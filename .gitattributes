# Normalize line endings: everything git detects as text becomes LF in the
# repository. Rust toolchain + shell scripts require LF.
* text=auto

*.rs   text eol=lf
*.toml text eol=lf
*.sql  text eol=lf
*.sh   text eol=lf
*.md   text
*.yml  text
*.yaml text
*.json text
*.xml  text

# Vendored legal texts are checked byte for byte against their SHA256SUMS
# (scripts/checks/law-corpus.sh); end-of-line normalisation would change the
# bytes the digest records. The ePrivacy consolidation is served with CRLF.
docs/law/**/*.html -text
docs/law/**/*.xml  -text
# The identity and provisioning documents are pinned by sha256 per file, and the
# SCIMReferenceCode LICENSE is served with CRLF.
docs/specs/rfc/** -text
docs/specs/openid-connect-core/** -text
docs/specs/microsoft-entra/** -text
docs/specs/scim-reference-code/** -text
docs/specs/keycloak/** -text
docs/specs/ehdsi-specifications/** -text
docs/specs/okta/** -text
docs/specs/oasis-saml/** -text
docs/specs/ihe-iua/** -text
docs/specs/nuts-rfc/** -text
docs/specs/ihe-balp/** -text
docs/specs/fhir-auditevent/** -text
docs/specs/fhir-consent/** -text
docs/specs/ihe-consents/** -text
docs/specs/xacml/** -text
docs/specs/nen-7513-sources/** -text
docs/specs/nl-role-codes/** -text

# Binary assets
*.png  binary
*.gif  binary
*.ico  binary
*.pdf  binary

# Generated code: collapse in diffs/linguist (still reviewed via the emitter)
crates/*/src/**/generated/** linguist-generated=true
crates/openehr-rm/src/model/data.rs linguist-generated=true
# The shipped ferroehr.toml, generated by tools/config-reference (#5316).
app/ferroehr/assets/ferroehr.default.toml linguist-generated=true

# ── Linguist: honest language stats ──────────────────────────────────────────
# Generated spec crates: emitted from the vendored BMM by openehr-codegen. The
# hand-written *_impl.rs siblings are re-included below.
crates/openehr-base/src/** linguist-generated=true
crates/openehr-rm/src/**   linguist-generated=true
crates/openehr-am/src/**   linguist-generated=true
crates/openehr-base/src/**/*_impl.rs linguist-generated=false
crates/openehr-rm/src/**/*_impl.rs   linguist-generated=false
# The draft packages emit-drafts writes under openehr-rm's `draft` module are
# covered by the crate glob above (#5124, #5540); their invariant checks are
# hand-written, and so is the access control terminology.
crates/openehr-rm/src/draft/**/invariants.rs linguist-generated=false
crates/openehr-rm/src/draft/access_control/terminology.rs linguist-generated=false
crates/openehr-am/src/**/*_impl.rs   linguist-generated=false

# Vendored third-party / spec inputs (never authored here)
crates/openehr-codegen/vendor/** linguist-vendored
crates/openehr-its/schemas/**    linguist-vendored
crates/openehr-its/vendor/**     linguist-vendored
website/book/theme/mermaid.min.js linguist-vendored
website/book/theme/mermaid-init.js linguist-vendored

# Byte-copied / machine-produced artifacts
deploy/helm/golden/**  linguist-generated=true
docs/conformance/**    linguist-generated=true

# Only the product code counts toward the language bar: helper scripts, docs
# website assets, packaging, hooks, and migrations are support material.
website/**   linguist-documentation
scripts/**   linguist-detectable=false
docker/**    linguist-detectable=false
deploy/**    linguist-detectable=false
.githooks/** linguist-detectable=false
.claude/**   linguist-detectable=false
Dockerfile*  linguist-detectable=false
app/ferroehr/migrations/** linguist-detectable=false

# Vendored upstream corpora are byte-verbatim (the vendored-corpora rule):
# no EOL normalization — upstream CKM exports carry CRLF and must round-trip
# bit-identical through clone/checkout.
corpus/archetypes/** -text
corpus/templates/ckm/full/** -text
