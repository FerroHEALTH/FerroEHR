archetype (adl_version=2.0.6; rm_release=1.1.0)
    openEHR-EHR-EHR_ACCESS.access_directives.v1.0.0

language
    original_language = <[ISO_639-1::en]>

description
    original_author = <
        ["name"] = <"FerroEHR">
        ["organisation"] = <"Cadasto B.V.">
    >
    lifecycle_state = <"unmanaged">
    details = <
        ["en"] = <
            language = <[ISO_639-1::en]>
            purpose = <"The access settings of one EHR in the access_directives scheme: the default disposition, the gate-keepers who change the settings, the subject's directives and the sensitivity labels.">
            use = <"Holds EHR_ACCESS.settings, which FerroEHR accepts only as an ACCESS_DIRECTIVE_SETTINGS of the draft access control package. FerroEHR reads the settings by their coded attributes in its access control terminology, never by this archetype's id, so a deployment may replace it with its own.">
            copyright = <"© Cadasto B.V.">
        >
    >

definition
    EHR_ACCESS[id1] matches {
        settings matches {
            ACCESS_CONTROL_SETTINGS[id2]
        }
    }

terminology
    term_definitions = <
        ["en"] = <
            ["id1"] = <text = <"EHR access"> description = <"The access settings of the EHR.">>
            ["id2"] = <text = <"Access directive settings"> description = <"The settings of the access_directives scheme, an ACCESS_DIRECTIVE_SETTINGS of the draft access control package.">>
        >
    >
