archetype (adl_version=2.0.6; rm_release=1.1.0)
    openEHR-EHR-EHR_ACCESS.access_directives.v1.1.0

language
    original_language = <[ISO_639-1::en]>

description
    original_author = <
        ["name"] = <"FerroEHR">
        ["organisation"] = <"Cadasto B.V.">
    >
    lifecycle_state = <"unmanaged">
    details = <
        ["en"] = <
            language = <[ISO_639-1::en]>
            purpose = <"The access settings of one EHR in the access_directives scheme: the default disposition, the gate-keepers who change the settings, the subject's directives and the sensitivity labels.">
            use = <"Holds EHR_ACCESS.settings as an ACCESS_DIRECTIVE_SETTINGS of FerroEHR's draft access control package, which is no openEHR release. FerroEHR reads the settings by their coded attributes in its access control terminology, never by this archetype's id, so a deployment may replace it with its own.">
            copyright = <"© Cadasto B.V.">
        >
    >
    other_details = <
        ["revision_history"] = <"1.1.0: constrains settings to ACCESS_DIRECTIVE_SETTINGS of the draft access control package and its attributes to their classes, which the ADL 2 validator reads beside RM 1.2.0; every settings this version admits are settings 1.0.0 admits, so a minor version. 1.0.0: settings constrained to the RM's ACCESS_CONTROL_SETTINGS.">
    >

definition
    EHR_ACCESS[id1] matches {
        settings matches {
            ACCESS_DIRECTIVE_SETTINGS[id2] matches {
                default_access matches {
                    DV_CODED_TEXT[id3]
                }
                gate_keepers matches {
                    PARTY_PROXY[id4] occurrences matches {0..*}
                }
                directives matches {
                    ACCESS_DIRECTIVE[id5] occurrences matches {0..*} matches {
                        kind matches {
                            DV_CODED_TEXT[id6]
                        }
                        effect matches {
                            DV_CODED_TEXT[id7]
                        }
                    }
                }
                labels matches {
                    ACCESS_LABEL[id8] occurrences matches {0..*} matches {
                        target matches {
                            OBJECT_REF[id9]
                        }
                        sensitivities matches {
                            DV_CODED_TEXT[id10] occurrences matches {1..*}
                        }
                    }
                }
            }
        }
    }

terminology
    term_definitions = <
        ["en"] = <
            ["id1"] = <text = <"EHR access"> description = <"The access settings of the EHR.">>
            ["id2"] = <text = <"Access directive settings"> description = <"The settings of the access_directives scheme.">>
            ["id3"] = <text = <"Default access"> description = <"What the EHR admits where no directive applies, a code of the access default group of FerroEHR's access control terminology.">>
            ["id4"] = <text = <"Gate-keeper"> description = <"A party who may change the settings, PARTY_SELF for the record's person.">>
            ["id5"] = <text = <"Directive"> description = <"A consent, restriction, opt-out or delegation the subject gives.">>
            ["id6"] = <text = <"Kind"> description = <"The kind of the directive, a code of the access directive kind group.">>
            ["id7"] = <text = <"Effect"> description = <"Whether the directive permits or denies, a code of the access effect group.">>
            ["id8"] = <text = <"Label"> description = <"A sensitivity label on content of the EHR.">>
            ["id9"] = <text = <"Target"> description = <"The content the label applies to.">>
            ["id10"] = <text = <"Sensitivity"> description = <"A sensitivity the labelled content carries.">>
        >
    >
