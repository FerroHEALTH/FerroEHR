archetype (adl_version=2.0.6; rm_release=1.1.0)
    openEHR-EHR-ITEM_TREE.access_log_details.v1.0.0

language
    original_language = <[ISO_639-1::en]>

description
    original_author = <
        ["organisation"] = <"Cadasto B.V.">
    >
    lifecycle_state = <"unmanaged">
    details = <
        ["en"] = <
            language = <[ISO_639-1::en]>
            purpose = <"The details of one access in ACCESS_LOG_ENTRY.other_details of the draft openEHR access log: the facts of an access the entry's core attributes do not hold, which the IHE BALP AuditEvent, the DICOM audit message and the EHDS access record carry beside the core.">
            use = <"One ITEM_TREE of ELEMENTs, each named by its node id. An element is written only where the entry's core does not state the fact as the access holds it: the core is read first, and a detail beside it. A reader of another system reads the tree by these node ids. The access log model is a draft of FerroEHR, which is no openEHR release.">
            copyright = <"© Cadasto B.V.">
        >
    >

definition
    ITEM_TREE[id1] matches {
        items matches {
                ELEMENT[id11] occurrences matches {0..1} matches {
                    value matches { DV_TEXT[id51] }
                }
                ELEMENT[id12] occurrences matches {0..1} matches {
                    value matches { DV_TEXT[id52] }
                }
                ELEMENT[id13] occurrences matches {0..1} matches {
                    value matches { DV_COUNT[id53] }
                }
                ELEMENT[id14] occurrences matches {0..1} matches {
                    value matches { DV_TEXT[id54] }
                }
                ELEMENT[id15] occurrences matches {0..1} matches {
                    value matches { DV_TEXT[id55] }
                }
                ELEMENT[id16] occurrences matches {0..1} matches {
                    value matches { DV_TEXT[id56] }
                }
                ELEMENT[id17] occurrences matches {0..1} matches {
                    value matches { DV_TEXT[id57] }
                }
                ELEMENT[id19] occurrences matches {0..*} matches {
                    value matches { DV_TEXT[id59] }
                }
                ELEMENT[id20] occurrences matches {0..1} matches {
                    value matches { DV_TEXT[id60] }
                }
                ELEMENT[id21] occurrences matches {0..1} matches {
                    value matches { DV_TEXT[id61] }
                }
                ELEMENT[id22] occurrences matches {0..1} matches {
