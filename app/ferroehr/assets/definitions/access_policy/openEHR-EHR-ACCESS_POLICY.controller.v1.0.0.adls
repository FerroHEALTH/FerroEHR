archetype (adl_version=2.0.6; rm_release=1.1.0)
    openEHR-EHR-ACCESS_POLICY.controller.v1.0.0

language
    original_language = <[ISO_639-1::en]>

description
    original_author = <
        ["name"] = <"FerroEHR">
        ["organisation"] = <"Cadasto B.V.">
    >
    lifecycle_state = <"unmanaged">
    details = <
        ["en"] = <
            language = <[ISO_639-1::en]>
            purpose = <"The access policy of the controller of the data FerroEHR keeps: the sensitivity of kinds of data, whether clinical access needs a care relationship and a declared purpose, and the named directives a subject can accept by reference.">
            use = <"The default archetype of the FerroEHR access policy. A deployment that names its own classifications, value sets or catalogue specialises it or writes its own ACCESS_POLICY archetype. ACCESS_POLICY is a class of FerroEHR's draft access control package, which is no openEHR release.">
            copyright = <"© Cadasto B.V.">
        >
    >
    other_details = <
        ["licence"] = <"This work is licensed under the Creative Commons Attribution-ShareAlike 3.0 License. To view a copy of this license, visit http://creativecommons.org/licenses/by-sa/3.0/.">
    >

definition
    ACCESS_POLICY[id1] matches {
        classifications matches {
            ACCESS_CLASSIFICATION[id2] occurrences matches {0..*} matches {
                data matches {
                    ACCESS_DATA_SCOPE[id3]
                }
                sensitivities matches {
                    DV_CODED_TEXT[id4] occurrences matches {1..*}
                }
            }
        }
        relationship_grace existence matches {0..1} matches {
            DV_DURATION[id5]
        }
        catalogue matches {
            ACCESS_DIRECTIVE[id6] occurrences matches {0..*} matches {
                kind matches {
                    DV_CODED_TEXT[id7]
                }
                effect matches {
                    DV_CODED_TEXT[id8]
                }
                identifiers matches {
                    DV_IDENTIFIER[id9] occurrences matches {1..*}
                }
            }
        }
        details existence matches {0..1} matches {
            ITEM_TREE[id10]
        }
    }

terminology
    term_definitions = <
        ["en"] = <
            ["id1"] = <text = <"Access policy"> description = <"The access policy of the controller of the data.">>
            ["id2"] = <text = <"Classification"> description = <"A rule that gives a kind of data its sensitivity labels.">>
            ["id3"] = <text = <"Data"> description = <"The kind of data the rule classifies.">>
            ["id4"] = <text = <"Sensitivity"> description = <"A sensitivity label the data carry, in the terminology the jurisdiction names.">>
            ["id5"] = <text = <"Relationship grace"> description = <"How long after a care relationship ends it still admits access.">>
            ["id6"] = <text = <"Catalogue directive"> description = <"A named directive a subject can accept by its identifier.">>
            ["id7"] = <text = <"Kind"> description = <"The kind of the directive.">>
            ["id8"] = <text = <"Effect"> description = <"Whether the directive permits or denies.">>
            ["id9"] = <text = <"Identifier"> description = <"An identifier of the directive, such as an IHE BPPC policy.">>
            ["id10"] = <text = <"Details"> description = <"Further detail the decision procedure never reads.">>
        >
    >
