archetype (adl_version=2.0.6; rm_release=1.1.0)
    openEHR-DEMOGRAPHIC-AGENT.system.v1.0.0

language
    original_language = <[ISO_639-1::en]>

description
    original_author = <
        ["name"] = <"FerroEHR">
        ["organisation"] = <"Cadasto B.V.">
    >
    lifecycle_state = <"unmanaged">
    details = <
        ["en"] = <
            language = <[ISO_639-1::en]>
            purpose = <"The AGENT of a software system that calls FerroEHR on its own account: a system client, a migration job or a change feed reader.">
            use = <"Identified by a DV_IDENTIFIER in details whose issuer is the token issuer and whose id is the OAuth 2.0 client_id. It performs the ROLEs that carry its grants and holds an acts-for PARTY_RELATIONSHIP to the healthcare provider it acts for. Adapted from the openEHR CKM archetype the derived_from entry names.">
            copyright = <"© openEHR Foundation">
        >
    >
    other_details = <
        ["licence"] = <"This work is licensed under the Creative Commons Attribution-ShareAlike 3.0 License. To view a copy of this license, visit http://creativecommons.org/licenses/by-sa/3.0/.">
        ["derived_from"] = <"openEHR-DEMOGRAPHIC-ORGANISATION.organisation.v0 (openEHR CKM 1013.1.475, modified 2019-08-09), openEHR-DEMOGRAPHIC-PARTY_IDENTITY.organisation_name.v0 (openEHR CKM 1013.1.476, modified 2019-08-09)">
    >

definition
    AGENT[id1] matches {
        details existence matches {1} matches {
            ITEM_TREE[id2] matches {
                items matches {
                    ELEMENT[id3] occurrences matches {1..*} matches {
                        value matches { DV_IDENTIFIER[id7] }
                    }
                }
            }
        }
        identities matches {
            PARTY_IDENTITY[id4] matches {
                details matches {
                    ITEM_TREE[id5] matches {
                        items matches {
                            ELEMENT[id6] occurrences matches {0..1} matches {
                                value matches { DV_TEXT[id8] }
                            }
                        }
                    }
                }
            }
        }
    }

terminology
    term_definitions = <
        ["en"] = <
            ["id1"] = <text = <"System agent"> description = <"A software system that acts on its own account.">>
            ["id2"] = <text = <"Identifiers"> description = <"The identifiers of the system.">>
            ["id3"] = <text = <"Identifier"> description = <"An identifier of the system: its OAuth 2.0 client_id under the token issuer, or another identifier an organisation gave it.">>
            ["id4"] = <text = <"Name"> description = <"The name the system is known by.">>
            ["id5"] = <text = <"Items"> description = <"The structure of the name.">>
            ["id6"] = <text = <"Name"> description = <"The name of the system as it is displayed.">>
        >
    >
