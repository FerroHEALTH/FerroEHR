archetype (adl_version=2.0.6; rm_release=1.1.0)
    openEHR-DEMOGRAPHIC-ROLE.federation_partner.v1.0.0

language
    original_language = <[ISO_639-1::en]>

description
    original_author = <
        ["name"] = <"FerroEHR">
        ["organisation"] = <"Cadasto B.V.">
    >
    lifecycle_state = <"unmanaged">
    details = <
        ["en"] = <
            language = <[ISO_639-1::en]>
            purpose = <"The ROLE a partner ORGANISATION performs under a data-sharing agreement: what its federation callers may read and write, on which legal ground, at which rate.">
            use = <"One CAPABILITY per accessor, the partner's named persons or the organisation itself, whose credentials hold the terms of the agreement; time_validity bounds the agreement by day. The ROLE is adapted from the openEHR CKM archetype the derived_from entry names, the ROLE of an organisation acting as a healthcare provider. Its CAPABILITY, whose credentials hold an authorization grant, is FerroEHR's own design: the openEHR RM and CKM use CAPABILITY for the professional qualifications of a performer, and no openEHR specification gives it an authorization meaning.">
            copyright = <"© openEHR Foundation">
        >
    >
    other_details = <
        ["licence"] = <"This work is licensed under the Creative Commons Attribution-ShareAlike 3.0 License. To view a copy of this license, visit http://creativecommons.org/licenses/by-sa/3.0/.">
        ["derived_from"] = <"openEHR-DEMOGRAPHIC-ROLE.healthcare_provider_organisation.v0 (openEHR CKM 1013.1.501, modified 2019-08-09)">
    >

definition
    ROLE[id1] matches {
        identities matches {
            PARTY_IDENTITY[id2] matches {
                details matches {
                    ITEM_TREE[id3] matches {
                        items matches {
                            ELEMENT[id4] occurrences matches {0..1} matches {
                                value matches { DV_TEXT[id5] }
                            }
                        }
                    }
                }
            }
        }
        capabilities matches {
            CAPABILITY[id6] occurrences matches {1..2} matches {
                name matches {
                    DV_CODED_TEXT[id7] matches {
                        defining_code matches {[ac1]}
                    }
                }
                credentials matches {
                    ITEM_TREE[id8] matches {
                        items matches {
                            ELEMENT[id90] occurrences matches {1..*} matches {
                                value matches { DV_CODED_TEXT[id91] }
                            }
                            ELEMENT[id9] occurrences matches {1} matches {
                                value matches { DV_TEXT[id40] }
                            }
                            ELEMENT[id10] occurrences matches {1} matches {
                                value matches { DV_TEXT[id41] }
                            }
                            ELEMENT[id11] occurrences matches {1} matches {
                                value matches { DV_TEXT[id42] }
                            }
                            ELEMENT[id12] occurrences matches {1} matches {
                                value matches { DV_TEXT[id43] }
                            }
                            ELEMENT[id13] occurrences matches {0..1} matches {
                                value matches { DV_CODED_TEXT[id44] }
                            }
                            CLUSTER[id14] occurrences matches {0..1} matches {
                                items matches {
                                    ELEMENT[id15] occurrences matches {1} matches {
                                        value matches { DV_TEXT[id45] }
                                    }
                                    ELEMENT[id16] occurrences matches {1} matches {
                                        value matches { DV_TEXT[id46] }
                                    }
                                    ELEMENT[id17] occurrences matches {0..1} matches {
                                        value matches { DV_TEXT[id47] }
                                    }
                                }
                            }
                            ELEMENT[id18] occurrences matches {0..1} matches {
                                value matches { DV_CODED_TEXT[id48] }
                            }
                            ELEMENT[id19] occurrences matches {0..*} matches {
                                value matches { DV_TEXT[id49] }
                            }
                            ELEMENT[id20] occurrences matches {0..*} matches {
                                value matches { DV_TEXT[id50] }
                            }
                            ELEMENT[id22] occurrences matches {0..1} matches {
                                value matches { DV_DURATION[id52] }
                            }
                            ELEMENT[id23] occurrences matches {0..1} matches {
                                value matches { DV_CODED_TEXT[id53] }
                            }
                            CLUSTER[id24] occurrences matches {1} matches {
                                items matches {
                                    ELEMENT[id25] occurrences matches {1} matches {
                                        value matches { DV_COUNT[id54] }
                                    }
                                    ELEMENT[id26] occurrences matches {1} matches {
                                        value matches { DV_COUNT[id55] }
                                    }
                                }
                            }
                            ELEMENT[id27] occurrences matches {0..1} matches {
                                value matches { DV_BOOLEAN[id56] }
                            }
                            ELEMENT[id28] occurrences matches {0..1} matches {
                                value matches { DV_CODED_TEXT[id57] }
                            }
                            ELEMENT[id29] occurrences matches {0..1} matches {
                                value matches { DV_DURATION[id58] }
                            }
                            ELEMENT[id30] occurrences matches {0..1} matches {
                                value matches { DV_DATE_TIME[id59] }
                            }
                            ELEMENT[id31] occurrences matches {0..1} matches {
                                value matches { DV_DATE_TIME[id60] }
                            }
                            ELEMENT[id32] occurrences matches {0..1} matches {
                                value matches { DV_TEXT[id61] }
                            }
                        }
                    }
                }
            }
        }
    }

terminology
    term_definitions = <
        ["en"] = <
            ["id1"] = <text = <"Federation partner"> description = <"The role of an organisation that exchanges data with this provider under a data-sharing agreement.">>
            ["id2"] = <text = <"Role name"> description = <"The name of the role.">>
            ["id3"] = <text = <"Name"> description = <"The structure of the name.">>
            ["id4"] = <text = <"Full name"> description = <"The name of the role as it is written in full.">>
            ["id6"] = <text = <"Agreement"> description = <"The terms of the agreement for one accessor.">>
            ["id7"] = <text = <"Kind"> description = <"The kind of the grant, which is the name of the capability.">>
            ["id8"] = <text = <"Grant"> description = <"What the capability grants, held in its credentials.">>
            ["id90"] = <text = <"Operation"> description = <"An operation the capability grants, a code of FerroEHR's operation terminology ferroehr-operations.">>
            ["id9"] = <text = <"Agreement name"> description = <"The name of the agreement.">>
            ["id10"] = <text = <"Agreement version"> description = <"The version of the agreement.">>
            ["id11"] = <text = <"Jurisdiction"> description = <"The ISO 3166-1 alpha-2 code of the jurisdiction the agreement is made under.">>
            ["id12"] = <text = <"Exchange"> description = <"The kind of exchange the agreement covers.">>
            ["id13"] = <text = <"Purpose"> description = <"What the exchange is for, a code the agreement names.">>
            ["id14"] = <text = <"Legal ground"> description = <"The legal ground of the processing.">>
            ["id15"] = <text = <"GDPR Article 6(1) point"> description = <"The point of GDPR Article 6(1), a to f.">>
            ["id16"] = <text = <"GDPR Article 9(2) point"> description = <"The point of GDPR Article 9(2), a to j.">>
            ["id17"] = <text = <"National provision"> description = <"The provision of the law that applies, which the processing rests on.">>
            ["id18"] = <text = <"Consent source"> description = <"The source of the consent the exchange is conditioned on, the ferroehr-operations code registry (an external consent registry, whose question names the responsible professional) or local (a consent this provider records).">>
            ["id19"] = <text = <"Read scope"> description = <"A patient/ scope the partner's callers may read under.">>
            ["id20"] = <text = <"Template written"> description = <"The id of a template whose COMPOSITIONs an external person may commit.">>
            ["id22"] = <text = <"Discard window"> description = <"The window, in whole hours, within which an external person may discard a dispensation of the same point of care; without it no discard is admitted.">>
            ["id23"] = <text = <"MyHealth@EU service"> description = <"The MyHealth@EU service a national contact point's person agreement serves, the ferroehr-operations code patient_summary, eprescription or orcd.">>
            ["id24"] = <text = <"Caller rate"> description = <"The rate one caller of the partner may send requests at.">>
            ["id25"] = <text = <"Requests per second"> description = <"The requests per second a caller may send once its burst is spent.">>
            ["id26"] = <text = <"Burst"> description = <"The requests a caller may send at once.">>
            ["id27"] = <text = <"Opt-out override"> description = <"Whether a professional of the partner may read an opted-out EHR where the law provides the vital-interest access.">>
            ["id28"] = <text = <"Access class"> description = <"For an organisation accessor, the ferroehr-operations code automated (no natural person views the data) or chained (the requester logs the person).">>
            ["id29"] = <text = <"Chained log retention"> description = <"For a chained access: how long the requester keeps its log.">>
            ["id30"] = <text = <"Not before"> description = <"The instant before which the grant does not hold, for a bound finer than the day of time_validity.">>
            ["id31"] = <text = <"Not after"> description = <"The instant after which the grant does not hold, for a bound finer than the day of time_validity.">>
            ["id32"] = <text = <"Authorisation reference"> description = <"The reference of the decision that authorised the grant, such as a change ticket or a processing agreement.">>
            ["ac1"] = <text = <"Accessors"> description = <"Who the agreement admits.">>
            ["at10"] = <text = <"Person"> description = <"Named persons of the partner.">>
            ["at11"] = <text = <"Organisation"> description = <"The partner organisation itself.">>
        >
    >
    value_sets = <
        ["ac1"] = <
            id = <"ac1">
            members = <"at10", "at11">
        >
    >
