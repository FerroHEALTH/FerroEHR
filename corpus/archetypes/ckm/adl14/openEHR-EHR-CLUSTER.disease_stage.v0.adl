archetype (adl_version=1.4; uid=bf88363a-4a8e-4959-9a98-944bba901543)
	openEHR-EHR-CLUSTER.disease_stage.v0

concept
	[at0000]	-- Disease stage
language
	original_language = <[ISO_639-1::en]>
description
	original_author = <
		["name"] = <"Heather Leslie">
		["organisation"] = <"Atomica Informatics">
		["email"] = <"heather.leslie@atomicainformatics.com">
		["date"] = <"2021-08-18">
	>
	details = <
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"To record details about the stage or phase of progression of a diagnosis.">
			use = <"Use to record details about the stage or phase of progression of a diagnosis.">
			misuse = <"Not to be used to record formal disease-specific staging or classification systems, for example those from FIGO, TNM or KDIGO. Use dedicated archetypes that explicitly model those systems.">
			copyright = <"© openEHR Foundation">
		>
	>
	lifecycle_state = <"in_development">
	other_contributors = <>
	other_details = <
