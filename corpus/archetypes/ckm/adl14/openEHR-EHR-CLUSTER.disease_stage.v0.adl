		["custodian_organisation"] = <"openEHR Foundation">
		["original_namespace"] = <"org.openehr">
		["original_publisher"] = <"openEHR Foundation">
		["custodian_namespace"] = <"org.openehr">
		["MD5-CAM-1.0.1"] = <"7027936068D610D8D22A1490CB193D60">
		["build_uid"] = <"6e9c6cbd-1977-4ec9-9f2f-c49f37457bd8">
		["revision"] = <"0.0.1-alpha">
	>

definition
	CLUSTER[at0000] matches {    -- Disease stage
		items cardinality matches {1..*; unordered} matches {
			ELEMENT[at0001] occurrences matches {0..1} matches {    -- Stage name
				value matches {
					DV_TEXT matches {*}
				}
			}
			ELEMENT[at0006] occurrences matches {0..1} matches {    -- Date diagnosed
				value matches {
					DV_DATE_TIME matches {*}
				}
			}
		}
	}

ontology
	term_definitions = <
		["en"] = <
			items = <
				["at0000"] = <
					text = <"Disease stage">
					description = <"Details about the stage of a diagnosis.">
				>
				["at0001"] = <
					text = <"Stage name">
					description = <"Identification of the phase of the disease.">
				>
				["at0006"] = <
					text = <"Date diagnosed">
					description = <"Date when the phase was clinically recognised.">
				>
			>
		>
	>
