	openEHR-EHR-CLUSTER.intraocular_pressure_test_reliability_indicator.v0

concept
	[at0000]	-- Intraocular pressure test reliability indicator
language
	original_language = <[ISO_639-1::en]>
description
	original_author = <
		["name"] = <"Lars Fuhrmann">
		["organisation"] = <"Deutsche Ophthalmologische Gesellschaft">
		["email"] = <"lars.fuhrmann@dog.org">
		["date"] = <"2026-02-07">
	>
	details = <
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"To record outputs indicating the reliability of an intraocular pressure test. 
">
			use = <"">
			keywords = <"IOP, Intraocular Pressure, Reliability", ...>
			misuse = <"">
			copyright = <"© openEHR Foundation">
		>
	>
	lifecycle_state = <"in_development">
	other_contributors = <>
	other_details = <
		["licence"] = <"This work is licensed under the Creative Commons Attribution-ShareAlike 4.0 International License. To view a copy of this license, visit http://creativecommons.org/licenses/by-sa/4.0/.">
		["custodian_organisation"] = <"openEHR Foundation">
		["references"] = <"Vantomme M, Pourjavan S, Detry-Morel M. The range of the waveform score of the ocular response analyzer (ora) in healthy subjects. Bull Soc Belge Ophtalmol. 2013;(322):91–7.

">
		["original_namespace"] = <"org.openehr">
		["original_publisher"] = <"openEHR Foundation">
		["custodian_namespace"] = <"org.openehr">
		["MD5-CAM-1.0.1"] = <"055956EA18DFF3E09EEC11300DDD03AF">
		["build_uid"] = <"1fbac967-5570-4185-96da-fecbb5eda170">
		["revision"] = <"0.0.1-alpha">
	>

definition
	CLUSTER[at0000] matches {    -- Intraocular pressure test reliability indicator
		items cardinality matches {1..*; unordered} matches {
			ELEMENT[at0001] occurrences matches {0..1} matches {    -- Ocular Reponse Analyzer Waveform Score
				value matches {
					C_DV_QUANTITY <
						property = <[openehr::755]>
						list = <
							["1"] = <
								units = <"[arb'U]">
								magnitude = <|0.0..10.0|>
								precision = <|2|>
							>
						>
					>
				}
			}
			ELEMENT[at0002] occurrences matches {0..1} matches {    -- 7CR Reliability Score
				value matches {
					C_DV_QUANTITY <
						property = <[openehr::755]>
						list = <
							["1"] = <
								units = <"[arb'U]">
								magnitude = <|0.0..10.0|>
								precision = <|2|>
							>
						>
					>
				}
			}
			ELEMENT[at0003] occurrences matches {0..1} matches {    -- Tonopen AVIA Statistical Confidence Indicator
				value matches {
					DV_QUANTITY matches {*}
				}
			}
			ELEMENT[at0004] occurrences matches {0..1} matches {    -- iCare measurement quality color indicator
				value matches {
					1|[local::at0005],
					2|[local::at0006]
				}
			}
		}
	}

ontology
	term_definitions = <
		["en"] = <
			items = <
				["at0000"] = <
					text = <"Intraocular pressure test reliability indicator">
					description = <"intraocular pressure test reliability indicator">
				>
				["at0001"] = <
					text = <"Ocular Reponse Analyzer Waveform Score">
					description = <"Waveform score produced by the Ocular Response Analyzer device.
">
					comment = <"Higher values indicate higher reliability.">
				>
				["at0002"] = <
					text = <"7CR Reliability Score">
					description = <"Reliability score produced by the Reichert® 7CR device.
">
					comment = <"Higher values indicate higher reliability.">
				>
				["at0003"] = <
					text = <"Tonopen AVIA Statistical Confidence Indicator">
					description = <"">
				>
				["at0004"] = <
					text = <"iCare measurement quality color indicator">
					description = <"">
				>
				["at0005"] = <
					text = <"Green">
					description = <"Good measurement quality">
				>
				["at0006"] = <
					text = <"Yellow">
					description = <"Acceptable measurement Quality">
				>
			>
		>
	>
