					comment = <"Wenn die Gewebeprobe zuvor in einer höheren Archetyp-Ebene, wie beispielsweise OBSERVATION.laboratory_test_result, identifiziert wurde, dann kann dieser SLOT redundant sein.">
				>
				["at0049"] = <
