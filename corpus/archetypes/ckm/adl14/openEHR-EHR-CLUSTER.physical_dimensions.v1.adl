										units = <"dm3">
										magnitude = <|>=0.0|>
									>
									["10"] = <
										units = <"[foz_us]">
										magnitude = <|>=0.0|>
									>
									["11"] = <
										units = <"[gal_us]">
										magnitude = <|>=0.0|>
									>
									["12"] = <
										units = <"[pt_us]">
										magnitude = <|>=0.0|>
									>
								>
							>
						}
					}
				}
			}
		}
	}

ontology
	term_definitions = <
		["en"] = <
			items = <
				["at0000"] = <
					text = <"Physical dimensions">
					description = <"The spatial measurements of an anatomical structure, an object or a fluid that is part of, found in or originates from the body of an individual.">
				>
				["at0046"] = <
					text = <"Volume">
					description = <"The amount of three-dimensional space occupied by a structure/object.">
				>
				["at0049"] = <
					text = <"Length">
					description = <"The longest dimension of an anatomical structure or object, usually aligned with its primary anatomical or longitudinal axis.">
					comment = <"This data element has multiple occurrences to allow recording of more than one length.

If the orientation of an anatomical structure or object is unclear, each dimension may be recorded using the same data element repeatedly, for example, 'length × length × length'.">
				>
				["at0050"] = <
					text = <"Width">
					description = <"The dimension perpendicular to the length, measured in the coronal (left-to-right) or transverse (side-to-side) direction — often representing the second longest axis.">
					comment = <"This data element has multiple occurrences to allow recording of more than one width. For example, the widest and narrowest part of an abnormal mass.">
				>
				["at0052"] = <
					text = <"Diameter">
					description = <"The length of a straight line passing through the centre of an object from one side to the opposite side, typically measured across its widest part.">
					comment = <"This data element has multiple occurrences to allow recording of multiple measurements.

If the orientation of an anatomical structure or object is unclear, use multiple occurrences of the same data element to record the diameter along two or more axes without a specific orientation. For example, a lesion with diameters recorded as 3 mm × 4 mm indicating measurements along two perpendicular axes without defining which is length or width.">
				>
				["at0053"] = <
					text = <"Depth">
					description = <"The vertical distance from a neutral base or reference surface to a lower point on an anatomical structure or object.">
					comment = <"For example: the depth of a wound from the normal surface of the skin.

This data element has multiple occurrences to allow recording the deepest and shallowest part of a skin lesion, or the maximum and minimum depth of an internal tumor in soft tissue.">
				>
				["at0054"] = <
					text = <"Height">
					description = <"The vertical distance from a neutral base or reference surface to a higher point on an anatomical structure or object.">
					comment = <"For example: the height of a lesion from the normal surface of the skin; or the height of a specimen from a tabletop.

This data element has multiple occurrences to allow recording of more than one height. For example, the maximum and minimum height of a tumor above the skin surface.">
				>
				["at0055"] = <
					text = <"Circumference/perimeter">
					description = <"The linear distance around the outer edge or boundary of an object.">
					comment = <"For irregular or polygonal shapes, this is referred to as the perimeter. For circular or nearly circular shapes, it is commonly referred to as the circumference.

This data element has multiple occurrences to allow recording of multiple measurements. For example, the inner and outer perimeter of a scar or uneven skin change or the inner and outer circumference of a cyst or nodule measured at different locations.">
				>
				["at0080"] = <
					text = <"Radius">
					description = <"The length of a straight line from the centre of an object to its surface or boundary, typically representing half the diameter.">
					comment = <"This data element has multiple occurrences to allow recording of multiple measurements. For example, the maximum and minimum radius of a cyst or nodule.">
				>
				["at0081"] = <
					text = <"Area">
					description = <"The calculated space of a structure/object in two dimensions.">
				>
				["at0082"] = <
					text = <"Thickness">
					description = <"The distance between two opposite surfaces or boundaries of an anatomical structure or object.">
					comment = <"For example, the thickness of a tissue layer, organ wall, or biopsy slice. 

This data element has multiple occurrences to allow recording of multiple measurements. For example, the maximum and minimum thickness of a cyst wall.">
				>
			>
		>
		["nb"] = <
			items = <
				["at0000"] = <
					text = <"Fysiske dimensjoner">
					description = <"De romlige målene til en anatomisk struktur, et objekt eller en væske som er en del av, finnes i, eller stammer fra et individ.">
				>
				["at0046"] = <
					text = <"Volum">
					description = <"Mengden tredimensjonalt rom som opptas av en struktur eller et objekt.">
				>
				["at0049"] = <
					text = <"Lengde">
					description = <"Den lengste dimensjonen til en anatomisk struktur eller et objekt, vanligvis orientert i henhold til den primære anatomiske eller longitudinale akse.">
					comment = <"Dette dataelementet har multiple forekomster for å tillate registrering av mer enn én lengde.

Dersom orienteringen til en anatomisk struktur eller et objekt er uklar, kan hver dimensjon registreres ved å bruke det samme dataelementet gjentatte ganger, for eksempel: «lengde × lengde × lengde».">
				>
				["at0050"] = <
					text = <"Bredde">
					description = <"Dimensjonen som står vinkelrett på lengden, målt i koronalretning (venstre-til-høyre) eller tverrretning (side-til-side) — ofte den nest lengste aksen.">
					comment = <"Dette dataelementet har multiple forekomster for å tillate registrering av mer enn én bredde, for eksempel den bredeste og smaleste delen av en masse som er avvikende.">
				>
				["at0052"] = <
					text = <"Diameter">
					description = <"Lengden av en rett linje som går gjennom midten av et objekt fra én side til motsatt side, vanligvis målt over den bredeste delen.">
					comment = <"Dette dataelementet har multiple forekomster for å tillate registrering av mer enn én måling.

Hvis orienteringen til en anatomisk struktur eller et objekt er uklar, bruk flere forekomster av det samme dataelementet for å registrere diameteren langs to eller flere akser uten en spesifikk retning. For eksempel en lesjon med diametre registrert som 3 mm × 4 mm, som angir målinger langs to vinkelrette akser uten å spesifisere hva som er lengde eller bredde.">
				>
				["at0053"] = <
					text = <"Dybde">
					description = <"Den vertikale avstanden fra en nøytral basis- eller referanseflate til et lavere punkt på en anatomisk struktur eller et objekt.">
					comment = <"For eksempel dybden på et sår målt fra den normale hudoverflaten.

Dette dataelementet har multiple forekomster for å tillate registrering av for eksempel den dypeste og grunneste delen av en hudlesjon, eller den maksimale og minimale dybden av en indre svulst i bløtvev.">
				>
				["at0054"] = <
					text = <"Høyde">
					description = <"Den vertikale avstanden fra en nøytral basis- eller referanseflate til et høyere punkt på en anatomisk struktur eller et objekt.">
					comment = <"For eksempel høyden på en lesjon over den normale hudoverflaten, eller høyden på en prøvemateriale fra bordoverflaten.

Dette dataelementet har multiple forekomster for å tillate registrering av mer enn én høyde, for eksempel den maksimale og minimale høyden på en svulst over hudoverflaten.">
				>
				["at0055"] = <
					text = <"Omkrets">
					description = <"Den lineære avstanden rundt ytterkanten eller yttergrensen av et objekt.">
					comment = <"På norsk refereres både uregelmessige eller polygonale former og sirkulære eller nesten sirkulære former som omkrets. Tilsvarene er \"perimeter\" og \"circumference\" på engelsk, og dataelementet har derfor blitt gitt navnet \"Circumference/perimeter\" på i den orignale språkdrakten.

Dette dataelementet har multiple forekomster for å tillate registrering av mer enn én måling. For eksempel den indre og ytre omkretsen av et arr eller en ujevn hudforandring, eller den indre og ytre omkretsen av en cyste eller knute målt på ulike steder.">
				>
				["at0080"] = <
					text = <"Radius">
					description = <"Lengden av en rett linje fra midten av et objekt til dets overflate eller yttergrense, vanligvis tilsvarende halvparten av diameteren.">
					comment = <"Dette dataelementet har multiple forekomster for å tillate registrering av mer enn én måling, for eksempel maksimal og minimal radius av en cyste eller knute.">
				>
				["at0081"] = <
					text = <"Areal">
					description = <"Det beregnede arealet av strukturen/objektet i to dimensjoner.">
				>
				["at0082"] = <
					text = <"Tykkelse">
					description = <"Avstanden mellom to motsatte flater eller grenser på en anatomisk struktur eller et objekt.">
					comment = <"For eksempel tykkelsen på et vevslag, en organvegg eller en vevsbit fra en biopsi.

Dette dataelementet har multiple forekomster for å tillate registrering av mer enn én måling, for eksempel den maksimale og minimale tykkelsen på en cystevegg.">
				>
			>
		>
		["sv"] = <
			items = <
				["at0000"] = <
					text = <"Fysiska dimensioner">
					description = <"Spatiala (rumsliga) mått på en anatomisk struktur, ett föremål eller en vätska som är en del av, finns i eller kommer från en individs kropp.">
				>
				["at0046"] = <
					text = <"Volym">
					description = <"Den mängd tredimensionellt utrymme som upptas av en struktur eller ett föremål.">
				>
				["at0049"] = <
					text = <"Längd">
					description = <"Den längsta dimensionen av en anatomisk struktur eller ett föremål, vanligtvis i linje med dess primära anatomiska eller longitudinella axel.">
					comment = <"Detta datafält har flera förekomster för att möjliggöra registrering av mer än en längd.

Om orienteringen av en anatomisk struktur eller ett objekt är oklar kan varje dimension registreras med hjälp av samma fält upprepade gånger, t.ex. ”längd × längd × längd”.">
				>
				["at0050"] = <
					text = <"Bredd">
					description = <"Dimensionen vinkelrätt mot längden, mätt i koronal (vänster till höger) eller transversal (sida till sida) riktning, representerar ofta den näst längsta axeln.">
					comment = <"Detta datafält har flera förekomster för att möjliggöra registrering av mer än en bredd. Till exempel den bredaste och smalaste delen av en onormal massa.">
				>
				["at0052"] = <
					text = <"Diameter">
					description = <"Längden på en rak linje som går genom ett föremåls centrum från ena sidan till den motsatta sidan, vanligtvis mätt över dess bredaste del.">
					comment = <"Detta datafält har flera förekomster för att möjliggöra registrering av flera diametrar.

Om orienteringen av en anatomisk struktur eller ett objekt är oklar, använd flera förekomster av samma datafält för att registrera diametern längs två eller flera axlar utan en specifik orientering. Exempelvis en lesion med diametrar som registrerats som 3 × 4 mm avser mätningar längs två vinkelräta axlar utan att definiera vilken som är längd eller bredd.">
				>
				["at0053"] = <
					text = <"Djup">
					description = <"Det vertikala avståndet från en neutral bas eller referensyta till en lägre punkt på en anatomisk struktur eller ett föremål.">
					comment = <"Exempelvis djupet på ett sår från den normala hudytan.

Detta datafält har flera förekomster för att möjliggöra registrering av den djupaste och grundaste delen av en hudlesion, eller det maximala och minimala djupet av en intern tumör i mjukvävnad.">
				>
				["at0054"] = <
					text = <"Höjd">
					description = <"Det vertikala avståndet från en neutral bas eller referensyta till en högre punkt på en anatomisk struktur eller ett föremål.">
					comment = <"Exempelvis en lesions höjd från den normala hudytan eller ett provmaterials höjd från ytan av ett bord.

Detta datafält har flera förekomster för att möjliggöra registrering av mer än en höjd. Exempelvis en tumörs maximala och minimala höjd över hudytan.">
				>
				["at0055"] = <
					text = <"Omkrets/perimeter">
					description = <"Det linjära avståndet runt ett föremåls ytterkant eller gräns.">
					comment = <"Vanligtvis används omkrets på svenska och då för samtliga former, dvs. oregelbundna, månghörniga, cirkulära eller nästan cirkulära.

Detta datafält har flera förekomster för att möjliggöra registrering av flera omkretsar. Till exempel den inre och yttre omkretsen av ett ärr eller en ojämn hudförändring eller den inre och yttre omkretsen av en cysta eller knöl som uppmätts på olika platser.">
				>
				["at0080"] = <
					text = <"Radie">
					description = <"Längden på en rak linje från ett föremåls centrum till dess yta eller avgränsning, vilket normalt motsvarar halva diametern.">
					comment = <"Detta datafält har flera förekomster för att möjliggöra registrering av flera radier. Exempelvis den maximala och minimala radien för en cysta eller knuta.">
				>
				["at0081"] = <
					text = <"Yta">
					description = <"Det beräknade utrymmet för en struktur eller ett föremål i två dimensioner.">
				>
				["at0082"] = <
					text = <"Tjocklek">
					description = <"Avståndet mellan två motsatta ytor eller gränser i en anatomisk struktur eller ett föremål.">
					comment = <"Exempelvis, tjockleken på ett vävnadsskikt, en organvägg eller ett snitt av en biopsi.

Detta datafält har flera förekomster för att möjliggöra registrering av flera tjocklekar. Exempelvis den maximala och minimala tjockleken på en cystvägg.">
				>
			>
		>
		["de"] = <
			items = <
				["at0000"] = <
					text = <"Physikalische Abmessungen">
					description = <"Die räumlichen Maße einer anatomischen Struktur, eines Objekts oder einer Flüssigkeit, die Teil des Körpers einer Person ist, sich darin befindet oder aus diesem stammt.">
				>
				["at0046"] = <
					text = <"Volumen">
					description = <"Der dreidimensionale Raum, den eine Struktur bzw. ein Objekt einnimmt.">
				>
				["at0049"] = <
					text = <"Länge">
					description = <"Die längste Ausdehnung einer anatomischen Struktur oder eines Objekts, die in der Regel mit deren primärer anatomischer oder Längsachse übereinstimmt.">
					comment = <"Dieses Datenelement kann mehrfach vorkommen, um die Erfassung von mehr als einer Länge zu ermöglichen.

Ist die Ausrichtung einer anatomischen Struktur oder eines Objekts unklar, kann jede Dimension wiederholt unter Verwendung desselben Datenelements erfasst werden, zum Beispiel „Länge × Länge × Länge“.">
				>
				["at0050"] = <
					text = <"Breite">
					description = <"Die zur Länge senkrechte Dimension, gemessen in koronaler (von links nach rechts) oder transversaler (von einer Seite zur anderen) Richtung – oft die zweitlängste Achse.">
					comment = <"Dieses Datenelement kann mehrfach vorkommen, um zur Erfassung von mehr als einer Breite zu dienen. Beispielsweise die breiteste und die schmalste Stelle einer pathologischen Masse.">
				>
				["at0052"] = <
					text = <"Durchmesser">
					description = <"Die Länge einer geraden Linie, die durch den Mittelpunkt eines Objekts von einer Seite zur gegenüberliegenden Seite verläuft und typischerweise an der breitesten Stelle gemessen wird.">
					comment = <"Dieses Datenelement kann mehrfach vorkommen, um die Erfassung mehrerer Messwerte zu ermöglichen.

Ist die Ausrichtung einer anatomischen Struktur oder eines Objekts unklar, verwenden Sie mehrere Vorkommen desselben Datenelements, um den Durchmesser entlang zweier oder mehrerer Achsen ohne spezifische Ausrichtung zu erfassen. Beispielsweise eine Läsion mit den angegebenen Durchmessern 3 mm × 4 mm, was Messwerte entlang zweier senkrechter Achsen angibt, ohne zu definieren, welche davon die Länge und welche die Breite ist.">
				>
				["at0053"] = <
					text = <"Tiefe">
					description = <"Der vertikale Abstand von einer neutralen Basis oder Referenzfläche zu einem tiefer gelegenen Punkt an einer anatomischen Struktur oder einem Objekt.">
					comment = <"Beispiel: die Tiefe einer Wunde gemessen von der normalen Hautoberfläche.

Dieses Datenelement kann mehrfach vorkommen, zur Erfassung der tiefsten und flachsten Stelle einer Hautläsion oder der maximalen und minimalen Tiefe eines inneren Tumors im Weichgewebe.">
				>
				["at0054"] = <
					text = <"Höhe">
					description = <"Der vertikale Abstand von einer neutralen Basis oder Referenzfläche zu einem höher gelegenen Punkt auf einer anatomischen Struktur oder einem Objekt.">
					comment = <"Beispielsweise: die Höhe einer Läsion über der normalen Hautoberfläche oder die Höhe einer Probe über einer Tischplatte.

Dieses Datenelement kann mehrfach vorkommen, um zur Erfassung von mehr als einer Höhe zu dienen. Beispielsweise die maximale und minimale Höhe eines Tumors über der Hautoberfläche.">
				>
				["at0055"] = <
					text = <"Umfang">
					description = <"Der lineare Abstand entlang der Außenkante oder Begrenzung eines Objekts.">
					comment = <"Dieses Datenelement kann mehrfach vorkommen, zur Erfassung mehrerer Messwerte. Beispielsweise der innere und äußere Umfang einer Narbe oder einer unregelmäßigen Hautveränderung oder der innere und äußere Kreisumfang einer Zyste oder eines Knotens, gemessen an verschiedenen Messorten.">
				>
				["at0080"] = <
					text = <"Radius">
					description = <"Die Länge einer geraden Linie vom Mittelpunkt eines Objekts bis zu dessen Oberfläche oder Begrenzung, die typischerweise die Hälfte des Durchmessers darstellt.">
					comment = <"Dieses Datenelement kann mehrfach vorkommen, um zur Erfassung mehrerer Messwerte zu dienen. Zum Beispiel den maximalen und minimalen Radius einer Zyste oder eines Knotens.">
				>
				["at0081"] = <
					text = <"Fläche">
					description = <"Der berechnete Raum einer Struktur/eines Objekts in zwei Dimensionen.">
				>
				["at0082"] = <
					text = <"Dicke">
					description = <"Der Abstand zwischen zwei gegenüberliegenden Oberflächen oder Begrenzungen einer anatomischen Struktur oder eines Objekts.">
					comment = <"Beispielsweise die Dicke einer Gewebeschicht, einer Organwand oder eines Biopsieschnitts. 

Dieses Datenelement kann mehrfach vorkommen, um zur Erfassung mehrerer Messwerte zu dienen. Beispielsweise die maximale und minimale Dicke einer Zystenwand.">
				>
			>
		>
	>
