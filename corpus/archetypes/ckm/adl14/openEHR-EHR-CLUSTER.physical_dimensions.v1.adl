definition
	CLUSTER[at0000] matches {    -- Physical dimensions
		items cardinality matches {1..*; unordered} matches {
			ELEMENT[at0049] occurrences matches {0..*} matches {    -- Length
				value matches {
					C_DV_QUANTITY <
						property = <[openehr::122]>
						list = <
							["1"] = <
								units = <"nm">
								magnitude = <|>=0.0|>
							>
							["2"] = <
								units = <"um">
								magnitude = <|>=0.0|>
							>
							["3"] = <
