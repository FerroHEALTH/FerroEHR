archetype (adl_version=1.4; uid=c4ed12e0-471f-40ec-b70d-be07ef3c5932)
	openEHR-EHR-CLUSTER.structured_name.v1

concept
	[at0000]	-- Structured name of a person
language
	original_language = <[ISO_639-1::en]>
	translations = <
