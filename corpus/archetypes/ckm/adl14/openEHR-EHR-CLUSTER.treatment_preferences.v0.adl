archetype (adl_version=1.4; uid=d917b9bf-ab18-423c-8cf5-16123873fad8)
	openEHR-EHR-CLUSTER.treatment_preferences.v0

concept
	[at0000]	-- Treatment preferences
language
	original_language = <[ISO_639-1::en]>
	translations = <
		["de"] = <
			language = <[ISO_639-1::de]>
			author = <
				["name"] = <"Olha Nikolaieva">
				["organisation"] = <"University Hospital Basel">
				["email"] = <"olha.nikolaieva@usb.ch">
			>
			other_details = <
				["other_contributors"] = <"Maren Diepenbruck, University Hospital Basel, Switzerland">
			>
		>
	>
description
	original_author = <
		["name"] = <"Heather Leslie">
		["organisation"] = <"Atomica Informatics">
		["email"] = <"heather.leslie@atomicainformatics.com">
		["date"] = <"2020-11-13">
	>
	details = <
		["de"] = <
			language = <[ISO_639-1::de]>
			purpose = <"Zur Erfassung der persönlichen Präferenzen einer Person hinsichtlich ihrer zukünftigen Versorgung und Behandlung, einschließlich des übergeordneten Versorgungsziels sowie von Vorgaben zu möglichen Behandlungen und medizinischen Interventionen, die sich auf die Lebensdauer oder die Lebensqualität auswirken können.">
			use = <"Zur Erfassung persönlicher Präferenzen hinsichtlich der zukünftigen Versorgung und Behandlung, die von der betroffenen Person selbst geäussert wurden. Diese Präferenzen umfassen das übergeordnete Versorgungsziel sowie Vorgaben zur kardiopulmonalen Reanimation und zu anderen kritischen medizinischen Interventionen, die das Leben verlängern oder die Lebensqualität beeinflussen können.

Dieser Archetyp ist dafür vorgesehen, im SLOT «Directive details» des Archetyps EVALUATION.advance_care_directive eingebettet zu werden. Er kann, sofern klinisch angemessen, auch in andere Archetypen eingebettet werden.">
			keywords = <"Patient, Präferenzen, Behandlung, Versorgung, Ziel", ...>
			misuse = <"Nicht zur Erfassung einer Verfügung zur Notfallversorgung und -behandlung verwenden. Verwenden Sie hierfür EVALUATION.emergency_care_treatment.">
		>
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"To record personal preferences for future care and treatment by the individual, including the overall goal of care and guidance about possible treatments and medical interventions that may impact length of life or quality of life.">
			use = <"Use to record personal preferences for future care and treatment, as asserted by the individual themselves. These preferences include the overall goal of care and guidance regarding cardiopulmonary resuscitation and other critical medical interventions that may prolong life or impact quality of life.

This archetype is designed to be nested in the 'Directive details' SLOT within the EVALUATION.advance_care_directive archetype. It may also be nested within other archetypes, as clinically appropriate.">
			keywords = <"patient", "preferences", "treatment", "care", "goal">
			misuse = <"Not to be used to record an 'Emergency care and treatment' directive - use EVALUATION.emergency_care_treatment for this purpose.">
			copyright = <"© openEHR Foundation">
		>
	>
	lifecycle_state = <"in_development">
	other_contributors = <>
	other_details = <
		["licence"] = <"This work is licensed under the Creative Commons Attribution-ShareAlike 4.0 International License. To view a copy of this license, visit http://creativecommons.org/licenses/by-sa/4.0/.">
		["custodian_organisation"] = <"openEHR Foundation">
		["references"] = <"Breault JL. DNR, DNAR, or AND? Is Language Important? Ochsner J. 2011 Winter;11(4):302-6. PMID: 22190879; PMCID: PMC3241061.

Salins N, Gursahani R, Mathur R, Iyer S, Macaden S, Simha N, Mani RK, Rajagopal MR. Definition of Terms Used in Limitation of Treatment and Providing Palliative Care at the End of Life: The Indian Council of Medical Research Commission Report. Indian J Crit Care Med. 2018 Apr;22(4):249-262. doi: 10.4103/ijccm.IJCCM_165_18. PMID: 29743764; PMCID: PMC5930529.

Thomas RL, Zubair MY, Hayes B, Ashby MA. Goals of care: a clinical framework for limitation of medical treatment. Med J Aust. 2014 Oct 20;201(8):452-5. doi: 10.5694/mja14.00623. PMID: 25332031.">
		["original_namespace"] = <"org.openehr">
		["original_publisher"] = <"openEHR Foundation">
		["custodian_namespace"] = <"org.openehr">
		["MD5-CAM-1.0.1"] = <"8B888397BB825773FC1D91DC8C2A19E8">
		["build_uid"] = <"ae163ddd-fa19-4e34-bbb1-5a8a8b859c55">
		["revision"] = <"0.0.1-alpha">
	>

definition
	CLUSTER[at0000] matches {    -- Treatment preferences
		items cardinality matches {1..*; unordered} matches {
			ELEMENT[at0001] occurrences matches {0..1} matches {    -- Goal of care
				value matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::
							at0002,    -- Living as long as possible
							at0003,    -- Balance longevity with quality of life
							at0004,    -- Quality of life and comfort
							at0005]    -- Unknown
						}
					}
				}
			}
			ELEMENT[at0006] occurrences matches {0..1} matches {    -- CPR preference
				value matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::
							at0007,    -- Attempt CPR
							at0008,    -- Do not attempt CPR
							at0009]    -- Unknown
						}
					}
				}
			}
			ELEMENT[at0010] occurrences matches {0..1} matches {    -- Hospital treatment
				value matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::
							at0011,    -- Admission to intensive care
							at0012,    -- Admission to hospital; no intensive care
							at0013,    -- Admission to hospital; under specific circumstances
							at0014]    -- No admission to hospital
						}
					}
				}
			}
			ELEMENT[at0015] occurrences matches {0..1} matches {    -- Hospital admission circumstances
				value matches {
					DV_TEXT matches {*}
				}
			}
			CLUSTER[at0016] occurrences matches {0..1} matches {    -- Per treatment
				items cardinality matches {1..*; unordered} matches {
					ELEMENT[at0017] occurrences matches {0..1} matches {    -- Treatment
						value matches {
							DV_CODED_TEXT matches {*}
						}
					}
					ELEMENT[at0018] occurrences matches {0..1} matches {    -- Preference
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0019,    -- Acceptable
									at0020,    -- Acceptable, under specified circumstances
									at0021,    -- Not acceptable
									at0022]    -- Unknown
								}
							}
						}
					}
					ELEMENT[at0023] occurrences matches {0..1} matches {    -- Specific circumstances
						value matches {
							DV_TEXT matches {*}
						}
					}
					ELEMENT[at0024] occurrences matches {0..1} matches {    -- Comment
						value matches {
							DV_TEXT matches {*}
						}
					}
				}
			}
			allow_archetype CLUSTER[at0025] occurrences matches {0..*} matches {    -- Additional details
				include
					archetype_id/value matches {/.*/}
			}
			ELEMENT[at0026] occurrences matches {0..1} matches {    -- Comment
				value matches {
					DV_TEXT matches {*}
				}
			}
		}
	}

ontology
	term_definitions = <
		["en"] = <
			items = <
				["at0000"] = <
					text = <"Treatment preferences">
					description = <"Personal preferences about the goal of care and acceptable future medical interventions, as asserted by the individual.">
				>
				["at0001"] = <
					text = <"Goal of care">
					description = <"Category describing the individual's preference for their own future treatment.">
				>
				["at0002"] = <
					text = <"Living as long as possible">
					description = <"">
				>
				["at0003"] = <
					text = <"Balance longevity with quality of life">
					description = <"">
				>
				["at0004"] = <
					text = <"Quality of life and comfort">
					description = <"">
				>
				["at0005"] = <
					text = <"Unknown">
					description = <"">
				>
				["at0006"] = <
					text = <"CPR preference">
					description = <"Preference for future cardiopulmonary resuscitation (CPR) intervention.">
				>
				["at0007"] = <
					text = <"Attempt CPR">
					description = <"All appropriate cardiopulmonary resuscitation treatments should be attempted to save or prolong life.">
				>
				["at0008"] = <
					text = <"Do not attempt CPR">
					description = <"No cardiopulmonary resuscitation treatments should be attempted to save or prolong life. All treatments to be focused on symptom relief and quality of life. Also known as 'Do not resuscitate (DNR)'; 'Do not attempt resuscitation (DNAR)'; 'Not for resuscitation (NFR)' or similar.">
				>
				["at0009"] = <
					text = <"Unknown">
					description = <"CPR guidance decision is not known.">
				>
				["at0010"] = <
					text = <"Hospital treatment">
					description = <"Preference for the acceptable level of hospital treatment.">
				>
				["at0011"] = <
					text = <"Admission to intensive care">
					description = <"">
				>
				["at0012"] = <
					text = <"Admission to hospital; no intensive care">
					description = <"">
				>
				["at0013"] = <
					text = <"Admission to hospital; under specific circumstances">
					description = <"">
				>
				["at0014"] = <
					text = <"No admission to hospital">
					description = <"">
				>
				["at0015"] = <
					text = <"Hospital admission circumstances">
					description = <"Description of the circumstances which would make a hospital admission acceptable.">
					comment = <"For example: bone fracture.">
				>
				["at0016"] = <
					text = <"Per treatment">
					description = <"Preference details about an identified medical treatment.">
				>
				["at0017"] = <
					text = <"Treatment">
					description = <"Name of the treatment.">
					comment = <"Coding of the treatment name with a terminology is recommended.">
				>
				["at0018"] = <
					text = <"Preference">
					description = <"Decision about the identified treatment.">
				>
				["at0019"] = <
					text = <"Acceptable">
					description = <"">
				>
				["at0020"] = <
					text = <"Acceptable, under specified circumstances">
					description = <"">
				>
				["at0021"] = <
					text = <"Not acceptable">
					description = <"">
				>
				["at0022"] = <
					text = <"Unknown">
					description = <"">
				>
				["at0023"] = <
					text = <"Specific circumstances">
					description = <"Description of the circumstances which would make the treatment acceptable.">
				>
				["at0024"] = <
					text = <"Comment">
					description = <"Additional narrative about the specified treatment preference, not captured in other fields.">
				>
				["at0025"] = <
					text = <"Additional details">
					description = <"Additional structured details about treatment preferences, not captured in other fields.">
				>
				["at0026"] = <
					text = <"Comment">
					description = <"Additional narrative about the all treatment preferences, not captured in other fields.">
				>
			>
		>
		["de"] = <
			items = <
				["at0000"] = <
					text = <"Behandlungspräferenzen">
					description = <"Persönliche Präferenzen hinsichtlich des Versorgungsziels und akzeptabler zukünftiger medizinischer Interventionen, wie sie von der betroffenen Person selbst geäussert wurden.">
				>
				["at0001"] = <
					text = <"Versorgungsziel">
					description = <"Kategorie zur Beschreibung der Präferenz der betroffenen Person hinsichtlich ihrer eigenen zukünftigen Behandlung.">
				>
				["at0002"] = <
					text = <"So lange wie möglich leben">
					description = <"">
				>
				["at0003"] = <
					text = <"Abwägung zwischen Lebensverlängerung und Lebensqualität">
					description = <"">
				>
				["at0004"] = <
					text = <"Lebensqualität und Wohlbefinden">
					description = <"">
				>
				["at0005"] = <
					text = <"Unbekannt">
					description = <"">
				>
				["at0006"] = <
					text = <"Präferenz zur kardiopulmonalen Reanimation">
					description = <"Präferenz hinsichtlich einer zukünftigen kardiopulmonalen Reanimation (CPR).">
				>
				["at0007"] = <
					text = <"Kardiopulmonale Reanimation durchführen">
					description = <"Alle angemessenen Massnahmen zur kardiopulmonalen Reanimation sollen durchgeführt werden, um das Leben zu retten oder zu verlängern.">
				>
				["at0008"] = <
					text = <"Keine kardiopulmonale Reanimation durchführen.">
					description = <"Es sollen keine Massnahmen zur kardiopulmonalen Reanimation durchgeführt werden, um das Leben zu retten oder zu verlängern. Alle Behandlungen sollen auf Symptomlinderung und Lebensqualität ausgerichtet sein. Auch bekannt als \"Keine Reanimation (DNR)\", \"Keine Reanimationsmassnahmen (DNAR)\", \"Nicht zur Reanimation vorgesehen (NFR)\" oder ähnlich.">
				>
				["at0009"] = <
					text = <"Unbekannt">
					description = <"Die Entscheidung zur kardiopulmonalen Reanimation ist nicht bekannt.">
				>
				["at0010"] = <
					text = <"Krankenhausbehandlung">
					description = <"Präferenz hinsichtlich des akzeptablen Umfangs der Krankenhausbehandlung.">
				>
				["at0011"] = <
					text = <"Aufnahme auf die Intensivstation">
					description = <"">
				>
				["at0012"] = <
					text = <"Aufnahme ins Krankenhaus, jedoch keine intensivmedizinische Behandlung.">
					description = <"">
				>
				["at0013"] = <
					text = <"Aufnahme ins Krankenhaus unter bestimmten Voraussetzungen.">
					description = <"">
				>
				["at0014"] = <
					text = <"Keine Aufnahme ins Krankenhaus.">
					description = <"">
				>
				["at0015"] = <
					text = <"Umstände einer Krankenhausaufnahme">
					description = <"Beschreibung der Umstände, unter denen eine Krankenhausaufnahme akzeptabel wäre.">
					comment = <"Zum Beispiel: Knochenfraktur.">
				>
				["at0016"] = <
					text = <"Je Behandlung">
					description = <"Details zu den Präferenzen hinsichtlich einer bestimmten medizinischen Behandlung.">
				>
				["at0017"] = <
					text = <"Behandlung">
					description = <"Name der Behandlung.">
					comment = <"Die Kodierung des Behandlungsnamens mit einer Terminologie wird empfohlen.">
				>
				["at0018"] = <
					text = <"Präferenz">
					description = <"Entscheidung hinsichtlich der angegebenen Behandlung.">
				>
				["at0019"] = <
					text = <"Akzeptabel">
					description = <"">
				>
				["at0020"] = <
					text = <"Akzeptabel unter bestimmten Voraussetzungen">
					description = <"">
				>
				["at0021"] = <
					text = <"Nicht akzeptabel">
					description = <"">
				>
				["at0022"] = <
					text = <"Unbekannt">
					description = <"">
				>
				["at0023"] = <
					text = <"Besondere Voraussetzungen">
					description = <"Beschreibung der Voraussetzungen, unter denen die Behandlung akzeptabel wäre.">
				>
				["at0024"] = <
					text = <"Kommentar">
					description = <"Zusätzlicher Freitext zur festgelegten Behandlungspräferenz, der in anderen Feldern nicht erfasst ist.">
				>
				["at0025"] = <
					text = <"Zusätzliche Details">
					description = <"Zusätzliche strukturierte Angaben zu Behandlungspräferenzen, die in anderen Feldern nicht erfasst sind.">
				>
				["at0026"] = <
					text = <"Kommentar">
					description = <"Zusätzlicher Freitext zu allen Behandlungspräferenzen, der nicht in anderen Feldern erfasst werden konnte.">
				>
			>
		>
	>
