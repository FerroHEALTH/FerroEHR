	openEHR-EHR-COMPOSITION.advance_care.v0

concept
	[at0000]	-- Advance care
language
	original_language = <[ISO_639-1::en]>
	translations = <
		["de"] = <
			language = <[ISO_639-1::de]>
			author = <
				["name"] = <"Olha Nikolaieva">
