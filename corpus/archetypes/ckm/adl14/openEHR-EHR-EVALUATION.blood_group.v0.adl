description
	original_author = <
		["name"] = <"Heather Leslie">
		["organisation"] = <"Atomica Informatics">
		["email"] = <"heather.leslie@atomicainformatics.com">
		["date"] = <"2022-06-27">
	>
	details = <
		["sv"] = <
			language = <[ISO_639-1::sv]>
			purpose = <"Att registrera en individs blodgrupp och RhD-status.">
			use = <"Används för att registrera en individs blodgrupp och RhD-status.

Eftersom en individs blodgrupp och RhD-status vanligtvis är stabila under hela livet har denna arketyp modellerats som en EVALUATION.">
			keywords = <"blod", "blodgrupp", "blodgruppering", "blodgruppsbestämning", "ABO", "rhesus", "Rh", "RhD">
			misuse = <"Ska inte användas för att registrera resultat från blodgrupps- och antigentester som kan behöva utföras vid olika tillfällen under en individs liv, exempelvis för att bekräfta blodgrupp och antigenstatus inför transfusion eller organtransplantation, under graviditet eller vid utredning av vissa tillstånd hos nyfödda. Använd CLUSTER.laboratory_test_analyte som nästlas i OBSERVATION.laboratory_test_result för att registrera resultatet från varje enskilt test.">
		>
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"To record the blood group and rhesus status of an individual.">
			use = <"Use to record the blood group and rhesus status of an individual.

As the blood group and rhesus status of an individual is usually stable over the life of an individual, this archetype has been modelled as an EVALUATION.">
			keywords = <"blood", "grouping", "rhesus">
			misuse = <"Not to be used to record the result of blood group and antigen test results which may need to be performed at various times over an individual's life - for example, to confirm their blood group and antigen status prior to transfusion, organ transplantation, in pregnancy and investigating certain neonatal conditions. Use the CLUSTER.laboratory_test_analyte nested within the OBSERVATION.laboratory_test_result archetype to record the result of each individual test.">
			copyright = <"© openEHR Foundation">
		>
		["ca"] = <
			language = <[ISO_639-1::ca]>
			purpose = <"Registrar el grup sanguini i el factor Rh d'un individu.">
			use = <"Es fa servir per registrar el grup sanguini i el factor Rh d'un individu.

Atès que el grup sanguini i el factor Rh d'un individu solen ser estables al llarg de la vida, aquest arquetip s'ha modelat com una EVALUATION.">
			keywords = <"sang", "agrupació", "Rh">
			misuse = <"No s'ha d'utilitzar per registrar el resultat de les proves de grup sanguini i antígens, les quals pot ser necessari realitzar diverses vegades al llarg de la vida d'un individu, per exemple, per confirmar el seu estat de grup sanguini i antígens abans d'una transfusió, un trasplantament d'òrgans, a l'embaràs i per investigar determinades afeccions neonatals. Utilitzeu l'arquetip CLUSTER.laboratory_test_analyte imbricat dins de l'arquetip OBSERVATION.laboratory_test_result per registrar el resultat de cada prova individual.">
		>
		["es"] = <
			language = <[ISO_639-1::es]>
			purpose = <"Registrar el grupo sanguíneo y el factor Rh de un individuo.">
			use = <"Se utiliza para registrar el grupo sanguíneo y el factor Rh de un individuo.

Dado que el grupo sanguíneo y el factor Rh de un individuo suelen ser estables a lo largo de su vida, este arquetipo se ha modelado como una EVALUATION.">
			keywords = <"sangre", "agrupación", "Rh">
			misuse = <"No debe utilizarse para registrar el resultado de las pruebas de grupo sanguíneo y antígenos, las cuales puede ser necesario realizar en varias ocasiones a lo largo de la vida de un individuo, por ejemplo, para confirmar su estado de grupo sanguíneo y antígenos antes de una transfusión, un trasplante de órganos, en el embarazo y para investigar determinadas afecciones neonatales. Utilice el arquetipo CLUSTER.laboratory_test_analyte anidado dentro del arquetipo OBSERVATION.laboratory_test_result para registrar el resultado de cada prueba individual.">
		>
	>
	lifecycle_state = <"in_development">
