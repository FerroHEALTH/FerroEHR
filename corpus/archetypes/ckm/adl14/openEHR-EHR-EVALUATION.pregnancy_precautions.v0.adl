definition
	EVALUATION[at0000] matches {    -- Pregnancy precautions
		data matches {
			ITEM_TREE[at0001] matches {    -- Item tree
				items cardinality matches {0..*; unordered} matches {
					ELEMENT[at0002] matches {    -- Precaution category
						value matches {
							DV_TEXT matches {*}
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0004,    -- Routine
									at0005,    -- Elevated
									at0006,    -- Known pregnancy
									at0016]    -- Not applicable
								}
							}
						}
					}
					ELEMENT[at0010] occurrences matches {0..1} matches {    -- Review date
						value matches {
							DV_DATE_TIME matches {*}
						}
					}
					ELEMENT[at0012] occurrences matches {0..1} matches {    -- Comment
						value matches {
							DV_TEXT matches {*}
						}
					}
				}
			}
		}
		protocol matches {
			ITEM_TREE[at0013] matches {    -- Item tree
				items cardinality matches {0..*; unordered} matches {
					ELEMENT[at0015] occurrences matches {0..1} matches {    -- Last updated
						value matches {
							DV_DATE_TIME matches {*}
						}
					}
					allow_archetype CLUSTER[at0014] occurrences matches {0..*} matches {    -- Extension
						include
							archetype_id/value matches {/.*/}
					}
				}
			}
		}
	}

ontology
	term_definitions = <
		["en"] = <
			items = <
				["at0000"] = <
					text = <"Pregnancy precautions">
					description = <"The category of pregnancy-related precautions currently applicable to an individual, to inform their care.">
				>
				["at0001"] = <
					text = <"Item tree">
					description = <"@ internal @">
				>
				["at0002"] = <
					text = <"Precaution category">
					description = <"The category of pregnancy-related precautions that currently applies to the individual.">
					comment = <"The category may be recorded by a clinician or proposed by a clinical system when a relevant clinical event is documented. ‘Elevated’ may apply, for example, when an individual is sexually active without contraception, planning pregnancy, following embryo transfer, or has a suspected pregnancy pending confirmation. ‘Not applicable’ may apply to individuals who are premenarchal or postmenopausal, or to those unable to carry a pregnancy following surgery, such as hysterectomy.">
				>
				["at0004"] = <
					text = <"Routine">
					description = <"Applies when pregnancy is physiologically possible and an unrecognised pregnancy cannot be excluded without further investigation. This is the default where no category has been recorded.">
				>
				["at0005"] = <
					text = <"Elevated">
					description = <"Applies when the likelihood of an unrecognised pregnancy is increased.">
				>
				["at0006"] = <
					text = <"Known pregnancy">
					description = <"Applies when pregnancy has been established by clinical assessment or investigation.">
				>
				["at0010"] = <
					text = <"Review date">
					description = <"The date when the category should be reassessed.">
					comment = <"Review of the current 'Precaution category' may confirm that the category remains applicable or result in a change to a different category. For example: a scheduled review of an 'Elevated' category following embryo transfer.">
				>
				["at0012"] = <
					text = <"Comment">
					description = <"Additional narrative about the pregnancy precautions not captured in other fields.">
				>
				["at0013"] = <
					text = <"Item tree">
					description = <"@ internal @">
				>
				["at0014"] = <
					text = <"Extension">
					description = <"Additional information required to extend the model with local content or to align with other reference models or formalisms.">
					comment = <"For example: local information requirements; or additional metadata to align with FHIR.">
				>
				["at0015"] = <
					text = <"Last updated">
					description = <"The date when these pregnancy precautions were last updated.">
				>
				["at0016"] = <
					text = <"Not applicable">
					description = <"Applies when pregnancy is physiologically not possible.">
				>
			>
		>
		["nb"] = <
			items = <
				["at0000"] = <
					text = <"Forholdsregler ved svangerskap">
					description = <"Kategorien av svangerskapsrelaterte forholdsregler som for tiden gjelder for et individ, som grunnlag for helsehjelpen.">
				>
				["at0001"] = <
					text = <"Elementtre">
					description = <"@ internal @">
				>
				["at0002"] = <
					text = <"Kategori av forholdsregler">
					description = <"Kategorien av svangerskapsrelaterte forholdsregler som for tiden gjelder for individet.">
					comment = <"Kategorien kan registreres av en kliniker eller foreslås av et klinisk system når en relevant klinisk hendelse dokumenteres. \"Økt\" kan for eksempel gjelde når et individ er seksuelt aktiv uten prevensjon, planlegger svangerskap, har gjennomgått embryooverføring eller har et antatt svangerskap som ennå ikke er bekreftet. \"Ikke aktuelt\" kan gjelde for individer før menarke eller etter menopause, eller for individer som ikke kan gjennomføre et svangerskap etter kirurgi, som hysterektomi.">
				>
				["at0004"] = <
					text = <"Standard">
					description = <"Gjelder når svangerskap er fysiologisk mulig og et uoppdaget svangerskap ikke kan utelukkes uten videre undersøkelser. Dette er standardkategorien når ingen kategori er registrert.">
				>
				["at0005"] = <
					text = <"Økt">
					description = <"Gjelder når sannsynligheten for et uoppdaget svangerskap er økt.">
				>
				["at0006"] = <
					text = <"Kjent svangerskap">
					description = <"Gjelder når svangerskap er fastslått ved klinisk vurdering eller undersøkelse.">
				>
				["at0010"] = <
					text = <"Dato for ny vurdering">
					description = <"Datoen da kategorien skal vurderes på nytt.">
					comment = <"En ny vurdering av gjeldende \"Kategori av forholdsregler\" kan bekrefte at kategorien fortsatt gjelder, eller føre til at den endres til en annen kategori. For eksempel: en planlagt ny vurdering av kategorien \"Skjerpede\" etter embryooverføring.">
				>
				["at0012"] = <
					text = <"Kommentar">
					description = <"Ytterligere fritekst om forholdsreglene ved svangerskap som ikke er dekket av andre felt.">
				>
				["at0013"] = <
					text = <"Elementtre">
					description = <"@ internal @">
				>
				["at0014"] = <
					text = <"Tilleggsinformasjon">
					description = <"Ytterligere informasjon som er nødvendig for å utvide modellen med lokalt innhold eller tilpasse den til andre referansemodeller eller formalismer.">
					comment = <"For eksempel: lokale informasjonskrav eller ytterligere metadata for å tilpasse modellen til FHIR.">
				>
				["at0015"] = <
					text = <"Sist oppdatert">
					description = <"Datoen da disse forholdsreglene ved svangerskap sist ble oppdatert.">
				>
				["at0016"] = <
					text = <"Ikke aktuelt">
					description = <"Gjelder når svangerskap ikke er fysiologisk mulig.">
				>
			>
		>
	>
