		["build_uid"] = <"de6b1322-1949-4d96-8c8b-e2b4e4f2b5a0">
		["ip_acknowledgements"] = <"The Mini Nutritional Assessment (MNA®) and Mini Nutritional Assessment–Short Form (MNA®-SF) are protected by copyright and are registered trademarks of Société des Produits Nestlé S.A., Vevey, Switzerland. © Société des Produits Nestlé S.A. 1994, Revision 2009. All rights reserved. Used with permission. MNA® is a registered trademark of Société des Produits Nestlé S.A.">
		["revision"] = <"0.0.1-alpha">
	>

definition
	OBSERVATION[at0000] matches {    -- Mini Nutritional Assessment - Short Form (MNA-SF)
		data matches {
			HISTORY[at0001] matches {    -- History
				events cardinality matches {1..*; unordered} matches {
					EVENT[at0002] occurrences matches {0..*} matches {    -- Any event
						data matches {
							ITEM_TREE[at0003] matches {    -- Tree
								items cardinality matches {0..*; unordered} matches {
									ELEMENT[at0005] matches {    -- Food intake decline in past 3 months
										value matches {
											0|[local::at0006],
											1|[local::at0007],
											2|[local::at0008]
										}
									}
									ELEMENT[at0009] matches {    -- Involuntary weight loss in past 3 months
										value matches {
											0|[local::at0010],
											1|[local::at0011],
											2|[local::at0012],
											3|[local::at0013]
										}
									}
									ELEMENT[at0014] matches {    -- Mobility
										value matches {
											0|[local::at0015],
											1|[local::at0016],
											2|[local::at0017]
										}
									}
									ELEMENT[at0018] matches {    -- Psychological stress or acute disease in past 3 months
										value matches {
											0|[local::at0019],
											2|[local::at0020]
										}
									}
									ELEMENT[at0021] matches {    -- Neuropsychological problems
										value matches {
											0|[local::at0022],
											1|[local::at0023],
											2|[local::at0024]
										}
									}
									ELEMENT[at0025] occurrences matches {0..1} matches {    -- Body Mass Index (BMI)
										value matches {
											0|[local::at0026],
											1|[local::at0027],
											2|[local::at0028],
											3|[local::at0029]
										}
									}
									ELEMENT[at0030] occurrences matches {0..1} matches {    -- Calf circumference (CC)
										value matches {
											0|[local::at0031],
											3|[local::at0032]
										}
									}
									ELEMENT[at0033] matches {    -- Screening score
										value matches {
											DV_COUNT matches {
												magnitude matches {|0..14|}
											}
										}
									}
									ELEMENT[at0034] matches {    -- Screening score interpretation
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0035,    -- Malnourished (0-7 points)
													at0036,    -- At risk of malnutrition (8-11 points)
													at0037]    -- Normal nutritional status (12-14 points)
												}
											}
										}
									}
									ELEMENT[at0038] occurrences matches {0..1} matches {    -- Comment
										value matches {
											DV_TEXT matches {*}
										}
									}
								}
							}
						}
					}
				}
			}
		}
		protocol matches {
			ITEM_TREE[at0004] matches {    -- Item tree
				items cardinality matches {0..*; unordered} matches {
					allow_archetype CLUSTER[at0039] occurrences matches {0..*} matches {    -- Extension
						include
							archetype_id/value matches {/.*/}
					}
				}
			}
		}
	}

ontology
	term_definitions = <
		["en"] = <
			items = <
				["at0000"] = <
					text = <"Mini Nutritional Assessment - Short Form (MNA-SF)">
					description = <"The MNA®-SF is a screening tool to help identify elderly patients who are malnourished or at risk of malnutrition. ">
				>
				["at0001"] = <
					text = <"History">
					description = <"@ internal @">
				>
				["at0002"] = <
					text = <"Any event">
					description = <"Default, unspecified point in time or interval event which may be explicitly defined in a template or at run-time.">
				>
				["at0003"] = <
					text = <"Tree">
					description = <"@ internal @">
				>
				["at0004"] = <
					text = <"Item tree">
					description = <"@ internal @">
				>
				["at0005"] = <
					text = <"Food intake decline in past 3 months">
					description = <"Question A: Has food intake declined over the past three months due to loss of appetite, digestive problems, chewing or swallowing difficulties?">
					Question = <"A">
				>
				["at0006"] = <
					text = <"Severe decrease in food intake">
					description = <"">
				>
				["at0007"] = <
					text = <"Moderate decrease in food intake">
					description = <"">
				>
				["at0008"] = <
					text = <"No decrease in food intake">
					description = <"">
				>
				["at0009"] = <
					text = <"Involuntary weight loss in past 3 months">
					description = <"Question B: Involuntary weight loss during the last three months?">
					Question = <"B">
				>
				["at0010"] = <
					text = <"Weight loss greater than 3 kg (6.6 pounds)">
					description = <"">
				>
				["at0011"] = <
					text = <"Does not know">
					description = <"">
				>
				["at0012"] = <
					text = <"Weight loss between 1 and 3 kg (2.2 and 6.6 pounds)">
					description = <"">
				>
				["at0013"] = <
					text = <"No weight loss">
					description = <"">
				>
				["at0014"] = <
					text = <"Mobility">
					description = <"Question C: Mobility?">
					Question = <"C">
				>
				["at0015"] = <
					text = <"Bed or chair bound">
					description = <"">
				>
				["at0016"] = <
					text = <"Able to get out of bed/chair, but does not go out">
					description = <"">
				>
				["at0017"] = <
					text = <"Goes out">
					description = <"">
				>
				["at0018"] = <
					text = <"Psychological stress or acute disease in past 3 months">
					description = <"Question D: Has the patient suffered psychological stress or acute disease in the past three months?">
					Question = <"D">
				>
				["at0019"] = <
					text = <"Yes">
					description = <"">
				>
				["at0020"] = <
					text = <"No">
					description = <"">
				>
				["at0021"] = <
					text = <"Neuropsychological problems">
					description = <"Question E: Neuropsychological problems?">
					Question = <"E">
				>
				["at0022"] = <
					text = <"Severe dementia or depression">
					description = <"">
				>
				["at0023"] = <
					text = <"Mild dementia">
					description = <"">
				>
				["at0024"] = <
					text = <"No psychological problems">
					description = <"">
				>
				["at0025"] = <
					text = <"Body Mass Index (BMI)">
					description = <"Question F1: Body mass index (BMI)? (weight in kg / height in m2)">
					comment = <"IF BMI IS NOT AVAILABLE, REPLACE QUESTION F1 WITH QUESTION F2.
DO NOT ANSWER QUESTION F2 IF QUESTION F1 IS ALREADY COMPLETED. ">
					Question = <"F1">
				>
				["at0026"] = <
					text = <"BMI less than 19">
					description = <"">
				>
				["at0027"] = <
					text = <"BMI 19 to less than 21">
					description = <"">
				>
				["at0028"] = <
					text = <"BMI 21 to less than 23">
					description = <"">
				>
				["at0029"] = <
					text = <"BMI 23 or greater">
					description = <"">
				>
				["at0030"] = <
					text = <"Calf circumference (CC)">
					description = <"Question F2: Calf circumference (CC) in cm">
					comment = <"DO NOT ANSWER QUESTION F2 IF QUESTION F1 IS ALREADY COMPLETED.">
					Question = <"F2">
				>
				["at0031"] = <
					text = <"CC less than 31">
					description = <"">
				>
				["at0032"] = <
					text = <"CC 31 or greater">
					description = <"">
				>
				["at0033"] = <
					text = <"Screening score">
					description = <"The score is calculated by summing the points assigned to each of the six questions (A-F), resulting in a total score between 0 and 14. When BMI is unavailable, calf circumference (F2) replaces the BMI question (F1).">
				>
				["at0034"] = <
					text = <"Screening score interpretation">
					description = <"The interpretation of the screening score result.">
				>
				["at0035"] = <
					text = <"Malnourished (0-7 points)">
					description = <"">
				>
				["at0036"] = <
					text = <"At risk of malnutrition (8-11 points)">
					description = <"">
				>
				["at0037"] = <
					text = <"Normal nutritional status (12-14 points)">
					description = <"">
				>
				["at0038"] = <
					text = <"Comment">
					description = <"Additional narrative about the measurement of the scale not captured in other fields.">
				>
				["at0039"] = <
					text = <"Extension">
					description = <"Additional information required to capture local content or to align with other reference models/formalisms.">
					comment = <"For example: local information requirements or additional metadata to align with FHIR or CIMI equivalents.">
				>
			>
		>
	>
