definition
	OBSERVATION[at0000] matches {    -- Physical activity screening questionnaire
		data matches {
			HISTORY[at0001] matches {    -- History
				events cardinality matches {0..*; unordered} matches {
					EVENT[at0002] occurrences matches {0..*} matches {    -- Any event
						data matches {
							ITEM_TREE[at0003] matches {    -- Tree
								items cardinality matches {0..*; unordered} matches {
									ELEMENT[at0034] occurrences matches {0..1} matches {    -- Screening purpose
										value matches {
											DV_TEXT matches {*}
										}
									}
									ELEMENT[at0039] occurrences matches {0..*} matches {    -- Any physical activity?
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0040,    -- Yes
													at0041,    -- No
													at0042,    -- Unknown
													at0045]    -- Unsure
												}
											}
											DV_TEXT matches {*}
											DV_BOOLEAN matches {*}
										}
									}
									ELEMENT[at0044] occurrences matches {0..1} matches {    -- Description
										value matches {
											DV_TEXT matches {*}
										}
									}
									CLUSTER[at0022] occurrences matches {0..*} matches {    -- Physical activity
										items cardinality matches {1..*; unordered} matches {
											ELEMENT[at0004] matches {    -- Physical activity name
												value matches {
													DV_TEXT matches {*}
												}
											}
											ELEMENT[at0005] occurrences matches {0..1} matches {    -- Specific physical activity?
												value matches {
													DV_CODED_TEXT matches {
														defining_code matches {
															[local::
															at0023,    -- Yes
															at0024,    -- No
															at0027,    -- Unknown
															at0046]    -- Unsure
														}
													}
													DV_TEXT matches {*}
													DV_BOOLEAN matches {*}
												}
											}
											ELEMENT[at0037] occurrences matches {0..*} matches {    -- Timing
												value matches {
													DV_DATE_TIME matches {*}
													DV_INTERVAL<DV_DATE_TIME> matches {*}
													DV_TEXT matches {*}
													DV_DURATION matches {*}
													DV_INTERVAL<DV_DURATION> matches {*}
												}
											}
											allow_archetype CLUSTER[at0036] occurrences matches {0..*} matches {    -- Additional details
												include
													archetype_id/value matches {/.*/}
											}
											ELEMENT[at0035] occurrences matches {0..1} matches {    -- Comment
												value matches {
													DV_TEXT matches {*}
												}
											}
										}
									}
									allow_archetype CLUSTER[at0043] occurrences matches {0..*} matches {    -- Additional details
										include
											archetype_id/value matches {/.*/}
									}
								}
							}
						}
					}
				}
			}
		}
		protocol matches {
			ITEM_TREE[at0007] matches {    -- Item tree
				items cardinality matches {0..*; unordered} matches {
					allow_archetype CLUSTER[at0021] occurrences matches {0..*} matches {    -- Extension
						include
							archetype_id/value matches {/.*/}
					}
				}
			}
		}
	}

ontology
	terminologies_available = <"SNOMED-CT", ...>
	term_definitions = <
		["en"] = <
			items = <
				["at0000"] = <
					text = <"Physical activity screening questionnaire">
					description = <"Series of questions and associated answers used to screen for physical activity.">
					comment = <"The answers may be self-reported.">
				>
				["at0001"] = <
					text = <"History">
					description = <"@ internal @">
				>
				["at0002"] = <
					text = <"Any event">
					description = <"Default, unspecified point in time or interval event which may be explicitly defined in a template or at run-time.">
				>
				["at0003"] = <
					text = <"Tree">
					description = <"@ internal @">
				>
				["at0004"] = <
					text = <"Physical activity name">
					description = <"Name of a specific physical activity or grouping of physical activities.">
					comment = <"For example: Plays football, mall walker. Coding of the 'Physical activity name' with a terminology is preferred, where possible.">
				>
				["at0005"] = <
					text = <"Specific physical activity?">
					description = <"Is there a history of the physical activity?">
					comment = <"In a template, the data element would typically be renamed to match the specific question being asked. The proposed value set can be adapted for local use by using the DV_TEXT or the DV_BOOLEAN datatypes choice to match each specific use case.">
				>
				["at0007"] = <
					text = <"Item tree">
					description = <"@ internal @">
				>
				["at0021"] = <
					text = <"Extension">
					description = <"Additional information required to extend the model with local content or to align with other reference models or formalisms.">
					comment = <"For example: local information requirements; or additional metadata to align with FHIR.">
				>
				["at0022"] = <
					text = <"Physical activity">
					description = <"Details about a specific physical activity or grouping of physical activities relevant for the screening purpose.">
					comment = <"Use separate instances of this CLUSTER to differentiate between specific activities or groupings of activities.">
				>
				["at0023"] = <
					text = <"Yes">
					description = <"">
				>
				["at0024"] = <
					text = <"No">
					description = <"">
				>
				["at0027"] = <
					text = <"Unknown">
					description = <"">
				>
				["at0034"] = <
					text = <"Screening purpose">
					description = <"The context or reason for screening.">
					comment = <"This data element is intended to provide collection context for the question/answer groups when queried at a later date. It is not expected that this data element will be exposed to the individual, but only stored in data.
For example: pre-admission screening or the name of the actual questionnaire.">
				>
				["at0035"] = <
					text = <"Comment">
					description = <"Additional narrative about a specific physical activity question, not captured in other fields.">
				>
				["at0036"] = <
					text = <"Additional details">
					description = <"Additional details or questions about the specific physical activity.">
				>
				["at0037"] = <
					text = <"Timing">
					description = <"Indication of timing related to the physical activity.">
					comment = <"The 'Timing' data element has deliberately been loosely modelled to support the myriad of ways that it can be used in questionnaires to capture when an activity was performed. The specific and intended semantics can be further clarified in a template. For example: the actual date and/or time; the start and stop time for the physical activity; the interval of time during which the physical activity was carried out; the duration of the physical activity; the age of the individual at the time of the physical activity; or the duration of time since it occurred. A partial date is valid, using the DV_DATE_TIME data type, to record only a year.">
				>
				["at0039"] = <
					text = <"Any physical activity?">
					description = <"Is there a history of physical activity relevant for the screening purpose?">
					comment = <"In a template, the data element would typically be renamed to match the specific question being asked. The proposed value set can be adapted for local use by using the DV_TEXT or the DV_BOOLEAN datatypes choice to match each specific use case.">
				>
				["at0040"] = <
					text = <"Yes">
					description = <"">
				>
				["at0041"] = <
					text = <"No">
					description = <"">
				>
				["at0042"] = <
					text = <"Unknown">
					description = <"">
				>
				["at0043"] = <
					text = <"Additional details">
					description = <"Structured details or questions about screening for physical activity.">
				>
				["at0044"] = <
					text = <"Description">
					description = <"Narrative description about the history of any physical activities relevant for the screening purpose.">
				>
				["at0045"] = <
					text = <"Unsure">
					description = <"">
				>
				["at0046"] = <
					text = <"Unsure">
					description = <"">
				>
			>
		>
		["nb"] = <
			items = <
				["at0000"] = <
					text = <"Kartleggingsspørsmål om fysisk aktivitet">
					description = <"Spørsmål og tilhørende svar som brukes til å kartlegge fysisk aktivitet.">
					comment = <"Svarene kan være selvrapporterte.">
				>
				["at0001"] = <
					text = <"History">
					description = <"@ internal @">
				>
				["at0002"] = <
					text = <"Uspesifisert hendelse">
					description = <"Standard, uspesifisert tidspunkt eller tidsintervall som kan defineres mer eksplisitt i et templat eller i en applikasjon.">
				>
				["at0003"] = <
					text = <"Tree">
					description = <"@ internal @">
				>
				["at0004"] = <
					text = <"Navn på fysisk aktivitet">
					description = <"Navnet på en spesifikk fysisk aktivitet eller gruppe av fysiske aktiviteter.">
					comment = <"For eksempel: Spiller fotball, går tur i kjøpesenter. Koding av \"Navn på fysisk aktivitet\" med en terminologi foretrekkes der det er mulig.">
				>
				["at0005"] = <
					text = <"Spesifikk fysisk aktivitet?">
					description = <"Har den spesifiserte fysiske aktiviteten funnet sted?">
					comment = <"Navnet på dataelementet kan omformuleres til det spesifikke spørsmålet i et templat eller brukergrensesnitt. Det foreslåtte verdisettet kan tilpasses/endres i det enkelte bruksområde ved å benytte de alternative datatypene DV_TEXT eller DV_BOOLEAN.">
				>
				["at0007"] = <
					text = <"Item tree">
					description = <"@ internal @">
				>
				["at0021"] = <
					text = <"Tilleggsinformasjon">
					description = <"Ytterligere informasjon som trengs for å kunne registrere lokalt definert innhold eller for å tilpasse til andre referansemodeller/formalismer.">
					comment = <"For eksempel lokale informasjonsbehov eller ytterligere metadata for å kunne tilpasse til tilsvarende konsepter i FHIR.">
				>
				["at0022"] = <
					text = <"Fysisk aktivitet">
					description = <"Detaljer om en spesifikk fysisk aktivitet eller en gruppe av fysiske aktiviteter som er innenfor kartleggingsformålet.">
					comment = <"Bruk separate instanser av dette CLUSTER'et for å skille mellom spesifikk fysisk aktivitet eller gruppering av fysiske aktiviteter.">
				>
				["at0023"] = <
					text = <"Ja">
					description = <"">
				>
				["at0024"] = <
					text = <"Nei">
					description = <"">
				>
				["at0027"] = <
					text = <"Ukjent">
					description = <"">
				>
				["at0034"] = <
					text = <"Kartleggingsformål">
					description = <"Konteksten eller årsaken for kartleggingen.">
					comment = <"Dette dataelementet er ment for å sette en kontekst for spørsmålene, dersom man senere ønsker å gjøre spørringer på dataene. Det er ikke forventet at dette dataelementet skal være synlig for en bruker av skjemaet, men kun tilgjengelig i de lagrede dataene. For eksempel: \"Preoperativ screening\" eller navnet på det faktiske spørreskjemaet.">
				>
				["at0035"] = <
					text = <"Kommentar">
					description = <"Ytterligere fritekst om den spesifikke fysiske aktiviteten som ikke er omfattet av andre felt.">
				>
				["at0036"] = <
					text = <"Ytterligere detaljer">
					description = <"Strukturerte detaljer eller spørsmål om den spesifikke fysiske aktiviteten.">
				>
				["at0037"] = <
					text = <"Tidsangivelse">
					description = <"Tidsangivelse for den fysiske aktiviteten.">
					comment = <"Elementet \"Tidsangivelse\" er med hensikt løst modellert for å legge til rette for myriadene av mulighetene det kan brukes i spørreskjemaer for å fange når en undersøkelse ble utført. Den spesifikke og tiltenkte semantikken kan bli ytterligere klargjort i et templat. For eksempel: Den fysiske aktivitetens faktiske dato og/eller klokkeslett, start- og sluttid for den fysiske aktiviteten, et tidsintervall for når den fysiske aktiviteten ble gjort, varigheten av en fysisk aktivitet, individets alder på tidspunktet for den fysiske aktiviteten, eller hvor lenge det siden den ble gjort. Kan være en delvis dato, for eksempel bare år, ved å bruke datatypen DV_DATE_TIME.">
				>
				["at0039"] = <
					text = <"Noen form for fysisk aktivitet?">
					description = <"Er det tidligere fysisk aktivitet som er innenfor karleggingsformålet?">
					comment = <"Navnet på dataelementet kan omformuleres til det spesifikke spørsmålet i et templat eller brukergrensesnitt. Det foreslåtte verdisettet kan tilpasses/endres i det enkelte bruksområde ved å benytte de alternative datatypene DV_TEXT eller DV_BOOLEAN.">
				>
				["at0040"] = <
					text = <"Ja">
					description = <"">
				>
				["at0041"] = <
					text = <"Nei">
					description = <"">
				>
				["at0042"] = <
					text = <"Ukjent">
					description = <"">
				>
				["at0043"] = <
					text = <"Ytterligere detaljer">
					description = <"Strukturerte detaljer eller spørsmål om fysiske aktivitet.">
				>
				["at0044"] = <
					text = <"Beskrivelse">
					description = <"Fritekstbeskrivelse av fysisk aktivitet som er innenfor kartleggingsformålet.">
				>
				["at0045"] = <
					text = <"Usikker">
					description = <"">
				>
				["at0046"] = <
					text = <"Usikker">
					description = <"">
				>
			>
		>
		["de"] = <
			items = <
				["at0000"] = <
					text = <"Fragebogen zum Screening der körperlichen Aktivität">
					description = <"Reihe von Fragen und zugehörigen Antworten zum Screening der körperlichen Aktivität.">
					comment = <"Die Antworten können selbstberichtet sein.">
				>
				["at0001"] = <
					text = <"History">
					description = <"@ internal @">
				>
				["at0002"] = <
					text = <"Beliebiges Ereignis">
					description = <"Standardmäßiger, nicht näher beschriebener Zeitpunkt oder Intervall Ereignis welches in einem Template oder bei der Anwendung genauer definiert werden kann.">
				>
				["at0003"] = <
					text = <"Tree">
					description = <"@ internal @">
				>
				["at0004"] = <
					text = <"Name der körperlichen Aktivität">
					description = <"Name einer bestimmten körperlichen Aktivität oder einer Gruppe körperlicher Aktivitäten.">
					comment = <"Zum Beispiel: Spielt Fussball, geht in Einkaufszentren spazieren. Kodierung von ‘Name der körperlichen Aktivität’ mit einer Terminologie wird nach Möglichkeit bevorzugt.">
				>
				["at0005"] = <
					text = <"Bestimmte körperliche Aktivität?">
					description = <"Gibt es eine Vorgeschichte zu dieser körperlichen Aktivität?">
					comment = <"In einem Template würde das Datenelement normalerweise in die spezifische gestellte Frage umbenannt. Der vorgeschlagene Wertesatz kann für die lokale Verwendung angepasst werden, indem die Datentypauswahl DV_TEXT oder DV_BOOLEAN verwendet wird, um jedem spezifischen Anwendungsfall zu entsprechen.">
				>
				["at0007"] = <
					text = <"Item tree">
					description = <"@ internal @">
				>
				["at0021"] = <
					text = <"Erweiterung">
					description = <"Additional information required to extend the model with local content or to align with other reference models or formalisms.">
					comment = <"Zum Beispiel: Lokaler Informationsbedarf oder zusätzliche Metadaten zur Anpassung an FHIR.">
				>
				["at0022"] = <
					text = <"Körperliche Aktivität">
					description = <"Details zu einer bestimmten körperlichen Aktivität oder einer Gruppe körperlicher Aktivitäten, die für den Zweck des Screenings relevant sind.">
					comment = <"Verwenden Sie separate Instanzen dieses CLUSTER, um zwischen bestimmten Aktivitäten oder Gruppen von Aktivitäten zu unterscheiden.">
				>
				["at0023"] = <
					text = <"Ja">
					description = <"">
				>
				["at0024"] = <
					text = <"Nein">
					description = <"">
				>
				["at0027"] = <
					text = <"Unbekannt">
					description = <"">
				>
				["at0034"] = <
					text = <"Zweck des Screenings">
					description = <"Der Kontext oder Grund für das Screening.">
					comment = <"Dieses Datenelement soll bei einer späteren Abfrage den Erhebungskontext für die Frage/Antwort-Gruppen bereitstellen. Es ist nicht vorgesehen, dass dieses Datenelement der Person angezeigt wird; es wird lediglich in den Daten gespeichert.
Zum Beispiel: Screening vor der Aufnahme oder der Name des eigentlichen Fragebogens.">
				>
				["at0035"] = <
					text = <"Kommentar">
					description = <"Zusätzliche Beschreibung zu einer spezifischen Frage zur körperlichen Aktivität, die nicht in den übrigen Feldern abgedeckt wurde.">
				>
				["at0036"] = <
					text = <"Zusätzliche Angaben">
					description = <"Zusätzliche Angaben oder Fragen zur spezifischen körperlichen Aktivität.">
				>
				["at0037"] = <
					text = <"Zeitangabe">
					description = <"Angabe des Zeitpunkts im Zusammenhang mit der körperlichen Aktivität.">
					comment = <"Das Datenelement ‘Zeitangabe’ wurde bewusst locker modelliert, um die unzähligen Möglichkeiten zu unterstützen, mit denen es in Fragebögen verwendet werden kann, um zu erfassen, wann eine Aktivität ausgeübt wurde. Die spezifische und beabsichtigte Semantik kann in einem Template weiter geklärt werden. Zum Beispiel: das tatsächliche Datum und/oder die Uhrzeit; die Start- und Endzeit der körperlichen Aktivität; der Zeitraum, in dem die körperliche Aktivität ausgeübt wurde; die Dauer der körperlichen Aktivität; das Alter der Person zum Zeitpunkt der körperlichen Aktivität; oder die Zeitdauer seit der Ausübung der körperlichen Aktivität. Unter Verwendung des Datentyps DV_DATE_TIME ist ein Teildatum zulässig, um nur ein Jahr zu erfassen.">
				>
				["at0039"] = <
					text = <"Irgendeine körperliche Aktivität?">
					description = <"Gibt es eine Vorgeschichte körperlicher Aktivität, die für den Zweck des Screenings relevant ist?">
					comment = <"In einem Template würde das Datenelement normalerweise in die spezifische gestellte Frage umbenannt. Der vorgeschlagene Wertesatz kann für die lokale Verwendung angepasst werden, indem die Datentypauswahl DV_TEXT oder DV_BOOLEAN verwendet wird, um jedem spezifischen Anwendungsfall zu entsprechen.">
				>
				["at0040"] = <
					text = <"Ja">
					description = <"">
				>
