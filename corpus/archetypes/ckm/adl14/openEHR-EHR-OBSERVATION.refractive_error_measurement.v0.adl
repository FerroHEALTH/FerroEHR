					text = <"*Set interpupillary distance (en)">
					description = <"">
					comment = <"*Not an observation or measurement of the tested individual's true interpupillary distance, but rather a recording of the interpupillary distance which was set in the testing device (such as a phoropter) during the measurement of refractive error. 
Measurements of Interpupillary distances will be recorded in another archetype.  (en)">
				>
