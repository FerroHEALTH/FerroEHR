					text = <"*Method (en)">
					description = <"* The type of method that was used to perform the measurement. (en)">
				>
				["at0150"] = <
					text = <"*Automated objective refractometry (en)">
					description = <"*The measurement was performed by automated objective refractomery, commonly refered to as autorefractometry. (en)">
				>
