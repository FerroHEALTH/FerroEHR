archetype (adl_version=1.4; uid=7787049b-a4ab-44e5-b99d-fd173248eedc)
	openEHR-EHR-OBSERVATION.specular_microscopy.v0

concept
	[at0000]	-- Corneal specular microscopy
language
	original_language = <[ISO_639-1::en]>
description
	original_author = <
		["name"] = <"Lars Fuhrmann">
		["organisation"] = <"German ophthalmological Society">
		["email"] = <"lars.fuhrmann@dog.org">
		["date"] = <"2026-04-23">
	>
	details = <
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"To record quantitative measurements of specular microscopy.">
			use = <"Use to record the results of corneal specular microscopy, including endothelial cell density, cell size variation, and cell morphology.

The primary use case is monitoring corneal endothelial health before and after intraocular surgery, including glaucoma drainage device surgery, cataract surgery, corneal transplantation, and long-term contact lens wear.

An event time represents the date/time of image acquisition. Multiple events may be recorded to represent serial assessments.

Aligned with the Royal College of Ophthalmologists Glaucoma Procedure Dataset (2024/PROF/483) requirement to record central endothelial cell density.">
			keywords = <"Cornea, specular microscopy, ECD, Endothelial Cell Density.", ...>
			misuse = <"Do not use for recording full corneal topography or pachymetry results — use a dedicated corneal topography or pachymetry archetype
Do not use for recording confocal microscopy results.">
			copyright = <"© openEHR Foundation">
		>
	>
	lifecycle_state = <"in_development">
	other_contributors = <"Lars Fuhrmann, German Ophthalmological Society (DOG)", ...>
	other_details = <
		["licence"] = <"This work is licensed under the Creative Commons Attribution-ShareAlike 4.0 International License. To view a copy of this license, visit http://creativecommons.org/licenses/by-sa/4.0/.">
		["custodian_organisation"] = <"openEHR Foundation">
		["references"] = <"McCarey BE, Edelhauser HF, Lynn MJ. Review of corneal endothelial specular microscopy for FDA clinical trials of refractive procedures, surgical devices, and new intraocular drugs and solutions. Cornea. 2008;27(1):1-16.
Royal College of Ophthalmologists. Glaucoma Procedure Dataset. 2024/PROF/483. May 2024.">
		["original_namespace"] = <"org.openehr">
		["original_publisher"] = <"openEHR Foundation">
		["custodian_namespace"] = <"org.openehr">
		["MD5-CAM-1.0.1"] = <"10927F39F5C331C1EE0E0F8FAB6E6CDF">
		["build_uid"] = <"34a2d9a1-9de1-4a46-8dc6-9a0d36c72009">
		["revision"] = <"0.0.1-alpha">
	>

definition
	OBSERVATION[at0000] matches {    -- Corneal specular microscopy
		data matches {
			HISTORY[at0001] matches {    -- History
				events cardinality matches {1..*; unordered} matches {
					EVENT[at0002] occurrences matches {0..*} matches {    -- Any event
						data matches {
							ITEM_TREE[at0003] matches {    -- Tree
								items cardinality matches {0..*; unordered} matches {
									ELEMENT[at0005] occurrences matches {0..1} matches {    -- Eye examined
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0018,    -- Right eye
													at0019]    -- Left eye
												}
											}
										}
									}
									ELEMENT[at0034] occurrences matches {0..1} matches {    -- Radial localisation
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0037,    -- central
													at0038,    -- paracentral
													at0039,    -- mid-peripheral
													at0040]    -- peripheral
												}
											}
										}
									}
									ELEMENT[at0036] occurrences matches {0..1} matches {    -- Circumferential localisation
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0053,    -- superior
													at0054,    -- superior-temporal
													at0055,    -- temporal
													at0056,    -- temporal-inferior
													at0057,    -- inferior
													at0058,    -- inferior-nasal
													at0059,    -- nasal
													at0060]    -- nasal-superior
												}
											}
											1|[local::at0041],
											2|[local::at0042],
											3|[local::at0043],
											4|[local::at0044],
											5|[local::at0045],
											6|[local::at0046],
											7|[local::at0047],
											8|[local::at0048],
											9|[local::at0049],
											10|[local::at0050],
											11|[local::at0051],
											12|[local::at0052]
										}
									}
									ELEMENT[at0006] matches {    -- Endothelial cell density
										value matches {
											C_DV_QUANTITY <
												
												list = <
													["1"] = <
														units = <"cells/mm2">
														magnitude = <|>=0.0|>
														precision = <|0|>
													>
												>
											>
										}
									}
									ELEMENT[at0035] occurrences matches {0..1} matches {    -- Number of recognised cells
										value matches {
											DV_COUNT matches {*}
										}
									}
									ELEMENT[at0007] occurrences matches {0..1} matches {    -- Mean cell area
										value matches {
											C_DV_QUANTITY <
												property = <[openehr::335]>
												list = <
													["1"] = <
														units = <"um2">
														magnitude = <|>=0.0|>
														precision = <|1|>
													>
												>
											>
										}
									}
									ELEMENT[at0008] occurrences matches {0..1} matches {    -- Coefficient of variation
										value matches {
											DV_PROPORTION matches {
												type matches {2}
											}
										}
									}
									ELEMENT[at0009] occurrences matches {0..1} matches {    -- Percentage of hexagonal cells
										value matches {
											DV_PROPORTION matches {
												numerator matches {|0.0..100.0|}
												type matches {2}
											}
										}
									}
									ELEMENT[at0010] occurrences matches {0..1} matches {    -- Interpretation
										value matches {
											DV_TEXT matches {*}
										}
									}
									ELEMENT[at0029] occurrences matches {0..1} matches {    -- Comment
										value matches {
											DV_TEXT matches {*}
										}
									}
									allow_archetype CLUSTER[at0027] occurrences matches {0..*} matches {    -- Test not done
										include
											archetype_id/value matches {/openEHR-EHR-CLUSTER\.exclusion_exam\.v1/}
									}
									ELEMENT[at0011] occurrences matches {0..1} matches {    -- Overall interpretation
										value matches {
											DV_TEXT matches {*}
										}
									}
									ELEMENT[at0012] occurrences matches {0..1} matches {    -- Confounding factors
										value matches {
											DV_TEXT matches {*}
										}
									}
									allow_archetype CLUSTER[at0028] occurrences matches {0..*} matches {    -- Device details
										include
											archetype_id/value matches {/openEHR-EHR-CLUSTER\.device\.v1/}
									}
								}
							}
						}
						state matches {
							ITEM_TREE[at0013] matches {*}    -- ItemTree
						}
					}
				}
			}
		}
		protocol matches {
			ITEM_TREE[at0015] matches {    -- ItemTree
				items cardinality matches {0..*; unordered} matches {
					allow_archetype CLUSTER[at0025] occurrences matches {0..*} matches {    -- Extension
						include
							archetype_id/value matches {/.*/}
					}
				}
			}
		}
	}

ontology
	term_definitions = <
		["en"] = <
			items = <
				["at0000"] = <
					text = <"Corneal specular microscopy">
					description = <"Measurements of corneal endothelial cell quantity, density and morphology obtained by specular microscopy.">
				>
				["at0001"] = <
					text = <"History">
					description = <"@ internal @">
				>
				["at0002"] = <
					text = <"Any event">
					description = <"Default, unspecified point-in-time event which may be explicitly defined in a template or at run time.">
				>
				["at0003"] = <
					text = <"Tree">
					description = <"@ internal @">
				>
				["at0005"] = <
					text = <"Eye examined">
					description = <"Identification of the eye from which the specular microscopy results were obtained.">
				>
				["at0006"] = <
					text = <"Endothelial cell density">
					description = <"The number of corneal endothelial cells per mm², measured in the central cornea by specular microscopy.">
				>
				["at0007"] = <
					text = <"Mean cell area">
					description = <"The mean area of individual endothelial cells in square micrometres (µm²). Reciprocally related to cell density.">
				>
				["at0008"] = <
					text = <"Coefficient of variation">
					description = <"Coefficient of variation (CV) of endothelial cell area, expressed as a percentage. A measure of cell size variability. ">
				>
				["at0009"] = <
					text = <"Percentage of hexagonal cells">
					description = <"Percentage of corneal endothelial cells that are hexagonal (six-sided). A measure of pleomorphism, also called Hexagonality or 6A">
				>
				["at0010"] = <
					text = <"Interpretation">
					description = <"Clinical interpretation of the specular microscopy findings for this eye.">
				>
				["at0011"] = <
					text = <"Overall interpretation">
					description = <"Overall clinical interpretation of the specular microscopy examination, combining findings from both eyes where applicable.">
				>
				["at0012"] = <
					text = <"Confounding factors">
					description = <"Factors that may have affected the quality or reliability of the specular microscopy images, such as poor fixation, corneal oedema, or patient cooperation.">
				>
				["at0013"] = <
					text = <"ItemTree">
					description = <"@ internal @">
				>
				["at0015"] = <
					text = <"ItemTree">
					description = <"@ internal @">
				>
				["at0018"] = <
					text = <"Right eye">
					description = <"The right eye was examined.">
				>
				["at0019"] = <
					text = <"Left eye">
					description = <"The left eye was examined.">
				>
				["at0025"] = <
					text = <"Extension">
					description = <"Additional information required to capture local content or to align with other reference models/formalisms.">
