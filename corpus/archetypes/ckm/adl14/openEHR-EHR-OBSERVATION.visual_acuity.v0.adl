				["at0586"] = <
					text = <"Perseptuell oppgave">
					description = <"Typen perseptuelt endepunkt som resultatet representerer.">
					comment = <"Lesevisus uttrykt i logMAR omtales noen ganger som logRAD.
Supplerende resultater fra lesevisusundersøkelser kan registreres via SLOT-en 'Supplerende resultater'.">
				>
				["at0587"] = <
					text = <"Minste oppløsbare visus">
					description = <"Et mål på evnen til å skille to atskilte objekter fra hverandre.">
				>
				["at0588"] = <
					text = <"Lesevisus">
					description = <"Et mål på den minste synsvinkelen der tekst kan leses.">
				>
				["at0589"] = <
					text = <"Lysadaptasjonstilstand">
					description = <"Den antatte adaptasjonstilstanden til synssystemet under undersøkelsen.">
					comment = <"Dette er en kategorisk beskrivelse av individets antatte netthinneadaptasjon, ikke en måling av belysningen i omgivelsene.">
				>
				["at0590"] = <
					text = <"Fotopisk">
					description = <"Individet er adaptert til forhold med høy luminans.">
				>
				["at0591"] = <
					text = <"Mesopisk">
					description = <"Individet er i en overgangstilstand mellom fotopisk og skotopisk adaptasjon.">
				>
				["at0592"] = <
					text = <"Skotopisk">
					description = <"Individet er adaptert til forhold med lav luminans.">
				>
				["at0593"] = <
					text = <"N 7">
					description = <"N-skriftstørrelse 7.">
				>
				["at0594"] = <
					text = <"Ingen lyssans">
					description = <"Individet klarte ikke å identifisere fravær eller tilstedeværelse av lys.">
				>
				["at0595"] = <
					text = <"Lyssans">
					description = <"Individet identifiserte korrekt fravær eller tilstedeværelse av lys.">
				>
				["at0596"] = <
					text = <"Håndbevegelser">
					description = <"Individet oppfattet håndbevegelser.">
				>
				["at0597"] = <
					text = <"Fingertelling">
					description = <"Individet telte fingre korrekt.">
				>
				["at0598"] = <
					text = <"Bailey-Lovie-tavle">
					description = <"En Bailey-Lovie-tavle ble brukt.">
				>
				["at0599"] = <
					text = <"E-ETDRS-test">
					description = <"En elektronisk eller datamaskinbasert ETDRS-undersøkelsesprotokoll ble brukt.">
				>
				["at0600"] = <
					text = <"ATS-HOTV-test">
					description = <"Undersøkelsesprotokollen HOTV fra Amblyopia Treatment Study ble brukt.">
				>
				["at0601"] = <
					text = <"Minste synbare visus">
					description = <"Et mål på evnen til å oppdage et visuelt objekt.">
				>
				["at0602"] = <
					text = <"Minste gjenkjennbare visus">
					description = <"Et mål på evnen til å gjenkjenne og identifisere et visuelt objekt.">
				>
				["at0603"] = <
