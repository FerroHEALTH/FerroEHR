				["at0586"] = <
					text = <"*Perceptual task (en)">
					description = <"*The type of perceptual task  endpoint that the result represents. (en)">
					comment = <"*Reading visual acuity expressed LogMAR is sometimes referred to as LogRAD. 
Supplementary results of reading visual acuity tests can be recorded via the 'supplementary results' slot.  (en)">
				>
				["at0587"] = <
					text = <"*Minimum resolvable visual acuity (en)">
					description = <"*A measurement of the ability to distinguish two separate objects as distinct. (en)">
				>
				["at0588"] = <
					text = <"*Reading acuity (en)">
					description = <"*A measurement of the smallest visual angle at which text can be read. (en)">
				>
				["at0589"] = <
					text = <"*Light adaptation state (en)">
					description = <"*The presumed adaptation state of the visual system during testing. (en)">
					comment = <"*This is a categorical description of the individual's presumed retinal adaptation state, not a measurement of the ambient lighting. (en)">
				>
				["at0590"] = <
					text = <"*Photopic (en)">
					description = <"*The individual is adapted to high luminance conditions. (en)">
				>
				["at0591"] = <
					text = <"*Mesopic (en)">
					description = <"*The individual is in a transitional adaptation state between photopic and scotopic. (en)">
				>
				["at0592"] = <
					text = <"*Scotopic (en)">
					description = <"*The individual is adapted to low luminance conditions. (en)">
				>
				["at0593"] = <
					text = <"*N 7 (en)">
					description = <"*N font size 7 (en)">
				>
				["at0594"] = <
					text = <"*No light perception (en)">
					description = <"*The individual was unable to identify the absence or presence of light. (en)">
				>
				["at0595"] = <
					text = <"*Light perception (en)">
					description = <"*The individual correctly identified the absence or presence of light. (en)">
				>
				["at0596"] = <
					text = <"*Hand Movement (en)">
					description = <"*The individual perceived hand movements. (en)">
				>
				["at0597"] = <
					text = <"*Count Fingers (en)">
					description = <"*The individual correctly counted fingers. (en)">
				>
				["at0598"] = <
					text = <"*Bailey-Lovie chart (en)">
					description = <"*A Bailey-Lovie chart was used. (en)">
				>
				["at0599"] = <
					text = <"*E-ETDRS test (en)">
					description = <"*An electronic or computerized ETRDS testing protocol was used. (en)">
				>
				["at0600"] = <
					text = <"*ATS-HOTV test (en)">
					description = <"*The Amblyopia Treatment Study HOTV testing protocol was used. (en)">
				>
				["at0601"] = <
					text = <"*Minimum detectable visual acuity (en)">
					description = <"*A measurement of the ability to detect a visual object. (en)">
				>
				["at0602"] = <
					text = <"*Minimum recognizable visual acuity (en)">
					description = <"*A measurement of the ability to recognize and identify a visual object. (en)">
				>
				["at0603"] = <
					text = <"*Left eye (en)">
					description = <"*The aid was positioned in front of the left eye. (en)">
				>
				["at0604"] = <
					text = <"*Right eye (en)">
					description = <"*The aid was positioned in front of the left eye. (en)">
				>
			>
		>
		["nb"] = <
			items = <
				["at0000"] = <
					text = <"Visusundersøkelse">
					description = <"En undersøkelse for å tallfeste et individs visus som et mål på evnen til å oppdage, skille eller gjenkjenne visuelle detaljer.">
				>
				["at0001"] = <
					text = <"Hendelsesserie">
					description = <"@ internal @">
				>
				["at0003"] = <
					text = <"Tre">
					description = <"@ internal @">
				>
				["at0007"] = <
					text = <"Undersøkt øye">
					description = <"Øyet som ble undersøkt, eller begge øyne ved en binokulær undersøkelse.">
					comment = <"'Begge øyne' skal kun brukes ved undersøkelse av binokulær visus.">
				>
				["at0012"] = <
					text = <"Venstre øye">
					description = <"Venstre øye ble undersøkt.">
				>
				["at0013"] = <
					text = <"Høyre øye">
					description = <"Høyre øye ble undersøkt.">
				>
				["at0014"] = <
					text = <"Begge øyne">
					description = <"Begge øyne ble undersøkt samtidig.">
				>
				["at0020"] = <
					text = <"Tre">
					description = <"@ internal @">
				>
				["at0021"] = <
					text = <"Optotype">
					description = <"Typen symbol som brukes for å undersøke visus.">
					comment = <"Koding med en terminologi anbefales. Fritekst bør kun tillates dersom det ikke finnes en egnet kodet verdi.">
				>
				["at0023"] = <
					text = <"Type tavle eller stimulus">
					description = <"Typen tavle eller kort som brukes for å måle visus.">
					comment = <"Koding med en terminologi anbefales. Fritekst bør kun tillates dersom det ikke finnes en egnet kodet verdi.">
				>
				["at0025"] = <
					text = <"Detaljer om tavle eller stimulusutstyr">
					description = <"Detaljer om utstyret som brukes for å gi en stimulus som skal oppløses av øyet som undersøkes, for eksempel en tavle, en projektor eller en digital skjerm.">
				>
				["at0040"] = <
					text = <"Kommentar">
					description = <"Ytterligere fritekst om målingen, som ikke omfattes av andre felt.">
				>
				["at0041"] = <
					text = <"Tre">
					description = <"@ internal @">
				>
				["at0081"] = <
					text = <"Kategori for undersøkelsesavstand">
					description = <"En kategorisering av undersøkelsesavstanden.">
					comment = <"Grensedefinisjonene kan variere, og det oppfordres derfor til å fylle ut elementet 'Undersøkelsesavstand', særlig ved mellomavstand og nær avstand.">
				>
				["at0082"] = <
					text = <"logMAR-tavle">
					description = <"En logMAR-tavle ble brukt.">
				>
				["at0083"] = <
					text = <"Snellen-tavle">
					description = <"En Snellen-tavle ble brukt.">
				>
				["at0084"] = <
					text = <"ETDRS-tavle">
					description = <"En ETDRS-tavle ble brukt.">
				>
				["at0106"] = <
					text = <"Bokstaver">
					description = <"Bokstavoptotyper ble brukt.">
				>
				["at0107"] = <
					text = <"Retningsoptotyper">
					description = <"Retningsoptotyper ble brukt.">
				>
				["at0108"] = <
					text = <"Piktogrammer">
					description = <"Piktogramoptotyper ble brukt.">
				>
				["at0112"] = <
					text = <"Konfunderende faktorer">
					description = <"Beskrivelse av tilfeldige faktorer knyttet til individets tilstand som kan påvirke den kliniske tolkningen av målingen.">
					comment = <"Eksempler: 'Pasienten var forvirret', \"Øyelokket ble holdt åpent for hånd\", \"Eksentrisk fiksering\".">
				>
				["at0134"] = <
					text = <"Uspesifisert hendelse">
					description = <"Standard, uspesifisert tidspunkt eller tidsintervall som kan defineres mer eksplisitt i et templat eller i en applikasjon.">
				>
				["at0141"] = <
					text = <"Undersøkelse ikke utført">
					description = <"Detaljer for eksplisitt å registrere at denne undersøkelsen ikke ble utført.">
				>
				["at0143"] = <
					text = <"Tilleggsinformasjon">
					description = <"Ytterligere informasjon som trengs for å kunne registrere lokalt definert innhold eller for å tilpasse til andre referansemodeller/formalismer.">
					comment = <"For eksempel lokale informasjonsbehov eller ytterligere metadata for å kunne tilpasse til tilsvarende konsepter i FHIR.">
				>
				["at0151"] = <
					text = <"Beste kvalitative resultat">
					description = <"Det høyeste nivået av synsfunksjon individet viste under kvalitativ undersøkelse.">
					comment = <"Brukes ikke for undersøkelse av lysprojeksjon. Bruk arketypen OBSERVATION.light_projection_test til dette formålet.
Høyere ordinalverdier representerer bedre synsfunksjon.">
				>
				["at0193"] = <
					text = <"Avledet resultat">
					description = <"En gruppering av beregnede eller estimerte visusverdier som er avledet ved omregning fra det primært registrerte resultatet.">
				>
				["at0206"] = <
					text = <"Lea-symboler">
					description = <"Lea-symboloptotyper ble brukt.">
				>
				["at0207"] = <
					text = <"Kay-bilder">
					description = <"Kay-bildeoptotyper ble brukt.">
				>
				["at0208"] = <
					text = <"Allen-bilder">
					description = <"Allen-bildeoptotyper ble brukt.">
				>
				["at0209"] = <
					text = <"Auckland-optotyper">
					description = <"Auckland-optotyper ble brukt.">
				>
				["at0210"] = <
					text = <"Amsterdam-bilder">
					description = <"Amsterdam-bildeoptotyper ble brukt.">
				>
				["at0211"] = <
					text = <"Landolt C">
					description = <"Landolt C-optotyper ble brukt.">
				>
				["at0212"] = <
					text = <"Tumbling E">
					description = <"Tumbling E-optotyper ble brukt.">
				>
				["at0213"] = <
					text = <"Tall">
					description = <"Talloptotyper ble brukt.">
				>
				["at0215"] = <
					text = <"Lea-tall">
					description = <"Lea-talloptotyper ble brukt.">
				>
				["at0216"] = <
					text = <"Sloan-bokstaver">
					description = <"Sloan-bokstavoptotyper ble brukt.">
				>
				["at0217"] = <
					text = <"Kyrilliske bokstaver">
					description = <"Kyrilliske bokstavoptotyper ble brukt.">
				>
				["at0218"] = <
					text = <"Snellen-bokstaver">
					description = <"Snellen-bokstavoptotyper ble brukt.">
				>
				["at0219"] = <
					text = <"HOTV-bokstaver">
					description = <"HOTV-bokstavoptotyper ble brukt.">
				>
				["at0220"] = <
					text = <"LRVC-bokstaver">
					description = <"LRVC-bokstavoptotyper ble brukt.">
				>
				["at0221"] = <
					text = <"Britiske bokstaver (2003)">
					description = <"Britiske bokstavoptotyper (2003) ble brukt.">
				>
				["at0222"] = <
					text = <"Europeiske bokstaver">
					description = <"Europeiske bokstavoptotyper ble brukt.">
				>
				["at0223"] = <
					text = <"Nær">
					description = <"Undersøkelsen ble utført på nær avstand.">
				>
				["at0224"] = <
					text = <"Mellomavstand">
					description = <"Undersøkelsen ble utført på mellomavstand.">
				>
				["at0225"] = <
					text = <"Lang">
					description = <"Undersøkelsen ble utført på lang avstand.">
				>
				["at0226"] = <
					text = <"Stimulusmetode">
					description = <"Informasjon om måten den visuelle stimulusen presenteres på.">
					comment = <"Gjør det mulig å registrere grunnleggende informasjon når ytterligere detaljer om type eller utstyrsnavn for stimulusen er ukjent.">
				>
				["at0227"] = <
					text = <"Elektronisk tavleskjerm">
					description = <"En elektronisk skjerm.">
				>
				["at0231"] = <
					text = <"Trykt tavle eller kort">
					description = <"En trykt tavle eller et trykt kort.">
				>
				["at0239"] = <
					text = <"Golovin-Sivtsev-tavle">
					description = <"En Golovin-Sivtsev-tavle ble brukt.">
				>
				["at0240"] = <
					text = <"Monoyer-tavle">
					description = <"En Monoyer-tavle ble brukt.">
				>
				["at0242"] = <
					text = <"Keeler-visuskort">
					description = <"Keeler-visuskort ble brukt, en type gitterbasert blikkpreferansetest.">
				>
				["at0244"] = <
					text = <"Bakgrunnsluminans">
					description = <"Luminansen i bakgrunnen til den visuelle stimulusen, for eksempel den hvite bakgrunnen på en tavle.">
					comment = <"Candela per kvadratmeter tilsvarer den ikke-SI-baserte enheten 'nit'.">
				>
				["at0245"] = <
					text = <"Weber-kontrast">
					description = <"Differansen mellom luminansen til stimulusen og bakgrunnen, delt på bakgrunnsluminansen.">
				>
				["at0248"] = <
					text = <"Michelson-kontrast">
					description = <"Differansen mellom høyeste og laveste luminans i stimulusen, delt på summen av dem.">
				>
				["at0256"] = <
					text = <"Belysningsstyrke i omgivelsene">
					description = <"Belysningsstyrken i rommet der visusundersøkelsen utføres.">
				>
				["at0262"] = <
					text = <"Synshjelpemiddel per øye">
					description = <"Et cluster som beskriver hvilken type synshjelpemiddel som ble brukt under undersøkelsen, og hvilket øye det var plassert foran.">
					comment = <"Når flere hjelpemidler er plassert foran samme øye, forventes dette clusteret brukt én gang for hvert av dem.">
				>
				["at0294"] = <
					text = <"Resultat i desimalnotasjon">
					description = <"Visus målt og uttrykt i desimalnotasjon.">
				>
				["at0295"] = <
					text = <"Resultat som meterbrøk">
					description = <"Visus målt og uttrykt som en Snellen-brøk i meter eller en brøk på M-skalaen.">
					comment = <"For Snellen-brøk er telleren vanligvis en referanseavstand på seks meter, uavhengig av den faktiske undersøkelsesavstanden.
For notasjon på M-skalaen skal telleren være lik den faktiske undersøkelsesavstanden.
Fyll ut elementet 'Undersøkelsesavstand' for å unngå tvetydighet, særlig dersom M-skalaen brukes.
">
				>
				["at0296"] = <
					text = <"Resultat som fotbrøk">
					description = <"Visus målt og uttrykt som en Snellen-brøk i fot.">
					comment = <"En referanseavstand på 20 fot brukes ofte som standard teller.
Bruk elementet 'Undersøkelsesavstand' for å unngå tvetydighet.
">
				>
				["at0297"] = <
					text = <"logMAR-resultat">
					description = <"Visus målt og uttrykt som titallslogaritmen til minste oppløsningsvinkel (MAR).">
					comment = <"Omtales noen ganger som 'logRAD' ved lesevisusundersøkelser.">
				>
				["at0299"] = <
					text = <"Resultat i N-skriftstørrelse">
					description = <"N-skriftstørrelsen til den minste linjen eller teksten som ble gjenkjent.">
					comment = <"Strengt tatt ikke en visusenhet, men et mål på stimulusstørrelse.">
				>
				["at0302"] = <
					text = <"Resultat i Jaeger-skriftstørrelse">
					description = <"Jaeger-skriftstørrelsen til den minste tekstlinjen som ble gjenkjent.">
					comment = <"Strengt tatt ikke en visusenhet, men et mål på stimulusstørrelse.">
				>
				["at0319"] = <
					text = <"Avledet resultat i desimalnotasjon">
					description = <"Visus i desimalnotasjon, avledet fra den primære registreringen.">
				>
				["at0320"] = <
					text = <"Avledet resultat som meterbrøk">
					description = <"Visus som meterbrøk (Snellen eller M-skala), avledet fra den primære registreringen.">
				>
				["at0321"] = <
					text = <"Avledet resultat som fotbrøk">
					description = <"Visus som Snellen-brøk i fot, avledet fra den primære registreringen.">
				>
				["at0322"] = <
					text = <"Avledet logMAR-resultat">
					description = <"Visus i logMAR-notasjon, avledet fra den primære registreringen.">
				>
				["at0333"] = <
					text = <"Tolkning">
					description = <"Tolkning av resultatene.">
					comment = <"Brukes ikke for informasjon om hvordan undersøkelsen ble utført, eller om pasientforhold som påvirker resultatet.">
				>
				["at0355"] = <
					text = <"Resultat i 5-skår-notasjon">
					description = <"Visus målt og uttrykt med den logaritmiske 5-skår-notasjonen, som er mye brukt i Kina.">
					comment = <"Definert som 5 minus logMAR-resultatet, og inngår i den kinesiske nasjonale standarden GB11533-1989.">
				>
				["at0356"] = <
					text = <"ETDRS-bokstavskår">
					description = <"Visus målt og uttrykt som ETDRS-bokstavskår.">
					comment = <"Merk: ETDRS-skåren inkluderer de 30 bokstavene som kan presenteres på 1 m avstand, og som legges til resultatene fra undersøkelsen på 4 m avstand.
Se ETDRS-rapport nummer 7 i referansene.
En bokstavskår på 85 tilsvarer 20/20, 1,0 desimal og 0,0 logMAR.
">
				>
				["at0357"] = <
					text = <"Avledet resultat som ETDRS-bokstavskår">
					description = <"Visus i ETDRS-notasjon, avledet fra den primære registreringen.">
					comment = <"Merk: ETDRS-skåren inkluderer de 30 bokstavene som kan presenteres på 1 m avstand, og som legges til resultatene fra undersøkelsen på 4 m avstand.
Se ETDRS-rapport nummer 7 i referansene.
En bokstavskår på 85 tilsvarer 20/20, 1,0 desimal og 0,0 logMAR.">
				>
				["at0370"] = <
					text = <"Sammenlignende merkelapp">
					description = <"Klassifisering av undersøkelsen og resultatet som 'best korrigerte' eller 'best registrerte' visus, eller lignende utsagn.">
					comment = <"Disse klassifikatorene inneholder ikke informasjon om den faktiske korreksjonen som ble brukt.
Det oppfordres til å registrere de spesifikke hjelpemidlene som ble brukt i clusteret 'Synshjelpemiddel per øye'.
">
				>
				["at0371"] = <
					text = <"BCVA">
					description = <"Dette resultatet er klassifisert som best korrigerte visus (Best Corrected Visual Acuity).">
				>
				["at0372"] = <
					text = <"BRVA">
					description = <"Dette resultatet er klassifisert som best registrerte visus (Best Recorded Visual Acuity).">
				>
				["at0373"] = <
					text = <"Type synshjelpemiddel">
					description = <"Informasjon som angir typen utstyr, eller fravær av utstyr, plassert foran ett av øynene.">
					comment = <"Unngå å bruke den generiske verdien \"Korrigert\" når utstyret eller opphavet til korreksjonsverdiene er kjent.

Koding med en terminologi anbefales. Fritekst bør kun tillates dersom det ikke finnes en egnet kodet verdi.">
				>
				["at0374"] = <
					text = <"Korreksjon basert på autorefraksjon">
					description = <"En korreksjon med styrker basert på en autorefraksjonsmåling.">
				>
				["at0375"] = <
					text = <"Korreksjon basert på subjektiv refraksjon">
					description = <"En korreksjon med styrker basert på en subjektiv refraksjon.">
				>
				["at0376"] = <
					text = <"Briller">
					description = <"Briller.">
				>
				["at0377"] = <
					text = <"Hard kontaktlinse">
					description = <"En kontaktlinse med hardt optisk senter, inkludert hybridlinser.">
				>
				["at0378"] = <
					text = <"Myk kontaktlinse">
					description = <"En kontaktlinse med mykt optisk senter.">
				>
				["at0381"] = <
					text = <"Korreksjon basert på retinoskopi">
					description = <"En korreksjon med styrker basert på en retinoskopiundersøkelse.">
				>
				["at0382"] = <
					text = <"Korrigert">
					description = <"Linser der opphavet til eller kilden for styrkene ikke er kjent.">
				>
				["at0383"] = <
					text = <"Tåkeleggingslinse">
					description = <"En linse som brukes for bevisst å gjøre synet uskarpt på det ene øyet mens det andre øyet undersøkes.">
				>
				["at0384"] = <
					text = <"Pinhole-okkluder">
					description = <"Utstyr med ett eller flere små hull som fungerer som blenderåpninger.">
				>
				["at0385"] = <
					text = <"Korreksjon basert på subjektiv overrefraksjon">
					description = <"En korreksjon med verdier basert på subjektiv overrefraksjon ble brukt.">
				>
				["at0386"] = <
					text = <"Uten korreksjon">
					description = <"Det er eksplisitt ingenting foran øyet under visusundersøkelsen, også omtalt som \"ukorrigert\".">
				>
				["at0395"] = <
					text = <"Detaljer om tilleggsbelysning">
					description = <"Detaljer om bruk av tilleggslyskilder, inkludert blendingstesting og blendingslys.">
				>
				["at0404"] = <
					text = <"Projisert tavle">
					description = <"En tavleprojektor.">
				>
				["at0405"] = <
					text = <"Øye med hjelpemiddel">
					description = <"Øyet som synshjelpemiddelet var plassert foran.">
					comment = <"Ved monokulære undersøkelser der det andre øyet er helt tildekket, antas det at synshjelpemiddelet er plassert foran øyet som undersøkes.
Under disse omstendighetene er automatisk utfylling fra elementet 'Undersøkt øye' mulig.
">
				>
				["at0410"] = <
					text = <"Bommede eller ekstra optotyper">
					description = <"Informasjon om enkeltoptotyper der hovedskåren var basert på en hel linje med optotyper.
Negativ: Antall uriktige optotyper i den siste linjen som ble markert som korrekt.
Positiv: Antall korrekte optotyper i den første linjen som ble markert som ikke korrekt.
Koden \"Delvis\" angir at et uspesifisert antall optotyper ble bommet i den minste skårede linjen.">
				>
				["at0411"] = <
					text = <"Delvis">
					description = <"Enkelte symboler ble ikke lest korrekt i den minste linjen som ble skåret som korrekt lest.">
				>
				["at0412"] = <
					text = <"Undersøkelsesavstand">
					description = <"Avstanden mellom øyet som undersøkes og den (tilsynelatende) plasseringen av stimulusen.">
					comment = <"Stimulusen kan være et virtuelt bilde.">
				>
				["at0415"] = <
					text = <"Merknad om ingen bedring">
					description = <"En merknad som angir at tillegg eller bruk av en annen type hjelpemiddel ikke ga et bedre undersøkelsesresultat.">
					comment = <"Brukes når nøyaktig visus med den ekstra korreksjonen (i en annen hendelse) ikke ble bestemt, vanligvis fordi det ble vurdert som irrelevant siden det ikke ga bedring.
Koding med en terminologi anbefales. Fritekst bør kun tillates dersom det ikke finnes en egnet kodet verdi.">
				>
				["at0416"] = <
					text = <"Ingen bedring med ekstra pinhole">
					description = <"Ingen bedring med en ekstra pinhole plassert foran øyet som undersøkes.">
				>
				["at0417"] = <
					text = <"Ingen bedring med korreksjon basert på subjektiv refraksjon">
					description = <"Ingen bedring med korreksjonslinser basert på subjektiv refraksjon.">
				>
				["at0418"] = <
					text = <"Pupilltilstand">
					description = <"Utsagn som beskriver tilstanden til individets pupiller under undersøkelsen.">
					comment = <"Den fysiske undersøkelsen av øyet registreres ved hjelp av arketypefamilien CLUSTER.exam-eye.
Koding med en terminologi anbefales. Fritekst bør kun tillates dersom det ikke finnes en egnet kodet verdi.">
				>
				["at0419"] = <
					text = <"Normal">
					description = <"Pupillen er i sin naturlige fysiologiske tilstand uten farmakologisk påvirkning eller patologiske endringer.">
				>
				["at0420"] = <
					text = <"Medikamentelt indusert mydriasis">
					description = <"Pupillen var utvidet på grunn av tidligere administrasjon av mydriatiske midler.">
				>
				["at0421"] = <
					text = <"Medikamentelt indusert miose">
					description = <"Pupillen var innsnevret på grunn av tidligere administrasjon av miotiske midler.">
				>
				["at0422"] = <
					text = <"Patologisk pupilltilstand">
					description = <"Pupillen var i en ikke-fysiologisk tilstand på grunn av sykdom, traume eller strukturelle avvik.">
				>
				["at0461"] = <
					text = <"Resultat">
					description = <"En gruppering av dataelementer som representerer den primære notasjonen for resultatet av visusundersøkelsen.">
					comment = <"Vanligvis skal kun ett resultat fylles ut.
Omregnede eller avledede verdier skal lagres i det egnede elementet i clusteret 'Avledet resultat'.">
				>
				["at0464"] = <
					text = <"Sfærisk styrke">
					description = <"Brytningsstyrken som er lik i alle meridianer.">
					comment = <"Brukes som grunnkorreksjonen som sylinder og akse legges til.">
				>
				["at0465"] = <
					text = <"Detaljer om synshjelpemiddel">
					description = <"Strukturerte detaljer om utstyret som ble brukt som synshjelpemiddel under undersøkelsen, for eksempel en foropter, en prøvebrille, briller eller kontaktlinser.">
				>
				["at0466"] = <
					text = <"Sylinderstyrke">
					description = <"Brytningsstyrken som legges til den sfæriske korreksjonen i meridianen 90° fra sylinderaksen for å kompensere for astigmatisme.">
				>
				["at0467"] = <
					text = <"Sylinderakse">
					description = <"Sylinderens orientering i grader.">
					comment = <"Etter konvensjon defineres sylinderaksen av meridianen uten styrke.">
				>
				["at0468"] = <
					text = <"Nærtillegg">
					description = <"Den ekstra sfæriske linsestyrken for syn på nært hold.">
				>
				["at0471"] = <
					text = <"Fysisk objekt">
					description = <"Andre fysiske objekter enn tavler eller kort.">
				>
				["at0472"] = <
					text = <"Berkeley rudimentary vision test">
					description = <"Berkeley rudimentary vision test (BRVT) ble brukt.">
				>
				["at0473"] = <
					text = <"Lesekort for nær avstand">
					description = <"Et lesekort for nær avstand med tekstavsnitt ble brukt.">
				>
				["at0474"] = <
					text = <"LEA gratings visustest">
					description = <"LEA-gitre ble brukt, en type gitterbasert blikkpreferansetest.">
				>
				["at0475"] = <
					text = <"Teller-visuskort">
					description = <"Teller-visuskort ble brukt, en type gitterbasert blikkpreferansetest.">
				>
				["at0476"] = <
					text = <"Cardiff-visustest">
					description = <"Cardiff-visustesten ble brukt, en type blikkpreferansetest basert på forsvinnende optotyper.">
				>
				["at0483"] = <
					text = <"Allen-bildetest">
					description = <"En Allen-bildetest ble brukt.">
				>
				["at0484"] = <
					text = <"Sheridan-Gardner-test">
					description = <"En Sheridan-Gardner-test ble brukt.">
				>
				["at0485"] = <
					text = <"Cambridge crowding cards">
					description = <"En test med Cambridge crowding cards ble brukt.">
				>
				["at0486"] = <
					text = <"MNREAD-tavle">
					description = <"En MNREAD-lesevisustavle (Minnesota Low Vision Reading) ble brukt.">
				>
				["at0487"] = <
					text = <"Radner-lesetavle">
					description = <"En Radner-lesetavle ble brukt.">
				>
				["at0488"] = <
					text = <"Freiburg visusundersøkelse">
					description = <"En Freiburg visusundersøkelse (FrACT) ble brukt.">
				>
				["at0489"] = <
					text = <"Sheridan Gardiner-test">
					description = <"En Sheridan Gardiner-test ble brukt.">
				>
				["at0490"] = <
					text = <"Integrert virtuell tavlevisning">
					description = <"En tavle presentert som et virtuelt bilde inne i et instrument, for eksempel en autorefraktor.">
				>
				["at0491"] = <
					text = <"Resultat i perioder per centimeter">
					description = <"Antall perioder (linjepar) per centimeter i det fineste gittermønsteret individet gjenkjente.">
					comment = <"Strengt tatt ikke en visusenhet, men et mål på stimulusstørrelse.">
				>
				["at0492"] = <
					text = <"Resultat i perioder per grad">
					description = <"Visus målt og uttrykt som antall par av svarte og hvite linjer (perioder) som spenner over en vinkel på én grad ved øyet som undersøkes.">
					comment = <"Brukes i gitterbaserte tester, som Teller-visuskort.">
				>
				["at0493"] = <
					text = <"Avledet resultat i perioder per grad">
					description = <"Visus i perioder per grad, avledet ved omregning fra den primære registreringen.">
				>
				["at0494"] = <
					text = <"Ingen bedring med korreksjon basert på autorefraksjon">
					description = <"Ingen bedring med korreksjonslinser basert på en autorefraksjonsmåling.">
				>
				["at0495"] = <
					text = <"Ingen bedring med briller">
					description = <"Ingen bedring med briller.">
				>
				["at0496"] = <
					text = <"Ingen bedring med myk kontaktlinse">
					description = <"Ingen bedring med en myk kontaktlinse.">
				>
				["at0497"] = <
					text = <"Ingen bedring med korreksjon basert på retinoskopi">
					description = <"Ingen bedring med korreksjonslinser basert på retinoskopi.">
				>
				["at0498"] = <
					text = <"Ingen bedring med hard kontaktlinse">
					description = <"Ingen bedring med en hard kontaktlinse.">
				>
				["at0499"] = <
					text = <"Sonksen Silver-test">
					description = <"En Sonksen Silver-test ble brukt.">
				>
				["at0500"] = <
					text = <"Cykloplegi under refraksjon">
					description = <"Informasjon om hvorvidt korreksjonen som ble brukt var basert på en måling av refraksjonsfeilen i cykloplegisk tilstand.">
				>
				["at0501"] = <
					text = <"Cykloplegisk refraksjon">
					description = <"Korreksjonen som ble brukt var basert på en måling av refraksjonsfeil i cykloplegisk tilstand.">
				>
				["at0502"] = <
					text = <"Ikke-cykloplegisk refraksjon">
					description = <"Korreksjonen som ble brukt var basert på en måling av refraksjonsfeil i ikke-cykloplegisk tilstand.">
				>
				["at0510"] = <
					text = <"Ingen bedring med ytterligere korreksjon">
					description = <"Ingen bedring med en uspesifisert ytterligere korreksjon.">
				>
				["at0512"] = <
					text = <"Supplerende resultater">
					description = <"Ytterligere strukturerte detaljer om resultatet av visusundersøkelsen som ikke fanges opp av andre dataelementer.">
					comment = <"Eksempler er å angi hvilket kort som ble skåret i en Cardiff-visustest, eller supplerende resultater fra lesevisusundersøkelser.">
				>
				["at0513"] = <
					text = <"Kontrastkategori">
					description = <"Et utsagn om kontrastnivået i undersøkelsen.">
					comment = <"Merk at de fleste visusundersøkelser utføres under forhold med høy kontrast.
Der det er mulig, oppfordres det til å fylle ut kvantitative elementer om kontrast.">
				>
				["at0514"] = <
					text = <"Høy kontrast">
					description = <"Undersøkelsen ble utført med høy kontrast.">
				>
				["at0515"] = <
					text = <"Lav kontrast">
					description = <"Undersøkelsen ble utført med lav kontrast.">
				>
				["at0516"] = <
					text = <"Detaljer om presentasjon av optotyper">
					description = <"Detaljer om hvordan optotypene ble presentert, inkludert utsagn om crowding.">
				>
				["at0517"] = <
					text = <"Defokuslinse">
					description = <"En linse som brukes med den hensikt å tilføre refraksjonsfeil.">
				>
				["at0518"] = <
					text = <"N 1">
					description = <"N-skriftstørrelse 1.">
				>
				["at0519"] = <
					text = <"N 1.5">
					description = <"N-skriftstørrelse 1,5.">
				>
				["at0520"] = <
					text = <"N 2">
					description = <"N-skriftstørrelse 2.">
				>
				["at0521"] = <
					text = <"N 2.5">
					description = <"N-skriftstørrelse 2,5.">
				>
				["at0522"] = <
					text = <"N 3">
					description = <"N-skriftstørrelse 3.">
				>
