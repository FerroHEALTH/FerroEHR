				["at0558"] = <
					text = <"Crowding">
					description = <"Et kategorisk utsagn om hvorvidt den visuelle stimulusen forventes å framkalle en crowding-effekt.">
					comment = <"Ytterligere detaljer om graden av crowding og forekomst av crowding-streker kan registreres ved hjelp av SLOT-en 'Detaljer om presentasjon av optotyper'.">
				>
				["at0560"] = <
					text = <"Med crowding">
					description = <"Stimulusen ble presentert på en måte som antas å framkalle en crowding-effekt.">
				>
				["at0561"] = <
					text = <"Uten crowding">
					description = <"Stimulusen ble presentert på en måte som antas ikke å framkalle en crowding-effekt.">
				>
				["at0562"] = <
					text = <"Type tilleggsbelysning som ble brukt">
					description = <"Typen lyskilder som ble brukt i tillegg til vanlig rom-, stimulus- eller tavlebelysning.">
					comment = <"Koding med en terminologi anbefales. Fritekst bør kun tillates dersom det ikke finnes en egnet kodet verdi.">
				>
				["at0563"] = <
					text = <"Blendingslys">
					description = <"En eller flere lyskilder ble rettet mot øyet for å framkalle blending.">
				>
				["at0564"] = <
					text = <"Brightness Acuity Test">
					description = <"Et håndholdt ganzfeld-belysningsinstrument ble brukt for å simulere lysstyrke i omgivelsene.">
				>
				["at0565"] = <
					text = <"Kommentar">
