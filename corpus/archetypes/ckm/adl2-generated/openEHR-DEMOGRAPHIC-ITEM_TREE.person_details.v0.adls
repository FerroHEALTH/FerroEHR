            ["at0047"] = <
                text = <"Βιομετρική έκδοση">
                description = <"Έκδοση της διαδικασίας που χρησιμοποιείται για την παραγωγή αυτού του βιομετρικού στοιχείου. Αυτό σχετίζεται με το λογισμικό που χρησιμοποιείται και όχι με τις προδιαγραφές της συσκευής. Αφηρημένες τιμές που ορίζονται από την προδιαγραφή μορφής προστάτη που προσδιορίζουν μια έκδοση της μορφής προστάτη">
