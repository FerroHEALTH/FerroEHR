        ["pt-br"] = <
            ["at0000"] = <
                text = <"Dados da pessoa">
                description = <"Dados demográficos da pessoa tais como dados sobre o nascimento, do óbito, sexo, estado civil, grupo étnico e identificador biométrico">
            >
            ["at0001"] = <
                text = <"Dados do nascimento">
