            ["at0045"] = <
                text = <"Θέση του βιομετρικού αναγνωριστικού στοιχείου">
                description = <"Όταν τα βιομετρικά στοιχεία θα μπορούσαν να αντιπροσωπεύουν διάφορες εναλλακτικές επιλογές, θα πρέπει να προσδιορίζεται η συγκεκριμένη τοποθεσία. Εάν το βιομετρικό στοιχείο αντιπροσωπεύει περισσότερες από μία, θα πρέπει να αναφέρονται πολλαπλές τοποθεσίες">
