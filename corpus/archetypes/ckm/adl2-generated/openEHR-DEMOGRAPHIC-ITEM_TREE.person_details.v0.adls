    details = <
        ["de"] = <
            language = <[ISO_639-1::de]>
            purpose = <"Zur Darstellung der demographischen Daten einer Person wie Geburtsdaten, Sterbedaten, Geschlecht, Familienstand, ethnische Gruppe und biometrischer Identifikator.">
            keywords = <"demographischer Bereich", "demographische Daten der Person">
            use = <"Der Archetyp wird im demographischen Bereich zur Erfassung der demografischen Daten einer Person verwendet.">
            misuse = <"">
            copyright = <"© openEHR Foundation">
        >
        ["pt-br"] = <
            language = <[ISO_639-1::pt-br]>
            purpose = <"Representação de dados demográficos de uma pessoa, tais como dados do nascimento, do óbito, sexo, estado civil, grupo étnico e identificador biométrico">
            keywords = <"serviço demográfico", "dados demográficos de uma pessoa">
            use = <"Usado em serviço demográficos para coletar os dados demográficos de uma pessoa">
            misuse = <"">
            copyright = <"© openEHR Foundation">
        >
        ["el"] = <
            language = <[ISO_639-1::el]>
            purpose = <"Αναπαράσταση δημογραφικών δεδομένων ενός ατόμου, όπως δεδομένα γέννησης, δεδομένα θανάτου, φύλο, οικογενειακή κατάσταση, εθνοτική ομάδα και βιομετρικά αναγνωριστικά στοιχεία">
            keywords = <"Δημογραφική Υπηρεσία", "δημογραφικά στοιχεία ατόμου">
            use = <"Χρησιμοποιείται σε δημογραφικές υπηρεσίες για τη συλλογή δημογραφικών δεδομένων ενός ατόμου">
            misuse = <"">
        >
        ["en"] = <
            language = <[ISO_639-1::en]>
            purpose = <"Representation of a person's demographic data such as, birth data, death data, sex, marital status, ethnic group and biometric identifier">
            keywords = <"demographic service", "person's demographic data">
            use = <"Used in demographic service to collect a person's demographic data">
            misuse = <"">
            copyright = <"© openEHR Foundation">
        >
        ["es-py"] = <
            language = <[ISO_639-1::es-py]>
            purpose = <"Representación de los datos demográficos de una persona, tales como datos de nacimiento, de defunción, sexo, estado civil, grupo étnico e identificador biométrico.">
            keywords = <"servicio demográfico", "datos demográficos de una persona">
            use = <"Utilizado en servicios demográficos para recolectar los datos demográficos de una persona.">
            misuse = <"">
            copyright = <"© openEHR Foundation">
        >
    >

definition
    ITEM_TREE[at0000] occurrences matches {0..1} matches {    -- Person data
        items cardinality matches {1..*} matches {
            CLUSTER[at0001] occurrences matches {1} matches {    -- Birth data
                items matches {
                    ELEMENT[at0010] occurrences matches {1} matches {    -- Birth date
                        value matches {
                            DV_DATE[at9003]
                        }
                    }
                    ELEMENT[at0011] matches {    -- Date of birth follow-up indicator
                        value matches {
                            DV_BOOLEAN[at9004]
                        }
                    }
                    ELEMENT[at0012] occurrences matches {0..1} matches {    -- Country of birth
                        value matches {
                            DV_CODED_TEXT[at9005] matches {
                                defining_code matches {[ac2]}    -- Country codes
                            }
                        }
                    }
                    ELEMENT[at0013] occurrences matches {0..1} matches {    -- State/territory/province
                        value matches {
                            DV_CODED_TEXT[at9006] matches {
                                defining_code matches {[ac3]}    -- State codes
                            }
                        }
                    }
                    ELEMENT[at0014] occurrences matches {0..1} matches {    -- City/town/locality
                        value matches {
                            DV_CODED_TEXT[at9007] matches {
                                defining_code matches {[ac4]}    -- City codes
                            }
                        }
                    }
                    ELEMENT[at0015] occurrences matches {0..1} matches {    -- Birth plurality
                        value matches {
                            DV_TEXT[at9008]
                            DV_CODED_TEXT[at9009] matches {
                                defining_code matches {[ac5]}    -- Birth plurality codes
                            }
                        }
                    }
                    ELEMENT[at0016] occurrences matches {0..1} matches {    -- Birth order
                        value matches {
                            DV_TEXT[at9010]
                            DV_CODED_TEXT[at9011] matches {
                                defining_code matches {[ac6]}    -- Birth order codes
                            }
                        }
                    }
                    ELEMENT[at0017] matches {    -- Sex
                        value matches {
                            DV_TEXT[at9012]
                            DV_CODED_TEXT[at9013] matches {
                                defining_code matches {[ac9000]}    -- Sex (synthesised)
                            }
                        }
                    }
                    ELEMENT[at0018] occurrences matches {1} matches {    -- Registry
                        value matches {
                            DV_TEXT[at9014]
                        }
                    }
                    allow_archetype CLUSTER[at0006] occurrences matches {0..1} matches {    -- Country specific birth data
                        include
                            archetype_id/value matches {/openEHR-DEMOGRAPHIC-CLUSTER\.birth_data_additional_detail[a-zA-Z0-9_-]*\.v0\..*/}
                    }
                }
            }
            CLUSTER[at0002] occurrences matches {1} matches {    -- Death data
                items matches {
                    ELEMENT[at0021] occurrences matches {1} matches {    -- Death date
                        value matches {
                            DV_DATE[at9015]
                        }
                    }
                    ELEMENT[at0022] occurrences matches {0..1} matches {    -- Source of notification
                        value matches {
                            DV_TEXT[at9016]
                            DV_CODED_TEXT[at9017] matches {
                                defining_code matches {[ac9001]}    -- Source of notification (synthesised)
                            }
                        }
                    }
                    ELEMENT[at0023] occurrences matches {0..1} matches {    -- Country
                        value matches {
                            DV_CODED_TEXT[at9018] matches {
                                defining_code matches {[ac2]}    -- Country codes
                            }
                        }
                    }
                    ELEMENT[at0024] occurrences matches {0..1} matches {    -- State/territory/province
                        value matches {
                            DV_CODED_TEXT[at9019] matches {
                                defining_code matches {[ac3]}    -- State codes
                            }
                        }
                    }
                    ELEMENT[at0025] occurrences matches {0..1} matches {    -- City/town/locality
                        value matches {
                            DV_TEXT[at9020]
                            DV_CODED_TEXT[at9021] matches {
                                defining_code matches {[ac4]}    -- City codes
                            }
                        }
                    }
                    ELEMENT[at0026] occurrences matches {0..1} matches {    -- Death certificate number
                        value matches {
                            DV_TEXT[at9022]
                        }
                    }
                }
            }
            CLUSTER[at0004] occurrences matches {1} matches {    -- Biometric identifier
                items matches {
                    ELEMENT[at0041] occurrences matches {1} matches {    -- Type of biometric
                        value matches {
                            DV_TEXT[at9023]
                            DV_CODED_TEXT[at9024] matches {
                                defining_code matches {[ac9002]}    -- Type of biometric (synthesised)
                            }
                        }
                    }
                    ELEMENT[at0042] occurrences matches {0..1} matches {    -- Biometric data template
                        value matches {
                            DV_TEXT[at9025]
                        }
                    }
                    ELEMENT[at0043] occurrences matches {0..1} matches {    -- Biometric enrolment quality
                        value matches {
                            DV_PROPORTION[at9026]
                        }
                    }
                    ELEMENT[at0044] occurrences matches {0..1} matches {    -- Biometric creating authority
                        value matches {
                            DV_TEXT[at9027]
                        }
                    }
                    ELEMENT[at0045] matches {    -- Location of biometric identifier
                        value matches {
                            DV_TEXT[at9028]
                            DV_CODED_TEXT[at9029] matches {
                                defining_code matches {[ac9]}    -- Localization code
                            }
                        }
                    }
                    ELEMENT[at0046] occurrences matches {0..1} matches {    -- Biometric device identification
                        value matches {
                            DV_TEXT[at9030]
                        }
                    }
                    ELEMENT[at0047] occurrences matches {0..1} matches {    -- Biometric version
                        value matches {
                            DV_TEXT[at9031]
                        }
                    }
                    ELEMENT[at0048] occurrences matches {0..1} matches {    -- Biometric date of creation
                        value matches {
                            DV_DATE[at9032]
                        }
                    }
                }
            }
            ELEMENT[at0031] matches {    -- Gender
                value matches {
                    DV_TEXT[at9033]
                    DV_CODED_TEXT[at9034] matches {
                        defining_code matches {[ac9000]}    -- Sex (synthesised)
                    }
                }
            }
            ELEMENT[at0032] matches {    -- Mother's family name
                value matches {
                    DV_TEXT[at9035]
                }
            }
            ELEMENT[at0033] matches {    -- Marital status
                value matches {
                    DV_TEXT[at9036]
                    DV_CODED_TEXT[at9037] matches {
                        defining_code matches {[ac7]}    -- Marital status codes
                    }
                }
            }
            ELEMENT[at0034] matches {    -- Ethnic background
                value matches {
                    DV_TEXT[at9038]
                    DV_CODED_TEXT[at9039] matches {
                        defining_code matches {[ac8]}    -- Ethnic background codes
                    }
                }
            }
            ELEMENT[at0035] matches {    -- Identification comment
                value matches {
                    DV_TEXT[at9040]
                }
            }
            allow_archetype CLUSTER[at0005] matches {    -- Other person identifiers
                include
                    archetype_id/value matches {/openEHR-DEMOGRAPHIC-CLUSTER\.person_identifier[a-zA-Z0-9_-]*\.v0\..*/}
            }
        }
    }

terminology
    term_definitions = <
        ["de"] = <
            ["at0000"] = <
                text = <"Personendaten">
                description = <"Demographische Daten über eine Person wie Geburtsdaten, Sterbedaten, Geschlecht, Familienstand, ethnische Gruppe und biometrische Identifikatoren.">
            >
            ["at0001"] = <
                text = <"Angaben zur Geburt">
                description = <"Demographische Daten zur Geburt.">
            >
            ["at0002"] = <
                text = <"Angaben zum Tod">
                description = <"Demographische Daten zum Tod">
            >
            ["at0004"] = <
                text = <"Biometrischer Identifikator">
                description = <"Biometrischer Identifikator einer Person.">
            >
            ["at0005"] = <
                text = <"Sonstige Personenkennzeichen">
                description = <"Sonstige Personenkennzeichen: Personalausweis, Führerschein, etc..">
            >
            ["at0006"] = <
                text = <"Länderspezifische Daten zur Geburt">
                description = <"Zusätzliche länderspezifische Geburtsdaten.">
            >
            ["at0010"] = <
                text = <"Geburtsdatum">
                description = <"Das Geburtsdatum einer Person.">
            >
            ["at0011"] = <
                text = <"Indikator für Geburtsdatum (Follow-up)">
                description = <"Markierung, welche anzeigt, wann das aktuelle Geburtsdatum verfolgt werden muss, um ein genaueres Datum zu erhalten.">
            >
            ["at0012"] = <
                text = <"Geburtsland">
                description = <"Das Land, in dem eine Person geboren wurde.">
            >
            ["at0013"] = <
                text = <"Staat/Gebiet/Provinz">
                description = <"Staat/Gebiet/Provinz, in dem die Person geboren wurde.">
            >
            ["at0014"] = <
                text = <"Stadt/Gemeinde/Ortschaft">
                description = <"Die Stadt/der Ort, in der/dem die Person geboren wurde.">
            >
            ["at0015"] = <
                text = <"Geburtenhäufigkeit">
                description = <"Ein Indikator für Mehrlingsgeburten, der die Anzahl der Geburten, die aus einer einzigen Schwangerschaft resultieren, angibt.">
            >
            ["at0016"] = <
                text = <"Geburtsfolge">
                description = <"Die sequentielle Reihenfolge der Person bei einer Mehrlingsgeburt, unabhängig von Lebend- oder Totgeburt.">
            >
            ["at0017"] = <
                text = <"Geschlecht">
                description = <"Das Geschlecht der Person.">
            >
            ["at0018"] = <
                text = <"Standesamt">
                description = <"Standesamt, das die Geburtsurkunde ausgestellt hat.">
            >
            ["at0021"] = <
                text = <"Todesdatum">
                description = <"Das Todesdatum einer Person">
            >
            ["at0022"] = <
                text = <"Meldestelle">
                description = <"Gibt die Informationsquelle über den Tod eines Pflegebedürftigen an. Dieses Feld gibt einen Hinweis auf die Zuverlässigkeit der Informationen.">
            >
            ["at0023"] = <
                text = <"Land">
                description = <"Das Land, in dem eine Person gestorben ist.">
            >
            ["at0024"] = <
                text = <"Land/Gebiet/Provinz">
                description = <"Land/Gebiet/Provinz, in dem eine Person gestorben ist.">
            >
            ["at0025"] = <
                text = <"Stadt/Gemeinde/Ortschaft">
                description = <"Die Stadt/der Ort, in der/dem eine Person gestorben ist.">
            >
            ["at0026"] = <
                text = <"Sterbeurkundennummer">
                description = <"Die Nummer der Sterbeurkunde.">
            >
            ["at0031"] = <
                text = <"Geschlecht">
                description = <"Das Geschlecht der Person.">
            >
            ["at0032"] = <
                text = <"Familienname der Mutter">
                description = <"Ursprünglicher Familienname der Mutter">
            >
            ["at0033"] = <
                text = <"Familienstand">
                description = <"Familienstand.">
            >
            ["at0034"] = <
                text = <"Ethnische Hintergrund">
                description = <"Ethnischer Hintergrund der Person.">
            >
            ["at0035"] = <
                text = <"Anmerkung zur Identifikation">
                description = <"Anmerkungen, die für eine Personenregistrierung aufgezeichnet werden, um zwischen zwei oder mehreren Personen mit denselben oder ähnlichen demografischen Informationen zu unterscheiden.">
            >
            ["at0041"] = <
                text = <"Art des biometrischen Merkmals">
                description = <"Identifizierung der Art des biometrischen Identifikators, der durch diesen Datensatz beschrieben wird.">
            >
            ["at0042"] = <
                text = <"Vorlage für biometrische Daten">
                description = <"Das Format für ein BIR, das vollständig durch einen CBEFF-Patron definiert ist.">
            >
            ["at0043"] = <
                text = <"Qualität der biometrischen Datenerfassung">
                description = <"Ein numerischer Indikator für die Qualität des biometrischen Objekts.">
            >
            ["at0044"] = <
                text = <"Biometrische Erstellungsbehörde">
                description = <"Dies zeigt die Organisation an, die das biometrische Merkmal erstellt hat.">
            >
            ["at0045"] = <
                text = <"Standort des biometrischen Identifikators">
                description = <"Wenn die biometrischen Daten mehrere alternative Optionen darstellen könnten, sollte der spezifische Standort identifiziert werden. Wenn die Biometrie mehr als einen darstellt, sollten mehrere Standorte angegeben werden.">
            >
            ["at0046"] = <
                text = <"Biometrische Geräteidentifikation">
                description = <"Eine einem biometrischen Produkt zugewiesene Kennung, die das biometrische Produkt innerhalb der biometrischen Produkte, denen von einem Eigentümer des biometrischen Produkts eine Kennung zugewiesen wurde, eindeutig identifiziert.">
            >
            ["at0047"] = <
                text = <"Biometrische Version">
                description = <"Version des Prozesses, der zur Erstellung dieser Biometrie verwendet wird. Dies bezieht sich auf die verwendete Software und nicht auf die Gerätespezifikation. Abstrakte(r) Wert(e), definiert durch die Benutzerformatspezifikation, die eine Version des Benutzerformats identifizieren.">
            >
            ["at0048"] = <
                text = <"Biometrisches Erstellungsdatum">
                description = <"Das Datum, an dem der biometrische Identifikator erstellt wurde.">
            >
            ["at0220"] = <
                text = <"Register">
                description = <"Geben Sie an, dass es sich bei der Benachrichtigungsquelle um ein Register handelt.">
            >
            ["at0221"] = <
                text = <"Gesundheitsdienstleister">
                description = <"Geben Sie an, dass die Benachrichtigungsquelle ein Gesundheitsdienstleister ist.">
            >
            ["at0222"] = <
                text = <"Verwandter">
                description = <"Geben Sie an, dass es sich bei der Benachrichtigungsquelle um einen Verwandten handelt">
            >
            ["at0223"] = <
                text = <"Sonstige">
                description = <"Geben Sie an, dass es sich bei der Benachrichtigungsquelle um eine andere Quelle handelt.">
            >
            ["at0224"] = <
                text = <"Unbekannt">
                description = <"Geben Sie an, dass die Benachrichtigungsquelle unbekannt ist.">
            >
            ["at0310"] = <
                text = <"Männlich">
                description = <"Männlich.">
            >
            ["at0311"] = <
                text = <"Weiblich">
                description = <"Weiblich.">
            >
            ["at0312"] = <
                text = <"Intersex oder unbestimmt">
                description = <"Wird in der Regel für Babys verwendet, deren Geschlecht aus welchen Gründen auch immer nicht bestimmt wurde, sollte im Allgemeinen nicht auf den vom Befragten ausgefüllten Datenerhebungsformularen verwendet werden und nur dann, wenn die Person oder der Befragte freiwillig angibt, dass die Person intersexuell ist, oder wenn während des Erhebungsprozesses auf andere Weise deutlich wird, dass die Person weder männlich noch weiblich ist.">
            >
            ["at0313"] = <
                text = <"Nicht angegeben/unzureichend beschrieben">
                description = <"Darf nicht auf primären Erfassungsformularen verwendet werden. Es dient hauptsächlich zur Verwendung in administrativen Sammlungen, wenn Daten aus Datensätzen übertragen werden, in denen das Element nicht gesammelt wurde.">
            >
            ["at0410"] = <
                text = <"Fingerabdruck-gerollt">
                description = <"Fingerabdruck-gerollt.">
            >
            ["at0411"] = <
                text = <"Fingerabdruck-flach">
                description = <"Fingerabdruck-flach.">
            >
            ["at0412"] = <
                text = <"Gesichtsmerkmale">
                description = <"Gesichtsmerkmale.">
            >
            ["at0413"] = <
                text = <"Stimme">
                description = <"Stimme.">
            >
            ["at0414"] = <
                text = <"Iris">
                description = <"Iris.">
            >
            ["at0415"] = <
                text = <"Netzhaut">
                description = <"Netzhaut.">
            >
            ["at0416"] = <
                text = <"Handgeometrie">
                description = <"Handgeometrie.">
            >
            ["at0417"] = <
                text = <"Dynamik der Unterschrift">
                description = <"Dynamik der Unterschrift.">
            >
            ["at0418"] = <
                text = <"Dynamik der Tastenanschläge">
                description = <"Dynamik der Tastenanschläge.">
            >
            ["at0419"] = <
                text = <"Lippenbewegung">
                description = <"Lippenbewegung.">
            >
            ["at0420"] = <
                text = <"Wärmebild des Gesichts">
                description = <"Wärmebild des Gesichts.">
            >
            ["at0421"] = <
                text = <"Wärmebild der Hand">
                description = <"Wärmebild der Hand.">
            >
            ["at0422"] = <
                text = <"Gangart">
                description = <"Gangart.">
            >
            ["at0423"] = <
                text = <"Blutgruppe (einschließlich Rhesusfaktor)">
                description = <"Blutgruppe (einschließlich Rhesusfaktor).">
            >
            ["at0424"] = <
