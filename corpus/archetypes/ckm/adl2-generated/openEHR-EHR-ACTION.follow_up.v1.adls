definition
    ACTION[at0000] matches {    -- Follow up action
        ism_transition matches {
            ISM_TRANSITION[at0001] matches {    -- Planned
                current_state matches {
                    DV_CODED_TEXT[at9048] matches {
                        defining_code matches {[at9000]}    -- initial
                    }
                }
                careflow_step matches {
                    DV_CODED_TEXT[at9049] matches {
                        defining_code matches {[at0001]}    -- Planned
                    }
                }
            }
            ISM_TRANSITION[at0002] matches {    -- Postponed
                current_state matches {
                    DV_CODED_TEXT[at9050] matches {
                        defining_code matches {[at9001]}    -- postponed
                    }
                }
                careflow_step matches {
                    DV_CODED_TEXT[at9051] matches {
                        defining_code matches {[at0002]}    -- Postponed
                    }
                }
            }
            ISM_TRANSITION[at0007] matches {    -- Cancelled
                current_state matches {
                    DV_CODED_TEXT[at9052] matches {
                        defining_code matches {[at9002]}    -- cancelled
                    }
                }
                careflow_step matches {
                    DV_CODED_TEXT[at9053] matches {
                        defining_code matches {[at0007]}    -- Cancelled
                    }
                }
            }
            ISM_TRANSITION[at0003] matches {    -- Scheduled
