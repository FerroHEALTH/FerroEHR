    details = <
        ["en"] = <
            language = <[ISO_639-1::en]>
            purpose = <"To record actions regarding imaging investigations.">
            keywords = <"Xray", "ultrasound", "MRI", "magnetic resonance", "CT", "scan", "tomography">
            use = <"">
            misuse = <"Not used for recording the findings of the investigation; use openEHR-EHR-OBSERVATION.imaging for the findings.">
            copyright = <"© openEHR Foundation">
        >
        ["ar-sy"] = <
            language = <[ISO_639-1::ar-sy]>
            purpose = <"لتسجيل الأفعال الخاصة بالاستقصاءات التصويرية.">
            keywords = <"الأشعة السينية", "الموجات فوق الصوتية", "التصوير بالرنين المغناطيسي", "الرنين المغناطيسي", "التصوير الطبقي المُحوسَب", "التفريسة", "التصوير المقطعي">
            use = <"">
            misuse = <"لا يستخدم لتسجيل الموجودات عند إجراء الاستقصاء, استخدم بدلا من ذلك نموذج الملاحظة.التصوير.">
            copyright = <"© openEHR Foundation">
        >
        ["es-ar"] = <
            language = <[ISO_639-1::es-ar]>
            purpose = <"Para registrar acciones en relación con evaluaciones de imágenes">
            keywords = <"Radiografía", "Ecografía", "RNM", "Resonancia magnética nuclear", "TC", "Escaneo", "Tomografía">
            use = <"">
            misuse = <"No usado para registrar los hallazgos de la investigación; use openEHR-EHR-OBSERVATION.imaging para registrar los hallazgos.">
            copyright = <"© openEHR Foundation">
        >
    >

definition
    ACTION[at0000] matches {    -- Imaging investigation
        ism_transition matches {
            ISM_TRANSITION[at0001] matches {    -- Planned
                current_state matches {
                    DV_CODED_TEXT[at9051] matches {
                        defining_code matches {[at9000]}    -- initial
                    }
                }
                careflow_step matches {
                    DV_CODED_TEXT[at9052] matches {
                        defining_code matches {[at0001]}    -- Planned
                    }
                }
            }
            ISM_TRANSITION[at0004] matches {    -- Requested
                current_state matches {
                    DV_CODED_TEXT[at9053] matches {
                        defining_code matches {[at9000]}    -- initial
                    }
                }
                careflow_step matches {
                    DV_CODED_TEXT[at9054] matches {
                        defining_code matches {[at0004]}    -- Requested
                    }
                }
            }
            ISM_TRANSITION[at0002] matches {    -- Postponed
                current_state matches {
                    DV_CODED_TEXT[at9055] matches {
                        defining_code matches {[at9001]}    -- postponed
                    }
                }
                careflow_step matches {
                    DV_CODED_TEXT[at9056] matches {
                        defining_code matches {[at0002]}    -- Postponed
                    }
                }
            }
            ISM_TRANSITION[at0003] matches {    -- Cancelled
                current_state matches {
                    DV_CODED_TEXT[at9057] matches {
                        defining_code matches {[at9002]}    -- cancelled
                    }
                }
                careflow_step matches {
                    DV_CODED_TEXT[at9058] matches {
                        defining_code matches {[at0003]}    -- Cancelled
                    }
                }
            }
            ISM_TRANSITION[at0005] matches {    -- Appointment made
                current_state matches {
                    DV_CODED_TEXT[at9059] matches {
                        defining_code matches {[at9003]}    -- scheduled
                    }
                }
                careflow_step matches {
                    DV_CODED_TEXT[at9060] matches {
                        defining_code matches {[at0005]}    -- Appointment made
                    }
                }
            }
            ISM_TRANSITION[at0006] matches {    -- Resheduled
                current_state matches {
                    DV_CODED_TEXT[at9061] matches {
                        defining_code matches {[at9003]}    -- scheduled
                    }
                }
                careflow_step matches {
                    DV_CODED_TEXT[at9062] matches {
                        defining_code matches {[at0006]}    -- Resheduled
                    }
                }
            }
            ISM_TRANSITION[at0007] matches {    -- Commenced
                current_state matches {
                    DV_CODED_TEXT[at9063] matches {
                        defining_code matches {[at9004]}    -- active
                    }
                }
                careflow_step matches {
                    DV_CODED_TEXT[at9064] matches {
                        defining_code matches {[at0007]}    -- Commenced
                    }
                }
            }
            ISM_TRANSITION[at0008] matches {    -- Investigation complete
                current_state matches {
                    DV_CODED_TEXT[at9065] matches {
                        defining_code matches {[at9004]}    -- active
                    }
                }
                careflow_step matches {
                    DV_CODED_TEXT[at9066] matches {
                        defining_code matches {[at0008]}    -- Investigation complete
                    }
                }
            }
            ISM_TRANSITION[at0009] matches {    -- Reported
                current_state matches {
                    DV_CODED_TEXT[at9067] matches {
                        defining_code matches {[at9004]}    -- active
                    }
                }
                careflow_step matches {
                    DV_CODED_TEXT[at9068] matches {
                        defining_code matches {[at0009]}    -- Reported
                    }
                }
            }
            ISM_TRANSITION[at0011] matches {    -- Report communicated
                current_state matches {
                    DV_CODED_TEXT[at9069] matches {
                        defining_code matches {[at9004]}    -- active
                    }
                }
                careflow_step matches {
                    DV_CODED_TEXT[at9070] matches {
                        defining_code matches {[at0011]}    -- Report communicated
                    }
                }
            }
            ISM_TRANSITION[at0012] matches {    -- Further imaging required
                current_state matches {
                    DV_CODED_TEXT[at9071] matches {
                        defining_code matches {[at9004]}    -- active
                    }
                }
                careflow_step matches {
                    DV_CODED_TEXT[at9072] matches {
                        defining_code matches {[at0012]}    -- Further imaging required
                    }
                }
            }
            ISM_TRANSITION[at0013] matches {    -- Imaging suspended
                current_state matches {
                    DV_CODED_TEXT[at9073] matches {
                        defining_code matches {[at9005]}    -- suspended
                    }
                }
                careflow_step matches {
                    DV_CODED_TEXT[at9074] matches {
                        defining_code matches {[at0013]}    -- Imaging suspended
                    }
                }
            }
            ISM_TRANSITION[at0014] matches {    -- Imaging aborted
                current_state matches {
                    DV_CODED_TEXT[at9075] matches {
                        defining_code matches {[at9006]}    -- aborted
                    }
                }
                careflow_step matches {
                    DV_CODED_TEXT[at9076] matches {
                        defining_code matches {[at0014]}    -- Imaging aborted
                    }
                }
            }
            ISM_TRANSITION[at0010] matches {    -- Completed
                current_state matches {
                    DV_CODED_TEXT[at9077] matches {
                        defining_code matches {[at9007]}    -- complete
                    }
                }
                careflow_step matches {
                    DV_CODED_TEXT[at9078] matches {
                        defining_code matches {[at0010]}    -- Completed
                    }
                }
            }
        }
        description matches {
            allow_archetype ITEM_TREE[at9050] matches {
                include
                    archetype_id/value matches {/openEHR-EHR-ITEM_TREE\.imaging\.v1/}
                exclude
                    archetype_id/value matches {/.*/}
            }
        }
    }

