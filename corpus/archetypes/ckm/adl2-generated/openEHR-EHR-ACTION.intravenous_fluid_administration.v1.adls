definition
    ACTION[at0000] matches {    -- Intravenous fluid administration
        ism_transition matches {
            ISM_TRANSITION[at0003] matches {    -- Plan IV fluid administration
                current_state matches {
                    DV_CODED_TEXT[at9039] matches {
                        defining_code matches {[at9000]}    -- initial
                    }
                }
                careflow_step matches {
                    DV_CODED_TEXT[at9040] matches {
                        defining_code matches {[at0003]}    -- Plan IV fluid administration
                    }
                }
            }
            ISM_TRANSITION[at0004] matches {    -- Order IV fluids
                current_state matches {
                    DV_CODED_TEXT[at9041] matches {
                        defining_code matches {[at9000]}    -- initial
                    }
                }
                careflow_step matches {
                    DV_CODED_TEXT[at9042] matches {
                        defining_code matches {[at0004]}    -- Order IV fluids
                    }
                }
            }
            ISM_TRANSITION[at0001] matches {    -- Postpone IV fluid administration
                current_state matches {
                    DV_CODED_TEXT[at9043] matches {
                        defining_code matches {[at9001]}    -- postponed
                    }
                }
                careflow_step matches {
                    DV_CODED_TEXT[at9044] matches {
                        defining_code matches {[at0001]}    -- Postpone IV fluid administration
                    }
                }
            }
            ISM_TRANSITION[at0007] matches {    -- Cancel administration of IV fluids
                current_state matches {
                    DV_CODED_TEXT[at9045] matches {
                        defining_code matches {[at9002]}    -- cancelled
                    }
                }
                careflow_step matches {
                    DV_CODED_TEXT[at9046] matches {
                        defining_code matches {[at0007]}    -- Cancel administration of IV fluids
                    }
                }
            }
            ISM_TRANSITION[at0005] matches {    -- Schedule start of IV fluid administration
                current_state matches {
                    DV_CODED_TEXT[at9047] matches {
                        defining_code matches {[at9003]}    -- scheduled
                    }
                }
                careflow_step matches {
                    DV_CODED_TEXT[at9048] matches {
                        defining_code matches {[at0005]}    -- Schedule start of IV fluid administration
                    }
                }
            }
            ISM_TRANSITION[at0006] matches {    -- Commence administration of IV fluids
                current_state matches {
                    DV_CODED_TEXT[at9049] matches {
                        defining_code matches {[at9004]}    -- active
                    }
                }
                careflow_step matches {
                    DV_CODED_TEXT[at9050] matches {
                        defining_code matches {[at0006]}    -- Commence administration of IV fluids
                    }
                }
            }
            ISM_TRANSITION[at0009] matches {    -- Monitor administration of IV fluids
                current_state matches {
                    DV_CODED_TEXT[at9051] matches {
                        defining_code matches {[at9004]}    -- active
                    }
                }
                careflow_step matches {
                    DV_CODED_TEXT[at9052] matches {
                        defining_code matches {[at0009]}    -- Monitor administration of IV fluids
                    }
                }
            }
            ISM_TRANSITION[at0002] matches {    -- Suspend IV fluid administration
                current_state matches {
                    DV_CODED_TEXT[at9053] matches {
                        defining_code matches {[at9005]}    -- suspended
                    }
                }
                careflow_step matches {
                    DV_CODED_TEXT[at9054] matches {
                        defining_code matches {[at0002]}    -- Suspend IV fluid administration
                    }
                }
            }
            ISM_TRANSITION[at0008] matches {    -- Abort administration of IV fluids
                current_state matches {
                    DV_CODED_TEXT[at9055] matches {
                        defining_code matches {[at9006]}    -- aborted
                    }
                }
                careflow_step matches {
                    DV_CODED_TEXT[at9056] matches {
                        defining_code matches {[at0008]}    -- Abort administration of IV fluids
                    }
                }
            }
            ISM_TRANSITION[at0010] matches {    -- Complete administration of IV fluids
                current_state matches {
                    DV_CODED_TEXT[at9057] matches {
                        defining_code matches {[at9007]}    -- complete
                    }
                }
                careflow_step matches {
                    DV_CODED_TEXT[at9058] matches {
                        defining_code matches {[at0010]}    -- Complete administration of IV fluids
                    }
                }
            }
        }
        description matches {
            allow_archetype ITEM_TREE[at9038] matches {
                include
                    archetype_id/value matches {/openEHR-EHR-ITEM_TREE\.intravenous_fluids\.v1/}
                exclude
                    archetype_id/value matches {/.*/}
            }
        }
    }

