                    }
                }
                careflow_step matches {
                    DV_CODED_TEXT[at9025] matches {
                        defining_code matches {[at0016]}    -- Review completed
                    }
                }
            }
        }
        description matches {
            ITEM_TREE[at0001] matches {
                items cardinality matches {0..*; unordered} matches {
                    ELEMENT[at0002] occurrences matches {0..1} matches {    -- Review activity
                        value matches {
                            DV_TEXT[at9026]
                        }
                    }
                    ELEMENT[at0015] occurrences matches {0..1} matches {    -- Description
                        value matches {
                            DV_TEXT[at9027]
                        }
                    }
                    ELEMENT[at0014] occurrences matches {0..1} matches {    -- Reason
                        value matches {
                            DV_TEXT[at9028]
                        }
                    }
                }
            }
        }
        protocol matches {
            ITEM_TREE[at0017] matches {
                items cardinality matches {0..*; unordered} matches {
                    ELEMENT[at0018] occurrences matches {0..1} matches {    -- Start date/time
                        value matches {
                            DV_DATE_TIME[at9029]
                        }
                    }
                    allow_archetype CLUSTER[at0020] matches {    -- Extension
                        include
