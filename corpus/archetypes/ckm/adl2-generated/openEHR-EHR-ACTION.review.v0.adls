                        defining_code matches {[at9003]}    -- scheduled
                    }
                }
                careflow_step matches {
                    DV_CODED_TEXT[at9031] matches {
                        defining_code matches {[at0019]}    -- Review rescheduled
                    }
                }
            }
            ISM_TRANSITION[at0006] matches {    -- Review performed
                current_state matches {
                    DV_CODED_TEXT[at9016] matches {
                        defining_code matches {[at9004]}    -- active
                    }
                }
                careflow_step matches {
                    DV_CODED_TEXT[at9017] matches {
                        defining_code matches {[at0006]}    -- Review performed
                    }
                }
            }
            ISM_TRANSITION[at0011] matches {    -- Review suspended
                current_state matches {
