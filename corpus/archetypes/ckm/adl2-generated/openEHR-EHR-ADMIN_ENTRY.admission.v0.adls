    >
    details = <
        ["de"] = <
            language = <[ISO_639-1::de]>
            purpose = <"Dieser ADMIN_ENTRY-Archetyp wurde für die Darstellung der minimalen Daten bei der Patientenaufnahme entwickelt. Er basiert auf der australischen/neuseeländischen Standardimplementierung von Health Level Seven (HL7) Version 2.4 (Teil 1: Patientenverwaltung) und Health Level Seven (HL7) Standard Version 2.3.1.">
            keywords = <"Daten", "Aufnahme", "Aufnahmedaten", "Patient", "Patientenaufnahme">
            use = <"">
            misuse = <"">
        >
        ["pt-br"] = <
            language = <[ISO_639-1::pt-br]>
            purpose = <"Este arquétipo ADMIN_ENTRY de admissão foi projetado para representar os dados mínimos de admissão. Foi baseado na Implementação padrão da Austrália/Nova Zelândia, padrão HL7 versão 2.4 (parte 1: administração paciente ) e HL7 versão 2.3.1.">
            use = <"">
            misuse = <"">
            copyright = <"© 2011 openEHR Foundation, openEHR Foundation">
        >
        ["ar-sy"] = <
            language = <[ISO_639-1::ar-sy]>
            purpose = <"هذا النموذج الخاص بإدخال المريض تم تصميمه لتمثيل الحد الأدنى من بيانات إدخال المريض.
و هذا يستخدم التطبيق العياري في أستراليا و نيوزيلندة للمستوى الصحي السابع النسخة/الإصدار 2.4 (الجزء الأول:إدراة المريض), و الإصدار 2.3.1 من المستوى الصحي السابع.">
            use = <"">
            misuse = <"">
            copyright = <"© 2011 openEHR Foundation, openEHR Foundation">
        >
        ["en"] = <
            language = <[ISO_639-1::en]>
            purpose = <"This admission ADMIN_ENTRY archetype was designed for representing the minimum admission data. This is based on the Australian/New Zealand Standard Implementation of Health Level Seven (HL7) Version 2.4 (Part 1: Patient administration) and Health Level Seven (HL7) Standard Version 2.3.1.">
            use = <"">
            misuse = <"">
            copyright = <"© 2011 openEHR Foundation, openEHR Foundation">
        >
    >

definition
    ADMIN_ENTRY[at0000] matches {    -- Patient admission
        data matches {
            ITEM_TREE[at0001] matches {
                items cardinality matches {2..*; unordered} matches {
                    ELEMENT[at0002] occurrences matches {1} matches {    -- Patient class
                        value matches {
                            DV_CODED_TEXT[at9005] matches {
                                defining_code matches {[ac9000]}    -- Patient class (synthesised)
                            }
                        }
                    }
                    CLUSTER[at0073] occurrences matches {0..1} matches {    -- Assigned patient location
                        items cardinality matches {1..*; unordered} matches {
                            ELEMENT[at0074] occurrences matches {0..1} matches {    -- Point of care/Unit
                                value matches {
                                    DV_TEXT[at9006]
                                }
                            }
                            ELEMENT[at0077] occurrences matches {0..1} matches {    -- Ward
                                value matches {
                                    DV_TEXT[at9007]
                                }
                            }
                            ELEMENT[at0078] occurrences matches {0..1} matches {    -- Room
                                value matches {
                                    DV_TEXT[at9008]
                                }
                            }
                            ELEMENT[at0079] occurrences matches {0..1} matches {    -- Bed
                                value matches {
                                    DV_TEXT[at9009]
                                }
                            }
                            CLUSTER[at0104] occurrences matches {0..1} matches {    -- Facility
                                items cardinality matches {1..*; unordered} matches {
                                    ELEMENT[at0105] occurrences matches {0..1} matches {    -- Namespace ID
                                        value matches {
                                            DV_TEXT[at9010]
                                        }
                                    }
                                    ELEMENT[at0106] occurrences matches {0..1} matches {    -- Universal ID
                                        value matches {
                                            DV_TEXT[at9011]
                                        }
                                    }
                                    ELEMENT[at0107] occurrences matches {0..1} matches {    -- Universal ID type
                                        value matches {
                                            DV_CODED_TEXT[at9012] matches {
                                                defining_code matches {[ac9001]}    -- Universal ID type (synthesised)
                                            }
                                        }
                                    }
                                }
                            }
                            ELEMENT[at0101] occurrences matches {0..1} matches {    -- Building
                                value matches {
                                    DV_TEXT[at9013]
                                }
                            }
                            ELEMENT[at0102] occurrences matches {0..1} matches {    -- Floor
                                value matches {
                                    DV_TEXT[at9014]
                                }
                            }
                            ELEMENT[at0103] occurrences matches {0..1} matches {    -- Location description
                                value matches {
                                    DV_TEXT[at9015]
                                }
                            }
                            CLUSTER[at0084] occurrences matches {0..1} matches {    -- Address
                                items cardinality matches {1..*; unordered} matches {
                                    ELEMENT[at0085] occurrences matches {0..1} matches {    -- Street
                                        value matches {
                                            DV_TEXT[at9016]
                                        }
                                    }
                                    ELEMENT[at0086] occurrences matches {0..1} matches {    -- City
                                        value matches {
                                            DV_TEXT[at9017]
                                        }
                                    }
                                    ELEMENT[at0087] occurrences matches {0..1} matches {    -- State/province
                                        value matches {
                                            DV_TEXT[at9018]
                                        }
                                    }
                                    ELEMENT[at0088] occurrences matches {0..1} matches {    -- Post code
                                        value matches {
                                            DV_TEXT[at9019]
                                        }
                                    }
                                    ELEMENT[at0089] occurrences matches {0..1} matches {    -- Country
                                        value matches {
                                            DV_TEXT[at9020]
                                        }
                                    }
                                }
                            }
                            ELEMENT[at0081] occurrences matches {0..1} matches {    -- Location type
                                value matches {
                                    DV_CODED_TEXT[at9021] matches {
                                        defining_code matches {[ac9002]}    -- Location type (synthesised)
                                    }
                                }
                            }
                        }
                    }
                    ELEMENT[at0013] occurrences matches {0..1} matches {    -- Admission type
                        value matches {
                            DV_CODED_TEXT[at9022] matches {
                                defining_code matches {[ac9003]}    -- Admission type (synthesised)
                            }
                        }
                    }
                    ELEMENT[at0023] occurrences matches {0..1} matches {    -- Pre-admit number
                        value matches {
                            DV_TEXT[at9023]
                        }
                    }
                    CLUSTER[at0094] occurrences matches {0..1} matches {    -- Prior patient location
                        items cardinality matches {1..*; unordered} matches {
                            CLUSTER[at0119] occurrences matches {0..1} matches {    -- Facility
                                items cardinality matches {1..*; unordered} matches {
                                    use_node ELEMENT[at9024] occurrences matches {1} /data[at0001]/items[at0073]/items[at0104]/items[at0105]
                                    use_node ELEMENT[at9056] occurrences matches {1} /data[at0001]/items[at0073]/items[at0104]/items[at0106]    -- Facility (synthesised)
                                    use_node ELEMENT[at9057] occurrences matches {1} /data[at0001]/items[at0073]/items[at0104]/items[at0107]    -- Facility (synthesised)
                                }
                            }
                            CLUSTER[at0095] occurrences matches {0..1} matches {    -- Adress
                                items cardinality matches {1..*; unordered} matches {
                                    use_node ELEMENT[at9027] occurrences matches {1} /data[at0001]/items[at0073]/items[at0084]/items[at0085]
                                    use_node ELEMENT[at9058] occurrences matches {1} /data[at0001]/items[at0073]/items[at0084]/items[at0086]    -- Adress (synthesised)
                                    use_node ELEMENT[at9059] occurrences matches {1} /data[at0001]/items[at0073]/items[at0084]/items[at0087]    -- Adress (synthesised)
                                    use_node ELEMENT[at9060] occurrences matches {1} /data[at0001]/items[at0073]/items[at0084]/items[at0088]    -- Adress (synthesised)
                                    use_node ELEMENT[at9061] occurrences matches {1} /data[at0001]/items[at0073]/items[at0084]/items[at0089]    -- Adress (synthesised)
                                }
                            }
                            use_node ELEMENT[at9032] occurrences matches {1} /data[at0001]/items[at0073]/items[at0074]
                            use_node ELEMENT[at9062] occurrences matches {1} /data[at0001]/items[at0073]/items[at0077]    -- Prior patient location (synthesised)
                            use_node ELEMENT[at9063] occurrences matches {1} /data[at0001]/items[at0073]/items[at0078]    -- Prior patient location (synthesised)
                            use_node ELEMENT[at9064] occurrences matches {1} /data[at0001]/items[at0073]/items[at0079]    -- Prior patient location (synthesised)
                            use_node ELEMENT[at9065] occurrences matches {1} /data[at0001]/items[at0073]/items[at0101]    -- Prior patient location (synthesised)
                            use_node ELEMENT[at9066] occurrences matches {1} /data[at0001]/items[at0073]/items[at0102]    -- Prior patient location (synthesised)
                            use_node ELEMENT[at9067] occurrences matches {1} /data[at0001]/items[at0073]/items[at0103]    -- Prior patient location (synthesised)
                        }
                    }
                    CLUSTER[at0098] matches {    -- Attending doctor
                        items cardinality matches {1..*; unordered} matches {
                            ELEMENT[at0099] occurrences matches {0..1} matches {    -- ID
                                value matches {
                                    DV_TEXT[at9039]
                                }
                            }
                            ELEMENT[at0100] occurrences matches {0..1} matches {    -- Family name
                                value matches {
                                    DV_TEXT[at9040]
                                }
                            }
                            ELEMENT[at0120] occurrences matches {0..1} matches {    -- Last name
                                value matches {
                                    DV_TEXT[at9041]
                                }
                            }
                        }
                    }
                    CLUSTER[at0025] occurrences matches {0..1} matches {    -- Referring doctor
                        items cardinality matches {1..*; unordered} matches {
                            use_node ELEMENT[at9042] occurrences matches {1} /data[at0001]/items[at0098]/items[at0099]
                            use_node ELEMENT[at9068] occurrences matches {1} /data[at0001]/items[at0098]/items[at0100]    -- Referring doctor (synthesised)
                            use_node ELEMENT[at9069] occurrences matches {1} /data[at0001]/items[at0098]/items[at0120]    -- Referring doctor (synthesised)
                        }
                    }
                    CLUSTER[at0121] matches {    -- Consulting doctor
                        items cardinality matches {1..*; unordered} matches {
                            use_node ELEMENT[at9045] occurrences matches {1} /data[at0001]/items[at0098]/items[at0099]
                            use_node ELEMENT[at9070] occurrences matches {1} /data[at0001]/items[at0098]/items[at0100]    -- Consulting doctor (synthesised)
                            use_node ELEMENT[at9071] occurrences matches {1} /data[at0001]/items[at0098]/items[at0120]    -- Consulting doctor (synthesised)
                        }
                    }
                    ELEMENT[at0041] occurrences matches {0..1} matches {    -- Hospital service
                        value matches {
                            DV_TEXT[at9048]
                        }
                    }
                    ELEMENT[at0049] occurrences matches {0..1} matches {    -- Admit source
                        value matches {
                            DV_TEXT[at9049]
                        }
                    }
                    CLUSTER[at0051] occurrences matches {0..1} matches {    -- Admitting doctor
                        items cardinality matches {1..*; unordered} matches {
                            use_node ELEMENT[at9050] occurrences matches {1} /data[at0001]/items[at0098]/items[at0099]
                            use_node ELEMENT[at9072] occurrences matches {1} /data[at0001]/items[at0098]/items[at0100]    -- Admitting doctor (synthesised)
                            use_node ELEMENT[at9073] occurrences matches {1} /data[at0001]/items[at0098]/items[at0120]    -- Admitting doctor (synthesised)
                        }
                    }
                    ELEMENT[at0061] occurrences matches {0..1} matches {    -- Financial class
                        value matches {
                            DV_CODED_TEXT[at9053] matches {
                                defining_code matches {[ac9004]}    -- Financial class (synthesised)
                            }
                        }
                    }
                    ELEMENT[at0066] occurrences matches {0..1} matches {    -- Charge price indicator
                        value matches {
                            DV_CODED_TEXT[at9054] matches {
                                defining_code matches {[ac2]}    -- Any term that 'is a' 'Charge price indicator'
                            }
                        }
                    }
                    ELEMENT[at0071] occurrences matches {1} matches {    -- Admit date/time
                        value matches {
                            DV_DATE_TIME[at9055]
                        }
                    }
                }
            }
        }
    }

terminology
    term_definitions = <
        ["de"] = <
            ["at0000"] = <
                text = <"Patientenaufnahme">
                description = <"Wird nur für aufgenommene Patienten verwendet. Es signalisiert den Beginn des Aufenthalts eines Patienten in einer Gesundheitseinrichtung.">
            >
            ["at0002"] = <
