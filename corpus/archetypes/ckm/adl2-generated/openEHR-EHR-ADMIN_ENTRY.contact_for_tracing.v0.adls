                description = <"">
            >
            ["at0024"] = <
                text = <"Symptomatic?">
                description = <"Is the exposed individual reporting any relevant symptoms or signs?">
            >
            ["at0025"] = <
                text = <"Yes">
                description = <"">
            >
            ["at0026"] = <
                text = <"No">
                description = <"">
            >
            ["at0027"] = <
