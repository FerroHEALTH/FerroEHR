definition
    ADMIN_ENTRY[at0000] matches {    -- COVID outcomes
        data matches {
            ITEM_TREE[at0001] matches {
                items cardinality matches {0..*; unordered} matches {
                    ELEMENT[at0002] occurrences matches {0..1} matches {    -- Health outcome
                        value matches {
                            DV_CODED_TEXT[at9001] matches {
                                defining_code matches {[ac9000]}    -- Health outcome (synthesised)
                            }
                            DV_TEXT[at9002]
                        }
                    }
                    ELEMENT[at0007] occurrences matches {0..1} matches {    -- Date of release or death
                        value matches {
                            DV_DATE_TIME[at9003]
                        }
                    }
                    ELEMENT[at0008] occurrences matches {0..1} matches {    -- Total number of contacts
                        value matches {
                            DV_COUNT[at9004]
                            DV_CODED_TEXT[at9005] matches {
                                defining_code matches {[at0009]}    -- Unknown
                            }
                        }
                    }
                }
            }
        }
    }

