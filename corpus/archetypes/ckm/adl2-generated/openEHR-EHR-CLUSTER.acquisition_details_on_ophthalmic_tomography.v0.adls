    details = <
        ["en"] = <
            language = <[ISO_639-1::en]>
            purpose = <"Register details about settings specified to carry out the acquisitions of a study of ophthalmic tomography.">
            use = <"To specify the strategy of acquisitions for ophthalmic tomography either planning the study, or recording the procedure once has been carried out.">
            misuse = <"">
            copyright = <"© openEHR Foundation">
        >
    >

definition
    CLUSTER[at0000] matches {    -- Acquisition details on ophthalmic tomography
        items cardinality matches {1..*; unordered} matches {
            ELEMENT[at0001] occurrences matches {0..1} matches {    -- Laterality
                value matches {
                    DV_CODED_TEXT[at9008] matches {
                        defining_code matches {[ac9000]}    -- Laterality (synthesised)
                    }
                }
            }
            ELEMENT[at0072] occurrences matches {0..1} matches {    -- Acquisition method
                value matches {
                    DV_CODED_TEXT[at9009] matches {
                        defining_code matches {[ac9001]}    -- Acquisition method (synthesised)
                    }
                }
            }
            ELEMENT[at0064] matches {    -- Study outcome
                value matches {
                    DV_CODED_TEXT[at9010] matches {
                        defining_code matches {[ac9002]}    -- Study outcome (synthesised)
                    }
                }
            }
            CLUSTER[at0019] occurrences matches {0..1} matches {    -- Predefined scan
                items cardinality matches {1..*; unordered} matches {
                    ELEMENT[at0011] matches {    -- Study type
                        value matches {
                            DV_CODED_TEXT[at9011] matches {
                                defining_code matches {[ac9003]}    -- Study type (synthesised)
                            }
                        }
                    }
                    ELEMENT[at0005] matches {    -- Predefined scans
                        value matches {
                            DV_CODED_TEXT[at9012] matches {
                                defining_code matches {[ac9004]}    -- Predefined scans (synthesised)
                            }
                        }
                    }
                }
            }
            CLUSTER[at0047] occurrences matches {0..1} matches {    -- Custom scan
                items cardinality matches {1..*; unordered} matches {
                    ELEMENT[at0048] occurrences matches {0..1} matches {    -- Scan pattern
                        value matches {
                            DV_CODED_TEXT[at9013] matches {
                                defining_code matches {[ac9005]}    -- Scan pattern (synthesised)
                            }
                        }
                    }
                    ELEMENT[at0058] occurrences matches {0..1} matches {    -- Position of scan pattern
                        value matches {
                            DV_CODED_TEXT[at9014] matches {
                                defining_code matches {[ac2]}    -- Anatomic structures of eye
                            }
                        }
                    }
                    ELEMENT[at0054] occurrences matches {0..1} matches {    -- Scan size (width or diameter)
                        value matches {
                            DV_QUANTITY[at9015] matches {
                                property matches {[at9006]}    -- Angle, plane
                                units matches {"deg"}
                                precision matches {0}
                            }
                        }
                    }
                    ELEMENT[at0056] occurrences matches {0..1} matches {    -- Scan size (height)
                        value matches {
                            DV_QUANTITY[at9016] matches {
                                property matches {[at9006]}    -- Angle, plane
                                units matches {"deg"}
                                precision matches {0}
                            }
                        }
                    }
                    ELEMENT[at0062] occurrences matches {0..1} matches {    -- Distance between sections
                        value matches {
                            DV_QUANTITY[at9017] matches {
                                property matches {[at9007]}    -- Length
                                units matches {"um"}
                                precision matches {0}
                            }
                        }
                    }
                    ELEMENT[at0057] occurrences matches {0..1} matches {    -- Section scans
                        value matches {
                            DV_COUNT[at9018] matches {
                                magnitude matches {|>=1|}
                            }
                        }
                    }
                }
            }
        }
    }

