archetype (adl_version=2.4.0; rm_release=1.1.0; generated; uid=d5ed6f2c-1415-4f1d-8589-4a58553b048b; build_uid=7a04a0fa-925d-4c0d-9206-16c16be155ea)
    openEHR-EHR-CLUSTER.alcohol_consumption.v0.0.1-alpha

