definition
    CLUSTER[at0000] matches {    -- Anatomical location tooth
        items cardinality matches {1..*; unordered} matches {
            CLUSTER[at0001] matches {    -- Tooth site
                items cardinality matches {1..*; unordered} matches {
                    ELEMENT[at0002] occurrences matches {0..1} matches {    -- Tooth name
                        value matches {
                            DV_TEXT[at9005]
                        }
                    }
                    CLUSTER[at0003] matches {    -- Tooth number
                        items cardinality matches {1..*; unordered} matches {
                            ELEMENT[at0004] occurrences matches {0..1} matches {    -- Upper
                                value matches {
                                    DV_QUANTITY[at9006]
                                }
                            }
                            ELEMENT[at0005] occurrences matches {0..1} matches {    -- Lower
                                value matches {
                                    DV_QUANTITY[at9007]
                                }
                            }
                            ELEMENT[at0006] occurrences matches {0..1} matches {    -- Right
                                value matches {
                                    DV_QUANTITY[at9008]
                                }
                            }
                            ELEMENT[at0007] occurrences matches {0..1} matches {    -- Left
                                value matches {
                                    DV_QUANTITY[at9009]
                                }
                            }
                        }
                    }
                    ELEMENT[at0008] occurrences matches {0..1} matches {    -- Site name
                        value matches {
                            DV_CODED_TEXT[at9010] matches {
                                defining_code matches {[ac9000]}    -- Site name (synthesised)
                            }
                        }
                    }
                }
            }
            ELEMENT[at0009] occurrences matches {0..1} matches {    -- Aspect
                value matches {
                    DV_CODED_TEXT[at9011] matches {
                        defining_code matches {[ac9001]}    -- Aspect (synthesised)
                    }
                }
            }
            ELEMENT[at0010] occurrences matches {0..1} matches {    -- Tissue
                value matches {
                    DV_CODED_TEXT[at9012] matches {
                        defining_code matches {[ac9002]}    -- Tissue (synthesised)
                    }
                }
            }
            CLUSTER[at0011] matches {    -- Axis
                items cardinality matches {1..*; unordered} matches {
                    ELEMENT[at0012] occurrences matches {0..1} matches {    -- Normal status
                        value matches {
                            DV_BOOLEAN[at9013] matches {
                                value matches {True, False}
                            }
                        }
                    }
                    ELEMENT[at0013] occurrences matches {0..1} matches {    -- Absolute measurement
                        value matches {
                            DV_QUANTITY[at9014]
                        }
                    }
                    ELEMENT[at0014] occurrences matches {0..1} matches {    -- Relative dangle
                        value matches {
                            DV_QUANTITY[at9015]
                        }
                    }
                }
            }
            CLUSTER[at0015] matches {    -- Location
                items cardinality matches {1..*; unordered} matches {
                    ELEMENT[at0016] occurrences matches {0..1} matches {    -- Normal status
                        value matches {
                            DV_BOOLEAN[at9016] matches {
                                value matches {True, False}
                            }
                        }
                    }
                    CLUSTER[at0017] matches {    -- Absolute measurement
                        items cardinality matches {1..*; unordered} matches {
                            ELEMENT[at0018] occurrences matches {0..1} matches {    -- Landmark
                                value matches {
                                    DV_CODED_TEXT[at9017] matches {
                                        defining_code matches {[ac9003]}    -- Landmark (synthesised)
                                    }
                                }
                            }
                            ELEMENT[at0019] occurrences matches {0..1} matches {    -- XYZ
                                value matches {
                                    DV_QUANTITY[at9018]
                                }
                            }
                        }
                    }
                    CLUSTER[at0020] matches {    -- Relative location
                        items cardinality matches {1..*; unordered} matches {
                            ELEMENT[at0021] occurrences matches {0..1} matches {    -- Landmark
                                value matches {
                                    DV_TEXT[at9019]
                                }
                            }
                            ELEMENT[at0022] occurrences matches {0..1} matches {    -- Direction
                                value matches {
                                    DV_CODED_TEXT[at9020] matches {
                                        defining_code matches {[ac9004]}    -- Direction (synthesised)
                                    }
                                }
                            }
                            ELEMENT[at0023] occurrences matches {0..1} matches {    -- Distance from landmark
                                value matches {
                                    DV_QUANTITY[at9021]
                                }
                            }
                            ELEMENT[at0024] occurrences matches {0..1} matches {    -- Description
                                value matches {
                                    DV_TEXT[at9022]
                                }
                            }
                        }
                    }
                }
            }
        }
    }

