archetype (adl_version=2.4.0; rm_release=1.1.0; generated; uid=a6e5f197-a2b0-486f-8477-3913fd8ecbb8; build_uid=fddd7540-e9c9-42f0-b387-75039709781f)
    openEHR-EHR-CLUSTER.art_container_details.v0.0.1-alpha

language
    original_language = <[ISO_639-1::en]>

