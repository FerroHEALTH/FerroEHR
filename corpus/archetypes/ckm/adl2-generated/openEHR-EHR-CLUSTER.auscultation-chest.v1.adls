    details = <
        ["en"] = <
            language = <[ISO_639-1::en]>
            purpose = <"To record data found on examination of the chest by auscultation/listening.">
            keywords = <"auscultate", "listen", "auscultation", "listening", "lungs", "chest", "bruit", "heart", "bowel sounds", "breath sounds", "heart sounds">
            use = <"To be embedded in an openEHR-EHR-OBSERVATION.exam cluster to express findings determined by auscultation of the chest.">
            misuse = <"Not for use in any other context at present.">
            copyright = <"copyright (c) 2010 openEHR Foundation">
        >
    >

definition
    CLUSTER[at0000.1] matches {    -- Auscultation of the chest
        items matches {
            CLUSTER[at0001] matches {
                /items[at0003]/value[at9002]/defining_code matches {[ac9000.1]}    -- Normal Statement (synthesised)
            }
            CLUSTER[at0002] matches {
                items matches {
                    CLUSTER[at0009] matches {
                        items matches {
                            after [at0074]
                            use_node ELEMENT[at0.9046] occurrences matches {1} /items[at0004]    -- Bowel sounds (synthesised)
                        }
                    }
                    CLUSTER[at0089] matches {
                        items matches {
                            after [at0090]
                            use_node ELEMENT[at0.9047] occurrences matches {1} /items[at0002]/items[at0010]/items[at0030]    -- Other sounds (synthesised)
                        }
                    }
                    before [at0009]
                    CLUSTER[at0.15] occurrences matches {0..1} matches {    -- Heart sounds and bruits
                        items cardinality matches {1..*; unordered} matches {
                            CLUSTER[at0.16] occurrences matches {0..1} matches {    -- First heart sound
                                items cardinality matches {1..*; unordered} matches {
                                    ELEMENT[at0.17] occurrences matches {0..1} matches {    -- Volume
                                        value matches {
                                            DV_ORDINAL[at0.9016] matches {
                                                [value, symbol] matches {
                                                    [{0}, {[at0.18]}],    -- Not heard
                                                    [{1}, {[at0.19]}],    -- Variable
                                                    [{2}, {[at0.20]}],    -- Soft
                                                    [{3}, {[at0.21]}],    -- Normal
                                                    [{4}, {[at0.22]}]    -- Loud
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0.23] occurrences matches {0..1} matches {    -- Splitting
                                        value matches {
                                            DV_CODED_TEXT[at0.9017] matches {
                                                defining_code matches {[ac0.9001]}    -- Splitting (synthesised)
                                            }
                                        }
                                    }
                                    use_node ELEMENT[at0.9039] occurrences matches {1} /items[at0004]    -- First heart sound (synthesised)
                                }
                            }
                            CLUSTER[at0.29] occurrences matches {0..1} matches {    -- Second heart sound
                                items cardinality matches {1..*; unordered} matches {
                                    use_node ELEMENT[at0.9019] occurrences matches {1} /items[at0002]/items[at0.15]/items[at0.16]/items[at0.17]
                                    use_node ELEMENT[at0.9040] occurrences matches {1} /items[at0002]/items[at0.15]/items[at0.16]/items[at0.23]    -- Second heart sound (synthesised)
                                    use_node ELEMENT[at0.9041] occurrences matches {1} /items[at0004]    -- Second heart sound (synthesised)
                                }
                            }
                            CLUSTER[at0.75] matches {    -- Added heart sound
                                items cardinality matches {1..*; unordered} matches {
                                    ELEMENT[at0.76] matches {    -- Specific sound
                                        value matches {
                                            DV_CODED_TEXT[at0.9022] matches {
                                                defining_code matches {[ac0.9002]}    -- Specific sound (synthesised)
                                            }
                                        }
                                    }
                                    ELEMENT[at0.43] matches {    -- Phase of heart cycle
                                        value matches {
