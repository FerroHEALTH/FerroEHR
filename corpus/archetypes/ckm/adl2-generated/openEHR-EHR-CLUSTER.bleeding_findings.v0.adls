                description = <"Structured anatomical location of the bleeding.">
                comment = <"If the body site is identified in the 'Body site' element or in another archetype in which this archetype is nested, this data element may be redundant.">
            >
            ["at0018"] = <
                text = <"Body site">
                description = <"Identification of the body site of the bleeding.">
                comment = <"If the body site is identified in the 'Structured body site' SLOT or in another archetype in which this archetype is nested, this data element may be redundant.">
            >
            ["ac9000"] = <
