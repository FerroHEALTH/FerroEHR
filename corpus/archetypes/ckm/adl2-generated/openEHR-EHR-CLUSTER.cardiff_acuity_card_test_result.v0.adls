    >
    details = <
        ["en"] = <
            language = <[ISO_639-1::en]>
            purpose = <" For recording the raw card-level result of a single Cardiff acuity card test, expressed as the identifier of the finest card on which a reliable preferential-looking response was observed.

The Cardiff acuity test is a preferential-looking test that uses vanishing-optotype pictures (e.g. fish, house, duck,
  car, boat, train) printed at decreasing stroke widths on a sequence of cards. The result is conventionally reported as
   the card identifier (LVA, LVB, A–M) rather than as a Snellen, decimal or logMAR value, because the conversion to a VA
   notation depends on the testing distance and on the published card-to-acuity lookup for the edition of the test used.">
            use = <"  - Slot this cluster into the Test-specific results SLOT of the visual acuity archetype when the Cardiff acuity test
  has been used. The card identifier captured here is the primary, raw result of the test.
  - Any conversion of this card identifier to a notation-based VA value (decimal, logMAR, Snellen ratio, cycles per
  degree) should be recorded in the Derived Result cluster of the parent VA archetype, together with the testing
  distance and chart edition needed to interpret it.">
            misuse = <"">
            copyright = <"© openEHR Foundation">
        >
    >

definition
    CLUSTER[at0000] matches {    -- Cardiff acuity test result
        items cardinality matches {1..*; unordered} matches {
            ELEMENT[at0002] occurrences matches {0..1} matches {    -- Result
                value matches {
                    DV_CODED_TEXT[at9001] matches {
                        defining_code matches {[ac9000]}    -- Result (synthesised)
                    }
                }
            }
        }
    }

