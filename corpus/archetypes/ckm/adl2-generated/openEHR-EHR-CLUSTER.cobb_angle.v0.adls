    references = <
        ["1"] = <"Greiner, Allen K. \"Adolescent idiopathic scoliosis: radiologic decision-making.\" American family physician 65.9 (2002): 1817. Retrieved from: https://www.aafp.org/pubs/afp/issues/2002/0501/p1817.html">
        ["2"] = <"Horng MH, Kuok CP, Fu MJ, Lin CJ, Sun YN. Cobb Angle Measurement of Spine from X-Ray Images Using Convolutional Neural Network. Comput Math Methods Med. 2019 Feb 19;2019:6357171. doi: 10.1155/2019/6357171. PMID: 30996731; PMCID: PMC6399566.  ">
        ["3"] = <"Retrieved from: https://www.ncbi.nlm.nih.gov/pmc/articles/PMC6399566/#:~:text=In%20current%20clinical%20diagnosis%2C%20the,endplate%20of%20the%20lowest%20vertebra">
        ["4"] = <"https://radiopaedia.org/articles/cobb-angle">
        ["5"] = <"https://surgeryreference.aofoundation.org/spine/deformities/adolescent-idiopathic-scoliosis/further-reading/lenke-classification">
    >
