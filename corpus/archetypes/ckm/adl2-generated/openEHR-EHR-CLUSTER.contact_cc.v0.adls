archetype (adl_version=2.4.0; rm_release=1.1.0; generated; uid=94c4a7b7-3f89-4f80-bd82-d03a7ed688de; build_uid=f6b84eb8-fe0e-4fd7-bde4-8e3c6fdbae30)
    openEHR-EHR-CLUSTER.contact_cc.v0.0.1

language
    original_language = <[ISO_639-1::en]>

description
    original_author = <
        ["name"] = <"Hildegard McNicoll">
        ["organisation"] = <"freshEHR Clinical Informatics Ltd.">
        ["email"] = <"hildi@freshehr.com">
        ["date"] = <"2018-07-19">
    >
    original_namespace = <"org.openehr">
    original_publisher = <"openEHR Foundation">
    lifecycle_state = <"rejected">
