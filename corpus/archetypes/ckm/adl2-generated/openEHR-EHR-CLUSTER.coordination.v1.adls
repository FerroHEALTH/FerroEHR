    details = <
        ["en"] = <
            language = <[ISO_639-1::en]>
            purpose = <"To capture examination details about coordination.">
            keywords = <"coordination", "cerebellum", "dysdiadokinesis", "finger-nose", "heel-shin", "tapping">
            use = <"For use as a part of an examination OBSERVATION.">
            misuse = <"">
            copyright = <"© openEHR Foundation">
        >
    >

definition
    CLUSTER[at0000] matches {    -- Coordination
        items cardinality matches {1..*; unordered} matches {
            CLUSTER[at0001] occurrences matches {0..1} matches {    -- Normal Statements
                items cardinality matches {1..*; unordered} matches {
                    ELEMENT[at0002] matches {    -- Normal statement
                        value matches {
                            DV_CODED_TEXT[at9007] matches {
                                defining_code matches {}
                            }
                        }
                    }
                }
            }
            CLUSTER[at0003] occurrences matches {0..1} matches {    -- Findings
                items cardinality matches {1..*; unordered} matches {
                    ELEMENT[at0004] occurrences matches {0..1} matches {    -- Clinical Description
                        value matches {
                            DV_TEXT[at9008]
                        }
                    }
                    CLUSTER[at0050] matches {    -- General test findings
                        items cardinality matches {1..*; unordered} matches {
                            ELEMENT[at0051] occurrences matches {0..1} matches {    -- Test
                                value matches {
                                    DV_CODED_TEXT[at9009] matches {
                                        defining_code matches {[ac9000]}    -- Test (synthesised)
                                    }
                                }
                            }
                            use_node ELEMENT[at9022] occurrences matches {1} /items[at0003]/items[at0005]/items[at0045]    -- General test findings (synthesised)
                            use_node ELEMENT[at9023] occurrences matches {1} /items[at0003]/items[at0005]/items[at0009]    -- General test findings (synthesised)
                            use_node ELEMENT[at9024] occurrences matches {1} /items[at0003]/items[at0005]/items[at0041]    -- General test findings (synthesised)
                        }
                    }
                    CLUSTER[at0005] matches {    -- Specific test findings
                        items cardinality matches {1..*; unordered} matches {
                            ELEMENT[at0008] matches {    -- Test
                                value matches {
                                    DV_CODED_TEXT[at9013] matches {
                                        defining_code matches {[ac9001]}    -- Test (synthesised)
                                    }
                                }
                            }
                            ELEMENT[at0045] occurrences matches {0..1} matches {    -- Eyes open/closed
                                value matches {
                                    DV_CODED_TEXT[at9014] matches {
                                        defining_code matches {[ac9002]}    -- Eyes open/closed (synthesised)
                                    }
                                }
                            }
                            ELEMENT[at0007] occurrences matches {0..1} matches {    -- Intention tremor
                                value matches {
                                    DV_BOOLEAN[at9015] matches {
                                        value matches {True, False}
                                    }
                                }
                            }
                            ELEMENT[at0006] occurrences matches {0..1} matches {    -- Overshooting
                                value matches {
                                    DV_BOOLEAN[at9016] matches {
                                        value matches {True, False}
                                    }
                                }
                            }
                            ELEMENT[at0022] occurrences matches {0..1} matches {    -- Rate
                                value matches {
                                    DV_ORDINAL[at9017] matches {
                                        [value, symbol] matches {
                                            [{0}, {[at0030]}],    -- Normal
                                            [{1}, {[at0031]}],    -- Slightly slower than expected
                                            [{2}, {[at0032]}]    -- Much slower than expected
                                        }
                                    }
                                }
                            }
                            ELEMENT[at0026] occurrences matches {0..1} matches {    -- Fluidity
                                value matches {
                                    DV_ORDINAL[at9018] matches {
                                        [value, symbol] matches {
                                            [{0}, {[at0033]}],    -- Smooth and even
                                            [{1}, {[at0034]}],    -- Slightly uneven
                                            [{2}, {[at0035]}]    -- Markedly uneven
                                        }
                                    }
                                }
                            }
                            ELEMENT[at0041] occurrences matches {0..1} matches {    -- Affected side
                                value matches {
                                    DV_CODED_TEXT[at9019] matches {
                                        defining_code matches {[ac9005]}    -- Affected side (synthesised)
                                    }
                                }
                            }
                            ELEMENT[at0009] occurrences matches {0..1} matches {    -- Overall Performance
                                value matches {
                                    DV_ORDINAL[at9020] matches {
                                        [value, symbol] matches {
                                            [{0}, {[at0010]}],    -- Normal
                                            [{1}, {[at0011]}],    -- Mild impairment
                                            [{2}, {[at0012]}]    -- Marked impairment
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

