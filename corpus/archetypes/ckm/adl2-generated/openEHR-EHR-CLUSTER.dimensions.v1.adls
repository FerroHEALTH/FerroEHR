definition
    CLUSTER[at0000] matches {    -- Dimensions
        items cardinality matches {1..*; unordered} matches {
            ELEMENT[at0001] occurrences matches {0..1} matches {    -- Circumference
                value matches {
                    DV_QUANTITY[at9004] matches {
                        property matches {[at9000]}    -- Length
                        [units] matches {
                            [{"µm"}],
                            [{"mm"}],
                            [{"cm"}],
                            [{"m"}],
                            [{"ft"}],
                            [{"in"}],
                            [{"yd"}]
                        }
                    }
                }
            }
            ELEMENT[at0002] occurrences matches {0..1} matches {    -- Length
                value matches {
                    DV_QUANTITY[at9005] matches {
                        property matches {[at9000]}    -- Length
                        [units] matches {
                            [{"µm"}],
                            [{"mm"}],
                            [{"cm"}],
                            [{"m"}],
                            [{"ft"}],
                            [{"in"}],
                            [{"yd"}]
                        }
                    }
                }
            }
            ELEMENT[at0003] occurrences matches {0..1} matches {    -- Breadth
                value matches {
                    DV_QUANTITY[at9006] matches {
                        property matches {[at9000]}    -- Length
                        [units] matches {
                            [{"µm"}],
                            [{"mm"}],
                            [{"cm"}],
                            [{"m"}],
                            [{"ft"}],
                            [{"in"}],
                            [{"yd"}]
                        }
                    }
                }
            }
            ELEMENT[at0004] occurrences matches {0..1} matches {    -- Depth
                value matches {
                    DV_QUANTITY[at9007] matches {
                        property matches {[at9000]}    -- Length
                        [units] matches {
                            [{"µm"}],
                            [{"mm"}],
                            [{"cm"}],
                            [{"m"}],
                            [{"in"}],
                            [{"ft"}]
                        }
                    }
                }
            }
            ELEMENT[at0005] occurrences matches {0..1} matches {    -- Area
                value matches {
                    DV_QUANTITY[at9008] matches {
                        property matches {[at9001]}    -- Area
                        [units] matches {
                            [{"mm2"}],
                            [{"cm2"}],
                            [{"% body"}],
                            [{"% head, neck"}],
                            [{"% lower limb"}],
                            [{"% trunk"}],
                            [{"% upper limb"}],
                            [{"m2"}],
                            [{"in2"}],
                            [{"ft2"}]
                        }
                    }
                }
            }
            ELEMENT[at0006] occurrences matches {0..1} matches {    -- Volume
                value matches {
                    DV_QUANTITY[at9009] matches {
                        property matches {[at9002]}    -- Volume
                        [units] matches {
                            [{"mm3"}],
                            [{"ml"}],
                            [{"in3"}],
                            [{"cc"}],
                            [{"ft3"}]
                        }
                    }
                }
            }
        }
    }

