    details = <
        ["nb"] = <
            language = <[ISO_639-1::nb]>
            purpose = <"For å registrere resultatene for hver enkelt parameter og den resulterende risikogruppen for EAU NMIBC risikovurdering (2021).">
            keywords = <"blære", "kreft", "stratifisering", "TURBT", "ikke-muskelinvasiv", "urotelialt", "karsinom", "prognostisk", "gruppe">
            use = <"Brukes for å registrere resultatene for hver enkelt parameter og den resulterende risikogruppen for EAU NMIBC risikovurdering (2021), basert på WHO 2004/2016- eller WHO 1973-graderingssystemene.">
            misuse = <"">
            copyright = <"© openEHR Foundation">
        >
        ["en"] = <
            language = <[ISO_639-1::en]>
            purpose = <"To record each component parameter and the risk group for the EAU NMIBC risk assessment (2021).">
            keywords = <"bladder", "cancer", "stratification", "TURBT", "non–muscle-invasive", "urothelial", "carcinoma", "prognostic", "group">
            use = <"Use to record each component parameter and the risk group for the EAU NMIBC risk assessment (2021), based on the WHO 2004/2016 or WHO 1973 grading systems.">
            misuse = <"">
            copyright = <"© openEHR Foundation">
        >
    >

definition
    CLUSTER[at0000] matches {    -- EAU NMIBC risk assessment (2021)
        items cardinality matches {1..*; unordered} matches {
            ELEMENT[at0006] occurrences matches {0..1} matches {    -- Age
                value matches {
                    DV_CODED_TEXT[at9009] matches {
                        defining_code matches {[ac9000]}    -- Age (synthesised)
                    }
                }
            }
            ELEMENT[at0007] occurrences matches {0..1} matches {    -- Tumor status
                value matches {
                    DV_CODED_TEXT[at9010] matches {
                        defining_code matches {[ac9001]}    -- Tumor status (synthesised)
                    }
                }
            }
            ELEMENT[at0028] occurrences matches {0..1} matches {    -- Number of tumors
                value matches {
                    DV_CODED_TEXT[at9011] matches {
                        defining_code matches {[ac9002]}    -- Number of tumors (synthesised)
                    }
                }
            }
            ELEMENT[at0008] occurrences matches {0..1} matches {    -- Maximum tumor diameter
                value matches {
                    DV_CODED_TEXT[at9012] matches {
                        defining_code matches {[ac9003]}    -- Maximum tumor diameter (synthesised)
                    }
                }
            }
            ELEMENT[at0015] occurrences matches {0..1} matches {    -- Stage
                value matches {
                    DV_CODED_TEXT[at9013] matches {
                        defining_code matches {[ac9004]}    -- Stage (synthesised)
                    }
                }
            }
            ELEMENT[at0018] occurrences matches {0..1} matches {    -- Concomitant CIS
                value matches {
                    DV_CODED_TEXT[at9014] matches {
                        defining_code matches {[ac9005]}    -- Concomitant CIS (synthesised)
                    }
                }
            }
            ELEMENT[at0021] occurrences matches {0..1} matches {    -- WHO grade 2004/2016
                value matches {
                    DV_CODED_TEXT[at9015] matches {
                        defining_code matches {[ac9006]}    -- WHO grade 2004/2016 (synthesised)
                    }
                }
            }
            ELEMENT[at0024] occurrences matches {0..1} matches {    -- WHO grade 1973
                value matches {
                    DV_CODED_TEXT[at9016] matches {
                        defining_code matches {[ac9007]}    -- WHO grade 1973 (synthesised)
                    }
                }
            }
            ELEMENT[at0001] occurrences matches {1} matches {    -- Risk group
                value matches {
                    DV_CODED_TEXT[at9017] matches {
                        defining_code matches {[ac9008]}    -- Risk group (synthesised)
                    }
                }
            }
        }
    }

terminology
    term_definitions = <
        ["nb"] = <
            ["at0000"] = <
                text = <"EAU NMIBC risikogruppering (2021)">
                description = <"Den europeiske urologiforeningen (EAU) sin risikovurdering fra 2021 for ikke-muskelinvasiv blærekreft (NMIBC) stratifiserer pasienter basert på prognostiske faktorer som svulstkarakteristika, pasientens alder og WHO-graderingssystemer for urotheliale neoplasmer.">
            >
            ["at0001"] = <
                text = <"Risikogruppe">
                description = <"Risiko for residiv basert på parametrene.">
                comment = <"Ytterligere kliniske risikofaktorer er: alder > 70 år; multiple papillære tumorer; og tumordiameter > 3 cm.">
            >
            ["at0002"] = <
                text = <"Lav risiko">
                description = <"En primær, solitær TaT1 LG/G1-svulst &lt; 3 cm i diameter uten CIS hos en pasient ≤ 70 år ELLER en primær Ta LG/G1-svulst uten CIS med maksimalt ÉN av de ytterligere kliniske risikofaktorene.">
            >
            ["at0003"] = <
                text = <"Middels risiko">
                description = <"Pasienter uten CIS som ikke er inkludert i verken lav-, høy- eller svært høyrisikogruppene.">
            >
            ["at0004"] = <
                text = <"Høy risiko">
                description = <"Alle T1 HG/G3 uten CIS, UNNTATT de som er inkludert i gruppen med svært høy risiko ELLER Alle CIS-pasienter, UNNTATT de som er inkludert i gruppen med svært høy risiko ELLER Ta LG/G2 eller T1G1, ingen CIS med alle 3 risikofaktorer ELLER Ta HG/G3 eller T1 LG, ingen CIS med minst 2 risikofaktorer ELLER T1G2 ingen CIS med minst 1 risikofaktor.">
            >
            ["at0005"] = <
                text = <"Svært høy risiko">
                description = <"Ta HG/G3 og CIS med alle 3 risikofaktorer ELLER T1G2 og CIS med minst 2 risikofaktorer ELLER T1 HG/G3 og CIS med minst 1 risikofaktor ELLER T1 HG/G3 ingen CIS med alle 3 risikofaktorer.">
            >
            ["at0006"] = <
                text = <"Alder">
                description = <"">
            >
            ["at0007"] = <
                text = <"Tumorstatus">
                description = <"">
            >
            ["at0008"] = <
                text = <"Maksimum tumordiameter">
                description = <"">
            >
            ["at0009"] = <
                text = <"Primær">
                description = <"">
            >
            ["at0010"] = <
                text = <"Residiv">
                description = <"">
            >
            ["at0011"] = <
                text = <"< 3 cm">
                description = <"">
            >
            ["at0012"] = <
                text = <"≥ 3 cm">
                description = <"">
            >
            ["at0013"] = <
                text = <"≤ 70 år">
                description = <"">
            >
            ["at0014"] = <
                text = <"> 70 år">
                description = <"">
            >
            ["at0015"] = <
                text = <"Stadium">
                description = <"">
            >
            ["at0016"] = <
                text = <"Ta">
                description = <"Ikke-invasiv papillær tumor begrenset til urotelet.">
            >
            ["at0017"] = <
                text = <"T1">
                description = <"Tumorinfiltrasjon av lamina propria, uten infiltrasjon i muscularis propria.">
            >
            ["at0018"] = <
                text = <"Samtidig CIS">
                description = <"">
            >
            ["at0019"] = <
                text = <"Nei">
                description = <"">
            >
            ["at0020"] = <
                text = <"Ja">
                description = <"">
            >
            ["at0021"] = <
                text = <"WHO-grad 2004/2016">
                description = <"">
                comment = <"Bare ett av de to klassifiseringssystemene (WHO 1973 eller WHO 2004/2016) skal brukes om gangen.">
            >
            ["at0022"] = <
                text = <"LMP-LG">
                description = <"Ikke-invasive papillære tumorer med minimal atypi og ordnede celler.">
            >
            ["at0023"] = <
                text = <"HG">
                description = <"Tumorer med markert arkitektur og kjerneatypi, hyppige mitoser og tap av normal cellestruktur.">
            >
            ["at0024"] = <
                text = <"WHO-grad 1973">
                description = <"">
                comment = <"Bare ett av de to klassifiseringssystemene (WHO 1973 eller WHO 2004/2016) skal brukes om gangen.">
            >
            ["at0025"] = <
                text = <"G1">
                description = <"Veldifferensierte tumorer med minimal atypi og ordnet arkitektur.">
            >
            ["at0026"] = <
                text = <"G2">
                description = <"Moderat differensierte tumorer med intermediær atypi og arkitektoniske uregelmessigheter.">
            >
            ["at0027"] = <
                text = <"G3">
                description = <"Dårlig differensierte tumorer med markert atypi, desorganisert arkitektur og hyppige mitoser.">
            >
            ["at0028"] = <
                text = <"Antall svulster">
                description = <"">
            >
            ["at0029"] = <
                text = <"Solitær">
                description = <"">
            >
            ["at0030"] = <
                text = <"Multiple">
                description = <"">
            >
