    term_definitions = <
        ["de"] = <
            ["at0000"] = <
                text = <"Mitarbeiter im Gesundheitswesen">
                description = <"Zusätzliche Informationen für das Covid-Screening zum Status des Beschäftigten im Gesundheitswesen.">
