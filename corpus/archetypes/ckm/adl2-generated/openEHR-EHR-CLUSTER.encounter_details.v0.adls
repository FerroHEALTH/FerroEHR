archetype (adl_version=2.4.0; rm_release=1.1.0; generated; uid=8aae2b01-f970-4a25-a0a9-8da12f9bf2f2; build_uid=a0110921-5a6e-4007-b266-c5e8e70c303f)
    openEHR-EHR-CLUSTER.encounter_details.v0.0.1-alpha

