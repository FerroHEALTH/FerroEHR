definition
    CLUSTER[at0000.1] matches {    -- Examination of bone
        items matches {
            ELEMENT[at0002.1] matches {    -- Clinical description
                value matches {
                    DV_TEXT[at0.9006]
                }
            }
            CLUSTER[at0008] matches {
                items matches {
                    before [at0009]
                    CLUSTER[at0.12] matches {    -- Abnormal findings
                        items cardinality matches {1..*; unordered} matches {
                            ELEMENT[at0.14] occurrences matches {0..1} matches {    -- Location
                                value matches {
                                    DV_TEXT[at0.9001]
                                }
                            }
                            ELEMENT[at0.15] occurrences matches {0..1} matches {    -- Clinical description
                                value matches {
                                    DV_CODED_TEXT[at0.9002] matches {
                                        defining_code
                                    }
                                }
                            }
                            ELEMENT[at0.11] occurrences matches {0..1} matches {    -- Breach of bone integrity
                                value matches {
                                    DV_BOOLEAN[at0.9003] matches {
                                        value matches {True}
                                    }
                                }
                            }
                            ELEMENT[at0.13] occurrences matches {0..1} matches {    -- Angulation present
                                value matches {
                                    DV_BOOLEAN[at0.9004] matches {
                                        value matches {True}
                                    }
                                }
                            }
                            ELEMENT[at0.10] occurrences matches {0..1} matches {    -- Crepitus present
                                value matches {
                                    DV_BOOLEAN[at0.9005] matches {
                                        value matches {True}
                                    }
                                }
                            }
                        }
                    }
                }
            }
            before [at0004]
            ELEMENT[at0.9] occurrences matches {0..1} matches {    -- Name of bone
                value matches {
                    DV_CODED_TEXT[at0.9000] matches {
                        defining_code
                    }
                }
            }
        }
    }

