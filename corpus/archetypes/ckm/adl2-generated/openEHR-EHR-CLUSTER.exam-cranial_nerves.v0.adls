definition
    CLUSTER[at0000.1] matches {    -- Examination of cranial nerves
        items matches {
            ELEMENT[at0001.1] matches {    -- System or structure examined
                value matches {
                    DV_CODED_TEXT[at0.9002] matches {
                        defining_code matches {[at0.1]}    -- Cranial nerve
                    }
                }
            }
            ELEMENT[at0.11] occurrences matches {0..1} matches {    -- I description
                value matches {
                    DV_TEXT[at0.9003]
                }
            }
            allow_archetype CLUSTER[at0.2] matches {    -- I details
                include
                    archetype_id/value matches {/openEHR-EHR-CLUSTER\.exclusion_exam\.v1\..*/}
            }
            ELEMENT[at0.12] occurrences matches {0..1} matches {    -- II description
                value matches {
                    DV_TEXT[at0.9004]
                }
            }
            allow_archetype CLUSTER[at0.3] matches {    -- II details
                include
                    archetype_id/value matches {/openEHR-EHR-CLUSTER\.exclusion_exam\.v1\..*/}
            }
            ELEMENT[at0.13] occurrences matches {0..1} matches {    -- III, IV & VI description
                value matches {
                    DV_TEXT[at0.9005]
                }
            }
            allow_archetype CLUSTER[at0.4] matches {    -- III, IV & VI details
                include
                    archetype_id/value matches {/openEHR-EHR-CLUSTER\.exclusion_exam\.v1\..*|openEHR-EHR-CLUSTER\.exam-pupil\.v0\..*/}
            }
            ELEMENT[at0.14] occurrences matches {0..1} matches {    -- V description
                value matches {
                    DV_TEXT[at0.9006]
                }
            }
            ELEMENT[at0.20] occurrences matches {0..1} matches {    -- Corneal reflex
                value matches {
                    DV_CODED_TEXT[at0.9007] matches {
                        defining_code matches {[ac0.9000]}    -- Corneal reflex (synthesised)
                    }
                }
            }
            ELEMENT[at0.24] occurrences matches {0..1} matches {    -- Jaw jerk
                value matches {
                    DV_CODED_TEXT[at0.9008] matches {
                        defining_code matches {[ac0.9001]}    -- Jaw jerk (synthesised)
                    }
                }
            }
            allow_archetype CLUSTER[at0.5] matches {    -- V details
                include
                    archetype_id/value matches {/openEHR-EHR-CLUSTER\.exclusion_exam\.v1\..*/}
            }
            ELEMENT[at0.15] occurrences matches {0..1} matches {    -- VII description
                value matches {
                    DV_TEXT[at0.9009]
                }
            }
            allow_archetype CLUSTER[at0.6] matches {    -- VII details
                include
                    archetype_id/value matches {/openEHR-EHR-CLUSTER\.exclusion_exam\.v1\..*|openEHR-EHR-CLUSTER\.exam-face\.v0\..*/}
            }
            ELEMENT[at0.16] occurrences matches {0..1} matches {    -- VIII description
                value matches {
                    DV_TEXT[at0.9010]
                }
            }
            allow_archetype CLUSTER[at0.7] matches {    -- VIII details
                include
                    archetype_id/value matches {/openEHR-EHR-CLUSTER\.exclusion_exam\.v1\..*/}
            }
            ELEMENT[at0.17] occurrences matches {0..1} matches {    -- IX & X description
                value matches {
                    DV_TEXT[at0.9011]
                }
            }
            ELEMENT[at0.27] occurrences matches {0..1} matches {    -- Gag reflex
                value matches {
                    DV_CODED_TEXT[at0.9014] matches {
                        defining_code matches {[ac0.9000]}    -- Corneal reflex (synthesised)
                    }
                }
            }
            allow_archetype CLUSTER[at0.8] matches {    -- IX & X details
                include
                    archetype_id/value matches {/openEHR-EHR-CLUSTER\.exclusion_exam\.v1\..*|openEHR-EHR-CLUSTER\.exam-throat\.v0\..*/}
            }
            ELEMENT[at0.18] occurrences matches {0..1} matches {    -- XI description
                value matches {
                    DV_TEXT[at0.9012]
                }
            }
            allow_archetype CLUSTER[at0.9] matches {    -- XI details
                include
                    archetype_id/value matches {/openEHR-EHR-CLUSTER\.exclusion_exam\.v1\..*/}
            }
            ELEMENT[at0.19] occurrences matches {0..1} matches {    -- XII description
                value matches {
                    DV_TEXT[at0.9013]
                }
            }
            allow_archetype CLUSTER[at0.10] matches {    -- XII details
                include
                    archetype_id/value matches {/openEHR-EHR-CLUSTER\.exclusion_exam\.v1\..*|openEHR-EHR-CLUSTER\.exam-tongue\.v0\..*/}
            }
        }
    }

terminology
    term_definitions = <
        ["de"] = <
            ["at0.1"] = <
                text = <"Cranial nerve">
                description = <"One of each of twelve pairs of nerves which arise directly from the brain.">
            >
            ["at0.10"] = <
                text = <"XII details">
                description = <"Details about the function of the hypoglossal nerve.">
            >
            ["at0.11"] = <
                text = <"I description">
                description = <"Narrative description about findings on examination of the olfactory nerve.">
                comment = <"For example: summary about smell testing.">
            >
            ["at0.12"] = <
                text = <"II description">
                description = <"Narrative description about findings on examination of the optic nerve.">
            >
            ["at0.13"] = <
                text = <"III, IV & VI description">
                description = <"Narrative description about findings on examination of the oculomotor, trochlear and abducens nerves.">
            >
            ["at0.14"] = <
                text = <"V description">
                description = <"Narrative description about findings on examination of the trigeminal nerve.">
            >
            ["at0.15"] = <
                text = <"VII description">
                description = <"Narrative description about findings on examination of the facial nerve.">
            >
            ["at0.16"] = <
                text = <"VIII description">
                description = <"Narrative description about findings on examination of the vestibulococchlear nerve.">
            >
            ["at0.17"] = <
                text = <"IX & X description">
                description = <"Narrative description about findings on examination of the glossopharyngeal and vagus nerves.">
            >
            ["at0.18"] = <
                text = <"XI description">
                description = <"Narrative description about findings on examination of the accessory nerve.">
            >
            ["at0.19"] = <
                text = <"XII description">
                description = <"Narrative description about findings on examination of the hypoglossal nerve.">
            >
            ["at0.2"] = <
                text = <"I details">
                description = <"Details about function of the olfactory nerve.">
            >
            ["at0.20"] = <
                text = <"Corneal reflex">
                description = <"The presence of the corneal reflex.">
                comment = <"Also known as the 'blink reflex'.">
            >
            ["at0.21"] = <
                text = <"Present">
                description = <"The reflex is observed.">
            >
