definition
    CLUSTER[at0000.1] matches {    -- Examination of the fetus
        items matches {
            CLUSTER[at0008.1] matches {    -- Abdominal Findings
                items matches {
                    before [at0009]
                    ELEMENT[at0.4] occurrences matches {0..1} matches {    -- Lie of the fetus
                        value matches {
                            DV_CODED_TEXT[at0.9033] matches {
                                defining_code matches {[ac0.9000]}    -- Lie of the fetus (synthesised)
                            }
                        }
                    }
                    ELEMENT[at0.8] occurrences matches {0..1} matches {    -- Presentation
                        value matches {
                            DV_CODED_TEXT[at0.9034] matches {
                                defining_code matches {[ac0.9001]}    -- Presentation (synthesised)
                            }
                        }
                    }
                    ELEMENT[at0.42] occurrences matches {0..1} matches {    -- Position
                        value matches {
                            DV_CODED_TEXT[at0.9026] matches {
                                defining_code matches {[ac0.9002]}    -- Position (synthesised)
                            }
                        }
                    }
                    ELEMENT[at0.32] occurrences matches {0..1} matches {    -- Attitude
                        value matches {
                            DV_CODED_TEXT[at0.9027] matches {
                                defining_code matches {[ac0.9003]}    -- Attitude (synthesised)
                            }
                        }
                    }
                    CLUSTER[at0.74] occurrences matches {0..1} matches {    -- Engagement
                        items cardinality matches {1..*; unordered} matches {
                            ELEMENT[at0.22] occurrences matches {0..1} matches {    -- Fifths
                                value matches {
                                    DV_CODED_TEXT[at0.9028] matches {
                                        defining_code matches {[ac0.9004]}    -- Fifths (synthesised)
                                    }
                                }
                            }
                            ELEMENT[at0.75] occurrences matches {0..1} matches {    -- Qualitative
                                value matches {
                                    DV_CODED_TEXT[at0.9029] matches {
                                        defining_code matches {[ac0.9005]}    -- Qualitative (synthesised)
                                    }
                                }
                            }
                        }
                    }
                    ELEMENT[at0.14] occurrences matches {0..1} matches {    -- Size relative to gestation
                        value matches {
                            DV_CODED_TEXT[at0.9030] matches {
                                defining_code matches {[ac0.9006]}    -- Size relative to gestation (synthesised)
                            }
                        }
                    }
                    ELEMENT[at0.29] occurrences matches {0..1} matches {    -- Station
                        value matches {
                            DV_QUANTITY[at0.9031] matches {
                                property matches {[at0.9007]}    -- Length
                                magnitude matches {|-5.0..5.0|}
                                units matches {"cm"}
                                precision matches {0}
                            }
                        }
                    }
                    ELEMENT[at0.18] occurrences matches {0..1} matches {    -- Estimated fetal weight
                        value matches {
                            DV_QUANTITY[at0.9032] matches {
                                property matches {[at0.9008]}    -- Mass
                                [magnitude, units, precision] matches {
                                    [{|0.0..20.0|}, {"kg"}, {|>=0|}],
                                    [{|0.0..20000.0|}, {"gm"}, {0}]
                                }
                            }
                        }
                    }
                    allow_archetype CLUSTER[at0.89] occurrences matches {0..1} matches {    -- Size
                        include
                            archetype_id/value matches {/openEHR-EHR-CLUSTER\.physical_properties(-[a-zA-Z0-9_]+)*\.v1\..*/}
                    }
                }
            }
            after [at0008.1]
            CLUSTER[at0.80] occurrences matches {0..1} matches {    -- Vaginal findings
                items cardinality matches {1..*; unordered} matches {
                    ELEMENT[at0.84] occurrences matches {0..1} matches {    -- Flexion
                        value matches {
                            DV_CODED_TEXT[at0.9020] matches {
                                defining_code matches {[ac0.9009]}    -- Flexion (synthesised)
                            }
                        }
                    }
                    ELEMENT[at0.81] occurrences matches {0..1} matches {    -- Caput
                        value matches {
                            DV_TEXT[at0.9021]
                        }
                    }
                    ELEMENT[at0.82] occurrences matches {0..1} matches {    -- Moulding
                        value matches {
                            DV_TEXT[at0.9022]
                        }
                    }
                    ELEMENT[at0.88] occurrences matches {0..1} matches {    -- Asynclitic
                        value matches {
                            DV_TEXT[at0.9023]
                        }
                    }
                    use_node ELEMENT[at0.9035] occurrences matches {1} /items[at0008.1]/items[at0.42]    -- Vaginal findings (synthesised)
                    use_node ELEMENT[at0.9036] occurrences matches {1} /items[at0008.1]/items[at0.29]    -- Vaginal findings (synthesised)
                }
            }
        }
    }

terminology
    term_definitions = <
        ["en"] = <
            ["at0.10"] = <
                text = <"Breech">
                description = <"The breech is the presenting part.">
            >
            ["at0.11"] = <
                text = <"Full breech">
                description = <"The breech is presenting with the legs flexed.">
            >
            ["at0.12"] = <
                text = <"Extended breech">
                description = <"The breech is the presenting part with the leg(s) extended.">
            >
            ["at0.13"] = <
                text = <"Shoulder">
                description = <"The shoulder is the presenting part.">
            >
