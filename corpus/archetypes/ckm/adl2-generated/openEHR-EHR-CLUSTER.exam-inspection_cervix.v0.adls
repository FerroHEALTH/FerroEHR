definition
    CLUSTER[at0000.1] matches {    -- Inspection of the cervix
        items matches {
            ELEMENT[at0001.1] matches {    -- System or structure examined
                value matches {
                    DV_CODED_TEXT[at0.9002] matches {
                        defining_code matches {[at0.1]}    -- Cervix
                    }
                }
            }
            after [at0003]
            ELEMENT[at0.2] occurrences matches {0..1} matches {    -- Discharge presence
                value matches {
                    DV_CODED_TEXT[at0.9003] matches {
                        defining_code matches {[ac0.9000]}    -- Discharge presence (synthesised)
                    }
                }
            }
            ELEMENT[at0.5] occurrences matches {0..1} matches {    -- Discharge description
                value matches {
                    DV_TEXT[at0.9004]
                }
            }
            ELEMENT[at0.6] occurrences matches {0..1} matches {    -- Ectropion presence
                value matches {
                    DV_CODED_TEXT[at0.9005] matches {
                        defining_code matches {[ac0.9001]}    -- Ectropion presence (synthesised)
                    }
                }
            }
            ELEMENT[at0.7] occurrences matches {0..1} matches {    -- Ectropion description
                value matches {
                    DV_TEXT[at0.9006]
                }
            }
        }
    }

