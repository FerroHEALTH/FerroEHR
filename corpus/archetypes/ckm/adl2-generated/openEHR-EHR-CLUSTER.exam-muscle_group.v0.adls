definition
    CLUSTER[at0000.1] matches {    -- Examination findings of a muscle group
        items matches {
            ELEMENT[at0001.1] matches {    -- Muscle group
                value matches {
                    DV_TEXT[at0.9005]
                }
            }
            ELEMENT[at0.1] occurrences matches {0..1} matches {    -- Fasciculation
                value matches {
                    DV_CODED_TEXT[at0.9006] matches {
                        defining_code matches {[ac0.9000]}    -- Fasciculation (synthesised)
                    }
                }
            }
            ELEMENT[at0.5] occurrences matches {0..1} matches {    -- Atrophy
                value matches {
                    DV_CODED_TEXT[at0.9007] matches {
                        defining_code matches {[ac0.9001]}    -- Atrophy (synthesised)
                    }
                }
            }
            ELEMENT[at0.9] occurrences matches {0..1} matches {    -- Hypertrophy
                value matches {
                    DV_CODED_TEXT[at0.9008] matches {
                        defining_code matches {[ac0.9002]}    -- Hypertrophy (synthesised)
                    }
                }
            }
            ELEMENT[at0.13] occurrences matches {0..1} matches {    -- Tenderness
                value matches {
                    DV_CODED_TEXT[at0.9009] matches {
                        defining_code matches {[ac0.9003]}    -- Tenderness (synthesised)
                    }
                }
            }
            ELEMENT[at0.17] occurrences matches {0..1} matches {    -- Strength
                value matches {
                    DV_ORDINAL[at0.9010] matches {
                        [value, symbol] matches {
                            [{0}, {[at0.18]}],    -- No visible muscle contraction
                            [{1}, {[at0.19]}],    -- Visible muscle contraction with no or trace movement
                            [{2}, {[at0.20]}],    -- Limb movement, but not against gravity
                            [{3}, {[at0.21]}],    -- Movement against gravity but not resistance
                            [{4}, {[at0.22]}],    -- Movement against at least some resistance supplied by the examiner
                            [{5}, {[at0.23]}]    -- Full strength
                        }
                    }
                }
            }
        }
    }

