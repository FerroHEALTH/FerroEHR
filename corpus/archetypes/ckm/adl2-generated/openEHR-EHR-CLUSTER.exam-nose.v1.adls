                            }
                            CLUSTER[at0.34] occurrences matches {0..1} matches {    -- Nares
                                items cardinality matches {1..*; unordered} matches {
                                    ELEMENT[at0.35] occurrences matches {0..1} matches {    -- Nares patent?
                                        value matches {
                                            DV_BOOLEAN[at0.9001] matches {
                                                value matches {True, False}
                                            }
                                        }
                                    }
                                    ELEMENT[at0.38] occurrences matches {0..1} matches {    -- Nasal breathing?
                                        value matches {
                                            DV_BOOLEAN[at0.9002] matches {
                                                value matches {True, False}
                                            }
                                        }
                                    }
                                    use_node ELEMENT[at0.9003] occurrences matches {0..1} /items[at0008.1]/items[at0.11]/items[at0.10]    -- Nares (synthesised)
