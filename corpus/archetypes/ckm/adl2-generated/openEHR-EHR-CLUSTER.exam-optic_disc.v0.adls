            language = <[ISO_639-1::en]>
            purpose = <"To record a narrative description, structured details and clinical interpretation of the findings observed during the physical examination of the optic disc of an eye.">
            use = <"Use to record a narrative description, structured details and clinical interpretation of the findings observed during the physical examination of the optic disc of an eye.

