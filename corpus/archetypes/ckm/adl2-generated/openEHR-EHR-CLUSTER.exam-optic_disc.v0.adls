Not to be used for recording the results of an imaging examination - use the CLUSTER.imaging_exam family of archetypes for this purpose.(en)">
        >
    >

definition
    CLUSTER[at0000.1] matches {    -- Examination of the optic disc
        items matches {
            ELEMENT[at0001.1] matches {    -- System or structure examined
                value matches {
                    DV_CODED_TEXT[at0.9001] matches {
                        defining_code matches {[ac0.9000]}    -- System or structure examined (synthesised)
                    }
                }
            }
        }
    }

