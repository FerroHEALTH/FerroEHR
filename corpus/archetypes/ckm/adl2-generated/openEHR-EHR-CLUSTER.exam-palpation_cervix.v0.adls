definition
    CLUSTER[at0000.1] matches {    -- Palpation of the cervix
        items matches {
            ELEMENT[at0001.1] matches {    -- System or structure examined
                value matches {
                    DV_CODED_TEXT[at0.9006] matches {
                        defining_code matches {[at0.1]}    -- Cervix
                    }
                }
            }
            after [at0003]
            ELEMENT[at0.2] occurrences matches {0..1} matches {    -- Relative position
                value matches {
                    DV_CODED_TEXT[at0.9007] matches {
                        defining_code matches {[ac0.9000]}    -- Relative position (synthesised)
                    }
                }
            }
            ELEMENT[at0.8] occurrences matches {0..1} matches {    -- Consistency
                value matches {
                    DV_CODED_TEXT[at0.9008] matches {
                        defining_code matches {[ac0.9001]}    -- Consistency (synthesised)
                    }
                }
            }
            ELEMENT[at0.12] occurrences matches {0..1} matches {    -- Surface description
                value matches {
                    DV_TEXT[at0.9009]
                }
            }
            ELEMENT[at0.13] occurrences matches {0..1} matches {    -- Mobility
                value matches {
                    DV_TEXT[at0.9010]
                }
            }
            ELEMENT[at0.14] occurrences matches {0..1} matches {    -- Tenderness
                value matches {
                    DV_TEXT[at0.9011]
                }
            }
            ELEMENT[at0.15] occurrences matches {0..1} matches {    -- Thickness
                value matches {
                    DV_CODED_TEXT[at0.9012] matches {
                        defining_code matches {[ac0.9002]}    -- Thickness (synthesised)
                    }
                }
            }
            ELEMENT[at0.20] occurrences matches {0..1} matches {    -- Effacement
                value matches {
                    DV_PROPORTION[at0.9013] matches {
                        numerator matches {|0.0..100.0|}
                        type matches {2}
                    }
                }
            }
            ELEMENT[at0.21] occurrences matches {0..1} matches {    -- Cervical length
                value matches {
                    DV_QUANTITY[at0.9014] matches {
                        property matches {[at0.9003]}    -- Length
                        magnitude matches {|0.0..10.0|}
                        units matches {"cm"}
                    }
                }
            }
            ELEMENT[at0.22] occurrences matches {0..1} matches {    -- Application to presenting part
                value matches {
                    DV_CODED_TEXT[at0.9015] matches {
                        defining_code matches {[ac0.9004]}    -- Application to presenting part (synthesised)
                    }
                }
            }
            ELEMENT[at0.23] occurrences matches {0..1} matches {    -- Anterior lip presence
                value matches {
                    DV_CODED_TEXT[at0.9016] matches {
                        defining_code matches {[ac0.9005]}    -- Anterior lip presence (synthesised)
                    }
                }
            }
            ELEMENT[at0.28] occurrences matches {0..1} matches {    -- External os dilation
                value matches {
                    DV_QUANTITY[at0.9017] matches {
                        property matches {[at0.9003]}    -- Length
                        magnitude matches {|0.0..10.0|}
                        units matches {"cm"}
                    }
                }
            }
            after [at0004]
            ELEMENT[at0.29] occurrences matches {0..1} matches {    -- Internal os dilation
                value matches {
                    DV_QUANTITY[at0.9018] matches {
                        property matches {[at0.9003]}    -- Length
                        magnitude matches {|0.0..10.0|}
                        units matches {"cm"}
                    }
                }
            }
        }
    }

terminology
    term_definitions = <
        ["de"] = <
            ["at0000.1"] = <
                text = <"*Palpation of the cervix (en)">
                description = <"*Findings obtained by manual palpation of the cervix. (en)">
            >
            ["at0001.1"] = <
                text = <"Untersuchtes System oder untersuchte Struktur">
                description = <"Identifizierung des untersuchten Körpersystems oder der anatomischen Struktur.">
                comment = <"Wenn möglich wird die Kodierung des untersuchten Systems oder der untersuchten Struktur mit einer Terminologie bevorzugt.">
            >
            ["at0.1"] = <
                text = <"*Cervix (en)">
                description = <"">
            >
            ["at0.2"] = <
                text = <"*Relative position (en)">
                description = <"*Actual cervical position in relation to the expected, central anatomical position. (en)">
            >
            ["at0.3"] = <
                text = <"*Anterior (en)">
                description = <"*The cervix is pointing anteriorly, towards the pubis. (en)">
            >
            ["at0.4"] = <
                text = <"*Normal (en)">
                description = <"*The cervix is located centrally, in the typical anatomical position. (en)">
            >
            ["at0.5"] = <
                text = <"*Posterior (en)">
                description = <"*The cervix is pointing posteriorly, towards the sacrum. (en)">
            >
            ["at0.6"] = <
                text = <"*Left (en)">
                description = <"*The cervix is pointing towards the left side of the pelvis. (en)">
            >
            ["at0.7"] = <
                text = <"*Right (en)">
                description = <"*The cervix is pointing towards the right side of the pelvis. (en)">
            >
            ["at0.8"] = <
                text = <"*Consistency (en)">
                description = <"*The firmness of the cervix. (en)">
            >
            ["at0.9"] = <
                text = <"*Firm (en)">
                description = <"*The cervix feels firm or hard. (en)">
            >
            ["at0.10"] = <
                text = <"*Intermediate (en)">
                description = <"*The cervix feels neither firm nor soft. (en)">
            >
            ["at0.11"] = <
                text = <"*Soft (en)">
                description = <"*The cervix feels soft or ripe. (en)">
            >
            ["at0.12"] = <
                text = <"*Surface description (en)">
                description = <"*Narrative description about the surface of the cervix. (en)">
            >
            ["at0.13"] = <
                text = <"*Mobility (en)">
                description = <"*Narrative description of the mobility of the cervix (en).">
            >
            ["at0.14"] = <
                text = <"*Tenderness (en)">
                description = <"*Narrative description about any tenderness associated  with the cervix, especially on movement. (en)">
            >
            ["at0.15"] = <
                text = <"*Thickness (en)">
                description = <"*Relative distance from the internal os to the external surface of the cervix. (en)">
            >
            ["at0.16"] = <
                text = <"*Thick (en)">
                description = <"*The cervix is thick. (en)">
            >
            ["at0.17"] = <
                text = <"*Thin (en)">
                description = <"*The cervix is thin. (en)">
            >
            ["at0.18"] = <
                text = <"*Paper-thin (en)">
                description = <"*The cervix is very thin. (en)">
            >
            ["at0.19"] = <
                text = <"*Oedematous (en)">
                description = <"*The cervix is thickened and swollen. (en)">
            >
            ["at0.20"] = <
                text = <"*Effacement (en)">
                description = <"*Estimation of the amount of cervical effacement, usually related to late pregnancy or labour. (en)">
            >
            ["at0.21"] = <
                text = <"*Cervical length (en)">
                description = <"*Estimation of the length of the cervix during late pregnancy or labour. (en)">
            >
            ["at0.22"] = <
                text = <"*Application to presenting part (en)">
                description = <"*Application of the cervix to the presenting part of the fetus during late pregnancy or labour. (en)">
            >
            ["at0.23"] = <
                text = <"*Anterior lip presence (en)">
                description = <"">
            >
            ["at0.24"] = <
                text = <"*Loose (en)">
                description = <"*Cervix is not moulded to the fetal presenting part. (en)">
            >
            ["at0.25"] = <
                text = <"*Tight (en)">
                description = <"*Cervix is closely moulded to the fetal presenting part. (en)">
            >
            ["at0.26"] = <
                text = <"*Present (en)">
                description = <"*An anterior lip is present. (en)">
            >
            ["at0.27"] = <
                text = <"*Absent (en)">
                description = <"*An anterior lip is not present. (en)">
            >
            ["at0.28"] = <
                text = <"*External os dilation (en)">
                description = <"*The amount of dilation of the external opening of the cervix. (en)">
            >
            ["at0.29"] = <
                text = <"*Internal os dilation (en)">
                description = <"*The amount of dilation of the internal opening of the cervix to the uterus. (en)">
            >
            ["at0.9003"] = <
                text = <"* Length (en)">
                description = <"* Length (en)">
            >
            ["ac0.9000"] = <
                text = <"*Relative position (en) (synthesised)">
                description = <"*Actual cervical position in relation to the expected, central anatomical position. (en) (synthesised)">
            >
            ["ac0.9001"] = <
                text = <"*Consistency (en) (synthesised)">
                description = <"*The firmness of the cervix. (en) (synthesised)">
            >
            ["ac0.9002"] = <
                text = <"*Thickness (en) (synthesised)">
                description = <"*Relative distance from the internal os to the external surface of the cervix. (en) (synthesised)">
            >
            ["ac0.9004"] = <
                text = <"*Application to presenting part (en) (synthesised)">
                description = <"*Application of the cervix to the presenting part of the fetus during late pregnancy or labour. (en) (synthesised)">
            >
            ["ac0.9005"] = <
                text = <"*Anterior lip presence (en) (synthesised)">
                description = <" (synthesised)">
            >
        >
