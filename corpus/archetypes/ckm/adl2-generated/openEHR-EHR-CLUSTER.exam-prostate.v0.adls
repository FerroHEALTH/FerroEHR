definition
    CLUSTER[at0000.1] matches {    -- Palpation of the prostate
        items matches {
            ELEMENT[at0001.1] matches {    -- System or structure examined
                value matches {
                    DV_CODED_TEXT[at0.9000] matches {
                        defining_code matches {[at0.1]}    -- Prostate
                    }
                }
            }
        }
    }

