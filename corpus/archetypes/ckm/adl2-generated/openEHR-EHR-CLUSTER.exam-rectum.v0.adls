definition
    CLUSTER[at0000.1] matches {    -- Examination of the rectum
        items matches {
            after [at0006]
            CLUSTER[at0.1] matches {    -- Lesions
                items cardinality matches {1..*; unordered} matches {
                    ELEMENT[at0.2] occurrences matches {1} matches {    -- Lesion type
                        value matches {
                            DV_TEXT[at0.9003]
                        }
                    }
                    ELEMENT[at0.4] occurrences matches {0..1} matches {    -- Presence
                        value matches {
                            DV_CODED_TEXT[at0.9004] matches {
                                defining_code matches {[ac0.9000]}    -- Presence (synthesised)
                            }
                        }
                    }
                    ELEMENT[at0.52] occurrences matches {0..1} matches {    -- Number of lesions
                        value matches {
                            DV_COUNT[at0.9005]
                        }
                    }
                    ELEMENT[at0.6] occurrences matches {0..1} matches {    -- Clinical description
                        value matches {
                            DV_TEXT[at0.9006]
                        }
                    }
                    allow_archetype CLUSTER[at0.8] matches {    -- Per lesion details
                        include
                            archetype_id/value matches {/openEHR-EHR-CLUSTER\.exam_lesion\.v0\..*/}
                    }
                    allow_archetype CLUSTER[at0.9] matches {    -- Additional details
                        include
                            archetype_id/value matches {/.*/}
                    }
                    ELEMENT[at0.12] occurrences matches {0..1} matches {    -- Comment
                        value matches {
                            DV_TEXT[at0.9007]
                        }
                    }
                }
            }
            allow_archetype CLUSTER[at0.13] matches {    -- Mucosa
                include
                    archetype_id/value matches {/.*/}
            }
            CLUSTER[at0.32] occurrences matches {0..1} matches {    -- Bleeding
                items cardinality matches {1..*; unordered} matches {
                    ELEMENT[at0.33] occurrences matches {0..1} matches {    -- Presence
                        value matches {
                            DV_CODED_TEXT[at0.9008] matches {
                                defining_code matches {[ac0.9001]}    -- Presence (synthesised)
                            }
                        }
                    }
                    ELEMENT[at0.36] occurrences matches {0..1} matches {    -- Description
                        value matches {
                            DV_TEXT[at0.9009]
                        }
                    }
                    ELEMENT[at0.37] occurrences matches {0..1} matches {    -- Source
                        value matches {
                            DV_TEXT[at0.9010]
                        }
                    }
                    ELEMENT[at0.38] occurrences matches {0..1} matches {    -- Colour
                        value matches {
                            DV_TEXT[at0.9011]
                        }
                    }
                    ELEMENT[at0.39] occurrences matches {0..1} matches {    -- Physical state
                        value matches {
                            DV_TEXT[at0.9012]
                        }
                    }
                    ELEMENT[at0.40] occurrences matches {0..1} matches {    -- Amount
                        value matches {
                            DV_CODED_TEXT[at0.9013] matches {
                                defining_code matches {[ac0.9002]}    -- Amount (synthesised)
                            }
                            DV_TEXT[at0.9014]
                        }
                    }
                    ELEMENT[at0.42] occurrences matches {0..1} matches {    -- Comment
                        value matches {
                            DV_TEXT[at0.9015]
                        }
                    }
                }
            }
            ELEMENT[at0.15] occurrences matches {0..1} matches {    -- Faecal loading
                value matches {
                    DV_TEXT[at0.9016]
                }
            }
            allow_archetype CLUSTER[at0.20] matches {    -- Faeces
                include
                    archetype_id/value matches {/.*|openEHR-EHR-CLUSTER\.exam_faeces\.v0\..*/}
            }
            allow_archetype CLUSTER[at0.21] matches {    -- Foreign object
                include
                    archetype_id/value matches {/.*/}
            }
            after [at0008]
            ELEMENT[at0007]
        }
    }

terminology
    term_definitions = <
        ["de"] = <
            ["at0000.1"] = <
                text = <"*Examination of the rectum (en)">
                description = <"*Findings observed during the physical examination of the rectum. (en)">
            >
            ["at0.1"] = <
                text = <"*Lesions (en)">
                description = <"*Findings related to any palpable or visible lesion or mass  found within the rectum on examination. (en)">
            >
            ["at0.2"] = <
                text = <"*Lesion type (en)">
                description = <"*A short descriptive name or identifier for the lesion or mass. (en)">
                comment = <"*For example: ulcer, polyp, nodule, erosion, tumour. (en)">
            >
            ["at0.4"] = <
                text = <"*Presence (en)">
                description = <"*Assertion about the observed presence or absence of a lesion or mass during the examination. (en)">
            >
            ["at0.6"] = <
                text = <"*Clinical description (en)">
                description = <"*Narrative description of the overall findings observed during the examination per lesion type. (en)">
            >
            ["at0.8"] = <
                text = <"*Per lesion details (en)">
                description = <"*Specific features or attributes that apply to this individual lesion or mass. (en)">
            >
            ["at0.9"] = <
                text = <"*Additional details (en)">
                description = <"*Other relevant clinical observations about the lesion type or masses that are not otherwise described. (en)">
            >
            ["at0.12"] = <
                text = <"*Comment (en)">
                description = <"*Additional narrative about the findings on examination of the lesion, not captured in other fields. (en)">
            >
            ["at0.13"] = <
                text = <"*Mucosa (en)">
                description = <"*Findings related to the appearance and integrity of the rectal mucosa found on examination. (en)">
            >
            ["at0.15"] = <
                text = <"*Faecal loading (en)">
                description = <"*Assessment of amount of faecal material within the rectum. (en)">
                comment = <"*For example: none, mild, moderate, severe. (en)">
            >
            ["at0.20"] = <
                text = <"*Faeces (en)">
                description = <"*Documentation of the observed characteristics of stool present during the examination. (en)">
            >
            ["at0.21"] = <
                text = <"*Foreign object (en)">
                description = <"*Findings of any non-biological or unexpected item found within the rectum during examination. (en)">
            >
            ["at0.32"] = <
                text = <"*Bleeding (en)">
                description = <"*Findings related to blood identified in the rectum. (en)">
            >
            ["at0.33"] = <
                text = <"*Presence (en)">
                description = <"*Assertion about the observed presence or absence of bleeding in the rectum. (en)">
            >
            ["at0.34"] = <
                text = <"*Present (en)">
                description = <"">
            >
            ["at0.35"] = <
                text = <"*Absent (en)">
                description = <"">
            >
            ["at0.36"] = <
                text = <"*Description (en)">
                description = <"*Narrative description of observed bleeding. (en)">
            >
            ["at0.37"] = <
                text = <"*Source (en)">
                description = <"*The apparent origin of the bleeding if identifiable. (en)">
                comment = <"*For example: from lesion, from rectal mucosa, diffuse. (en)">
            >
            ["at0.38"] = <
                text = <"*Colour (en)">
                description = <"*The observed colour of the blood present. (en)">
                comment = <"*For example: bright red (fresh), dark red, black. (en)">
            >
            ["at0.39"] = <
                text = <"*Physical state (en)">
                description = <"*Describes the physical attributes of the blood in the rectum. (en)">
                comment = <"*For example: liquid, clotted.

 (en)">
            >
            ["at0.40"] = <
                text = <"*Amount (en)">
                description = <"*The estimated volume of blood present. (en)">
            >
            ["at0.42"] = <
                text = <"*Comment (en)">
                description = <"*Additional narrative about the physical examination findings, not captured in other fields. (en)">
            >
            ["at0.43"] = <
                text = <"*None (en)">
                description = <"">
            >
            ["at0.44"] = <
                text = <"*Trace amount (en)">
                description = <"">
            >
            ["at0.45"] = <
                text = <"*Small amount (en)">
                description = <"">
            >
            ["at0.46"] = <
                text = <"*Moderate amount (en)">
                description = <"">
            >
            ["at0.47"] = <
                text = <"*Large amount (en)">
                description = <"">
            >
            ["at0.48"] = <
                text = <"*Rectum filled with blood (en)">
                description = <"">
            >
            ["at0.49"] = <
                text = <"*Present (en)">
                description = <"">
            >
            ["at0.50"] = <
                text = <"*Absent (en)">
                description = <"">
            >
            ["at0.51"] = <
                text = <"*Indeterminate (en)">
                description = <"">
            >
            ["at0.52"] = <
                text = <"*Number of lesions (en)">
                description = <"*The total count of distinct lesions or masses identified. (en)">
            >
            ["at0.54"] = <
                text = <"*Indeterminate (en)">
                description = <"">
            >
            ["ac0.9000"] = <
                text = <"*Presence (en) (synthesised)">
                description = <"*Assertion about the observed presence or absence of a lesion or mass during the examination. (en) (synthesised)">
            >
            ["ac0.9001"] = <
                text = <"*Presence (en) (synthesised)">
                description = <"*Assertion about the observed presence or absence of bleeding in the rectum. (en) (synthesised)">
            >
            ["ac0.9002"] = <
                text = <"*Amount (en) (synthesised)">
                description = <"*The estimated volume of blood present. (en) (synthesised)">
            >
        >
