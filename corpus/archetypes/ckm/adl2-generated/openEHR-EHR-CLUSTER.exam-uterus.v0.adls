        ["sv"] = <
            ["at0000.1"] = <
                text = <"*Examination of the uterus (en)">
                description = <"*Findings observed during the palpation of the uterus. (en)">
            >
            ["at0.1"] = <
                text = <"*Length (en)">
                description = <"*The estimated length from the fundus to the cervix. (en)">
                comment = <"*Measured in centimetres. (en)">
            >
            ["at0.2"] = <
                text = <"*Size estimation (en)">
                description = <"*Size estimation of the uterus. (en)">
                comment = <"*An estimation of uterine size based on physical examination, documented as either a narrative description or a comparative estimate related to size of a pregnant uterus, such as '10 weeks'. These comparisons refer to the typical uterine size at specific stages of pregnancy and provide a standardised reference framework. Alternatively, locally recognised size descriptors, such as 'orange' or 'tennis ball' may be added to the DV_TEXT data type in a template to support a predefined list of terms. (en)">
            >
            ["at0.3"] = <
                text = <"*Fundal height (en)">
                description = <"*The vertical distance from the symphysis pubis to the top of the pregnant uterine fundus. (en)">
                comment = <"*Usually only possible in pregnancy after approximately 20 weeks of gestation. This can be recorded as the measured distance or by identifying the height of the uterine fundus relative to identifiable anatomical landmarks, such as  the pubic symphysis, umbilicus, xiphoid process). (en)">
            >
            ["at0.4"] = <
                text = <"*Not palpable (en)">
                description = <"*Uterus is not palpable in the abdomen. (en)">
            >
            ["at0.5"] = <
                text = <"*At public symphsis (en)">
                description = <"*The uterus is just palpable at the level of the symphysis pubis. (en)">
            >
            ["at0.6"] = <
                text = <"*At umbilicus (en)">
                description = <"*The uterus is palpable at, or about, the level of the umbilicus. (en)">
            >
            ["at0.7"] = <
                text = <"*At xiphisternum (en)">
                description = <"*The uterus is palpable at, or about, the level of the xiphisternum. (en)">
            >
            ["at0.12"] = <
                text = <"*Mobility (en)">
                description = <"*The degree to which the uterus can be displaced during bimanual examination, reflecting its freedom of movement within the pelvis. (en)">
            >
            ["at0.13"] = <
                text = <"*Mobile (en)">
                description = <"*The uterus moves freely in response to gentle pressure during bimanual palpation, without resistance or pain. (en)">
            >
            ["at0.14"] = <
                text = <"*LImited (en)">
                description = <"*The uterus can be displaced on bimanual palpation but with some resistance or reduced range of motion. (en)">
            >
            ["at0.15"] = <
                text = <"*Fixed (en)">
                description = <"*The uterus does not move or is unable to be displaced on bimanual palpation. (en)">
            >
            ["at0.8"] = <
                text = <"*Tenderness (en)">
                description = <"*The presence or absence of pain elicited during bimanual palpation of the uterus. (en)">
            >
            ["at0.9"] = <
                text = <"*Present (en)">
                description = <"*Pain is elicited on bimanual palpation of the uterus. (en)">
            >
            ["at0.10"] = <
                text = <"*Absent (en)">
                description = <"*No pain is elicited on bimanual palpation of the uterus. (en)">
            >
            ["at0.11"] = <
                text = <"*Tenderness decription (en)">
                description = <"*Narrative description about findings of pain or tenderness of the uterus. (en)">
                comment = <"*For e.g. Tenderness present on anterior uterine wall, elicited during bimanual palpation, described by the patient as sharp and localized. (en)">
            >
            ["at0.16"] = <
                text = <"*Shape (en)">
                description = <"*The overall anatomical contour of the uterus as assessed during bimanual palpation. (en)">
                comment = <"*For eg. Normal pear-shaped uterus. (en)">
            >
            ["at0.17"] = <
                text = <"*Consistency (en)">
                description = <"*Narrative description about the texture and firmness of the uterus. (en)">
            >
            ["at0.18"] = <
                text = <"*Version (en)">
                description = <"*The orientation of the cervix relative to the vagina. (en)">
            >
            ["at0.19"] = <
                text = <"*Anteverted (en)">
                description = <"*The cervix tilts forward toward the bladder. (en)">
            >
            ["at0.20"] = <
                text = <"*Neutral (en)">
                description = <"*The cervix is roughly in line with the vagina. (en)">
            >
            ["at0.21"] = <
                text = <"*Retroverted (en)">
                description = <"*The cervix tilts backward toward the rectum. (en)">
            >
            ["at0.22"] = <
                text = <"*Flexion (en)">
                description = <"*The orientation of the vagina relative to the cervix. (en)">
            >
            ["at0.23"] = <
                text = <"*Anteflexed (en)">
                description = <"*The body of the uterus bends forward over the bladder. (en)">
            >
            ["at0.24"] = <
                text = <"*Midflexed (en)">
                description = <"*The body is aligned with the cervix. (en)">
            >
            ["at0.25"] = <
                text = <"*Retroflexed (en)">
                description = <"*The body of the uterus bends backward toward the rectum. (en)">
            >
