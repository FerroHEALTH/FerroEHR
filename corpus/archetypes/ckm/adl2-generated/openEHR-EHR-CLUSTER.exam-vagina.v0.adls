definition
    CLUSTER[at0000.1] matches {    -- Examination of the vagina
        items matches {
            ELEMENT[at0.6] occurrences matches {0..1} matches {    -- Bleeding presence
                value matches {
                    DV_CODED_TEXT[at0.9007] matches {
                        defining_code matches {[ac0.9001]}    -- Bleeding presence (synthesised)
                    }
                }
            }
            ELEMENT[at0.10] occurrences matches {0..1} matches {    -- Bleeding description
                value matches {
                    DV_TEXT[at0.9008]
                }
            }
            allow_archetype CLUSTER[at0.11] matches {    -- Bleeding details
                include
                    archetype_id/value matches {/.*/}
            }
            allow_archetype CLUSTER[at0.12] matches {    -- Lesion details
                include
                    archetype_id/value matches {/.*/}
            }
            ELEMENT[at0.13] occurrences matches {0..1} matches {    -- Tenderness presence
                value matches {
                    DV_CODED_TEXT[at0.9009] matches {
                        defining_code matches {[ac0.9002]}    -- Tenderness presence (synthesised)
                    }
                }
            }
            ELEMENT[at0.17] occurrences matches {0..1} matches {    -- Tenderness description
                value matches {
                    DV_TEXT[at0.9010]
                }
            }
            allow_archetype CLUSTER[at0.18] matches {    -- Tenderness details
                include
                    archetype_id/value matches {/.*/}
            }
            ELEMENT[at0.19] occurrences matches {0..1} matches {    -- Prolapse presence
                value matches {
                    DV_CODED_TEXT[at0.9011] matches {
                        defining_code matches {[ac0.9003]}    -- Prolapse presence (synthesised)
                    }
                }
            }
            ELEMENT[at0.23] occurrences matches {0..1} matches {    -- Prolapse description
                value matches {
                    DV_TEXT[at0.9012]
                }
            }
            ELEMENT[at0.24] occurrences matches {0..1} matches {    -- Mucosa description
                value matches {
                    DV_TEXT[at0.9013]
                }
            }
            allow_archetype CLUSTER[at0.25] matches {    -- Mucosa details
                include
                    archetype_id/value matches {/.*/}
            }
            ELEMENT[at0.26] occurrences matches {0..1} matches {    -- Foreign body presence
                value matches {
                    DV_CODED_TEXT[at0.9014] matches {
                        defining_code matches {[ac0.9004]}    -- Foreign body presence (synthesised)
                    }
                }
            }
            ELEMENT[at0.30] occurrences matches {0..1} matches {    -- Foreign body description
                value matches {
                    DV_TEXT[at0.9015]
                }
            }
            allow_archetype CLUSTER[at0.31] matches {    -- Foreign body details
                include
                    archetype_id/value matches {/.*/}
            }
            after [at0007]
            ELEMENT[at0.1] occurrences matches {0..1} matches {    -- Discharge presence
                value matches {
                    DV_CODED_TEXT[at0.9005] matches {
                        defining_code matches {[ac0.9000]}    -- Discharge presence (synthesised)
                    }
                }
            }
            ELEMENT[at0.5] occurrences matches {0..1} matches {    -- Discharge description
                value matches {
                    DV_TEXT[at0.9006]
                }
            }
        }
    }

