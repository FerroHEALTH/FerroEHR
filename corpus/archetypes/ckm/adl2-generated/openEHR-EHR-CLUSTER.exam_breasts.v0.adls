archetype (adl_version=2.4.0; rm_release=1.1.0; generated; uid=e1de9374-6175-4051-bc4f-b738787b1173; build_uid=9f59a46e-2e07-4a06-9019-72fd2327c4cb)
    openEHR-EHR-CLUSTER.exam_breasts.v0.0.1

language
    original_language = <[ISO_639-1::en]>

