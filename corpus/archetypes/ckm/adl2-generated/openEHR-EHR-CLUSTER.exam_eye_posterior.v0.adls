archetype (adl_version=2.4.0; rm_release=1.1.0; generated; uid=d1cd2ab5-197c-4b93-b615-b237371e0138; build_uid=7719c557-8d1b-4e0d-aa63-af99b5aecf0f)
    openEHR-EHR-CLUSTER.exam_eye_posterior.v0.0.1

language
    original_language = <[ISO_639-1::en]>

description
    original_author = <
        ["name"] = <"Heather Leslie">
        ["organisation"] = <"Ocean Informatics">
        ["email"] = <"heather.leslie@oceaninformatics.com">
        ["date"] = <"2015-07-09">
    >
