archetype (adl_version=2.4.0; rm_release=1.1.0; generated; uid=7950e3f9-5149-4b50-8d27-a55a168c0d78; build_uid=053365ed-8588-4219-b119-7ca0e7afad1a)
    openEHR-EHR-CLUSTER.exam_face.v0.0.2

