    details = <
        ["en"] = <
            language = <[ISO_639-1::en]>
            purpose = <"For recording the findings on physical examination of the pupils.">
            keywords = <"eye", "pupil", "reflex", "PERL", "PERLA", "inspection", "examination">
            use = <"Use to record the findings on physical examination of the pupils.

Use to incorporate the narrative descriptions of clinical findings within existing or legacy clinical systems into an archetyped format, using the 'Clinical Description' data element.

Specifically designed to be used within the OBSERVATION.exam archetype, but may be used within any clinically appropriate ENTRY or CLUSTER archetype.">
            misuse = <"Not to be used to record findings of the physical examination of other parts of the eye, such as the retina - use other specific archetypes for this purpose.">
            copyright = <"© openEHR Foundation">
        >
        ["sl"] = <
            language = <[ISO_639-1::sl]>
            purpose = <"Za dokumentiranje opazovanj zenic v ZN">
            keywords = <"zenice", "refleks", "oči">
            use = <"Uporablja se za opazovanje zenic v ZN">
            misuse = <"">
            copyright = <"© openEHR Foundation">
        >
    >

definition
    CLUSTER[at0000] matches {    -- Examination Findings  - Pupils
        items cardinality matches {1..*; unordered} matches {
            ELEMENT[at0069] occurrences matches {0..1} matches {    -- Description
                value matches {
                    DV_TEXT[at9028]
                }
            }
            ELEMENT[at0071] occurrences matches {0..1} matches {    -- Symmetry
                value matches {
                    DV_CODED_TEXT[at9029] matches {
                        defining_code matches {[ac9000]}    -- Symmetry (synthesised)
                    }
                }
            }
            CLUSTER[at0075] occurrences matches {0..2} matches {    -- Per Pupil
                items cardinality matches {1..*; unordered} matches {
                    ELEMENT[at0015] occurrences matches {1} matches {    -- Pupil Examined
                        value matches {
                            DV_CODED_TEXT[at9030] matches {
                                defining_code matches {[ac9001]}    -- Pupil Examined (synthesised)
                            }
                        }
                    }
                    ELEMENT[at0005] occurrences matches {0..1} matches {    -- Shape
                        value matches {
                            DV_CODED_TEXT[at9031] matches {
                                defining_code matches {[ac9002]}    -- Shape (synthesised)
                            }
                        }
                    }
                    ELEMENT[at0002] occurrences matches {0..1} matches {    -- Measured Size
                        value matches {
                            DV_QUANTITY[at9032] matches {
                                property matches {[at9003]}    -- Length
                                magnitude matches {|0.0..30.0|}
                                units matches {"mm"}
                                precision matches {0}
                            }
                        }
                    }
                    ELEMENT[at0020] occurrences matches {0..1} matches {    -- Estimated Size
                        value matches {
                            DV_CODED_TEXT[at9033] matches {
                                defining_code matches {[ac9004]}    -- Estimated Size (synthesised)
                            }
                        }
                    }
                    ELEMENT[at0003] occurrences matches {0..1} matches {    -- Direct Light Reflex
                        value matches {
                            DV_CODED_TEXT[at9034] matches {
                                defining_code matches {[ac9005]}    -- Direct Light Reflex (synthesised)
                            }
                        }
                    }
                    ELEMENT[at0004] occurrences matches {0..1} matches {    -- Consensual Light Reflex
                        value matches {
                            DV_CODED_TEXT[at9035] matches {
                                defining_code matches {[ac9006]}    -- Consensual Light Reflex (synthesised)
                            }
                        }
                    }
                    ELEMENT[at0006] occurrences matches {0..1} matches {    -- Accommodation Reflex
                        value matches {
                            DV_CODED_TEXT[at9036] matches {
                                defining_code matches {[ac9007]}    -- Accommodation Reflex (synthesised)
                            }
                        }
                    }
                    ELEMENT[at0053] occurrences matches {0..1} matches {    -- Relative Afferent Pupillary Defect
                        value matches {
                            DV_CODED_TEXT[at9037] matches {
                                defining_code matches {[ac9008]}    -- Relative Afferent Pupillary Defect (synthesised)
                            }
                        }
                    }
                    allow_archetype CLUSTER[at0078] matches {    -- Examination detail
                        include
                            archetype_id/value matches {/.*/}
                    }
                    ELEMENT[at0076] matches {    -- Interpretation
                        value matches {
                            DV_TEXT[at9038]
                        }
                    }
                    ELEMENT[at0070] matches {    -- Image
                        value matches {
                            DV_MULTIMEDIA[at9039] matches {
                                media_type matches {[ac9027]}    -- Image (synthesised)
                            }
                        }
                    }
                }
            }
            ELEMENT[at0068] matches {    -- Interpretation
                value matches {
                    DV_TEXT[at9040]
                }
            }
            ELEMENT[at0077] matches {    -- Image
                value matches {
                    DV_MULTIMEDIA[at9041] matches {
                        media_type matches {[ac9027]}    -- Image (synthesised)
                    }
                }
            }
            ELEMENT[at0027] occurrences matches {0..1} matches {    -- Comment
                value matches {
                    DV_TEXT[at9042]
                }
            }
        }
    }

