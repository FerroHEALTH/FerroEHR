    details = <
        ["en"] = <
            language = <[ISO_639-1::en]>
            purpose = <"For recording a narrative description and clinical interpretation of the findings observed during the physical examination of the vagina.">
            use = <"Use to record a narrative description of the overall findings observed during the physical examination of the vagina. This initial draft archetype consists only of the core examination pattern data elements (as per CLUSTER.exam_pattern) and will likely be expanded further over time as specific clinical requirements are identified.

This archetype has been specifically designed to be used in the 'Examination detail' SLOT within the OBSERVATION.exam archetype, but can also be used within other OBSERVATION or CLUSTER archetypes, where clinically appropriate - for example, CLUSTER.exam_vulva.

Use to provide a framework in which CLUSTER archetypes can be nested in the 'Examination findings' SLOT to record additional structured physical examination findings - for example, CLUSTER.exam_cervix. 

The CLUSTER.exclusion_exam archetype can be nested within the 'Examination not done' SLOT to optionally record explicit details about the examination not being performed.

Use to incorporate the narrative descriptions of clinical findings within existing or legacy clinical systems into an archetyped format, using the 'Clinical Description' data element.">
            misuse = <"Not to be used for recording data not related to the physical examination of the vagina.

Not to be used for recording the clinical history - use specific OBSERVATION and CLUSTER archetypes. For example OBSERVATION.story and CLUSTER.symptom.

Not to be used to record stand-alone clinical observations or measurements or test results - use specific OBSERVATION archetypes. For example OBSERVATION.blood_pressure or OBSERVATION.imaging_exam.">
            copyright = <"© openEHR Foundation">
        >
    >

definition
    CLUSTER[at0000] matches {    -- Examination of the vagina
        items cardinality matches {1..*; unordered} matches {
            ELEMENT[at0002] occurrences matches {0..1} matches {    -- No abnormality detected
                value matches {
                    DV_BOOLEAN[at9004] matches {
                        value matches {True}
                    }
                }
            }
            ELEMENT[at0003] occurrences matches {0..1} matches {    -- Clinical description
                value matches {
                    DV_TEXT[at9005]
                }
            }
            allow_archetype CLUSTER[at0004] matches {    -- Examination findings
                include
                    archetype_id/value matches {/openEHR-EHR-CLUSTER\.exam_cervix(-[a-zA-Z0-9_]+)*\.v0\..*/}
            }
            allow_archetype CLUSTER[at0005] matches {    -- Multimedia representation
                include
                    archetype_id/value matches {/openEHR-EHR-CLUSTER\.multimedia(-[a-zA-Z0-9_]+)*\.v1\..*/}
            }
            ELEMENT[at0006] matches {    -- Clinical interpretation
                value matches {
                    DV_TEXT[at9006]
                }
            }
            ELEMENT[at0007] occurrences matches {0..1} matches {    -- Comment
                value matches {
                    DV_TEXT[at9007]
                }
            }
            allow_archetype CLUSTER[at0008] matches {    -- Examination not done
                include
                    archetype_id/value matches {/openEHR-EHR-CLUSTER\.exclusion_exam(-[a-zA-Z0-9_]+)*\.v1\..*/}
            }
            ELEMENT[at0011] occurrences matches {0..1} matches {    -- Currently menstruating
                value matches {
                    DV_BOOLEAN[at9008] matches {
                        value matches {True, False}
                    }
                }
            }
            ELEMENT[at0012] occurrences matches {0..1} matches {    -- Recent removal of tampon
                value matches {
                    DV_BOOLEAN[at9009] matches {
                        value matches {True, False}
                    }
                }
            }
            CLUSTER[at0013] occurrences matches {0..1} matches {    -- Discharge
                items cardinality matches {1..*; unordered} matches {
                    ELEMENT[at0014] occurrences matches {0..1} matches {    -- Presence
                        value matches {
                            DV_BOOLEAN[at9010] matches {
                                value matches {True, False}
                            }
                        }
                    }
                    ELEMENT[at0015] occurrences matches {0..1} matches {    -- Amount
                        value matches {
                            DV_CODED_TEXT[at9011] matches {
                                defining_code matches {[ac9000]}    -- Amount (synthesised)
                            }
                        }
                    }
                    ELEMENT[at0016] occurrences matches {0..1} matches {    -- Appearance
                        value matches {
                            DV_CODED_TEXT[at9012] matches {
                                defining_code matches {[ac9001]}    -- Appearance (synthesised)
                            }
                        }
                    }
                    ELEMENT[at0017] occurrences matches {0..1} matches {    -- Smell
                        value matches {
                            DV_CODED_TEXT[at9013] matches {
                                defining_code matches {[ac9002]}    -- Smell (synthesised)
                            }
                        }
                    }
                }
            }
            ELEMENT[at0022] occurrences matches {0..1} matches {    -- Mucosa
                value matches {
                    DV_CODED_TEXT[at9014] matches {
                        defining_code matches {[ac9003]}    -- Mucosa (synthesised)
                    }
                }
            }
            ELEMENT[at0026] occurrences matches {0..1} matches {    -- Tenderness
                value matches {
                    DV_BOOLEAN[at9015] matches {
                        value matches {True, False}
                    }
                }
            }
        }
    }

