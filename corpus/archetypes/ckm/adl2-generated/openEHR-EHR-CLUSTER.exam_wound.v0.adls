                }
            }
            CLUSTER[at0150] matches {    -- Periwound appearance
                items cardinality matches {1..*; unordered} matches {
                    ELEMENT[at0127] occurrences matches {1} matches {    -- Skin type
                        value matches {
                            DV_CODED_TEXT[at9067] matches {
                                defining_code matches {[ac9045]}    -- Skin type (synthesised)
                            }
                            DV_TEXT[at9068]
                        }
                    }
                    ELEMENT[at0151] occurrences matches {0..1} matches {    -- Presence
                        value matches {
