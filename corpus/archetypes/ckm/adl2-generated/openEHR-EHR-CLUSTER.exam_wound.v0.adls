terminology
    term_definitions = <
        ["en"] = <
            ["at0000"] = <
                text = <"Examination of a wound">
                description = <"Findings observed during the physical examination of a wound.">
            >
            ["at0001"] = <
                text = <"System or structure examined">
                description = <"Identification of the examined body system or anatomical structure.">
                comment = <"For example: the very generic term \"skin\", which will likely require additional qualification using one of the 'Body site' data elements, or the complete phrase \"skin of right knee\". Coding of the system or structure examined with a terminology is preferred, where possible.">
            >
            ["at0003"] = <
                text = <"Clinical description">
                description = <"Narrative description of the overall findings observed during the examination of a wound.">
            >
            ["at0004"] = <
                text = <"Additional findings">
                description = <"Structured details about the wound not captured in the other fields.">
            >
            ["at0005"] = <
                text = <"Multimedia representation">
                description = <"Digital image, video or diagram representing the wound findings.">
            >
            ["at0006"] = <
                text = <"Clinical interpretation">
                description = <"Single word, phrase or brief description that represents the clinical meaning and significance of the wound findings.">
                comment = <"Coding of the 'Clinical interpretation' with a terminology is preferred, where possible.">
            >
            ["at0007"] = <
                text = <"Comment">
                description = <"Additional narrative about the wound findings, not captured in other fields.">
            >
            ["at0008"] = <
                text = <"Examination not done">
                description = <"Details to explicitly record that this examination was not performed.">
            >
            ["at0011"] = <
                text = <"Structured body site">
                description = <"A structured description of the area of the body under examination.">
                comment = <"If the body site has been fully identified in the 'System or structure examined' or the 'Body site' data element, this SLOT becomes redundant.">
            >
            ["at0012"] = <
                text = <"Body site">
                description = <"Identification of the area of the body under examination.">
                comment = <"For example: \"entire body\", \"face\" or \"right cheek\". If the body site has been fully identified in the 'System or structure examined' data element, this data element becomes redundant.">
            >
            ["at0013"] = <
                text = <"Undermining present?">
                description = <"Is undermining present in the wound?">
                comment = <"For example: color; induration; warmth; or oedema.">
            >
            ["at0014"] = <
                text = <"Internal object or structure">
                description = <"Details about the observation of any exposed body structures, devices, and/or foreign bodies visible by the naked eye in a wound.">
            >
            ["at0015"] = <
                text = <"Object/structure">
                description = <"Idnetification of an exposed body structure, device, and/or foreign body visible by the naked eye within the wound.">
                comment = <"Coding of the visible internal structure if preferred, if possible.">
            >
            ["at0016"] = <
                text = <"Wound label">
                description = <"A name or alias for a single wound, so that it can be distinguished from other wounds.">
            >
            ["at0017"] = <
                text = <"Tunnelling present?">
                description = <"Is tunnelling present in the wound?">
            >
            ["at0020"] = <
                text = <"Present or absent?">
                description = <"Is the object/structure present?">
            >
            ["at0021"] = <
                text = <"Present">
                description = <"The identified object or structure is observed in the wound.">
            >
            ["at0022"] = <
                text = <"Absent">
                description = <"The identified object or structure is not observed in the wound.">
            >
            ["at0023"] = <
                text = <"Indeterminate">
                description = <"It is not possible to tell if the  identified object or structure is present or absent in the wound.">
            >
            ["at0024"] = <
                text = <"Description">
                description = <"Narrative description about the associated factor.">
            >
            ["at0025"] = <
                text = <"Comment">
                description = <"Additional narrative about the associated factor, not captured in other fields.">
            >
            ["at0026"] = <
                text = <"Present">
                description = <"Undermining is observed in the wound.">
            >
            ["at0027"] = <
                text = <"Absent">
                description = <"Undermining is not observed in the wound.">
            >
            ["at0028"] = <
                text = <"Indeterminate">
                description = <"It is not possible to tell if undermining is present or absent.">
            >
            ["at0029"] = <
                text = <"Present">
                description = <"Tunnelling is observed in the wound.">
            >
            ["at0030"] = <
                text = <"Absent">
                description = <"Tunnelling is not observed in the wound.">
            >
            ["at0031"] = <
                text = <"Indeterminate">
                description = <"It is not possible to tell if a tunnel is present or absent.">
            >
            ["at0032"] = <
                text = <"Exudate present?">
                description = <"Is an exudate present in the wound?">
            >
            ["at0033"] = <
                text = <"Present">
                description = <"An exudate is observed in the wound.">
            >
            ["at0034"] = <
                text = <"Absent">
                description = <"An exudate is not observed in the wound.">
            >
            ["at0035"] = <
                text = <"Indeterminate">
                description = <"It is not possible to tell if an exudate is present or absent.">
            >
            ["at0036"] = <
                text = <"Length">
                description = <"The length of the wound, in the longest dimension.">
            >
            ["at0037"] = <
                text = <"Width">
                description = <"The width of the wound, perpendicular to longest dimension.">
            >
            ["at0038"] = <
                text = <"Depth">
                description = <"The depth of the wound.">
            >
            ["at0039"] = <
                text = <"Area">
                description = <"The area of the wound.">
            >
            ["at0041"] = <
                text = <"Undermining details">
                description = <"Details about undermining of the wound.">
                comment = <"Multiple occurrences of this cluster will allow recording of the undermining occurring in different parts of the wound.">
            >
            ["at0042"] = <
                text = <"Amount of undermining">
                description = <"Amount of tissue destruction that extends under the intact wound edge.">
            >
            ["at0044"] = <
                text = <"Direction of undermining">
                description = <"Direction of the undermining outward from the centre of the wound, as described by a clock-face.">
                comment = <"For example: one o'clock.">
            >
            ["at0045"] = <
                text = <"Tunnelling details">
                description = <"Details about tunnelling into other tissues.">
                comment = <"Multiple occurrences of this cluster will allow recording about each tunnel that leads from the wound.">
            >
            ["at0046"] = <
                text = <"Tunnel length">
                description = <"Length of an identified tunnel radiating out from the centre of the wound.">
            >
            ["at0047"] = <
                text = <"Direction of tunnel">
                description = <"Direction of the tunnel radiating outward from the centre of the wound, as described by a clock-face.">
                comment = <"For example: one o'clock.">
            >
            ["at0048"] = <
                text = <"Edge description">
                description = <"Narrative description about the edge of the wound.">
            >
            ["at0049"] = <
                text = <"Edge color">
                description = <"The colour of the wound edge.">
            >
            ["at0051"] = <
                text = <"Wound bed tissue">
                description = <"Details about the appearance of the base of the wound.">
                comment = <"Multiple occurrences of this Cluster allow for recordings of multiple discrete areas of different appearances..">
            >
            ["at0052"] = <
                text = <"Tissue type">
                description = <"Description of the tissue in the wound base.">
                comment = <"For example: necrotic; sloughing; fibrinous; eschar; or granulation tissue.">
            >
            ["at0053"] = <
                text = <"Proportion">
                description = <"The proportion of the wound that has the identified appearance.">
                comment = <"This is the the area of the base of the wound that has a specific appearance, compared to the total area of the wound bed and represented as a percentage.">
            >
            ["at0054"] = <
                text = <"Wound bed colour">
                description = <"Details about the colour of the base of the wound.">
