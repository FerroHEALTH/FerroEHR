                    }
                }
            }
            ELEMENT[at0155] occurrences matches {0..1} matches {    -- Periwound temperature
                value matches {
                    DV_CODED_TEXT[at9071] matches {
                        defining_code matches {[ac9047]}    -- Periwound temperature (synthesised)
                    }
                }
            }
            CLUSTER[at0060] matches {    -- Association
                items cardinality matches {2..*; unordered} matches {
                    ELEMENT[at0061] occurrences matches {1} matches {    -- Factor
                        value matches {
                            DV_TEXT[at9018]
                        }
                    }
                    ELEMENT[at0062] occurrences matches {1} matches {    -- Present or absent?
                        value matches {
                            DV_CODED_TEXT[at9019] matches {
                                defining_code matches {[ac9002]}    -- Present or absent? (synthesised)
                            }
                        }
                    }
                }
            }
            CLUSTER[at0054] matches {    -- Wound bed colour
                items cardinality matches {1..*; unordered} matches {
                    ELEMENT[at0055] occurrences matches {1} matches {    -- Colour
                        value matches {
                            DV_CODED_TEXT[at9072] matches {
                                defining_code matches {[ac9041]}    -- Edge color (synthesised)
                            }
                            DV_TEXT[at9020]
                        }
                    }
                    ELEMENT[at0056] occurrences matches {0..1} matches {    -- Proportion
                        value matches {
                            DV_PROPORTION[at9021] matches {
                                numerator matches {|0.0..100.0|}
                                type matches {2}
                                precision matches {0}
                            }
                        }
                    }
                }
            }
            CLUSTER[at0051] matches {    -- Wound bed tissue
                items cardinality matches {1..*; unordered} matches {
                    ELEMENT[at0052] occurrences matches {1} matches {    -- Tissue type
                        value matches {
                            DV_TEXT[at9022]
                            DV_CODED_TEXT[at9073] matches {
                                defining_code matches {[ac9048]}    -- Tissue type (synthesised)
                            }
                        }
                    }
                    ELEMENT[at0053] occurrences matches {0..1} matches {    -- Proportion
                        value matches {
                            DV_PROPORTION[at9023] matches {
                                numerator matches {|0.0..100.0|}
                                type matches {2}
                                precision matches {0}
                            }
                        }
                    }
                }
            }
            CLUSTER[at0014] matches {    -- Internal object or structure
                items cardinality matches {1..*; unordered} matches {
                    ELEMENT[at0015] occurrences matches {1..*} matches {    -- Object/structure
                        value matches {
                            DV_TEXT[at9024]
                            DV_CODED_TEXT[at9074] matches {
                                defining_code matches {[ac9049]}    -- Object/structure (synthesised)
                            }
                        }
                    }
                    ELEMENT[at0020] occurrences matches {0..1} matches {    -- Present or absent?
                        value matches {
                            DV_CODED_TEXT[at9025] matches {
                                defining_code matches {[ac9003]}    -- Present or absent? (synthesised)
                            }
                        }
                    }
                    ELEMENT[at0024] occurrences matches {0..1} matches {    -- Description
                        value matches {
                            DV_TEXT[at9026]
                        }
                    }
                    ELEMENT[at0025] occurrences matches {0..1} matches {    -- Comment
                        value matches {
                            DV_TEXT[at9027]
                        }
                    }
                }
            }
            ELEMENT[at0017] occurrences matches {0..1} matches {    -- Tunnelling present?
                value matches {
                    DV_CODED_TEXT[at9028] matches {
                        defining_code matches {[ac9004]}    -- Tunnelling present? (synthesised)
                    }
                }
            }
            CLUSTER[at0045] matches {    -- Tunnelling details
                items cardinality matches {1..*; unordered} matches {
                    ELEMENT[at0046] occurrences matches {0..1} matches {    -- Tunnel length
                        value matches {
