definition
    CLUSTER[at0000] matches {    -- Hip procedure registry details (Valdoltra)
        items cardinality matches {1..*; unordered} matches {
            ELEMENT[at0011] occurrences matches {0..1} matches {    -- Trochanter osteotomy
                value matches {
                    DV_CODED_TEXT[at9003] matches {
                        defining_code matches {[ac9000]}    -- Trochanter osteotomy (synthesised)
                    }
                }
            }
            ELEMENT[at0002] occurrences matches {0..1} matches {    -- Prophylactic antibiotics
                value matches {
                    DV_CODED_TEXT[at9004] matches {
                        defining_code matches {[ac9001]}    -- Prophylactic antibiotics (synthesised)
                    }
                }
            }
            ELEMENT[at0005] occurrences matches {0..1} matches {    -- Wound drainage
                value matches {
                    DV_CODED_TEXT[at9005] matches {
                        defining_code matches {[ac9002]}    -- Wound drainage (synthesised)
                    }
                }
            }
            ELEMENT[at0010] occurrences matches {0..1} matches {    -- Duration of procedure
                value matches {
                    DV_DURATION[at9006] matches {
                        value matches {PTM/|>=PT0S|}
                    }
                }
            }
            allow_archetype CLUSTER[at0009] matches {    -- Details
                include
                    archetype_id/value matches {/.*/}
            }
        }
    }

