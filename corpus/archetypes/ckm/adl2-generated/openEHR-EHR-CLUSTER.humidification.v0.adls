definition
    CLUSTER[at0000] matches {    -- Humidification
        items cardinality matches {1..*; unordered} matches {
            ELEMENT[at0002] occurrences matches {0..1} matches {    -- Type
                value matches {
                    DV_CODED_TEXT[at9002] matches {
                        defining_code matches {[ac9000]}    -- Type (synthesised)
                    }
                }
            }
            ELEMENT[at0005] occurrences matches {0..1} matches {    -- Set Temperature
                value matches {
                    DV_QUANTITY[at9003] matches {
                        property matches {[at9001]}    -- Temperature
                        units matches {"Cel"}
                    }
                }
            }
        }
    }

