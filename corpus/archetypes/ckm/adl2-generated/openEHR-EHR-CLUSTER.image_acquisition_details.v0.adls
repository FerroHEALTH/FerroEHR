definition
    CLUSTER[at0000] matches {    -- Image acquisition details
        items cardinality matches {1..*; unordered} matches {
            ELEMENT[at0001] occurrences matches {0..1} matches {    -- Scan mode
                value matches {
                    DV_TEXT[at9005]
                }
            }
            ELEMENT[at0002] occurrences matches {0..1} matches {    -- ECG-synchronization
                value matches {
                    DV_TEXT[at9006]
                }
            }
            ELEMENT[at0003] occurrences matches {0..1} matches {    -- Use of duel energy?
                value matches {
                    DV_BOOLEAN[at9007] matches {
                        value matches {True, False}
                    }
                }
            }
            ELEMENT[at0004] occurrences matches {0..1} matches {    -- Scan range
                value matches {
                    DV_QUANTITY[at9008] matches {
                        property matches {[at9000]}    -- * Length (en)
                        units matches {"cm"}
                    }
                }
            }
            ELEMENT[at0005] occurrences matches {0..1} matches {    -- Pitch
                value matches {
                    DV_QUANTITY[at9009] matches {
                        property matches {[at9001]}    -- * Qualified real (en)
                        units matches {"1"}
                    }
                }
            }
            ELEMENT[at0006] occurrences matches {0..1} matches {    -- Tube voltage
                value matches {
                    DV_QUANTITY[at9010] matches {
                        property matches {[at9002]}    -- * Voltage, electrical (en)
                        units matches {"mV"}
                    }
                }
            }
            ELEMENT[at0007] occurrences matches {0..1} matches {    -- Tube current
                value matches {
                    DV_QUANTITY[at9011] matches {
                        property matches {[at9003]}    -- * Electric current (en)
                        units matches {"A"}
                    }
                }
            }
            ELEMENT[at0010] occurrences matches {0..1} matches {    -- Dose-length product (DLP)
                value matches {
                    DV_TEXT[at9012]
                }
            }
            ELEMENT[at0009] occurrences matches {0..1} matches {    -- CT dose index (CTDI)
                value matches {
                    DV_QUANTITY[at9013] matches {
                        property matches {[at9004]}    -- * Energy dose (en)
                        units matches {"Gy"}
                    }
                }
            }
        }
    }

