definition
    CLUSTER[at0000] matches {    -- Image reconstruction details
        items cardinality matches {1..*; unordered} matches {
            ELEMENT[at0021] occurrences matches {0..1} matches {    -- Reconstruction method
                value matches {
                    DV_CODED_TEXT[at9004] matches {
                        defining_code matches {[ac9000]}    -- Reconstruction method (synthesised)
                    }
                }
            }
            ELEMENT[at0011] occurrences matches {0..1} matches {    -- Reconstruction slice
                value matches {
                    DV_QUANTITY[at9005] matches {
                        property matches {[at9001]}    -- Length
                        units matches {"mm"}
                    }
                }
            }
            ELEMENT[at0012] occurrences matches {0..1} matches {    -- Reconstruction increment
                value matches {
                    DV_QUANTITY[at9006] matches {
                        property matches {[at9001]}    -- Length
                        units matches {"mm"}
                    }
                }
            }
            ELEMENT[at0024] occurrences matches {0..1} matches {    -- Reconstruction filter
                value matches {
                    DV_TEXT[at9007]
                }
            }
            CLUSTER[at0004] occurrences matches {0..1} matches {    -- ECG-pulsing window width
                items cardinality matches {1..*; unordered} matches {
                    ELEMENT[at0006] occurrences matches {0..1} matches {    -- RR-interval
                        value matches {
                            DV_INTERVAL<DV_QUANTITY>[at9008] matches {
                                lower matches {
                                    DV_QUANTITY[at9009] matches {
                                        property matches {[at9002]}    -- Qualified real
                                        units matches {"%"}
                                    }
                                }
                                upper matches {
                                    DV_QUANTITY[at9010] matches {
                                        property matches {[at9002]}    -- Qualified real
                                        units matches {"%"}
                                    }
                                }
                            }
                        }
                    }
                    ELEMENT[at0007] occurrences matches {0..1} matches {    -- After R-wave
                        value matches {
                            DV_INTERVAL<DV_DURATION>[at9011] matches {
                                upper matches {
                                    DV_DURATION[at9012] matches {
                                        value
                                    }
                                }
                            }
                        }
                    }
                }
            }
            CLUSTER[at0014] occurrences matches {0..1} matches {    -- ECG reconstruction phase
                items cardinality matches {1..*; unordered} matches {
                    ELEMENT[at0015] occurrences matches {0..1} matches {    -- RR-interval
                        value matches {
                            DV_QUANTITY[at9013] matches {
                                property matches {[at9002]}    -- Qualified real
                                units matches {"%"}
                            }
                        }
                    }
                    ELEMENT[at0016] occurrences matches {0..1} matches {    -- After R-wave
                        value matches {
                            DV_QUANTITY[at9014] matches {
                                property matches {[at9003]}    -- Time
                                units matches {"ms"}
                            }
                        }
                    }
                }
            }
        }
    }

