                comment = <"*For example: normal or subcapsulated. (en)">
            >
            ["at0.11"] = <
                text = <"*Label (en)">
                description = <"*Narrative description as a way to label each follicle, for example by location or numeric. (en)">
            >
            ["at0.9007"] = <
