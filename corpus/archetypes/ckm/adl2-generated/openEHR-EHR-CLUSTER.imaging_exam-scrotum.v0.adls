                description = <"Funn eller observasjoner ved bildediagnostisk undersøkelse av skrotum med bruk av radiologiske metoder.">
            >
            ["at0001.1"] = <
                text = <"Struktur">
                description = <"Navn av undersøkt struktur eller område på eller i kroppen.">
            >
        >
