            ["at0000.1"] = <
                text = <"Imaging examination of the scrotum">
                description = <"Findings observed in an imaging examination targeting the scrotum, using radiographic techniques.">
            >
            ["at0001.1"] = <
                text = <"Body structure">
                description = <"Identification of the body structure or region examined.">
            >
            ["at0.1"] = <
                text = <"Scrotum">
                description = <"The entire scrotum was examined.">
            >
        >
    >
