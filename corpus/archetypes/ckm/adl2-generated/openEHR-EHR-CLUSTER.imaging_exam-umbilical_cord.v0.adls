definition
    CLUSTER[at0000.1] matches {    -- Imaging examination of an umbilical cord
        items matches {
            ELEMENT[at0001.1] matches {    -- Body structure
                value matches {
                    DV_CODED_TEXT[at0.9000] matches {
                        defining_code matches {[at0.1]}    -- Umbilical cord
                    }
                }
            }
            after [at0004]
            ELEMENT[at0.2] occurrences matches {0..1} matches {    -- Number of arteries
                value matches {
                    DV_COUNT[at0.9001] matches {
                        magnitude matches {|>=0|}
                    }
                }
            }
            ELEMENT[at0.3] occurrences matches {0..1} matches {    -- Number of veins
                value matches {
                    DV_COUNT[at0.9002] matches {
                        magnitude matches {|>=0|}
                    }
                }
            }
        }
    }

