description
    original_author = <
        ["name"] = <"Ian McNicoll">
        ["organisation"] = <"freshEHR Clinical Informatics">
        ["email"] = <"ian.mcnicoll@freshehr.com">
        ["date"] = <"2007-11-12">
    >
    original_namespace = <"org.openehr">
