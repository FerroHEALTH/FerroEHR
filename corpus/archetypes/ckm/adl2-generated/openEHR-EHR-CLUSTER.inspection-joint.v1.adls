definition
    CLUSTER[at0000.1] matches {    -- Inspection of joint
        /items[at0006]/items matches {
            after [at0036]
            ELEMENT[at0.55] occurrences matches {0..1} matches {    -- Deformity
                value matches {
                    DV_TEXT[at0.9000]
                }
            }
            after [at0034]
            CLUSTER[at0.53] occurrences matches {0..1} matches {    -- Muscle wasting
                items cardinality matches {1..*; unordered} matches {
                    ELEMENT[at0.54] occurrences matches {0..1} matches {    -- Involved muscle group
                        value matches {
                            DV_TEXT[at0.9001]
                        }
                    }
                    ELEMENT[at0.52] occurrences matches {0..1} matches {    -- Description
                        value matches {
                            DV_TEXT[at0.9002]
                        }
                    }
                }
            }
        }
    }

