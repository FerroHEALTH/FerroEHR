    openEHR-EHR-CLUSTER.inspection-tongue.v0.0.1

specialize
    openEHR-EHR-CLUSTER.inspection.v1

language
    original_language = <[ISO_639-1::en]>

description
    original_author = <
        ["name"] = <"Heather Leslie">
        ["organisation"] = <"Ocean Informatics">
