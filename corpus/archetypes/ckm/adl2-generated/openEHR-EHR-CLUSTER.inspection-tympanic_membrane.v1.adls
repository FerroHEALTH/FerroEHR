    other_contributors = <"Heather Leslie", ...>
    lifecycle_state = <"Rejected">
    details = <
        ["en"] = <
            language = <[ISO_639-1::en]>
            purpose = <"For recording the findings on inspection of the tympanic membrane">
            keywords = <"inspect", "visual", "ear", "tympanic", "perforation", "drum">
            use = <"For use with the exam clusters for recording findings on inspection of the tmpanic membrane">
            misuse = <"Should only be used in the exam observation">
            copyright = <"© openEHR Foundation">
        >
    >

definition
    CLUSTER[at0000.1] matches {    -- Inspection of Tympanic Membrane
        items matches {
            CLUSTER[at0001] matches {
                /items[at0002]/value matches {
                    DV_CODED_TEXT[at9007.1] matches {
                        defining_code matches {[at0.87]}    -- Tympanic membrane normal
                    }
                }
            }
            CLUSTER[at0006] matches {
                items matches {
                    ELEMENT[at0027] matches {
                        value matches {
                            DV_CODED_TEXT[at9014.1] matches {
                                defining_code matches {[ac0.9000]}    -- Surface (synthesised)
                            }
                        }
                    }
                    after [at0034]
                    ELEMENT[at0.52] occurrences matches {0..1} matches {    -- Adequacy of View
                        value matches {
                            DV_ORDINAL[at0.9004] matches {
                                [value, symbol] matches {
                                    [{0}, {[at0.53]}],    -- Unobscured
                                    [{1}, {[at0.54]}],    -- Slightly obscured
                                    [{2}, {[at0.55]}],    -- Moderately obscured
                                    [{3}, {[at0.56]}],    -- Mostly obscured
                                    [{4}, {[at0.57]}]    -- Totally obscured
                                }
                            }
                        }
                    }
                    CLUSTER[at0.76] occurrences matches {0..1} matches {    -- Specific Appearance
                        items cardinality matches {1..*; unordered} matches {
                            ELEMENT[at0.58] matches {    -- Clinical Description
                                value matches {
                                    DV_CODED_TEXT[at0.9005] matches {
                                        defining_code
                                    }
                                }
                            }
                            ELEMENT[at0.93] occurrences matches {0..1} matches {    -- Light Reflex present
                                value matches {
                                    DV_BOOLEAN[at0.9006] matches {
                                        value matches {True, False}
                                    }
                                }
                            }
                            ELEMENT[at0051] occurrences matches {0..1} matches {
                                value matches {
                                    DV_TEXT[at0.9007]
                                }
                            }
                            ELEMENT[at0.80] occurrences matches {0..1} matches {    -- Retraction
                                value matches {
                                    DV_ORDINAL[at0.9008] matches {
                                        [value, symbol] matches {
                                            [{0}, {[at0.81]}],    -- No retraction
                                            [{1}, {[at0.82]}],    -- Slightly retracted
                                            [{2}, {[at0.83]}],    -- touches the ossicular chain
                                            [{3}, {[at0.84]}],    -- reaches the level of the promontory
                                            [{4}, {[at0.85]}]    -- adheres to the promontory
                                        }
                                    }
                                }
                            }
                            ELEMENT[at0.90] occurrences matches {0..1} matches {    -- Air/Fluid level visible?
                                value matches {
                                    DV_BOOLEAN[at0.9009] matches {
                                        value matches {True, False}
                                    }
                                }
                            }
                            CLUSTER[at0.97] occurrences matches {0..1} matches {    -- Scarring
                                items cardinality matches {1..*; unordered} matches {
                                    ELEMENT[at0.94] occurrences matches {0..1} matches {    -- Description of scarring
                                        value matches {
                                            DV_CODED_TEXT[at0.9010] matches {
                                                defining_code matches {[ac0.9003]}    -- Description of scarring (synthesised)
                                            }
                                        }
                                    }
                                    ELEMENT[at0.79] occurrences matches {0..1} matches {    -- Clinical Description
                                        value matches {
                                            DV_TEXT[at0.9011]
                                        }
                                    }
                                }
                            }
                        }
                    }
                    CLUSTER[at0.74] occurrences matches {0..1} matches {    -- Ventilation Tube
                        items cardinality matches {1..*; unordered} matches {
                            allow_archetype CLUSTER[at0.98] matches {    -- Cluster: Ventilation tube
                                include
                                    archetype_id/value matches {/openEHR-EHR-CLUSTER\.tympanic_ventilation_tube\.v1\..*/}
                            }
                        }
                    }
                    CLUSTER[at0.63] occurrences matches {0..1} matches {    -- Perforation
                        items cardinality matches {1..*; unordered} matches {
                            allow_archetype CLUSTER[at0.99] matches {    -- Cluster: Perforation
                                include
                                    archetype_id/value matches {/openEHR-EHR-CLUSTER\.inspection-tympanic_perforation\.v1\..*/}
                            }
                        }
                    }
                }
            }
        }
    }

