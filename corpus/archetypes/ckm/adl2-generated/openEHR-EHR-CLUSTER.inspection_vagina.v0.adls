archetype (adl_version=2.4.0; rm_release=1.1.0; generated; uid=c87a0f61-1dea-4586-841f-4d1c1817a6d6; build_uid=189c0cb6-14e8-421e-b417-ce569d8f8e15)
    openEHR-EHR-CLUSTER.inspection_vagina.v0.0.1

language
    original_language = <[ISO_639-1::en]>

