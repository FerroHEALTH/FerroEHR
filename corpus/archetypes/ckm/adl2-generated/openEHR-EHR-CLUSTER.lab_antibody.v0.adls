archetype (adl_version=2.4.0; rm_release=1.1.0; generated; uid=f2c01b02-9c94-4533-9e3f-5311fe777495; build_uid=8ea82615-9a35-4f46-9f4f-b639a7bc7a12)
    openEHR-EHR-CLUSTER.lab_antibody.v0.0.1-alpha

language
    original_language = <[ISO_639-1::en]>

description
    original_author = <
        ["name"] = <"Heather Leslie">
        ["organisation"] = <"Atomica Informatics">
        ["email"] = <"heather.leslie@atomicainformatics.com">
        ["date"] = <"2024-08-09">
    >
    original_namespace = <"org.openehr">
    original_publisher = <"openEHR Foundation">
    other_contributors = <"Nicola Ewen, SERHA/Ministry of Health and Wellness, Jamaica", "Heather Leslie, Atomica Informatics, Australia (openEHR Editor)", "Yohann White, Ministry of Health and Wellness, Jamaica">
    lifecycle_state = <"in_development">
