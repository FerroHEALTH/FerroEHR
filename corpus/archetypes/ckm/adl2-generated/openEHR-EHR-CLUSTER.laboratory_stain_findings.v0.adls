definition
    CLUSTER[at0000] matches {    -- Laboratory stain findings
        items cardinality matches {1..*; unordered} matches {
            ELEMENT[at0004] occurrences matches {1} matches {    -- Stain name
                value matches {
                    DV_TEXT[at9002]
                    DV_CODED_TEXT[at9003] matches {
                        defining_code matches {[ac9000]}    -- Stain name (synthesised)
                    }
                }
            }
            ELEMENT[at0008] occurrences matches {0..1} matches {    -- Description
                value matches {
                    DV_TEXT[at9004]
                }
            }
            ELEMENT[at0009] matches {    -- Finding
                value matches {
                    DV_CODED_TEXT[at9005] matches {
                        defining_code matches {[ac9001]}    -- Finding (synthesised)
                    }
                }
            }
            ELEMENT[at0012] occurrences matches {0..1} matches {    -- Comment
                value matches {
                    DV_TEXT[at9006]
                }
            }
        }
    }

terminology
    term_definitions = <
        ["en"] = <
            ["at0000"] = <
                text = <"Laboratory stain findings">
                description = <"Findings observed from the examination of tissue treated with specialised stains intended to enhance the visibility of tissue structures and cellular details under a microscope.">
            >
            ["at0004"] = <
                text = <"Stain name">
                description = <"Name of the technique used to stain the specimen.">
            >
            ["at0005"] = <
                text = <"Gram stain">
                description = <"">
            >
            ["at0006"] = <
                text = <"India ink stain">
                description = <"">
            >
            ["at0007"] = <
                text = <"Ziehl-Neelsen stain">
                description = <"">
            >
            ["at0008"] = <
                text = <"Description">
                description = <"Narrative description about the findings observed on microscopic inspection of a specimen using the identified stain.">
            >
            ["at0009"] = <
                text = <"Finding">
                description = <"Microscopic finding observed using the identified stain.">
            >
            ["at0010"] = <
                text = <"Positive">
                description = <"">
            >
            ["at0011"] = <
                text = <"Negative">
                description = <"">
            >
            ["at0012"] = <
                text = <"Comment">
                description = <"Additional narrative about the microscopy findings using the identified stain, not captured in other fields.">
            >
            ["ac9000"] = <
                text = <"Stain name (synthesised)">
                description = <"Name of the technique used to stain the specimen. (synthesised)">
            >
            ["ac9001"] = <
                text = <"Finding (synthesised)">
                description = <"Microscopic finding observed using the identified stain. (synthesised)">
            >
        >
    >
