    other_details = <
        ["MD5-CAM-1.0.1"] = <"F573FE924C31A6B15E5527C9695166A6">
    >
    details = <
        ["de"] = <
            language = <[ISO_639-1::de]>
            purpose = <"Zur Dokumentation von Befunden, die bei der Untersuchtung von Laborproben unter dem Mikroskop beobachtet wurden.">
            keywords = <"Mikroskopie", "Mikro">
            use = <"">
            misuse = <"Nicht zur Dokumentation von Befunden aus der Kultur einer Probe zu verwenden - für diesen Zweck ist der CLUSTER.laboratory_test_culture Archetyp zu nutzen.">
        >
        ["en"] = <
            language = <[ISO_639-1::en]>
            purpose = <"To record findings observed examining laboratory specimens under a microscope.">
            keywords = <"microscopy", "micro">
            use = <"">
            misuse = <"Not to be used to record findings observed from culture of a specimen - use the CLUSTER.laboratory_test_culture for this purpose.">
            copyright = <"© openEHR Foundation">
        >
    >

definition
    CLUSTER[at0000] matches {    -- Laboratory serological finding
        items cardinality matches {1..*; unordered} matches {
            ELEMENT[at0049] occurrences matches {0..1} matches {    -- Test name
                value matches {
                    DV_TEXT[at9001]
                }
            }
            allow_archetype CLUSTER[at0033] matches {    -- Specimen
                include
                    archetype_id/value matches {/.*/}
            }
            ELEMENT[at0001] occurrences matches {0..1} matches {    -- Description
                value matches {
                    DV_TEXT[at9002]
                }
            }
            ELEMENT[at0050] occurrences matches {0..1} matches {    -- Finding
                value matches {
                    DV_TEXT[at9003]
                    DV_QUANTITY[at9004]
                    DV_CODED_TEXT[at9005] matches {
                        defining_code matches {[ac9000]}    -- Finding (synthesised)
                    }
                }
            }
            ELEMENT[at0022] occurrences matches {0..1} matches {    -- Comment
                value matches {
                    DV_TEXT[at9006]
                }
            }
        }
    }

