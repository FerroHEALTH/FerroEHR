archetype (adl_version=2.4.0; rm_release=1.1.0; generated; uid=9272290a-50d5-4f5e-b525-e231b5e51ad8; build_uid=12560271-d184-46a9-ac0d-680229465a41)
    openEHR-EHR-CLUSTER.lesions.v0.0.1-alpha

language
    original_language = <[ISO_639-1::en]>

description
    original_author = <
        ["name"] = <"Keisha Barwise">
        ["organisation"] = <"openEHR Foundation">
        ["email"] = <"keisha.barwise@openehr.org">
        ["date"] = <"2025-07-21">
    >
    original_namespace = <"org.openehr">
    original_publisher = <"openEHR Foundation">
    other_contributors = <"Nicola Ewen Hall, openEHR Fellow 2025, Jamaica", "Khin Aung, Thrive Consultants, Jamaica", "Heather Leslie, openEHR Foundation, Chief Clinical Information Officer">
    lifecycle_state = <"in_development">
    custodian_namespace = <"org.openehr">
    custodian_organisation = <"openEHR Foundation">
    licence = <"This work is licensed under the Creative Commons Attribution-ShareAlike 4.0 International License. To view a copy of this license, visit http://creativecommons.org/licenses/by-sa/4.0/.">
    other_details = <
        ["current_contact"] = <"Heather Leslie, Atomica Informatics, Australia<heather.leslie@atomicainformatics.com>">
        ["MD5-CAM-1.0.1"] = <"6F7ED37C3CEA002162F5D699ABB9C47B">
    >
    details = <
        ["en"] = <
            language = <[ISO_639-1::en]>
            purpose = <"To record the presence and summary characteristics of one or more lesions observed during physical examination.">
            keywords = <"Lesion, mass, ulcer, nodule, swelling, inspection, polyp.", ...>
            use = <"Use to record the observed findings during the physical examination of one or more lesions.

This archetype has been specifically designed to be used within CLUSTER archetypes, where clinically appropriate. 

Use to incorporate the narrative descriptions of clinical findings within existing or legacy clinical systems into an archetyped format, using the 'Clinical Description' data element.">
            misuse = <"Not to be used for recording the clinical history - use specific OBSERVATION and CLUSTER archetypes. For example OBSERVATION.story and CLUSTER.symptom_sign.

Not to be used for recording the results of an imaging examination - use the CLUSTER.imaging_exam family of archetypes for this purpose.">
            copyright = <"© openEHR Foundation">
        >
    >

definition
    CLUSTER[at0000] matches {    -- Lesions
        items cardinality matches {1..*; unordered} matches {
            ELEMENT[at0001] occurrences matches {0..1} matches {    -- Lesion type
                value matches {
                    DV_TEXT[at9001]
                }
            }
            ELEMENT[at0002] occurrences matches {0..1} matches {    -- Presence
                value matches {
                    DV_CODED_TEXT[at9002] matches {
                        defining_code matches {[ac9000]}    -- Presence (synthesised)
                    }
                }
            }
            ELEMENT[at0006] occurrences matches {1..*} matches {    -- Number of lesions
                value matches {
                    DV_COUNT[at9003]
                }
            }
            ELEMENT[at0007] occurrences matches {0..1} matches {    -- Clinical descriptions
                value matches {
                    DV_TEXT[at9004]
                }
            }
            allow_archetype CLUSTER[at0009] matches {    -- Additional details
                include
                    archetype_id/value matches {/.*/}
            }
            allow_archetype CLUSTER[at0008] matches {    -- Per lesion
                include
                    archetype_id/value matches {/openEHR-EHR-CLUSTER\.exam_lesion(-[a-zA-Z0-9_]+)*\.v0\..*/}
            }
            ELEMENT[at0010] occurrences matches {0..1} matches {    -- Comment
                value matches {
                    DV_TEXT[at9005]
                }
            }
        }
    }

terminology
    term_definitions = <
        ["en"] = <
            ["at0000"] = <
                text = <"Lesions">
                description = <"Findings observed during the physical examination of lesions.">
            >
            ["at0001"] = <
                text = <"Lesion type">
                description = <"A short descriptive name or identifier for the lesion or mass.">
            >
            ["at0002"] = <
                text = <"Presence">
                description = <"Assertion about the observed presence or absence of a lesion or mass during the examination.">
            >
            ["at0003"] = <
                text = <"Present">
                description = <"">
            >
            ["at0004"] = <
                text = <"Absent">
                description = <"">
            >
            ["at0005"] = <
                text = <"Indeterminate">
                description = <"">
            >
            ["at0006"] = <
                text = <"Number of lesions">
                description = <"The total count of distinct lesions or masses identified.">
            >
            ["at0007"] = <
                text = <"Clinical descriptions">
                description = <"Narrative description of the overall findings observed during the examination per lesion type.">
            >
            ["at0008"] = <
                text = <"Per lesion">
                description = <"Specific features or attributes that apply to this individual lesion or mass.">
            >
            ["at0009"] = <
                text = <"Additional details">
                description = <"Relevant clinical observations about the lesion type or masses that are not otherwise described.">
            >
            ["at0010"] = <
                text = <"Comment">
                description = <"Additional narrative about the findings on examination of the lesion, not captured in other fields.">
            >
            ["ac9000"] = <
                text = <"Presence (synthesised)">
                description = <"Assertion about the observed presence or absence of a lesion or mass during the examination. (synthesised)">
            >
        >
    >
    value_sets = <
        ["ac9000"] = <
            id = <"ac9000">
            members = <"at0003", "at0004", "at0005">
        >
    >
