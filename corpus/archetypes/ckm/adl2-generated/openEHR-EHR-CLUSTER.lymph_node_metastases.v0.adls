        ["ar-sy"] = <
            ["at0000"] = <
                text = <"الورم - نقائل العقد الليمفاوية">
                description = <"لتسجيل الموجودات الخاصة بنقائل الورم في العقد الليمفاوية.">
            >
            ["at0001"] = <
                text = <"عدد العقد الليمفاوية التي تم فحصها">
