archetype (adl_version=2.4.0; rm_release=1.1.0; generated; uid=cc50d8ab-ed2c-482e-97b4-987039240e36; build_uid=423b6aae-b302-4f67-857a-7f07b49c76e5)
    openEHR-EHR-CLUSTER.medication_preparation.v0.0.1

language
    original_language = <[ISO_639-1::en]>

description
    original_author = <
