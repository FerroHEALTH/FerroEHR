definition
    CLUSTER[at0000] matches {    -- Microbiology parasitology findings
        items cardinality matches {1..*; unordered} matches {
            allow_archetype CLUSTER[at0002] matches {    -- Specimen
                include
                    archetype_id/value matches {/.*/}
            }
            ELEMENT[at0001] occurrences matches {0..1} matches {    -- Description
                value matches {
                    DV_TEXT[at9001]
                }
            }
            CLUSTER[at0003] matches {    -- Interpretation
                items cardinality matches {1..*; unordered} matches {
                    ELEMENT[at0004] occurrences matches {0..1} matches {    -- Parasite name
                        value matches {
                            DV_TEXT[at9002]
                        }
                    }
                    ELEMENT[at0005] occurrences matches {0..1} matches {    -- Detected?
                        value matches {
                            DV_CODED_TEXT[at9003] matches {
                                defining_code matches {[ac9000]}    -- Detected? (synthesised)
                            }
                        }
                    }
                }
            }
            ELEMENT[at0009] occurrences matches {0..1} matches {    -- Comment
                value matches {
                    DV_TEXT[at9004]
                }
            }
        }
    }

