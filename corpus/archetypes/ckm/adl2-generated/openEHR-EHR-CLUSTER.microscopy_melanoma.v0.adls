            >
            ["at0001"] = <
                text = <"عمق الغزو">
                description = <"عمق غزو الورم. عادة ما يعبر عنه بثِخَن بريسلو">
                comment = <"يتم قياس ثِخَن برسيلو من قمة الطبقة الحُبَيْبِية للبشرة,, أو إذا كان السطح مُتَقَرِّحاً, من قاعدة القرحة إلى أعمق خلية بشرية غازية. 

و يتم تقريبه إلى أقرب 0.1 ميلليمتر.">
