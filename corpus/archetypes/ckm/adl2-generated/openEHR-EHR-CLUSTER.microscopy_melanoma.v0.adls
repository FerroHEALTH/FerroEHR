                description = <"Tumour regression is present, involving less than 75% of the tumour.">
            >
            ["at0053"] = <
                text = <"Present involving 75% or more">
                description = <"Tumour regression is present, involving 75% or more of the tumour.">
            >
            ["at0067"] = <
