definition
    CLUSTER[at0000] matches {    -- Movement
        items cardinality matches {1..*; unordered} matches {
            CLUSTER[at0001] occurrences matches {0..1} matches {    -- Normal statements
                items cardinality matches {1..*; unordered} matches {
                    ELEMENT[at0002] occurrences matches {1..*} matches {    -- Normal statement
                        value matches {
                            DV_TEXT[at9004]
                        }
                    }
                }
            }
            ELEMENT[at0003] occurrences matches {0..1} matches {    -- Clinical description
                value matches {
                    DV_TEXT[at9005]
                }
            }
            CLUSTER[at0036] occurrences matches {0..1} matches {    -- Findings
                items cardinality matches {1..*; unordered} matches {
                    CLUSTER[at0037] occurrences matches {0..1} matches {    -- General movement
                        items cardinality matches {1..*; unordered} matches {
                            use_node ELEMENT[at9006] occurrences matches {1} /items[at0036]/items[at0004]/items[at0007]
                            use_node ELEMENT[at9015] occurrences matches {1} /items[at0036]/items[at0004]/items[at0006]    -- General movement (synthesised)
                            use_node ELEMENT[at9016] occurrences matches {1} /items[at0036]/items[at0004]/items[at0019]    -- General movement (synthesised)
                        }
                    }
                    CLUSTER[at0004] matches {    -- Specific movement
                        items cardinality matches {1..*; unordered} matches {
                            ELEMENT[at0011] occurrences matches {0..1} matches {    -- Type of movement
                                value matches {
                                    DV_CODED_TEXT[at9009] matches {
                                        defining_code matches {[ac9000]}    -- Type of movement (synthesised)
                                    }
                                }
                            }
                            ELEMENT[at0005] occurrences matches {1} matches {    -- Movement
                                value matches {
                                    DV_TEXT[at9010]
                                }
                            }
                            ELEMENT[at0007] occurrences matches {0..1} matches {    -- Description
                                value matches {
                                    DV_TEXT[at9011]
                                }
                            }
                            ELEMENT[at0035] occurrences matches {0..1} matches {    -- Arc of movement
                                value matches {
                                    DV_QUANTITY[at9012] matches {
                                        property matches {[at9001]}    -- Angle, plane
                                        magnitude matches {|>=0.0|}
                                        units matches {"°"}
                                        precision matches {0}
                                    }
                                }
                            }
                            ELEMENT[at0006] occurrences matches {0..1} matches {    -- Relative range of movement
                                value matches {
                                    DV_ORDINAL[at9013] matches {
                                        [value, symbol] matches {
                                            [{0}, {[at0008]}],    -- No movement
                                            [{2}, {[at0017]}],    -- Severe restriction
                                            [{5}, {[at0010]}],    -- Moderate restriction
                                            [{8}, {[at0016]}],    -- Minor restriction
                                            [{10}, {[at0009]}]    -- Full range of movement
                                        }
                                    }
                                }
                            }
                            ELEMENT[at0019] occurrences matches {0..1} matches {    -- Associated pain
                                value matches {
                                    DV_ORDINAL[at9014] matches {
                                        [value, symbol] matches {
                                            [{0}, {[at0020]}],    -- None
                                            [{1}, {[at0021]}],    -- Mild
                                            [{5}, {[at0022]}],    -- Moderate
                                            [{8}, {[at0024]}],    -- Severe
                                            [{10}, {[at0023]}]    -- Extreme
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

