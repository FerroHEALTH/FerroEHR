archetype (adl_version=2.4.0; rm_release=1.1.0; generated; uid=4946e311-71c7-41d0-963e-ea8eaa3f0a2e; build_uid=31822ca5-96dd-4ff3-9d85-220b450db65a)
    openEHR-EHR-CLUSTER.operative_procedure.v0.0.1-alpha

language
    original_language = <[ISO_639-1::en]>

