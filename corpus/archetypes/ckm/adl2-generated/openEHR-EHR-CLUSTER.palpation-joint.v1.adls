    details = <
        ["en"] = <
            language = <[ISO_639-1::en]>
            purpose = <"To record data found on examination through palpation of joint.">
            keywords = <"palpate", "joint">
            use = <"To be embedded in the openEHR-EHR-OBSERVATION.exam cluster to express findings determined by palpation.">
            misuse = <"Not for use in any other context at present.">
            copyright = <"© openEHR Foundation">
        >
        ["ar-sy"] = <
            language = <[ISO_639-1::ar-sy]>
            purpose = <"الموجودات التي يتم التعرف عليها من خلال جس المفاصل.">
            keywords = <"يجس", "المفصل">
            use = <"يتم إدماجه كعنقود في نموذج ملاحظة.فحص, للتعبير عن الموجودات التي يتم تحديدها بالجس.">
            misuse = <"لا تستخدم في أي سياق آخر في الوقت الحالي.">
            copyright = <"© openEHR Foundation">
        >
    >

definition
    CLUSTER[at0000.1] matches {    -- Palpation of joint
        /items[at0080]/items matches {
            CLUSTER[at0019] matches {
                items matches {
                    after [at0005]
                    use_node ELEMENT[at0.9012] occurrences matches {1} /items[at0080]/items[at0010]/items[at0011]    -- Tenderness (synthesised)
                }
            }
            CLUSTER[at0010] matches {
                items matches {
                    after [at0011]
                    ELEMENT[at0.83] occurrences matches {0..1} matches {    -- Deformity
                        value matches {
                            DV_CODED_TEXT[at0.9002] matches {
                                defining_code
                            }
                        }
                    }
                }
            }
            after [at0053]
            ELEMENT[at0.93] occurrences matches {0..1} matches {    -- Crepitus present
                value matches {
                    DV_BOOLEAN[at0.9003] matches {
                        value matches {True, False}
                    }
                }
            }
            ELEMENT[at0.94] occurrences matches {0..1} matches {    -- Locking of joint present
                value matches {
                    DV_BOOLEAN[at0.9004] matches {
                        value matches {True, False}
                    }
                }
            }
            CLUSTER[at0.85] occurrences matches {0..1} matches {    -- Effusion
                items cardinality matches {1..*; unordered} matches {
                    ELEMENT[at0.86] occurrences matches {0..1} matches {    -- Present
                        value matches {
                            DV_BOOLEAN[at0.9005] matches {
                                value matches {True, False}
                            }
                        }
                    }
                    ELEMENT[at0.87] occurrences matches {0..1} matches {    -- Description
                        value matches {
                            DV_CODED_TEXT[at0.9006] matches {
                                defining_code
                            }
                        }
                    }
                    ELEMENT[at0.88] occurrences matches {0..1} matches {    -- Degree
                        value matches {
                            DV_ORDINAL[at0.9007] matches {
                                [value, symbol] matches {
                                    [{0}, {[at0.89]}],    -- Absent
                                    [{1}, {[at0.90]}],    -- Mild
                                    [{2}, {[at0.91]}],    -- Moderate
                                    [{3}, {[at0.92]}]    -- Large
                                }
                            }
                        }
                    }
                }
            }
            ELEMENT[at0.84] occurrences matches {0..1} matches {    -- Comparison to other side
                value matches {
                    DV_TEXT[at0.9008]
                }
            }
            CLUSTER[at0.95] matches {    -- Specific Test
                items cardinality matches {1..*; unordered} matches {
                    ELEMENT[at0.96] occurrences matches {0..1} matches {    -- Name of test
                        value matches {
                            DV_CODED_TEXT[at0.9009] matches {
                                defining_code
                            }
                        }
                    }
                    ELEMENT[at0.97] occurrences matches {0..1} matches {    -- Outcome of test
                        value matches {
                            DV_CODED_TEXT[at0.9010] matches {
                                defining_code
                            }
                        }
                    }
                    ELEMENT[at0.98] occurrences matches {0..1} matches {    -- Comments
                        value matches {
                            DV_CODED_TEXT[at0.9011] matches {
                                defining_code
                            }
                        }
                    }
                }
            }
        }
    }

