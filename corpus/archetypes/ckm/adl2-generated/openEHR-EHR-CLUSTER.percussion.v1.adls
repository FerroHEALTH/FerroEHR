definition
    CLUSTER[at0000] matches {    -- Percussion
        items cardinality matches {1..*; unordered} matches {
            CLUSTER[at0001] occurrences matches {0..1} matches {    -- Normal statements
                items cardinality matches {1..*; unordered} matches {
                    ELEMENT[at0002] occurrences matches {0..1} matches {    -- Normal statement
                        value matches {
                            DV_TEXT[at9001]
                        }
                    }
                }
            }
            ELEMENT[at0003] occurrences matches {0..1} matches {    -- Clinical description
                value matches {
                    DV_TEXT[at9002]
                }
            }
            CLUSTER[at0004] matches {    -- Findings
                items cardinality matches {1..*; unordered} matches {
                    ELEMENT[at0005] occurrences matches {0..1} matches {    -- Percussion note
                        value matches {
                            DV_CODED_TEXT[at9003] matches {
                                defining_code matches {[ac9000]}    -- Percussion note (synthesised)
                            }
                        }
                    }
                }
            }
            CLUSTER[at0010] matches {    -- Localised percussion
                items cardinality matches {1..*; unordered} matches {
                    ELEMENT[at0011] occurrences matches {1} matches {    -- Region or site
                        value matches {
                            DV_CODED_TEXT[at9004] matches {
                                defining_code matches {}
                            }
                        }
                    }
                    use_node ELEMENT[at9005] occurrences matches {1} /items[at0004]/items[at0005]    -- Localised percussion (synthesised)
                }
            }
        }
    }

