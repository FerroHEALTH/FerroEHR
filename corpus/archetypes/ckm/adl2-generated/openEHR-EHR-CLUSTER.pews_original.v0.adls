    references = <
        ["1"] = <"Monaghan A. Detecting and managing deterioration in children. Paediatr Nurs. 2005 Feb;17(1):32-5. doi: 10.7748/paed2005.02.17.1.32.c964. PMID: 15751446.">
    >
