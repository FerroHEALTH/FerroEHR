        >
    >

definition
    CLUSTER[at0000] matches {    -- PEWS - original variables
        items cardinality matches {1..*; unordered} matches {
            ELEMENT[at0001] occurrences matches {0..1} matches {    -- Behaviour
                value matches {
                    DV_ORDINAL[at9005] matches {
                        [value, symbol] matches {
                            [{0}, {[at0002]}],    -- Playing/appropriate
                            [{1}, {[at0003]}],    -- Sleeping
                            [{2}, {[at0004]}],    -- Irritable
                            [{3}, {[at0005]}]    -- Lethargic/confused or reduced response to pain
                        }
                    }
                }
            }
            ELEMENT[at0006] occurrences matches {0..1} matches {    -- Cardiovascular
                value matches {
                    DV_ORDINAL[at9006] matches {
                        [value, symbol] matches {
                            [{0}, {[at0007]}],    -- Pink OR capillary refill 1–2 seconds
                            [{1}, {[at0008]}],    -- Pale OR capillary refill 3 seconds
                            [{2}, {[at0009]}],    -- Gray OR capillary refill 4 seconds OR tachycardia of 20 bpm above normal
                            [{3}, {[at0010]}]    -- Gray and mottled OR capillary refill ≥5 seconds OR tachycardia of 30 bpm above normal OR bradycardia
                        }
                    }
                }
            }
            ELEMENT[at0011] occurrences matches {0..1} matches {    -- Respiratory
                value matches {
                    DV_ORDINAL[at9007] matches {
                        [value, symbol] matches {
                            [{0}, {[at0012]}],    -- Within normal parameters, no retractions
                            [{1}, {[at0013]}],    -- >10 above normal parameters using accessory muscles OR 30+ %FiO2 or 3+ L/min
                            [{2}, {[at0014]}],    -- >20 above normal parameters and retractions OR 40+ %FiO2 or 6+ L/min
                            [{3}, {[at0015]}]    -- Five below normal parameters with retractions and grunting OR 50% FiO2 or 8+ L/min
                        }
                    }
                }
            }
            ELEMENT[at0016] occurrences matches {0..1} matches {    -- Quarter hourly nebulizers
                value matches {
                    DV_ORDINAL[at9008] matches {
                        [value, symbol] matches {
                            [{0}, {[at0017]}],    -- No
                            [{1}, {[at0018]}]    -- Yes
                        }
                    }
                }
            }
            ELEMENT[at0019] occurrences matches {0..1} matches {    -- Persistent vomiting following surgery
                value matches {
                    DV_ORDINAL[at9009] matches {
                        [value, symbol] matches {
                            [{0}, {[at0020]}],    -- No
                            [{1}, {[at0021]}]    -- Yes
                        }
                    }
                }
            }
        }
    }

