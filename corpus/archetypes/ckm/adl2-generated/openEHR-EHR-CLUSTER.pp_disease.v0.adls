definition
    CLUSTER[at0000] matches {    -- Phenopacket disease
        items cardinality matches {1..*; unordered} matches {
            ELEMENT[at0001] occurrences matches {1} matches {    -- term
                value matches {
                    DV_CODED_TEXT[at9000]
                }
            }
            ELEMENT[at0002] occurrences matches {0..1} matches {    -- onset
                value matches {
                    DV_DURATION[at9001] matches {
                        value matches {PYMD/|>=P0D|}
                    }
                    DV_CODED_TEXT[at9002]
                    DV_INTERVAL<DV_DURATION>[at9003] matches {
                        lower matches {
                            DV_DURATION[at9004] matches {
                                value matches {PYMD/|>=P0D|}
                            }
                        }
                        upper matches {
                            DV_DURATION[at9005] matches {
                                value matches {PYMD/|>=P0D|}
                            }
                        }
                    }
                }
            }
            ELEMENT[at0003] occurrences matches {0..1} matches {    -- tumor_stage
                value matches {
                    DV_CODED_TEXT[at9006]
                }
            }
        }
    }

