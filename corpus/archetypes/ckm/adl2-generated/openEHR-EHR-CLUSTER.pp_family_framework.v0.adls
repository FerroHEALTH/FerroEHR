definition
    CLUSTER[at0000] matches {    -- Phenopacket family framework
        items cardinality matches {1..*; unordered} matches {
            ELEMENT[at0002] occurrences matches {0..1} matches {    -- id
                value matches {
                    DV_IDENTIFIER[at9000]
                }
            }
            allow_archetype CLUSTER[at0003]    -- proband
            allow_archetype CLUSTER[at0004] matches {    -- relatives
                include
                    archetype_id/value matches {/.*/}
            }
            allow_archetype CLUSTER[at0005] matches {    -- pedigree
                include
                    archetype_id/value matches {/openEHR-EHR-CLUSTER\.pp_pedigree\.v0\..*/}
            }
            allow_archetype CLUSTER[at0006] matches {    -- hts_files
                include
                    archetype_id/value matches {/openEHR-EHR-CLUSTER\.pp_htsfile\.v0\..*/}
            }
            allow_archetype CLUSTER[at0007] matches {    -- meta_data
                include
                    archetype_id/value matches {/openEHR-EHR-CLUSTER\.pp_metadata\.v0\..*/}
            }
        }
    }

