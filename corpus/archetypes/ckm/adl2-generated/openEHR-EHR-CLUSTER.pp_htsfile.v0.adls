definition
    CLUSTER[at0000] matches {    -- Phenopacket HtsFile
        items cardinality matches {1..*; unordered} matches {
            ELEMENT[at0001] occurrences matches {1} matches {    -- uri
                value matches {
                    DV_URI[at9001]
                }
            }
            ELEMENT[at0002] occurrences matches {0..1} matches {    -- description
                value matches {
                    DV_TEXT[at9002]
                }
            }
            ELEMENT[at0003] occurrences matches {1} matches {    -- hts_format
                value matches {
                    DV_CODED_TEXT[at9003] matches {
                        defining_code matches {[ac9000]}    -- hts_format (synthesised)
                    }
                }
            }
            ELEMENT[at0011] occurrences matches {1} matches {    -- genome_assembly
                value matches {
                    DV_TEXT[at9004]
                }
            }
            ELEMENT[at0012] occurrences matches {0..1} matches {    -- individual_identifier
                value matches {
                    DV_IDENTIFIER[at9005]
                }
            }
            ELEMENT[at0013] occurrences matches {0..1} matches {    -- sample_identifier
                value matches {
                    DV_IDENTIFIER[at9006]
                }
            }
        }
    }

terminology
    term_definitions = <
        ["en"] = <
            ["at0000"] = <
                text = <"Phenopacket HtsFile">
                description = <"Phenopacket HtsFile">
            >
            ["at0001"] = <
                text = <"uri">
                description = <"A valid URI.">
                comment = <"For example: \"file://data/genomes/germline_wgs.vcf.gz\".">
            >
            ["at0002"] = <
                text = <"description">
                description = <"Arbitrary description of the file">
                comment = <"For example; \"Matched normal germline sample\".">
            >
            ["at0003"] = <
                text = <"hts_format">
                description = <"*">
                comment = <"For example: \"VCF\".">
            >
            ["at0004"] = <
                text = <"UNKNOWN">
                description = <"An HTS file of unknown type.">
            >
            ["at0005"] = <
