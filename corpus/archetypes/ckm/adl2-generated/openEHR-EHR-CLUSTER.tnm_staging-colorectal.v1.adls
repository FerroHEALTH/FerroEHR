definition
    CLUSTER[at0000.1] matches {    -- TNM staging - Colorectal cancer (Sixth edition)
        items matches {
            CLUSTER[at0002] matches {
                items matches {
                    ELEMENT[at0003] matches {
                        value matches {
                            DV_CODED_TEXT[at9001.1] matches {
                                defining_code matches {[ac0.9000]}    -- Primary tumour (T) (synthesised)
                            }
                        }
                    }
                    ELEMENT[at0004] matches {
                        value matches {
                            DV_CODED_TEXT[at9002.1] matches {
                                defining_code matches {[ac0.9001]}    -- Regional lymph nodes (N) (synthesised)
                            }
                        }
                    }
                    ELEMENT[at0005] matches {
                        value matches {
                            DV_CODED_TEXT[at9003.1] matches {
                                defining_code matches {[ac0.9002]}    -- Distant metastasis (M) (synthesised)
                            }
                        }
                    }
                    ELEMENT[at0014] matches {
                        value matches {
                            DV_CODED_TEXT[at9005.1] matches {
                                defining_code matches {[ac0.9003]}    -- Clinical stage grouping (synthesised)
                            }
                        }
                    }
                }
            }
            CLUSTER[at0006] matches {
                items matches {
                    ELEMENT[at0007] matches {
                        value matches {
                            DV_CODED_TEXT[at9007.1] matches {
                                defining_code matches {[ac0.9004]}    -- Primary tumour (pT) (synthesised)
                            }
                        }
                    }
                    ELEMENT[at0008] matches {
                        value matches {
                            DV_CODED_TEXT[at9008.1] matches {
                                defining_code matches {[ac0.9005]}    -- Regional lymph node (pN) (synthesised)
                            }
                        }
                    }
                    ELEMENT[at0009] matches {
                        value matches {
                            DV_CODED_TEXT[at9009.1] matches {
                                defining_code matches {[ac0.9007]}    -- Distant metastasis (pM) (synthesised)
                            }
                        }
                    }
                    ELEMENT[at0015] matches {
                        value matches {
                            DV_CODED_TEXT[at9011.1] matches {
                                defining_code matches {[ac0.9003]}    -- Clinical stage grouping (synthesised)
                            }
                        }
                    }
                }
            }
        }
    }

terminology
    term_definitions = <
        ["en"] = <
            ["at0.20"] = <
                text = <"pTX">
                description = <"Cannot be assessed.">
            >
            ["at0.21"] = <
                text = <"pT0">
                description = <"No evidence of primary tumour.">
            >
            ["at0.22"] = <
                text = <"pTis - no invasion">
                description = <"Carcinoma in situ, intraepithelial (no invasion).">
            >
            ["at0.23"] = <
                text = <"pTis - invasion">
                description = <"Carcinoma in situ, invasion of lamina propria.">
            >
            ["at0.24"] = <
                text = <"pT1">
                description = <"Tumor invades submucosa.">
            >
            ["at0.25"] = <
                text = <"pT2">
                description = <"Tumor invades muscularis propria.">
            >
            ["at0.26"] = <
                text = <"pT3">
                description = <"Tumour invades through muscularis propria into subserosa or into non-peritonealized pericolic or perirectal tissues.">
            >
            ["at0.27"] = <
                text = <"pT4a">
                description = <"Tumor penetrates the visceral peritoneum.">
            >
