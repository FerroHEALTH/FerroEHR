    details = <
        ["en"] = <
            language = <[ISO_639-1::en]>
            purpose = <"To record the TNM staging classification for melanoma of skin (Sixth Edition).">
            keywords = <"tumour", "TNM", "malignancy", "cancer", "staging", "classification", "grade", "grading", "stage", "lymph node", "metastasis", "melanoma">
            use = <"Use only for the Sixth edition of TNM melanoma of skin classification.">
            misuse = <"Not to be used for other editions of TNM classification.">
            copyright = <"© openEHR Foundation">
        >
    >

definition
    CLUSTER[at0000.1] matches {    -- TNM staging - Melanoma of skin (Sixth edition)
        items matches {
            CLUSTER[at0002] matches {
                items matches {
                    ELEMENT[at0004] matches {
                        value matches {
                            DV_CODED_TEXT[at9002.1] matches {
                                defining_code matches {[ac0.9000]}    -- Regional lymph nodes (N) (synthesised)
                            }
                        }
                    }
                    ELEMENT[at0005] matches {
                        value matches {
                            DV_CODED_TEXT[at9003.1] matches {
                                defining_code matches {[ac0.9001]}    -- Distant metastasis (M) (synthesised)
                            }
                        }
                    }
                    ELEMENT[at0010] matches {
                        value matches {
                            DV_CODED_TEXT[at9004.1] matches {
                                defining_code matches {[ac0.9002]}    -- Clinical staging (synthesised)
                            }
                        }
                    }
                }
            }
            CLUSTER[at0006] matches {
                items matches {
                    ELEMENT[at0007] matches {
                        value matches {
                            DV_CODED_TEXT[at9007.1] matches {
                                defining_code matches {[ac0.9003]}    -- Primary tumour (pT) (synthesised)
                            }
                        }
                    }
                    ELEMENT[at0008] matches {
                        value matches {
                            DV_CODED_TEXT[at9008.1] matches {
                                defining_code matches {[ac0.9004]}    -- Regional lymph node (pN) (synthesised)
                            }
                        }
                    }
                    ELEMENT[at0009] matches {
                        value matches {
                            DV_CODED_TEXT[at9009.1] matches {
                                defining_code matches {[ac0.9005]}    -- Distant metastasis (pM) (synthesised)
                            }
                        }
                    }
                    ELEMENT[at0011] matches {
                        value matches {
                            DV_CODED_TEXT[at9010.1] matches {
                                defining_code
                            }
                        }
                    }
                }
            }
        }
    }

