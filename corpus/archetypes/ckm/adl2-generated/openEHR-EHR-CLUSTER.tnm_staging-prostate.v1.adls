    details = <
        ["en"] = <
            language = <[ISO_639-1::en]>
            purpose = <"To record the TNM staging classification for prostate cancer (Sixth Edition).">
            keywords = <"tumour", "TNM", "malignancy", "cancer", "staging", "classification", "grade", "grading", "stage", "lymph node", "metastasis", "prostate">
            use = <"Use only for the Sixth edition of TNM prostate classification.">
            misuse = <"Not to be used for other editions of TNM classification.
Not to be to stage transitional cell carcinoma of the prostate.">
            copyright = <"© openEHR Foundation">
        >
    >

definition
    CLUSTER[at0000.1] matches {    -- TNM staging - Prostate cancer (Sixth edition)
        items matches {
            CLUSTER[at0002] matches {
                items matches {
                    ELEMENT[at0003] matches {
                        value matches {
                            DV_CODED_TEXT[at9001.1] matches {
                                defining_code matches {[ac0.9000]}    -- Primary tumour (T) (synthesised)
                            }
                        }
                    }
                    ELEMENT[at0004] matches {
                        value matches {
                            DV_CODED_TEXT[at9002.1] matches {
                                defining_code matches {[ac0.9001]}    -- Regional lymph nodes (N) (synthesised)
                            }
                        }
                    }
                    ELEMENT[at0005] matches {
                        value matches {
                            DV_CODED_TEXT[at9003.1] matches {
                                defining_code matches {[ac0.9002]}    -- Distant metastasis (M) (synthesised)
                            }
                        }
                    }
                    ELEMENT[at0014] matches {
                        value matches {
                            DV_CODED_TEXT[at9005.1] matches {
                                defining_code matches {[ac0.9003]}    -- Clinical stage grouping (synthesised)
                            }
                        }
                    }
                }
            }
            CLUSTER[at0006] matches {
                items matches {
                    ELEMENT[at0007] matches {
                        value matches {
                            DV_CODED_TEXT[at9007.1] matches {
                                defining_code matches {[ac0.9004]}    -- Primary tumour (pT) (synthesised)
                            }
                        }
                    }
                    ELEMENT[at0008] matches {
                        value matches {
                            DV_CODED_TEXT[at9008.1] matches {
                                defining_code matches {[ac0.9005]}    -- Regional lymph node (pN) (synthesised)
                            }
                        }
                    }
                    ELEMENT[at0009] matches {
                        value matches {
                            DV_CODED_TEXT[at9009.1] matches {
                                defining_code matches {[ac0.9006]}    -- Distant metastasis (pM) (synthesised)
                            }
                        }
                    }
                    ELEMENT[at0011] matches {
                        value matches {
                            DV_CODED_TEXT[at9010.1] matches {
                                defining_code
                            }
                        }
                    }
                    ELEMENT[at0015] matches {
                        value matches {
                            DV_CODED_TEXT[at9011.1] matches {
                                defining_code matches {[ac0.9007]}    -- Pathological stage grouping (synthesised)
                            }
                        }
                    }
                }
            }
        }
    }

