    details = <
        ["en"] = <
            language = <[ISO_639-1::en]>
            purpose = <"To record the TNM staging classification for lung cancer (Seventh Edition).">
            keywords = <"tumour", "TNM", "malignancy", "cancer", "staging", "classification", "grade", "grading", "stage", "lymph node", "metastasis", "lung", "bronchial">
            use = <"Use only for the Seventh edition of TNM lung cancer classification.">
            misuse = <"Not to be used for pleural mesothelioma, sarcoma or other rare lung tumours.
Not to be used for other editions of TNM classification.">
            copyright = <"© openEHR Foundation">
        >
    >

definition
    CLUSTER[at0000.1] matches {    -- Tumour - Lung cancer TNM staging 7th Edition
        items matches {
            ELEMENT[at0003] matches {
                value matches {
                    DV_CODED_TEXT[at9001.1] matches {
                        defining_code matches {[ac0.9000]}    -- Primary tumour (T) (synthesised)
                    }
                }
            }
            ELEMENT[at0004] matches {
                value matches {
                    DV_CODED_TEXT[at9002.1] matches {
                        defining_code matches {[ac0.9001]}    -- Regional lymph nodes (N) (synthesised)
                    }
                }
            }
            ELEMENT[at0005] matches {
                value matches {
                    DV_CODED_TEXT[at9003.1] matches {
                        defining_code matches {[ac0.9002]}    -- Distant metastasis (M) (synthesised)
                    }
                }
            }
            ELEMENT[at0025] matches {
                value matches {
                    DV_CODED_TEXT[at9004.1] matches {
                        defining_code matches {[ac0.9003]}    -- Residual tumour (R) (synthesised)
                    }
                }
            }
            ELEMENT[at0014] matches {
                value matches {
                    DV_CODED_TEXT[at9008.1] matches {
                        defining_code matches {[ac0.9004]}    -- Stage grouping (synthesised)
                    }
                }
            }
        }
    }

