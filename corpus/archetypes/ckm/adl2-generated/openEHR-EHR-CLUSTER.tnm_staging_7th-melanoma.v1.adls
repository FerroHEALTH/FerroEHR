    details = <
        ["en"] = <
            language = <[ISO_639-1::en]>
            purpose = <"To record the classification and grading of primary cutaneous melanoma using the TNM classification 7th Edition.">
            keywords = <"tumour", "TNM", "malignancy", "cancer", "staging", "classification", "grade", "grading", "stage", "lymph node", "metastasis", "melanoma", "skin">
            use = <"">
            misuse = <"Should not normally be used for TNM classification without specialisation or template-constraints">
            copyright = <"© openEHR Foundation">
        >
    >

definition
    CLUSTER[at0000.1] matches {    -- Tumour - Primary Cutaneous Melanoma TNM staging 7th Edition
        items matches {
            ELEMENT[at0003] matches {
                value matches {
                    DV_CODED_TEXT[at9001.1] matches {
                        defining_code matches {[ac0.9000]}    -- Primary tumour (T) (synthesised)
                    }
                }
            }
            ELEMENT[at0004] matches {
                value matches {
                    DV_CODED_TEXT[at9002.1] matches {
                        defining_code matches {[ac0.9001]}    -- Regional lymph nodes (N) (synthesised)
                    }
                }
            }
            ELEMENT[at0005] matches {
                value matches {
                    DV_CODED_TEXT[at9003.1] matches {
                        defining_code matches {[ac0.9002]}    -- Distant metastasis (M) (synthesised)
                    }
                }
            }
            ELEMENT[at0014] matches {
                value matches {
                    DV_CODED_TEXT[at9008.1] matches {
                        defining_code matches {[ac0.9003]}    -- Stage grouping (synthesised)
                    }
                }
            }
        }
    }

