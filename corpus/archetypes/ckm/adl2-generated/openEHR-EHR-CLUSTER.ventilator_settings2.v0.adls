    details = <
        ["sl"] = <
            language = <[ISO_639-1::sl]>
            purpose = <"To ecord details of assisted ventilation parameters.">
            keywords = <"ventilator", "assisted", "respiration", "mechanical">
            use = <"May be used both on the context of instructing these parameters to be set and in recording the parameters actualy in use either manually or direct from the device.">
            misuse = <"">
            copyright = <"© openEHR Foundation">
        >
        ["en"] = <
            language = <[ISO_639-1::en]>
            purpose = <"To record details of ventilator settings, such as ventilation type, volume, frequencies and pressures.">
            keywords = <"ventilator", "assisted">
            use = <"">
            misuse = <"">
            copyright = <"© openEHR Foundation">
        >
    >

definition
    CLUSTER[at0000] matches {    -- Ventilator settings/findings
        items cardinality matches {1..*; unordered} matches {
            ELEMENT[at0144] occurrences matches {0..1} matches {    -- Type of ventilation
                value matches {
                    DV_CODED_TEXT[at9014] matches {
                        defining_code matches {[ac9000]}    -- Type of ventilation (synthesised)
                    }
                }
            }
            ELEMENT[at0001] occurrences matches {0..1} matches {    -- Ventilation mode
                value matches {
                    DV_CODED_TEXT[at9015] matches {
                        defining_code matches {[ac9001]}    -- Ventilation mode (synthesised)
                    }
                }
            }
            ELEMENT[at0114] matches {    -- Ventilation submode
                value matches {
                    DV_CODED_TEXT[at9016] matches {
                        defining_code matches {[ac9002]}    -- Ventilation submode (synthesised)
                    }
                }
            }
            allow_archetype CLUSTER[at0056] occurrences matches {0..1} matches {    -- Ventilation device
                include
                    archetype_id/value matches {/openEHR-EHR-CLUSTER\.device(-[a-zA-Z0-9_]+)*\.v1\..*/}
            }
            allow_archetype CLUSTER[at0051] occurrences matches {0..1} matches {    -- Oxygen delivery
                include
                    archetype_id/value matches {/openEHR-EHR-CLUSTER\.gas_delivery-oxygen(-[a-zA-Z0-9_]+)*\.v1\..*/}
            }
            ELEMENT[at0055] occurrences matches {0..1} matches {    -- Heater used
                value matches {
                    DV_BOOLEAN[at9017] matches {
                        value matches {True, False}
                    }
                }
            }
            ELEMENT[at0007] matches {    -- Frequency
                name matches {
                    DV_CODED_TEXT[at9018] matches {
                        defining_code matches {[ac9003]}    -- Frequency (synthesised)
                    }
                }
                value matches {
                    DV_QUANTITY[at9019] matches {
                        property matches {[at9004]}    -- Frequency
                        [magnitude, units, precision] matches {
                            [{|0.0..500.0|}, {"/min"}, {0}],
                            [{|0.0..500.0|}, {"Hz"}, {0}]
                        }
                    }
                }
            }
            ELEMENT[at0015] matches {    -- Pressure
                name matches {
                    DV_CODED_TEXT[at9020] matches {
                        defining_code matches {[ac9005]}    -- Pressure (synthesised)
                    }
                }
                value matches {
                    DV_QUANTITY[at9021] matches {
                        property matches {[at9006]}    -- Pressure
                        [magnitude, units, precision] matches {
                            [{|0.0..200.0|}, {"mbar"}, {1}],
                            [{|>=0.0|}, {"cm[H20]"}, {|>=0|}]
                        }
                    }
                }
            }
            ELEMENT[at0031] matches {    -- Volume
                name matches {
                    DV_CODED_TEXT[at9022] matches {
                        defining_code matches {[ac9007]}    -- Volume (synthesised)
                    }
                }
                value matches {
                    DV_QUANTITY[at9023] matches {
                        property matches {[at9008]}    -- Volume
                        [magnitude, units, precision] matches {
                            [{|0.0..2000.0|}, {"ml"}, {1}],
                            [{|0.0..200.0|}, {"l"}, {1}]
                        }
                    }
                }
            }
            ELEMENT[at0060] matches {    -- Flow rate
                name matches {
                    DV_CODED_TEXT[at9024] matches {
                        defining_code matches {[ac9009]}    -- Flow rate (synthesised)
                    }
                }
                value matches {
                    DV_QUANTITY[at9025] matches {
                        property matches {[at9010]}    -- Flow rate, volume
                        magnitude matches {|>=0.0|}
                        units matches {"l/min"}
                        precision matches {1}
                    }
                }
            }
            ELEMENT[at0038] matches {    -- Timing
                name matches {
                    DV_CODED_TEXT[at9026] matches {
                        defining_code matches {[ac9011]}    -- Timing (synthesised)
                    }
                }
                value matches {
                    DV_DURATION[at9027] matches {
                        value matches {PTS/|PT0S..PT16M40S|}
                    }
                }
            }
            ELEMENT[at0045] matches {    -- Trigger value
                name matches {
                    DV_CODED_TEXT[at9028] matches {
                        defining_code matches {[ac9012]}    -- Trigger value (synthesised)
                    }
                }
                value matches {
                    DV_COUNT[at9029] matches {
                        magnitude matches {|0..100|}
                    }
                    DV_QUANTITY[at9030] matches {
                        property matches {[at9010]}    -- Flow rate, volume
                        magnitude matches {|0.0..100.0|}
                        units matches {"l/min"}
                        precision matches {1}
                    }
                }
            }
            ELEMENT[at0087] matches {    -- Trigger type
                value matches {
                    DV_TEXT[at9031]
                }
            }
            ELEMENT[at0043] occurrences matches {0..1} matches {    -- I:E Inspiration/expiration
                value matches {
                    DV_PROPORTION[at9032] matches {
                        numerator matches {|1.0..99.0|}
                        is_integral matches {False}
                        type matches {0}
                    }
                }
            }
            ELEMENT[at0044] occurrences matches {0..1} matches {    -- I:T Inspiratory/Total
                value matches {
                    DV_PROPORTION[at9033] matches {
                        numerator matches {|0.0..100.0|}
                        type matches {2}
                    }
                }
            }
            ELEMENT[at0095] occurrences matches {0..1} matches {    -- Artificial airway compensation
                value matches {
                    DV_PROPORTION[at9034] matches {
                        numerator matches {|>=0.0|}
                        is_integral matches {False}
                        type matches {2}
                    }
                }
            }
            ELEMENT[at0053] occurrences matches {0..1} matches {    -- NO delivered
                value matches {
                    DV_QUANTITY[at9035] matches {
                        property matches {[at9013]}    -- Proportion
                        magnitude matches {|0.0..500.0|}
                        units matches {"[ppb]"}
                        precision matches {0}
                    }
                }
            }
            ELEMENT[at0054] occurrences matches {0..1} matches {    -- NO2 removed
                value matches {
                    DV_QUANTITY[at9036] matches {
                        property matches {[at9013]}    -- Proportion
                        magnitude matches {|0.0..5.0|}
                        units matches {"[ppb]"}
                        precision matches {0}
                    }
                }
            }
        }
    }

