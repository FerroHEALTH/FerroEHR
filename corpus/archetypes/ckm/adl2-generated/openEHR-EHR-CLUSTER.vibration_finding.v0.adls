archetype (adl_version=2.4.0; rm_release=1.1.0; generated; uid=a9c7806b-b88b-49ac-af96-768e19c18ae2; build_uid=73e353cd-fccc-4a27-99a0-8f2a996f0845)
    openEHR-EHR-CLUSTER.vibration_finding.v0.0.1-alpha

language
    original_language = <[ISO_639-1::en]>

description
    original_author = <
        ["name"] = <"Heather Leslie">
        ["organisation"] = <"Atomica Informatics">
        ["email"] = <"heather.leslie@atomicainformatics.com">
        ["date"] = <"2023-06-14">
    >
    original_namespace = <"org.openehr">
    original_publisher = <"openEHR Foundation">
    lifecycle_state = <"in_development">
    custodian_namespace = <"org.openehr">
