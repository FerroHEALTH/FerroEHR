        ["MD5-CAM-1.0.1"] = <"F97815033DDF6ED3BC2EB4298F9B9895">
    >
    details = <
        ["en"] = <
            language = <[ISO_639-1::en]>
            purpose = <"Aggregating several observations and action for recording of observations of daily living (ODLs) by a patient.

Based on the data model developed within the EMPOWER project, www.empower-fp7,eu.">
            use = <"Composition of ODLs for self-monitoring.">
            misuse = <"">
            copyright = <"© openEHR Foundation">
        >
    >

definition
    COMPOSITION[at0000] matches {    -- ODL (EMPOWER)
        category matches {
            DV_CODED_TEXT[at9001] matches {
                defining_code matches {[at9000]}    -- event
            }
        }
        context matches {
            EVENT_CONTEXT[at9002] matches {
                other_context matches {
                    ITEM_TREE[at0001]
                }
            }
        }
        content cardinality matches {1..*; unordered} matches {
            allow_archetype OBSERVATION[at0002] matches {    -- OBSERVATION
                include
                    archetype_id/value matches {/.*/}
            }
            allow_archetype ACTION[at0003] matches {    -- ACTION
                include
                    archetype_id/value matches {/.*/}
            }
            allow_archetype EVALUATION[at0004] matches {    -- EVALUATION
                include
                    archetype_id/value matches {/.*/}
            }
        }
    }

terminology
    term_definitions = <
        ["en"] = <
            ["at0000"] = <
                text = <"ODL (EMPOWER)">
                description = <"Observation of daily living data that is reported by the patient himself while self-monitoring.">
            >
            ["at0002"] = <
                text = <"OBSERVATION">
                description = <"Slot for an observation.">
            >
            ["at0003"] = <
                text = <"ACTION">
                description = <"Slot for an action.">
            >
            ["at0004"] = <
                text = <"EVALUATION">
                description = <"Slot for an evaluation.">
            >
            ["at9000"] = <
                text = <"event">
                description = <"event">
            >
        >
    >
    term_bindings = <
        ["openehr"] = <
            ["at9000"] = <http://openehr.org/id/433>
        >
    >
