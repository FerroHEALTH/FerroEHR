definition
    COMPOSITION[at0000.1] matches {    -- Post mortem report
        /context[at9002]/other_context[at0001]/items matches {
            ELEMENT[at0.1] occurrences matches {0..1} matches {    -- Date of autopsy
                value matches {
                    DV_DATE_TIME[at0.9000]
                }
            }
            allow_archetype CLUSTER[at0.2] matches {    -- Pathologist
                include
                    archetype_id/value matches {/openEHR-EHR-CLUSTER\.person(-[a-zA-Z0-9_]+)*\.v1\..*/}
            }
            ELEMENT[at0.3] occurrences matches {0..1} matches {    -- Pathologist category
                value matches {
                    DV_TEXT[at0.9001]
                }
            }
            allow_archetype CLUSTER[at0.4] matches {    -- Investigator
                include
                    archetype_id/value matches {/.*/}
            }
            ELEMENT[at0.5] occurrences matches {0..1} matches {    -- Date report completed
                value matches {
                    DV_DATE_TIME[at0.9002]
                }
            }
            ELEMENT[at0.6] occurrences matches {0..1} matches {    -- Date report submitted
                value matches {
                    DV_DATE_TIME[at0.9003]
                }
            }
        }
    }

terminology
    term_definitions = <
        ["de"] = <
            ["at0000.1"] = <
                text = <"*Post mortem report (en)">
                description = <"*Container archetype to carry information about a post mortem or autopsy. (en)">
            >
            ["at0.5"] = <
                text = <"*Date report completed (en)">
                description = <"*The date when the post mortem report was completed. (en)">
            >
            ["at0.6"] = <
                text = <"*Date report submitted (en)">
                description = <"*The date when the post mortem report was submitted to the public health authority. (en)">
            >
            ["at0.1"] = <
                text = <"*Date of autopsy (en)">
                description = <"*The date when the autopsy was completed. (en)">
            >
            ["at0.3"] = <
                text = <"*Coroner category (en)">
                description = <"*The category/credentials of the pathologist who carried out the autopsy. (en)">
