    other_details = <
        ["current_contact"] = <"Heather Leslie, Atomica Informatics, heather.leslie@atomicainformatics.com">
        ["MD5-CAM-1.0.1"] = <"18AFB80928AA95AF3DAB27B3A1E2FFEA">
    >
    details = <
        ["de"] = <
            language = <[ISO_639-1::de]>
            purpose = <"Zur Erfassung der Einzelheiten einer formellen Überprüfung der klinischen Situation eines Patienten oder eines bestimmten Aspekts seiner klinischen Versorgung.">
            keywords = <"Überprüfung", "Beurteilung", "Medizin", "klinisch", "Fall", "Akte">
            use = <"Zur Erfassung der Einzelheiten einer formellen Überprüfung der klinischen Situation eines Patienten oder eines bestimmten Aspekts seiner klinischen Versorgung. Zum Beispiel, um Arzneimittelüberprüfungen oder Überprüfungen durch einen Case Manager zu dokumentieren.">
            misuse = <"">
        >
        ["pt-pt"] = <
            language = <[ISO_639-1::pt-pt]>
            purpose = <"Registar os detalhes de uma análise formal da situação clínica de um sujeito ou de qualquer aspeto específico dos seus cuidados clínicos.">
            keywords = <"análise", "avaliação", "medicina", "clínico", "caso", "ficheiro">
            use = <"Utilize para registar os detalhes de uma análise formal da situação clínica de um sujeito ou de qualquer aspeto específico dos seus cuidados clínicos. Por exemplo: utilizar para registar avaliações de Medicamentos; ou revisões do Coordenador de Caso.">
            misuse = <"">
        >
        ["sv"] = <
            language = <[ISO_639-1::sv]>
            purpose = <"Att dokumentera innehållet och detaljerna kring en formell granskning av en patients kliniska situation eller en specifik aspekt av den kliniska vården.">
            keywords = <"granskning", "bedömning", "medicin", "klinisk", "patientfall">
            use = <"Används för att dokumentera en formell granskning av en patients kliniska situation eller en specifik aspekt av den kliniska vården.
Exempelvis för att dokumentera läkemedelsgranskningar eller vårdplaneringsmöten (t.ex. utförda av en patientansvarig sjuksköterska eller samordnare).">
            misuse = <"">
        >
        ["nb"] = <
            language = <[ISO_639-1::nb]>
            purpose = <"For å registrere detaljer om en formell vurdering av den kliniske situasjonen eller andre aspekter ved den klinisk omsorgen hos et individ.">
            keywords = <"gjennomgang", "evaluering", "drøftelse", "sak", "dokumentasjon", "gjennomgåelse", "bedømme", "drøfting">
            use = <"Brukes for å registrere detaljer om en formell vurdering av den kliniske situasjonen eller andre aspekter ved den klinisk omsorgen hos et individ.
For eksempel: brukes for å registrere Gjennomgang av legemiddelliste; eller Koordinatorvurdering.">
            misuse = <"">
        >
        ["en"] = <
            language = <[ISO_639-1::en]>
            purpose = <"To record the details of a formal review of a subject's clinical situation or any specific aspect of their clinical care.">
            keywords = <"review", "assessment", "medicine", "clinical", "case", "file">
            use = <"Use to record the details of a formal review of a subject's clinical situation or any specific aspect of their clinical care. For example: use to record Medicines reviews; or Case Coordinator reviews.">
            misuse = <"">
            copyright = <"© openEHR Foundation">
        >
        ["fr"] = <
            language = <[ISO_639-1::fr]>
            purpose = <"Pour enregistrer les détails d'une revue formelle de la situation clinique d'un sujet ou de tout aspect spécifique de ses soins cliniques.">
            keywords = <"revue", "évaluation", "médecine", "clinique", "cas", "fichier">
            use = <"À utiliser pour enregistrer les détails d'une revue formelle de la situation clinique d'un sujet ou de tout aspect spécifique de ses soins cliniques. Par exemple pour enregistrer des contrôles de médicaments ou des bilans effectués par un responsable de suivi.">
            misuse = <"">
        >
    >

definition
    COMPOSITION[at0000] matches {    -- Review
        category matches {
            DV_CODED_TEXT[at9001] matches {
                defining_code matches {[at9000]}    -- event
            }
        }
        context matches {
            EVENT_CONTEXT[at9002] matches {
                other_context matches {
                    ITEM_TREE[at0002] matches {
                        items cardinality matches {0..*; unordered} matches {
                            allow_archetype CLUSTER[at0003] matches {    -- Extension
                                include
                                    archetype_id/value matches {/.*/}
                            }
                        }
                    }
                }
            }
        }
    }

terminology
    term_definitions = <
        ["de"] = <
            ["at0000"] = <
                text = <"Überprüfung">
                description = <"Komposition zur Erfassung der Details einer formellen Überprüfung der klinischen Situation eines Patienten oder eines bestimmten Aspekts seiner klinischen Versorgung.">
            >
            ["at0003"] = <
                text = <"Erweiterung">
                description = <"Zusätzliche Informationen zur Erfassung lokaler Inhalte oder Anpassung an andere Referenzmodelle/Formalismen.">
                comment = <"Zum Beispiel: Lokaler Informationsbedarf oder zusätzliche Metadaten zur Anpassung an FHIR-Ressourcen.">
            >
            ["at9000"] = <
                text = <"* event (en)">
                description = <"* event (en)">
            >
        >
        ["pt-pt"] = <
            ["at0000"] = <
                text = <"Análise">
                description = <"Composição para registo dos detalhes de uma análise formal da situação clínica de um sujeito ou de qualquer aspeto específico dos seus cuidados clínicos.">
            >
            ["at0003"] = <
                text = <"*Extension (en)">
                description = <"*Additional information required to extend the model with local content or to align with other reference models or formalisms. (en)">
                comment = <"*For example: local information requirements; or additional metadata to align with FHIR. (en)">
            >
            ["at9000"] = <
                text = <"* event (en)">
                description = <"* event (en)">
            >
        >
