definition
    ELEMENT[at0000] matches {    -- Current Day of Menstrual cycle
        value matches {
            DV_COUNT[at9000] matches {
                magnitude matches {|>=1|}
            }
        }
    }

terminology
    term_definitions = <
        ["en"] = <
            ["at0000"] = <
                text = <"Current Day of Menstrual cycle">
                description = <"Number of days since onset of last normal menstrual period">
            >
        >
    >
