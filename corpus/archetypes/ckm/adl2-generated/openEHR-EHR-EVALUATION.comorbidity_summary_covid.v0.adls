definition
    EVALUATION[at0000] matches {    -- Condition summary
        data matches {
            ITEM_TREE[at0003] matches {
                items cardinality matches {0..*; unordered} matches {
                    ELEMENT[at0021] occurrences matches {0..1} matches {    -- Any underlying conditions?
                        value matches {
                            DV_CODED_TEXT[at9004] matches {
                                defining_code matches {[ac9000]}    -- Any underlying conditions? (synthesised)
                            }
                        }
                    }
                    ELEMENT[at0035] occurrences matches {0..1} matches {    -- Trimester if pregnant
                        value matches {
                            DV_CODED_TEXT[at9005] matches {
                                defining_code matches {[ac9001]}    -- Trimester if pregnant (synthesised)
                            }
                        }
                    }
                    CLUSTER[at0012] matches {    -- Condition
                        items cardinality matches {1..*; unordered} matches {
                            ELEMENT[at0020] occurrences matches {0..1} matches {    -- Condition name
                                value matches {
                                    DV_CODED_TEXT[at9006] matches {
                                        defining_code matches {[ac9002]}    -- Condition name (synthesised)
                                    }
                                    DV_TEXT[at9007]
                                }
                            }
                            ELEMENT[at0004] occurrences matches {0..1} matches {    -- Status
                                value matches {
                                    DV_CODED_TEXT[at9008] matches {
                                        defining_code matches {[ac9003]}    -- Status (synthesised)
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        protocol matches {
            ITEM_TREE[at0001] matches {
                items cardinality matches {0..*; unordered} matches {
                    allow_archetype CLUSTER[at0002] matches {    -- Extension
                        include
                            archetype_id/value matches {/.*/}
                    }
                }
            }
        }
    }

