archetype (adl_version=2.4.0; rm_release=1.1.0; generated; uid=f336cdef-3359-4135-9ad2-b226c9c78062; build_uid=d6e090ae-63f2-4a4b-80ba-8c7a63d4c2c1)
    openEHR-EHR-EVALUATION.developmental_milestones.v0.0.1-alpha

language
    original_language = <[ISO_639-1::en]>

description
    original_author = <
