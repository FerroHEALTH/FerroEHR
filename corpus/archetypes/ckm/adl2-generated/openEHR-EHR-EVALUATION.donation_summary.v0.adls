archetype (adl_version=2.4.0; rm_release=1.1.0; generated; uid=7f371f86-8d09-4a03-8a78-ea46eb808bc7; build_uid=a819844c-569f-4f22-88e2-2054e4d0accd)
    openEHR-EHR-EVALUATION.donation_summary.v0.0.1-alpha

language
    original_language = <[ISO_639-1::en]>

description
    original_author = <
        ["name"] = <"Heather Leslie">
        ["organisation"] = <"Atomica Informatics">
        ["email"] = <"heather.leslie@atomicainformatics.com">
        ["date"] = <"2025-07-14">
    >
    original_namespace = <"org.openehr">
    original_publisher = <"openEHR Foundation">
    lifecycle_state = <"in_development">
    custodian_namespace = <"org.openehr">
