archetype (adl_version=2.4.0; rm_release=1.1.0; generated; uid=ae4d9842-8565-4a09-9e5d-6f728d7a1d4b; build_uid=d7556901-a4e9-411c-b462-993d7b3cb536)
    openEHR-EHR-EVALUATION.exclusion-medication.v1.0.0

