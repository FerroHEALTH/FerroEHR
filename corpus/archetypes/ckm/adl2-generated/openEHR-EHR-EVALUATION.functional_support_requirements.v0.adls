description
    original_author = <
        ["name"] = <"Heather Leslie">
        ["organisation"] = <"Atomica Informatics">
        ["email"] = <"heather.leslie@atomicainformatics.com">
        ["date"] = <"2026-03-16">
    >
    original_namespace = <"org.openehr">
    original_publisher = <"openEHR Foundation">
    other_contributors = <"Vebjørn Arntzen, Oslo University Hospital, Norway", "Sparked AU, CSIRO, Australia (openEHR Editor)", "SB Bhattacharyya, Bhattacharyyas Clinical Records Research & Informatics LLP, India", "Tara Bonet Chinillach, Catalan Health Service, Spain", "Clara Calleja Vega, CatSalut. Servei Català de la Salut., Spain", "Lars Fuhrmann, German Society of Ophthalmology, Germany", "William Goossen, Results 4 Care, Netherlands", "Patricia Homem-Silva, University of Porto, Portugal", "Evelyn Hovenga, EJSH Consulting, Australia", "Heather Leslie, Atomica Informatics, Australia (openEHR Editor)", "Michael Lutz, BITsoft, Germany", "Patrick Fergal McSharry, MSMS(I) and SESLHD, Australia", "Mikael Nyström, Cambio Healthcare Systems AB, Sweden", "Vuk Radnić, Better, Slovenia", "Norwegian Review Summary, Norwegian Public Hospitals, Norway", "Averil Tam, CSIRO, Australia", "Nyree Taylor, CSIRO, Australia (openEHR Editor)">
    lifecycle_state = <"in_development">
    custodian_namespace = <"org.openehr">
    custodian_organisation = <"openEHR Foundation">
    licence = <"This work is licensed under the Creative Commons Attribution-ShareAlike 4.0 International License. To view a copy of this license, visit http://creativecommons.org/licenses/by-sa/4.0/.">
    references = <
        ["1"] = <"Functional support requirements, Proposed data group, Australian Clinical Data for Interoperability (AUCDI) Release 4 [Internet]. Sparked FHIR Accelerator, CSIRO; [cited 2026 Nov 05]. Unpublished.">
        ["2"] = <"Granger CV, Hamilton BB, Linacre JM, Heinemann AW, Wright BD. Performance profiles of the functional independence measure. Am J Phys Med Rehabil. 1993 Apr;72(2):84-9.">
        ["3"] = <"World Health Organization. International classification of functioning, disability and health (ICF) [Internet]. Geneva: World Health Organization; 2001 [cited 2026 Jan 19]. Available from: https://www.who.int/standards/classifications/international-classification-of-functioning-disability-and-health">
    >
    other_details = <
        ["MD5-CAM-1.0.1"] = <"C166E78CF4454B54EB3AA0F9CF229339">
    >
    details = <
        ["nb"] = <
            language = <[ISO_639-1::nb]>
            purpose = <"For å registrere sammendragsinformasjon om støtten som er nødvendig for å sette et individ i stand til eller hjelpe et individ med å utføre en aktivitet.">
            use = <"*Use to record summary information about the supports needed to enable or assist an individual to perform a single activity. This includes an individual who is fully dependent on others to complete the activity.

Supports may include human assistance, assistive devices, assistance animals, and environmental conditions, such as a quiet room.

Support requirements may be identified for activities of everyday life in any setting, such as at home, in residential care, or in hospital.

Support requirements may be identified across a range of areas of activity and participation including, but not limited to:
- Mobility,
- Self-care,
- Communication,
- Domestic life,
- Attending work or school,
- Community participation,
- Recognised groupings of activities, such as personal activities of daily living (pADLs) or instrumental activities of daily living (iADLs), and
- Activities performed in regulated, occupational, or safety-critical contexts.

An activity may be:
- A simple or foundational action that can be observed as a discrete activity, such as standing, brushing hair, or gripping a cup.
- A complex or composite action that requires a sequence of simple actions, such as transferring from bed to chair, preparing a meal, managing medications, or driving a car.

This information is persistent and is updated as support requirements change. It may inform care planning, allocation of staff and equipment, and determination of service eligibility. It may be recorded on its own or as part of a care plan. Recording a support requirement identifies a need. It does not imply that the support will be provided against the individual's wishes.

Record one instance of this archetype for each activity, reflecting the support needed when the individual's need for support is greatest. Where an assistive device changes the human assistance needed, such as a hoist for transfers, include the device in the name of the activity.

This archetype is one of a set of three related archetypes designed to represent different aspects of how an individual functions in everyday life:
- OBSERVATION.functional_ability, which records what an individual can do when performing an activity;
- EVALUATION.impairment_summary, which records an impairment that may limit what an individual can do; and
- EVALUATION.functional_support_requirements, which records the type and level of support an individual needs for an activity.

In practice, these archetypes are often used alongside others, such as CLUSTER.symptom_sign and EVALUATION.problem_diagnosis. For example:
- For an adult with Parkinson’s disease, tremor is recorded using CLUSTER.symptom_sign, the condition using EVALUATION.problem_diagnosis, the ability to drink from a cup using OBSERVATION.functional_ability, motor control using EVALUATION.impairment_summary, and the need for a cup with a lid using EVALUATION.functional_support_requirements.
- For an adult after a stroke, left-sided weakness is recorded using CLUSTER.symptom_sign, the condition using EVALUATION.problem_diagnosis, the ability to transfer from bed to chair using OBSERVATION.functional_ability, left lower limb motor control using EVALUATION.impairment_summary, and the need for physical assistance from two people to transfer from bed to chair using EVALUATION.functional_support_requirements.
- For an adult with Alzheimer’s disease, forgetfulness is recorded using CLUSTER.symptom_sign, the condition using EVALUATION.problem_diagnosis, the ability to manage medications using OBSERVATION.functional_ability, short-term memory using EVALUATION.impairment_summary, and the need for prompting from a carer using EVALUATION.functional_support_requirements.
- For a child with chronic otitis media, ear discharge is recorded using CLUSTER.symptom_sign, the condition using EVALUATION.problem_diagnosis, the ability to follow instructions in the classroom using OBSERVATION.functional_ability, hearing using EVALUATION.impairment_summary, and the need for seating near the teacher using EVALUATION.functional_support_requirements.. (en)">
            misuse = <"Brukes ikke for å registrere et individs evne til å utføre en aktivitet eller delta i en livssituasjon. Bruk arketypen OBSERVATION.functional_ability (Funksjonell evne) til dette formålet.

Brukes ikke for å registrere en underliggende funksjonsnedsettelse som påvirker en kroppsfunksjon eller kroppsstruktur. Bruk arketypen EVALUATION.impairment_summary (Sammendrag av funksjonsnedsettelse) til dette formålet.

Brukes ikke for å registrere resultatet av en vurdering eller skala for funksjonell uavhengighet. Bruk en egnet OBSERVATION-arketype til dette formålet.

Brukes ikke for å registrere intervensjoner som ble levert under en spesifikk omsorgshendelse eller intervensjon. Bruk en egnet ACTION-arketype for å dokumentere intervensjoner eller tjenester som er levert som del av omsorgsutførelsen.">
        >
        ["en"] = <
            language = <[ISO_639-1::en]>
            purpose = <"To record summary information about the supports needed to enable or assist an individual to perform an activity.">
            use = <"Use to record summary information about the supports needed to enable or assist an individual to perform a single activity. This includes an individual who is fully dependent on others to complete the activity.

Supports may include human assistance, assistive devices, assistance animals, and environmental conditions, such as a quiet room.

Support requirements may be identified for activities of everyday life in any setting, such as at home, in residential care, or in hospital.

Support requirements may be identified across a range of areas of activity and participation including, but not limited to:
- Mobility,
- Self-care,
- Communication,
- Domestic life,
- Attending work or school,
- Community participation,
- Recognised groupings of activities, such as personal activities of daily living (pADLs) or instrumental activities of daily living (iADLs), and
- Activities performed in regulated, occupational, or safety-critical contexts.

An activity may be:
- A simple or foundational action that can be observed as a discrete activity, such as standing, brushing hair, or gripping a cup.
- A complex or composite action that requires a sequence of simple actions, such as transferring from bed to chair, preparing a meal, managing medications, or driving a car.

This information is persistent and is updated as support requirements change. It may inform care planning, allocation of staff and equipment, and determination of service eligibility. It may be recorded on its own or as part of a care plan. Recording a support requirement identifies a need. It does not imply that the support will be provided against the individual's wishes.

Record one instance of this archetype for each activity, reflecting the support needed when the individual's need for support is greatest. Where an assistive device changes the human assistance needed, such as a hoist for transfers, include the device in the name of the activity.

This archetype is one of a set of three related archetypes designed to represent different aspects of how an individual functions in everyday life:
- OBSERVATION.functional_ability, which records what an individual can do when performing an activity;
- EVALUATION.impairment_summary, which records an impairment that may limit what an individual can do; and
- EVALUATION.functional_support_requirements, which records the type and level of support an individual needs for an activity.

In practice, these archetypes are often used alongside others, such as CLUSTER.symptom_sign and EVALUATION.problem_diagnosis. For example:
- For an adult with Parkinson’s disease, tremor is recorded using CLUSTER.symptom_sign, the condition using EVALUATION.problem_diagnosis, the ability to drink from a cup using OBSERVATION.functional_ability, motor control using EVALUATION.impairment_summary, and the need for a cup with a lid using EVALUATION.functional_support_requirements.
- For an adult after a stroke, left-sided weakness is recorded using CLUSTER.symptom_sign, the condition using EVALUATION.problem_diagnosis, the ability to transfer from bed to chair using OBSERVATION.functional_ability, left lower limb motor control using EVALUATION.impairment_summary, and the need for physical assistance from two people to transfer from bed to chair using EVALUATION.functional_support_requirements.
- For an adult with Alzheimer’s disease, forgetfulness is recorded using CLUSTER.symptom_sign, the condition using EVALUATION.problem_diagnosis, the ability to manage medications using OBSERVATION.functional_ability, short-term memory using EVALUATION.impairment_summary, and the need for prompting from a carer using EVALUATION.functional_support_requirements.
- For a child with chronic otitis media, ear discharge is recorded using CLUSTER.symptom_sign, the condition using EVALUATION.problem_diagnosis, the ability to follow instructions in the classroom using OBSERVATION.functional_ability, hearing using EVALUATION.impairment_summary, and the need for seating near the teacher using EVALUATION.functional_support_requirements..">
            misuse = <"Not to be used to record an individual's ability to perform an activity or participate in a life situation. Use the OBSERVATION.functional_ability archetype for this purpose.

Not to be used to record an impairment of physiological or psychological function. Use the EVALUATION.impairment_summary archetype for this purpose.

Not to be used to record a diagnosis, including a diagnosis of impairment or disability. Use the EVALUATION.problem_diagnosis archetype for this purpose.

Not to be used to record the outcome of a functional independence assessment or scoring system. Use an appropriate OBSERVATION archetype for this purpose.

Not to be used to record a request or order for a support, service, or device. Use an appropriate INSTRUCTION archetype for this purpose.

Not to be used to record who is allocated or rostered to provide support, the organisation providing it, or where it is provided. This belongs to care planning and service arrangements.

Not to be used to record the interventions that were provided during a specific care event or intervention. Use an appropriate ACTION archetype to document interventions or services delivered as part of care provision.">
            copyright = <"© openEHR Foundation">
        >
    >

definition
    EVALUATION[at0000] matches {    -- Functional support requirements
        data matches {
            ITEM_TREE[at0001] matches {
                items cardinality matches {0..*; unordered} matches {
                    ELEMENT[at0002] occurrences matches {1} matches {    -- Activity name
                        value matches {
                            DV_TEXT[at9002]
                        }
                    }
                    ELEMENT[at0003] occurrences matches {0..1} matches {    -- Support description
                        value matches {
                            DV_TEXT[at9003]
                        }
                    }
                    ELEMENT[at0025] occurrences matches {0..1} matches {    -- Assistive devices description
                        value matches {
                            DV_TEXT[at9004]
                        }
                    }
                    allow_archetype CLUSTER[at0020] matches {    -- Assistive device details
                        include
                            archetype_id/value matches {/openEHR-EHR-CLUSTER\.device(-[a-zA-Z0-9_]+)*\.v1\..*/}
                    }
                    ELEMENT[at0005] matches {    -- Assistance type
                        value matches {
                            DV_CODED_TEXT[at9005] matches {
                                defining_code matches {[ac9000]}    -- Assistance type (synthesised)
                            }
                            DV_TEXT[at9006]
                        }
                    }
                    ELEMENT[at0011] occurrences matches {0..1} matches {    -- Physical assistance level
                        value matches {
                            DV_CODED_TEXT[at9007] matches {
                                defining_code matches {[ac9001]}    -- Physical assistance level (synthesised)
                            }
                            DV_TEXT[at9011]
                        }
                    }
                    ELEMENT[at0018] occurrences matches {0..1} matches {    -- Number of people
                        value matches {
                            DV_COUNT[at9008] matches {
                                magnitude matches {|>=1|}
                            }
                        }
                    }
                    allow_archetype CLUSTER[at0019] matches {    -- Support person details
                        include
                            archetype_id/value matches {/openEHR-EHR-CLUSTER\.person\.v1\..*/}
                    }
                    allow_archetype CLUSTER[at0021] matches {    -- Additional details
                        include
                            archetype_id/value matches {/.*/}
                    }
                    ELEMENT[at0022] occurrences matches {0..1} matches {    -- Comment
                        value matches {
                            DV_TEXT[at9009]
                        }
                    }
                }
            }
        }
        protocol matches {
            ITEM_TREE[at0004] matches {
                items cardinality matches {0..*; unordered} matches {
                    ELEMENT[at0023] occurrences matches {0..1} matches {    -- Last updated
                        value matches {
                            DV_DATE_TIME[at9010]
                        }
                    }
                    allow_archetype CLUSTER[at0024] matches {    -- Extension
                        include
                            archetype_id/value matches {/.*/}
                    }
                }
            }
        }
    }

terminology
    term_definitions = <
        ["nb"] = <
            ["at0000"] = <
                text = <"Funksjonelle støttebehov">
                description = <"Sammendragsinformasjon om støtten som er nødvendig for å sette et individ i stand til eller hjelpe et individ med å utføre en aktivitet.">
                comment = <"I hele denne arketypen refererer uttrykket \"utføre en aktivitet\" eller lignende til å gjennomføre en enkelt aktivitet eller en gruppering av relaterte aktiviteter, eller å delta i en hverdagslig livssituasjon. Begrepet \"hjelpemiddel\" refererer til ethvert verktøy, hjelpemiddel eller teknologi som brukes av et individ for å støtte, opprettholde eller optimere utførelsen av en aktivitet.">
            >
            ["at0002"] = <
                text = <"Aktivitetsnavn">
                description = <"Navnet på aktiviteten som det er behov for støtte til.">
                comment = <"Koding med ekstern terminologi anbefales. Fritekst bør bare tillates der ingen passende kodet verdi er tilgjengelig. For eksempel: snu seg i sengen, forflytte seg fra seng til stol, gå; gå i trapper; pusse tenner, ta på sko, menstruasjonshygiene; lese, snakke, skrive; tilberede måltider, gjøre husarbeid; bruke offentlig transport, søke jobb, ta ut penger i en minibank; gå på skole, drive med sport, bli med i en klubb, gå på teater.">
            >
            ["at0003"] = <
                text = <"Beskrivelse av støtte">
                description = <"Fritekstbeskrivelse av støtten som er nødvendig for å sette individet i stand til eller hjelpe et individ med å utføre den identifiserte aktiviteten.">
                comment = <"\"Støtte\" brukes som et paraplybegrep som kan omfatte menneskelig hjelp, hjelpemidler eller miljømessige forhold.">
            >
            ["at0005"] = <
                text = <"Type assistanse">
                description = <"Typen menneskelig assistanse som er nødvendig for å sette individet i stand til eller hjelpe individet med å utføre aktiviteten.">
                comment = <"Mer enn én \"Type assistanse\" kan registreres der det er aktuelt. Verdien \"Ingen\" kan registreres dersom et tidligere identifisert funksjonelt støttebehov ikke lenger er nødvendig.">
            >
            ["at0006"] = <
                text = <"Ingen">
                description = <"Det er ikke behov for menneskelig assistanse for at individet skal kunne utføre aktiviteten selvstendig.">
            >
            ["at0007"] = <
                text = <"Tilsyn">
                description = <"Overvåking av aktiviteten av en annen person for å ivareta sikkerheten, vanligvis fra et sted i nærheten eller på avstand, og uten å være posisjonert for å gripe inn fysisk umiddelbart.">
            >
            ["at0008"] = <
                text = <"Tilrettelegging av oppgave">
                description = <"Tilrettelegging av miljøet eller utstyret av en annen person slik at individet kan utføre aktiviteten.">
            >
            ["at0009"] = <
                text = <"Kognitiv støtte">
                description = <"Veiledning om hvordan en aktivitet kan planlegges eller tilnærmes, eller hint/pekepinn gitt under aktiviteten for å støtte gjennomføringen av oppgaven.">
            >
            ["at0010"] = <
                text = <"Fysisk assistanse">
                description = <"Fysisk nærhet eller praktisk assistanse fra en annen person for å støtte trygg eller effektiv utførelse av aktiviteten.">
            >
            ["at0011"] = <
                text = <"Type fysisk assistanse">
                description = <"Intensiteten av menneskelig assistanse som er nødvendig fra en eller flere personer for å støtte trygg eller effektiv utførelse av en aktivitet.">
                comment = <"Fysisk assistanse kan være relatert til sikkerhet, balanse, koordinasjon, styrke eller motorisk utførelse under aktiviteten. Samtidig bruk av hjelpemidler eller miljømessig støtte bestemmer ikke \"Type fysisk assistanse\", selv om det kan påvirke antall personer som kreves for å yte assistanse.">
            >
            ["at0012"] = <
                text = <"Tilstedeværende avventende assistanse">
                description = <"Individet utfører aktiviteten selvstendig mens en eller flere personer holder seg innenfor armlengdes avstand, posisjonert slik at de umiddelbart kan gi fysisk assistanse om nødvendig av sikkerhetshensyn.">
            >
            ["at0013"] = <
                text = <"Lett fysisk kontakt">
                description = <"Individet utfører aktiviteten selvstendig mens en eller flere personer gir lett fysisk kontakt for kun balanse eller stabilitet.">
            >
            ["at0014"] = <
                text = <"Minimal fysisk assistanse">
                description = <"Individet utfører det meste av aktiviteten mens en eller flere personer bidrar med begrenset fysisk innsats.">
            >
            ["at0015"] = <
                text = <"Moderat fysisk assistanse">
                description = <"Individet og en eller flere personer bidrar med omtrent like stor fysisk innsats for å fullføre aktiviteten.">
            >
            ["at0016"] = <
                text = <"Maksimal fysisk assistanse">
                description = <"*The individual contributes a small part of the physical effort and one or more people provide the rest. Sometimes known as 'Maximal' assistance. (en)">
            >
            ["at0017"] = <
                text = <"Total fysisk assistanse">
                description = <"*The individual is not able to contribute any effort and is dependent on one or more people to provide all the physical effort. (en)">
            >
            ["at0018"] = <
                text = <"Antall personer">
                description = <"Antall personer som er nødvendig for å yte menneskelig assistanse ved utførelse av aktiviteten.">
                comment = <"Antall personer som er nødvendig kan variere avhengig av miljømessige forhold eller samtidig bruk av hjelpemidler.">
            >
            ["at0019"] = <
                text = <"Detaljer om støtteperson">
                description = <"Strukturerte detaljer om en eller flere spesifikke personer eller roller som er nødvendige for å yte assistanse ved utførelse av aktiviteten.">
                comment = <"Dette kan omfatte en navngitt person, en relasjon eller en definert rolle, slik som partner, familiemedlem, omsorgsperson, terapeut eller støtteperson.">
            >
            ["at0020"] = <
                text = <"Detaljer om hjelpemiddel">
                description = <"Strukturerte detaljer om ett eller flere verktøy, hjelpemidler eller teknologier som er nødvendige for å sette individet i stand til eller hjelpe et individ med å utføre aktiviteten.">
                comment = <"For eksempel: smarttelefonpåminnelser, tilpasset spisebestikk, lesebriller, høreapparater, mobilitetshjelpemidler, proteser, hjelpemidler til egenomsorg, kommunikasjonshjelpemidler eller et servicedyr.">
            >
            ["at0021"] = <
                text = <"Ytterligere detaljer">
                description = <"Ytterligere strukturerte detaljer om de funksjonelle støttebehovene for en aktivitet.">
            >
            ["at0022"] = <
                text = <"Kommentar">
                description = <"Ytterligere fritekst om de funksjonelle støttebehovene for en aktivitet som ikke er fanget opp i andre felt.">
            >
            ["at0023"] = <
                text = <"Sist oppdatert">
                description = <"Datoen da disse funksjonelle støttebehovene sist ble oppdatert.">
            >
            ["at0024"] = <
                text = <"Tilleggsinformasjon">
                description = <"Ytterligere informasjon som trengs for å kunne registrere lokalt definert innhold eller for å tilpasse til andre referansemodeller eller formalismer.">
                comment = <"For eksempel lokale informasjonsbehov eller ytterligere metadata for å kunne tilpasse til tilsvarende konsepter i FHIR.">
            >
            ["at0025"] = <
                text = <"Beskrivelse av hjelpemidler">
                description = <"Fritekstbeskrivelse av verktøy, hjelpemidler eller teknologier som er nødvendige for å sette individet i stand til eller hjelpe individet med å utføre aktiviteten.">
                comment = <"For eksempel: smarttelefonpåminnelser, tilpasset spisebestikk, lesebriller, høreapparater, mobilitetshjelpemidler, proteser, hjelpemidler til egenomsorg, kommunikasjonshjelpemidler eller et servicedyr.">
            >
            ["ac9000"] = <
                text = <"Type assistanse (synthesised)">
                description = <"Typen menneskelig assistanse som er nødvendig for å sette individet i stand til eller hjelpe individet med å utføre aktiviteten. (synthesised)">
            >
            ["ac9001"] = <
                text = <"Type fysisk assistanse (synthesised)">
                description = <"Intensiteten av menneskelig assistanse som er nødvendig fra en eller flere personer for å støtte trygg eller effektiv utførelse av en aktivitet. (synthesised)">
            >
        >
        ["en"] = <
            ["at0000"] = <
                text = <"Functional support requirements">
                description = <"Summary information about the supports needed to enable or assist an individual to perform an activity.">
                comment = <"Throughout this archetype, the phrase \"perform an activity\", or similar, refers to carrying out a single activity or a grouping of related activities, or participating in an everyday life situation. The term \"assistive device\" refers to any tool, aid, or technology used by an individual to support, maintain, or optimise performance of an activity, including digital technologies and medical devices.">
            >
            ["at0002"] = <
                text = <"Activity name">
                description = <"The name of the activity for which support is required.">
                comment = <"Coding with an external terminology is recommended. For example: rolling over in bed, transferring from bed to chair, walking; climbing stairs; brushing teeth, putting on shoes, menstrual care; reading, speaking, writing; preparing meals, doing housework; using public transport, seeking a job, withdrawing money from an ATM; attending school, playing sport, joining a club, attending the theatre. Free text entry should only be permitted where no appropriate coded value is available.">
            >
            ["at0003"] = <
                text = <"Support description">
                description = <"Narrative description of all supports needed to perform the activity.">
                comment = <"Supports may include human assistance, assistive devices, assistance animals, and environmental conditions.">
            >
            ["at0005"] = <
                text = <"Assistance type">
                description = <"The type of human assistance needed to enable or assist the individual to perform the activity safely or effectively.">
                comment = <"More than one 'Assistance type' may be recorded. \"No assistance\" may be recorded where only supports other than human assistance are needed, or where human assistance is no longer needed.">
            >
            ["at0006"] = <
                text = <"No assistance">
                description = <"No assistance from other people is needed.">
            >
            ["at0007"] = <
                text = <"Supervision">
                description = <"Observation from a distance by one or more people.">
            >
            ["at0008"] = <
                text = <"Task preparation">
                description = <"Set-up of the environment or equipment by one or more people.">
            >
            ["at0009"] = <
                text = <"Cognitive support">
                description = <"Guidance from one or more people on how to plan or approach the activity, or cues during the activity.">
            >
            ["at0010"] = <
                text = <"Physical assistance">
                description = <"Physical proximity or hands-on assistance from one or more people.">
            >
            ["at0011"] = <
                text = <"Physical assistance level">
                description = <"The degree of physical involvement needed from one or more people to enable or assist the individual to perform the activity safely or effectively.">
                comment = <"Record only where 'Assistance type' includes \"Physical assistance\". Physical assistance may relate to safety, balance, coordination, strength, or motor execution. The levels are informed by, but deliberately not aligned with, the Functional Independence Measure (FIM). They add standby and contact guarding. Each level is described in plain language rather than by proportion of effort. Where FIM or another scale is required, its values may be used in place of the local value set in a template.">
            >
            ["at0012"] = <
                text = <"Standby assistance (guarding)">
                description = <"The individual performs the whole activity without physical contact while one or more people remain within arm's reach, ready to provide immediate physical assistance.">
            >
            ["at0013"] = <
                text = <"Light physical contact (contact guarding)">
                description = <"The individual performs the whole activity while one or more people maintain light physical contact to provide immediate support.">
            >
            ["at0014"] = <
                text = <"Minimal physical assistance">
                description = <"The individual performs most of the activity while one or more people provide a small amount of physical effort.">
            >
            ["at0015"] = <
                text = <"Moderate physical assistance">
                description = <"The individual and one or more people contribute approximately equal physical effort.">
            >
            ["at0016"] = <
                text = <"Extensive physical assistance">
                description = <"The individual contributes a small part of the physical effort and one or more people provide the rest. Sometimes known as 'Maximal' assistance.">
            >
            ["at0017"] = <
                text = <"Total physical assistance">
                description = <"The individual is not able to contribute any effort and is dependent on one or more people to provide all the physical effort.">
            >
            ["at0018"] = <
                text = <"Number of people">
                description = <"The number of people needed to provide human assistance for the individual to perform the activity safely or effectively.">
                comment = <"The number of people needed may vary with environmental conditions or the use of assistive devices.">
            >
            ["at0019"] = <
                text = <"Support person details">
                description = <"Structured details of one or more specific people who must provide the assistance.">
                comment = <"Use only where the assistance must be provided by a particular person or role, for example: shopping only with their mother, or support from a familiar support worker. This may be a named individual, a relationship, such as partner or family member, or a defined role, such as carer, therapist, or support worker.">
            >
            ["at0020"] = <
                text = <"Assistive device details">
                description = <"Structured detail about one or more assistive devices needed to perform the activity.">
                comment = <"For example: smartphone reminders, modified cutlery, reading glasses, hearing aids, mobility aids, prostheses, self-care aids, or communication aids.">
            >
            ["at0021"] = <
                text = <"Additional details">
                description = <"Additional structured detail about the functional support requirements for an activity.">
            >
            ["at0022"] = <
                text = <"Comment">
                description = <"Additional narrative about the functional support requirements for an activity not captured in other fields.">
                comment = <"For example: variation in support requirements with circumstances, such as fatigue, pain, or time of day.">
            >
            ["at0023"] = <
                text = <"Last updated">
                description = <"The date when these functional support requirements were last updated.">
            >
            ["at0024"] = <
                text = <"Extension">
                description = <"Additional information required to extend the model with local content or to align with other reference models or formalisms.">
                comment = <"For example: local information requirements; or additional metadata to align with FHIR.">
            >
            ["at0025"] = <
                text = <"Assistive devices description">
                description = <"Narrative description of the assistive devices needed to perform the activity.">
                comment = <"For example: smartphone reminders, modified cutlery, reading glasses, hearing aids, mobility aids, prostheses, self-care aids, or communication aids.">
            >
            ["ac9000"] = <
                text = <"Assistance type (synthesised)">
                description = <"The type of human assistance needed to enable or assist the individual to perform the activity safely or effectively. (synthesised)">
            >
            ["ac9001"] = <
                text = <"Physical assistance level (synthesised)">
                description = <"The degree of physical involvement needed from one or more people to enable or assist the individual to perform the activity safely or effectively. (synthesised)">
            >
        >
    >
    value_sets = <
        ["ac9001"] = <
            id = <"ac9001">
            members = <"at0012", "at0013", "at0014", "at0015", "at0016", "at0017">
        >
        ["ac9000"] = <
            id = <"ac9000">
            members = <"at0006", "at0007", "at0008", "at0009", "at0010">
        >
    >
