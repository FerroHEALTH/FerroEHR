    references = <
        ["1"] = <"Hand dominance, Draft archetype [Internet]. openEHR Foundation, openEHR Clinical Knowledge Manager [cited: 2026-07-07]. Available from: https://ckm.openehr.org/ckm/archetypes/1013.1.8191">
        ["2"] = <"Papadatou-Pastou M, Ntolka E, Schmitz J, Martin M, Munafò MR, Ocklenburg S, Paracchini S. Human handedness: A meta-analysis. Psychol Bull. 2020 Jun;146(6):481-524. doi:10.1037/bul0000229. Epub 2020 Apr 2. PMID: 32237881.">
        ["3"] = <"Oldfield RC. The assessment and analysis of handedness: the Edinburgh inventory. Neuropsychologia. 1971 Mar;9(1):97-113. doi:10.1016/0028-3932(71)90067-4. PMID: 5146491.">
    >
    other_details = <
        ["MD5-CAM-1.0.1"] = <"035DD003A758205E1EF942C81203EDBA">
    >
    details = <
        ["nb"] = <
            language = <[ISO_639-1::nb]>
            purpose = <"For å registrere et individs foretrukne hånd for å gjøre ulike motoriske handlinger.">
            keywords = <"Høyrehendt, venstrehendt, keivhendt, lateralitet", ...>
            use = <"Brukes for å registrere et individs foretrukne hånd for å gjøre ulike motoriske handlinger.">
            misuse = <"Brukes ikke for å registrere andre aspekter av menneskelig lateralitet, som dominant fot, øye eller øre. En separat arketype er ment for dette bruket, men var ikke tilgjengelig ved publiseringen.">
        >
        ["en"] = <
            language = <[ISO_639-1::en]>
            purpose = <"To record an individual's natural preference for using a specific hand for various motor tasks.">
            keywords = <"handedness, right handed, left handed, laterality", ...>
            use = <"Use to record an individual's natural preference for using a specific hand for various motor tasks.">
            misuse = <"Not to be used to record other aspects of human laterality, such as dominant foot, eye or ear. A separate archetype is intended for this use case but was not available at the time of authoring or publication.">
            copyright = <"© openEHR Foundation">
        >
    >

definition
    EVALUATION[at0000] matches {    -- Hand dominance
        data matches {
            ITEM_TREE[at0001] matches {
                items cardinality matches {0..*; unordered} matches {
                    ELEMENT[at0002] occurrences matches {0..1} matches {    -- Dominant hand
                        value matches {
                            DV_CODED_TEXT[at9001] matches {
                                defining_code matches {[ac9000]}    -- Dominant hand (synthesised)
                            }
                            DV_TEXT[at9002]
                        }
                    }
                    ELEMENT[at0013] occurrences matches {0..1} matches {    -- Comment
                        value matches {
                            DV_TEXT[at9003]
                        }
                    }
                }
            }
        }
        protocol matches {
            ITEM_TREE[at0014] matches {
                items cardinality matches {0..*; unordered} matches {
                    ELEMENT[at0016] occurrences matches {0..1} matches {    -- Assessment method
                        value matches {
                            DV_TEXT[at9004]
                        }
                    }
                    ELEMENT[at0023] occurrences matches {0..1} matches {    -- Last updated
                        value matches {
                            DV_DATE_TIME[at9005]
                        }
                    }
                    allow_archetype CLUSTER[at0015] matches {    -- Extension
                        include
                            archetype_id/value matches {/.*/}
                    }
                }
            }
        }
    }

terminology
    term_definitions = <
        ["nb"] = <
            ["at0000"] = <
                text = <"Hånddominans">
                description = <"Hånddominans er et individs naturlige preferanse for å bruke en bestemt hånd for å gjennomføre ulike motoriske handlinger.">
            >
            ["at0002"] = <
                text = <"Dominant hånd">
                description = <"Hvilken hånd individet vanligvis bruker for vanlige oppgaver.">
            >
            ["at0003"] = <
                text = <"Høyrehendt">
                description = <"Individet bruker hovedsakelig sin høyre hånd.">
            >
            ["at0004"] = <
                text = <"Venstrehendt">
                description = <"Individet bruker hovedsakelig sin venstre hånd.">
            >
            ["at0005"] = <
                text = <"Ambidekster">
                description = <"Individet bruker bruker begge hender like mye. Også kalt kapphendt eller tvehendt.">
            >
            ["at0006"] = <
                text = <"Kryssdominant">
                description = <"Individet bruker ulike hender avhengig av oppgaven, som f.eks. skriver med høyre hånd, og bruker hammer med venstre.">
            >
            ["at0013"] = <
                text = <"Kommentar">
                description = <"Ytterligere fritekst om hånddominans som ikke er omfattet i andre felter.">
            >
            ["at0015"] = <
                text = <"Tilleggsinformasjon">
                description = <"Ytterligere informasjon som trengs for å kunne registrere lokalt definert innhold eller for å tilpasse til andre referansemodeller/formalismer.">
                comment = <"For eksempel lokale informasjonsbehov eller ytterligere metadata for å kunne tilpasse til tilsvarende konsepter i FHIR.">
            >
            ["at0016"] = <
                text = <"Vurderingsmetode">
                description = <"Hvilken metode som ble brukt for å fastslå individets hånddominans.">
                comment = <"For eksempel, Edinburgh Handedness Inventory.">
            >
            ["at0023"] = <
                text = <"Sist oppdatert">
                description = <"Datoen da hånddominans sist ble oppdatert.">
            >
            ["ac9000"] = <
                text = <"Dominant hånd (synthesised)">
                description = <"Hvilken hånd individet vanligvis bruker for vanlige oppgaver. (synthesised)">
            >
        >
        ["en"] = <
            ["at0000"] = <
                text = <"Hand dominance">
                description = <"Hand dominance is an individual's natural preference for a specific hand for performing various motor tasks.">
            >
            ["at0002"] = <
                text = <"Dominant hand">
                description = <"Which hand the individual typically uses for common tasks.">
            >
            ["at0003"] = <
                text = <"Right-handed">
                description = <"The individual primarily uses their right hand.">
            >
            ["at0004"] = <
                text = <"Left-handed">
                description = <"The individual primarily uses their left hand.">
            >
            ["at0005"] = <
                text = <"Ambidextrous">
                description = <"The individual uses both hands equally.">
            >
            ["at0006"] = <
                text = <"Mixed-handed">
                description = <"The individual prefers different hands for different tasks, such as writing with the right hand and using a hammer with the left.">
            >
            ["at0013"] = <
                text = <"Comment">
                description = <"Additional narrative about the dominant hand, not captured in other fields.">
            >
            ["at0015"] = <
                text = <"Extension">
                description = <"Additional information required to capture local context or to align with other reference models/formalisms.">
                comment = <"For example, local information requirements; or additional metadata to align with FHIR.">
            >
            ["at0016"] = <
                text = <"Assessment method">
                description = <"The method used to acertain the individual's handedness.">
                comment = <"For example, Edinburgh Handedness Inventory.">
            >
            ["at0023"] = <
                text = <"Last updated">
                description = <"The date when the dominant hand was last updated.">
            >
            ["ac9000"] = <
                text = <"Dominant hand (synthesised)">
                description = <"Which hand the individual typically uses for common tasks. (synthesised)">
            >
        >
    >
    value_sets = <
        ["ac9000"] = <
            id = <"ac9000">
            members = <"at0003", "at0004", "at0005", "at0006">
        >
    >
