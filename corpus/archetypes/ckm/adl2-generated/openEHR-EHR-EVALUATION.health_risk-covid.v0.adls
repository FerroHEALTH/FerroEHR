        ["it"] = <
            ["at0000.1"] = <
                text = <"Valutazione rischio infezione da COVID-19">
                description = <"Valutazione del rischio potenziale e della probabilità di infezione da COVID-19 e di futuri effetti indesiderati sulla salute, così come determinato dai fattori di rischio identificati ">
            >
            ["at0002.1"] = <
                text = <"Rischio clinico">
                description = <"Identificazione della potenziale futura malattia, condizione o problema sanitario per il quale si sta valutando il rischio, per nome">
                comment = <"E' preferibile identificare il \"rischio clinico\" tramite una terminologia, ove possibile. Il testo libero dovrebbe essere utilizzato esclusivamente nei casi in cui non fosse disponibile una terminologia appropriata. Per esempio: rischio di malattie cardiovascolari, con fattori di rischio di ipertensione ed ipercolesterolemia. ">
            >
            ["at0.1"] = <
                text = <"Valutazione rischio COVID-19">
                description = <"Valutazione rischio infezione da COVID-19">
            >
            ["at0013.1"] = <
                text = <"Fattore di rischio">
                description = <"Identificazione del fattore di rischio, per nome ">
                comment = <"Per esempio: ipertensione ed ipercolesterolemia, che possono essere usate come parte della valutazione globale per le malattie cardiovascolari; oppure un marker genetico. Codificare, ove possibile, il \"Fattore di rischio\" tramite l'utilizzo di una terminologia.">
            >
            ["at0.9"] = <
                text = <"Contatto con un caso confermato di COVID-19">
