archetype (adl_version=2.4.0; rm_release=1.1.0; generated; uid=0ab9c19f-6a9e-4d30-982a-ce280ad447b9; build_uid=eeee9931-c5ce-47bc-8970-98a1610e8370)
    openEHR-EHR-EVALUATION.infectious_disease_investigation_classification.v0.0.1-alpha

language
    original_language = <[ISO_639-1::en]>

description
    original_author = <
        ["name"] = <"Heather Leslie">
        ["organisation"] = <"Atomica Informatics">
        ["email"] = <"heather.leslie@atomicainformatics.com">
        ["date"] = <"2022-06-25">
    >
    original_namespace = <"org.openehr">
    original_publisher = <"openEHR Foundation">
