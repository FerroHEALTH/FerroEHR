definition
    EVALUATION[at0000] matches {    -- Medication safety event
        data matches {
            ITEM_TREE[at0001] matches {
                items cardinality matches {0..*; unordered} matches {
                    ELEMENT[at0235] occurrences matches {0..1} matches {    -- Main event for case?
                        value matches {
                            DV_BOOLEAN[at9010] matches {
                                value matches {True}
                            }
                        }
                    }
                    ELEMENT[at0002] occurrences matches {0..1} matches {    -- Safety event type
                        value matches {
                            DV_CODED_TEXT[at9011] matches {
                                defining_code matches {[ac10]}    -- New constraint
                            }
                        }
                    }
                    ELEMENT[at0003] occurrences matches {0..1} matches {    -- MEDRA classification
                        value matches {
                            DV_CODED_TEXT[at9012] matches {
                                defining_code matches {[ac2]}    -- *New constraint(sl)
                            }
                        }
                    }
                    ELEMENT[at0004] occurrences matches {0..1} matches {    -- DateTime of event onset
                        value matches {
                            DV_DATE_TIME[at9013]
                        }
                    }
                    ELEMENT[at0041] occurrences matches {0..1} matches {    -- Description of event
                        value matches {
                            DV_TEXT[at9014]
                        }
                    }
                    CLUSTER[at0233] matches {    -- Cause of event
                        items cardinality matches {1..*; unordered} matches {
                            ELEMENT[at0062] occurrences matches {0..1} matches {    -- Estimated cause of event
                                value matches {
                                    DV_CODED_TEXT[at9015] matches {
                                        defining_code matches {[ac9000]}    -- Estimated cause of event (synthesised)
                                    }
                                }
                            }
                            ELEMENT[at0234] occurrences matches {0..1} matches {    -- Comment
                                value matches {
                                    DV_TEXT[at9016]
                                }
                            }
                        }
                    }
                    ELEMENT[at0020] occurrences matches {0..1} matches {    -- Related trigger
                        value matches {
                            DV_CODED_TEXT[at9017] matches {
                                defining_code matches {[ac9001]}    -- Related trigger (synthesised)
                            }
                            DV_TEXT[at9018]
                        }
                    }
                    CLUSTER[at0018] matches {    -- Adverse effect
                        items cardinality matches {1..*; unordered} matches {
                            CLUSTER[at0345] matches {    -- Reaction details
                                items cardinality matches {1..*; unordered} matches {
                                    ELEMENT[at0021] occurrences matches {0..1} matches {    -- Reaction
                                        value matches {
                                            DV_CODED_TEXT[at9019] matches {
                                                defining_code matches {[ac4]}    -- *New constraint(sl)
                                            }
                                        }
                                    }
                                    ELEMENT[at0346] occurrences matches {0..1} matches {    -- Comment
                                        value matches {
                                            DV_TEXT[at9020]
                                        }
                                    }
                                }
                            }
                            ELEMENT[at0108] occurrences matches {0..1} matches {    -- DateTime of reaction onset
                                value matches {
                                    DV_DATE_TIME[at9021]
                                }
                            }
                            ELEMENT[at0222] occurrences matches {0..1} matches {    -- Severity
                                value matches {
                                    DV_CODED_TEXT[at9022] matches {
                                        defining_code matches {[ac9002]}    -- Severity (synthesised)
                                    }
                                }
                            }
                            ELEMENT[at0022] occurrences matches {0..1} matches {    -- Liklihood of causation
                                value matches {
                                    DV_CODED_TEXT[at9023] matches {
                                        defining_code matches {[ac9002]}    -- Severity (synthesised)
                                    }
                                }
                            }
                            CLUSTER[at0236] matches {    -- Intervention details
                                items cardinality matches {1..*; unordered} matches {
                                    CLUSTER[at0347] matches {    -- Intervention additional details
                                        items cardinality matches {1..*; unordered} matches {
                                            ELEMENT[at0012] occurrences matches {0..1} matches {    -- Intervention
                                                value matches {
                                                    DV_CODED_TEXT[at9024] matches {
                                                        defining_code matches {[ac9003]}    -- Intervention (synthesised)
                                                    }
                                                }
                                            }
                                            ELEMENT[at0348] occurrences matches {0..1} matches {    -- Comment
                                                value matches {
                                                    DV_TEXT[at9025]
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0014] matches {    -- Intervention result
                                        value matches {
                                            DV_CODED_TEXT[at9026] matches {
                                                defining_code matches {[ac9004]}    -- Intervention result (synthesised)
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    ELEMENT[at0353] occurrences matches {0..1} matches {    -- Side effect recurrence
                        value matches {
                            DV_CODED_TEXT[at9027] matches {
                                defining_code matches {[ac9005]}    -- Side effect recurrence (synthesised)
                            }
                        }
                    }
                    CLUSTER[at0349] matches {    -- Actual patient outcome details
                        items cardinality matches {1..*; unordered} matches {
                            ELEMENT[at0042] occurrences matches {0..1} matches {    -- Actual patient outcome
                                value matches {
                                    DV_CODED_TEXT[at9028] matches {
                                        defining_code matches {[ac9006]}    -- Actual patient outcome (synthesised)
                                    }
                                }
                            }
                            ELEMENT[at0350] occurrences matches {0..1} matches {    -- Comment
                                value matches {
                                    DV_TEXT[at9029]
                                }
                            }
                        }
                    }
                    ELEMENT[at0231] occurrences matches {0..1} matches {    -- Potential patient outcome
                        value matches {
                            DV_CODED_TEXT[at9030] matches {
                                defining_code matches {[ac9006]}    -- Actual patient outcome (synthesised)
                            }
                        }
                    }
                    ELEMENT[at0043] matches {    -- Patient outcome category
                        value matches {
                            DV_CODED_TEXT[at9031] matches {
                                defining_code matches {[ac9007]}    -- Patient outcome category (synthesised)
                            }
                        }
                    }
                    ELEMENT[at0232] occurrences matches {0..1} matches {    -- Additional comment
                        value matches {
                            DV_TEXT[at9032]
                        }
                    }
                    CLUSTER[at0237] occurrences matches {0..1} matches {    -- Summary details
                        items cardinality matches {1..*; unordered} matches {
                            ELEMENT[at0238] occurrences matches {0..1} matches {    -- Admission diagnosis classification
                                value matches {
                                    DV_CODED_TEXT[at9033] matches {
                                        defining_code matches {[ac7]}    -- *New constraint(sl)
                                    }
                                }
                            }
                            ELEMENT[at0239] occurrences matches {0..1} matches {    -- Discharge diagnosis classification
                                value matches {
                                    DV_CODED_TEXT[at9034] matches {
                                        defining_code matches {[ac8]}    -- *New constraint(sl)
                                    }
                                }
                            }
                            ELEMENT[at0249] occurrences matches {0..1} matches {    -- Link to main event
                                value matches {
                                    DV_EHR_URI[at9035]
                                }
                            }
                            CLUSTER[at0241] occurrences matches {0..1} matches {    -- Oncological case details
                                items cardinality matches {1..*; unordered} matches {
                                    ELEMENT[at0240] occurrences matches {0..1} matches {    -- TNM classification
                                        value matches {
                                            DV_CODED_TEXT[at9036] matches {
                                                defining_code matches {[ac9]}    -- *New constraint(sl)
                                            }
                                        }
                                    }
                                    ELEMENT[at0244] occurrences matches {0..1} matches {    -- Effectiveness of therapy
                                        value matches {
                                            DV_CODED_TEXT[at9037] matches {
                                                defining_code matches {[ac9008]}    -- Effectiveness of therapy (synthesised)
                                            }
                                        }
                                    }
                                    ELEMENT[at0242] occurrences matches {0..1} matches {    -- Order of treatment
                                        value matches {
                                            DV_TEXT[at9038]
                                        }
                                    }
                                    ELEMENT[at0243] occurrences matches {0..1} matches {    -- Reason for case closure
                                        value matches {
                                            DV_CODED_TEXT[at9039] matches {
                                                defining_code matches {[ac9009]}    -- Reason for case closure (synthesised)
                                            }
                                        }
                                    }
                                    ELEMENT[at0268] occurrences matches {0..1} matches {    -- Reason treatment aborted
                                        value matches {
                                            DV_TEXT[at9040]
                                        }
                                    }
                                }
                            }
                        }
                    }
                    ELEMENT[at0351] matches {    -- Medications involved
                        value matches {
                            DV_TEXT[at9041]
                        }
                    }
                    ELEMENT[at0352] matches {    -- Medications administered
                        value matches {
                            DV_TEXT[at9042]
                        }
                    }
                }
            }
        }
    }

