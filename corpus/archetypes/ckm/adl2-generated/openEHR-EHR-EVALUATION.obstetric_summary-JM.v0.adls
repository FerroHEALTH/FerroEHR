        ["1"] = <"Born Too Soon: The Global Action Report on Preterm Birth [Internet]. Geneva: World Health Organization; 2012. Available from: https://www.who.int/maternal_child_adolescent/documents/born_too_soon/en/.">
        ["2"] = <"Derived from: Obstetric summary, draft archetype [Internet]. Australian Digital Health Agency (NEHTA), ADHA Clinical Knowledge Manager. No longer available.">
        ["3"] = <"Fact sheet: Preterm birth [Internet]. Geneva: World Health Organisation. Preterm birth; 2018 Feb 19 [cited 2020 May 07]. Available from: https://www.who.int/news-room/fact-sheets/detail/preterm-birth.">
        ["4"] = <"Opara EI, Zaidi J. The interpretation and clinical application of the word 'parity': a survey [Internet]. BJOG. 2007 Oct;114(10):1295-7. doi: 10.1111/j.1471-0528.2007.01435.x. PMID: 17877683. Available from: https://obgyn.onlinelibrary.wiley.com/doi/full/10.1111/j.1471-0528.2007.01435.x.">
