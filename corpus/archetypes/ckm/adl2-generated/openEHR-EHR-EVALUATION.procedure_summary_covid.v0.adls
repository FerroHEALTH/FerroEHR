definition
    EVALUATION[at0000] matches {    -- COVID - procedure summary
        data matches {
            ITEM_TREE[at0003] matches {
                items cardinality matches {0..*; unordered} matches {
                    CLUSTER[at0012] matches {    -- Procedure
                        items cardinality matches {1..*; unordered} matches {
                            ELEMENT[at0020] occurrences matches {0..1} matches {    -- Procedure name
                                value matches {
                                    DV_CODED_TEXT[at9003] matches {
                                        defining_code matches {[ac9000]}    -- Procedure name (synthesised)
                                    }
                                    DV_TEXT[at9004]
                                }
                            }
                            ELEMENT[at0004] occurrences matches {0..1} matches {    -- Status
                                value matches {
                                    DV_CODED_TEXT[at9005] matches {
                                        defining_code matches {[ac9001]}    -- Status (synthesised)
                                    }
                                }
                            }
                            ELEMENT[at0043] occurrences matches {0..1} matches {    -- Procedure date
                                value matches {
                                    DV_DATE_TIME[at9006]
                                }
                            }
                        }
                    }
                }
            }
        }
        protocol matches {
            ITEM_TREE[at0001] matches {
                items cardinality matches {0..*; unordered} matches {
                    ELEMENT[at0047] occurrences matches {0..1} matches {    -- Report phase
                        value matches {
                            DV_CODED_TEXT[at9007] matches {
                                defining_code matches {[ac9002]}    -- Report phase (synthesised)
                            }
                        }
                    }
                    allow_archetype CLUSTER[at0002] matches {    -- Extension
                        include
                            archetype_id/value matches {/.*/}
                    }
                }
            }
        }
    }

