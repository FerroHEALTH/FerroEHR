definition
    EVALUATION[at0000] matches {    -- Transfusion summary
        data matches {
            ITEM_TREE[at0001] matches {
                items cardinality matches {0..*; unordered} matches {
                    ELEMENT[at0002] occurrences matches {0..1} matches {    -- Status
                        value matches {
                            DV_CODED_TEXT[at9001] matches {
                                defining_code matches {[ac9000]}    -- Status (synthesised)
                            }
                        }
                    }
                    CLUSTER[at0005] matches {    -- Transfusion event
                        items cardinality matches {1..*; unordered} matches {
                            ELEMENT[at0006] occurrences matches {0..1} matches {    -- Blood product
                                value matches {
                                    DV_TEXT[at9002]
                                }
                            }
                            ELEMENT[at0007] occurrences matches {0..1} matches {    -- Transfusion date
                                value matches {
                                    DV_DATE_TIME[at9003]
                                }
                            }
                            allow_archetype CLUSTER[at0008] matches {    -- Organisation
                                include
                                    archetype_id/value matches {/.*/}
                            }
                            ELEMENT[at0009] occurrences matches {0..1} matches {    -- Comment
                                value matches {
                                    DV_TEXT[at9004]
                                }
                            }
                        }
                    }
                }
            }
        }
        protocol matches {
            ITEM_TREE[at0010] matches {
                items cardinality matches {0..*; unordered} matches {
                    allow_archetype CLUSTER[at0011] matches {    -- Extension
                        include
                            archetype_id/value matches {/.*/}
                    }
                    ELEMENT[at0012] occurrences matches {0..1} matches {    -- Last updated
                        value matches {
                            DV_DATE_TIME[at9005]
                        }
                    }
                }
            }
        }
    }

