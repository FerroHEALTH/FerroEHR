                text = <"*Substance details(en)">
                description = <"*Additional structured details about the specified type of substance or e-liquid vaped.(en)">
            >
            ["at0079"] = <
                text = <"Definition av har aldrigt vapat">
                description = <"Den tillämpade definitionen för värdet ”Har aldrig vapat” i varje av de ”Status”-dataelement som används i denna arketyp.">
                comment = <"Till exempel kan definitionen innebära att värdet inte är noll, utan mindre än en specificerad mängd (i enheter eller vikt) som röks under ett angivet tidsintervall.">
            >
            ["at0080"] = <
                text = <"*Daily vaping commenced(en)">
                description = <"*The date or partial date when the individual first started daily vaping of any substance.(en)">
                comment = <"Det kan vara del av ett datum, t.ex. bara ett årtal.">
            >
            ["at0081"] = <
                text = <"Episodbeteckning">
                description = <"*Identification of an episode of vaping activity - either as a number in a sequence and/or a named event.(en)">
                comment = <"*For example: '2' as the second episode within a sequence of episodes; or 'Pregnancy with twins' if describing the vaping activity during a health event such as during a specific pregnancy.(en)">
            >
            ["at0082"] = <
                text = <"Episodens slutdatum">
                description = <"Datum när den här episoden slutade.">
                comment = <"Kan vara del av ett datum, till exempel bara ett årtal. Det här fältet kommer att vara tomt om epsioden är aktuell och pågående.">
            >
            ["at0083"] = <
