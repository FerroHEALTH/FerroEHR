                text = <"Tilläggsinformation">
                description = <"Plats för att infoga tilläggsinformation som krävs för lokala anpassningar eller anpassning till andra referensmodeller eller formella krav.">
                comment = <"Exempelvis lokala informationskrav eller metadata för anpassning till FHIR- eller CIMI-motsvarigheter.

">
            >
            ["at0075"] = <
                text = <"Definition av nuvarande vaper">
                description = <"Den tillämpade definitionen för värdet ”Nuvarande vaper” i varje av de ”Status”-dataelement som används i denna arketyp.">
                comment = <"Definitionen kan behöva anges för varje typ. Definitionen av ”Nuvarande vaper” kan skilja sig mellan olika regioner och regelverk.">
            >
            ["at0076"] = <
                text = <"Definition av före detta vaper">
                description = <"Den tillämpade definitionen för värdet ”Före detta vaper” i varje av de ”Status”-dataelement som används i denna arketyp.">
                comment = <"Definitionen av ”Före detta vaper” kan skilja sig mellan olika regioner och regelverk.">
