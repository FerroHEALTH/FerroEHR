definition
    EVALUATION[at0000] matches {    -- Vaping summary
        data matches {
            ITEM_TREE[at0001] matches {
                items cardinality matches {0..*; unordered} matches {
                    ELEMENT[at0089] occurrences matches {0..1} matches {    -- Overall status
                        value matches {
                            DV_CODED_TEXT[at9003] matches {
                                defining_code matches {[ac9000]}    -- Overall status (synthesised)
                            }
                        }
                    }
                    ELEMENT[at0043] occurrences matches {0..1} matches {    -- Overall description
                        value matches {
                            DV_TEXT[at9004]
                        }
                    }
                    ELEMENT[at0015] occurrences matches {0..1} matches {    -- Regular vaping commenced
                        value matches {
                            DV_DATE[at9005]
                        }
                    }
                    ELEMENT[at0080] occurrences matches {0..1} matches {    -- Daily vaping commenced
                        value matches {
                            DV_DATE[at9006]
                        }
                    }
                    CLUSTER[at0029] matches {    -- Per substance
                        items cardinality matches {1..*; unordered} matches {
                            ELEMENT[at0095] occurrences matches {1} matches {    -- Substance name
                                value matches {
                                    DV_TEXT[at9007]
                                }
                            }
                            ELEMENT[at0052] occurrences matches {0..1} matches {    -- Status
                                value matches {
                                    DV_CODED_TEXT[at9008] matches {
                                        defining_code matches {[ac9001]}    -- Status (synthesised)
                                    }
                                }
                            }
                            ELEMENT[at0053] occurrences matches {0..1} matches {    -- Description
                                value matches {
                                    DV_TEXT[at9009]
                                }
                            }
                            CLUSTER[at0064] matches {    -- Per episode
                                items cardinality matches {1..*; unordered} matches {
                                    ELEMENT[at0081] occurrences matches {0..1} matches {    -- Episode label
                                        value matches {
                                            DV_COUNT[at9010] matches {
                                                magnitude matches {|>=1|}
                                            }
                                            DV_TEXT[at9011]
                                        }
                                    }
                                    ELEMENT[at0013] occurrences matches {0..1} matches {    -- Episode start date
                                        value matches {
                                            DV_DATE[at9012]
                                        }
                                    }
                                    ELEMENT[at0082] occurrences matches {0..1} matches {    -- Episode end date
                                        value matches {
                                            DV_DATE[at9013]
                                        }
                                    }
                                    ELEMENT[at0030] occurrences matches {0..1} matches {    -- Pattern
                                        value matches {
                                            DV_CODED_TEXT[at9014] matches {
                                                defining_code matches {[ac9002]}    -- Pattern (synthesised)
                                            }
                                            DV_TEXT[at9015]
                                        }
                                    }
                                    ELEMENT[at0023] occurrences matches {0..1} matches {    -- ???Typical use (units)
                                        value matches {
                                            DV_QUANTITY[at9016] matches {
                                                [magnitude, units, precision] matches {
                                                    [{|>=0.0|}, {"1/d"}, {1}],
                                                    [{|>=0.0|}, {"1/wk"}, {1}]
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0025] occurrences matches {0..1} matches {    -- Number of quit attempts
                                        value matches {
                                            DV_COUNT[at9017] matches {
                                                magnitude matches {|>=0|}
                                            }
                                        }
                                    }
                                    allow_archetype CLUSTER[at0026] matches {    -- Episode details
                                        include
                                            archetype_id/value matches {/openEHR-EHR-CLUSTER\.cessation_attempts(-[a-zA-Z0-9_]+)*\.v0\..*/}
                                    }
                                    ELEMENT[at0087] occurrences matches {0..1} matches {    -- Episode comment
                                        value matches {
                                            DV_TEXT[at9018]
                                        }
                                    }
                                }
                            }
                            ELEMENT[at0014] occurrences matches {0..1} matches {    -- Quit date
                                value matches {
                                    DV_DATE[at9019]
                                }
                            }
                            allow_archetype CLUSTER[at0077] matches {    -- Substance details
                                include
                                    archetype_id/value matches {/.*/}
                            }
                            ELEMENT[at0069] occurrences matches {0..1} matches {    -- Comment
                                value matches {
                                    DV_TEXT[at9020]
                                }
                            }
                        }
                    }
                    allow_archetype CLUSTER[at0086]    -- Additional details
                    ELEMENT[at0016] occurrences matches {0..1} matches {    -- Overall quit date
                        value matches {
                            DV_DATE[at9021]
                        }
                    }
                    ELEMENT[at0019] occurrences matches {0..1} matches {    -- Overall comment
                        value matches {
                            DV_TEXT[at9022]
                        }
                    }
                }
            }
        }
        protocol matches {
            ITEM_TREE[at0021] matches {
                items cardinality matches {0..*; unordered} matches {
                    allow_archetype CLUSTER[at0073] matches {    -- Extension
                        include
                            archetype_id/value matches {/.*/}
                    }
                    ELEMENT[at0071] matches {    -- Quit date definition
                        value matches {
                            DV_TEXT[at9023]
                        }
                    }
                    ELEMENT[at0085] occurrences matches {0..1} matches {    -- Quit attempt definition
                        value matches {
                            DV_TEXT[at9024]
                        }
                    }
                    ELEMENT[at0075] matches {    -- Current vpaer definition
                        value matches {
                            DV_TEXT[at9025]
                        }
                    }
                    ELEMENT[at0076] matches {    -- Former vaper definition
                        value matches {
                            DV_TEXT[at9026]
                        }
                    }
                    ELEMENT[at0079] matches {    -- Never vaped definition
                        value matches {
                            DV_TEXT[at9027]
                        }
                    }
                    ELEMENT[at0022] occurrences matches {0..1} matches {    -- Last updated
                        value matches {
                            DV_DATE_TIME[at9028]
                        }
                    }
                }
            }
        }
    }

terminology
    term_definitions = <
        ["de"] = <
            ["at0000"] = <
                text = <"*Vaping summary (en)">
                description = <"*Summary or persistent information about an individual’s use of devices that aerosolise nicotine or other substances for inhalation. (en)">
            >
            ["at0003"] = <
                text = <"*Current vape user (en)">
                description = <"*The individual is a current vape user. (en)">
            >
            ["at0005"] = <
                text = <"*Former vape user (en)">
                description = <"*The individual has previously vaped but is not a current user. (en)">
            >
            ["at0006"] = <
                text = <"*Lifetime non-user (en)">
                description = <"*The Individual has never vaped any type of substance. (en)">
            >
            ["at0013"] = <
                text = <"Startdatum der Episode">
                description = <"Datum, an dem die Episode begann.">
                comment = <"Kann ein Teildatum sein, z.B. nur ein Jahr.">
            >
            ["at0014"] = <
                text = <"Zeitpunkt des Aufhörens">
                description = <"*Date when the individual last vaped the specified substance or e-liquid. (en)">
                comment = <"Kann ein Teildatum sein, z.B. nur ein Jahr. Die Definitionen für ein \"Zeitpunkt des Aufhörens\" sind sehr unterschiedlich und können über das Datenelement \"Definition Zeitpunkts des Aufhörens\" im Abschnitt \"Protokoll\" dieses Archetyps definiert werden. Dieses Datum ist identisch mit dem \"Enddatum der Episode\" der letzten Episode. Dieses Datum könnte von der Entscheidungshilfe genutzt werden, um festzustellen, ob die Person, zum Beispiel in den ersten 12 Monaten nach der Kündigung, einem Rückfallrisiko ausgesetzt ist.

">
            >
            ["at0015"] = <
                text = <"*Regular vaping commenced (en)">
                description = <"*The date or partial date when the individual first started frequent or regular, but usually non-daily, vaping of any substance. (en)">
                comment = <"*Can be a partial date, for example, only a year. For example, this date could represent when the individual commenced vaping every Friday night or at parties.  (en)">
            >
            ["at0016"] = <
                text = <"Zeitpunkt des Aufhörens gesamt">
                description = <"*The date when the individual last ceased vaping of any substance or e-liquid. (en)">
                comment = <"Kann ein Teildatum sein, z.B. nur ein Jahr. Dieses Datum könnte von Entscheidungshilfen genutzt werden, um festzustellen, ob die Person, zum Beispiel in den ersten 12 Monaten nach dem Aufhören, einem Rückfallrisiko ausgesetzt ist.">
            >
            ["at0019"] = <
                text = <"Zusätzliche Anmerkungen">
                description = <"*Additional narrative about all vaping that has not been captured in other fields. (en)">
                comment = <"*For example: stopped vaping or reduced amount on becoming pregnant. (en)">
            >
            ["at0022"] = <
                text = <"Zuletzt aktualisiert">
                description = <"*The date when this vaping summary was last updated. (en)">
            >
            ["at0023"] = <
                text = <"*???Typical use (units) (en)">
                description = <"*Estimate of number of units of the specified type of substance or e-liquid consumed. (en)">
                comment = <"*This data element is redundant if a value is recorded for 'Typical use(mass)'. (en)">
            >
            ["at0025"] = <
                text = <"Anzahl Versuche mit dem Rauchen aufzuhören">
                description = <"*Total number of times the individual has attempted to stop vaping the specified substance or e-liquid within this episode. (en)">
            >
            ["at0026"] = <
                text = <"Details der Episode">
                description = <"*Additional structured details about the specified episode of vaping. (en)">
            >
            ["at0029"] = <
                text = <"*Per substance (en)">
                description = <"*Details about smoking activity for a specified type of substance or e-liquid. (en)">
            >
            ["at0030"] = <
                text = <"Rauchmuster">
                description = <"*The typical pattern of vaping for the specified substance or e-liquid. (en)">
            >
            ["at0043"] = <
                text = <"Allgemeine Beschreibung">
                description = <"*Narrative description about the individual’s overall vaping pattern and history. (en)">
                comment = <"*Use this data element to record a narrative description of the vaping habits for this individual or to incorporate unstructured vaping information from existing or legacy clinical systems. (en)">
            >
            ["at0052"] = <
                text = <"Status">
                description = <"*Statement about current vaping behaviour for the specified substance or e-liquid. (en)">
            >
            ["at0053"] = <
                text = <"Beschreibung">
                description = <"*Narrative summary about vaping behaviour for the specified substance or e-liquid. (en)">
            >
            ["at0059"] = <
                text = <"*Former vaper(en)">
                description = <"*Die Person hat früher die angegebene Tabakart geraucht, ist jedoch derzeit kein Raucher.">
            >
            ["at0061"] = <
                text = <"*Current vaper(en)">
                description = <"*Die Person ist derzeitiger Raucher der angegebenen Tabakart.">
            >
            ["at0064"] = <
                text = <"Pro Episode">
                description = <"Angaben zu einem bestimmten Zeitraum des Rauchens der angegebenen Tabakart.">
            >
            ["at0069"] = <
                text = <"Kommentar">
                description = <"*Additional narrative about vaping of the specified substance or e-liquid, not captured in other fields. (en)">
            >
            ["at0071"] = <
                text = <"Definition Zeitpunkts des Aufhörens">
                description = <"Die angewendete Definition für das Datenelement \"Zeitpunkt des Aufhörens\" das in diesem Archetyp verwendet wird.">
            >
            ["at0073"] = <
                text = <"Erweiterung">
                description = <"Zusätzliche Informationen zur Erfassung lokaler Inhalte oder Anpassung an andere Referenzmodelle/Formalismen.">
                comment = <"Zum Beispiel: Lokaler Informationsbedarf oder zusätzliche Metadaten zur Anpassung an FHIR-Ressourcen oder CIMI-Modelle.">
            >
            ["at0075"] = <
                text = <"*Current vpaer definition(en)">
                description = <"*The applied definition for the 'Current vaper' value in each of the 'Status' data elements used in this archetype.">
                comment = <"*Definition may need to be specified per type. Current vaper definitions vary in different jurisdictions. 
 (en)">
            >
            ["at0076"] = <
                text = <"*Former vaper definition(en)">
                description = <"*The applied definition for the 'Former vaper' value in each of the 'Status' data elements used in this archetype.">
                comment = <"*Former vaper definitions vary in different jurisdictions. (en)">
            >
            ["at0077"] = <
                text = <"*Substance details (en)">
                description = <"*Additional structured details about the specified type of substance or e-liquid vaped. (en)">
            >
            ["at0079"] = <
                text = <"*Never vaped definition(en)">
                description = <"*The applied definition for the 'Never vaped' value in each of the 'Status' data elements used in this archetype.">
                comment = <"*For example, the definition may not be zero, but less than a specified amount (as units or mass) smoked during a specified time interval. (en)">
            >
            ["at0080"] = <
                text = <"*Daily vaping commenced (en)">
                description = <"*The date or partial date when the individual first started daily vaping of any substance. (en)">
                comment = <"Kann ein Teildatum sein, z.B. nur ein Jahr.">
            >
            ["at0081"] = <
                text = <"Episodenlabel">
                description = <"*Identification of an episode of vaping activity - either as a number in a sequence and/or a named event. (en)">
                comment = <"*For example: '2' as the second episode within a sequence of episodes; or 'Pregnancy with twins' if describing the vaping activity during a health event such as during a specific pregnancy. (en)">
            >
            ["at0082"] = <
                text = <"Enddatum der Episode">
                description = <"Datum, an dem die Episode endet.">
                comment = <"Kann ein Teildatum sein, z.B. nur ein Jahr. Das Datenelement ist leer, wenn die Episode aktuell und noch nicht beendet ist.">
            >
            ["at0083"] = <
                text = <"Täglich">
                description = <"Die angegebene Tabakart wird mindestens einmal täglich geraucht.">
            >
            ["at0084"] = <
                text = <"Nicht täglich">
                description = <"Die angegebene Tabakart wird nicht jeden Tag geraucht.">
            >
            ["at0085"] = <
                text = <"Defintion Versuch des Aufhörens">
                description = <"Die angewendete Definition für einen Versuch mit dem Rauchen aufzuhören. Dient zur Bestimmung des Wertes für das in diesem Archetyp verwendete Datenelement \"Anzahl Versuche mit dem Rauchen aufzuhören\".">
                comment = <"*For example: 'stopped vaping for one day or longer with the intention of quitting'. (en)">
            >
            ["at0086"] = <
                text = <"*Additional details (en)">
                description = <"*Additional structured details about the overall vaping behaviour. (en)">
            >
            ["at0087"] = <
                text = <"Kommentar zur Episode">
                description = <"*Additional narrative about vaping during the specified episode, not captured in other fields. (en)">
            >
            ["at0089"] = <
                text = <"Allgemeiner Status">
