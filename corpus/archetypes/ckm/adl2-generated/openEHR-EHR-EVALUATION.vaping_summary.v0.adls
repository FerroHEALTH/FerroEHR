        ["en"] = <
            ["at0000"] = <
                text = <"Vaping summary">
                description = <"Summary or persistent information about an individual’s use of devices that aerosolise nicotine or other substances for inhalation.">
            >
            ["at0003"] = <
                text = <"Current vape user">
                description = <"The individual is a current vape user.">
            >
            ["at0005"] = <
                text = <"Former vape user">
                description = <"The individual has previously vaped but is not a current user.">
            >
            ["at0006"] = <
                text = <"Lifetime non-user">
                description = <"The Individual has never vaped any type of substance.">
            >
            ["at0013"] = <
                text = <"Episode start date">
                description = <"Date when this episode commenced.">
                comment = <"Can be a partial date, for example, only a year.">
            >
            ["at0014"] = <
                text = <"Quit date">
                description = <"Date when the individual last vaped the specified substance or e-liquid.">
                comment = <"Can be a partial date, for example, only a year. Definitions for a 'Quit date' vary enormously and can be defined using the 'Quit data definition' data element in the Protocol section of this archetype. This date will be identical to the 'Episode end date' for the most recent episode. This date could be used by decision support guidance to determine if the  individual is at risk of relapse, for example in the first 12 months since quitting.">
            >
            ["at0015"] = <
                text = <"Regular vaping commenced">
                description = <"The date or partial date when the individual first started frequent or regular, but usually non-daily, vaping of any substance.">
                comment = <"Can be a partial date, for example, only a year. For example, this date could represent when the individual commenced vaping every Friday night or at parties. ">
            >
            ["at0016"] = <
                text = <"Overall quit date">
                description = <"The date when the individual last ceased vaping of any substance or e-liquid.">
                comment = <"Can be a partial date, for example, only a year. This date could be used by decision support guidance to determine if the  individual is at risk of relapse, for example in the first 12 months since quitting.">
            >
            ["at0019"] = <
                text = <"Overall comment">
                description = <"Additional narrative about all vaping that has not been captured in other fields.">
                comment = <"For example: stopped vaping or reduced amount on becoming pregnant.">
            >
            ["at0022"] = <
                text = <"Last updated">
                description = <"The date when this vaping summary was last updated.">
            >
            ["at0023"] = <
                text = <"???Typical use (units)">
                description = <"Estimate of number of units of the specified type of substance or e-liquid consumed.">
                comment = <"This data element is redundant if a value is recorded for 'Typical use(mass)'.">
            >
            ["at0025"] = <
                text = <"Number of quit attempts">
                description = <"Total number of times the individual has attempted to stop vaping the specified substance or e-liquid within this episode.">
            >
            ["at0026"] = <
                text = <"Episode details">
                description = <"Additional structured details about the specified episode of vaping.">
            >
            ["at0029"] = <
                text = <"Per substance">
                description = <"Details about vaping activity for a specified type of substance or e-liquid.">
            >
            ["at0030"] = <
                text = <"Pattern">
                description = <"The typical pattern of vaping for the specified substance or e-liquid.">
            >
            ["at0043"] = <
                text = <"Overall description">
                description = <"Narrative description about the individual’s overall vaping pattern and history.">
                comment = <"Use this data element to record a narrative description of the vaping habits for this individual or to incorporate unstructured vaping information from existing or legacy clinical systems.">
            >
            ["at0052"] = <
                text = <"Status">
                description = <"Statement about current vaping behaviour for the specified substance or e-liquid.">
            >
            ["at0053"] = <
                text = <"Description">
                description = <"Narrative summary about vaping behaviour for the specified substance or e-liquid.">
            >
            ["at0059"] = <
                text = <"Former vaper">
                description = <"Individual has previously vaped the specified substance or e-liquid but is not a current vaper.">
            >
            ["at0061"] = <
                text = <"Current vaper">
                description = <"Individual is a current vaper of the specified substance or e-liquid.">
            >
            ["at0064"] = <
                text = <"Per episode">
                description = <"Details about a discrete period of vaping activity for the specified substance or e-liquid.">
            >
            ["at0069"] = <
                text = <"Comment">
                description = <"Additional narrative about vaping of the specified substance or e-liquid, not captured in other fields.">
            >
            ["at0071"] = <
                text = <"Quit date definition">
                description = <"The applied definition for the 'Quit date' data elements used in this archetype.">
            >
            ["at0073"] = <
                text = <"Extension">
                description = <"Additional information required to capture local content or to align with other reference models/formalisms.">
                comment = <"For example: local information requirements or additional metadata to align with FHIR or CIMI equivalents.">
            >
            ["at0075"] = <
                text = <"Current vpaer definition">
                description = <"The applied definition for the 'Current vaper' value in each of the 'Status' data elements used in this archetype.">
                comment = <"Definition may need to be specified per type. Current vaper definitions vary in different jurisdictions. 
">
            >
            ["at0076"] = <
