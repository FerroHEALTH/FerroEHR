archetype (adl_version=2.4.0; rm_release=1.1.0; generated; uid=d0b028bd-a208-4aa1-bc14-d22b3b932e17; build_uid=a0b7b24f-a406-452d-969b-06f83ea17d88)
    openEHR-EHR-EVALUATION.vaping_summary.v0.0.1-alpha

