    references = <
        ["1"] = <"Tobacco smoking summary, Published archetype [Internet]. openEHR Foundation, openEHR Clinical Knowledge Manager [cited: 2020-05-20]. Available from: https://ckm.openehr.org/ckm/archetypes/1013.1.2466.">
    >
