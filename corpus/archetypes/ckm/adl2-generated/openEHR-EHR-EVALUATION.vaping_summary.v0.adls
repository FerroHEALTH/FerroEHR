            >
            ["at0053"] = <
                text = <"Beskrivning">
                description = <"*Narrative summary about vaping behaviour for the specified substance or e-liquid.(en)">
            >
            ["at0059"] = <
                text = <"Före detta vaper">
                description = <"Individen har tidigare rökt den här sortens substans eller e-vätska, men gör det inte nu.">
            >
            ["at0061"] = <
                text = <"Nuvarande vaper">
                description = <"Individen röker denna typ av substans eller e-vätska.">
            >
            ["at0064"] = <
                text = <"Per episod">
                description = <"Detaljerad beskrivning av en specifik konsumtionsperiod för den angivna typen av tobak.">
            >
            ["at0069"] = <
                text = <"Kommentar">
                description = <"*Additional narrative about vaping of the specified substance or e-liquid, not captured in other fields.(en)">
