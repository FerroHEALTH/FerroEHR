definition
    INSTRUCTION[at0000] matches {    -- Assisted ventilation order
        activities cardinality matches {0..*; unordered} matches {
            ACTIVITY[at0007] occurrences matches {0..1} matches {    -- Current Activity
                description matches {
                    ITEM_TREE[at0008] matches {
                        items cardinality matches {0..*; unordered} matches {
                            ELEMENT[at0024] occurrences matches {0..1} matches {    -- Assistance Type
                                value matches {
                                    DV_CODED_TEXT[at9012] matches {
                                        defining_code matches {[ac9000]}    -- Assistance Type (synthesised)
                                    }
                                }
                            }
                            ELEMENT[at0014] occurrences matches {0..1} matches {    -- Inflation Type
                                value matches {
                                    DV_CODED_TEXT[at9013] matches {
                                        defining_code matches {[ac9001]}    -- Inflation Type (synthesised)
                                    }
                                }
                            }
                            ELEMENT[at0022] occurrences matches {0..1} matches {    -- Ventilator Pattern
                                value matches {
                                    DV_CODED_TEXT[at9014] matches {
                                        defining_code matches {[ac9002]}    -- Ventilator Pattern (synthesised)
                                    }
                                }
                            }
                            ELEMENT[at0023] occurrences matches {0..1} matches {    -- Ventilator Adjunct
                                value matches {
                                    DV_CODED_TEXT[at9015] matches {
                                        defining_code matches {[ac9003]}    -- Ventilator Adjunct (synthesised)
                                    }
                                }
                            }
                            ELEMENT[at0032] occurrences matches {0..1} matches {    -- Trigger Type
                                value matches {
                                    DV_CODED_TEXT[at9016] matches {
                                        defining_code matches {[ac9004]}    -- Trigger Type (synthesised)
                                    }
                                }
                            }
                            ELEMENT[at0041] occurrences matches {0..1} matches {    -- Trigger Value
                                value matches {
                                    DV_QUANTITY[at9017]
                                }
                            }
                            ELEMENT[at0049] occurrences matches {0..1} matches {    -- Group
                                value matches {
                                    DV_CODED_TEXT[at9018] matches {
                                        defining_code matches {[ac9005]}    -- Group (synthesised)
                                    }
                                }
                            }
                            ELEMENT[at0059] occurrences matches {0..1} matches {    -- Systematic Code
                                value matches {
                                    DV_CODED_TEXT[at9019] matches {
                                        defining_code matches {[ac9006]}    -- Systematic Code (synthesised)
                                    }
                                }
                            }
                            ELEMENT[at0066] occurrences matches {0..1} matches {    -- Set Rate
                                value matches {
                                    DV_QUANTITY[at9020] matches {
                                        property matches {[at9007]}    -- Frequency
                                        units matches {"/min"}
                                        precision matches {0}
                                    }
                                }
                            }
                            ELEMENT[at0067] occurrences matches {0..1} matches {    -- Inspiratory Pressure
                                value matches {
                                    DV_QUANTITY[at9021] matches {
                                        property matches {[at9008]}    -- Pressure
                                        units matches {"cm[H2O]"}
                                    }
                                }
                            }
                            ELEMENT[at0068] occurrences matches {0..1} matches {    -- Maximum Inspiratory Pressure Pmax
                                value matches {
                                    DV_QUANTITY[at9022] matches {
                                        property matches {[at9008]}    -- Pressure
                                        units matches {"cm[H2O]"}
                                    }
                                }
                            }
                            ELEMENT[at0069] occurrences matches {0..1} matches {    -- Plateau Airway Pressure
                                value matches {
                                    DV_QUANTITY[at9023] matches {
                                        property matches {[at9008]}    -- Pressure
                                        units matches {"cm[H2O]"}
                                    }
                                }
                            }
                            ELEMENT[at0070] occurrences matches {0..1} matches {    -- Peak End-Expiratory Pressure (PEEP)
                                value matches {
                                    DV_QUANTITY[at9024] matches {
                                        property matches {[at9008]}    -- Pressure
                                        units matches {"cm[H2O]"}
                                    }
                                }
                            }
                            ELEMENT[at0071] occurrences matches {0..1} matches {    -- Tidal Volume
                                value matches {
                                    DV_QUANTITY[at9025] matches {
                                        property matches {[at9009]}    -- Volume
                                        units matches {"ml"}
                                    }
                                }
                            }
                            ELEMENT[at0072] occurrences matches {0..1} matches {    -- Baseline Airway Pressure (BAP)
                                value matches {
                                    DV_QUANTITY[at9026] matches {
                                        property matches {[at9008]}    -- Pressure
                                        units matches {"cm[H2O]"}
                                    }
                                }
                            }
                            ELEMENT[at0073] occurrences matches {0..1} matches {    -- Assured Constant Airway Pressure (ACAP)
                                value matches {
                                    DV_QUANTITY[at9027]
                                }
                            }
                            ELEMENT[at0074] occurrences matches {0..1} matches {    -- Inspiratory Time
                                value matches {
                                    DV_QUANTITY[at9028] matches {
                                        property matches {[at9010]}    -- Time
                                        units matches {"s"}
                                    }
                                }
                            }
                            ELEMENT[at0075] occurrences matches {0..1} matches {    -- Expiratory Time
                                value matches {
                                    DV_QUANTITY[at9029] matches {
                                        property matches {[at9010]}    -- Time
                                        units matches {"s"}
                                    }
                                }
                            }
                            ELEMENT[at0077] occurrences matches {0..1} matches {    -- Inspiratory Pause Time
                                value matches {
                                    DV_QUANTITY[at9030] matches {
                                        property matches {[at9010]}    -- Time
                                        units matches {"s"}
                                    }
                                }
                            }
                            ELEMENT[at0079] occurrences matches {0..1} matches {    -- I:E Ratio
                                value matches {
                                    DV_PROPORTION[at9031] matches {
                                        type matches {0}
                                    }
                                }
                            }
                            ELEMENT[at0080] occurrences matches {0..1} matches {    -- Inspiratory Time Fraction
                                value matches {
                                    DV_PROPORTION[at9032] matches {
                                        type matches {2}
                                    }
                                }
                            }
                            ELEMENT[at0083] occurrences matches {0..1} matches {    -- Breathing System
                                value matches {
                                    DV_CODED_TEXT[at9033] matches {
                                        defining_code matches {[ac9011]}    -- Breathing System (synthesised)
                                    }
                                }
                            }
                            allow_archetype CLUSTER[at0057] matches {    -- Ventilation Device
                                include
                                    archetype_id/value matches {/openEHR-EHR-CLUSTER\.device\.v1\..*/}
                            }
                            allow_archetype CLUSTER[at0082] matches {    -- Humidification
                                include
                                    archetype_id/value matches {/openEHR-EHR-CLUSTER\.humidification\.v0\..*/}
                            }
                            allow_archetype CLUSTER[at0091] matches {    -- Airway Device
                                include
                                    archetype_id/value matches {/openEHR-EHR-CLUSTER\.airway_device\.v1\..*/}
                            }
                        }
                    }
                }
            }
        }
        protocol matches {
            ITEM_TREE[at0004] matches {
                items cardinality matches {0..*; unordered} matches {
                    allow_archetype CLUSTER[at0092] matches {    -- Extension
                        include
                            archetype_id/value matches {/.*/}
                    }
                }
            }
        }
    }

