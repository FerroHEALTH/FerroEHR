definition
    INSTRUCTION[at0000.1] matches {    -- Imaging examination request
        /activities[at0001]/description[at0009]/items matches {
            ELEMENT[at0154] matches {
                value matches {
                    DV_TEXT[at0.9001]
                }
            }
            ELEMENT[at0.1] occurrences matches {0..1} matches {    -- Modality
                value matches {
                    DV_TEXT[at0.9002]
                }
            }
            ELEMENT[at0.2] occurrences matches {0..1} matches {    -- Target body site
                value matches {
                    DV_TEXT[at0.9003]
                }
            }
            allow_archetype CLUSTER[at0.3] matches {    -- Structured target body site
                include
                    archetype_id/value matches {/openEHR-EHR-CLUSTER\.anatomical_location(-[a-zA-Z0-9_]+)*\.v1\..*|openEHR-EHR-CLUSTER\.anatomical_location_relative(-[a-zA-Z0-9_]+)*\.v2\..*|openEHR-EHR-CLUSTER\.anatomical_location_circle(-[a-zA-Z0-9_]+)*\.v1\..*/}
            }
            ELEMENT[at0.4] occurrences matches {0..1} matches {    -- Contrast use
                value matches {
                    DV_CODED_TEXT[at0.9004] matches {
                        defining_code matches {[ac0.9000]}    -- Contrast use (synthesised)
                    }
                    DV_TEXT[at0.9005]
                }
            }
        }
    }

terminology
    term_definitions = <
        ["de"] = <
            ["at0000.1"] = <
                text = <"*Imaging examination request (en)">
                description = <"*An order or instruction for a medical or diagnostic imaging service. (en)">
            >
            ["at0.1"] = <
                text = <"*Modality (en)">
                description = <"*The type of device, process or method used to acquire or produce the image or data. (en)">
                comment = <"*Coding of the 'Modality' with an external terminology is recommended, if available. This data element allows multiple occurrences to enable the user to record a multiple responses, if required. For example: 'X-Ray'; 'Ultrasound'; 'Medical Resonance Imaging (MRI)'; 'Positron Emission Tomography (PET)'; 'Mammography'; 'Fluoroscopy'; or 'Digital Subtraction Angiography (DSA)'. (en)">
            >
            ["at0.2"] = <
                text = <"*Target body site (en)">
                description = <"*Identification of the area of the body targeted for the imaging examination. (en)">
                comment = <"*Coding of the 'Target body site' with an external terminology is desirable, if available. This data element allows multiple occurrences to enable the user to record a multiple responses, if required. For example: 'heart'; 'both lungs'; 'right breast'; and 'left lower limb'. (en)">
            >
            ["at0.3"] = <
                text = <"*Structured target body site (en)">
                description = <"*A structured description of the area of the body targeted for examination. (en)">
            >
            ["at0.4"] = <
                text = <"*Contrast use (en)">
                description = <"*Specific stipulation by the requestor about the use of contrast as part of the imaging examination. (en)">
