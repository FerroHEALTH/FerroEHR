definition
    INSTRUCTION[at0000.1] matches {    -- Laboratory test request
        /activities[at0001]/description[at0009]/items matches {
            ELEMENT[at0154] matches {
                value matches {
                    DV_TEXT[at0.9003]
                }
            }
            after [at0121]
            ELEMENT[at0.1] occurrences matches {0..1} matches {    -- Fasting status
                value matches {
                    DV_CODED_TEXT[at0.9004] matches {
                        defining_code matches {[ac0.9004]}    -- Fasting status (synthesised)
                    }
                    DV_TEXT[at0.9005]
                }
            }
            after [at0151]
            allow_archetype CLUSTER[at0.4] matches {    -- Requested specimen
                include
                    archetype_id/value matches {/openEHR-EHR-CLUSTER\.specimen(-[a-zA-Z0-9_]+)*\.v1\..*/}
            }
            allow_archetype CLUSTER[at0.5] matches {    -- Collected specimen
                include
                    archetype_id/value matches {/openEHR-EHR-CLUSTER\.specimen(-[a-zA-Z0-9_]+)*\.v1\..*/}
            }
        }
    }

terminology
    term_definitions = <
        ["de"] = <
            ["at0000.1"] = <
                text = <"*Laboratory test request (en)">
                description = <"*An order or instruction for a laboratory test service. (en)">
            >
            ["at0.1"] = <
                text = <"*Fasting status (en)">
                description = <"*Request requirement for the patient to be fasted at the time of specimen collection. (en)">
            >
            ["at0.2"] = <
                text = <"*Fasting (en)">
                description = <"*The test should be carried out on a fasted individual. (en)">
