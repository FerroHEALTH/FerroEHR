definition
    ITEM_TREE[at0000] matches {    -- Gas administration
        items cardinality matches {0..*; unordered} matches {
            ELEMENT[at0014] occurrences matches {0..1} matches {    -- Gas
                value matches {
                    DV_TEXT[at9003]
                }
            }
            ELEMENT[at0003] occurrences matches {0..1} matches {    -- Means of delivery
                value matches {
                    DV_CODED_TEXT[at9004] matches {
                        defining_code matches {[ac9000]}    -- Means of delivery (synthesised)
                    }
                }
            }
            CLUSTER[at0004] occurrences matches {0..1} matches {    -- Amount
                items cardinality matches {1..*; unordered} matches {
                    ELEMENT[at0002] occurrences matches {0..1} matches {    -- Inspired oxygen
                        value matches {
                            DV_PROPORTION[at9005] matches {
                                numerator matches {|>20.0|}
                                denominator matches {100.0}
                                type matches {2}
                            }
                        }
                    }
                    ELEMENT[at0005] occurrences matches {0..1} matches {    -- Flow rate
                        value matches {
                            DV_QUANTITY[at9006] matches {
                                property matches {[at9001]}    -- Flow rate, volume
                                magnitude matches {|>=0.0|}
                                units matches {"l/m"}
                                precision matches {0}
                            }
                        }
                    }
                    ELEMENT[at0012] occurrences matches {0..1} matches {    -- Partial pressure of oxygen
                        value matches {
                            DV_QUANTITY[at9007] matches {
                                property matches {[at9002]}    -- Pressure
                                magnitude matches {|>=0.0|}
                                units matches {"bar"}
                                precision matches {1}
                            }
                        }
                    }
                }
            }
            ELEMENT[at0010] occurrences matches {0..1} matches {    -- Atmospheric pressure
                value matches {
                    DV_QUANTITY[at9008] matches {
                        property matches {[at9002]}    -- Pressure
                        [magnitude, units, precision] matches {
                            [{|>=0.0|}, {"atm"}, {1}],
                            [{|>=0.3|}, {"bar"}, {1}]
                        }
                    }
                }
            }
            ELEMENT[at0013] occurrences matches {0..1} matches {    -- Duration of therapy
                value matches {
                    DV_DURATION[at9009]
                }
            }
            ELEMENT[at0015] occurrences matches {0..1} matches {    -- Self-administered
                value matches {
                    DV_BOOLEAN[at9010] matches {
                        value matches {True, False}
                    }
                }
            }
        }
    }

