    lifecycle_state = <"Rejected">
    details = <
        ["en"] = <
            language = <[ISO_639-1::en]>
            purpose = <"Specifies the description of a formulation with more than one ingredient as part of an INSTRUCTION or ACTION recording. This will usually be in response to a medication order or prescription, but may be self administered or supplied by a pharmacy.">
            keywords = <"medication", "description", "formulation">
            use = <"For use with INSTRUCTION.medication and ACTION.medication to describe the formulation">
            misuse = <"">
            copyright = <"© openEHR Foundation">
        >
    >

definition
    ITEM_TREE[at0000.1] matches {    -- Medication description involving a formulation
        items matches {
            ELEMENT[at0001.1] matches {    -- Name of formulation
                value matches {
                    DV_TEXT[at0.9000]
                }
            }
            ELEMENT[at0003] matches {
                value matches {
                    DV_QUANTITY[at0.9004]
                }
            }
            ELEMENT[at0004] matches {
                value matches {
                    DV_CODED_TEXT[at9070.1] matches {
                        defining_code matches {[ac1]}
                    }
                }
            }
            CLUSTER[at0018] matches {
                items matches {
                    ELEMENT[at0019] matches {
                        /value[at9052]/value
                    }
                    ELEMENT[at0032] matches {
                        /value[at9056]/value
                    }
                }
            }
            after [at0001.1]
            CLUSTER[at0.32] occurrences matches {0..1} matches {    -- Ingredients
                items cardinality matches {1..*; unordered} matches {
                    CLUSTER[at0.33] occurrences matches {1..*} matches {    -- Ingredient
                        items cardinality matches {1..*; unordered} matches {
                            ELEMENT[at0.34] occurrences matches {0..1} matches {    -- Name of ingredient
                                value matches {
                                    DV_CODED_TEXT[at0.9001] matches {
                                        defining_code
                                    }
                                }
                            }
                            ELEMENT[at0.35] occurrences matches {0..1} matches {    -- Quantity
                                value matches {
                                    DV_QUANTITY[at0.9002]
                                }
                            }
                        }
                    }
                }
            }
            ELEMENT[at0002] occurrences matches {0..1} matches {
                value matches {
                    DV_TEXT[at0.9003]
                }
            }
            after [at0004]
            ELEMENT[at0005] occurrences matches {0..1} matches {
                value matches {
                    DV_COUNT[at0.9005] matches {
                        magnitude matches {|>=1|}
                    }
                    DV_INTERVAL<DV_COUNT>[at0.9006] matches {
                        upper matches {
                            DV_COUNT[at0.9007]
                        }
                        lower matches {
                            DV_COUNT[at0.9008] matches {
                                magnitude matches {|>=1|}
                            }
                        }
                    }
                }
            }
            ELEMENT[at0006]
            after [at0010]
            ELEMENT[at0012]
        }
    }

