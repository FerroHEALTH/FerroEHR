    details = <
        ["en"] = <
            language = <[ISO_639-1::en]>
            purpose = <"To record the results for each component parameter and their total sum for the Aldrete score.">
            keywords = <"Aldrete", "score", "recovery", "anesthesia", "PACU", "post-anesthesia", "care", "unit", "discharge">
            use = <"Use to record the results for each component parameter and their total sum for the Aldrete score.">
            misuse = <"">
            copyright = <"© Cambio CDS, openEHR Foundation">
        >
    >

definition
    OBSERVATION[at0000] matches {    -- Aldrete score
        data matches {
            HISTORY[at0001] matches {
                events cardinality matches {1..*; unordered} matches {
                    EVENT[at0002] matches {    -- Any event
                        data matches {
                            ITEM_TREE[at0003] matches {
                                items cardinality matches {0..*; unordered} matches {
                                    ELEMENT[at0004] occurrences matches {0..1} matches {    -- Activity
                                        value matches {
                                            DV_ORDINAL[at9005] matches {
                                                [value, symbol] matches {
                                                    [{0}, {[at0005]}],    -- Unable to move extremities voluntarily or on command
                                                    [{1}, {[at0006]}],    -- Able to move 2 extremities voluntarily or on command
                                                    [{2}, {[at0007]}]    -- Able to move 4 extremities voluntarily or on command
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0008] occurrences matches {0..1} matches {    -- Respiration
                                        value matches {
                                            DV_ORDINAL[at9006] matches {
                                                [value, symbol] matches {
                                                    [{0}, {[at0009]}],    -- Apnoeic
                                                    [{1}, {[at0010]}],    -- Dyspnoea or limited breathing
                                                    [{2}, {[at0011]}]    -- Able to breathe deeply and cough freely
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0012] occurrences matches {0..1} matches {    -- Circulation
                                        value matches {
                                            DV_ORDINAL[at9007] matches {
                                                [value, symbol] matches {
                                                    [{0}, {[at0013]}],    -- BP ±50% of pre-anaesthetic level
                                                    [{1}, {[at0014]}],    -- BP between 20-49% of pre-anaesthetic level
                                                    [{2}, {[at0015]}]    -- BP ±20% of pre-anaesthetic level
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0016] occurrences matches {0..1} matches {    -- Consciousness
                                        value matches {
                                            DV_ORDINAL[at9008] matches {
                                                [value, symbol] matches {
                                                    [{0}, {[at0017]}],    -- Not responding
                                                    [{1}, {[at0018]}],    -- Arousable on calling
                                                    [{2}, {[at0019]}]    -- Fully awake
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0020] occurrences matches {0..1} matches {    -- Colour
                                        value matches {
                                            DV_ORDINAL[at9009] matches {
                                                [value, symbol] matches {
                                                    [{0}, {[at0021]}],    -- Cyanotic
                                                    [{1}, {[at0022]}],    -- Pale, dusky, blotchy, jaundiced, or other
                                                    [{2}, {[at0023]}]    -- Normal
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0024] occurrences matches {0..1} matches {    -- Total score
                                        value matches {
                                            DV_COUNT[at9010] matches {
                                                magnitude matches {|0..10|}
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        protocol matches {
            ITEM_TREE[at0025] matches {
                items cardinality matches {0..*; unordered} matches {
                    allow_archetype CLUSTER[at0026] matches {    -- Extension
                        include
                            archetype_id/value matches {/.*/}
                    }
                }
            }
        }
    }

terminology
    term_definitions = <
        ["en"] = <
            ["at0000"] = <
                text = <"Aldrete score">
                description = <"An assessment score used to evaluate recovery after anaesthesia and patient readiness to be discharged from a post-anaesthesia care unit (PACU).">
                comment = <"Original version, c 1970">
            >
            ["at0002"] = <
                text = <"Any event">
                description = <"Default, unspecified point in time or interval event which may be explicitly defined in a template or at run-time.">
            >
            ["at0004"] = <
                text = <"Activity">
                description = <"">
            >
            ["at0005"] = <
                text = <"Unable to move extremities voluntarily or on command">
                description = <"">
            >
