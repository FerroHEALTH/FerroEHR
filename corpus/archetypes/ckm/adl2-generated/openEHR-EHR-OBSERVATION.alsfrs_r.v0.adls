definition
    OBSERVATION[at0000] matches {    -- Revised Amyotrophic Lateral Sclerosis Functional Rating Scale (ALSFRS-R)
        data matches {
            HISTORY[at0001] matches {
                events cardinality matches {1..*; unordered} matches {
                    EVENT[at0002] occurrences matches {0..1} matches {    -- Any event
                        data matches {
                            ITEM_TREE[at0003] matches {
                                items cardinality matches {0..*; unordered} matches {
                                    ELEMENT[at0004] occurrences matches {0..1} matches {    -- Speech
                                        value matches {
                                            DV_ORDINAL[at9014] matches {
                                                [value, symbol] matches {
                                                    [{0}, {[at0005]}],    -- Loss of useful speech
                                                    [{1}, {[at0006]}],    -- Speech combined with nonvocal communications
                                                    [{2}, {[at0007]}],    -- Intelligible with repeating
                                                    [{3}, {[at0008]}],    -- Detectable speech disturbance
                                                    [{4}, {[at0009]}]    -- Normal
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0010] occurrences matches {0..1} matches {    -- Salivation
                                        value matches {
                                            DV_ORDINAL[at9015] matches {
                                                [value, symbol] matches {
                                                    [{0}, {[at0011]}],    -- Marked drooling; requires constant tissue or handkerchief
                                                    [{1}, {[at0012]}],    -- Marked excess of saliva with some drooling
                                                    [{2}, {[at0013]}],    -- Moderately excessive saliva; may have minimal drooling
                                                    [{3}, {[at0014]}],    -- Slight but definite excess of saliva in mouth; may have nighttime drooling
                                                    [{4}, {[at0015]}]    -- Normal
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0016] occurrences matches {0..1} matches {    -- Swallowing
                                        value matches {
                                            DV_ORDINAL[at9016] matches {
                                                [value, symbol] matches {
                                                    [{0}, {[at0017]}],    -- Nothing by mouth; exclusively parenteral or enteral feeding
                                                    [{1}, {[at0018]}],    -- Needs supplemental tube feedings
                                                    [{2}, {[at0019]}],    -- Dietary consistency changes
                                                    [{3}, {[at0020]}],    -- Early eating problems; occasional choking
                                                    [{4}, {[at0021]}]    -- Normal eating habits
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0022] occurrences matches {0..1} matches {    -- Handwriting
                                        value matches {
                                            DV_ORDINAL[at9017] matches {
                                                [value, symbol] matches {
                                                    [{0}, {[at0023]}],    -- Unable to grip pen
                                                    [{1}, {[at0024]}],    -- Able to grip pen but unable to write
                                                    [{2}, {[at0025]}],    -- Not all words are legible
                                                    [{3}, {[at0026]}],    -- Slow or sloppy; all words are legible
                                                    [{4}, {[at0027]}]    -- Normal
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0028] occurrences matches {0..1} matches {    -- Patients with gastrostomy and >50% daily nutrition intake via G-tube
                                        value matches {
                                            DV_CODED_TEXT[at9018] matches {
                                                defining_code matches {[ac9004]}    -- Patients with gastrostomy and >50% daily nutrition intake via G-tube (synthesised)
                                            }
                                        }
                                    }
                                    ELEMENT[at0031] occurrences matches {0..1} matches {    -- Cutting food and handling utensils (patients with gastrostomy)
                                        value matches {
                                            DV_ORDINAL[at9019] matches {
                                                [value, symbol] matches {
                                                    [{0}, {[at0032]}],    -- Unable to perform any aspect of task
                                                    [{1}, {[at0033]}],    -- Provides minimal assistance to caregiver
                                                    [{2}, {[at0034]}],    -- Some help needed with closures and fasteners
                                                    [{3}, {[at0035]}],    -- Clumsy but able to perform all manipulations independently
                                                    [{4}, {[at0036]}]    -- Normal
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0081] occurrences matches {0..1} matches {    -- Cutting food and handling utensils (patients without gastrostomy)
                                        value matches {
                                            DV_ORDINAL[at9020] matches {
                                                [value, symbol] matches {
                                                    [{0}, {[at0082]}],    -- Needs to be fed
                                                    [{1}, {[at0083]}],    -- Food must be cut by someone but can still feed slowly
                                                    [{2}, {[at0084]}],    -- Can cut most foods although clumsy and slow; some help needed
                                                    [{3}, {[at0085]}],    -- Somewhat slow and clumsy but no help needed
                                                    [{4}, {[at0086]}]    -- Normal
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0037] occurrences matches {0..1} matches {    -- Dressing and hygiene
                                        value matches {
                                            DV_ORDINAL[at9021] matches {
                                                [value, symbol] matches {
                                                    [{0}, {[at0038]}],    -- Total dependence
                                                    [{1}, {[at0039]}],    -- Needs attendant for self-care
                                                    [{2}, {[at0040]}],    -- Intermittent assistance or substitute methods
                                                    [{3}, {[at0041]}],    -- Independent and complete self-care with effort or decreased efficiency
                                                    [{4}, {[at0042]}]    -- Normal function
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0043] occurrences matches {0..1} matches {    -- Turning in bed and adjusting bed clothes
                                        value matches {
                                            DV_ORDINAL[at9022] matches {
                                                [value, symbol] matches {
                                                    [{0}, {[at0044]}],    -- Helpless
                                                    [{1}, {[at0045]}],    -- Can initiate but not turn or adjust sheets alone
                                                    [{2}, {[at0046]}],    -- Can turn alone or adjust sheets but with great difficulty
                                                    [{3}, {[at0047]}],    -- Somewhat slow and clumsy but no help needed
                                                    [{4}, {[at0048]}]    -- Normal
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0049] occurrences matches {0..1} matches {    -- Walking
                                        value matches {
                                            DV_ORDINAL[at9023] matches {
                                                [value, symbol] matches {
                                                    [{0}, {[at0050]}],    -- No purposeful leg movement
                                                    [{1}, {[at0051]}],    -- Nonambulatory functional movement
                                                    [{2}, {[at0052]}],    -- Walks with assistance
                                                    [{3}, {[at0053]}],    -- Early ambulation difficulties
                                                    [{4}, {[at0054]}]    -- Normal
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0055] occurrences matches {0..1} matches {    -- Climbing stairs
                                        value matches {
                                            DV_ORDINAL[at9024] matches {
                                                [value, symbol] matches {
                                                    [{0}, {[at0056]}],    -- Cannot do
                                                    [{1}, {[at0057]}],    -- Needs assistance
                                                    [{2}, {[at0058]}],    -- Mild unsteadiness or fatigue
                                                    [{3}, {[at0059]}],    -- Slow
                                                    [{4}, {[at0060]}]    -- Normal
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0061] occurrences matches {0..1} matches {    -- Dyspnea
                                        value matches {
                                            DV_ORDINAL[at9025] matches {
                                                [value, symbol] matches {
                                                    [{0}, {[at0062]}],    -- Significant difficulty, considering using mechanical respiratory support
                                                    [{1}, {[at0063]}],    -- Occurs at rest, difficulty breathing when either sitting or lying
                                                    [{2}, {[at0064]}],    -- Occurs with one or more of the following eating, bathing, dressing
                                                    [{3}, {[at0065]}],    -- Occurs when walking
                                                    [{4}, {[at0066]}]    -- None
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0067] occurrences matches {0..1} matches {    -- Orthopnea
                                        value matches {
                                            DV_ORDINAL[at9026] matches {
                                                [value, symbol] matches {
                                                    [{0}, {[at0068]}],    -- Unable to sleep
                                                    [{1}, {[at0069]}],    -- Can only sleep sitting up
                                                    [{2}, {[at0070]}],    -- Needs extra pillows in order to sleep (>2)
                                                    [{3}, {[at0071]}],    -- Some difficulty sleeping at night due to shortness of breath; does not routinely use >2 pillows
                                                    [{4}, {[at0072]}]    -- None
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0073] occurrences matches {0..1} matches {    -- Respiratory insufficiency
                                        value matches {
                                            DV_ORDINAL[at9027] matches {
                                                [value, symbol] matches {
                                                    [{0}, {[at0074]}],    -- Invasive mechanical ventilation by intubation or tracheostomy
                                                    [{1}, {[at0075]}],    -- Continuous use of BiPAP during the night and day
                                                    [{2}, {[at0076]}],    -- Continuous use of BiPAP during the night
                                                    [{3}, {[at0077]}],    -- Intermittent use of BiPAP
                                                    [{4}, {[at0078]}]    -- None
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0079] occurrences matches {0..1} matches {    -- Total score
                                        value matches {
                                            DV_COUNT[at9028] matches {
                                                magnitude matches {|0..48|}
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

