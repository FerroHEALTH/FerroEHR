            >
        >
        ["en"] = <
            ["at0000"] = <
                text = <"ASA physical status classification system">
                description = <"Classification system adopted by the American Society of Anesthesiologists (ASA) as part of a pre-surgical risk assessment.">
            >
            ["at0001"] = <
