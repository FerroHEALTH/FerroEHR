                description = <"Unspecified point in time event which may be explicitly defined in a template or at run-time.">
            >
            ["at0019"] = <
                text = <"Extension">
                description = <"Additional information required to extend the model with local content or to align with other reference models or formalisms.">
                comment = <"For example: local information requirements; or additional metadata to align with FHIR.">
            >
            ["at0020"] = <
                text = <"Emergency (E)">
                description = <"Record as True if the surgery was carried out in an emergency situation.">
                comment = <"Represented by the suffix 'E' added to the class. For example: '3E'. Class 5 is usually an emergency and is therefore almost always only designated as '5E'. The class '6E' is not valid and is simply recorded as class '6', as all organ retrieval in brain-dead patients is done urgently. Definition of an emergency can be found in the ASA (2020) reference.">
            >
            ["at0003"] = <
                text = <"ASA 1">
                description = <"A normal healthy patient.">
            >
            ["at0004"] = <
                text = <"ASA 2">
                description = <"A patient with mild systemic disease.">
            >
            ["at0005"] = <
                text = <"ASA 3">
                description = <"A patient with severe systemic disease.">
            >
            ["at0006"] = <
                text = <"ASA 4">
                description = <"A patient with severe systemic disease that is a constant threat to life.">
            >
            ["at0007"] = <
                text = <"ASA 5">
                description = <"A moribund patient who is not expected to survive without the operation.">
            >
            ["at0008"] = <
                text = <"ASA 6">
                description = <"A declared brain-dead patient whose organs are being removed for donor purposes.">
            >
            ["ac9001"] = <
                text = <"Classification (synthesised)">
                description = <"Assessed classification of a patient. (synthesised)">
            >
        >
        ["es"] = <
            ["at0000"] = <
                text = <"Sistema de la ASA para la clasificación del estado físico.">
                description = <"Sistema de clasificación adoptado por la Sociedad Americana de Anestesiólogos (ASA) como parte de una evaluación de riesgo prequirúrgico.">
            >
            ["at0001"] = <
                text = <"Clasificación">
                description = <"Clasificación evaluada de un paciente.">
                comment = <"Se pueden encontrar ejemplos para cada clase en la referencia de la ASA (2020).">
            >
            ["at0003"] = <
                text = <"ASA 1">
                description = <"Paciente sano.">
            >
            ["at0004"] = <
                text = <"ASA 2">
                description = <"Paciente con enfermedad sistémica leve.">
            >
            ["at0005"] = <
                text = <"ASA 3">
                description = <"Paciente con enfermedad sistémica grave.">
            >
            ["at0006"] = <
                text = <"ASA 4">
                description = <"Paciente con enfermedad sistémica grave que es una amenaza constante pasa su vida.">
            >
            ["at0007"] = <
                text = <"ASA 5">
                description = <"Paciente moribundo que no se espera que sobreviva sin la operación.">
            >
            ["at0008"] = <
                text = <"ASA 6">
                description = <"Paciente en muerte cerebral cuyos órganos están siendo extraídos para donación.">
            >
            ["at0016"] = <
                text = <"En cualquier momento de un evento temporal.">
                description = <"Evento en un punto no especificado en el tiempo que puede ser definido explícitamente en una plantilla o durante la ejecución.">
            >
            ["at0019"] = <
                text = <"Extensión">
                description = <"Se requiere información adicional para ampliar el modelo con contenido local o para alinearlo con otros modelos de referencia o formalismos.">
                comment = <"Por ejemplo: requisitos de información local; o metadatos adicionales para alinearse con FHIR.">
            >
            ["at0020"] = <
                text = <"Emergencia (E)">
                description = <"Registra como Verdadero si la cirugía se llevó a cabo en una situación de emergencia.">
                comment = <"Representado por el sufijo 'E' añadido a la clase. Por ejemplo: '3E'. La Clase 5 suele ser una emergencia y por lo tanto casi siempre se designa solo como '5E'. La clase '6E' no es válida y simplemente se registra como clase '6', ya que la extracción de órganos en pacientes en estado de muerte cerebral se realiza en la urgencia. La definición de una emergencia se puede encontrar en la referencia de la ASA (2020).">
            >
            ["ac9001"] = <
                text = <"Clasificación (synthesised)">
                description = <"Clasificación evaluada de un paciente. (synthesised)">
            >
        >
        ["nl"] = <
            ["at0000"] = <
                text = <"ASA-classificatiesysteem fysieke status">
                description = <"Classificatiesysteem van de American Society of Anesthesiologists (ASA) als onderdeel van een preoperatieve risicobeoordeling.">
            >
            ["at0001"] = <
                text = <"Classificatie">
                description = <"Vastgestelde classificatie van een patiënt.">
                comment = <"Voorbeelden voor elke klasse zijn te vinden in de ASA (2020)-referentie.">
            >
            ["at0003"] = <
                text = <"ASA 1">
                description = <"Een normale, gezonde patiënt.">
            >
            ["at0004"] = <
                text = <"ASA 2">
                description = <"Een patiënt met een milde systemische aandoening.">
            >
            ["at0005"] = <
                text = <"ASA 3">
                description = <"Een patiënt met een ernstige systemische aandoening.">
            >
            ["at0006"] = <
                text = <"ASA 4">
                description = <"Een patiënt met een ernstige systemische aandoening die een constante bedreiging voor het leven vormt.">
            >
            ["at0007"] = <
                text = <"ASA 5">
                description = <"Een moribunde patiënt van wie niet verwacht wordt dat die zonder de operatie overleeft.">
            >
            ["at0008"] = <
                text = <"ASA 6">
                description = <"Een hersendode patiënt van wie organen worden uitgenomen voor donatie.">
            >
            ["at0016"] = <
                text = <"Willekeurig moment in de tijd">
                description = <"Ongespecificeerd moment in de tijd dat expliciet gedefinieerd kan worden in een template of tijdens het vastleggen van de data.">
            >
            ["at0019"] = <
                text = <"Uitbreiding">
                description = <"Aanvullende informatie die nodig is om het model uit te breiden met lokale inhoud of af te stemmen op andere referentiemodellen of formalismen.">
                comment = <"Bijvoorbeeld: lokale informatiebehoeften; of aanvullende metadata voor afstemming met FHIR.">
            >
            ["at0020"] = <
                text = <"Spoed (E)">
                description = <"Registreer als Waar als de operatie in een spoedsituatie werd uitgevoerd.">
                comment = <"Weergegeven door het achtervoegsel 'E' achter de klasse. Bijvoorbeeld: '3E'. Klasse 5 is meestal een spoedsituatie en wordt daarom vrijwel altijd als '5E' aangeduid. De klasse '6E' is niet geldig en wordt eenvoudigweg als klasse '6' vastgelegd, omdat alle orgaanuitname bij hersendode patiënten met spoed plaatsvindt. De definitie van een spoedsituatie is te vinden in de ASA (2020)-referentie.">
            >
            ["ac9001"] = <
                text = <"Classificatie (synthesised)">
                description = <"Vastgestelde classificatie van een patiënt. (synthesised)">
            >
        >
    >
