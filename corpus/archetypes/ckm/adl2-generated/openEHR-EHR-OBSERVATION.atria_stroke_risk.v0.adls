archetype (adl_version=2.4.0; rm_release=1.1.0; generated; uid=39b62cd8-fcd4-4d0d-ad74-fa52fed27410; build_uid=3f09b7ad-374b-4342-940d-ae20bdd41450)
    openEHR-EHR-OBSERVATION.atria_stroke_risk.v0.0.1-alpha

