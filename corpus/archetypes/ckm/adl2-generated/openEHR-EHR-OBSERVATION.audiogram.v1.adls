archetype (adl_version=2.4.0; rm_release=1.1.0; generated; uid=e30630dc-15a6-4a57-beb4-80e9d02eb9d2; build_uid=2819e3ca-195f-49a5-84d6-dd069c497a63)
    openEHR-EHR-OBSERVATION.audiogram.v1.0.0

language
    original_language = <[ISO_639-1::en]>

