archetype (adl_version=2.4.0; rm_release=1.1.0; generated; uid=90a3a0e4-23f0-49ff-8eae-fa748c7f9a72; build_uid=658c82a0-ff94-4a14-ab9f-86ccdbb2a6b5)
    openEHR-EHR-OBSERVATION.audiogram_result.v0.0.1-alpha

