archetype (adl_version=2.4.0; rm_release=1.1.0; generated; uid=d06900fb-4c7f-4497-a53a-124ebcfa2335; build_uid=744431f0-6d86-4ebf-9a2a-899ea985f4f6)
    openEHR-EHR-OBSERVATION.berg_balance_scale.v1.0.0

language
