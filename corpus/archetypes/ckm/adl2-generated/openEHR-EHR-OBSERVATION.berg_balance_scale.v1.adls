    references = <
        ["1"] = <"Berg KO, Wood-Dauphinee SL, Williams JI, Gayton D. Measuring balance in the elderly: preliminary development of an instrument. Physiother Can. 1989;41(6):304-11.">
        ["2"] = <"Berg KO, Wood-Dauphinee SL, Williams JI, Maki B. Measuring balance in the elderly: validation of an instrument. Can J Public Health. 1992;83 Suppl 2:S7-11.">
    >
    other_details = <
        ["MD5-CAM-1.0.1"] = <"41C4F5933AE67A3E45B3F124D1D34527">
