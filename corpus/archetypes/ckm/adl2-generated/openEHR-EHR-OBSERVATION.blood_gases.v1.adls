definition
    OBSERVATION[at0000] matches {    -- Blood gas assessment
        data matches {
            HISTORY[at0002] matches {
                events cardinality matches {1..*; unordered} matches {
                    EVENT[at0003] matches {    -- Any event
                        data matches {
                            ITEM_TREE[at0001] matches {
                                items matches {
                                    CLUSTER[at0011] occurrences matches {0..1} matches {    -- Arterial
                                        items cardinality matches {0..8} matches {
                                            ELEMENT[at0004] occurrences matches {0..1} matches {    -- PaO2
                                                value matches {
                                                    DV_QUANTITY[at9003] matches {
                                                        property matches {[at9000]}    -- Pressure
                                                        magnitude matches {|>=0.0|}
                                                        units matches {"kPa"}
                                                    }
                                                }
                                            }
                                            ELEMENT[at0005] occurrences matches {0..1} matches {    -- PaCO2
                                                value matches {
                                                    DV_QUANTITY[at9004] matches {
                                                        property matches {[at9000]}    -- Pressure
                                                        magnitude matches {|>=0.0|}
                                                        units matches {"kPa"}
                                                    }
                                                }
                                            }
                                            ELEMENT[at0006] occurrences matches {0..1} matches {    -- pH
                                                value matches {
                                                    DV_QUANTITY[at9005] matches {
                                                        property matches {[at9001]}    -- Concentration
                                                        magnitude matches {|0.0..14.0|}
                                                        units matches {"[pH]"}
                                                    }
                                                }
                                            }
                                            ELEMENT[at0007] occurrences matches {0..1} matches {    -- Base excess
                                                value matches {
                                                    DV_QUANTITY[at9006] matches {
                                                        property matches {[at9001]}    -- Concentration
                                                        magnitude matches {|-30.0..30.0|}
                                                        units matches {"mmol/l"}
                                                    }
                                                }
                                            }
                                            ELEMENT[at0008] occurrences matches {0..1} matches {    -- Alveolar-arterial pO2 difference
                                                value matches {
                                                    DV_QUANTITY[at9007] matches {
                                                        property matches {[at9000]}    -- Pressure
                                                        magnitude matches {|0.0..1000.0|}
                                                        units matches {"kPa"}
                                                    }
                                                }
                                            }
                                            ELEMENT[at0015] occurrences matches {0..1} matches {    -- SaO2
                                                value matches {
                                                    DV_QUANTITY[at9008] matches {
                                                        property matches {[at9002]}    -- Proportion
                                                        magnitude matches {|0.0..100.0|}
                                                        units matches {"%"}
                                                    }
                                                }
                                            }
                                            ELEMENT[at0012] occurrences matches {0..1} matches {    -- Site
                                                value matches {
                                                    DV_CODED_TEXT[at9009] matches {
                                                        defining_code matches {[ac1]}    -- Any term that 'is_a' artery or cavity
                                                    }
                                                }
                                            }
                                            ELEMENT[at0018] occurrences matches {0..1} matches {    -- CaO2
                                                value matches {
                                                    DV_QUANTITY[at9010] matches {
                                                        property matches {[at9001]}    -- Concentration
                                                        magnitude matches {|>=0.0|}
                                                        units matches {"{VOLUME/VOLUME}"}
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    CLUSTER[at0013] occurrences matches {0..1} matches {    -- Venous
                                        items cardinality matches {0..4} matches {
                                            ELEMENT[at0016] occurrences matches {0..1} matches {    -- PvO2
                                                value matches {
                                                    DV_QUANTITY[at9011] matches {
                                                        property matches {[at9000]}    -- Pressure
                                                        magnitude matches {|0.0..1000.0|}
                                                        units matches {"kPa"}
                                                    }
                                                }
                                            }
                                            ELEMENT[at0017] occurrences matches {0..1} matches {    -- PvCO2
                                                value matches {
                                                    DV_QUANTITY[at9012] matches {
                                                        property matches {[at9000]}    -- Pressure
                                                        magnitude matches {|0.0..1000.0|}
                                                        units matches {"kPa"}
                                                    }
                                                }
                                            }
                                            ELEMENT[at0014] occurrences matches {0..1} matches {    -- Site
                                                value matches {
                                                    DV_CODED_TEXT[at9013] matches {
                                                        defining_code matches {[ac2]}    -- Any term that 'is_a' vein or cavity
                                                    }
                                                }
                                            }
                                            use_node ELEMENT[at9018] occurrences matches {1} /data[at0002]/events[at0003]/data[at0001]/items[at0011]/items[at0006]    -- Venous (synthesised)
                                        }
                                    }
                                    CLUSTER[at0019] occurrences matches {0..1} matches {    -- Capillary
                                        items cardinality matches {1..*; unordered} matches {
                                            use_node ELEMENT[at9015] occurrences matches {1} /data[at0002]/events[at0003]/data[at0001]/items[at0011]/items[at0006]
                                        }
                                    }
                                }
                            }
                        }
                        state matches {
                            ITEM_LIST[at0009] matches {
                                items matches {
                                    ELEMENT[at0010] occurrences matches {0..1} matches {    -- FiO2
                                        value matches {
                                            DV_QUANTITY[at9016] matches {
                                                property matches {[at9002]}    -- Proportion
                                                magnitude matches {|0.0..100.0|; 0.0}
                                                units matches {"%"; "%"}
                                                precision matches {0; 0}
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        protocol matches {
            ITEM_LIST[at0020] matches {
                items cardinality matches {0..*; unordered} matches {
                    ELEMENT[at0021] occurrences matches {0..1} matches {    -- Device
                        value matches {
                            DV_TEXT[at9017]
                        }
                    }
                }
            }
        }
    }

