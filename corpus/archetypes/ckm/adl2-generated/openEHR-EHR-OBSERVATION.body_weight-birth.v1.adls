definition
    OBSERVATION[at0000.1] occurrences matches {0..1} matches {    -- Body weight at birth
        /data[at0002]/events cardinality matches {1; unordered} matches {
            POINT_EVENT[at0003.1] occurrences matches {1} matches {    -- Birth
                offset matches {
                    DV_DURATION[at0.9005] matches {
                        value matches {PT0S; PT0S}
                    }
                }
                /data[at0001]/items matches {
                    ELEMENT[at0004.1] occurrences matches {0..1} matches {    -- Birth weight
                        value matches {
                            DV_QUANTITY[at0.9006] matches {
                                property matches {[at9000]}
                                [magnitude, units] matches {
                                    [{|0.0..10.0|}, {"kg"}],
                                    [{|0.0..10000.0|}, {"gm"}]
                                }
                            }
                        }
                    }
                    ELEMENT[at0024] matches {
                        value matches {
                            DV_TEXT[at0.9002]
                        }
                    }
                }
                /state[at0008]/items matches {
                    ELEMENT[at0009] matches {
                        value matches {
                            DV_CODED_TEXT[at0.9003] matches {
                                defining_code matches {[ac9001; at12]}
                            }
                        }
                    }
                    ELEMENT[at0025] matches {
                        value matches {
                            DV_TEXT[at0.9004]
                        }
                    }
                }
            }
        }
    }

