definition
    OBSERVATION[at0000] matches {    -- CHA₂DS₂-VASc score
        data matches {
            HISTORY[at0002] matches {    -- history
                events cardinality matches {1..*; unordered} matches {
                    EVENT[at0003] matches {    -- Any event
                        data matches {
                            ITEM_TREE[at0001] matches {    -- Tree
                                items cardinality matches {0..*; unordered} matches {
                                    ELEMENT[at0026] occurrences matches {0..1} matches {    -- Congestive Heart Failure
                                        value matches {
                                            DV_ORDINAL[at9003] matches {
                                                [value, symbol] matches {
                                                    [{0}, {[at0027]}],    -- Absent
                                                    [{1}, {[at0028]}]    -- Present
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0029] occurrences matches {0..1} matches {    -- Hypertension
                                        value matches {
                                            DV_ORDINAL[at9004] matches {
                                                [value, symbol] matches {
                                                    [{0}, {[at0027]}],    -- Absent
                                                    [{1}, {[at0028]}]    -- Present
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0032] occurrences matches {0..1} matches {    -- Diabetes
                                        value matches {
                                            DV_ORDINAL[at9005] matches {
                                                [value, symbol] matches {
                                                    [{0}, {[at0027]}],    -- Absent
                                                    [{1}, {[at0028]}]    -- Present
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0035] occurrences matches {0..1} matches {    -- Age
                                        value matches {
                                            DV_ORDINAL[at9006] matches {
                                                [value, symbol] matches {
                                                    [{0}, {[at0036]}],    -- Under 65
                                                    [{1}, {[at0037]}],    -- Between 65-74
                                                    [{2}, {[at0038]}]    -- Above or equals to 75
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0039] occurrences matches {0..1} matches {    -- Previous stroke
                                        value matches {
                                            DV_ORDINAL[at9007] matches {
                                                [value, symbol] matches {
                                                    [{0}, {[at0027]}],    -- Absent
                                                    [{2}, {[at0028]}]    -- Present
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0046] occurrences matches {0..1} matches {    -- Vascular disease
                                        value matches {
                                            DV_ORDINAL[at9008] matches {
                                                [value, symbol] matches {
                                                    [{0}, {[at0027]}],    -- Absent
                                                    [{1}, {[at0028]}]    -- Present
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0042] occurrences matches {0..1} matches {    -- Gender
                                        value matches {
                                            DV_ORDINAL[at9009] matches {
                                                [value, symbol] matches {
                                                    [{0}, {[at0043]}],    -- Male
                                                    [{1}, {[at0044]}]    -- Female
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0099] occurrences matches {0..1} matches {    -- Total score
                                        value matches {
                                            DV_COUNT[at9010] matches {
                                                magnitude matches {|0..9|}
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        protocol matches {
            ITEM_TREE[at0100] matches {
                items cardinality matches {0..*; unordered} matches {
                    allow_archetype CLUSTER[at0101] matches {    -- Extension
                        include
                            archetype_id/value matches {/.*/}
                    }
                }
            }
        }
    }

