terminology
    term_definitions = <
        ["en"] = <
            ["at0000"] = <
                text = <"Childhood Health Assessment Questionnaire">
                description = <"The Childhood Health Assessment Questionnaire for arthritis.">
            >
            ["at0002"] = <
                text = <"Point in time">
                description = <"A specific date and/or time which may be explicitly defined in a template or at run-time.">
            >
            ["at0004"] = <
                text = <"Dress">
                description = <"Assessment of child's ability to dress, including tying shoelaces and doing buttons.">
            >
            ["at0005"] = <
                text = <"Shampoo">
                description = <"Assessment of the child's ability to shampoo his or her hair.">
