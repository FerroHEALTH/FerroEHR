            >
            ["at0022"] = <
                text = <"No">
                description = <"">
            >
            ["at0023"] = <
                text = <"Yes">
                description = <"Mild or moderat or severe chronic pulmonary disease.">
            >
            ["at0024"] = <
                text = <"Ulcer disease">
