                description = <"Bekreftet AIDS eller sannsynlig AIDS ved for eksempel påvist AIDS-relatert tilstand.">
            >
            ["at0072"] = <
                text = <"CCI totalskår">
                description = <"Summen av poeng for hver enkelt parameter i Charlson Comorbidity Index.">
            >
            ["at0073"] = <
