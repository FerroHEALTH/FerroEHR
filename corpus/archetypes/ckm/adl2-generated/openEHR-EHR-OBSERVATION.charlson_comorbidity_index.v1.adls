            ["at0024"] = <
                text = <"Enfermedad ulcerosa">
                description = <"">
            >
            ["at0025"] = <
                text = <"No">
                description = <"">
            >
            ["at0026"] = <
                text = <"Sí">
                description = <"Antecedentes de tratamiento para enfermedad ulcerosa o de sangrado por úlcera, o antecedente de sangrado gastrointestinal que requirió transfusiones debido a causas distintas a la enfermedad ulcerosa.">
            >
