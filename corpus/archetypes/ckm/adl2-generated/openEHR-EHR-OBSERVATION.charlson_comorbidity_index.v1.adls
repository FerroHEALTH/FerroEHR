            ["at0041"] = <
                text = <"Ja">
                description = <"Moderat: kreatinin >3 mg/dL (0,27 mmol/L). Alvorlig: i dialyse, er transplantert, har uremi.">
            >
            ["at0045"] = <
                text = <"Solid svulst">
                description = <"">
