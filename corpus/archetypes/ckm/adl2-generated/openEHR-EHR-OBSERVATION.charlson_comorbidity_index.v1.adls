        ["es"] = <
            ["at0000"] = <
                text = <"Índice de Comorbilidad de Charlson (CCI)">
                description = <"Una herramienta de evaluación utilizada para predecir el riesgo de muerte por enfermedades comórbidas.">
            >
            ["at0002"] = <
                text = <"Cualquier evento">
                description = <"Por defecto, punto en el tiempo no especificado o evento de intervalo que puede ser definido explícitamente en una plantilla o durante la ejecución.">
            >
            ["at0006"] = <
                text = <"Enfermedad vascular periférica">
                description = <"">
            >
            ["at0007"] = <
                text = <"No">
                description = <"">
            >
            ["at0008"] = <
                text = <"Sí">
                description = <"Claudicación intermitente o bypass previo por insuficiencia arterial crónica, antecedentes de gangrena o insuficiencia arterial aguda, o aneurisma torácico o abdominal no tratado (≥6 cm).">
            >
            ["at0009"] = <
                text = <"Insuficiencia cardíaca congestiva">
                description = <"">
            >
            ["at0010"] = <
                text = <"No">
                description = <"">
            >
            ["at0011"] = <
                text = <"Sí">
                description = <"Disnea de esfuerzo o nocturna paroxística que ha respondido sintomáticamente (o en el examen físico) a digitálicos, diuréticos o agentes reductores de la poscarga.">
            >
            ["at0012"] = <
                text = <"Infarto de miocardio">
                description = <"">
            >
            ["at0013"] = <
                text = <"No">
                description = <"">
            >
            ["at0014"] = <
                text = <"Sí">
                description = <"Antecedentes de infarto de miocardio confirmado o probable (cambios en el ECG y/o cambios enzimáticos).">
            >
            ["at0015"] = <
                text = <"Enfermedad cerebrovascular">
                description = <"">
            >
            ["at0016"] = <
                text = <"No">
                description = <"">
            >
            ["at0017"] = <
                text = <"Sí">
                description = <"Antecedentes de accidente cerebrovascular (ACV) con secuelas menores o inexistentes y ataques isquémicos transitorios (AIT).">
            >
            ["at0018"] = <
                text = <"Demencia">
                description = <"">
            >
            ["at0019"] = <
