            >
            ["at0067"] = <
                text = <"Moderat til alvorlig">
                description = <"Moderat: Cirrhose med portal hypertensjon, men uten blødning. Alvorlig: Cirrhose med portal hypertensjon og variceblødning.">
            >
            ["at0068"] = <
                text = <"Organskade">
