    references = <
        ["1"] = <"Charlson ME, Pompei P, Ales KL, MacKenzie CR. A new method of classifying prognostic comorbidity in longitudinal studies: development and validation. J Chronic Dis. 1987;40(5):373-83. doi: 10.1016/0021-9681(87)90171-8. PubMed PMID: 3558716. Available from: https://www.sciencedirect.com/science/article/pii/0021968187901718?via%3Dihub.">
    >
    other_details = <
        ["MD5-CAM-1.0.1"] = <"38C82F4B20D86E6CCEC40BAB06F804D9">
    >
    details = <
        ["nb"] = <
            language = <[ISO_639-1::nb]>
            purpose = <"For å registrere resultatet for hver komponentparameter i Charlson Comorbidity Index (CCI) og dens totale sum, og for å beregne estimert overlevelsesrate etter 10 år.">
            keywords = <"CCI", "komorbiditet", "samtidige tilstander", "estimert overlevelse", "dødelighet", "multimorbiditet", "risiko", "prognose", "risikovurdering">
            use = <"Brukes for å registrere resultatet for hver komponentparameter i Charlson Comorbidity Index (CCI) og dens totale sum, og for å beregne estimert overlevelsesrate etter 10 år.

Datasettet og tilhørende verdier er fra den opprinnelige Charlson-studien i 1987.

I den originale artikkelen var det listet opp 19 tilstander, hvor flere hadde separate representasjoner av samme tilstand, men med ulik alvorlighetsgrad. I denne arketypen har disse tilstandene blitt gruppert sammen - for eksempel er de to tilstandene \"Mild leversykdom\" og \"Moderat til alvorlig leversykdom\" verdier gruppert under tilstanden \"Leversykdom\". Som et resultat er bare 16 tilstander representert i denne arketypen

Notat: Per dags dato finnes det ingen validert norsk oversettelse av verktøyet. Denne oversettelsen av arketypen er basert på ordlyden i diverse skjema på norsk og ved bruk av medisinske ordbøker og tilbakemeldinger fra den norske høringen av arketypen.">
            misuse = <"">
            copyright = <"© openEHR Foundation">
        >
        ["en"] = <
            language = <[ISO_639-1::en]>
            purpose = <"To record the result for each component parameter of the Charlson Comorbidity Index (CCI) and its total sum, and to calculate the 10 year estimated survival.">
            keywords = <"CCI", "comorbidity", "concurrent conditions", "estimated survival", "mortality", "prognosis", "assessment", "risk">
            use = <"To record the result for each component parameter of the Charlson Comorbidity Index (CCI) and its total sum, and to calculate the 10 year estimated survival.

This data and value set is from the original Charlson et al study in 1987.
In the original paper, 19 'conditions' were represented, including a number that had separate representations of the same condition, but with different severity. In this archetype, these conditions have been grouped together - for example, 'Mild liver disease' and 'Moderate to severe liver disease' are values under the condition 'Liver disease'. As a result, there are only 16 conditions represented in this archetype.">
            misuse = <"">
            copyright = <"© openEHR Foundation">
        >
        ["es"] = <
            language = <[ISO_639-1::es]>
            purpose = <"Registrar el resultado para cada parámetro componente del Índice de Comorbilidad de Charlson (CCI) y su suma total, y calcular la supervivencia estimada a 10 años.">
            keywords = <"CCI", "comorbilidad", "condiciones concurrentes", "supervivencia estimada", "mortalidad", "pronóstico", "evaluación", "riesgo">
            use = <"Registrar el resultado para cada parámetro componente del Índice de Comorbilidad de Charlson (CCI) y su suma total, y calcular la supervivencia estimada a 10 años.

Estos datos y el conjunto de valores provienen del estudio original de Charlson y colaboradores en 1987.
En el artículo original, se representaron 19 'enfermedades', incluyendo varias que tenían representaciones separadas de la misma condición, pero con diferente gravedad. En este arquetipo, estas condiciones se han agrupado juntas, por ejemplo, 'Enfermedad hepática leve' y 'Enfermedad hepática moderada a grave' son valores bajo la condición 'Enfermedad hepática'. Como resultado, este arquetipo representa solo 16 condiciones.">
            misuse = <"">
        >
    >

definition
    OBSERVATION[at0000] matches {    -- Charlson Comorbidity Index (CCI)
        data matches {
            HISTORY[at0001] matches {
                events cardinality matches {1..*; unordered} matches {
                    EVENT[at0002] matches {    -- Any event
                        data matches {
                            ITEM_TREE[at0003] matches {
                                items cardinality matches {0..*; unordered} matches {
                                    ELEMENT[at0061] occurrences matches {0..1} matches {    -- Age group
                                        value matches {
                                            DV_ORDINAL[at9018] matches {
                                                [value, symbol] matches {
                                                    [{0}, {[at0062]}],    -- <50 years
                                                    [{1}, {[at0063]}],    -- 50–59 years
                                                    [{2}, {[at0064]}],    -- 60-69 years
                                                    [{3}, {[at0065]}],    -- 70–79 years
                                                    [{4}, {[at0066]}]    -- ≥80 years
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0012] occurrences matches {0..1} matches {    -- Myocardial infarction
                                        value matches {
                                            DV_ORDINAL[at9019] matches {
                                                [value, symbol] matches {
                                                    [{0}, {[at0013]}],    -- No
                                                    [{1}, {[at0014]}]    -- Yes
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0009] occurrences matches {0..1} matches {    -- Congestive heart failure
                                        value matches {
                                            DV_ORDINAL[at9020] matches {
                                                [value, symbol] matches {
                                                    [{0}, {[at0010]}],    -- No
                                                    [{1}, {[at0011]}]    -- Yes
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0006] occurrences matches {0..1} matches {    -- Peripheral vascular disease
                                        value matches {
                                            DV_ORDINAL[at9021] matches {
                                                [value, symbol] matches {
                                                    [{0}, {[at0007]}],    -- No
                                                    [{1}, {[at0008]}]    -- Yes
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0015] occurrences matches {0..1} matches {    -- Cerebrovascular disease
                                        value matches {
                                            DV_ORDINAL[at9022] matches {
                                                [value, symbol] matches {
                                                    [{0}, {[at0016]}],    -- No
                                                    [{1}, {[at0017]}]    -- Yes
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0018] occurrences matches {0..1} matches {    -- Dementia
                                        value matches {
                                            DV_ORDINAL[at9023] matches {
                                                [value, symbol] matches {
                                                    [{0}, {[at0019]}],    -- No
                                                    [{1}, {[at0020]}]    -- Yes
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0021] occurrences matches {0..1} matches {    -- Chronic pulmonary disease
                                        value matches {
                                            DV_ORDINAL[at9024] matches {
                                                [value, symbol] matches {
                                                    [{0}, {[at0022]}],    -- No
                                                    [{1}, {[at0023]}]    -- Yes
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0024] occurrences matches {0..1} matches {    -- Ulcer disease
                                        value matches {
                                            DV_ORDINAL[at9025] matches {
                                                [value, symbol] matches {
                                                    [{0}, {[at0025]}],    -- No
                                                    [{1}, {[at0026]}]    -- Yes
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0027] occurrences matches {0..1} matches {    -- Liver disease
                                        value matches {
                                            DV_ORDINAL[at9026] matches {
                                                [value, symbol] matches {
                                                    [{0}, {[at0028]}],    -- None
                                                    [{1}, {[at0029]}],    -- Mild
                                                    [{3}, {[at0067]}]    -- Moderate to severe
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0030] occurrences matches {0..1} matches {    -- Connective tissue disease
                                        value matches {
                                            DV_ORDINAL[at9027] matches {
                                                [value, symbol] matches {
                                                    [{0}, {[at0031]}],    -- No
                                                    [{1}, {[at0032]}]    -- Yes
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0033] occurrences matches {0..1} matches {    -- Diabetes mellitus
                                        value matches {
                                            DV_ORDINAL[at9028] matches {
                                                [value, symbol] matches {
                                                    [{0}, {[at0034]}],    -- None or diet-controlled
                                                    [{1}, {[at0035]}],    -- Uncomplicated
                                                    [{2}, {[at0068]}]    -- End-organ damage
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0036] occurrences matches {0..1} matches {    -- Hemiplegia
                                        value matches {
                                            DV_ORDINAL[at9029] matches {
                                                [value, symbol] matches {
                                                    [{0}, {[at0037]}],    -- No
                                                    [{2}, {[at0038]}]    -- Yes
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0039] occurrences matches {0..1} matches {    -- Moderate or severe renal disease
                                        value matches {
                                            DV_ORDINAL[at9030] matches {
                                                [value, symbol] matches {
                                                    [{0}, {[at0040]}],    -- No
                                                    [{2}, {[at0041]}]    -- Yes
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0045] occurrences matches {0..1} matches {    -- Solid tumor
                                        value matches {
                                            DV_ORDINAL[at9031] matches {
                                                [value, symbol] matches {
                                                    [{0}, {[at0046]}],    -- None
                                                    [{2}, {[at0048]}],    -- Localized
                                                    [{6}, {[at0069]}]    -- Metastatic
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0047] occurrences matches {0..1} matches {    -- Leukemia
                                        value matches {
                                            DV_ORDINAL[at9032] matches {
                                                [value, symbol] matches {
                                                    [{0}, {[at0049]}],    -- No
                                                    [{2}, {[at0051]}]    -- Yes
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0050] occurrences matches {0..1} matches {    -- Lymphoma
                                        value matches {
                                            DV_ORDINAL[at9033] matches {
                                                [value, symbol] matches {
                                                    [{0}, {[at0052]}],    -- No
                                                    [{2}, {[at0053]}]    -- Yes
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0060] occurrences matches {0..1} matches {    -- AIDS
                                        value matches {
                                            DV_ORDINAL[at9034] matches {
                                                [value, symbol] matches {
                                                    [{0}, {[at0070]}],    -- No
                                                    [{6}, {[at0071]}]    -- Yes
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0072] occurrences matches {0..1} matches {    -- CCI total score
                                        value matches {
                                            DV_COUNT[at9035]
                                        }
                                    }
                                    ELEMENT[at0073] occurrences matches {0..1} matches {    -- Estimated 10-year survival
                                        value matches {
                                            DV_QUANTITY[at9036] matches {
                                                property matches {[at9017]}    -- Qualified real
                                                units matches {"%"}
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        protocol matches {
            ITEM_TREE[at9037] matches {
                items cardinality matches {0..*; unordered} matches {
                    allow_archetype CLUSTER[at0074] matches {    -- Extension
                        include
                            archetype_id/value matches {/.*/}
                    }
                }
            }
        }
    }

terminology
    term_definitions = <
        ["nb"] = <
            ["at0000"] = <
                text = <"Charlson Comorbidity Index (CCI)">
                description = <"Et verktøy som brukes til å forutsi risikoen for død som følge av komorbide faktorer.">
            >
            ["at0002"] = <
                text = <"Uspesifisert hendelse">
                description = <"Standard uspesifisert tidspunkt- eller intervallhendelse som kan defineres mer eksplisitt i et templat eller i en applikasjon.">
            >
            ["at0006"] = <
                text = <"Perifere vaskulære sykdommer">
                description = <"">
            >
            ["at0007"] = <
                text = <"Nei">
                description = <"">
            >
            ["at0008"] = <
                text = <"Ja">
                description = <"Claudicatio intermittens, tidligere bypass på grunn av arteriell insuffisiens, tidligere gangren eller akutt arteriell insuffisiens, ubehandlet thorakalt og/eller abdominalt aneurisme (≥6 cm).">
            >
            ["at0009"] = <
                text = <"Kronisk hjertesvikt">
                description = <"">
            >
            ["at0010"] = <
                text = <"Nei">
                description = <"">
            >
            ["at0011"] = <
                text = <"Ja">
                description = <"Anstrengelsesdyspné eller paroksysmal nattlig dyspné og har respondert symptomatisk (eller ved fysisk undersøkelse) på digitalis, diuretika eller midler som reduserer afterload.">
            >
            ["at0012"] = <
                text = <"Myokardinfarkt">
                description = <"">
            >
            ["at0013"] = <
                text = <"Nei">
                description = <"">
            >
            ["at0014"] = <
                text = <"Ja">
                description = <"Tidligere diagnostisert eller sannsynlig hjerteinfarkt (EKG-forandringer og/eller enzymforandringer).">
            >
            ["at0015"] = <
                text = <"Cerebrovaskulær hendelse">
                description = <"">
            >
            ["at0016"] = <
                text = <"Nei">
                description = <"">
            >
            ["at0017"] = <
                text = <"Ja">
                description = <"Cerebrovaskulær hendelse (CVA) eller transitorisk iskemisk anfall (TIA).">
            >
            ["at0018"] = <
                text = <"Demens">
                description = <"">
            >
            ["at0019"] = <
                text = <"Nei">
                description = <"">
            >
            ["at0020"] = <
                text = <"Ja">
                description = <"Demens eller kronisk kognitiv svikt.">
            >
            ["at0021"] = <
                text = <"Kronisk lungesykdom">
                description = <"">
            >
            ["at0022"] = <
                text = <"Nei">
                description = <"">
            >
            ["at0023"] = <
                text = <"Ja">
                description = <"Mild, moderat eller alvorlig kronisk lungesykdom.">
            >
            ["at0024"] = <
                text = <"Ulcussykdom">
                description = <"">
            >
            ["at0025"] = <
                text = <"Nei">
                description = <"">
            >
            ["at0026"] = <
                text = <"Ja">
                description = <"Enhver behandling av magesårsykdom, blødende magesår,  eller tidligere transfusjonskrevende behandling av gastrointestinal blødning.">
            >
            ["at0027"] = <
                text = <"Leversykdom">
                description = <"">
            >
            ["at0028"] = <
                text = <"Ingen">
                description = <"">
            >
            ["at0029"] = <
                text = <"Mild">
                description = <"Cirrhose uten portal hypertensjon eller kronisk hepatitt.">
            >
            ["at0030"] = <
                text = <"Bindevevssykdom">
                description = <"">
            >
            ["at0031"] = <
                text = <"Nei">
                description = <"">
            >
            ["at0032"] = <
                text = <"Ja">
                description = <"">
            >
            ["at0033"] = <
                text = <"Diabetes">
                description = <"">
            >
            ["at0034"] = <
                text = <"Ingen eller diettkontrollert">
                description = <"">
            >
            ["at0035"] = <
                text = <"Ukompliser">
                description = <"Diabetes behandlet med insulin eller orale hypoglykemiske midler, men ikke diett alene.">
            >
            ["at0036"] = <
                text = <"Hemiplegi">
                description = <"">
