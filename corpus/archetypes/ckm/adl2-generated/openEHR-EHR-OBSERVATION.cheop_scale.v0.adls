    references = <
        ["1"] = <"Blount RL, Loiselle KA. Behavioural assessment of pediatric pain. Pain Res Manag. 2009 Jan-Feb;14(1):47-52. doi: 10.1155/2009/348184. PMID: 19262916; PMCID: PMC2706564.">
        ["2"] = <"McGrath PJ, Johnson G, Goodman JT, Dunn J, Chapman J. CHEOPS: A behavioral scale for rating postoperative pain in children. In: Fields HL, Dubner R, Cervero F, eds. Advances in Pain Research and Therapy. New York: Raven Press, 1985:395-402.">
    >
