                description = <"Zusätzliche Informationen zur Erfassung lokaler Inhalte oder Anpassung an andere Referenzmodelle/Formalismen.">
                comment = <"Lokaler Informationsbedarf oder zusätzliche Metadaten zur Anpassung an FHIR-Ressourcen oder CIMI-Modelle.">
            >
            ["ac9015"] = <
                text = <"Gesamtbilirubin (synthesised)">
                description = <"Score für das Gesamtbilirubin in Mikromol pro Liter [μmol/l]. (synthesised)">
            >
            ["ac9016"] = <
                text = <"Serumalbumin (synthesised)">
                description = <"Score für das Serumalbumin in Gramm pro Liter [g/l]. (synthesised)">
            >
            ["ac9017"] = <
                text = <"INR (synthesised)">
                description = <"Score für den INR. (synthesised)">
            >
            ["ac9018"] = <
                text = <"Aszites (synthesised)">
                description = <"Score für die Ausprägung eines Aszites. (synthesised)">
            >
            ["ac9019"] = <
                text = <"Hepatische Enzephalopathie (synthesised)">
                description = <"Score für die Ausprägung einer hepatischen Enzephalopathie. (synthesised)">
            >
            ["ac9020"] = <
                text = <"Angepasstes Gesamtbilirubin (synthesised)">
                description = <"Score für ein angepasstes Gesamtbilirubin wenn der Patient unter primär biliären Cholangitis oder primär sklerosierenden Cholangitis leidet. (synthesised)">
            >
            ["ac9006"] = <
                text = <"Stadium (synthesised)">
                description = <"Das anhand des Gesamtscore vergebene Stadium. (synthesised)">
            >
        >
        ["en"] = <
            ["at0000"] = <
                text = <"Child-Pugh score">
                description = <"Tool used to assess the prognosis of chronic liver disease, mainly cirrhosis.">
            >
            ["at0002"] = <
