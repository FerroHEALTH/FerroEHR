                description = <"">
            >
            ["at0074"] = <
                text = <"≥80%">
                description = <"">
            >
            ["at0076"] = <
                text = <"Sumskår">
                description = <"Summen av poeng for hver enkelt delfunksjon i Chelsea Critical Care Physical Assessment Tool.">
            >
            ["at0078"] = <
                text = <"Tilleggsinformasjon">
                description = <"Ytterligere informasjon som trengs for å kunne registrere lokalt definert innhold eller for å tilpasse til andre referansemodeller/formalismer.">
                comment = <"For eksempel lokale informasjonsbehov eller ytterligere metadata for å kunne tilpasse til tilsvarende konsepter i FHIR.">
            >
            ["ac9019"] = <
                text = <"Respiratorisk funksjon (synthesised)">
                description = <" (synthesised)">
            >
            ["ac9020"] = <
                text = <"Hoste (synthesised)">
                description = <" (synthesised)">
            >
            ["ac9021"] = <
                text = <"Forflytning i seng f.eks. snu seg (synthesised)">
                description = <" (synthesised)">
            >
            ["ac9022"] = <
                text = <"Liggende til sittende på sengekant (synthesised)">
                description = <" (synthesised)">
            >
            ["ac9023"] = <
                text = <"Sittebalanse (dvs. sitter på sengekanten/ sitter uten støtte) (synthesised)">
                description = <" (synthesised)">
            >
            ["ac9024"] = <
                text = <"Stående balanse (synthesised)">
                description = <" (synthesised)">
            >
            ["ac9025"] = <
                text = <"Sittende til stående (Utgangsstilling: ≤90 grader hoftefleksjon) (synthesised)">
                description = <" (synthesised)">
            >
            ["ac9026"] = <
                text = <"Forflytning fra seng til stol (synthesised)">
                description = <" (synthesised)">
            >
            ["ac9027"] = <
                text = <"Gange (synthesised)">
                description = <" (synthesised)">
            >
            ["ac9028"] = <
                text = <"Gripestyrke (predikert gjennomsnitt for alder og kjønn for den sterkeste hånden) (synthesised)">
                description = <" (synthesised)">
            >
        >
        ["en"] = <
            ["at0000"] = <
                text = <"Chelsea Critical Care Physical Assessment (CPAx) tool">
                description = <"A scoring system to measure physical morbidity in critical care.">
            >
            ["at0002"] = <
                text = <"Any event">
                description = <"Default, unspecified point in time or interval event which may be explicitly defined in a template or at run-time.">
            >
            ["at0004"] = <
                text = <"Respiratory function">
                description = <"">
            >
            ["at0005"] = <
                text = <"Complete ventilator dependence. Mandatory breaths only. May be fully sedated/ paralysed">
                description = <"">
            >
            ["at0006"] = <
                text = <"Ventilator dependence. Mandatory breaths with some spontaneous effort">
                description = <"">
            >
            ["at0007"] = <
                text = <"Spontaneously breathing with continuous invasive or non-invasive ventilatory support">
                description = <"">
            >
