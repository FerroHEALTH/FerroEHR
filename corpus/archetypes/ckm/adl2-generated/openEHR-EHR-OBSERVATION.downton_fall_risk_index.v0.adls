definition
    OBSERVATION[at0000] matches {    -- Downton Fall Risk Index (DFRI)
        data matches {
            HISTORY[at0001] matches {
                events cardinality matches {1..*; unordered} matches {
                    EVENT[at0002] occurrences matches {0..1} matches {    -- Any event
                        data matches {
                            ITEM_TREE[at0003] matches {
                                items cardinality matches {0..*; unordered} matches {
                                    ELEMENT[at0004] occurrences matches {0..1} matches {    -- Known previous falls
                                        value matches {
                                            DV_ORDINAL[at9005] matches {
                                                [value, symbol] matches {
                                                    [{0}, {[at0005]}],    -- No
                                                    [{1}, {[at0006]}]    -- Yes
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0007] occurrences matches {0..5} matches {    -- Medications
                                        value matches {
                                            DV_ORDINAL[at9006] matches {
                                                [value, symbol] matches {
                                                    [{0}, {[at0008]}],    -- None
                                                    [{1}, {[at0009]}],    -- Tranquillisers/sedatives
                                                    [{1}, {[at0010]}],    -- Diuretics
                                                    [{1}, {[at0011]}],    -- Antihypertensives (other than diuretics)
                                                    [{1}, {[at0012]}],    -- Antiparkinsonian drugs
                                                    [{1}, {[at0013]}],    -- Antidepressants
                                                    [{0}, {[at0014]}]    -- Other medications
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0015] occurrences matches {0..3} matches {    -- Sensory deficits
                                        value matches {
                                            DV_ORDINAL[at9007] matches {
                                                [value, symbol] matches {
                                                    [{0}, {[at0016]}],    -- None
                                                    [{1}, {[at0017]}],    -- Visual impairment
                                                    [{1}, {[at0018]}],    -- Hearing impairment
                                                    [{1}, {[at0019]}]    -- Limbs (amputation, stroke, neuropathy, etc.)
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0020] occurrences matches {0..1} matches {    -- Mental state
                                        value matches {
                                            DV_ORDINAL[at9008] matches {
                                                [value, symbol] matches {
                                                    [{0}, {[at0021]}],    -- Orientated
                                                    [{1}, {[at0022]}]    -- Confused (MTS <7/10)
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0023] occurrences matches {0..1} matches {    -- Gait
                                        value matches {
                                            DV_ORDINAL[at9009] matches {
                                                [value, symbol] matches {
                                                    [{0}, {[at0024]}],    -- Normal
                                                    [{0}, {[at0025]}],    -- Safe with walking aids
                                                    [{1}, {[at0026]}],    -- Unsafe with/without aids
                                                    [{0}, {[at0027]}]    -- Unable
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0028] occurrences matches {0..1} matches {    -- Total score
                                        value matches {
                                            DV_COUNT[at9010] matches {
                                                magnitude matches {|0..11|}
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        protocol matches {
            ITEM_TREE[at0029] matches {
                items cardinality matches {0..*; unordered} matches {
                    allow_archetype CLUSTER[at0030] matches {    -- Extension
                        include
                            archetype_id/value matches {/.*/}
                    }
                }
            }
        }
    }

