    details = <
        ["en"] = <
            language = <[ISO_639-1::en]>
            purpose = <"To record details of the Atopic dermatitis EASI score.">
            use = <"">
            misuse = <"">
            copyright = <"© openEHR Foundation">
        >
    >

definition
    OBSERVATION[at0000] matches {    -- EASI score
        data matches {
            HISTORY[at0001] matches {
                events cardinality matches {1..*; unordered} matches {
                    EVENT[at0002] matches {    -- Any event
                        data matches {
                            ITEM_TREE[at0003] matches {
                                items cardinality matches {0..*; unordered} matches {
                                    CLUSTER[at0004] matches {    -- Body area
                                        name matches {
                                            DV_CODED_TEXT[at9004] matches {
                                                defining_code matches {[ac9000]}    -- Body area (synthesised)
                                            }
                                        }
                                        items cardinality matches {1..*; unordered} matches {
                                            ELEMENT[at0009] matches {    -- Severity index
                                                name matches {
                                                    DV_CODED_TEXT[at9005] matches {
                                                        defining_code matches {[ac9001]}    -- Severity index (synthesised)
                                                    }
                                                }
                                                value matches {
                                                    DV_ORDINAL[at9006] matches {
                                                        [value, symbol] matches {
                                                            [{0}, {[at0014]}],    -- Absent
                                                            [{1}, {[at0015]}],    -- Mild
                                                            [{2}, {[at0016]}],    -- Moderate
                                                            [{3}, {[at0017]}]    -- Severe
                                                        }
                                                    }
                                                }
                                            }
                                            ELEMENT[at0018] occurrences matches {0..1} matches {    -- Affected area
                                                value matches {
                                                    DV_ORDINAL[at9007] matches {
                                                        [value, symbol] matches {
                                                            [{0}, {[at0019]}],    -- 1% to 9%
                                                            [{1}, {[at0020]}],    -- 10% to 29%
                                                            [{2}, {[at0021]}],    -- 30% to 49%
                                                            [{3}, {[at0022]}],    -- 50% to 69%
                                                            [{4}, {[at0023]}],    -- 70% to 89%
                                                            [{5}, {[at0024]}]    -- 90% to 100%
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0025] occurrences matches {0..1} matches {    -- Total EASI score
                                        value matches {
                                            DV_COUNT[at9008] matches {
                                                magnitude matches {|0..72|}
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        protocol matches {
            ITEM_TREE[at0026] matches {
                items cardinality matches {0..*; unordered} matches {
                    allow_archetype CLUSTER[at0027] matches {    -- Extension
                        include
                            archetype_id/value matches {/.*/}
                    }
                }
            }
        }
    }

