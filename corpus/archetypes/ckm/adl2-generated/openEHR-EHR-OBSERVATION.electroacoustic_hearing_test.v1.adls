definition
    OBSERVATION[at0000] matches {    -- Electroacoustic Hearing Test
        data matches {
            HISTORY[at0001] matches {
                events cardinality matches {1..*; unordered} matches {
                    EVENT[at0002] occurrences matches {0..1} matches {    -- Any event
                        data matches {
                            ITEM_TREE[at0003] matches {
                                items cardinality matches {0..*; unordered} matches {
                                    ELEMENT[at0004] occurrences matches {0..1} matches {    -- Test
                                        value matches {
                                            DV_CODED_TEXT[at9015] matches {
                                                defining_code matches {[ac9000]}    -- Test (synthesised)
                                            }
                                        }
                                    }
                                    CLUSTER[at0037] occurrences matches {0..1} matches {    -- Normal Statements
                                        items cardinality matches {1..*; unordered} matches {
                                            ELEMENT[at0027] occurrences matches {0..1} matches {    -- Normal statement
                                                value matches {
                                                    DV_CODED_TEXT[at9016] matches {
                                                        defining_code matches {[ac9001]}    -- Normal statement (synthesised)
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    CLUSTER[at0010] matches {    -- Details
                                        items cardinality matches {1..*; unordered} matches {
                                            ELEMENT[at0040] occurrences matches {0..1} matches {    -- Screening Outcome
                                                value matches {
                                                    DV_CODED_TEXT[at9017] matches {
                                                        defining_code matches {[ac9002]}    -- Screening Outcome (synthesised)
                                                    }
                                                }
                                            }
                                            ELEMENT[at0007] occurrences matches {0..1} matches {    -- Side
                                                value matches {
                                                    DV_CODED_TEXT[at9018] matches {
                                                        defining_code matches {[ac9003]}    -- Side (synthesised)
                                                    }
                                                }
                                            }
                                            ELEMENT[at0015] occurrences matches {0..1} matches {    -- Intensity of stimulus
                                                value matches {
                                                    DV_CODED_TEXT[at9019] matches {
                                                        defining_code matches {[ac9004]}    -- Intensity of stimulus (synthesised)
                                                    }
                                                    DV_COUNT[at9020]
                                                }
                                            }
                                            ELEMENT[at0023] occurrences matches {0..1}    -- Result
                                        }
                                    }
                                    ELEMENT[at0012] occurrences matches {0..1} matches {    -- Image of result
                                        value matches {
                                            DV_MULTIMEDIA[at9021] matches {
                                                media_type matches {[ac9010]}    -- Image of result (synthesised)
                                            }
                                        }
                                    }
                                    ELEMENT[at0011] occurrences matches {0..1} matches {    -- Comment
                                        value matches {
                                            DV_TEXT[at9022]
                                        }
                                    }
                                }
                            }
                        }
                        state matches {
                            ITEM_TREE[at0024] matches {
                                items cardinality matches {0..*; unordered} matches {
                                    ELEMENT[at0025] occurrences matches {0..1} matches {    -- Stimulus presentation
                                        value matches {
                                            DV_CODED_TEXT[at9023] matches {
                                                defining_code matches {[ac9011]}    -- Stimulus presentation (synthesised)
                                            }
                                        }
                                    }
                                    ELEMENT[at0032] occurrences matches {0..1} matches {    -- Masking
                                        value matches {
                                            DV_CODED_TEXT[at9024] matches {
                                                defining_code matches {[ac9012]}    -- Masking (synthesised)
                                            }
                                        }
                                    }
                                    ELEMENT[at0046] occurrences matches {0..1} matches {    -- Stimulus Frequency
                                        value matches {
                                            DV_QUANTITY[at9025] matches {
                                                property matches {[at9013]}    -- Frequency
                                                [units] matches {
                                                    [{"Hz"}],
                                                    [{"kHz"}]
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        protocol matches {
            ITEM_LIST[at0013] matches {
                items cardinality matches {0..*; unordered} matches {
                    ELEMENT[at0014] occurrences matches {0..1} matches {    -- Transducer
                        value matches {
                            DV_TEXT[at9026]
                        }
                    }
