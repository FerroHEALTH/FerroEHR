    openEHR-EHR-OBSERVATION.empower_meal.v0.0.1-alpha

language
    original_language = <[ISO_639-1::en]>

description
    original_author = <
        ["name"] = <"Hans Demski">
        ["organisation"] = <"Helmholtz Zentrum München GmbH">
        ["email"] = <"demski@helmholtz-muenchen.de">
        ["date"] = <"2015-04-21">
    >
    original_namespace = <"org.openehr">
    original_publisher = <"openEHR Foundation">
    other_contributors = <"based on the data model developed within the EMPOWER project, www.empower-fp7,eu", ...>
    lifecycle_state = <"in_development">
    custodian_namespace = <"org.openehr">
    custodian_organisation = <"openEHR Foundation">
    licence = <"This work is licensed under the Creative Commons Attribution-ShareAlike 3.0 License. To view a copy of this license, visit http://creativecommons.org/licenses/by-sa/3.0/.">
    other_details = <
        ["MD5-CAM-1.0.1"] = <"A893F4BC3F4CA164E77D808FBC147821">
    >
    details = <
        ["en"] = <
            language = <[ISO_639-1::en]>
            purpose = <"Recording of observations of daily lifing related to meals.

Based on the data model developed within the EMPOWER project, www.empower-fp7,eu.">
            use = <"Record the self-observations of the subject regarding the intake of food.">
            misuse = <"">
            copyright = <"© openEHR Foundation">
        >
    >

definition
    OBSERVATION[at0000] matches {    -- Meal (EMPOWER)
        data matches {
            HISTORY[at0001] matches {
                events cardinality matches {1..*; unordered} matches {
                    EVENT[at0002] occurrences matches {0..1} matches {    -- Any Event
                        data matches {
                            ITEM_TREE[at0003] matches {
                                items cardinality matches {1..*; unordered} matches {
                                    ELEMENT[at0004] occurrences matches {1} matches {    -- Time of meal
                                        value matches {
                                            DV_CODED_TEXT[at9003] matches {
                                                defining_code matches {[ac9000]}    -- Time of meal (synthesised)
                                            }
                                        }
                                    }
                                    CLUSTER[at0009] matches {    -- Food items
                                        items cardinality matches {1..*; unordered} matches {
                                            ELEMENT[at0012] occurrences matches {0..1} matches {    -- Amount
                                                value matches {
                                                    DV_COUNT[at9004]
                                                }
                                            }
                                            ELEMENT[at0013] occurrences matches {0..1} matches {    -- Unit
                                                value matches {
                                                    DV_CODED_TEXT[at9005] matches {
                                                        defining_code matches {[ac9001]}    -- Unit (synthesised)
                                                    }
                                                }
                                            }
                                            ELEMENT[at0020] occurrences matches {1} matches {    -- Description
                                                value matches {
                                                    DV_TEXT[at9006]
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0010] occurrences matches {0..1} matches {    -- Bread units
                                        value matches {
                                            DV_QUANTITY[at9007] matches {
                                                property matches {[at9002]}    -- Qualified real
                                                units matches {"BE"}
                                                precision matches {0}
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

