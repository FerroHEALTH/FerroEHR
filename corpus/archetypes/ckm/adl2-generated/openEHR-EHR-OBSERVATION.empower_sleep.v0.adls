archetype (adl_version=2.4.0; rm_release=1.1.0; generated; uid=f71bc0f7-c6e6-4642-b6d8-a4039482a50a; build_uid=498c8566-cd16-4a2f-910a-133c39f3ebd5)
    openEHR-EHR-OBSERVATION.empower_sleep.v0.0.1-alpha

language
    original_language = <[ISO_639-1::en]>

description
    original_author = <
        ["name"] = <"Ilias Lamprinos">
        ["organisation"] = <"Intracom Telecom">
