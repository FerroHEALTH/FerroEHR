    ip_acknowledgements = <
        ["1"] = <"The specific content of this Expanded Prostate cancer Index Composite for Clinical Practice (EPIC-CP) archetype is copyright protected. Any use of this archetype within implementations must be in compliance with the terms established by the copyright owners. Commercial use license inquiries can be directed to the University of Michigan as outlined below. Copyright statement: © 2000 The Regents of the University of Michigan, Regents of the University of California, Emory University and Cedars-Sinai. All rights reserved. Copyright information: MImeasures@umich.edu">
    >
    references = <
        ["1"] = <"Chang P, Szymanski KM, Dunn RL, Chipman JJ, Litwin MS, Nguyen PL, Sweeney CJ, Cook R, Wagner AA, DeWolf WC, Bubley GJ, Funches R, Aronovitz JA, Wei JT, Sanda MG. Expanded prostate cancer index composite for clinical practice: development and validation of a practical health related quality of life instrument for use in the routine clinical care of patients with prostate cancer. J Urol. 2011 Sep;186(3):865-72. doi: 10.1016/j.juro.2011.04.085. Epub 2011 Jul 23. PubMed PMID: 21788038; PubMed Central PMCID: PMC3807735.">
        ["2"] = <"Chipman JJ, Sanda MG, Dunn RL, Wei JT, Litwin MS, Crociani CM, Regan MM, Chang P. Measuring and predicting prostate cancer related quality of life changes using EPIC for clinical practice. J Urol. 2014 Mar;191(3):638-45. doi: 10.1016/j.juro.2013.09.040. Epub 2013 Sep 25. PubMed PMID: 24076307; PubMed Central PMCID: PMC5006995.">
    >
    other_details = <
        ["MD5-CAM-1.0.1"] = <"8557038CDD0AE74478F0A96DCFB79F38">
    >
    details = <
        ["nb"] = <
            language = <[ISO_639-1::nb]>
            purpose = <"For å registere resultater fra det helserelaterte livkvalitetsspørreskjemaet EPIC-CP (HRQoL) for pasienter med prostatakreft.">
            keywords = <"prostatakreft", "livskvalitet", "spørreskjema", "QoL", "HRQoL", "PROM", "selvrapportert">
            use = <"Brukes for å registere resultater fra det helserelaterte livkvalitetsspørreskjemaet (HRQoL) EPIC-CP for pasienter med prostatakreft.

EPIC-CP livskvalitetsspørreskjemaet er basert på de 26 spørsmålene i Extended Prostate Cancer Index Composite (EPIC-26) og komprimert til et spørreskjema med 16 spørsmål, og er spesifikt designed til å brukes i rutinemessig klinisk behandling hos pasienter som har prostatakreft.

Selv om denne arketypen normalt vil bli brukt i COMPOSITION.self_reported_data (Selvrapporterte data), kan det avhengig av situasjonen begrunnes å bruke en annen COMPOSITION.

Selv om alle arketyper fra openEHR er gratis tilgjengelig under en åpen lisens, er det spesifikke innholdet i denne Expanded Prostate Cancer Index Composite for Clinical Practice (EPIC-CP) opphavsrettbeskyttet. Enhver bruk av denne arketypen i en implementasjon må være i henhold til kravene som er satt av eierne av opphavsretten. Spørsmål om lisenser for kommersiell bruk kan rettes til University of Michigan som beskrevet nedenfor. Copyright statement: © 2000 The Regents of the University of Michigan, Regents of the University of California, Emory University and Cedars-Sinai. All rights reserved. Copyright information: MImeasures@umich.edu.

Det finnes ingen validert norsk oversettelse. Den validerte oversettelsen av EPIC-26 (Short form) er brukt som mal, i tillegg til EG Checkware Norge sin versjon.">
            misuse = <"">
            copyright = <"© openEHR Foundation">
        >
        ["en"] = <
            language = <[ISO_639-1::en]>
            purpose = <"To record the results from the EPIC-CP health-related quality of life (HRQoL) questionnaire in patients with prostate cancer.">
            keywords = <"prostate cancer", "quality of life", "QOL", "HRQoL", "PROM", "self reported">
            use = <"Use to record the results from the EPIC-CP health-related quality of life (HRQoL) questionnaire in patients with prostate cancer.

The EPIC-CP questionnaire is based on the 26-item Extended Prostate Cancer Index Composite (EPIC-26) and reduced to a 16-item questionnaire specifically designed for use in the routine clinical care of prostate cancer patients.

While this archetype normally will reside in COMPOSITION.self_reported_data, it might be justified to use an other COMPOSITION depending on the situation.

While openEHR archetypes are all freely available under an open license, the specific content of this Expanded Prostate Cancer Index Composite for Clinical Practice (EPIC-CP) archetype is copyright protected. Any use of this archetype within implementations must be in compliance with the terms established by the copyright owners. Commercial use license inquiries can be directed to the University of Michigan as outlined below. Copyright statement: © 2000 The Regents of the University of Michigan, Regents of the University of California, Emory University and Cedars-Sinai. All rights reserved. Copyright information: MImeasures@umich.edu.">
            misuse = <"">
            copyright = <"© openEHR Foundation, © 2000 The Regents of the University of Michigan, Regents of the University of California, Emory University and Cedars-Sinai.">
        >
    >

definition
    OBSERVATION[at0000] matches {    -- Expanded Prostate Cancer Index Composite for Clinical Practice (EPIC-CP)
        data matches {
            HISTORY[at0001] matches {
                events cardinality matches {1..*; unordered} matches {
                    EVENT[at0002] matches {    -- Any event
                        data matches {
                            ITEM_TREE[at0003] matches {
                                items cardinality matches {0..*; unordered} matches {
                                    ELEMENT[at0004] occurrences matches {0..1} matches {    -- 1. Overall, how much of a problem has your urinary function been for you?
                                        value matches {
                                            DV_CODED_TEXT[at9016] matches {
                                                defining_code matches {[ac9000]}    -- 1. Overall, how much of a problem has your urinary function been for you? (synthesised)
                                            }
                                        }
                                    }
                                    ELEMENT[at0005] occurrences matches {0..1} matches {    -- 2. Which of the following best describes your urinary control?
                                        value matches {
                                            DV_ORDINAL[at9017] matches {
                                                [value, symbol] matches {
                                                    [{0}, {[at0031]}],    -- Total control
                                                    [{1}, {[at0032]}],    -- Occasional dribbling
                                                    [{2}, {[at0033]}],    -- Frequent dribbling
                                                    [{4}, {[at0034]}]    -- No urinary control
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0006] occurrences matches {0..1} matches {    -- 3. How many pads or adult diapers per day have you been using for urinary leakage?
                                        value matches {
                                            DV_ORDINAL[at9018] matches {
                                                [value, symbol] matches {
                                                    [{0}, {[at0035]}],    -- None
                                                    [{1}, {[at0036]}],    -- One pad per day
                                                    [{2}, {[at0037]}],    -- Two pads per day
                                                    [{4}, {[at0038]}]    -- Three or more pads per day
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0007] occurrences matches {0..1} matches {    -- 4. How big a problem, if any, has urinary dripping or leakage been for you?
                                        value matches {
                                            DV_ORDINAL[at9019] matches {
                                                [value, symbol] matches {
                                                    [{0}, {[at0039]}],    -- No problem
                                                    [{1}, {[at0040]}],    -- Very small problem
                                                    [{2}, {[at0041]}],    -- Small problem
                                                    [{3}, {[at0042]}],    -- Moderate problem
                                                    [{4}, {[at0043]}]    -- Big problem
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0008] occurrences matches {0..1} matches {    -- Urinary Incontinence Symptom Score
                                        value matches {
                                            DV_COUNT[at9020] matches {
                                                magnitude matches {|0..12|}
                                            }
                                        }
                                    }
                                    CLUSTER[at0105] occurrences matches {0..1} matches {    -- 5. How big a problem, if any, has each of the following been for you?
                                        items cardinality matches {1..*; unordered} matches {
                                            ELEMENT[at0009] occurrences matches {0..1} matches {    -- 5a. Pain or burning with urination
                                                value matches {
                                                    DV_ORDINAL[at9038] matches {
                                                        [value, symbol] matches {
                                                            [{0}, {[at0044]}],    -- No problem
                                                            [{1}, {[at0045]}],    -- Very small problem
                                                            [{2}, {[at0046]}],    -- Small problem
                                                            [{3}, {[at0047]}],    -- Moderate problem
                                                            [{4}, {[at0048]}]    -- Big problem
                                                        }
                                                    }
                                                }
                                            }
                                            ELEMENT[at0010] occurrences matches {0..1} matches {    -- 5b. Weak urine stream/incomplete bladder emptying
                                                value matches {
                                                    DV_ORDINAL[at9039] matches {
                                                        [value, symbol] matches {
                                                            [{0}, {[at0049]}],    -- No problem
                                                            [{1}, {[at0050]}],    -- Very small problem
                                                            [{2}, {[at0051]}],    -- Small problem
                                                            [{3}, {[at0052]}],    -- Moderate problem
                                                            [{4}, {[at0053]}]    -- Big problem
                                                        }
                                                    }
                                                }
                                            }
                                            ELEMENT[at0011] occurrences matches {0..1} matches {    -- 5c. Need to urinate frequently
                                                value matches {
                                                    DV_ORDINAL[at9040] matches {
                                                        [value, symbol] matches {
                                                            [{0}, {[at0054]}],    -- No problem
                                                            [{1}, {[at0055]}],    -- Very small problem
                                                            [{2}, {[at0056]}],    -- Small problem
                                                            [{3}, {[at0057]}],    -- Moderate problem
                                                            [{4}, {[at0058]}]    -- Big problem
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0012] occurrences matches {0..1} matches {    -- Urinary Irritation/Obstruction Symptom Score
                                        value matches {
                                            DV_COUNT[at9024] matches {
                                                magnitude matches {|0..12|}
                                            }
                                        }
                                    }
                                    CLUSTER[at0106] occurrences matches {0..1} matches {    -- 6. How big a problem, if any, has each of the following been for you?
                                        items cardinality matches {1..*; unordered} matches {
                                            ELEMENT[at0013] occurrences matches {0..1} matches {    -- 6a. Rectal pain or urgency of bowel movements
                                                value matches {
                                                    DV_ORDINAL[at9041] matches {
                                                        [value, symbol] matches {
                                                            [{0}, {[at0059]}],    -- No problem
                                                            [{1}, {[at0060]}],    -- Very small problem
                                                            [{2}, {[at0061]}],    -- Small problem
                                                            [{3}, {[at0062]}],    -- Moderate problem
                                                            [{4}, {[at0063]}]    -- Big problem
                                                        }
                                                    }
                                                }
                                            }
                                            ELEMENT[at0014] occurrences matches {0..1} matches {    -- 6b. Increased frequency of your bowel movements
                                                value matches {
                                                    DV_ORDINAL[at9042] matches {
                                                        [value, symbol] matches {
                                                            [{0}, {[at0064]}],    -- No problem
                                                            [{1}, {[at0065]}],    -- Very small problem
                                                            [{2}, {[at0066]}],    -- Small problem
                                                            [{3}, {[at0067]}],    -- Moderate problem
                                                            [{4}, {[at0068]}]    -- Big problem
                                                        }
                                                    }
                                                }
                                            }
                                            ELEMENT[at0015] occurrences matches {0..1} matches {    -- 6c. Overall problems with your bowel habits
                                                value matches {
                                                    DV_ORDINAL[at9043] matches {
                                                        [value, symbol] matches {
                                                            [{0}, {[at0069]}],    -- No problem
                                                            [{1}, {[at0070]}],    -- Very small problem
                                                            [{2}, {[at0071]}],    -- Small problem
                                                            [{3}, {[at0072]}],    -- Moderate problem
                                                            [{4}, {[at0073]}]    -- Big problem
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0016] occurrences matches {0..1} matches {    -- Bowel Symptom Score
                                        value matches {
                                            DV_COUNT[at9028] matches {
                                                magnitude matches {|0..12|}
                                            }
                                        }
                                    }
                                    ELEMENT[at0017] occurrences matches {0..1} matches {    -- 7. How would you rate your ability to reach orgasm (climax)?
                                        value matches {
                                            DV_ORDINAL[at9029] matches {
                                                [value, symbol] matches {
                                                    [{0}, {[at0074]}],    -- Very good
                                                    [{1}, {[at0075]}],    -- Good
                                                    [{2}, {[at0076]}],    -- Fair
                                                    [{3}, {[at0077]}],    -- Poor
                                                    [{4}, {[at0078]}]    -- Very poor to none
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0018] occurrences matches {0..1} matches {    -- 8. How would you describe the usual quality of your erections?
                                        value matches {
                                            DV_ORDINAL[at9030] matches {
                                                [value, symbol] matches {
                                                    [{0}, {[at0079]}],    -- Firm enough for intercourse
                                                    [{1}, {[at0080]}],    -- Firm enough for masturbation and foreplay only
                                                    [{2}, {[at0081]}],    -- Not firm enough for any sexual activity
                                                    [{4}, {[at0082]}]    -- None at all
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0019] occurrences matches {0..1} matches {    -- 9. Overall, how much of a problem has your sexual function or lack of sexual function been for you?
                                        value matches {
                                            DV_ORDINAL[at9031] matches {
                                                [value, symbol] matches {
                                                    [{0}, {[at0083]}],    -- No problem
                                                    [{1}, {[at0084]}],    -- Very small problem
                                                    [{2}, {[at0085]}],    -- Small problem
                                                    [{3}, {[at0086]}],    -- Moderate problem
                                                    [{4}, {[at0087]}]    -- Big problem
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0020] occurrences matches {0..1} matches {    -- Sexual Symptom Score
                                        value matches {
                                            DV_COUNT[at9032] matches {
                                                magnitude matches {|0..12|}
                                            }
                                        }
                                    }
                                    CLUSTER[at0107] occurrences matches {0..1} matches {    -- 10. How big a problem, if any, has each of the following been for you?
                                        items cardinality matches {1..*; unordered} matches {
                                            ELEMENT[at0021] occurrences matches {0..1} matches {    -- 10a. Hot flashes or breast tenderness/enlargement
                                                value matches {
                                                    DV_ORDINAL[at9044] matches {
                                                        [value, symbol] matches {
                                                            [{0}, {[at0088]}],    -- No problem
                                                            [{1}, {[at0089]}],    -- Very small problem
                                                            [{2}, {[at0090]}],    -- Small problem
                                                            [{3}, {[at0091]}],    -- Moderate problem
                                                            [{4}, {[at0092]}]    -- Big problem
                                                        }
                                                    }
                                                }
                                            }
                                            ELEMENT[at0022] occurrences matches {0..1} matches {    -- 10b. Feeling depressed
                                                value matches {
                                                    DV_ORDINAL[at9045] matches {
                                                        [value, symbol] matches {
                                                            [{0}, {[at0093]}],    -- No problem
                                                            [{1}, {[at0094]}],    -- Very small problem
                                                            [{2}, {[at0095]}],    -- Small problem
                                                            [{3}, {[at0096]}],    -- Moderate problem
                                                            [{4}, {[at0097]}]    -- Big problem
                                                        }
                                                    }
                                                }
                                            }
                                            ELEMENT[at0023] occurrences matches {0..1} matches {    -- 10c. Lack of energy
                                                value matches {
                                                    DV_ORDINAL[at9046] matches {
                                                        [value, symbol] matches {
                                                            [{0}, {[at0098]}],    -- No problem
                                                            [{1}, {[at0099]}],    -- Very small problem
                                                            [{2}, {[at0100]}],    -- Small problem
                                                            [{3}, {[at0101]}],    -- Moderate problem
                                                            [{4}, {[at0102]}]    -- Big problem
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0024] occurrences matches {0..1} matches {    -- Vitality/Hormonal Symptom Score
                                        value matches {
                                            DV_COUNT[at9036] matches {
                                                magnitude matches {|0..12|}
                                            }
                                        }
                                    }
                                    ELEMENT[at0025] occurrences matches {0..1} matches {    -- Overall Prostate Cancer QOL Score
                                        value matches {
                                            DV_COUNT[at9037] matches {
                                                magnitude matches {|0..60|}
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        protocol matches {
            ITEM_TREE[at0103]
        }
    }

terminology
    term_definitions = <
        ["nb"] = <
            ["at0000"] = <
                text = <"Expanded Prostate Cancer Index Composite for Clinical Practice (EPIC-CP)">
                description = <"Et spørreskjema som brukes for å måle helserelatert livskvalitet knyttet til urininkontinens, urinveisirritasjon, tarmfunksjon, seksuell og hormonell helse, til bruk i rutinemessig klinisk oppfølging av pasienter med prostatakreft.">
            >
            ["at0002"] = <
                text = <"Uspesifisert hendelse">
                description = <"Standard, uspesifisert tidspunkt eller tidsintervall som kan defineres mer eksplisitt i en template eller i en applikasjon.">
            >
            ["at0004"] = <
                text = <"1. Alt i alt, hvor stort problem har blærefunksjonen din vært for deg?">
                description = <"">
            >
            ["at0005"] = <
                text = <"2. Hvordan vil du beskrive din kontroll over vannlatingen?">
                description = <"">
            >
            ["at0006"] = <
                text = <"3. Hvor mange truseinnlegg eller voksenbleier har du brukt per dag for din urinlekkasje?">
                description = <"">
            >
            ["at0007"] = <
                text = <"4. Hvor stort problem, om noe, har drypping eller urinlekkasje vært for deg?">
                description = <"">
            >
            ["at0008"] = <
                text = <"Skår for urininkontinenssymptom">
                description = <"Sumskåren for domenet urininkontinens.">
                comment = <"Spørsmål 2 - 4.">
            >
            ["at0009"] = <
                text = <"5a. Smerte eller svie ved vannlating">
                description = <"">
            >
            ["at0010"] = <
                text = <"5b. Svak urinstråle eller ufullstendig tømming">
                description = <"">
            >
            ["at0011"] = <
                text = <"5c. Hyppig trang til vannlating">
                description = <"">
            >
            ["at0012"] = <
                text = <"Skår for urinirritasjon/obstruksjonssymptom">
                description = <"Sumskåren for domenet urinveisirritasjon/ - obstruksjon.">
                comment = <"Spørsmål 5a-5c.">
            >
            ["at0013"] = <
                text = <"6a. Smerter i endetarm eller sterk umiddelbar avføringstrang">
                description = <"">
            >
            ["at0014"] = <
                text = <"6b. Økt antall avføringer">
                description = <"">
            >
            ["at0015"] = <
                text = <"6c. Alt i alt, hvor stort problem har tarmfunksjonen vært for deg?">
                description = <"">
            >
            ["at0016"] = <
                text = <"Skår for tarmsymptom">
                description = <"Sumskåren for domenet tarmfunksjon.">
                comment = <"Spørsmål 6a‐6c.">
            >
            ["at0017"] = <
                text = <"7. Hvordan vil du gradere din evne til å oppnå orgasme (klimaks)?">
                description = <"">
            >
            ["at0018"] = <
                text = <"8. Hvordan vil du beskrive kvaliteten av ereksjonene dine vanligvis?">
                description = <"">
            >
            ["at0019"] = <
                text = <"9. Alt i alt, hvor stort problem har seksualfunksjonen, eller mangelen på slik funksjon vært for deg?">
                description = <"">
            >
            ["at0020"] = <
                text = <"Skår for seksualsymptom">
                description = <"Sumskåren for domenet seksualfunksjon.">
                comment = <"Spørsmål 7‐9.">
            >
            ["at0021"] = <
                text = <"10a. Hetetokter eller ømme/svulne bryster">
                description = <"">
            >
            ["at0022"] = <
                text = <"10b. Følt meg deprimert">
                description = <"">
            >
            ["at0023"] = <
                text = <"10c. Manglet energi">
                description = <"">
            >
            ["at0024"] = <
                text = <"Skår for vitalitet/hormonsymptom">
                description = <"Sumskåren for domenet vitalitet/hormonbalanse.">
                comment = <"Spørsmål 10a‐10c.">
            >
            ["at0025"] = <
                text = <"Totalskår for livskvalitet ved prostatakreft">
                description = <"Sum av alle 5 skårene for domenene.">
            >
            ["at0026"] = <
                text = <"Ikke noe problem">
                description = <"">
            >
            ["at0027"] = <
                text = <"Svært lite problem">
                description = <"">
            >
            ["at0028"] = <
