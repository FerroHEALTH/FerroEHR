                description = <"">
            >
            ["at0010"] = <
                text = <"Visual analog scale (EQ VAS)">
                description = <"The patient’s self-assessed health, usually displayed on a vertical visual analogue scale, where the endpoints are labelled ‘The best health you can imagine’ and ‘The worst health you can imagine’.">
            >
            ["at0011"] = <
                text = <"Health state">
                description = <"A 5-digit code formed from the scores selected for each of the five dimensions, with a score of 9 indicating a missing value.">
                comment = <"e.g. '21491'">
            >
