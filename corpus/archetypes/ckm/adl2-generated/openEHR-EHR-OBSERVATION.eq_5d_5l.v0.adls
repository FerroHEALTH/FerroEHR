    details = <
        ["en"] = <
            language = <[ISO_639-1::en]>
            purpose = <"To record the results of the EQ-5D-5L instrument, used in accordance with EuroQol guidelines.">
            keywords = <"PROM", "health", "assessment", "EuroQol", "EQ">
            use = <"Use to record the results of the EQ-5D-5L instrument, used in accordance with EuroQol guidelines.

While openEHR archetypes are all freely available under an open license, the specific content of the EQ-5D-5L instrument is copyright protected. Any use of this archetype within implementations must be in compliance with the terms established by the copyright owners:
Copyright statement: <to  be supplied by EuroQol>.
Copyright information: <to  be supplied by EuroQol>.

No translations to be added without guidance from openEHR CKAs and EuroQol.">
            misuse = <"Not to be used to record the results of any other EuroQol instrument.">
            copyright = <"© openEHR Foundation">
        >
    >

definition
    OBSERVATION[at0000] matches {    -- EQ-5D-5L
        data matches {
            HISTORY[at0001] matches {
                events cardinality matches {1..*; unordered} matches {
                    POINT_EVENT[at0002] occurrences matches {0..1} matches {    -- Any point in time event
                        data matches {
                            ITEM_TREE[at0003] matches {
                                items cardinality matches {0..*; unordered} matches {
                                    ELEMENT[at0004] occurrences matches {0..1} matches {    -- Mobility (MOB)
                                        value matches {
                                            DV_ORDINAL[at9005] matches {
                                                [value, symbol] matches {
                                                    [{1}, {[at0005]}],    -- I have no problems in walking about
                                                    [{2}, {[at0012]}],    -- I have slight problems in walking about
                                                    [{3}, {[at0013]}],    -- I have moderate problems in walking about
                                                    [{4}, {[at0014]}],    -- I have severe problems in walking about
                                                    [{5}, {[at0015]}]    -- I am unable to walk about
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0006] occurrences matches {0..1} matches {    -- Self-care (SC)
                                        value matches {
                                            DV_ORDINAL[at9006] matches {
                                                [value, symbol] matches {
                                                    [{1}, {[at0016]}],    -- I have no problems washing or dressing myself
                                                    [{2}, {[at0017]}],    -- I have slight problems washing or dressing myself
                                                    [{3}, {[at0018]}],    -- I have moderate problems washing or dressing myself
                                                    [{4}, {[at0019]}],    -- I have severe problems washing or dressing myself
                                                    [{5}, {[at0020]}]    -- I am unable to wash or dress myself
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0007] occurrences matches {0..1} matches {    -- Usual activities (UA)
                                        value matches {
                                            DV_ORDINAL[at9007] matches {
                                                [value, symbol] matches {
                                                    [{1}, {[at0021]}],    -- I have no problems doing my usual activities
                                                    [{2}, {[at0022]}],    -- I have slight problems doing my usual activities
                                                    [{3}, {[at0023]}],    -- I have moderate problems doing my usual activities
                                                    [{4}, {[at0024]}],    -- I have severe problems doing my usual activities
                                                    [{5}, {[at0025]}]    -- I am unable to do my usual activities
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0008] occurrences matches {0..1} matches {    -- Pain/discomfort (PD)
                                        value matches {
                                            DV_ORDINAL[at9008] matches {
                                                [value, symbol] matches {
                                                    [{1}, {[at0026]}],    -- I have no pain or discomfort
                                                    [{2}, {[at0027]}],    -- I have slight pain or discomfort
                                                    [{3}, {[at0028]}],    -- I have moderate pain or discomfort
                                                    [{4}, {[at0029]}],    -- I have severe pain or discomfort
                                                    [{5}, {[at0030]}]    -- I have extreme pain or discomfort
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0009] occurrences matches {0..1} matches {    -- Anxiety/depression (AD)
                                        value matches {
                                            DV_ORDINAL[at9009] matches {
                                                [value, symbol] matches {
                                                    [{1}, {[at0031]}],    -- I am not anxious or depressed
                                                    [{2}, {[at0032]}],    -- I am slightly anxious or depressed
                                                    [{3}, {[at0033]}],    -- I am moderately anxious or depressed
                                                    [{4}, {[at0034]}],    -- I am severely anxious or depressed
                                                    [{5}, {[at0035]}]    -- I am extremely anxious or depressed
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0011] occurrences matches {0..1} matches {    -- Health state
                                        value matches {
                                            DV_TEXT[at9010]
                                        }
                                    }
                                    ELEMENT[at0010] occurrences matches {0..1} matches {    -- Visual analog scale (EQ VAS)
                                        value matches {
                                            DV_COUNT[at9011] matches {
                                                magnitude matches {|0..100|}
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

terminology
    term_definitions = <
        ["en"] = <
            ["at0000"] = <
                text = <"EQ-5D-5L">
                description = <"A standardised PROM instrument used to assess health outcome from a wide variety of interventions on a common scale, for purposes of evaluation, allocation and monitoring.">
            >
            ["at0002"] = <
                text = <"Any point in time event">
                description = <"">
            >
            ["at0004"] = <
                text = <"Mobility (MOB)">
                description = <"">
            >
            ["at0005"] = <
                text = <"I have no problems in walking about">
