        ["2"] = <"MAPI Research Trust. EuroQol 5-dimension 5-level (EQ-5D-5L) [Internet]. Lyon (FR): MAPI Research Trust; [cited 2025 Dec 14]. Available from: https://eprovide.mapi-trust.org/instruments/euroqol-5-dimension-5-level">
