archetype (adl_version=2.4.0; rm_release=1.1.0; generated; uid=e1bb147f-3393-4f8d-b43f-40e4707cef3f; build_uid=e364d205-7b9f-458b-8b3f-3f89efb2b477)
    openEHR-EHR-OBSERVATION.experiment.v0.0.1-alpha

language
    original_language = <[ISO_639-1::cs]>

description
    original_author = <
        ["name"] = <"Václav Papež">
        ["organisation"] = <"University of West Bohemia">
        ["email"] = <"vpapez@kiv.zcu.cz">
        ["date"] = <"2016-04-04">
    >
    original_namespace = <"org.openehr">
    original_publisher = <"openEHR Foundation">
    lifecycle_state = <"in_development">
    custodian_namespace = <"org.openehr">
    custodian_organisation = <"openEHR Foundation">
    licence = <"This work is licensed under the Creative Commons Attribution-ShareAlike 3.0 License. To view a copy of this license, visit http://creativecommons.org/licenses/by-sa/3.0/.">
    references = <
        ["1"] = <"Based on odML terminology http://portal.g-node.org/odml/terminologies/v1.0/experiment/experiment.xml, v.1.0, d. 2012-01-02 ">
        ["2"] = <"                                                   http://portal.g-node.org/odml/terminologies/v1.0/dataset/dataset.xml, v.1.0, d. 2015-10-04  ">
        ["3"] = <"                                                   http://portal.g-node.org/odml/terminologies/v1.0/protocol/protocol.xml, v.1.0, d. 2014-11-25 ">
        ["4"] = <"                                                   http://portal.g-node.org/odml/terminologies/v1.0/event/event.xml, v.1.0, d. 2012-01-02 ">
        ["5"] = <"                                                   http://portal.g-node.org/odml/terminologies/v1.0/setup/setup.xml, v.1.0, d. 2012-01-02 ">
        ["6"] = <"                                                   http://portal.g-node.org/odml/terminologies/v1.0/recording/recording.xml, v.1.0, d. 2012-01-02 ">
