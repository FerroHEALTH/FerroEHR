definition
    OBSERVATION[at0000] matches {    -- Faeces
        data matches {
            HISTORY[at0001] matches {
                events cardinality matches {1..*; unordered} matches {
                    EVENT[at0002] matches {    -- Any event
                        data matches {
                            ITEM_TREE[at0003] matches {
                                items cardinality matches {0..*; unordered} matches {
                                    ELEMENT[at0018] occurrences matches {0..1} matches {    -- Clinical description
                                        value matches {
                                            DV_CODED_TEXT[at9005] matches {
                                                defining_code matches {}
                                            }
                                        }
                                    }
                                    ELEMENT[at0004] occurrences matches {0..1} matches {    -- Colour
                                        value matches {
                                            DV_TEXT[at9006]
                                        }
                                    }
                                    ELEMENT[at0005] occurrences matches {0..1} matches {    -- Consistency
                                        value matches {
                                            DV_CODED_TEXT[at9007] matches {
                                                defining_code matches {[ac9000]}    -- Consistency (synthesised)
                                            }
                                        }
                                    }
                                    ELEMENT[at0010] occurrences matches {0..1} matches {    -- Used bowels
                                        value matches {
                                            DV_BOOLEAN[at9008] matches {
                                                value matches {True, False}
                                            }
                                        }
                                    }
                                    ELEMENT[at0020] occurrences matches {0..1} matches {    -- Last opened bowels
                                        value matches {
                                            DV_DATE_TIME[at9009]
                                        }
                                    }
                                    ELEMENT[at0021] occurrences matches {0..1} matches {    -- Time since last opened bowels
                                        value matches {
                                            DV_QUANTITY[at9010] matches {
                                                property matches {[at9001]}    -- Time
                                                [units] matches {
                                                    [{"min"}],
                                                    [{"h"}],
                                                    [{"d"}]
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0011] occurrences matches {0..1} matches {    -- Amount
                                        value matches {
                                            DV_ORDINAL[at9011] matches {
                                                [value, symbol] matches {
                                                    [{0}, {[at0012]}],    -- No faeces passed
                                                    [{1}, {[at0013]}],    -- Very small amount
                                                    [{2}, {[at0014]}],    -- Small
                                                    [{5}, {[at0015]}],    -- Usual
                                                    [{8}, {[at0016]}],    -- Large
                                                    [{10}, {[at0017]}]    -- Very large
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0019] occurrences matches {0..1} matches {    -- Volume
                                        value matches {
                                            DV_QUANTITY[at9012] matches {
                                                property matches {[at9004]}    -- Mass
                                                magnitude matches {|>=0.0|}
                                                units matches {"g"}
                                                precision matches {0}
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        protocol matches {
            ITEM_TREE[at0022] matches {
                items cardinality matches {0..*; unordered} matches {
                    allow_archetype CLUSTER[at0023] matches {    -- Extension
                        include
                            archetype_id/value matches {/.*/}
                    }
                }
            }
        }
    }

terminology
    term_definitions = <
        ["es-ar"] = <
            ["at0000"] = <
                text = <"Heces">
                description = <"Para registrar una deposición de materia fecal.">
