    references = <
        ["1"] = <"Fescina RH, De Mucio B, Martinez G, Alemán A, Sosa C, Mainero L, Rubino M. Monitoring fetal growth. 2nd ed. Montevideo: CLAP/WR; 2011.">
        ["2"] = <"Kiserud T, Benachi A, Hecher K, Perez RG, Carvalho J, Piaggio G, Platt LD. The World Health Organization fetal growth charts: concept, findings, interpretation, and application. Am J Obstet Gynecol. 2018 Feb;218(2S):S619-S629. doi: 10.1016/j.ajog.2017.12.010. PMID: 29422204.">
