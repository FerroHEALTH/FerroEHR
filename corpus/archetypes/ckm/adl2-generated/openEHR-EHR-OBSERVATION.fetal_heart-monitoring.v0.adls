    details = <
        ["sv"] = <
            language = <[ISO_639-1::sv]>
            purpose = <"Att registrera observationer av fostrets hjärtfrekvens över tid, vanligtvis med hjälp av kardiotokograf eller liknande utrustning under senare delen av graviditeten eller under förlossningen, som underlag för bedömning av fostrets tillstånd i livmodern.">
            keywords = <"foster", "fosterhjärta", "fosterhjärtfrekvens", "hjärtfrekvens", "hjärtrytm", "hjärtslag", "fosterövervakning", "fosterhjärtövervakning", "CTG", "kardiotokografi">
            use = <"Används för att registrera observationer av fostrets hjärtfrekvens över tid, vanligtvis med hjälp av kardiotokograf eller liknande utrustning under senare delen av graviditeten eller under förlossningen, som underlag för bedömning av fostrets tillstånd.

Används för att registrera fynd från elektronisk övervakning, inklusive kardiotokografi (CTG).

Används endast för att registrera uppgifter om fostrets hjärtslag.">
            misuse = <"Ska inte användas för att registrera enstaka, intermittenta mätningar av fostrets hjärtfrekvens. Använd i stället den överordnade arketypen OBSERVATION.fetal_heart.

Ska inte användas för att registrera hjärtfrekvens hos spädbarn, barn eller vuxna.">
            copyright = <"© openEHR Foundation">
        >
        ["en"] = <
            language = <[ISO_639-1::en]>
            purpose = <"To record observations about the fetal heart rate, usually using a cardiotocograph or similar device over a time in late pregnancy or labour, as an assessment about fetal wellbeing in utero.">
            keywords = <"fetal", "heart", "beat", "rate", "rhythm">
            use = <"Use to record observations about the fetal heart rate, usually using a cardiotocograph or similar device over a period of time in late pregnancy or labour, as an assessment about fetal wellbeing.

Use to capture findings from electronic monitoring, including cardiotocography.

Use is restricted to recording details about the heart beat of a fetus.">
            misuse = <"Not to be used to record simple, intermittent measurements of fetal heart rate - use the parent archetype OBSERVATION.fetal_heart instead.

Not to be used for recording the heart rate of infants, children or adults.">
            copyright = <"© openEHR Foundation">
        >
    >

definition
    OBSERVATION[at0000.1] matches {    -- Fetal heart monitoring
        /data[at0001]/events[at0002]/data[at0003]/items matches {
            after [at0005]
            ELEMENT[at0.1] occurrences matches {0..1} matches {    -- Variability
                value matches {
                    DV_INTERVAL<DV_QUANTITY>[at0.9010] matches {
                        lower matches {
                            DV_QUANTITY[at0.9011] matches {
                                magnitude matches {|0.0..<1000.0|}
                                units matches {"1/min"}
                                precision matches {0}
                            }
                        }
                        upper matches {
                            DV_QUANTITY[at0.9012] matches {
                                magnitude matches {|0.0..<1000.0|}
                                units matches {"1/min"}
                                precision matches {0}
                            }
                        }
                    }
                }
            }
            ELEMENT[at0.2] occurrences matches {0..1} matches {    -- Variability category
                value matches {
                    DV_CODED_TEXT[at0.9013] matches {
                        defining_code matches {[ac0.9005]}    -- Variability category (synthesised)
                    }
                }
            }
            ELEMENT[at0.3] occurrences matches {0..1} matches {    -- Variability description
                value matches {
                    DV_TEXT[at0.9014]
                }
            }
            ELEMENT[at0.4] occurrences matches {0..1} matches {    -- Accelerations
                value matches {
                    DV_CODED_TEXT[at0.9015] matches {
                        defining_code matches {[ac0.9006]}    -- Accelerations (synthesised)
                    }
                }
            }
            ELEMENT[at0.5] occurrences matches {0..1} matches {    -- Early decelerations
                value matches {
                    DV_CODED_TEXT[at0.9016] matches {
                        defining_code matches {[ac0.9007]}    -- Early decelerations (synthesised)
                    }
                }
            }
            ELEMENT[at0.6] occurrences matches {0..1} matches {    -- Uncomplicated variable decelerations
                value matches {
                    DV_CODED_TEXT[at0.9017] matches {
                        defining_code matches {[ac0.9008]}    -- Uncomplicated variable decelerations (synthesised)
                    }
                }
            }
            ELEMENT[at0.7] occurrences matches {0..1} matches {    -- Complicated variable decelerations
                value matches {
                    DV_CODED_TEXT[at0.9018] matches {
                        defining_code matches {[ac0.9009]}    -- Complicated variable decelerations (synthesised)
                    }
                }
            }
            ELEMENT[at0.8] occurrences matches {0..1} matches {    -- Late decelerations
                value matches {
                    DV_CODED_TEXT[at0.9019] matches {
                        defining_code matches {[ac0.9010]}    -- Late decelerations (synthesised)
                    }
                }
            }
            ELEMENT[at0.9] occurrences matches {0..1} matches {    -- Prolonged decelerations
                value matches {
                    DV_DURATION[at0.9020] matches {
                        value matches {PTMS/|>=PT0S|}
                    }
                }
            }
            after [at0010]
            allow_archetype CLUSTER[at0.10] matches {    -- Multimedia representation
                include
                    archetype_id/value matches {/openEHR-EHR-CLUSTER\.multimedia\.v0\..*|openEHR-EHR-CLUSTER\.multimedia\.v1\..*/}
            }
        }
    }

terminology
    term_definitions = <
        ["sv"] = <
            ["at0.1"] = <
                text = <"Variabilitet">
                description = <"Variabilitet i fostrets hjärtfrekvens som observerats under övervakningsperioden.">
            >
            ["at0.10"] = <
                text = <"Multimediarepresentation">
                description = <"Digital representation av fynd från övervakningen.">
                comment = <"Exempelvis video eller CTG-registrering.">
            >
            ["at0.11"] = <
                text = <"Ingen">
                description = <"Variabilitet i hjärtfrekvensen kan inte detekteras.">
            >
            ["at0.12"] = <
                text = <"Minimal">
                description = <"Variabiliteten i hjärtfrekvensen är detekterbar men högst 5 slag per minut.">
            >
            ["at0.13"] = <
                text = <"Måttlig">
                description = <"Variabiliteten i hjärtfrekvensen är 6–25 slag per minut.">
            >
            ["at0.14"] = <
                text = <"Uttalad">
                description = <"Variabiliteten i hjärtfrekvensen är större än 25 slag per minut.">
            >
            ["at0.15"] = <
                text = <"Saknas">
                description = <"Accelerationer i fostrets hjärtfrekvens kan inte detekteras.">
            >
            ["at0.16"] = <
                text = <"Förekommer spontant">
                description = <"Accelerationer i fostrets hjärtfrekvens förekommer spontant.">
            >
            ["at0.17"] = <
                text = <"Förekommer vid skalpstimulering">
                description = <"Accelerationer i fostrets hjärtfrekvens detekteras som resultat av skalpstimulering.">
            >
            ["at0.18"] = <
                text = <"Saknas vid skalpstimulering">
                description = <"Accelerationer i fostrets hjärtfrekvens detekteras inte vid skalpstimulering.">
            >
            ["at0.19"] = <
                text = <"Inga">
                description = <"Inga decelerationer har detekterats.">
            >
            ["at0.2"] = <
                text = <"Variabilitetskategori">
                description = <"Kategori för variabiliteten i fostrets hjärtfrekvens som observerats under övervakningsperioden.">
            >
            ["at0.20"] = <
                text = <"Enstaka">
