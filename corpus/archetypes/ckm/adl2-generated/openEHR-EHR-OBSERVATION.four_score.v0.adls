definition
    OBSERVATION[at0000] matches {    -- Full Outline of UnResponsiveness (FOUR) score
        data matches {
            HISTORY[at0001] matches {
                events cardinality matches {0..*; unordered} matches {
                    EVENT[at0002] matches {    -- Any event
                        data matches {
                            ITEM_TREE[at0003] matches {
                                items cardinality matches {0..*; unordered} matches {
                                    ELEMENT[at0004] occurrences matches {0..1} matches {    -- Eye response
                                        value matches {
                                            DV_ORDINAL[at9004] matches {
                                                [value, symbol] matches {
                                                    [{4}, {[at0012]}],    -- Eyelids open or opened, tracking, or blinking to command
                                                    [{3}, {[at0013]}],    -- Eyelids open but not tracking
                                                    [{2}, {[at0014]}],    -- Eyelids closed but open to loud voice
                                                    [{1}, {[at0015]}],    -- Eyelids closed but open to pain
                                                    [{0}, {[at0016]}]    -- Eyelids remain closed with pain
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0009] occurrences matches {0..1} matches {    -- Motor response
                                        value matches {
                                            DV_ORDINAL[at9005] matches {
                                                [value, symbol] matches {
                                                    [{4}, {[at0017]}],    -- Thumbs-up, fist, or peace sign
                                                    [{3}, {[at0018]}],    -- Localizing to pain
                                                    [{2}, {[at0019]}],    -- Flexion response to pain
                                                    [{1}, {[at0020]}],    -- Extension response to pain
                                                    [{0}, {[at0021]}]    -- No response to pain or generalized myoclonus status
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0010] occurrences matches {0..1} matches {    -- Brain stem reflexes
                                        value matches {
                                            DV_ORDINAL[at9006] matches {
                                                [value, symbol] matches {
                                                    [{4}, {[at0022]}],    -- Pupil and corneal reflexes present
                                                    [{3}, {[at0023]}],    -- One pupil wide and fixed
                                                    [{2}, {[at0024]}],    -- Pupil or corneal reflexes present
                                                    [{1}, {[at0025]}],    -- Pupil and corneal reflexes absent
                                                    [{0}, {[at0026]}]    -- Absent pupil, corneal and cough reflex
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0011] occurrences matches {0..1} matches {    -- Respiration
                                        value matches {
                                            DV_ORDINAL[at9007] matches {
                                                [value, symbol] matches {
                                                    [{1}, {[at0027]}],    -- Not intubated, regular breathing pattern
                                                    [{2}, {[at0028]}],    -- Not intubated, Cheyne–Stokes breathing pattern
                                                    [{3}, {[at0029]}],    -- Not intubated, irregular breathing
                                                    [{4}, {[at0030]}],    -- Breathes above ventilator rate
                                                    [{5}, {[at0031]}]    -- Breathes at ventilator rate or apnoea
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0033] occurrences matches {0..1} matches {    -- Total score
                                        value matches {
                                            DV_COUNT[at9008] matches {
                                                magnitude matches {|0..16|}
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        protocol matches {
            ITEM_TREE[at0008] matches {
                items cardinality matches {0..*; unordered} matches {
                    allow_archetype CLUSTER[at0032] matches {    -- Extension
                        include
                            archetype_id/value matches {/.*/}
                    }
                }
            }
        }
    }

