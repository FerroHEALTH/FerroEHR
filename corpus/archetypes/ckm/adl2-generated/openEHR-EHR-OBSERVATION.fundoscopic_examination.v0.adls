definition
    OBSERVATION[at0000] matches {    -- Fundoscopic examination of eyes
        data matches {
            HISTORY[at0001] matches {
                events cardinality matches {1..*; unordered} matches {
                    EVENT[at0002] matches {    -- Any event
                        data matches {
                            ITEM_TREE[at0003] matches {
                                items cardinality matches {0..*; unordered} matches {
                                    CLUSTER[at0136] occurrences matches {0..2} matches {    -- Test Result
                                        items cardinality matches {1..*; unordered} matches {
                                            ELEMENT[at0004] occurrences matches {0..1} matches {    -- Eye examined
                                                value matches {
                                                    DV_CODED_TEXT[at9025] matches {
                                                        defining_code matches {[ac9019]}    -- Eye examined (synthesised)
                                                    }
                                                }
                                            }
                                            ELEMENT[at0008] occurrences matches {0..1} matches {    -- Clinical description
                                                value matches {
                                                    DV_TEXT[at9048]
                                                }
                                            }
                                            ELEMENT[at0053] occurrences matches {0..1} matches {    -- Red reflex
                                                value matches {
                                                    DV_BOOLEAN[at9049] matches {
                                                        value matches {True, False}
                                                    }
                                                }
                                            }
                                            ELEMENT[at0091] occurrences matches {0..1} matches {    -- Optic disc description
                                                value matches {
                                                    DV_TEXT[at9050]
                                                }
                                            }
                                            ELEMENT[at0090] occurrences matches {0..1} matches {    -- Macula description
                                                value matches {
                                                    DV_TEXT[at9051]
                                                }
                                            }
                                            ELEMENT[at0092] occurrences matches {0..1} matches {    -- Retinal arteries description
                                                value matches {
                                                    DV_TEXT[at9052]
                                                }
                                            }
                                            ELEMENT[at0093] occurrences matches {0..1} matches {    -- Retinal veins description
                                                value matches {
                                                    DV_TEXT[at9053]
                                                }
                                            }
                                            ELEMENT[at0094] occurrences matches {0..1} matches {    -- Retinal background description
                                                value matches {
                                                    DV_TEXT[at9054]
                                                }
                                            }
                                            ELEMENT[at0098] occurrences matches {0..1} matches {    -- Vitreous description
                                                value matches {
                                                    DV_TEXT[at9055]
                                                }
                                            }
                                            ELEMENT[at0143] occurrences matches {0..1} matches {    -- Clinical interpretation
                                                value matches {
                                                    DV_TEXT[at9056]
                                                }
                                            }
                                            allow_archetype CLUSTER[at0142] matches {    -- Multimedia representation
                                                include
                                                    archetype_id/value matches {/openEHR-EHR-CLUSTER\.multimedia(-[a-zA-Z0-9_]+)*\.v0\..*/}
                                            }
                                            allow_archetype CLUSTER[at0139] matches {    -- Additional findings
                                                include
                                                    archetype_id/value matches {/openEHR-EHR-CLUSTER\.clinical_findings(-[a-zA-Z0-9_]+)*\.v1\..*/}
                                            }
                                            allow_archetype CLUSTER[at0141] matches {    -- Examination not done
                                                include
                                                    archetype_id/value matches {/openEHR-EHR-CLUSTER\.exclusion_exam(-[a-zA-Z0-9_]+)*\.v1\..*/}
                                            }
                                            ELEMENT[at0126] matches {    -- Comment
                                                value matches {
                                                    DV_TEXT[at9057]
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        state matches {
                            ITEM_TREE[at0013] matches {
                                items cardinality matches {0..*; unordered} matches {
                                    ELEMENT[at0140] occurrences matches {0..1} matches {    -- Confounding factors
                                        value matches {
                                            DV_TEXT[at9058]
                                        }
                                    }
                                    ELEMENT[at0014] occurrences matches {0..1} matches {    -- Mydriatic used
                                        value matches {
                                            DV_BOOLEAN[at9018] matches {
                                                value matches {True, False}
                                            }
                                        }
                                    }
                                    ELEMENT[at0054] occurrences matches {0..1} matches {    -- Small pupil
                                        value matches {
                                            DV_BOOLEAN[at9059] matches {
                                                value matches {True, False}
                                            }
                                        }
                                    }
                                    ELEMENT[at0124] occurrences matches {0..1} matches {    -- Uncooperative patient
                                        value matches {
                                            DV_BOOLEAN[at9060] matches {
                                                value matches {True, False}
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        protocol matches {
            ITEM_TREE[at0028] matches {
                items cardinality matches {0..*; unordered} matches {
                    ELEMENT[at0029] occurrences matches {0..1} matches {    -- Method
                        value matches {
                            DV_CODED_TEXT[at9019] matches {
                                defining_code matches {[ac9021]}    -- Method (synthesised)
                            }
                        }
                    }
                    allow_archetype CLUSTER[at0089] matches {    -- Device details
                        include
                            archetype_id/value matches {/openEHR-EHR-CLUSTER\.device(-[a-zA-Z0-9_]+)*\.v1\..*/}
                    }
                    ELEMENT[at0067] occurrences matches {0..1} matches {    -- Field angle
                        value matches {
                            DV_CODED_TEXT[at9042] matches {
                                defining_code matches {[ac9022]}    -- Field angle (synthesised)
                            }
                        }
                    }
                    ELEMENT[at0072] occurrences matches {0..1} matches {    -- Attempts
                        value matches {
                            DV_COUNT[at9043] matches {
                                magnitude matches {|1..3|}
                            }
                        }
                    }
                    CLUSTER[at0073] occurrences matches {0..1} matches {    -- Subdivision of the retina
                        name matches {
                            DV_CODED_TEXT[at9044] matches {
                                defining_code matches {[ac2]}    -- Subdivision of retina
                            }
                        }
                        items cardinality matches {1..*; unordered} matches {
                            ELEMENT[at0074] matches {    -- ETRDS fields
                                name matches {
                                    DV_CODED_TEXT[at9045] matches {
                                        defining_code matches {[ac3]}    -- Diabetic Retinopathy Study field
                                    }
                                }
                                value matches {
                                    DV_CODED_TEXT[at9046] matches {
                                        defining_code matches {[ac9023]}    -- ETRDS fields (synthesised)
                                    }
                                }
                            }
                            ELEMENT[at0082] matches {    -- Mosaic and peripherals
                                value matches {
                                    DV_CODED_TEXT[at9047] matches {
                                        defining_code matches {[ac9024]}    -- Mosaic and peripherals (synthesised)
                                    }
                                }
                            }
                        }
                    }
                    ELEMENT[at0056] occurrences matches {0..1} matches {    -- Shadow artifact
                        value matches {
                            DV_BOOLEAN[at9061] matches {
                                value matches {True, False}
                            }
                        }
                    }
                    ELEMENT[at0055] occurrences matches {0..1} matches {    -- Cataract artifact
                        value matches {
                            DV_BOOLEAN[at9062] matches {
                                value matches {True, False}
                            }
                        }
                    }
                    ELEMENT[at0059] occurrences matches {0..1} matches {    -- Quality of visualisation
                        value matches {
                            DV_ORDINAL[at9063] matches {
                                [value, symbol] matches {
                                    [{1}, {[at0060]}],    -- Quality inadequate for any diagnostic purpose
                                    [{2}, {[at0061]}],    -- Unable to exclude all emergent findings
                                    [{3}, {[at0062]}],    -- Only able to exclude emergent findings
                                    [{4}, {[at0063]}],    -- Quality not ideal, but is possible to exclude subtle findings
                                    [{5}, {[at0064]}]    -- Ideal quality
                                }
                            }
                        }
                    }
                    ELEMENT[at0058] occurrences matches {0..1} matches {    -- Visualisation description
                        value matches {
                            DV_TEXT[at9064]
                        }
                    }
                    ELEMENT[at0123] occurrences matches {0..1} matches {    -- High refraction
                        value matches {
                            DV_BOOLEAN[at9065] matches {
                                value matches {True, False}
                            }
                        }
                    }
                    allow_archetype CLUSTER[at0144] matches {    -- Extension
                        include
                            archetype_id/value matches {/.*/}
                    }
                }
            }
        }
    }

terminology
    term_definitions = <
        ["pt-br"] = <
            ["at0000"] = <
                text = <"*Fundoscopic examination of eyes(en)">
                description = <"*Record of clinical findings on fundoscopy of eyes.(en)">
            >
            ["at0002"] = <
                text = <"*Any event(en)">
                description = <"*Default, unspecified point in time or interval event which may be explicitly defined in a template or at run-time.(en)">
            >
            ["at0004"] = <
                text = <"*Eye examined(en)">
                description = <"*Identification of the eye which is being examined.(en)">
                comment = <"*Matches to DICOM Laterality (0020,0060) attribute.(en)">
            >
            ["at0008"] = <
                text = <"*Clinical description(en)">
                description = <"*Narrative description of the overall findings observed during the physical examination of the eye examined.(en)">
            >
            ["at0014"] = <
                text = <"*Mydriatic used(en)">
                description = <"*True if mydriatic is used.(en)">
            >
            ["at0029"] = <
                text = <"*Method(en)">
                description = <"*Method chosen to perform the funduscopic examination.(en)">
            >
            ["at0030"] = <
                text = <"*Direct(en)">
                description = <"*Study performed by direct ophthalmoscopy.(en)">
            >
            ["at0031"] = <
                text = <"*Indirect(en)">
                description = <"*Study of eye fundus by indirect ophthalmoscopy method.(en)">
            >
            ["at0053"] = <
                text = <"*Red reflex(en)">
                description = <"*True if Red Reflex is present.(en)">
            >
            ["at0054"] = <
                text = <"*Small pupil(en)">
                description = <"*True if during the acquisition, pupil diameter is smaller than normal (3,3mm).(en)">
            >
            ["at0055"] = <
                text = <"*Cataract artifact(en)">
                description = <"*True if cataract obstructs the visualization of eye fundus.(en)">
            >
            ["at0056"] = <
                text = <"*Shadow artifact(en)">
                description = <"*True if shadow artifact is present on the border of the image.(en)">
            >
            ["at0058"] = <
                text = <"*Visualisation description(en)">
                description = <"*Narrative description about visualisation.(en)">
            >
            ["at0059"] = <
                text = <"*Quality of visualisation(en)">
                description = <"*Levels quantifying the quality of each acquisition, based in the ease to visualize the structures on the eye fundus.(en)">
            >
            ["at0060"] = <
                text = <"*new ordinal(en)">
                description = <"**(en)">
            >
            ["at0061"] = <
                text = <"*new ordinal(en)">
                description = <"**(en)">
            >
            ["at0062"] = <
                text = <"*new ordinal(en)">
                description = <"**(en)">
            >
            ["at0063"] = <
                text = <"*new ordinal(en)">
                description = <"**(en)">
            >
            ["at0064"] = <
                text = <"*new ordinal(en)">
                description = <"**(en)">
            >
            ["at0067"] = <
                text = <"*Field angle(en)">
                description = <"*Describes the optical acceptance angle of the lens used during the test.(en)">
            >
            ["at0068"] = <
                text = <"*30º(en)">
                description = <"*30º angle used for small pupil (SP) capture (for patients with pupil diameter <3.3mm).(en)">
            >
            ["at0069"] = <
                text = <"*45º(en)">
                description = <"*45º angle used to acquire eye fundus of normal pupils.(en)">
            >
            ["at0070"] = <
                text = <"*100º(en)">
                description = <"*Wide angle acquisition.(en)">
            >
            ["at0071"] = <
                text = <"*200º(en)">
                description = <"*Ultra-wide angle acquisition.(en)">
            >
            ["at0072"] = <
                text = <"*Attempts(en)">
                description = <"*Number of attempts before obtaining the acquisition (doesn't compute if test is repeated by a specific recognized technical failure).(en)">
            >
            ["at0073"] = <
                text = <"*Subdivision of the retina(en)">
                description = <"*Subdivision of the retina identifying eye fundus image locations.(en)">
            >
            ["at0074"] = <
                text = <"*ETRDS fields(en)">
                description = <"*Subdivision of the retina based on Diabetic Retinopathy Study fields.(en)">
            >
            ["at0075"] = <
                text = <"*Study field 1(en)">
                description = <"**(en)">
            >
            ["at0076"] = <
                text = <"*Study field 2(en)">
                description = <"**(en)">
            >
            ["at0077"] = <
                text = <"*Study field 3(en)">
                description = <"**(en)">
            >
            ["at0078"] = <
                text = <"*Study field 4(en)">
                description = <"**(en)">
            >
            ["at0079"] = <
                text = <"*Study field 5(en)">
                description = <"**(en)">
            >
            ["at0080"] = <
                text = <"*Study field 6(en)">
                description = <"**(en)">
            >
            ["at0081"] = <
                text = <"*Study field 7(en)">
                description = <"**(en)">
            >
            ["at0082"] = <
                text = <"*Mosaic and peripherals(en)">
                description = <"*Division of the retina in quadrants + mosaic obtained from the combination of them.(en)">
            >
            ["at0083"] = <
                text = <"*Mosaic(en)">
                description = <"*Mosaic obtained from combining every peripheral acquisitions and the center one.(en)">
            >
            ["at0084"] = <
                text = <"*Central(en)">
                description = <"*Image centered on the macula.(en)">
            >
            ["at0085"] = <
                text = <"*Nasal(en)">
                description = <"*Image centered on the optic nerve or papila.(en)">
            >
            ["at0086"] = <
                text = <"*Temporal(en)">
                description = <"*Image centered on the temporal quadrant of the retina.(en)">
            >
            ["at0087"] = <
                text = <"*Superior(en)">
                description = <"*Image centered on the superior half of the retina.(en)">
            >
            ["at0088"] = <
                text = <"*Inferior(en)">
                description = <"*Image centered on the inferior half of the retina.(en)">
            >
            ["at0089"] = <
                text = <"*Device details(en)">
                description = <"*Details of the device used to acquire eye fundus images.(en)">
            >
            ["at0090"] = <
                text = <"*Macula description(en)">
                description = <"*Narrative description about the macula.(en)">
            >
            ["at0091"] = <
                text = <"*Optic disc description(en)">
                description = <"*Narrative description about the optic disc.(en)">
            >
            ["at0092"] = <
                text = <"*Retinal arteries description(en)">
                description = <"*Narrative description about the retinal arteries.(en)">
            >
            ["at0093"] = <
                text = <"*Retinal veins description(en)">
                description = <"*Narrative description about the retinal veins.(en)">
            >
            ["at0094"] = <
                text = <"*Retinal background description(en)">
                description = <"*Narrative description about the retinal background.(en)">
            >
            ["at0098"] = <
                text = <"*Vitreous description(en)">
                description = <"*Narrative description about the vitreous humour.(en)">
            >
            ["at0122"] = <
                text = <"*60º(en)">
                description = <"*60º angle used to acquire eye fundus in some DR screening studies.(en)">
            >
            ["at0123"] = <
                text = <"*High refraction(en)">
                description = <"*True if the refraction of the eye exceeds the range from -12D to +15D.(en)">
            >
            ["at0124"] = <
                text = <"*Uncooperative patient(en)">
                description = <"*True if patient doesn't collaborate during the image acquisition.(en)">
            >
            ["at0126"] = <
                text = <"*Comment(en)">
                description = <"*Additional narrative about the physical examination findings, not captured in other fields.(en)">
            >
            ["at0129"] = <
                text = <"*Mydriatic retinography(en)">
                description = <"*Observation of retina through funduscopic images acquired by previous dilatation of patient's pupils.(en)">
            >
            ["at0130"] = <
                text = <"*Non-mydriatic retinography(en)">
                description = <"*Observation of retina through funduscopic images acquired without previous dilatation of patient's pupils.(en)">
            >
            ["at0131"] = <
                text = <"*Contact lens biomicroscopy(en)">
                description = <"*Eye fundus viewing through biomicroscopy lens in contact to patient's eye surface.(en)">
            >
            ["at0132"] = <
                text = <"*Non-contact lens biomicroscopy(en)">
                description = <"*Eye fundus viewing through biomicroscopy lens without contact to patient's eye surface.(en)">
            >
            ["at0135"] = <
                text = <"*Angiography(en)">
                description = <"*Observation of the eye fundus using a fluorescent dye inyected to emphasize the blood vessels in the eye retina.(en)">
            >
            ["at0136"] = <
                text = <"*New cluster(en)">
                description = <"**(en)">
            >
            ["at0137"] = <
                text = <"*Left eye(en)">
                description = <"*The left eye was examined.(en)">
            >
            ["at0138"] = <
                text = <"*Right eye(en)">
                description = <"*The right eye was examined.(en)">
            >
            ["at0139"] = <
                text = <"*Additional findings(en)">
                description = <"*Additional structured details about the physical examination findings.(en)">
            >
            ["at0140"] = <
                text = <"*Confounding factors(en)">
                description = <"*Narrative description of factors, not recorded elsewhere, that may influence the clinical findings.(en)">
            >
            ["at0141"] = <
                text = <"*Examination not done(en)">
                description = <"*Details to explicitly record that this examination was not performed.(en)">
            >
            ["at0142"] = <
                text = <"*Multimedia representation(en)">
                description = <"*Digital image, video or diagram representing the physical examination findings.(en)">
            >
            ["at0143"] = <
                text = <"*Clinical interpretation(en)">
                description = <"*Single word, phrase or brief description that represents the clinical meaning and significance of the physical examination findings for the eye examined.(en)">
                comment = <"*Coding of the 'Clinical interpretation' with a terminology is preferred, where possible.(en)">
            >
            ["at0144"] = <
                text = <"*Extension(en)">
                description = <"*Additional information required to capture local content or to align with other reference models/formalisms.(en)">
                comment = <"*For example: local information requirements or additional metadata to align with FHIR or CIMI equivalents.(en)">
            >
            ["ac2"] = <
                text = <"*Nueva restricción(en)">
                description = <"**(en)">
            >
            ["ac3"] = <
                text = <"*Nueva restricción(en)">
                description = <"**(en)">
            >
            ["ac9019"] = <
                text = <"*Eye examined(en) (synthesised)">
                description = <"*Identification of the eye which is being examined.(en) (synthesised)">
            >
            ["ac9021"] = <
                text = <"*Method(en) (synthesised)">
                description = <"*Method chosen to perform the funduscopic examination.(en) (synthesised)">
            >
            ["ac9022"] = <
                text = <"*Field angle(en) (synthesised)">
                description = <"*Describes the optical acceptance angle of the lens used during the test.(en) (synthesised)">
            >
            ["ac9023"] = <
                text = <"*ETRDS fields(en) (synthesised)">
                description = <"*Subdivision of the retina based on Diabetic Retinopathy Study fields.(en) (synthesised)">
            >
            ["ac9024"] = <
                text = <"*Mosaic and peripherals(en) (synthesised)">
                description = <"*Division of the retina in quadrants + mosaic obtained from the combination of them.(en) (synthesised)">
            >
            ["ac9047"] = <
                text = <"*Quality of visualisation(en) (synthesised)">
                description = <"*Levels quantifying the quality of each acquisition, based in the ease to visualize the structures on the eye fundus.(en) (synthesised)">
            >
        >
        ["en"] = <
            ["at0000"] = <
                text = <"Fundoscopic examination of eyes">
                description = <"Record of clinical findings on fundoscopy of eyes.">
            >
            ["at0002"] = <
                text = <"Any event">
                description = <"Default, unspecified point in time or interval event which may be explicitly defined in a template or at run-time.">
            >
            ["at0004"] = <
                text = <"Eye examined">
                description = <"Identification of the eye which is being examined.">
                comment = <"Matches to DICOM Laterality (0020,0060) attribute.">
            >
            ["at0008"] = <
