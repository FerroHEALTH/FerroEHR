    details = <
        ["en"] = <
            language = <[ISO_639-1::en]>
            purpose = <"To record the results and total score of the GAD-7 scale.">
            use = <"Use to record the results and total score of the GAD-7 scale.">
            misuse = <"">
            copyright = <"© Apperta UK, openEHR Foundation">
