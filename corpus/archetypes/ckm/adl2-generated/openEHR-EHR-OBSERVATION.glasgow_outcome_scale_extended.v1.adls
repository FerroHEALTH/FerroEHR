                text = <"Respondent (synthesised)">
                description = <" (synthesised)">
            >
            ["ac9050"] = <
                text = <"1. Er personen med hodeskade i stand til å respondere på enkel instruksjon, eller si noen ord? (synthesised)">
                description = <" (synthesised)">
            >
            ["ac9002"] = <
                text = <"2a Kreves det personhjelp til daglige aktiviteter i hjemmet hver dag? (synthesised)">
                description = <" (synthesised)">
            >
            ["ac9051"] = <
                text = <"2b Trenger han/hun ofte hjelp eller tilsyn i hjemmet? (synthesised)">
                description = <" (synthesised)">
            >
            ["ac9004"] = <
                text = <"2c Var det helt nødvendig med personhjelp i daglige aktiviteter i hjemmet før skaden? (synthesised)">
                description = <" (synthesised)">
            >
            ["ac9052"] = <
                text = <"3a Kan han/hun gjøre innkjøp uten hjelp? (synthesised)">
                description = <" (synthesised)">
            >
            ["ac9006"] = <
                text = <"3b Kunne han/hun gjøre innkjøp uten hjelp før skaden? (synthesised)">
                description = <" (synthesised)">
            >
            ["ac9053"] = <
                text = <"4a Kan han/hun reise lokalt uten hjelp? (synthesised)">
                description = <" (synthesised)">
            >
            ["ac9008"] = <
                text = <"4b Kunne han/hun reise lokalt uten hjelp før skaden? (synthesised)">
                description = <" (synthesised)">
            >
            ["ac9009"] = <
                text = <"5a Er han/hun for tiden i stand til å arbeide med samme kapasitet som tidligere? (synthesised)">
                description = <" (synthesised)">
            >
            ["ac9054"] = <
                text = <"5b Hvor store er hans/hennes begrensninger? (synthesised)">
                description = <" (synthesised)">
            >
            ["ac9011"] = <
                text = <"5c Var han/hun i arbeid eller arbeidssøkende før skaden (svar \"ja\") eller ingen av delene (svar \"nei\")? (synthesised)">
                description = <" (synthesised)">
            >
            ["ac9012"] = <
                text = <"6a Kan han/hun gjenoppta regelmessige sosiale aktiviteter og fritidsaktiviteter utenfor hjemmet? (synthesised)">
                description = <" (synthesised)">
            >
            ["ac9055"] = <
                text = <"6b Hvor omfattende er begrensningene i sosiale aktiviteter og fritidsaktiviteter (utenfor hjemmet)? (synthesised)">
                description = <" (synthesised)">
            >
            ["ac9014"] = <
                text = <"6c Deltok han/hun jevnlig i sosiale aktiviteter og fritidsaktiviteter utenfor hjemmet før skaden? (synthesised)">
                description = <" (synthesised)">
            >
            ["ac9015"] = <
                text = <"7a Har det vært psykologiske problemer som har resultert i pågående belastninger eller splid i vennskap eller familieforhold? (synthesised)">
                description = <" (synthesised)">
            >
            ["ac9056"] = <
                text = <"7b Hva har vært omfanget av disse problemene? (synthesised)">
                description = <" (synthesised)">
            >
            ["ac9017"] = <
                text = <"7c Var det problemer i forhold til familie eller venner før skaden? (synthesised)">
                description = <" (synthesised)">
            >
            ["ac9057"] = <
                text = <"8a Er det andre aktuelle problemer relatert til skaden som påvirker dagliglivet? (synthesised)">
                description = <" (synthesised)">
            >
            ["ac9019"] = <
                text = <"8b Var de tilsvarende problemene tilstede også før skaden? (synthesised)">
                description = <" (synthesised)">
            >
            ["ac9020"] = <
