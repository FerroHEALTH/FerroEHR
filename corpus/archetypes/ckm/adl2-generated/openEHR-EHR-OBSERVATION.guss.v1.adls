        ["2"] = <"University for Continuing Education Krems. GUSS - Gugging Swallowing Screen [Internet]. [cited 2025 September 05]. Available from: https://www.donau-uni.ac.at/en/university/faculties/health-medicine/departments/clinical-neurosciences-preventive-medicine/research/research-projects/guss.html">
