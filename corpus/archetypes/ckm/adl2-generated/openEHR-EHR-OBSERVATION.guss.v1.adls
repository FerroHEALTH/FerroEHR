    details = <
        ["nb"] = <
            language = <[ISO_639-1::nb]>
            purpose = <"For å registrere resultatene for hver enkelt parameter og totalskår for Gugging Swallowing Screen (GUSS).">
            keywords = <"dysfagi, aspirasjon, svelging", ...>
            use = <"Brukes for å registrere resultatene for hver enkelt parameter og totalskår for Gugging Swallowing Screen (GUSS).

openEHR-arketyper er fritt tilgjengelige under en åpen lisens, men det spesifikke innholdet i denne Gugging Swallowing Screen-arketypen er antatt opphavsrettslig beskyttet. All bruk av denne arketypen i implementasjoner må gjøres i henhold til eventuelle vilkår gitt av innehaverne av opphavsretten.

Informasjon om opphavsrett: GUSS - Gugging Swallowing Screen - University for Continuing Education Krems [Internet], available from https://www.donau-uni.ac.at/en/university/faculties/health-medicine/departments/clinical-neurosciences-preventive-medicine/research/research-projects/guss.html.">
            misuse = <"Skal ikke brukes for å registrere resultatene for Gugging Swallowing Screen for Intensive Care Units (GUSS-ICU). Bruk arketypen OBSERVATION.guss_icu til dette formålet.">
            copyright = <"© openEHR Foundation">
        >
        ["en"] = <
            language = <[ISO_639-1::en]>
            purpose = <"To record the result for each component parameter and the total sum for the Gugging Swallowing Screen (GUSS).">
            keywords = <"dysphagia, aspiration, swallowing", ...>
            use = <"Use to record the result for each component parameter and the total sum for the Gugging Swallowing Screen (GUSS).

While openEHR archetypes are all freely available under an open license, the specific content of this Gugging Swallowing Screen archetype is assumed to be copyright protected, although the terms of copyright are not known at the time of publication. Any use of this archetype within implementations must be in compliance with any terms established by the copyright owners.

Copyright information: GUSS - Gugging Swallowing Screen - University for Continuing Education Krems [Internet], available from https://www.donau-uni.ac.at/en/university/faculties/health-medicine/departments/clinical-neurosciences-preventive-medicine/research/research-projects/guss.html.">
            misuse = <"Not to be used to record the Gugging Swallowing Screen for Intensive Care Units (GUSS-ICU). Use the OBSERVATION.guss_icu archetype for this purpose.">
            copyright = <"© openEHR Foundation">
        >
    >

definition
    OBSERVATION[at0000] matches {    -- Gugging Swallowing Screen (GUSS)
        data matches {
            HISTORY[at0001] matches {
                events cardinality matches {1..*; unordered} matches {
                    EVENT[at0002] matches {    -- Any event
                        data matches {
                            ITEM_TREE[at0003] matches {
                                items cardinality matches {0..*; unordered} matches {
                                    CLUSTER[at0004] occurrences matches {0..1} matches {    -- Preliminary Investigation/Indirect Swallowing Test
                                        items cardinality matches {1..*; unordered} matches {
                                            ELEMENT[at0005] occurrences matches {0..1} matches {    -- Vigilance
                                                value matches {
                                                    DV_ORDINAL[at9018] matches {
                                                        [value, symbol] matches {
                                                            [{1}, {[at0006]}],    -- Yes
                                                            [{0}, {[at0007]}]    -- No
                                                        }
                                                    }
                                                }
                                            }
                                            ELEMENT[at0008] occurrences matches {0..1} matches {    -- Coughing and/or throat clearing
                                                value matches {
                                                    DV_ORDINAL[at9019] matches {
                                                        [value, symbol] matches {
                                                            [{1}, {[at0009]}],    -- Yes
                                                            [{0}, {[at0010]}]    -- No
                                                        }
                                                    }
                                                }
                                            }
                                            ELEMENT[at0011] occurrences matches {0..1} matches {    -- Swallowing successful
                                                value matches {
                                                    DV_ORDINAL[at9020] matches {
                                                        [value, symbol] matches {
                                                            [{1}, {[at0012]}],    -- Yes
                                                            [{0}, {[at0013]}]    -- No
                                                        }
                                                    }
                                                }
                                            }
                                            ELEMENT[at0014] occurrences matches {0..1} matches {    -- Drooling
                                                value matches {
                                                    DV_ORDINAL[at9021] matches {
                                                        [value, symbol] matches {
                                                            [{0}, {[at0015]}],    -- Yes
                                                            [{1}, {[at0016]}]    -- No
                                                        }
                                                    }
                                                }
                                            }
                                            ELEMENT[at0017] occurrences matches {0..1} matches {    -- Voice change
                                                value matches {
                                                    DV_ORDINAL[at9022] matches {
                                                        [value, symbol] matches {
                                                            [{0}, {[at0018]}],    -- Yes
                                                            [{1}, {[at0019]}]    -- No
                                                        }
                                                    }
                                                }
                                            }
                                            ELEMENT[at0034] occurrences matches {0..1} matches {    -- Sum
                                                value matches {
                                                    DV_COUNT[at9023] matches {
                                                        magnitude matches {|0..5|}
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    CLUSTER[at0020] occurrences matches {0..1} matches {    -- Semisolid
                                        items cardinality matches {1..*; unordered} matches {
                                            ELEMENT[at0021] occurrences matches {0..1} matches {    -- Deglutition
                                                value matches {
                                                    DV_ORDINAL[at9024] matches {
                                                        [value, symbol] matches {
                                                            [{0}, {[at0022]}],    -- Swallowing not possible
                                                            [{1}, {[at0023]}],    -- Swallowing delayed
                                                            [{2}, {[at0024]}]    -- Swallowing successful
                                                        }
                                                    }
                                                }
                                            }
                                            ELEMENT[at0025] occurrences matches {0..1} matches {    -- Coughing (involuntary)
                                                value matches {
                                                    DV_ORDINAL[at9025] matches {
                                                        [value, symbol] matches {
                                                            [{0}, {[at0026]}],    -- Yes
                                                            [{1}, {[at0027]}]    -- No
                                                        }
                                                    }
                                                }
                                            }
                                            ELEMENT[at0028] occurrences matches {0..1} matches {    -- Drooling
                                                value matches {
                                                    DV_ORDINAL[at9026] matches {
                                                        [value, symbol] matches {
                                                            [{0}, {[at0029]}],    -- Yes
                                                            [{1}, {[at0030]}]    -- No
                                                        }
                                                    }
                                                }
                                            }
                                            ELEMENT[at0031] occurrences matches {0..1} matches {    -- Voice change
                                                value matches {
                                                    DV_ORDINAL[at9027] matches {
                                                        [value, symbol] matches {
                                                            [{0}, {[at0032]}],    -- Yes
                                                            [{1}, {[at0033]}]    -- No
                                                        }
                                                    }
                                                }
                                            }
                                            ELEMENT[at0035] occurrences matches {0..1} matches {    -- Sum
                                                value matches {
                                                    DV_COUNT[at9028] matches {
                                                        magnitude matches {|0..5|}
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    CLUSTER[at0036] occurrences matches {0..1} matches {    -- Liquid
                                        items cardinality matches {1..*; unordered} matches {
                                            ELEMENT[at0037] occurrences matches {0..1} matches {    -- Deglutition
                                                value matches {
                                                    DV_ORDINAL[at9029] matches {
                                                        [value, symbol] matches {
                                                            [{0}, {[at0038]}],    -- Swallowing not possible
                                                            [{1}, {[at0039]}],    -- Swallowing delayed
                                                            [{2}, {[at0040]}]    -- Swallowing successful
                                                        }
                                                    }
                                                }
                                            }
                                            ELEMENT[at0041] occurrences matches {0..1} matches {    -- Coughing (involuntary)
                                                value matches {
                                                    DV_ORDINAL[at9030] matches {
                                                        [value, symbol] matches {
                                                            [{0}, {[at0042]}],    -- Yes
                                                            [{1}, {[at0043]}]    -- No
                                                        }
                                                    }
                                                }
                                            }
                                            ELEMENT[at0044] occurrences matches {0..1} matches {    -- Drooling
                                                value matches {
                                                    DV_ORDINAL[at9031] matches {
                                                        [value, symbol] matches {
                                                            [{0}, {[at0045]}],    -- Yes
                                                            [{1}, {[at0046]}]    -- No
                                                        }
                                                    }
                                                }
                                            }
                                            ELEMENT[at0047] occurrences matches {0..1} matches {    -- Voice change
                                                value matches {
                                                    DV_ORDINAL[at9032] matches {
                                                        [value, symbol] matches {
                                                            [{0}, {[at0048]}],    -- Yes
                                                            [{1}, {[at0049]}]    -- No
                                                        }
                                                    }
                                                }
                                            }
                                            ELEMENT[at0050] occurrences matches {0..1} matches {    -- Sum
                                                value matches {
                                                    DV_COUNT[at9033] matches {
                                                        magnitude matches {|0..5|}
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    CLUSTER[at0051] occurrences matches {0..1} matches {    -- Solid
                                        items cardinality matches {1..*; unordered} matches {
                                            ELEMENT[at0052] occurrences matches {0..1} matches {    -- Deglutition
                                                value matches {
                                                    DV_ORDINAL[at9034] matches {
                                                        [value, symbol] matches {
                                                            [{0}, {[at0053]}],    -- Swallowing not possible
                                                            [{1}, {[at0054]}],    -- Swallowing delayed
                                                            [{2}, {[at0055]}]    -- Swallowing successful
                                                        }
                                                    }
                                                }
                                            }
                                            ELEMENT[at0056] occurrences matches {0..1} matches {    -- Coughing (involuntary)
                                                value matches {
                                                    DV_ORDINAL[at9035] matches {
                                                        [value, symbol] matches {
                                                            [{0}, {[at0057]}],    -- Yes
                                                            [{1}, {[at0058]}]    -- No
                                                        }
                                                    }
                                                }
                                            }
                                            ELEMENT[at0059] occurrences matches {0..1} matches {    -- Drooling
                                                value matches {
                                                    DV_ORDINAL[at9036] matches {
                                                        [value, symbol] matches {
                                                            [{0}, {[at0060]}],    -- Yes
                                                            [{1}, {[at0061]}]    -- No
                                                        }
                                                    }
                                                }
                                            }
                                            ELEMENT[at0062] occurrences matches {0..1} matches {    -- Voice change
                                                value matches {
                                                    DV_ORDINAL[at9037] matches {
                                                        [value, symbol] matches {
                                                            [{0}, {[at0063]}],    -- Yes
                                                            [{1}, {[at0064]}]    -- No
                                                        }
                                                    }
                                                }
                                            }
                                            ELEMENT[at0065] occurrences matches {0..1} matches {    -- Sum
                                                value matches {
                                                    DV_COUNT[at9038] matches {
                                                        magnitude matches {|0..5|}
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0066] occurrences matches {0..1} matches {    -- Sum
                                        value matches {
                                            DV_COUNT[at9039] matches {
                                                magnitude matches {|0..20|}
                                            }
                                        }
                                    }
                                    ELEMENT[at0069] occurrences matches {0..1} matches {    -- Results and severity code
                                        value matches {
                                            DV_CODED_TEXT[at9040] matches {
                                                defining_code matches {[ac9017]}    -- Results and severity code (synthesised)
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        protocol matches {
            ITEM_TREE[at0067] matches {
                items cardinality matches {0..*; unordered} matches {
                    allow_archetype CLUSTER[at0068] matches {    -- Extension
                        include
                            archetype_id/value matches {/.*/}
                    }
                }
            }
        }
    }

