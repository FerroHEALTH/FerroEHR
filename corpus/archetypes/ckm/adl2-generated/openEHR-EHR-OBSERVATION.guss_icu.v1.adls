    details = <
        ["nb"] = <
            language = <[ISO_639-1::nb]>
            purpose = <"For å registrere resultatene for hver enkelt parameter og totalskår for Gugging Swallowing Screen for Intensive Care Units (GUSS-ICU).
">
            keywords = <"svelging, dysfagi, aspirasjon, intensivavdeling, slag, ekstubasjon", ...>
            use = <"Brukes for å registrere resultatene for hver enkelt parameter og totalskår for Gugging Swallowing Screen for Intensive Care Units (GUSS-ICU).

openEHR-arketyper er fritt tilgjengelige under en åpen lisens, men det spesifikke innholdet i denne Gugging Swallowing Screen for Intensive Care Units (GUSS-ICU)-arketypen er antatt opphavsrettslig beskyttet. All bruk av denne arketypen i implementasjoner må gjøres i henhold til eventuelle vilkår gitt av innehaverne av opphavsretten.
 
Informasjon om opphavsrett: GUSS - Gugging Swallowing Screen - University for Continuing Education Krems [Internet], available from https://www.donau-uni.ac.at/en/university/faculties/health-medicine/departments/health-sciences-medicine-research/clinical-neurosciences/research/research-projects/guss/guss-icu.html">
            misuse = <"Skal ikke brukes for å registrere resultatene for Gugging Swallowing Screen (GUSS). Bruk arketypen OBSERVATION.guss til dette formålet.
">
            copyright = <"© openEHR Foundation">
        >
        ["en"] = <
            language = <[ISO_639-1::en]>
            purpose = <"To record the result for each component parameter and the total sum for the Gugging Swallowing Screen for Intensive Care Units (GUSS-ICU).">
            keywords = <"dysphagia, aspiration, swallowing, ICU, intensive care unit, stroke, extubation", ...>
            use = <"Use to record the result for each component parameter and their total sum for the Gugging Swallowing Screen for Intensive Care Units (GUSS-ICU).

While openEHR archetypes are all freely available under an open license, the specific content of this Gugging Swallowing Screen for Intensive Care Units (GUSS-ICU) archetype is assumed to be copyright protected, although the terms of copyright are not known at the time of publication. Any use of this archetype within implementations must be in compliance with any terms established by the copyright owners. 

Copyright information: Gugging Swallowing Screen for Intensive Care Units (GUSS-ICU) - University for Continuing Education Krems [Internet], available from https://www.donau-uni.ac.at/en/university/faculties/health-medicine/departments/health-sciences-medicine-research/clinical-neurosciences/research/research-projects/guss/guss-icu.html.">
            misuse = <"Not to be used to record the Gugging Swallowing Screen (GUSS). Use the OBSERVATION.guss archetype for this purpose.">
            copyright = <"© openEHR Foundation">
        >
    >

definition
    OBSERVATION[at0000] matches {    -- Gugging Swallowing Screen for Intensive Care Units (GUSS - ICU)
        data matches {
            HISTORY[at0001] matches {
                events cardinality matches {1..*; unordered} matches {
                    EVENT[at0002] matches {    -- Any event
                        data matches {
                            ITEM_TREE[at0003] matches {
                                items cardinality matches {0..*; unordered} matches {
                                    CLUSTER[at0004] occurrences matches {0..1} matches {    -- Preliminary Investigation / Indirect Swallowing Test
                                        items cardinality matches {1..*; unordered} matches {
                                            ELEMENT[at0005] occurrences matches {0..1} matches {    -- RASS from 0 to +2
                                                value matches {
                                                    DV_ORDINAL[at9011] matches {
                                                        [value, symbol] matches {
                                                            [{1}, {[at0006]}],    -- Yes
                                                            [{0}, {[at0007]}]    -- No
                                                        }
                                                    }
                                                }
                                            }
                                            ELEMENT[at0035] occurrences matches {0..1} matches {    -- Stridor present
                                                value matches {
                                                    DV_ORDINAL[at9012] matches {
                                                        [value, symbol] matches {
                                                            [{0}, {[at0036]}],    -- Yes
                                                            [{1}, {[at0037]}]    -- No
                                                        }
                                                    }
                                                }
                                            }
                                            ELEMENT[at0008] occurrences matches {0..1} matches {    -- Coughing and/or throat clearing efficiently
                                                value matches {
                                                    DV_ORDINAL[at9013] matches {
                                                        [value, symbol] matches {
                                                            [{1}, {[at0012]}],    -- Yes
                                                            [{0}, {[at0013]}]    -- No
                                                        }
                                                    }
                                                }
                                            }
                                            ELEMENT[at0009] occurrences matches {0..1} matches {    -- Swallowing saliva possible
                                                value matches {
                                                    DV_ORDINAL[at9014] matches {
                                                        [value, symbol] matches {
                                                            [{1}, {[at0014]}],    -- Yes
                                                            [{0}, {[at0015]}]    -- No
                                                        }
                                                    }
                                                }
                                            }
                                            ELEMENT[at0010] occurrences matches {0..1} matches {    -- Drooling (saliva)
                                                value matches {
                                                    DV_ORDINAL[at9015] matches {
                                                        [value, symbol] matches {
                                                            [{0}, {[at0016]}],    -- Yes
                                                            [{1}, {[at0017]}]    -- No
                                                        }
                                                    }
                                                }
                                            }
                                            ELEMENT[at0011] occurrences matches {0..1} matches {    -- Change of voice after swallowing saliva
                                                value matches {
                                                    DV_ORDINAL[at9016] matches {
                                                        [value, symbol] matches {
                                                            [{0}, {[at0018]}],    -- Yes
                                                            [{1}, {[at0019]}]    -- No
                                                        }
                                                    }
                                                }
                                            }
                                            ELEMENT[at0020] occurrences matches {0..1} matches {    -- Sum
                                                value matches {
                                                    DV_COUNT[at9017] matches {
                                                        magnitude matches {|0..6|}
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    CLUSTER[at0021] occurrences matches {0..1} matches {    -- Direct Swallowing Test (4 subtests)
                                        items cardinality matches {1..*; unordered} matches {
                                            ELEMENT[at0022] occurrences matches {0..1} matches {    -- Semisolid
                                                value matches {
                                                    DV_ORDINAL[at9018] matches {
                                                        [value, symbol] matches {
                                                            [{1}, {[at0039]}],    -- Pass
                                                            [{0}, {[at0040]}]    -- Fail
                                                        }
                                                    }
                                                }
                                            }
                                            ELEMENT[at0023] occurrences matches {0..1} matches {    -- Liquids
                                                value matches {
                                                    DV_ORDINAL[at9019] matches {
                                                        [value, symbol] matches {
                                                            [{1}, {[at0047]}],    -- Pass
                                                            [{0}, {[at0048]}]    -- Fail
                                                        }
                                                    }
                                                }
                                            }
                                            ELEMENT[at0024] occurrences matches {0..1} matches {    -- Solids
                                                value matches {
                                                    DV_ORDINAL[at9020] matches {
                                                        [value, symbol] matches {
                                                            [{1}, {[at0049]}],    -- Pass
                                                            [{0}, {[at0050]}]    -- Fail
                                                        }
                                                    }
                                                }
                                            }
                                            ELEMENT[at0025] occurrences matches {0..1} matches {    -- Liquids & Solids
                                                value matches {
                                                    DV_ORDINAL[at9021] matches {
                                                        [value, symbol] matches {
                                                            [{1}, {[at0051]}],    -- Pass
                                                            [{0}, {[at0052]}]    -- Fail
                                                        }
                                                    }
                                                }
                                            }
                                            ELEMENT[at0026] occurrences matches {0..1} matches {    -- Sum
                                                value matches {
                                                    DV_COUNT[at9022] matches {
                                                        magnitude matches {|0..4|}
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0027] occurrences matches {0..1} matches {    -- Total sum
                                        value matches {
                                            DV_COUNT[at9023] matches {
                                                magnitude matches {|0..10|}
                                            }
                                        }
                                    }
                                    ELEMENT[at0030] occurrences matches {0..1} matches {    -- Severity code
                                        value matches {
                                            DV_CODED_TEXT[at9024] matches {
                                                defining_code matches {[ac9010]}    -- Severity code (synthesised)
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        protocol matches {
            ITEM_TREE[at0028] matches {
                items cardinality matches {0..*; unordered} matches {
                    allow_archetype CLUSTER[at0029] matches {    -- Extension
                        include
                            archetype_id/value matches {/.*/}
                    }
                }
            }
        }
    }

