            ["ac9005"] = <
                text = <"Protokoll for måling (synthesised)">
                description = <"Spesifikasjon av protokollen eller den standardiserte metoden som ble brukt til å måle håndgrepsstyrke under vurderingen. (synthesised)">
            >
        >
        ["en"] = <
            ["at0000"] = <
                text = <"Handgrip strength">
                description = <"The maximum voluntary isometric force generated by the muscles of the hand and forearm during a gripping action, usually measured with a hand-held dynamometer.">
            >
            ["at0002"] = <
                text = <"Any event">
                description = <"Default, unspecified point in time or interval event which may be explicitly defined in a template or at run-time.">
            >
            ["at0004"] = <
                text = <"Measured hand">
                description = <"The hand for which handgrip strength was measured.">
            >
            ["at0005"] = <
                text = <"Right hand">
                description = <"">
            >
            ["at0006"] = <
                text = <"Left hand">
                description = <"">
            >
            ["at0007"] = <
                text = <"Grip strength">
                description = <"The measured force produced during a handgrip.">
            >
            ["at0008"] = <
                text = <"Comment">
                description = <"Additional narrative about the handgrip strength not captured in other fields.">
            >
            ["at0010"] = <
                text = <"Measuring device">
                description = <"Details about the device used to measure the handgrip strength.">
            >
            ["at0019"] = <
                text = <"Confounding factors">
                description = <"Issues or factors that may impact on the measurement of handgrip strength, not captured in other fields.">
                comment = <"For example: pain, musculoskeletal conditions, fatigue, or deviations from a measurement protocol.">
            >
            ["at0024"] = <
                text = <"Extension">
                description = <"Additional information required to extend the model with local content or to align with other reference models or formalisms.">
                comment = <"For example: local information requirements; or additional metadata to align with FHIR.">
            >
            ["at0032"] = <
                text = <"Measurement protocol">
