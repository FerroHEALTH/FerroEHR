    details = <
        ["nb"] = <
            language = <[ISO_639-1::nb]>
            purpose = <"For å registrere et individs håndgrepsstyrke.">
            keywords = <"Gripestyrke, grepstyrke, håndgrepsstyrke, muskelstyrke, styrke i overekstremitetene, dynamometer, skrøpelighet, håndfunksjon, funksjonsstatus, fysisk funksjon, rehabilitering, fysioterapi, ergoterapi", ...>
            use = <"Brukes for å registrere et individs håndgrepsstyrke.">
            misuse = <"Brukes ikke for å registrere estimert eller ikke‑målt håndgrepsstyrke. Brukes ikke for å registrere andre gripestyrker som nøkkelklypestyrke, fingertuppklypestyrke eller trepunktsklypestyrke. Behovet for egne arketyper for disse formålene er anerkjent, men slike arketyper var ikke tilgjengelige da denne arketypen ble publisert.">
            copyright = <"© openEHR Foundation">
        >
        ["en"] = <
            language = <[ISO_639-1::en]>
            purpose = <"To record the measured handgrip strength of an individual, typically using a hand dynamometer.">
            keywords = <"grip strength, grip, strength, handgrip strength, muscle strength, upper limp strength, dynamometer, frailty, functional status, hand function, physical performance, rehabilitation, physiotherapy, occupational therapy", ...>
            use = <"Use to record the measured handgrip strength of an individual, typically using a hand dynamometer.">
            misuse = <"Not to be used to record estimated or non‑measured handgrip strength. Not to be used to record other grip types such as lateral pinch, tip pinch, or three‑jaw chuck pinch. The need for a specific archetypes for these purposes is acknowledged but had not yet been developed at the time of the publication of this archetype.">
        >
    >

definition
    OBSERVATION[at0000] matches {    -- Handgrip strength
        data matches {
            HISTORY[at0001] matches {
                events cardinality matches {1..*; unordered} matches {
                    EVENT[at0002] matches {    -- Any event
                        data matches {
                            ITEM_TREE[at0003] matches {
                                items cardinality matches {0..*; unordered} matches {
                                    ELEMENT[at0004] occurrences matches {1} matches {    -- Measured hand
                                        value matches {
                                            DV_CODED_TEXT[at9006] matches {
                                                defining_code matches {[ac9000]}    -- Measured hand (synthesised)
                                            }
                                        }
                                    }
                                    ELEMENT[at0007] occurrences matches {1} matches {    -- Grip strength
                                        value matches {
                                            DV_QUANTITY[at9007] matches {
                                                property matches {[at9001]}    -- Force
                                                [magnitude, units] matches {
                                                    [{|>=0.0|}, {"kgf"}],
                                                    [{|>=0.0|}, {"[lbf_av]"}],
                                                    [{|>=0.0|}, {"N"}]
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0008] occurrences matches {0..1} matches {    -- Comment
                                        value matches {
                                            DV_TEXT[at9008]
                                        }
                                    }
                                }
                            }
                        }
                        state matches {
                            ITEM_TREE[at0013] matches {
                                items cardinality matches {0..*; unordered} matches {
                                    ELEMENT[at0019] occurrences matches {0..1} matches {    -- Confounding factors
                                        value matches {
                                            DV_TEXT[at9010]
                                        }
                                    }
                                }
                            }
                        }
                    }
                    INTERVAL_EVENT[at0035] occurrences matches {0..1} matches {    -- Maximum grip strength
                        data matches {
                            use_node ITEM_TREE[at9013] /data[at0001]/events[at0002]/data[at0003]
                        }
                        state matches {
                            use_node ITEM_TREE[at9014] /data[at0001]/events[at0002]/state[at0013]
                        }
                        math_function matches {
                            DV_CODED_TEXT[at9015] matches {
                                defining_code matches {[at9003]}    -- maximum
                            }
                        }
                    }
                    INTERVAL_EVENT[at0036] occurrences matches {0..1} matches {    -- Mean grip strength
                        data matches {
                            use_node ITEM_TREE[at9016] /data[at0001]/events[at0002]/data[at0003]
                        }
                        state matches {
                            use_node ITEM_TREE[at9017] /data[at0001]/events[at0002]/state[at0013]
                        }
                        math_function matches {
                            DV_CODED_TEXT[at9018] matches {
                                defining_code matches {[at9004]}    -- mean
                            }
                        }
                    }
                }
            }
        }
        protocol matches {
            ITEM_TREE[at0011] matches {
                items cardinality matches {0..*; unordered} matches {
                    ELEMENT[at0032] occurrences matches {0..1} matches {    -- Measurement protocol
                        value matches {
                            DV_CODED_TEXT[at9019] matches {
                                defining_code matches {[ac9005]}    -- Measurement protocol (synthesised)
                            }
                            DV_TEXT[at9020]
                        }
                    }
                    ELEMENT[at0039] occurrences matches {0..1} matches {    -- Grip span
                        value matches {
                            DV_QUANTITY[at9022] matches {
                                property matches {[at9021]}    -- Length
                                [magnitude, units, precision] matches {
                                    [{|0.0..<100.0|}, {"cm"}, {1}],
                                    [{|0.0..<1000.0|}, {"mm"}, {|>=0|}]
                                }
                            }
                            DV_TEXT[at9023]
                        }
                    }
                    allow_archetype CLUSTER[at0010] occurrences matches {0..1} matches {    -- Measuring device
                        include
                            archetype_id/value matches {/.*|openEHR-EHR-CLUSTER\.device(-[a-zA-Z0-9_]+)*\.v1\..*/}
                    }
                    allow_archetype CLUSTER[at0024] matches {    -- Extension
                        include
                            archetype_id/value matches {/.*/}
                    }
                }
            }
        }
    }

terminology
    term_definitions = <
        ["nb"] = <
            ["at0000"] = <
                text = <"Håndgrepsstyrke">
                description = <"Den maksimale viljestyrte isometriske kraften som genereres av musklene i hånd og underarm under et håndgrep, vanligvis målt med et håndholdt dynamometer.">
            >
            ["at0002"] = <
                text = <"Uspesifisert hendelse">
                description = <"Standard, uspesifisert tidspunkt eller tidsintervall som kan defineres mer eksplisitt i en template eller i en applikasjon.">
            >
            ["at0004"] = <
                text = <"Målt hånd">
                description = <"Hånden som ble brukt ved måling av håndgrepsstyrke.">
            >
            ["at0005"] = <
                text = <"Høyre hånd">
                description = <"">
            >
            ["at0006"] = <
                text = <"Venstre hånd">
                description = <"">
            >
            ["at0007"] = <
                text = <"Gripestyrke">
                description = <"Den målte kraften som genereres under et håndgrep.">
            >
            ["at0008"] = <
                text = <"Kommentar">
                description = <"Ytterligere fritekst om målingen, som ikke omfattes av andre felt.">
            >
            ["at0010"] = <
                text = <"Måleapparat">
                description = <"Detaljer om utstyret som ble brukt til å måle håndgrepsstyrken.">
            >
            ["at0019"] = <
                text = <"Konfunderende faktorer">
                description = <"Problemer eller faktorer som kan påvirke målingen av håndgrepsstyrke, som ikke fanges opp i andre felt.">
                comment = <"For eksempel: smerte, muskel‑ og skjelettlidelser, tretthet eller avvik fra en måleprotokoll.">
            >
            ["at0024"] = <
                text = <"Tilleggsinformasjon">
                description = <"Ytterligere informasjon som trengs for å kunne registrere lokalt definert innhold eller for å tilpasse til andre referansemodeller/formalismer.">
                comment = <"For eksempel lokale informasjonsbehov eller ytterligere metadata for å kunne tilpasse til tilsvarende konsepter i FHIR eller CIMI.">
            >
            ["at0032"] = <
                text = <"Protokoll for måling">
                description = <"Spesifikasjon av protokollen eller den standardiserte metoden som ble brukt til å måle håndgrepsstyrke under vurderingen.">
            >
            ["at0034"] = <
                text = <"NIHR Southampton Biomedial Research Centre">
                description = <"">
            >
            ["at0035"] = <
                text = <"Maksimal håndgrepsstyrke">
                description = <"Maksimal håndgrepsstyrke beregnet fra en serie målinger, registrert som den høyeste verdien oppnådd under standardiserte testforhold.">
            >
            ["at0036"] = <
                text = <"Gjennomsnittlig håndgrepsstyrke">
                description = <"Gjennomsnittlig gripestyrke beregnet fra en serie målinger, registrert som gjennomsnittsverdien oppnådd under standardiserte testforhold.">
            >
            ["at0037"] = <
                text = <"Jamar Standard Position (American Society of Hand Therapists)">
                description = <"">
            >
            ["at0038"] = <
                text = <"NIH Toolbox Grip Strength Test">
                description = <"">
            >
            ["at0039"] = <
                text = <"Gripespenn">
                description = <"Den faktiske avstanden mellom håndtakene på dynamometeret ved måletidspunktet.">
                comment = <"Kan registreres som en kontinuerlig lengde i centimeter eller millimeter, eller som en kodet produsentdefinert innstilling for instrumenter som ikke angir en numerisk avstand.">
            >
            ["at9021"] = <
                text = <"* Length (en)">
                description = <"* Length (en)">
            >
            ["at9003"] = <
