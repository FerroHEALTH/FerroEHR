    details = <
        ["en"] = <
            language = <[ISO_639-1::en]>
            purpose = <"For the recording of details of the Health Assessment Questionnaire used to assess how a subject's arthritis affects his or her ability to function in daily life.">
            keywords = <"HAQ", "Health Assessment", "Questionnaire", "Arthritis">
            use = <"To record the details of the Health Assessment Questionnaire used in Rare Diseases management settings to assess how a subject's arthritis affects his or her ability to function in daily life.">
            misuse = <"">
            copyright = <"© Clinical Models UK">
        >
    >

definition
    OBSERVATION[at0000] matches {    -- Health Assessment Questionnaire
        data matches {
            HISTORY[at0001] matches {
                events cardinality matches {1..*; unordered} matches {
                    POINT_EVENT[at0002] occurrences matches {0..1} matches {    -- Point in time
                        data matches {
                            ITEM_TREE[at0003] matches {
                                items cardinality matches {0..*; unordered} matches {
                                    CLUSTER[at0008] occurrences matches {0..1} matches {    -- Dressing and grooming
                                        items cardinality matches {1..*; unordered} matches {
                                            ELEMENT[at0004] occurrences matches {0..1} matches {    -- Dress
                                                value matches {
                                                    DV_CODED_TEXT[at9023] matches {
                                                        defining_code matches {[ac9000]}    -- Dress (synthesised)
                                                    }
                                                }
                                            }
                                            ELEMENT[at0005] occurrences matches {0..1} matches {    -- Shampoo
                                                value matches {
                                                    DV_CODED_TEXT[at9024] matches {
                                                        defining_code matches {[ac9001]}    -- Shampoo (synthesised)
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    CLUSTER[at0029] occurrences matches {0..1} matches {    -- Arising
                                        items cardinality matches {1..*; unordered} matches {
                                            ELEMENT[at0030] occurrences matches {0..1} matches {    -- Stand up
                                                value matches {
                                                    DV_CODED_TEXT[at9025] matches {
                                                        defining_code matches {[ac9002]}    -- Stand up (synthesised)
                                                    }
                                                }
                                            }
                                            ELEMENT[at0036] occurrences matches {0..1} matches {    -- Get in and out of bed
                                                value matches {
                                                    DV_CODED_TEXT[at9026] matches {
                                                        defining_code matches {[ac9003]}    -- Get in and out of bed (synthesised)
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    CLUSTER[at0042] occurrences matches {0..1} matches {    -- Eating
                                        items cardinality matches {1..*; unordered} matches {
                                            ELEMENT[at0043] occurrences matches {0..1} matches {    -- Cut meat
                                                value matches {
                                                    DV_CODED_TEXT[at9027] matches {
                                                        defining_code matches {[ac9004]}    -- Cut meat (synthesised)
                                                    }
                                                }
                                            }
                                            ELEMENT[at0049] occurrences matches {0..1} matches {    -- Lift up cup or glass to mouth
                                                value matches {
                                                    DV_CODED_TEXT[at9028] matches {
                                                        defining_code matches {[ac9005]}    -- Lift up cup or glass to mouth (synthesised)
                                                    }
                                                }
                                            }
                                            ELEMENT[at0055] occurrences matches {0..1} matches {    -- Open new carton of milk
                                                value matches {
                                                    DV_CODED_TEXT[at9029] matches {
                                                        defining_code matches {[ac9006]}    -- Open new carton of milk (synthesised)
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    CLUSTER[at0061] occurrences matches {0..1} matches {    -- Walking
                                        items cardinality matches {1..*; unordered} matches {
                                            ELEMENT[at0062] occurrences matches {0..1} matches {    -- Walk outdoors on flat ground
                                                value matches {
                                                    DV_CODED_TEXT[at9030] matches {
                                                        defining_code matches {[ac9007]}    -- Walk outdoors on flat ground (synthesised)
                                                    }
                                                }
                                            }
                                            ELEMENT[at0068] occurrences matches {0..1} matches {    -- Climb up five steps
                                                value matches {
                                                    DV_CODED_TEXT[at9031] matches {
                                                        defining_code matches {[ac9008]}    -- Climb up five steps (synthesised)
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    CLUSTER[at0087] occurrences matches {0..1} matches {    -- Hygiene
                                        items cardinality matches {1..*; unordered} matches {
                                            ELEMENT[at0088] occurrences matches {0..1} matches {    -- Wash and dry entire body
                                                value matches {
                                                    DV_CODED_TEXT[at9032] matches {
                                                        defining_code matches {[ac9009]}    -- Wash and dry entire body (synthesised)
                                                    }
                                                }
                                            }
                                            ELEMENT[at0094] occurrences matches {0..1} matches {    -- Take a bath
                                                value matches {
                                                    DV_CODED_TEXT[at9033] matches {
                                                        defining_code matches {[ac9010]}    -- Take a bath (synthesised)
                                                    }
                                                }
                                            }
                                            ELEMENT[at0097] occurrences matches {0..1} matches {    -- Get on and off toilet
                                                value matches {
                                                    DV_CODED_TEXT[at9034] matches {
                                                        defining_code matches {[ac9011]}    -- Get on and off toilet (synthesised)
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    CLUSTER[at0118] occurrences matches {0..1} matches {    -- Reach
                                        items cardinality matches {1..*; unordered} matches {
                                            ELEMENT[at0119] occurrences matches {0..1} matches {    -- Reach and get down 5lb object
                                                value matches {
                                                    DV_CODED_TEXT[at9035] matches {
                                                        defining_code matches {[ac9012]}    -- Reach and get down 5lb object (synthesised)
                                                    }
                                                }
                                            }
                                            ELEMENT[at0125] occurrences matches {0..1} matches {    -- Bend down to pick up
                                                value matches {
                                                    DV_CODED_TEXT[at9036] matches {
                                                        defining_code matches {[ac9013]}    -- Bend down to pick up (synthesised)
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    CLUSTER[at0143] occurrences matches {0..1} matches {    -- Grip
                                        items cardinality matches {1..*; unordered} matches {
                                            ELEMENT[at0150] occurrences matches {0..1} matches {    -- Open car doors
                                                value matches {
                                                    DV_CODED_TEXT[at9037] matches {
                                                        defining_code matches {[ac9014]}    -- Open car doors (synthesised)
                                                    }
                                                }
                                            }
                                            ELEMENT[at0156] occurrences matches {0..1} matches {    -- Open jars
                                                value matches {
                                                    DV_CODED_TEXT[at9038] matches {
                                                        defining_code matches {[ac9015]}    -- Open jars (synthesised)
                                                    }
                                                }
                                            }
                                            ELEMENT[at0162] occurrences matches {0..1} matches {    -- Turn taps on and off
                                                value matches {
                                                    DV_CODED_TEXT[at9039] matches {
                                                        defining_code matches {[ac9016]}    -- Turn taps on and off (synthesised)
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    CLUSTER[at0174] occurrences matches {0..1} matches {    -- Activities
                                        items cardinality matches {1..*; unordered} matches {
                                            ELEMENT[at0175] occurrences matches {0..1} matches {    -- Run errands and shop
                                                value matches {
                                                    DV_CODED_TEXT[at9040] matches {
                                                        defining_code matches {[ac9017]}    -- Run errands and shop (synthesised)
                                                    }
                                                }
                                            }
                                            ELEMENT[at0177] occurrences matches {0..1} matches {    -- Get in and out of car
                                                value matches {
                                                    DV_CODED_TEXT[at9041] matches {
                                                        defining_code matches {[ac9018]}    -- Get in and out of car (synthesised)
                                                    }
                                                }
                                            }
                                            ELEMENT[at0193] occurrences matches {0..1} matches {    -- Do household chores
                                                value matches {
                                                    DV_CODED_TEXT[at9042] matches {
                                                        defining_code matches {[ac9019]}    -- Do household chores (synthesised)
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0205] matches {    -- Devices used
                                        value matches {
                                            DV_CODED_TEXT[at9043] matches {
                                                defining_code matches {[ac9020]}    -- Devices used (synthesised)
                                            }
                                            DV_TEXT[at9044]
                                        }
                                    }
                                    ELEMENT[at0212] occurrences matches {0..1} matches {    -- Needs help from other person
                                        value matches {
                                            DV_CODED_TEXT[at9045] matches {
                                                defining_code matches {[ac9021]}    -- Needs help from other person (synthesised)
                                            }
                                        }
                                    }
                                    ELEMENT[at0217] occurrences matches {0..1} matches {    -- Pain score
                                        value matches {
                                            DV_QUANTITY[at9046] matches {
                                                property matches {[at9022]}    -- Qualified real
                                                magnitude matches {|0.0..100.0|}
                                                units matches {"1"}
                                            }
                                        }
                                    }
                                    ELEMENT[at0233] occurrences matches {0..1} matches {    -- Comment
                                        value matches {
                                            DV_TEXT[at9047]
                                        }
                                    }
                                }
                            }
                        }
                        state matches {
                            ITEM_TREE[at0229] matches {
                                items cardinality matches {0..*; unordered} matches {
                                    ELEMENT[at0230] matches {    -- Confounding factors
                                        value matches {
                                            DV_TEXT[at9048]
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        protocol matches {
            ITEM_TREE[at0231] matches {
                items cardinality matches {0..*; unordered} matches {
                    allow_archetype CLUSTER[at0232] matches {    -- Extension
                        include
                            archetype_id/value matches {/.*/}
                    }
                }
            }
        }
    }

