definition
    OBSERVATION[at0000.1] matches {    -- Pulse
        /data[at0002]/events matches {
            EVENT[at0003] matches {
                /data[at0001]/items matches {
                    ELEMENT[at1005.1] matches {    -- Presence
                        /value[at9006]/defining_code matches {[ac9000.1]}    -- Presence (synthesised)
                    }
                    ELEMENT[at0004.1] matches {    -- Pulse rate
                        value matches {
                            DV_QUANTITY[at0.9001] matches {
                                property matches {[at9001]}
                                magnitude matches {|0.0..<1000.0|}
                                units matches {"/min"}
                                precision matches {0}
                            }
                        }
                    }
                    ELEMENT[at0005.1] matches {    -- Regularity
                        value matches {
                            DV_CODED_TEXT[at0.9002] matches {
                                defining_code matches {[ac9002]}
                            }
                            DV_TEXT[at0.9003]
                        }
                    }
                    ELEMENT[at1022.1]    -- Clinical description
                    ELEMENT[at1023.1]    -- Clinical interpretation
                    ELEMENT[at1059.1]    -- Comment
                    after [at0005.1]
                    ELEMENT[at0.5] matches {    -- Character
                        value matches {
                            DV_TEXT[at0.9004]
                        }
                    }
                }
            }
            INTERVAL_EVENT[at1036.1]    -- Maximum pulse rate
        }
        /protocol[at0010]/items matches {
            ELEMENT[at1019.1] matches {    -- Method
                /value[at9018]/defining_code matches {[ac9005.1]}    -- Method (synthesised)
            }
            after [at1019.1]
            ELEMENT[at0.6] occurrences matches {0..1} matches {    -- Artery site
                value matches {
                    DV_CODED_TEXT[at0.9005] matches {
                        defining_code matches {[ac0.9000]}    -- Artery site (synthesised)
                    }
                    DV_TEXT[at0.9006]
                }
            }
        }
    }

terminology
    term_definitions = <
        ["de"] = <
            ["at0000.1"] = <
                text = <"*Pulse (en)">
                description = <"*Findings about consecutive pressure waves observed as blood is pumped through an artery by the heart. (en)">
            >
            ["at1005.1"] = <
                text = <"Vorhandensein">
                description = <"*Observation about the detection of an arterial pulse. (en)">
                comment = <"*It can be implied that the pulse is present if Rate >0 /min. (en)">
            >
            ["at0004.1"] = <
                text = <"*Pulse rate (en)">
                description = <"*The measured rate of the pulse. (en)">
            >
            ["at0005.1"] = <
                text = <"*Regularity(en)">
                description = <"*The regularity of the pulse. (en)">
                comment = <"*This data element allows a choice of datatypes. Use the DV_TEXT data type to support inclusion of alternative or extended value sets. (en)">
            >
            ["at1022.1"] = <
                text = <"Klinische Beschreibung">
                description = <"*Narrative description about the pulse. (en)">
            >
            ["at1023.1"] = <
                text = <"Klinische Interpretation">
                description = <"*Single word, phrase or brief description that represents the clinical meaning and significance of the pulse findings, including the rhythm. (en)">
                comment = <"*For example: 'bradycardia'; or 'ectopic beats'. Coding with a terminology is preferred, where possible. This data element has multiple occurrences to allow the recording of more than one 'Clinical interpretation'. (en)">
            >
            ["at1059.1"] = <
                text = <"Kommentar">
                description = <"*Additional narrative about the pulse findings not captured in other fields. (en)">
            >
            ["at1036.1"] = <
                text = <"*Maximum pulse rate (en)">
                description = <"*Maximum pulse rate observed during a specified time interval. (en)">
            >
            ["at1019.1"] = <
                text = <"Methode">
                description = <"*Method used to observe the pulse. (en)">
                comment = <"*For example, palpation or pulse oximetry. (en)">
            >
            ["at0.1"] = <
                text = <"*Pulse oximetry (en)">
                description = <"*The findings are observed using a pulse oximetry device. (en)">
            >
            ["at0.2"] = <
                text = <"*Doppler (en)">
                description = <"*The findings are observed using a doppler ultrasound device. (en)">
            >
            ["at0.3"] = <
                text = <"*Oscillometry (en)">
                description = <"*The findings are observed using an oscillometric device, such as an automatic blood pressure device. (en)">
            >
            ["at0.4"] = <
                text = <"*Intra-arterial probe (en)">
                description = <"*The findings are observed using an intra-arterial probe, directly measuring the pressure wave in the artery. (en)">
            >
            ["at1013.1"] = <
                text = <"Gerät">
                description = <"*Details about the device used to measure the pulse. (en)">
            >
            ["at0.5"] = <
                text = <"*Character (en)">
                description = <"*Description of the character of the pulse. (en)">
                comment = <"*Coding with a terminology is desired, where possible. For example: full, thready, bounding, slow rising, or collapsing. Multiple terms may be recorded. (en)">
            >
            ["at0.6"] = <
                text = <"*Artery site (en)">
                description = <"*Body site where the pulse was observed. (en)">
                comment = <"*This data element allows a choice of datatypes. Use the DV_TEXT data type to support inclusion of alternative or extended value sets. (en)">
            >
            ["at0.7"] = <
                text = <"*Radial artery - Left (en)">
