                                                    [{1}, {[at0031]}],    -- Mild
                                                    [{2}, {[at0032]}],    -- Moderate
                                                    [{3}, {[at0033]}],    -- Severe
                                                    [{4}, {[at0034]}]    -- Extreme
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0035] occurrences matches {0..1} matches {    -- S4. How severe is your hip joint stiffness after first wakening in the morning?
                                        value matches {
                                            DV_ORDINAL[at9043] matches {
                                                [value, symbol] matches {
