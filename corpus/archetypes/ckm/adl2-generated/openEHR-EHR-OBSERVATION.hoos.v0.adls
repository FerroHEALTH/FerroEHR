                                    }
                                    ELEMENT[at0256] occurrences matches {0..1} matches {    -- Quality of life subtotal
                                        value matches {
                                            DV_COUNT[at9084]
                                        }
                                    }
                                    ELEMENT[at0257] occurrences matches {0..1} matches {    -- Total score
                                        value matches {
                                            DV_COUNT[at9085]
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        protocol matches {
            ITEM_TREE[at0004] matches {
                items cardinality matches {0..*; unordered} matches {
                    allow_archetype CLUSTER[at0264] matches {    -- Extension
                        include
                            archetype_id/value matches {/.*/}
                    }
                }
            }
        }
    }

