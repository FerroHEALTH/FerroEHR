definition
    OBSERVATION[at0000] matches {    -- Feeding
        data matches {
            HISTORY[at0001] matches {
                events cardinality matches {1..*; unordered} matches {
                    EVENT[at0002] matches {    -- Any event
                        data matches {
                            ITEM_TREE[at0003] matches {
                                items cardinality matches {0..*; unordered} matches {
                                    ELEMENT[at0029] occurrences matches {0..1} matches {    -- Description
                                        value matches {
                                            DV_TEXT[at9006]
                                        }
                                    }
                                    ELEMENT[at0030] occurrences matches {0..1} matches {    -- Infant feeding category
                                        value matches {
                                            DV_CODED_TEXT[at9007] matches {
                                                defining_code matches {[ac9000]}    -- Infant feeding category (synthesised)
                                            }
                                        }
                                    }
                                    CLUSTER[at0028] occurrences matches {0..1} matches {    -- Breast feeding
                                        items cardinality matches {1..2; unordered} matches {
                                            ELEMENT[at0022] occurrences matches {0..1} matches {    -- Proportion
                                                value matches {
                                                    DV_PROPORTION[at9008] matches {
                                                        type matches {2}
                                                    }
                                                }
                                            }
                                            ELEMENT[at0024] occurrences matches {0..1} matches {    -- Time taken
                                                value matches {
                                                    DV_QUANTITY[at9009] matches {
                                                        property matches {[at9001]}    -- Time
                                                        magnitude matches {|>=0.0|}
                                                        units matches {"min"}
                                                        precision matches {0}
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    CLUSTER[at0016] occurrences matches {0..1} matches {    -- Other method
                                        items cardinality matches {1..*; unordered} matches {
                                            ELEMENT[at0017] occurrences matches {0..1} matches {    -- Type
                                                value matches {
                                                    DV_CODED_TEXT[at9010] matches {
                                                        defining_code matches {[ac9002]}    -- Type (synthesised)
                                                    }
                                                }
                                            }
                                            ELEMENT[at0023] occurrences matches {0..1} matches {    -- Volume by this method
                                                value matches {
                                                    DV_QUANTITY[at9011] matches {
                                                        property matches {[at9003]}    -- Volume
                                                        magnitude matches {|>=0.0|}
                                                        units matches {"ml"}
                                                        precision matches {0}
                                                    }
                                                }
                                            }
                                            ELEMENT[at0026] occurrences matches {0..1} matches {    -- Content
                                                value matches {
                                                    DV_TEXT[at9012]
                                                }
                                            }
                                            use_node ELEMENT[at9018] occurrences matches {1} /data[at0001]/events[at0002]/data[at0003]/items[at0028]/items[at0022]    -- Other method (synthesised)
                                            use_node ELEMENT[at9019] occurrences matches {1} /data[at0001]/events[at0002]/data[at0003]/items[at0028]/items[at0024]    -- Other method (synthesised)
                                        }
                                    }
                                    CLUSTER[at0004] occurrences matches {0..1} matches {    -- Function
                                        items cardinality matches {1..*; unordered} matches {
                                            ELEMENT[at0010] occurrences matches {0..1} matches {    -- Description
                                                value matches {
                                                    DV_TEXT[at9015]
                                                }
                                            }
                                            ELEMENT[at0005] occurrences matches {0..1} matches {    -- Sucking
                                                value matches {
                                                    DV_ORDINAL[at9016] matches {
                                                        [value, symbol] matches {
                                                            [{0}, {[at0006]}],    -- unable to suck
                                                            [{1}, {[at0007]}],    -- some ability
                                                            [{2}, {[at0008]}],    -- reduced sucking
                                                            [{3}, {[at0009]}]    -- normal
                                                        }
                                                    }
                                                }
                                            }
                                            ELEMENT[at0011] occurrences matches {0..1} matches {    -- Swallowing
                                                value matches {
                                                    DV_ORDINAL[at9017] matches {
                                                        [value, symbol] matches {
                                                            [{0}, {[at0012]}],    -- Unable to swallow
                                                            [{1}, {[at0013]}],    -- Some ability to swallow
                                                            [{2}, {[at0014]}],    -- Reduced swallow
                                                            [{3}, {[at0015]}]    -- Normal
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

