    licence = <"This work is licensed under the Creative Commons Attribution-ShareAlike 4.0 International License. To view a copy of this license, visit http://creativecommons.org/licenses/by-sa/4.0/.">
    references = <
        ["1"] = <"Brooks, S. The Kutcher Adolescent Depression Scale (KADS). Child and Adolescent Psychopharmacology News. 2004; 9 (5):4-6. doi: 10.1521/capn.9.5.4.52044. ">
        ["2"] = <"LeBlanc JC, Almudevar A, Brooks SJ, Kutcher S. Screening for adolescent depression: comparison of the Kutcher Adolescent Depression Scale with the Beck depression inventory. J Child Adolesc Psychopharmacol. 2002 Summer;12(2):113-26. doi: 10.1089/104454602760219153. PMID: 12188980.">
    >
    other_details = <
        ["MD5-CAM-1.0.1"] = <"DC46AC38C3B34AD0F73B786319CF0774">
