    references = <
        ["1"] = <"Kessler, R.C., Andrews, G., Colpe, L.J., Hiripi, E., Mroczek, D.K., Normand, S.-L.T., Walters, E.E. and Zaslavsky, A.M. (2002) \"Short screening scales to monitor population prevalences and trends in non-specific psychological distress\", Psychological Medicine, 32(6), pp. 959–976. doi: 10.1017/S0033291702006074.">
    >
    other_details = <
        ["MD5-CAM-1.0.1"] = <"531F58D569C3CD8A6A754A5314C0C9EB">
    >
    details = <
        ["en"] = <
            language = <[ISO_639-1::en]>
            purpose = <"For measuring anxiety and depression through a 10-item questionnaire. It's intended to yield a global measure of
distress based on questions about anxiety and depressive symptoms that a person has experienced in the most recent 4 week period.">
            use = <"Use for measuring anxiety and depression through a 10-item questionnaire. The numbers attached to the subject's 10 responses are added up and the total score is the score on the Kessler Psychological Distress Scale (K10). Scores will range from 10 to 50.">
            misuse = <"Not to be used to record any other measures of anxiety and depression than the Kessler Psychological Distress Scale (K10).">
            copyright = <"© Nasjonal IKT HF">
        >
    >

definition
    OBSERVATION[at0000] matches {    -- Kessler Psychological Distress Scale (K10)
        data matches {
            HISTORY[at0001] matches {
                events cardinality matches {1..*; unordered} matches {
                    EVENT[at0002] occurrences matches {0..1} matches {    -- Any event
                        data matches {
                            ITEM_TREE[at0003] matches {
                                items cardinality matches {0..*; unordered} matches {
                                    ELEMENT[at0004] occurrences matches {0..1} matches {    -- During the last 30 days, about how often did you feel tired out for no good reason?
                                        value matches {
                                            DV_ORDINAL[at9010] matches {
                                                [value, symbol] matches {
                                                    [{1}, {[at0005]}],    -- None of the time
                                                    [{2}, {[at0006]}],    -- A little of the time
                                                    [{3}, {[at0007]}],    -- Some of the time
                                                    [{4}, {[at0008]}],    -- Most of the time
                                                    [{5}, {[at0009]}]    -- All of the time
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0015] occurrences matches {0..1} matches {    -- During the last 30 days, about how often did you feel nervous?
                                        value matches {
                                            DV_ORDINAL[at9011] matches {
                                                [value, symbol] matches {
                                                    [{1}, {[at0016]}],    -- None of the time
                                                    [{2}, {[at0017]}],    -- A little of the time
                                                    [{3}, {[at0018]}],    -- Some of the time
                                                    [{4}, {[at0019]}],    -- Most of the time
                                                    [{5}, {[at0020]}]    -- All of the time
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0021] occurrences matches {0..1} matches {    -- During the last 30 days, about how often did you feel so nervous that nothing could calm you down?
                                        value matches {
                                            DV_ORDINAL[at9012] matches {
                                                [value, symbol] matches {
                                                    [{1}, {[at0022]}],    -- None of the time
                                                    [{2}, {[at0023]}],    -- A little of the time
                                                    [{3}, {[at0024]}],    -- Some of the time
                                                    [{4}, {[at0025]}],    -- Most of the time
                                                    [{5}, {[at0026]}]    -- All of the time
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0027] occurrences matches {0..1} matches {    -- During the last 30 days, about how often did you feel hopeless?
                                        value matches {
                                            DV_ORDINAL[at9013] matches {
                                                [value, symbol] matches {
                                                    [{1}, {[at0028]}],    -- None of the time
                                                    [{2}, {[at0029]}],    -- A little of the time
                                                    [{3}, {[at0030]}],    -- Some of the time
                                                    [{4}, {[at0031]}],    -- Most of the time
                                                    [{5}, {[at0032]}]    -- All of the time
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0033] occurrences matches {0..1} matches {    -- During the last 30 days, about how often did you feel restless or fidgety?
                                        value matches {
                                            DV_ORDINAL[at9014] matches {
                                                [value, symbol] matches {
                                                    [{1}, {[at0034]}],    -- None of the time
                                                    [{2}, {[at0035]}],    -- A little of the time
                                                    [{3}, {[at0036]}],    -- Some of the time
                                                    [{4}, {[at0037]}],    -- Most of the time
                                                    [{5}, {[at0038]}]    -- All of the time
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0039] occurrences matches {0..1} matches {    -- During the last 30 days, about how often did you feel so restless you could not sit still?
                                        value matches {
                                            DV_ORDINAL[at9015] matches {
                                                [value, symbol] matches {
                                                    [{1}, {[at0040]}],    -- None of the time
                                                    [{2}, {[at0041]}],    -- A little of the time
                                                    [{3}, {[at0042]}],    -- Some of the time
                                                    [{4}, {[at0043]}],    -- Most of the time
                                                    [{5}, {[at0044]}]    -- All of the time
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0045] occurrences matches {0..1} matches {    -- During the last 30 days, about how often did you feel depressed?
                                        value matches {
                                            DV_ORDINAL[at9016] matches {
                                                [value, symbol] matches {
                                                    [{1}, {[at0046]}],    -- None of the time
                                                    [{2}, {[at0047]}],    -- A little of the time
                                                    [{3}, {[at0048]}],    -- Some of the time
                                                    [{4}, {[at0049]}],    -- Most of the time
                                                    [{5}, {[at0050]}]    -- All of the time
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0051] occurrences matches {0..1} matches {    -- During the last 30 days, about how often did you feel that everything was an effort?
                                        value matches {
                                            DV_ORDINAL[at9017] matches {
                                                [value, symbol] matches {
                                                    [{1}, {[at0052]}],    -- None of the time
                                                    [{2}, {[at0053]}],    -- A little of the time
                                                    [{3}, {[at0054]}],    -- Some of the time
                                                    [{4}, {[at0055]}],    -- Most of the time
                                                    [{5}, {[at0056]}]    -- All of the time
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0057] occurrences matches {0..1} matches {    -- During the last 30 days, about how often did you feel so sad that nothing could cheer you up?
                                        value matches {
                                            DV_ORDINAL[at9018] matches {
                                                [value, symbol] matches {
                                                    [{1}, {[at0058]}],    -- None of the time
                                                    [{2}, {[at0059]}],    -- A little of the time
                                                    [{3}, {[at0060]}],    -- Some of the time
                                                    [{4}, {[at0061]}],    -- Most of the time
                                                    [{5}, {[at0062]}]    -- All of the time
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0063] occurrences matches {0..1} matches {    -- During the last 30 days, about how often did you feel worthless?
                                        value matches {
                                            DV_ORDINAL[at9019] matches {
                                                [value, symbol] matches {
                                                    [{1}, {[at0064]}],    -- None of the time
                                                    [{2}, {[at0065]}],    -- A little of the time
                                                    [{3}, {[at0066]}],    -- Some of the time
                                                    [{4}, {[at0067]}],    -- Most of the time
                                                    [{5}, {[at0068]}]    -- All of the time
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0014] occurrences matches {0..1} matches {    -- Total score
                                        value matches {
                                            DV_COUNT[at9020] matches {
                                                magnitude matches {|10..50|}
                                            }
                                        }
                                    }
                                    ELEMENT[at0069] occurrences matches {0..1} matches {    -- Comment
                                        value matches {
                                            DV_TEXT[at9021]
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        protocol matches {
            ITEM_TREE[at0070] matches {
                items cardinality matches {0..*; unordered} matches {
                    allow_archetype CLUSTER[at0071] matches {    -- Extension
                        include
                            archetype_id/value matches {/.*/}
                    }
                }
            }
        }
    }

