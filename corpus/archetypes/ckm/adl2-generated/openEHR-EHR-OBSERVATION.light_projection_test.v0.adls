    ip_acknowledgements = <
        ["1"] = <"This artefact includes content from SNOMED Clinical Terms® (SNOMED CT®) which is copyrighted material of the International Health Terminology Standards Development Organisation (IHTSDO).">
    >
    references = <
        ["1"] = <"Paris J, Macri C, Lee YM, Agrawal S, Chan WO. Utility of the light projection test in detecting and localising retinal detachment. Hong Kong J Emerg Med. 2025;32:e70064. doi: 10.1002/hkj2.70064.">
    >
    other_details = <
        ["MD5-CAM-1.0.1"] = <"28FCB315FFCC5A5DD8472C009532EE71">
