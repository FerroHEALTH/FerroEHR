    references = <
        ["1"] = <"Paulsen T, Grotle M, Garratt A, Kjeken I. Development and psychometric testing of the patient-reported measure of activity performance of the hand (MAP-Hand) in rheumatoid arthritis. J Rehabil Med 2010;42:636-44.">
        ["2"] = <"Fernandes L, Grotle M, Darre S, Nossum R, Kjeken I. Validity and responsiveness of the Measure of Activity Performance of the Hand (MAP-Hand) in patients with hand osteoarthritis. J Rehabil Med 2012 Oct;44(10):869-76 2013;2:93-9.">
        ["3"] = <"Prior Y, Tennant A, Tyson S et al. Measure of activity performance of the hand (MAP-Hand) questionnaire: linguistic validation, cultural adaptation and psychometric testing in people with rheumatoid arthritis in the UK. BMC Musculoskelet Disord 2018; 19 (1): 275.">
        ["4"] = <"Tveter AT, Nossum R, Eide REM et al. The Measure of Activity Performance of the hand (MAP-Hand) - A reliable and valid questionnaire for use in patients with hand osteoarthritis with specific involvement of the thumb. J Hand Ther 2022; 35 (1): 115-123.">
        ["5"] = <"Tveter AT, Østerås N, Nossum R et al. The MAP-Hand: Psychometric properties and differences in activity performance between patients with carpometacarpal osteoarthritis and rheumatoid arthritis. J Rehabil Med 2020; 52 (6): jrm00070.">
        ["6"] = <"Diakonhjemmet sykehus. MAP-Hand (Measure of activity performance of the hand). Retrieved from https://www.diakonhjemmetsykehus.no/avdelinger/nkrr/klinisk-verktoykasse/a-til-a/map-hand-measure-of-activity-performance-of-the-hand/.">
    >
    other_details = <
        ["MD5-CAM-1.0.1"] = <"FF5A9AA17B3BD6627C887E866054A141">
    >
    details = <
        ["nb"] = <
            language = <[ISO_639-1::nb]>
            purpose = <"For å registrere resultater fra MAP-Hand vurderingsverktøy.">
            keywords = <"aktivitet, PROM", ...>
            use = <"Brukes for å registrere resultater fra MAP-Hand vurderingsverktøy.

Et pasientrapportert vurderingsverktøy for å vurdere utførelse av håndaktiviteter hos pasienter med revmatoid artritt eller håndartrose som har, eller står i fare for å få funksjonsproblemer på grunn av artritt i hendene.

openEHR-arketyper er fritt tilgjengelige under en åpen lisens, men det spesifikke innholdet i denne \"Measure of activity performance of the hand (MAP-Hand)\"-arketypen er opphavsrettslig beskyttet. All bruk av denne arketypen i implementasjoner må gjøres i henhold til vilkår gitt av innehaverne av opphavsretten.

Informasjon om opphavsretten: Ingvild Kjeken, Diakonhjemmet sykehus (forfatter).">
            misuse = <"">
            copyright = <"© openEHR Foundation">
        >
        ["en"] = <
            language = <[ISO_639-1::en]>
            purpose = <"To record the results of the MAP-Hand tool.">
            keywords = <"activity, PROM, rheumatoid arthritis, osteoarthritis, hand, activity, function", ...>
            use = <"Use to record the results of the MAP-Hand tool. 

A patient-reported assessment tool for evaluating hand activity performance for patients with rheumatoid arthritis or osteoarthritis affecting the hands, particularly those who have, or are at risk of developing functional difficulties related to arthritis in the hands.

While openEHR archetypes are all freely available under an open license, the specific content of this Measure of activity performance of the hand (MAP-Hand) archetype is copyright protected. Any use of this archetype within implementations must be in compliance with the terms established by the copyright owners. 
Copyright information: Ingvild Kjeken, Diakonhjemmet sykehus (author).">
            misuse = <"">
            copyright = <"© openEHR Foundation">
        >
    >

definition
    OBSERVATION[at0000] matches {    -- Measure of activity performance of the hand (MAP-Hand)
        data matches {
            HISTORY[at0001] matches {
                events cardinality matches {1..*; unordered} matches {
                    POINT_EVENT[at0002] occurrences matches {0..1} matches {    -- Point in time event
                        data matches {
                            ITEM_TREE[at0003] matches {
                                items cardinality matches {0..*; unordered} matches {
                                    ELEMENT[at0009] occurrences matches {0..1} matches {    -- 1. Buttoning buttons
                                        value matches {
                                            DV_ORDINAL[at9057] matches {
                                                [value, symbol] matches {
                                                    [{1}, {[at0103]}],    -- No difficulty
                                                    [{2}, {[at0104]}],    -- Some difficulty
                                                    [{3}, {[at0105]}],    -- Great difficulty
                                                    [{4}, {[at0106]}]    -- Not able to do
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0004] occurrences matches {0..1} matches {    -- 2. Putting on socks or tights
                                        value matches {
                                            DV_ORDINAL[at9058] matches {
                                                [value, symbol] matches {
                                                    [{1}, {[at0107]}],    -- No difficulty
                                                    [{2}, {[at0108]}],    -- Some difficulty
                                                    [{3}, {[at0109]}],    -- Great difficulty
                                                    [{4}, {[at0110]}]    -- Not able to do
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0014] occurrences matches {0..1} matches {    -- 3. Tying shoelaces
                                        value matches {
                                            DV_ORDINAL[at9059] matches {
                                                [value, symbol] matches {
                                                    [{1}, {[at0111]}],    -- No difficulty
                                                    [{2}, {[at0112]}],    -- Some difficulty
                                                    [{3}, {[at0113]}],    -- Great difficulty
                                                    [{4}, {[at0114]}]    -- Not able to do
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0019] occurrences matches {0..1} matches {    -- 4. Squeezing out of tubes (e.g. toothpaste)
                                        value matches {
                                            DV_ORDINAL[at9060] matches {
                                                [value, symbol] matches {
                                                    [{1}, {[at0115]}],    -- No difficulty
                                                    [{2}, {[at0116]}],    -- Some difficulty
                                                    [{3}, {[at0117]}],    -- Great difficulty
                                                    [{4}, {[at0118]}]    -- Not able to do
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0024] occurrences matches {0..1} matches {    -- 5. Brushing teeth
                                        value matches {
                                            DV_ORDINAL[at9061] matches {
                                                [value, symbol] matches {
                                                    [{1}, {[at0119]}],    -- No difficulty
                                                    [{2}, {[at0120]}],    -- Some difficulty
                                                    [{3}, {[at0121]}],    -- Great difficulty
                                                    [{4}, {[at0122]}]    -- Not able to do
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0029] occurrences matches {0..1} matches {    -- 6. Wiping yourself after using the toilet
                                        value matches {
                                            DV_ORDINAL[at9062] matches {
                                                [value, symbol] matches {
                                                    [{1}, {[at0123]}],    -- No difficulty
                                                    [{2}, {[at0124]}],    -- Some difficulty
                                                    [{3}, {[at0125]}],    -- Great difficulty
                                                    [{4}, {[at0126]}]    -- Not able to do
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0030] occurrences matches {0..1} matches {    -- 7. Opening bottle screw tops
                                        value matches {
                                            DV_ORDINAL[at9063] matches {
                                                [value, symbol] matches {
                                                    [{1}, {[at0127]}],    -- No difficulty
                                                    [{2}, {[at0128]}],    -- Some difficulty
                                                    [{3}, {[at0129]}],    -- Great difficulty
                                                    [{4}, {[at0130]}]    -- Not able to do
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0031] occurrences matches {0..1} matches {    -- 8. Opening hermetic cans
                                        value matches {
                                            DV_ORDINAL[at9064] matches {
                                                [value, symbol] matches {
                                                    [{1}, {[at0131]}],    -- No difficulty
                                                    [{2}, {[at0132]}],    -- Some difficulty
                                                    [{3}, {[at0133]}],    -- Great difficulty
                                                    [{4}, {[at0134]}]    -- Not able to do
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0032] occurrences matches {0..1} matches {    -- 9. Opening jam jars
                                        value matches {
                                            DV_ORDINAL[at9065] matches {
                                                [value, symbol] matches {
                                                    [{1}, {[at0135]}],    -- No difficulty
                                                    [{2}, {[at0136]}],    -- Some difficulty
                                                    [{3}, {[at0137]}],    -- Great difficulty
                                                    [{4}, {[at0138]}]    -- Not able to do
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0033] occurrences matches {0..1} matches {    -- 10. Slicing bread using a knife
                                        value matches {
                                            DV_ORDINAL[at9066] matches {
                                                [value, symbol] matches {
                                                    [{1}, {[at0139]}],    -- No difficulty
                                                    [{2}, {[at0140]}],    -- Some difficulty
                                                    [{3}, {[at0141]}],    -- Great difficulty
                                                    [{4}, {[at0142]}]    -- Not able to do
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0034] occurrences matches {0..1} matches {    -- 11. Peeling raw vegetables
                                        value matches {
                                            DV_ORDINAL[at9067] matches {
                                                [value, symbol] matches {
                                                    [{1}, {[at0143]}],    -- No difficulty
                                                    [{2}, {[at0144]}],    -- Some difficulty
                                                    [{3}, {[at0145]}],    -- Great difficulty
                                                    [{4}, {[at0146]}]    -- Not able to do
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0035] occurrences matches {0..1} matches {    -- 12. Stirring food in a pan
                                        value matches {
                                            DV_ORDINAL[at9068] matches {
                                                [value, symbol] matches {
                                                    [{1}, {[at0147]}],    -- No difficulty
                                                    [{2}, {[at0148]}],    -- Some difficulty
                                                    [{3}, {[at0149]}],    -- Great difficulty
                                                    [{4}, {[at0150]}]    -- Not able to do
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0036] occurrences matches {0..1} matches {    -- 13. Wringing out cloths
                                        value matches {
                                            DV_ORDINAL[at9069] matches {
                                                [value, symbol] matches {
                                                    [{1}, {[at0151]}],    -- No difficulty
                                                    [{2}, {[at0152]}],    -- Some difficulty
                                                    [{3}, {[at0153]}],    -- Great difficulty
                                                    [{4}, {[at0154]}]    -- Not able to do
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0037] occurrences matches {0..1} matches {    -- 14. Carrying shopping bags
                                        value matches {
                                            DV_ORDINAL[at9070] matches {
                                                [value, symbol] matches {
                                                    [{1}, {[at0155]}],    -- No difficulty
                                                    [{2}, {[at0156]}],    -- Some difficulty
                                                    [{3}, {[at0157]}],    -- Great difficulty
                                                    [{4}, {[at0158]}]    -- Not able to do
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0038] occurrences matches {0..1} matches {    -- 15. Writing by hand
                                        value matches {
                                            DV_ORDINAL[at9071] matches {
                                                [value, symbol] matches {
                                                    [{1}, {[at0159]}],    -- No difficulty
                                                    [{2}, {[at0160]}],    -- Some difficulty
                                                    [{3}, {[at0161]}],    -- Great difficulty
                                                    [{4}, {[at0162]}]    -- Not able to do
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0039] occurrences matches {0..1} matches {    -- 16. Typing on a computer
                                        value matches {
                                            DV_ORDINAL[at9072] matches {
                                                [value, symbol] matches {
                                                    [{1}, {[at0163]}],    -- No difficulty
                                                    [{2}, {[at0164]}],    -- Some difficulty
                                                    [{3}, {[at0165]}],    -- Great difficulty
                                                    [{4}, {[at0166]}]    -- Not able to do
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0040] occurrences matches {0..1} matches {    -- 17. Pushing with hands when getting up from a chair
                                        value matches {
                                            DV_ORDINAL[at9073] matches {
                                                [value, symbol] matches {
                                                    [{1}, {[at0167]}],    -- No difficulty
                                                    [{2}, {[at0168]}],    -- Some difficulty
                                                    [{3}, {[at0169]}],    -- Great difficulty
                                                    [{4}, {[at0170]}]    -- Not able to do
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0041] occurrences matches {0..1} matches {    -- 18. Carrying heavy objects like suitcases and bags (over 5 kg/10lbs)
                                        value matches {
                                            DV_ORDINAL[at9074] matches {
                                                [value, symbol] matches {
                                                    [{1}, {[at0171]}],    -- No difficulty
                                                    [{2}, {[at0172]}],    -- Some difficulty
                                                    [{3}, {[at0173]}],    -- Great difficulty
                                                    [{4}, {[at0174]}]    -- Not able to do
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0179] occurrences matches {0..1} matches {    -- Mean score of predefined activities
                                        value matches {
                                            DV_QUANTITY[at9075] matches {
                                                property matches {[at9055]}    -- Qualified real
                                                magnitude matches {|1.0..4.0|}
                                                units matches {"1"}
                                                precision matches {1}
                                            }
                                        }
                                    }
                                    CLUSTER[at0097] occurrences matches {0..5} matches {    -- Self-defined activities
                                        items cardinality matches {1..*; unordered} matches {
                                            ELEMENT[at0094] occurrences matches {0..1} matches {    -- Activity
                                                value matches {
                                                    DV_TEXT[at9037]
                                                }
                                            }
                                            ELEMENT[at0096] occurrences matches {0..1} matches {    -- Grading
                                                value matches {
                                                    DV_ORDINAL[at9076] matches {
                                                        [value, symbol] matches {
                                                            [{1}, {[at0175]}],    -- No difficulty
                                                            [{2}, {[at0176]}],    -- Some difficulty
                                                            [{3}, {[at0177]}],    -- Great difficulty
                                                            [{4}, {[at0178]}]    -- Not able to do
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0180] occurrences matches {0..1} matches {    -- Mean score of self-defined activites
                                        value matches {
                                            DV_QUANTITY[at9077] matches {
                                                property matches {[at9055]}    -- Qualified real
                                                magnitude matches {|1.0..4.0|}
                                                units matches {"1"}
                                                precision matches {1}
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        protocol matches {
            ITEM_TREE[at0095] matches {
                items cardinality matches {0..*; unordered} matches {
                    allow_archetype CLUSTER[at0102] matches {    -- Extension
                        include
                            archetype_id/value matches {/.*/}
                    }
                }
            }
        }
    }

terminology
    term_definitions = <
        ["nb"] = <
            ["at0000"] = <
                text = <"Measure of activity performance of the hand (MAP-Hand)">
                description = <"Et pasientrapportert vurderingsverktøy for evaluering av håndfunksjon (MAP-Hand).">
            >
            ["at0002"] = <
                text = <"Uspesifisert tidspunkthendelse">
                description = <"Uspesifisert tidspunkt som kan defineres mer eksplisitt i en templat eller i en applikasjon.">
