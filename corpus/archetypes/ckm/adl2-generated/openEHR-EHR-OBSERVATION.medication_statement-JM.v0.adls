    >

definition
    OBSERVATION[at0000.1] matches {    -- Medication use statement - JM
        /data[at0001]/events[at0002]/data[at0003]/items matches {
            ELEMENT[at0.1] occurrences matches {0..1} matches {    -- First administered
                value matches {
                    DV_DATE_TIME[at0.9000]
                }
            }
            ELEMENT[at0.2] occurrences matches {0..1} matches {    -- Number of doses administered
                value matches {
                    DV_COUNT[at0.9001]
                }
            }
        }
    }

terminology
    term_definitions = <
        ["de"] = <
            ["at0000.1"] = <
                text = <"*Medication use statement - JM (en)">
                description = <"Eine Aussage über die aktuelle Einnahme eines einzelnen Medikaments durch eine Person.">
            >
            ["at0.1"] = <
                text = <"*First administered (en)">
                description = <"*The date and time when the medication was first taken by, or administered to, the individual. (en)">
            >
            ["at0.2"] = <
                text = <"*Number of doses administered (en)">
                description = <"*The total number of doses administered. (en)">
                comment = <"*For example: 1 stat dose of prophylactic antibiotics; or 10 doses in an antibiotic course over 5 days. (en)">
            >
        >
