definition
    OBSERVATION[at0000] matches {    -- Mini nutritional assessmemt short form (MNA-SF)
        data matches {
            HISTORY[at0001] matches {
                events cardinality matches {1..*; unordered} matches {
                    EVENT[at0002] occurrences matches {0..1} matches {    -- Any event
                        data matches {
                            ITEM_TREE[at0003] matches {
                                items cardinality matches {0..*; unordered} matches {
                                    ELEMENT[at0004] occurrences matches {0..1} matches {    -- *New element(pt)
                                        value matches {
                                            DV_CODED_TEXT[at9007] matches {
                                                defining_code matches {[ac9000]}    -- *New element(pt) (synthesised)
                                            }
                                        }
                                    }
                                    ELEMENT[at0008] occurrences matches {0..1} matches {    -- *New element(pt)
                                        value matches {
                                            DV_CODED_TEXT[at9008] matches {
                                                defining_code matches {[ac9001]}    -- *New element(pt) (synthesised)
                                            }
                                        }
                                    }
                                    ELEMENT[at0012] occurrences matches {0..1} matches {    -- *New element(pt)
                                        value matches {
                                            DV_CODED_TEXT[at9009] matches {
                                                defining_code matches {[ac9002]}    -- *New element(pt) (synthesised)
                                            }
                                        }
                                    }
                                    ELEMENT[at0017] occurrences matches {0..1} matches {    -- *New element(pt)
                                        value matches {
                                            DV_CODED_TEXT[at9010] matches {
                                                defining_code matches {[ac9003]}    -- *New element(pt) (synthesised)
                                            }
                                        }
                                    }
                                    ELEMENT[at0020] occurrences matches {0..1} matches {    -- *New element(pt)
                                        value matches {
                                            DV_CODED_TEXT[at9011] matches {
                                                defining_code matches {[ac9004]}    -- *New element(pt) (synthesised)
                                            }
                                        }
                                    }
                                    ELEMENT[at0025] occurrences matches {0..1} matches {    -- *New element(pt)
                                        value matches {
                                            DV_CODED_TEXT[at9012] matches {
                                                defining_code matches {[ac9005]}    -- *New element(pt) (synthesised)
                                            }
                                        }
                                    }
                                    ELEMENT[at0030] occurrences matches {0..1} matches {    -- *New element(pt)
                                        value matches {
                                            DV_QUANTITY[at9013] matches {
                                                property matches {[at9006]}    -- Term binding for at9006, translation not known in ADL 1.4 -> ADL 2 converter
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

terminology
    term_definitions = <
        ["pt"] = <
            ["at0000"] = <
                text = <"Mini nutritional assessmemt short form (MNA-SF)">
                description = <"unknown">
            >
            ["at0002"] = <
                text = <"Any event">
                description = <"*">
            >
            ["at0004"] = <
                text = <"*New element(pt)">
                description = <"**(pt)">
            >
            ["at0005"] = <
                text = <"*0: Several loss of appetite. (pt)">
                description = <"*The patient presents a several loss of appetite. (pt)">
            >
            ["at0006"] = <
                text = <"*1: Moderate loss of appetite(pt)">
                description = <"*The patient presents a moderate loss of appetite(pt)">
            >
            ["at0007"] = <
                text = <"*2: No loss of appetite. (pt)">
                description = <"*The patient presents no loss of appetite. (pt)">
            >
            ["at0008"] = <
                text = <"*New element(pt)">
                description = <"**(pt)">
            >
            ["at0009"] = <
                text = <"*0: Weight loss greater(pt)">
                description = <"*The patient presents a weight loss greater. (pt)">
            >
            ["at0010"] = <
                text = <"*1: Does not know(pt)">
                description = <"*The patient does not know informed about weight loss. (pt)">
            >
            ["at0011"] = <
                text = <"*2: Weight loss between 1 and 3 kg. (pt)">
                description = <"*The patient presents a weight loss between 1 and 3 kg.  (pt)">
            >
            ["at0012"] = <
                text = <"*New element(pt)">
                description = <"**(pt)">
            >
            ["at0013"] = <
                text = <"*0: Bed or chair (pt)">
                description = <"*No patients mobility(pt)">
            >
            ["at0014"] = <
                text = <"*1: Able to get out of bed/chair but doe not go out. (pt)">
                description = <"*The patient can get out of bed/chair but doe does not go out. (pt)">
            >
            ["at0015"] = <
                text = <"*2: Goes out(pt)">
                description = <"*The patient is able to go out. (pt)">
            >
            ["at0017"] = <
                text = <"*New element(pt)">
                description = <"**(pt)">
            >
            ["at0018"] = <
                text = <"*0: Yes(pt)">
                description = <"*The patient suffered psychological stress or acute disease in the past three months. (pt)">
            >
            ["at0019"] = <
                text = <"*2: No(pt)">
                description = <"*The patient did not suffer psychological stress or acute disease in the past three months. (pt)">
            >
            ["at0020"] = <
                text = <"*New element(pt)">
                description = <"**(pt)">
            >
            ["at0021"] = <
                text = <"*0:  Severe dementia or depression(pt)">
                description = <"*Patient presents a severe dementia or depression.(pt)">
            >
            ["at0022"] = <
                text = <"*1: Mild dementia(pt)">
                description = <"* Patient presents a mild dementia.(pt)">
            >
            ["at0023"] = <
                text = <"*2: No psychological problems(pt)">
                description = <"* Patient does not presents neuropsychological problems.(pt)">
            >
            ["at0025"] = <
                text = <"*New element(pt)">
                description = <"**(pt)">
            >
            ["at0026"] = <
                text = <"*0: BMI less than 19(pt)">
                description = <"*BMI less than 19 kg/m2(pt)">
            >
            ["at0027"] = <
                text = <"*1: BMI 19 to less than 21(pt)">
                description = <"*BMI value(pt)">
            >
            ["at0028"] = <
                text = <"*2: BMI 21 to less than 23(pt)">
                description = <"*BMI value(pt)">
            >
            ["at0029"] = <
                text = <"*3: BMI 23 or greater(pt)">
                description = <"*BMI value(pt)">
            >
            ["at0030"] = <
                text = <"*New element(pt)">
                description = <"**(pt)">
            >
            ["at9006"] = <
                text = <"Term binding for at9006, translation not known in ADL 1.4 -> ADL 2 converter">
                description = <"Term binding for at9006, translation not known in ADL 1.4 -> ADL 2 converter">
            >
