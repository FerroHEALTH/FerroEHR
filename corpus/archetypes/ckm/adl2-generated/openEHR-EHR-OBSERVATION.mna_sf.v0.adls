    ip_acknowledgements = <
        ["1"] = <"The Mini Nutritional Assessment (MNA®) and Mini Nutritional Assessment–Short Form (MNA®-SF) are protected by copyright and are registered trademarks of Société des Produits Nestlé S.A., Vevey, Switzerland. © Société des Produits Nestlé S.A. 1994, Revision 2009. All rights reserved. Used with permission. MNA® is a registered trademark of Société des Produits Nestlé S.A.">
