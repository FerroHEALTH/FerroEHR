            >
            ["ac9041"] = <
                text = <"Muskelstyrke i ansikt (synthesised)">
                description = <" (synthesised)">
            >
            ["ac9042"] = <
                text = <"Språk (synthesised)">
                description = <" (synthesised)">
            >
            ["ac9043"] = <
