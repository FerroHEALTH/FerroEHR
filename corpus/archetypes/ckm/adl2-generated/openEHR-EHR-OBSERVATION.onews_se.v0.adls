            >
            ["at0048"] = <
                text = <"Extension">
                description = <"Additional information required to extend the model with local content or to align with other reference models/formalisms.">
                comment = <"For example: local information requirements; or additional metadata to align with FHIR.">
            >
            ["ac9018"] = <
                text = <"Respiratory rate (synthesised)">
                description = <"Category for the respiratory rate measurement. (synthesised)">
            >
            ["ac9019"] = <
                text = <"Oxygen saturation (synthesised)">
                description = <"Category for the oxygen saturation measurement. (synthesised)">
            >
