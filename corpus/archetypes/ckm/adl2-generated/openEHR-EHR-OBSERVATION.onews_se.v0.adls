    ip_acknowledgements = <
        ["1"] = <"While openEHR archetypes are all freely available under an open license, the specific content of this Obstetric National Early Warning Score (ONEWS) archetype is copyright protected. Any use of this archetype within implementations must be in compliance with the terms established by the copyright owners. ">
