                description = <"">
            >
            ["at0032"] = <
                text = <"Level of consciousness">
                description = <"Category for the observed conscious state, using the ACVPU scale.">
            >
            ["at0033"] = <
                text = <"Alert">
                description = <"The patient is alert or awake.">
            >
