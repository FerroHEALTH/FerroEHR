    >
    references = <
        ["1"] = <"Djärv T, Joelsson-Alm E, Rutberg H, Spångfors M, Hein A, Lindroos L, Åmark H. National Early Warning Score 2 NEWS2 : Övervakning och bedömning av vitalparametrar (2018) [Internet]. Stockholm: Löf regionernas ömsesidiga försäkringsbolag; 2018 [cited 2021 Jun 07]. Avaiable from: https://lof.se/filer/NEWS2-broschyr.pdf">
    >
    other_details = <
        ["MD5-CAM-1.0.1"] = <"343CE8037BE0C4A26A51CF209541F45A">
