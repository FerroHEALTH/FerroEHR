            author = <
                ["name"] = <"?">
            >
        >
    >

description
    original_author = <
        ["name"] = <"Aitor Eguzkitza">
        ["organisation"] = <"Universidad Pública de Navarra - Complejo Hospitalario de Navarra">
        ["email"] = <"aitor.eguzkiza@unavarra.es">
