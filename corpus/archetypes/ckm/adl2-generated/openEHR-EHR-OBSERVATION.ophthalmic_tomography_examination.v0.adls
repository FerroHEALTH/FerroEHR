archetype (adl_version=2.4.0; rm_release=1.1.0; generated; uid=78ac5c3d-9e2c-4cce-89a8-4d4fe9046202; build_uid=c38cd23c-dbf9-4989-841f-fcaeb2b31660)
    openEHR-EHR-OBSERVATION.ophthalmic_tomography_examination.v0.0.1-alpha

