    details = <
        ["nb"] = <
            language = <[ISO_639-1::nb]>
            purpose = <"For å registrere resultatene for hver enkelt parameter og deres totale skår for Psoriasis Area Severity Index (PASI).">
            keywords = <"hud", ...>
            use = <"Brukes for å registrere resultatene for hver enkelt parameter og deres totale skår for Psoriasis Area Severity Index (PASI).

Per dags dato finnes det ingen validert norsk oversettelse av verktøyet. Man har derfor i arketypen valgt å beholde orginalspråk for alle dataelementene. Om det på et tidspunkt etableres en validert norsk oversettelse, vil arketypen oppdateres med denne.">
            misuse = <"">
        >
        ["en"] = <
            language = <[ISO_639-1::en]>
            purpose = <"To record the result for each component parameter and the total score for the Psoriasis Area Severity Index (PASI).">
            keywords = <"skin", ...>
            use = <"Use to record the result for each component parameter and the total score for the Psoriasis Area Severity Index (PASI).">
            misuse = <"">
        >
    >

definition
    OBSERVATION[at0000] matches {    -- Psoriasis Area Severity Index (PASI)
        data matches {
            HISTORY[at0001] matches {
                events cardinality matches {1..*; unordered} matches {
                    EVENT[at0002] matches {    -- Any event
                        data matches {
                            ITEM_TREE[at0003] matches {
                                items cardinality matches {0..*; unordered} matches {
                                    CLUSTER[at0004] occurrences matches {0..1} matches {    -- Head region (h)
                                        items cardinality matches {1..*; unordered} matches {
                                            ELEMENT[at0005] occurrences matches {0..1} matches {    -- Erythema (E)
                                                value matches {
                                                    DV_ORDINAL[at9004] matches {
                                                        [value, symbol] matches {
                                                            [{0}, {[at0006]}],    -- None
                                                            [{1}, {[at0007]}],    -- Mild
                                                            [{2}, {[at0008]}],    -- Moderate
                                                            [{3}, {[at0009]}],    -- Severe
                                                            [{4}, {[at0010]}]    -- Very severe
                                                        }
                                                    }
                                                }
                                            }
                                            ELEMENT[at0011] occurrences matches {0..1} matches {    -- Infiltration (I)
                                                value matches {
                                                    DV_ORDINAL[at9005] matches {
                                                        [value, symbol] matches {
                                                            [{0}, {[at0012]}],    -- None
                                                            [{1}, {[at0013]}],    -- Mild
                                                            [{2}, {[at0014]}],    -- Moderate
                                                            [{3}, {[at0015]}],    -- Severe
                                                            [{4}, {[at0016]}]    -- Very severe
                                                        }
                                                    }
                                                }
                                            }
                                            ELEMENT[at0017] occurrences matches {0..1} matches {    -- Desquamation (D)
                                                value matches {
                                                    DV_ORDINAL[at9006] matches {
                                                        [value, symbol] matches {
                                                            [{0}, {[at0018]}],    -- None
                                                            [{1}, {[at0019]}],    -- Mild
                                                            [{2}, {[at0020]}],    -- Moderate
                                                            [{3}, {[at0021]}],    -- Severe
                                                            [{4}, {[at0022]}]    -- Very severe
                                                        }
                                                    }
                                                }
                                            }
                                            ELEMENT[at0023] occurrences matches {0..1} matches {    -- Body surface area involvement (A)
                                                value matches {
                                                    DV_ORDINAL[at9007] matches {
                                                        [value, symbol] matches {
                                                            [{0}, {[at0024]}],    -- No involvement
                                                            [{1}, {[at0025]}],    -- <10%
                                                            [{2}, {[at0026]}],    -- 10%-29%
                                                            [{3}, {[at0027]}],    -- 30%-49%
                                                            [{4}, {[at0028]}],    -- 50%-69%
                                                            [{5}, {[at0029]}],    -- 70%-89%
                                                            [{6}, {[at0030]}]    -- 90%-100%
                                                        }
                                                    }
                                                }
                                            }
                                            ELEMENT[at0038] occurrences matches {0..1} matches {    -- Score head region
                                                value matches {
                                                    DV_QUANTITY[at9045] matches {
                                                        property matches {[at9008]}    -- Qualified real
                                                        magnitude matches {|>=0.0|}
                                                        units matches {"1"}
                                                        precision matches {1}
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    CLUSTER[at0032] occurrences matches {0..1} matches {    -- Trunk region (t)
                                        items cardinality matches {1..*; unordered} matches {
                                            ELEMENT[at0005] occurrences matches {0..1} matches {    -- Erythema (E)
                                                value matches {
                                                    DV_ORDINAL[at9027] matches {
                                                        [value, symbol] matches {
                                                            [{0}, {[at0006]}],    -- None
                                                            [{1}, {[at0007]}],    -- Mild
                                                            [{2}, {[at0008]}],    -- Moderate
                                                            [{3}, {[at0009]}],    -- Severe
                                                            [{4}, {[at0010]}]    -- Very severe
                                                        }
                                                    }
                                                }
                                            }
                                            ELEMENT[at0011] occurrences matches {0..1} matches {    -- Infiltration (I)
                                                value matches {
                                                    DV_ORDINAL[at9028] matches {
                                                        [value, symbol] matches {
                                                            [{0}, {[at0012]}],    -- None
                                                            [{1}, {[at0013]}],    -- Mild
                                                            [{2}, {[at0014]}],    -- Moderate
                                                            [{3}, {[at0015]}],    -- Severe
                                                            [{4}, {[at0016]}]    -- Very severe
                                                        }
                                                    }
                                                }
                                            }
                                            ELEMENT[at0017] occurrences matches {0..1} matches {    -- Desquamation (D)
                                                value matches {
                                                    DV_ORDINAL[at9029] matches {
                                                        [value, symbol] matches {
                                                            [{0}, {[at0018]}],    -- None
                                                            [{1}, {[at0019]}],    -- Mild
                                                            [{2}, {[at0020]}],    -- Moderate
                                                            [{3}, {[at0021]}],    -- Severe
                                                            [{4}, {[at0022]}]    -- Very severe
                                                        }
                                                    }
                                                }
                                            }
                                            ELEMENT[at0023] occurrences matches {0..1} matches {    -- Body surface area involvement (A)
                                                value matches {
                                                    DV_ORDINAL[at9030] matches {
                                                        [value, symbol] matches {
                                                            [{0}, {[at0024]}],    -- No involvement
                                                            [{1}, {[at0025]}],    -- <10%
                                                            [{2}, {[at0026]}],    -- 10%-29%
                                                            [{3}, {[at0027]}],    -- 30%-49%
                                                            [{4}, {[at0028]}],    -- 50%-69%
                                                            [{5}, {[at0029]}],    -- 70%-89%
                                                            [{6}, {[at0030]}]    -- 90%-100%
                                                        }
                                                    }
                                                }
                                            }
                                            ELEMENT[at0039] occurrences matches {0..1} matches {    -- Score trunk region
                                                value matches {
                                                    DV_QUANTITY[at9042] matches {
                                                        property matches {[at9008]}    -- Qualified real
                                                        magnitude matches {|>=0.0|}
                                                        units matches {"1"}
                                                        precision matches {1}
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    CLUSTER[at0033] occurrences matches {0..1} matches {    -- Upper extremities region (u)
                                        items cardinality matches {1..*; unordered} matches {
                                            ELEMENT[at0005] occurrences matches {0..1} matches {    -- Erythema (E)
                                                value matches {
                                                    DV_ORDINAL[at9032] matches {
                                                        [value, symbol] matches {
                                                            [{0}, {[at0006]}],    -- None
                                                            [{1}, {[at0007]}],    -- Mild
                                                            [{2}, {[at0008]}],    -- Moderate
                                                            [{3}, {[at0009]}],    -- Severe
                                                            [{4}, {[at0010]}]    -- Very severe
                                                        }
                                                    }
                                                }
                                            }
                                            ELEMENT[at0011] occurrences matches {0..1} matches {    -- Infiltration (I)
                                                value matches {
                                                    DV_ORDINAL[at9033] matches {
                                                        [value, symbol] matches {
                                                            [{0}, {[at0012]}],    -- None
                                                            [{1}, {[at0013]}],    -- Mild
                                                            [{2}, {[at0014]}],    -- Moderate
                                                            [{3}, {[at0015]}],    -- Severe
                                                            [{4}, {[at0016]}]    -- Very severe
                                                        }
                                                    }
                                                }
                                            }
                                            ELEMENT[at0017] occurrences matches {0..1} matches {    -- Desquamation (D)
                                                value matches {
                                                    DV_ORDINAL[at9034] matches {
                                                        [value, symbol] matches {
                                                            [{0}, {[at0018]}],    -- None
                                                            [{1}, {[at0019]}],    -- Mild
                                                            [{2}, {[at0020]}],    -- Moderate
                                                            [{3}, {[at0021]}],    -- Severe
                                                            [{4}, {[at0022]}]    -- Very severe
                                                        }
                                                    }
                                                }
                                            }
                                            ELEMENT[at0023] occurrences matches {0..1} matches {    -- Body surface area involvement (A)
                                                value matches {
                                                    DV_ORDINAL[at9035] matches {
                                                        [value, symbol] matches {
                                                            [{0}, {[at0024]}],    -- No involvement
                                                            [{1}, {[at0025]}],    -- <10%
                                                            [{2}, {[at0026]}],    -- 10%-29%
                                                            [{3}, {[at0027]}],    -- 30%-49%
                                                            [{4}, {[at0028]}],    -- 50%-69%
                                                            [{5}, {[at0029]}],    -- 70%-89%
                                                            [{6}, {[at0030]}]    -- 90%-100%
                                                        }
                                                    }
                                                }
                                            }
                                            ELEMENT[at0040] occurrences matches {0..1} matches {    -- Score upper extremities region
                                                value matches {
                                                    DV_QUANTITY[at9043] matches {
                                                        property matches {[at9008]}    -- Qualified real
                                                        magnitude matches {|>=0.0|}
                                                        units matches {"1"}
                                                        precision matches {1}
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    CLUSTER[at0034] occurrences matches {0..1} matches {    -- Lower extremities region (l)
                                        items cardinality matches {1..*; unordered} matches {
                                            ELEMENT[at0005] occurrences matches {0..1} matches {    -- Erythema (E)
                                                value matches {
                                                    DV_ORDINAL[at9037] matches {
                                                        [value, symbol] matches {
                                                            [{0}, {[at0006]}],    -- None
                                                            [{1}, {[at0007]}],    -- Mild
                                                            [{2}, {[at0008]}],    -- Moderate
                                                            [{3}, {[at0009]}],    -- Severe
                                                            [{4}, {[at0010]}]    -- Very severe
                                                        }
                                                    }
                                                }
                                            }
                                            ELEMENT[at0011] occurrences matches {0..1} matches {    -- Infiltration (I)
                                                value matches {
                                                    DV_ORDINAL[at9038] matches {
                                                        [value, symbol] matches {
                                                            [{0}, {[at0012]}],    -- None
                                                            [{1}, {[at0013]}],    -- Mild
                                                            [{2}, {[at0014]}],    -- Moderate
                                                            [{3}, {[at0015]}],    -- Severe
                                                            [{4}, {[at0016]}]    -- Very severe
                                                        }
                                                    }
                                                }
                                            }
                                            ELEMENT[at0017] occurrences matches {0..1} matches {    -- Desquamation (D)
                                                value matches {
                                                    DV_ORDINAL[at9039] matches {
                                                        [value, symbol] matches {
                                                            [{0}, {[at0018]}],    -- None
                                                            [{1}, {[at0019]}],    -- Mild
                                                            [{2}, {[at0020]}],    -- Moderate
                                                            [{3}, {[at0021]}],    -- Severe
                                                            [{4}, {[at0022]}]    -- Very severe
                                                        }
                                                    }
                                                }
                                            }
                                            ELEMENT[at0023] occurrences matches {0..1} matches {    -- Body surface area involvement (A)
                                                value matches {
                                                    DV_ORDINAL[at9040] matches {
                                                        [value, symbol] matches {
                                                            [{0}, {[at0024]}],    -- No involvement
                                                            [{1}, {[at0025]}],    -- <10%
                                                            [{2}, {[at0026]}],    -- 10%-29%
                                                            [{3}, {[at0027]}],    -- 30%-49%
                                                            [{4}, {[at0028]}],    -- 50%-69%
                                                            [{5}, {[at0029]}],    -- 70%-89%
                                                            [{6}, {[at0030]}]    -- 90%-100%
                                                        }
                                                    }
                                                }
                                            }
                                            ELEMENT[at0041] occurrences matches {0..1} matches {    -- Score lower extremities region
                                                value matches {
                                                    DV_QUANTITY[at9044] matches {
                                                        property matches {[at9008]}    -- Qualified real
                                                        magnitude matches {|>=0.0|}
                                                        units matches {"1"}
                                                        precision matches {1}
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0035] occurrences matches {0..1} matches {    -- Total PASI-score
                                        value matches {
                                            DV_QUANTITY[at9025] matches {
                                                property matches {[at9008]}    -- Qualified real
                                                magnitude matches {|>=0.0|}
                                                units matches {"1"}
                                                precision matches {1}
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        protocol matches {
            ITEM_TREE[at0036] matches {
                items cardinality matches {0..*; unordered} matches {
                    allow_archetype CLUSTER[at0037] matches {    -- Extension
                        include
                            archetype_id/value matches {/.*/}
                    }
                }
            }
        }
    }

terminology
    term_definitions = <
        ["nb"] = <
            ["at0000"] = <
                text = <"Psoriasis Area Severity Index (PASI)">
                description = <"Et verktøy for å måle alvorlighetsgrad av psoriasis basert på affisert areal av hud og plakkenes utseende.">
            >
            ["at0002"] = <
                text = <"Uspesifisert hendelse">
                description = <"Uspesifisert tidspunkt som kan defineres mer eksplisitt i en templat eller i en applikasjon.">
            >
            ["at0004"] = <
                text = <"Head region (h)">
                description = <"">
            >
            ["at0005"] = <
                text = <"Erythema (E)">
                description = <"Assessment of the redness/erythema of the psoriatic plaques.">
            >
            ["at0006"] = <
