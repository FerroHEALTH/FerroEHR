    details = <
        ["ar-sy"] = <
            language = <[ISO_639-1::ar-sy]>
            purpose = <"لتسجيل نتيجة اختبار المعمل, و التي قد يتم استخدامها لتسجيل اختبار ذي قيمة واحدة, و عادة ما يتم بعد ذلك المزيد من التخصيص أو الوضع في قالب لتمثيل اختبار متعدد القيم أو رتل من الاختبارات. 
و يمثل هذا النموذج كوالد (أب) للتخصيصات الأخرى لاختبارات معملية أكثر تحديدا مثل الميكروبيولوجيا و الهيستوباثولوجيا.">
            keywords = <"المعمل - المختبر", "الباثولوجيا - المرضية", "الكيمياء الحيوية", "الدمويات", "الميكروبيولوجيا", "المناعيات - علم المناعة">
            use = <"قد يستخدم لتسجيل نتيجة اختبار المعمل, و التي قد يتم استخدامها لتسجيل اختبار ذي قيمة واحدة, و عادة ما يتم بعد ذلك المزيد من التخصيص أو الوضع في قالب لتمثيل اختبار متعدد القيم أو رتل من الاختبارات. 

يتم بعد ذلك تقديم التقرير للطبيب السريري الذي قام بطلب الاختبار في سياق تقرير معملي متكامل.">
            misuse = <"قد تكون التخصيصات أكثر مناسبة للتقارير المركبة مثل حالات الميكروبيولوجيا أو الهيستوباثولوجيا.">
            copyright = <"© openEHR Foundation">
        >
        ["en"] = <
            language = <[ISO_639-1::en]>
            purpose = <"To record the findings and interpretation of biochemical lipid study test results. This is typically done in a laboratory but may be done in other environments such as at the point of care.">
            keywords = <"lab", "pathology", "biochemistry", "laboratory", "chemical", "clinical", "test", "specimen">
            use = <"Use to record a lipid studies test result panel.

This archetype has been designed to enable the health record to:
- distinguish between fasting and non-fasting lipid measurements, 
- distinguish measurements from laboratory, point of care and home-based devices, and;

Will normally be reported back to the requesting clinician as one component within the context of an overall COMPOSITION-based report.">
            misuse = <"Not to be used to represent an entire cumulative report. This Pathology test result archetype represents only one of the result sets that is usually viewed as a vertical in a cumulative test report. A cumulative report is a view that is constructed from the results represented by multiple OBSERVATION archetypes.">
            copyright = <"© openEHR Foundation">
        >
    >

definition
    OBSERVATION[at0000.1] matches {    -- Lipid Studies Test Result
        /data[at0001]/events matches {
            EVENT[at0002] matches {
                /data[at0003]/items[at0095]/items matches {
                    CLUSTER[at0096.6] matches {    -- Total Cholesterol
                        items matches {
                            ELEMENT[at0078.1] matches {    -- Result Value
                                value matches {
                                    DV_QUANTITY[at0.9001] matches {
                                        property matches {[at0.9000]}    -- Concentration
                                        [units] matches {
                                            [{"mg/dl"}],
                                            [{"mmol/l"}]
                                        }
                                    }
                                }
                            }
                            ELEMENT[at0102] matches {
                                value matches {
                                    DV_TEXT[at0.9002]
                                }
                            }
                            ELEMENT[at0103] matches {
                                value matches {
                                    DV_TEXT[at0.9003]
                                }
                            }
                            ELEMENT[at0108] matches {
                                value matches {
                                    DV_CODED_TEXT[at0.9004] matches {
                                        defining_code matches {[ac9000]}
                                    }
                                }
                            }
                        }
                    }
                    CLUSTER[at0096.7] matches {    -- Triglyceride
                        items matches {
                            ELEMENT[at0078.2] matches {    -- Result Value
                                value matches {
                                    DV_QUANTITY[at0.9005] matches {
                                        property matches {[at0.9000]}    -- Concentration
                                        [magnitude, units] matches {
                                            [{|>=0.0|}, {"mg/dl"}],
                                            [{|>=0.0|}, {"mmol/l"}]
                                        }
                                    }
                                }
                            }
                            after [at0078.2]
                            use_node ELEMENT[at0.9036] /data[at0001]/events[at0002]/data[at0003]/items[at0095]/items[at0096.6]/items[at0102]    -- Triglyceride (synthesised)
                            use_node ELEMENT[at0.9037] occurrences matches {0..1} /data[at0001]/events[at0002]/data[at0003]/items[at0095]/items[at0096.6]/items[at0103]    -- Triglyceride (synthesised)
                            use_node ELEMENT[at0.9038] occurrences matches {0..1} /data[at0001]/events[at0002]/data[at0003]/items[at0095]/items[at0096.6]/items[at0108]    -- Triglyceride (synthesised)
                        }
                    }
                    CLUSTER[at0096.5] matches {    -- HDL Cholesterol
                        items matches {
                            ELEMENT[at0078.3] matches {    -- Result Value
                                value matches {
                                    DV_QUANTITY[at0.9009] matches {
                                        property matches {[at0.9000]}    -- Concentration
                                        [magnitude, units] matches {
                                            [{|>=0.0|}, {"mg/dl"}],
                                            [{|>=0.0|}, {"mmol/l"}]
                                        }
                                    }
                                }
                            }
                            after [at0078.3]
                            use_node ELEMENT[at0.9039] /data[at0001]/events[at0002]/data[at0003]/items[at0095]/items[at0096.6]/items[at0102]    -- HDL Cholesterol (synthesised)
                            use_node ELEMENT[at0.9040] occurrences matches {0..1} /data[at0001]/events[at0002]/data[at0003]/items[at0095]/items[at0096.6]/items[at0103]    -- HDL Cholesterol (synthesised)
                            use_node ELEMENT[at0.9041] occurrences matches {0..1} /data[at0001]/events[at0002]/data[at0003]/items[at0095]/items[at0096.6]/items[at0108]    -- HDL Cholesterol (synthesised)
                        }
                    }
                    CLUSTER[at0096.4] matches {    -- LDL Cholesterol Direct Assay
                        items matches {
                            ELEMENT[at0078.4] matches {    -- Result Value
                                value matches {
                                    DV_QUANTITY[at0.9013] matches {
                                        property matches {[at0.9000]}    -- Concentration
                                        [magnitude, units] matches {
                                            [{|>=0.0|}, {"mg/dl"}],
                                            [{|>=0.0|}, {"mmol/l"}]
                                        }
                                    }
                                }
                            }
                            after [at0078.4]
                            use_node ELEMENT[at0.9042] /data[at0001]/events[at0002]/data[at0003]/items[at0095]/items[at0096.6]/items[at0102]    -- LDL Cholesterol Direct Assay (synthesised)
                            use_node ELEMENT[at0.9043] occurrences matches {0..1} /data[at0001]/events[at0002]/data[at0003]/items[at0095]/items[at0096.6]/items[at0103]    -- LDL Cholesterol Direct Assay (synthesised)
                            use_node ELEMENT[at0.9044] occurrences matches {0..1} /data[at0001]/events[at0002]/data[at0003]/items[at0095]/items[at0096.6]/items[at0108]    -- LDL Cholesterol Direct Assay (synthesised)
                        }
                    }
                    CLUSTER[at0096.8] matches {    -- LDL Cholesterol Calculated
                        items matches {
                            ELEMENT[at0078.7] matches {    -- Result Value
                                value matches {
                                    DV_QUANTITY[at0.9017] matches {
                                        property matches {[at0.9000]}    -- Concentration
                                        [magnitude, units] matches {
                                            [{|>=0.0|}, {"mg/dl"}],
                                            [{|>=0.0|}, {"mmol/l"}]
                                        }
                                    }
                                }
                            }
                            after [at0078.7]
                            use_node ELEMENT[at0.9045] /data[at0001]/events[at0002]/data[at0003]/items[at0095]/items[at0096.6]/items[at0102]    -- LDL Cholesterol Calculated (synthesised)
                            use_node ELEMENT[at0.9046] occurrences matches {0..1} /data[at0001]/events[at0002]/data[at0003]/items[at0095]/items[at0096.6]/items[at0103]    -- LDL Cholesterol Calculated (synthesised)
                            use_node ELEMENT[at0.9047] occurrences matches {0..1} /data[at0001]/events[at0002]/data[at0003]/items[at0095]/items[at0096.6]/items[at0108]    -- LDL Cholesterol Calculated (synthesised)
                        }
                    }
                    CLUSTER[at0096.3] matches {    -- VLDL Cholesterol
                        items matches {
                            ELEMENT[at0078.8] matches {    -- Result Value
                                value matches {
                                    DV_QUANTITY[at0.9021] matches {
                                        property matches {[at0.9000]}    -- Concentration
                                        [magnitude, units] matches {
                                            [{|>=0.0|}, {"mg/dl"}],
                                            [{|>=0.0|}, {"mmol/l"}]
                                        }
                                    }
                                }
                            }
                            after [at0078.8]
                            use_node ELEMENT[at0.9048] /data[at0001]/events[at0002]/data[at0003]/items[at0095]/items[at0096.6]/items[at0102]    -- VLDL Cholesterol (synthesised)
                            use_node ELEMENT[at0.9049] occurrences matches {0..1} /data[at0001]/events[at0002]/data[at0003]/items[at0095]/items[at0096.6]/items[at0103]    -- VLDL Cholesterol (synthesised)
                            use_node ELEMENT[at0.9050] occurrences matches {0..1} /data[at0001]/events[at0002]/data[at0003]/items[at0095]/items[at0096.6]/items[at0108]    -- VLDL Cholesterol (synthesised)
                        }
                    }
                    CLUSTER[at0096.2] matches {    -- LDL/HDL Cholesterol Ratio
                        items matches {
                            ELEMENT[at0078.5] matches {    -- Result Value
                                value matches {
                                    DV_PROPORTION[at0.9025] matches {
                                        is_integral matches {False}
                                        type matches {0}
                                    }
                                }
                            }
                            after [at0078.5]
                            use_node ELEMENT[at0.9051] /data[at0001]/events[at0002]/data[at0003]/items[at0095]/items[at0096.6]/items[at0102]    -- LDL/HDL Cholesterol Ratio (synthesised)
                            use_node ELEMENT[at0.9052] occurrences matches {0..1} /data[at0001]/events[at0002]/data[at0003]/items[at0095]/items[at0096.6]/items[at0103]    -- LDL/HDL Cholesterol Ratio (synthesised)
                            use_node ELEMENT[at0.9053] occurrences matches {0..1} /data[at0001]/events[at0002]/data[at0003]/items[at0095]/items[at0096.6]/items[at0108]    -- LDL/HDL Cholesterol Ratio (synthesised)
                        }
                    }
                    CLUSTER[at0096.1] matches {    -- Total/HDL Cholesterol Ratio
                        items matches {
                            ELEMENT[at0078.6] matches {    -- Result Value
                                value matches {
                                    DV_PROPORTION[at0.9029] matches {
                                        is_integral matches {False}
                                        type matches {0}
                                    }
                                }
                            }
                            after [at0078.6]
                            use_node ELEMENT[at0.9054] /data[at0001]/events[at0002]/data[at0003]/items[at0095]/items[at0096.6]/items[at0102]    -- Total/HDL Cholesterol Ratio (synthesised)
                            use_node ELEMENT[at0.9055] occurrences matches {0..1} /data[at0001]/events[at0002]/data[at0003]/items[at0095]/items[at0096.6]/items[at0103]    -- Total/HDL Cholesterol Ratio (synthesised)
                            use_node ELEMENT[at0.9056] occurrences matches {0..1} /data[at0001]/events[at0002]/data[at0003]/items[at0095]/items[at0096.6]/items[at0108]    -- Total/HDL Cholesterol Ratio (synthesised)
                        }
                    }
                }
                state matches {
                    ITEM_TREE[at0.112] matches {
                        items cardinality matches {0..*; unordered} matches {
                            ELEMENT[at0.113] occurrences matches {0..1} matches {    -- Fasting State
                                value matches {
                                    DV_BOOLEAN[at0.9033] matches {
                                        value matches {True}
                                    }
                                }
                            }
                            ELEMENT[at0.114] occurrences matches {0..1} matches {    -- Duration of Fasting
                                value matches {
                                    DV_DURATION[at0.9034] matches {
                                        value matches {PTHS/|>=PT0S|}
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        /protocol[at0004]/items matches {
            before [at0017]
            ELEMENT[at0.111] occurrences matches {0..1} matches {    -- Point of Care Device used
                value matches {
                    DV_BOOLEAN[at0.9035] matches {
                        value matches {True, False}
                    }
                }
            }
        }
    }

