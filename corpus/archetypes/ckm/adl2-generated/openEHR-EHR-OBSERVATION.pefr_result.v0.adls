                text = <"Kommentar">
                description = <"Ytterligere fritekst om målingen av maksimal ekspiratorisk luftstrømshastighet, som ikke fanges opp i andre felt.">
            >
            ["at0016"] = <
                text = <"Stilling">
                description = <"Individets kroppsstilling ved tidspunktet for målingen.">
            >
            ["at0017"] = <
