    details = <
        ["de"] = <
            language = <[ISO_639-1::de]>
            purpose = <"Zur Repräsentation des Verhältnisses zwischen dem Sauerstoffpartialdruck im Blut (PaO2) und dem Sauerstoffanteil in der eingeatmeten Luft (FiO2).">
            keywords = <"Carrico", "Horovitz", "Index", "Ratio", "PF", "Oxygenierungsindex", "Quotient", "Horovitz-Quotient", "PaO2", "FiO2">
            use = <"Zur Repräsentation des Verhältnisses zwischen dem Sauerstoffpartialdruck im Blut (PaO2) und dem Sauerstoffanteil in der eingeatmeten Luft (FiO2).

Der Wert von PaO2 wird in der Regel an einer anderen Stelle in der Patientenakte als Teil eines arteriellen Blutgas-Testergebnisses protokolliert (OBSERVATION.laboratory_test_result).

Der Wert von FiO2 wird in der Regel an anderer Stelle in der Patientenakte unter Verwendung des Datenelements \"FiO2\" (at0052) im CLUSTER.inspired_oxygen dargestellt.

Dieses Verhältnis kann in anderen Scores verwendet werden, z. B. im SOFA-Score (OBSERVATION.sofa_score), im SMART-COP-Risiko-Score, im ARDS-Schweregrad-Score und im Simplified Acute Physiology Score (SAPS) II.">
            misuse = <"">
        >
        ["nb"] = <
            language = <[ISO_639-1::nb]>
            purpose = <"For å registrere ratio mellom partialtrykk av oksygen i blod (PaO₂) og fraksjon av oksygen i den innåndede luften (FiO₂).">
            keywords = <"Carrico", "Horowitz", "indeks", "ratio", "PF", "P/F", "PaO2", "FiO2", "oksygenering", "oksygeneringsbehov">
            use = <"Bruk for å registrere ratio mellom partialtrykk av oksygen i blod (PaO₂) og fraksjon av oksygen i den innåndede luften (FiO₂).

Verdien for PaO₂ blir normalt registrert annet sted i pasientjournalen, for eksempel som del av svar på arteriell blodgassanalyse (OBSERVATION.laboratory_test_result).

Verdien for FiO₂ blir normalt registrert annet sted i pasientjournalen, i elementet 'FiO₂' (at0052) i CLUSTER.inspired_oxygen (Innåndet oksygen).

Denne ratioen kan brukes i andre skårer, som for eksempel SOFA skår (OBSERVATION.sofa_score), SMART-COP risk skår, ARDS severity score og Simplified Acute Physiology Score (SAPS) II.">
            misuse = <"">
        >
        ["en"] = <
            language = <[ISO_639-1::en]>
            purpose = <"Use to record the ratio between the partial pressure of oxygen in blood (PaO₂) and the fraction of oxygen in the inspired air (FiO₂).">
            keywords = <"Carrico", "Horowitz", "index", "ratio", "PF", "P/F", "PaO2", "FiO2">
            use = <"Use to record the ratio between the partial pressure of oxygen in blood (PaO₂), and the fraction of oxygen in the inspired air (FiO₂).

The value of PaO₂ will usually be recorded elsewhere in the health record as part of an arterial blood gas test result (OBSERVATION.laboratory_test_result).

The value of FiO₂ will usually be recorded elsewhere in the health record using the 'FiO₂' data element (at0052) in the CLUSTER.inspired_oxygen.

This ratio may be used within other scores, such as SOFA Score (OBSERVATION.sofa_score), SMART-COP risk score, ARDS severity score and Simplified Acute Physiology Score (SAPS) II.">
            misuse = <"">
            copyright = <"© openEHR Foundation">
        >
    >

definition
    OBSERVATION[at0000] matches {    -- PaO₂/FiO₂ ratio
        data matches {
            HISTORY[at0001] matches {
                events cardinality matches {0..*; unordered} matches {
                    POINT_EVENT[at0002] matches {    -- Any point in time event
                        data matches {
                            ITEM_TREE[at0003] matches {
                                items cardinality matches {0..*; unordered} matches {
                                    ELEMENT[at0004] occurrences matches {1} matches {    -- Ratio
                                        value matches {
                                            DV_QUANTITY[at9001] matches {
                                                property matches {[at9000]}    -- Pressure
                                                [units] matches {
                                                    [{"kPa"}],
                                                    [{"mm[Hg]"}]
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0007] occurrences matches {0..1} matches {    -- Clinical interpretation
                                        value matches {
                                            DV_TEXT[at9002]
                                        }
                                    }
                                    ELEMENT[at0008] occurrences matches {0..1} matches {    -- Comment
                                        value matches {
                                            DV_TEXT[at9003]
                                        }
                                    }
                                }
                            }
                        }
                        state matches {
                            ITEM_TREE[at0009] matches {
                                items cardinality matches {0..*; unordered} matches {
                                    ELEMENT[at0010] occurrences matches {0..1} matches {    -- Confounding factors
                                        value matches {
                                            DV_TEXT[at9004]
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        protocol matches {
            ITEM_TREE[at0005] matches {
                items cardinality matches {0..*; unordered} matches {
                    allow_archetype CLUSTER[at0006] matches {    -- Extension
                        include
                            archetype_id/value matches {/.*/}
                    }
                }
            }
        }
    }

