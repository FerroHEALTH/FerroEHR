            >
            ["at0019"] = <
                text = <"Kognitio/muisti">
                description = <"*Subjective assessment of cognitive status or Abbreviated Mental Test Score (AMTS).  (en)">
            >
            ["at0020"] = <
                text = <"Ei vaikeuksia tai MMSE pisteet 24-30">
                description = <"*">
