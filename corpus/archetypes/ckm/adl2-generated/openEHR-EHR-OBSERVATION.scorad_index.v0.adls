            >
            ["ac9025"] = <
                text = <"Intensity - dryness (synthesised)">
                description = <"The level of intensity of dryness of unaffected skin. (synthesised)">
            >
            ["ac9006"] = <
                text = <"Total intensity grade (synthesised)">
