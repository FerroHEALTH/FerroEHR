    references = <
        ["1"] = <"Morken, T., Baste, V., Johnsen, G.E. et al. The Staff Observation Aggression Scale – Revised (SOAS-R) – adjustment and validation for emergency primary health care. BMC Health Serv Res 18, 335 (2018). https://doi.org/10.1186/s12913-018-3157-z">
        ["2"] = <"Palmstierna, T. and Wistedt, B. (1987), Staff observation aggression scale, SOAS: Presentation and evaluation. Acta Psychiatrica Scandinavica, 76: 657-663. https://doi.org/10.1111/j.1600-0447.1987.tb02936.x">
        ["3"] = <"Nijman, H.L., Muris, P., Merckelbach, H.L., Palmstierna, T., Wistedt, B., Vos, A., van Rixtel, A. and Allertz, W. (1999), The staff observation aggression scale–revised (SOAS‐R). Aggr. Behav., 25: 197-209. https://doi.org/10.1002/(SICI)1098-2337(1999)25:3<197::AID-AB4>3.0.CO;2-C">
        ["4"] = <"Nijman, H.L.I., Palmstierna, T., Almvik, R. and Stolker, J.J. (2005), Fifteen years of research with the Staff Observation Aggression Scale: a review. Acta Psychiatrica Scandinavica, 111: 12-21. https://doi.org/10.1111/j.1600-0447.2004.00417.x">
    >
    other_details = <
        ["MD5-CAM-1.0.1"] = <"F1B57BC1AEA3CC8C29D09762277EFB44">
