    details = <
        ["nb"] = <
            language = <[ISO_639-1::nb]>
            purpose = <"For å registrere hyppigheten, karakteren og alvorlighetsgraden av aggressive hendelser.">
            keywords = <"verbal, fysisk, angrep, voldelig, oppførsel", ...>
            use = <"Brukes for å registrere hyppigheten, karakteren og alvorlighetsgraden av aggressive hendelser.

openEHR-arketyper er fritt tilgjengelige under en åpen lisens, men det spesifikke innholdet i denne Staff Observation Aggression Scale – Revised – Emergency primary care-arketypen er opphavsrettslig beskyttet. All bruk av denne arketypen i implementasjoner må gjøres i henhold til vilkår gitt av innehaverne av opphavsretten.
Erklæring om opphavsrett: ©Henk Nijman, Tom Palmstierna1999 –Not to be copied without express written permission by one of the author or Frenzs B.V.
Informasjon om opphavsretten: https://www.frenzs.org/soas-r/.">
            misuse = <"">
        >
        ["en"] = <
            language = <[ISO_639-1::en]>
            purpose = <"To record the frequency, nature, and severity of aggressive incidents.">
            keywords = <"verbal, physical, attacking, violent, behaviour", ...>
            use = <"Use to record the frequency, nature, and severity of aggressive incidents.

While openEHR archetypes are all freely available under an open license, the specific content of this Staff Observation Aggression Scale – Revised – Emergency primary care archetype is copyright protected. Any use of this archetype within implementations must be in compliance with the terms established by the copyright owners. Copyright statement: ©Henk Nijman, Tom Palmstierna1999 –Not to be copied without express written permission by one of the author or Frenzs B.V. Copyright information: https://www.frenzs.org/soas-r/.">
            misuse = <"">
        >
    >

definition
    OBSERVATION[at0000] matches {    -- The Staff Observation Aggression Scale – Revised Emergency (SOAS-RE)
        data matches {
            HISTORY[at0001] matches {
                events cardinality matches {0..*; unordered} matches {
                    EVENT[at0002] matches {    -- Any event
                        data matches {
                            ITEM_TREE[at0003] matches {
                                items cardinality matches {0..*; unordered} matches {
                                    ELEMENT[at0132] occurrences matches {0..1} matches {    -- When was the incident?
                                        value matches {
                                            DV_DATE_TIME[at9015] matches {
                                                value
                                            }
                                        }
                                    }
                                    ELEMENT[at0099] matches {    -- Where was the incident?
                                        value matches {
                                            DV_CODED_TEXT[at9016] matches {
                                                defining_code matches {[ac9000]}    -- Where was the incident? (synthesised)
                                            }
                                        }
                                    }
                                    ELEMENT[at0104] occurrences matches {0..1} matches {    -- Other place of incident
                                        value matches {
                                            DV_TEXT[at9017]
                                        }
                                    }
                                    CLUSTER[at0106] occurrences matches {0..1} matches {    -- Staff member exposed to incident
                                        items cardinality matches {1..*; unordered} matches {
                                            ELEMENT[at0130] occurrences matches {0..1} matches {    -- Age
                                                value matches {
                                                    DV_COUNT[at9018] matches {
                                                        magnitude matches {|0..120|}
                                                    }
                                                }
                                            }
                                            ELEMENT[at0107] occurrences matches {0..1} matches {    -- Occupation
                                                value matches {
                                                    DV_TEXT[at9019]
                                                }
                                            }
                                            ELEMENT[at0108] occurrences matches {0..1} matches {    -- Sex
                                                value matches {
                                                    DV_CODED_TEXT[at9020] matches {
                                                        defining_code matches {[ac9001]}    -- Sex (synthesised)
                                                    }
                                                }
                                            }
                                            ELEMENT[at0111] matches {    -- Were you alone in the situation?
                                                value matches {
                                                    DV_CODED_TEXT[at9021] matches {
                                                        defining_code matches {[ac9002]}    -- Were you alone in the situation? (synthesised)
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    CLUSTER[at0114] occurrences matches {0..1} matches {    -- Aggressor
                                        items cardinality matches {1..*; unordered} matches {
                                            ELEMENT[at0115] matches {    -- Who
                                                value matches {
                                                    DV_CODED_TEXT[at9022] matches {
                                                        defining_code matches {[ac9003]}    -- Who (synthesised)
                                                    }
                                                }
                                            }
                                            ELEMENT[at0133] occurrences matches {0..1} matches {    -- Other aggressor
                                                value matches {
                                                    DV_TEXT[at9048]
                                                }
                                            }
                                            ELEMENT[at0119] occurrences matches {0..1} matches {    -- Sex
                                                value matches {
                                                    DV_CODED_TEXT[at9023] matches {
                                                        defining_code matches {[ac9004]}    -- Sex (synthesised)
                                                    }
                                                }
                                            }
                                            ELEMENT[at0122] occurrences matches {0..1} matches {    -- Does the aggressor have a known mental illness?
                                                value matches {
                                                    DV_CODED_TEXT[at9049] matches {
                                                        defining_code matches {[ac9005]}    -- Does the aggressor have a known mental illness? (synthesised)
                                                    }
                                                }
                                            }
                                            ELEMENT[at0123] occurrences matches {0..1} matches {    -- Was the aggressor under influence of drugs or alcohol?
                                                value matches {
                                                    DV_CODED_TEXT[at9050] matches {
                                                        defining_code matches {[ac9006]}    -- Was the aggressor under influence of drugs or alcohol? (synthesised)
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    CLUSTER[at0007] occurrences matches {1} matches {    -- Provocation of aggresive behaviour
                                        items cardinality matches {1..*; unordered} matches {
                                            ELEMENT[at0020] occurrences matches {0..1} matches {    -- No understandable provocation
                                                value matches {
                                                    DV_BOOLEAN[at9026] matches {
                                                        value matches {True}
                                                    }
                                                }
                                            }
                                            ELEMENT[at0014] matches {    -- Provoked by
                                                value matches {
                                                    DV_CODED_TEXT[at9027] matches {
                                                        defining_code matches {[ac9007]}    -- Provoked by (synthesised)
                                                    }
                                                }
                                            }
                                            ELEMENT[at0019] occurrences matches {0..1} matches {    -- Description
                                                value matches {
                                                    DV_TEXT[at9028]
                                                }
                                            }
                                        }
                                    }
                                    CLUSTER[at0008] occurrences matches {1} matches {    -- Means used by the aggressor
                                        items cardinality matches {1..*; unordered} matches {
                                            ELEMENT[at0059] occurrences matches {0..1} matches {    -- Verbal aggression
                                                value matches {
                                                    DV_BOOLEAN[at9029] matches {
                                                        value matches {True}
                                                    }
                                                }
                                            }
                                            ELEMENT[at0060] occurrences matches {0..1} matches {    -- Threat
                                                value matches {
                                                    DV_BOOLEAN[at9030] matches {
                                                        value matches {True}
                                                    }
                                                }
                                            }
                                            ELEMENT[at0022] occurrences matches {0..1} matches {    -- Ordinary objects
                                                value matches {
                                                    DV_CODED_TEXT[at9031] matches {
                                                        defining_code matches {[at0026]}    -- Room contents/ objects.
                                                    }
                                                }
                                            }
                                            ELEMENT[at0023] occurrences matches {0..1} matches {    -- Parts of the body
                                                value matches {
                                                    DV_CODED_TEXT[at9032] matches {
                                                        defining_code matches {[ac9008]}    -- Parts of the body (synthesised)
                                                    }
                                                }
                                            }
                                            ELEMENT[at0058] occurrences matches {0..1} matches {    -- Descritpion
                                                value matches {
                                                    DV_TEXT[at9033]
                                                }
                                            }
                                            ELEMENT[at0031] occurrences matches {0..1} matches {    -- Dangerous objects or methods
                                                value matches {
                                                    DV_CODED_TEXT[at9034] matches {
                                                        defining_code matches {[ac9009]}    -- Dangerous objects or methods (synthesised)
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    CLUSTER[at0010] occurrences matches {1} matches {    -- Target of aggression
                                        items cardinality matches {1..*; unordered} matches {
                                            ELEMENT[at0061] occurrences matches {0..1} matches {    -- None
                                                value matches {
                                                    DV_BOOLEAN[at9035] matches {
                                                        value matches {True}
                                                    }
                                                }
                                            }
                                            ELEMENT[at0036] matches {    -- Target
                                                value matches {
                                                    DV_CODED_TEXT[at9036] matches {
                                                        defining_code matches {[ac9047]}    -- Target (synthesised)
                                                    }
                                                }
                                            }
                                            ELEMENT[at0062] occurrences matches {0..1} matches {    -- Description
                                                value matches {
                                                    DV_TEXT[at9037]
                                                }
                                            }
                                        }
                                    }
                                    CLUSTER[at0011] occurrences matches {1} matches {    -- Consequence(s) for victim(s)
                                        items cardinality matches {1..*; unordered} matches {
                                            ELEMENT[at0046] occurrences matches {0..1} matches {    -- None
                                                value matches {
                                                    DV_BOOLEAN[at9038] matches {
                                                        value matches {True}
                                                    }
                                                }
                                            }
                                            ELEMENT[at0047] occurrences matches {0..1} matches {    -- Objects
                                                value matches {
                                                    DV_CODED_TEXT[at9039] matches {
                                                        defining_code matches {[at0049]}    -- Damaged
                                                    }
                                                }
                                            }
                                            ELEMENT[at0048] matches {    -- Person
                                                value matches {
                                                    DV_CODED_TEXT[at9040] matches {
                                                        defining_code matches {[ac9011]}    -- Person (synthesised)
                                                    }
                                                }
                                            }
                                            ELEMENT[at0063] occurrences matches {0..1} matches {    -- Description
                                                value matches {
                                                    DV_TEXT[at9041]
                                                }
                                            }
                                        }
                                    }
                                    CLUSTER[at0012] occurrences matches {0..1} matches {    -- Measure(s) to stop aggression
                                        items cardinality matches {1..*; unordered} matches {
                                            ELEMENT[at0064] occurrences matches {0..1} matches {    -- None
                                                value matches {
                                                    DV_BOOLEAN[at9042] matches {
                                                        value matches {True}
                                                    }
                                                }
                                            }
                                            ELEMENT[at0065] matches {    -- Measure(s)
                                                value matches {
                                                    DV_CODED_TEXT[at9043] matches {
                                                        defining_code matches {[ac9012]}    -- Measure(s) (synthesised)
                                                    }
                                                }
                                            }
                                            ELEMENT[at0075] occurrences matches {0..1} matches {    -- Description
                                                value matches {
                                                    DV_TEXT[at9044]
                                                }
                                            }
                                        }
                                    }
                                    CLUSTER[at0013] occurrences matches {0..1} matches {    -- Persons involved in measure(s) to stop aggression
                                        items cardinality matches {1..*; unordered} matches {
                                            ELEMENT[at0076] matches {    -- Persons involved
                                                value matches {
                                                    DV_CODED_TEXT[at9045] matches {
                                                        defining_code matches {[ac9013]}    -- Persons involved (synthesised)
                                                    }
                                                }
                                            }
                                            ELEMENT[at0085] occurrences matches {0..1} matches {    -- Description
                                                value matches {
                                                    DV_TEXT[at9046]
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0086] occurrences matches {0..1} matches {    -- Visual Analogue Scale (VAS)
                                        value matches {
                                            DV_ORDINAL[at9047] matches {
                                                [value, symbol] matches {
                                                    [{0}, {[at0087]}],    -- Not severe at all
                                                    [{1}, {[at0089]}],    -- 1
                                                    [{2}, {[at0090]}],    -- 2
                                                    [{3}, {[at0091]}],    -- 3
                                                    [{4}, {[at0092]}],    -- 4
                                                    [{5}, {[at0093]}],    -- 5
                                                    [{6}, {[at0094]}],    -- 6
                                                    [{7}, {[at0095]}],    -- 7
                                                    [{8}, {[at0096]}],    -- 8
                                                    [{9}, {[at0097]}],    -- 9
                                                    [{10}, {[at0098]}]    -- Extremely severe
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        protocol matches {
            ITEM_TREE[at0004] matches {
                items cardinality matches {0..*; unordered} matches {
                    allow_archetype CLUSTER[at0134] matches {    -- Extension
                        include
                            archetype_id/value matches {/.*/}
                    }
                }
            }
        }
    }

terminology
    term_definitions = <
        ["nb"] = <
            ["at0000"] = <
                text = <"The Staff Observation Aggression Scale – Revised Emergency (SOAS-RE)">
                description = <"Et instrument for å overvåke hyppigheten, karakteren og alvorlighetsgraden av aggressive hendelser.">
            >
            ["at0002"] = <
                text = <"Uspesifisert hendelse">
                description = <"Standard, uspesifisert tidspunkt eller tidsintervall som kan defineres mer eksplisitt i et templat eller i en applikasjon.">
            >
            ["at0007"] = <
                text = <"Utløsende faktor for aggressiv atferd">
                description = <"">
            >
            ["at0008"] = <
                text = <"Hva brukte utøver">
                description = <"">
            >
            ["at0010"] = <
                text = <"Mål for aggresjon">
                description = <"">
            >
            ["at0011"] = <
                text = <"Umiddelbar konsekvens for offer">
                description = <"">
            >
            ["at0012"] = <
                text = <"Umiddelbart tiltak for å stoppe aggresjon">
                description = <"">
