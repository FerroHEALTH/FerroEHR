                description = <"*@internal@(en)">
            >
            ["ac9000"] = <
                text = <"رأس السطر (synthesised)">
                description = <"*@internal@(en) (synthesised)">
            >
            ["ac9010"] = <
                text = <"عضلة ذات الرأسين (synthesised)">
