definition
    OBSERVATION[at0000] matches {    -- Travel trip history
        data matches {
            HISTORY[at0001] matches {
                events cardinality matches {0..*; unordered} matches {
                    EVENT[at0002] occurrences matches {0..1} matches {    -- Any event
                        data matches {
                            ITEM_TREE[at0003] matches {
                                items cardinality matches {0..*; unordered} matches {
                                    ELEMENT[at0111] occurrences matches {0..1} matches {    -- Recent travel
                                        value matches {
                                            DV_CODED_TEXT[at9025] matches {
                                                defining_code matches {[ac9022]}    -- Recent travel (synthesised)
                                            }
                                        }
                                    }
                                    ELEMENT[at0115] occurrences matches {0..1} matches {    -- Incubation period
                                        value matches {
                                            DV_DURATION[at9026]
                                        }
                                    }
                                    ELEMENT[at0059] matches {    -- Reason for travel
                                        value matches {
                                            DV_CODED_TEXT[at9005] matches {
                                                defining_code matches {[ac9000]}    -- Reason for travel (synthesised)
                                            }
                                            DV_TEXT[at9006]
                                        }
                                    }
                                    ELEMENT[at0070] occurrences matches {0..1} matches {    -- Duration of travel
                                        value matches {
                                            DV_DURATION[at9007]
                                        }
                                    }
                                    ELEMENT[at0071] occurrences matches {0..1} matches {    -- Date of return
                                        value matches {
                                            DV_DATE_TIME[at9008]
                                        }
                                    }
                                    CLUSTER[at0120] occurrences matches {0..1} matches {    -- Known contacts
                                        items cardinality matches {1..*; unordered} matches {
                                            ELEMENT[at0121] occurrences matches {0..1} matches {    -- Confirmed contact
                                                value matches {
                                                    DV_CODED_TEXT[at9027] matches {
                                                        defining_code matches {[ac9023]}    -- Confirmed contact (synthesised)
                                                    }
                                                }
                                            }
                                            ELEMENT[at0131] occurrences matches {0..1} matches {    -- Contact setting
                                                value matches {
                                                    DV_TEXT[at9028]
                                                }
                                            }
                                            CLUSTER[at0125] matches {    -- Contact details
                                                items cardinality matches {1..*; unordered} matches {
                                                    ELEMENT[at0126] occurrences matches {0..1} matches {    -- Case identifier
                                                        value matches {
                                                            DV_TEXT[at9029]
                                                            DV_IDENTIFIER[at9030]
                                                        }
                                                    }
                                                    ELEMENT[at0129] occurrences matches {0..1} matches {    -- Date of first exposure
                                                        value matches {
                                                            DV_DATE_TIME[at9031]
                                                        }
                                                    }
                                                    ELEMENT[at0130] occurrences matches {0..1} matches {    -- Date of last exposure
                                                        value matches {
                                                            DV_DATE_TIME[at9032]
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    CLUSTER[at0134] occurrences matches {0..1} matches {    -- Location history
                                        items cardinality matches {1..*; unordered} matches {
                                            ELEMENT[at0132] matches {    -- Likely location for exposure
                                                value matches {
                                                    DV_TEXT[at9033]
                                                }
                                            }
                                            allow_archetype CLUSTER[at0135] matches {    -- Location visited
                                                include
                                                    archetype_id/value matches {/.*/}
                                            }
                                        }
                                    }
                                    ELEMENT[at0072] occurrences matches {0..1} matches {    -- Type of accommodations and sleeping arrangements
                                        value matches {
                                            DV_CODED_TEXT[at9014]
                                        }
                                    }
                                    ELEMENT[at0116] occurrences matches {0..1} matches {    -- Visited healthcare facilities
                                        value matches {
                                            DV_CODED_TEXT[at9034] matches {
                                                defining_code matches {[ac9024]}    -- Visited healthcare facilities (synthesised)
                                            }
                                        }
                                    }
                                    ELEMENT[at0049] matches {    -- Recreational activities
                                        value matches {
                                            DV_CODED_TEXT[at9015] matches {
                                                defining_code matches {[ac9001]}    -- Recreational activities (synthesised)
                                            }
                                        }
                                    }
                                    ELEMENT[at0102] occurrences matches {0..1} matches {    -- Common exposures
                                        value matches {
                                            DV_TEXT[at9016]
                                        }
                                    }
                                    ELEMENT[at0103] occurrences matches {0..1} matches {    -- Insect bites
                                        value matches {
                                            DV_TEXT[at9017]
                                        }
                                    }
                                    ELEMENT[at0085] matches {    -- Foods eaten
                                        value matches {
                                            DV_CODED_TEXT[at9018] matches {
                                                defining_code matches {[ac9002]}    -- Foods eaten (synthesised)
                                            }
                                        }
                                    }
                                    ELEMENT[at0104] occurrences matches {0..1} matches {    -- Source of drinking water
                                        value matches {
                                            DV_TEXT[at9019]
                                        }
                                    }
                                    ELEMENT[at0091] matches {    -- Other exposures
                                        value matches {
                                            DV_CODED_TEXT[at9020] matches {
                                                defining_code matches {[ac9003]}    -- Other exposures (synthesised)
                                            }
                                            DV_TEXT[at9021]
                                        }
                                    }
                                    ELEMENT[at0096] matches {    -- Use of travel precautions
                                        value matches {
                                            DV_CODED_TEXT[at9022] matches {
                                                defining_code matches {[ac9004]}    -- Use of travel precautions (synthesised)
                                            }
                                        }
                                    }
                                    allow_archetype CLUSTER[at0109] matches {    -- Exposure details
                                        include
                                            archetype_id/value matches {/.*/}
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        protocol matches {
            ITEM_TREE[at0100] matches {
                items cardinality matches {0..*; unordered} matches {
                    allow_archetype CLUSTER[at0101] matches {    -- Extension
                        include
                            archetype_id/value matches {/.*/}
                    }
                }
            }
        }
    }

