    other_details = <
        ["MD5-CAM-1.0.1"] = <"E6A056073949078B363F62A91C54E6AA">
    >
    details = <
        ["en"] = <
            language = <[ISO_639-1::en]>
            purpose = <"To record the measured or estimated urine output.">
            keywords = <"wee", "urine", "production", "output">
            use = <"Use the HISTORY class to record the period of time and totals if required.">
            misuse = <"">
            copyright = <"© openEHR Foundation">
        >
        ["ar-sy"] = <
            language = <[ISO_639-1::ar-sy]>
            purpose = <"لتسجيل قياس (أو تقدير) النتاج البولي">
            keywords = <"البول", "الإنتاج", "النتاج">
            use = <"استخدم فئة (التاريخ) لتسجيل الفترة الزمنية و إجمالي الكميات عند الحاجة">
            misuse = <"">
            copyright = <"© openEHR Foundation">
        >
    >

definition
    OBSERVATION[at0000] matches {    -- Urine output
        data matches {
            HISTORY[at0001] matches {
                events cardinality matches {1..*; unordered} matches {
                    POINT_EVENT[at0002] matches {    -- Timing
                        data matches {
                            ITEM_TREE[at0003] matches {
                                items cardinality matches {0..*; unordered} matches {
                                    ELEMENT[at0004] occurrences matches {1} matches {    -- Urine output
                                        value matches {
                                            DV_QUANTITY[at9005] matches {
                                                property matches {[at9000]}    -- Volume
                                                magnitude matches {|>=0.0|}
                                                units matches {"ml"}
                                                precision matches {0}
                                            }
                                        }
                                    }
                                    ELEMENT[at0013] occurrences matches {0..1} matches {    -- Passed urine
                                        value matches {
                                            DV_BOOLEAN[at9006] matches {
                                                value matches {True, False}
                                            }
                                        }
                                    }
                                    ELEMENT[at0014] occurrences matches {0..1} matches {    -- Last void
                                        value matches {
                                            DV_DATE_TIME[at9007] matches {
                                                value
                                            }
                                        }
                                    }
                                    ELEMENT[at0015] occurrences matches {0..1} matches {    -- Time since last void
                                        value matches {
                                            DV_QUANTITY[at9008] matches {
                                                property matches {[at9001]}    -- Time
                                                [units] matches {
                                                    [{"s"}],
                                                    [{"min"}],
                                                    [{"h"}],
                                                    [{"d"}]
                                                }
                                            }
                                        }
                                    }
                                    allow_archetype CLUSTER[at0016] occurrences matches {0..1} matches {    -- Fluid cluster
                                        include
                                            archetype_id/value matches {/openEHR-EHR-CLUSTER\.fluid\.v1\..*/}
                                        exclude
                                            archetype_id/value matches {/.*/}
                                    }
                                }
                            }
                        }
                    }
                    INTERVAL_EVENT[at0006] matches {    -- Total
                        math_function matches {
                            DV_CODED_TEXT[at9010] matches {
                                defining_code matches {[at9002]}    -- total
                            }
                        }
                        data matches {
                            use_node ITEM_TREE[at9011] /data[at0001]/events[at0002]/data[at0003]
                        }
                    }
                    INTERVAL_EVENT[at0007] matches {    -- Actual
                        math_function matches {
                            DV_CODED_TEXT[at9012] matches {
                                defining_code matches {[at9003]}    -- actual
                            }
                        }
                        data matches {
                            use_node ITEM_TREE[at9013] /data[at0001]/events[at0002]/data[at0003]
                        }
                    }
                }
            }
        }
        protocol matches {
            ITEM_LIST[at0008] matches {
                items cardinality matches {0..*; unordered} matches {
                    ELEMENT[at0009] occurrences matches {0..1} matches {    -- Method of catchment
                        value matches {
                            DV_CODED_TEXT[at9014] matches {
                                defining_code matches {[ac9004]}    -- Method of catchment (synthesised)
                            }
                        }
                    }
                }
            }
        }
    }

