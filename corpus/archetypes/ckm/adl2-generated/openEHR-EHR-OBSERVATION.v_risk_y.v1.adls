    details = <
        ["nb"] = <
            language = <[ISO_639-1::nb]>
            purpose = <"For å registrere strukturert vurdering av korttids voldsrisiko hos ungdom i alderen 12–18 år basert på V-RISK-Y sjekkliste, inkludert skåring av individuelle risikofaktorer og samlet klinisk vurdering.">
            keywords = <"voldsrisiko, ungdom, risikovurdering, psykisk helsevern, sikkerhetspsykiatri, sjekkliste, skåringsverktøy, risikofaktorer, forebyggende tiltak", ...>
            use = <"Brukes for å registrere strukturert vurdering av korttids voldsrisiko hos ungdom i alderen 12–18 år basert på V-RISK-Y sjekkliste, inkludert skåring av individuelle risikofaktorer og samlet klinisk vurdering.">
            misuse = <"Brukes ikke for å registrere langsiktig voldsrisiko eller utover aldersgruppen som er definert for V-RISK-Y.">
        >
        ["en"] = <
            language = <[ISO_639-1::en]>
            purpose = <"To record a structured assessment of short-term violence risk in adolescents aged 12–18 years based on the V-RISK-Y checklist, including scoring of individual risk factors and an overall clinical assessment.">
            keywords = <"violence risk, adolescents, risk assessment, mental health services, forensic psychiatry, checklist, scoring tool, risk factors, preventive measures, youth", ...>
            use = <"Used to record scores for each of the 12 items in the V-RISK-Y, as well as an overall clinical assessment of violence risk.

Reference for the English translation: V-RISK-Y © Revised 21.06.2024. Regional Research and Education Centre for Security, Prisons and Forensic Psychiatry, Oslo University Hospital, South-Eastern Norway Regional Health Authority.

While openEHR archetypes are all freely available under an open license, the specific content of this V-RISK-Y archetype is copyright protected. Any use of this archetype within implementations must be in compliance with the terms established by the copyright owners.

Copyright statement: V-RISK-Y © The checklist can be downloaded and used free of charge (no fees). It is not permitted to use V-RISK-Y in a commercial context or to charge someone for using it. The layout can be adapted, for example to fit an electronic hospital record, but the text cannot be changed.

Copyright information: https://www.sifer.no/verktoy/#v-risk-y/">
            misuse = <"Not to be used for results from other instruments in the V-RISK family. Use specific archetypes for these purposes.">
            copyright = <"© openEHR Foundation">
        >
    >

definition
    OBSERVATION[at0000] matches {    -- Violence Risk Assessment Checklist for Youth aged 12-18 (V-RISK-Y)
        data matches {
            HISTORY[at0001] matches {
                events cardinality matches {1..*; unordered} matches {
                    EVENT[at0002] matches {    -- Any event
                        data matches {
                            ITEM_TREE[at0003] matches {
                                items cardinality matches {0..*; unordered} matches {
                                    ELEMENT[at0004] occurrences matches {0..1} matches {    -- 1. Prior and/or current acts of violence
                                        value matches {
                                            DV_CODED_TEXT[at9045] matches {
                                                defining_code matches {[ac9015]}    -- 1. Prior and/or current acts of violence (synthesised)
                                            }
                                        }
                                    }
                                    ELEMENT[at0005] occurrences matches {0..1} matches {    -- 2. Prior and/or current threats of violence
                                        value matches {
                                            DV_CODED_TEXT[at9046] matches {
                                                defining_code matches {[ac9016]}    -- 2. Prior and/or current threats of violence (synthesised)
                                            }
                                        }
                                    }
                                    ELEMENT[at0006] occurrences matches {0..1} matches {    -- 3. Prior and/or current alcohol or substance abuse
                                        value matches {
                                            DV_CODED_TEXT[at9047] matches {
                                                defining_code matches {[ac9017]}    -- 3. Prior and/or current alcohol or substance abuse (synthesised)
                                            }
                                        }
                                    }
                                    ELEMENT[at0007] occurrences matches {0..1} matches {    -- 4. Prior and/or current severe symptoms of mental health disorders
                                        value matches {
                                            DV_CODED_TEXT[at9048] matches {
                                                defining_code matches {[ac9018]}    -- 4. Prior and/or current severe symptoms of mental health disorders (synthesised)
                                            }
                                        }
                                    }
                                    ELEMENT[at0008] occurrences matches {0..1} matches {    -- 5. Disruptive, impulsive behaviour/behavioural disorder
                                        value matches {
                                            DV_CODED_TEXT[at9032] matches {
                                                defining_code matches {[ac9019]}    -- 5. Disruptive, impulsive behaviour/behavioural disorder (synthesised)
                                            }
                                        }
                                    }
                                    ELEMENT[at0009] occurrences matches {0..1} matches {    -- 6. Has poor insight into the mental disorder and/or behaviour
                                        value matches {
                                            DV_CODED_TEXT[at9033] matches {
                                                defining_code matches {[ac9020]}    -- 6. Has poor insight into the mental disorder and/or behaviour (synthesised)
                                            }
                                        }
                                    }
                                    ELEMENT[at0010] occurrences matches {0..1} matches {    -- 7. Suspicion
                                        value matches {
                                            DV_CODED_TEXT[at9034] matches {
                                                defining_code matches {[ac9021]}    -- 7. Suspicion (synthesised)
                                            }
                                        }
                                    }
                                    ELEMENT[at0011] occurrences matches {0..1} matches {    -- 8. Demonstrates lack of empathy
                                        value matches {
                                            DV_CODED_TEXT[at9035] matches {
                                                defining_code matches {[ac9022]}    -- 8. Demonstrates lack of empathy (synthesised)
                                            }
                                        }
                                    }
                                    ELEMENT[at0012] occurrences matches {0..1} matches {    -- 9. Unrealistic planning
                                        value matches {
                                            DV_CODED_TEXT[at9036] matches {
                                                defining_code matches {[ac9023]}    -- 9. Unrealistic planning (synthesised)
                                            }
                                        }
                                    }
                                    ELEMENT[at0013] occurrences matches {0..1} matches {    -- 10. Future stressful situations
                                        value matches {
                                            DV_CODED_TEXT[at9037] matches {
                                                defining_code matches {[ac9024]}    -- 10. Future stressful situations (synthesised)
                                            }
                                        }
                                    }
                                    ELEMENT[at0014] occurrences matches {0..1} matches {    -- 11. Prior and/or current severe trauma
                                        value matches {
                                            DV_CODED_TEXT[at9038] matches {
                                                defining_code matches {[ac9025]}    -- 11. Prior and/or current severe trauma (synthesised)
                                            }
                                        }
                                    }
                                    ELEMENT[at0015] occurrences matches {0..1} matches {    -- 12. The youth’s and parents/guardians’ own perception of violence risk
                                        value matches {
                                            DV_CODED_TEXT[at9039] matches {
                                                defining_code matches {[ac9026]}    -- 12. The youth’s and parents/guardians’ own perception of violence risk (synthesised)
                                            }
                                        }
                                    }
                                    ELEMENT[at0016] occurrences matches {0..1} matches {    -- How great do you believe the risk of violence is for this youth?
                                        value matches {
                                            DV_CODED_TEXT[at9040] matches {
                                                defining_code matches {[ac9027]}    -- How great do you believe the risk of violence is for this youth? (synthesised)
                                            }
                                        }
                                    }
                                    ELEMENT[at0083] occurrences matches {0..1} matches {    -- Immediate implementation of preventive measures
                                        value matches {
                                            DV_CODED_TEXT[at9041] matches {
                                                defining_code matches {[ac9013]}    -- Immediate implementation of preventive measures (synthesised)
                                            }
                                        }
                                    }
                                    ELEMENT[at0081] occurrences matches {0..1} matches {    -- Description of preventive measures
                                        value matches {
                                            DV_TEXT[at9042]
                                        }
                                    }
                                    ELEMENT[at0086] occurrences matches {0..1} matches {    -- Suggestions for additional violence risk assessments
                                        value matches {
                                            DV_CODED_TEXT[at9043] matches {
                                                defining_code matches {[ac9014]}    -- Suggestions for additional violence risk assessments (synthesised)
                                            }
                                        }
                                    }
                                    ELEMENT[at0082] occurrences matches {0..1} matches {    -- Description of additional violence risk assessments
                                        value matches {
                                            DV_TEXT[at9044]
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        protocol matches {
            ITEM_TREE[at0089] matches {
                items cardinality matches {0..*; unordered} matches {
                    allow_archetype CLUSTER[at0090] matches {    -- Extension
                        include
                            archetype_id/value matches {/.*/}
                    }
                }
            }
        }
    }

terminology
    term_definitions = <
        ["nb"] = <
            ["at0000"] = <
                text = <"Voldsrisiko Sjekkliste for Ungdom 12-18 år (V-RISK-Y)">
                description = <"V-RISK-Y er et strukturert verktøy for vurdering av voldsrisiko blant ungdom i alderen 12–18 år. Verktøyet er utviklet for bruk ved første kontakt med ungdommen og gir grunnlag for å vurdere behovet for umiddelbare tiltak og videre risikovurdering. ">
            >
            ["at0002"] = <
                text = <"Uspesifisert hendelse">
                description = <"Standard, uspesifisert tidspunkt eller tidsintervall som kan defineres mer eksplisitt i et templat eller i en applikasjon.">
            >
            ["at0004"] = <
                text = <"1. Tidligere og/eller aktuell vold">
                description = <"">
                comment = <"Alvorlig vold: Fysiske angrep (inkludert ulike våpen, brann) for å påføre alvorlig fysisk skade mot annen person.

Moderat: Aggresjonshandlinger som spark, slag og dytting som ikke forårsaker skade hos offeret. 
Ja: Må ha gjort minst 3 moderate eller 1 alvorlig voldshandling. 

Definisjon av vold: Atferd innrettet på (intensjon) å påføre et annet menneske kroppslig smerte, skade eller krenkelse.">
            >
            ["at0005"] = <
                text = <"2. Tidligere og/eller aktuelle trusler om vold">
                description = <"">
                comment = <"En verbal voldstrussel: Rop, utsagn eller skriftlig (inkludert sosiale medier) som truer med å utøve vold mot et annet menneske. 

En fysisk voldstrussel er å vise angrepsforberedende atferd f.eks. å true med knyttneve, eller annen fysisk atferd som signaliserer fysisk angrep. Å ødelegge gjenstander er ikke voldsatferd, men kan i noen situasjoner oppfattes som en trussel (fysisk trussel vil ofte gi høyere risiko enn verbal trussel).

Det kan være vanskelig å vurdere innholdet i trusler, og må etter beste skjønn karakteriseres som virkelige trusler (Moderat eller Ja), eller som «bare prat» (Nei).">
            >
            ["at0006"] = <
                text = <"3. Tidligere og/eller aktuell rusbruk">
                description = <"">
                comment = <"Moderat: Ungdommen har en historie med misbruk av alkohol, medikamenter, narkotiske stoffer, anabole steroider eller løsemidler. 
Ja: Ungdommen har eller har hatt omfattende misbruk/avhengighet, med nedsatt helse eller funksjon i skole-, arbeids- eller fritidsliv.">
            >
            ["at0007"] = <
                text = <"4. Tidligere og/eller aktuelle alvorlige psykiske symptomer">
                description = <"">
                comment = <"Dette leddet fokuserer på en sviktende forståelse av virkeligheten. Ungdommen har merkelig eller upassende atferd eller uttrykker forestillinger som ikke samsvarer med utviklingsmessig alder. Dette kan være uttrykk for angstlidelser, depresjoner, autismespekter lidelser, lidelser/ symptomer med realitetsbrist, eller tilsvarende, og kan også forekomme uten at noen psykisk lidelse er påvist.

Kanskje: Atferd eller forestillinger som gir mistanke om avvik.
Ja: Åpenbar og tydelig avvikende atferd eller forestillinger.">
            >
            ["at0008"] = <
                text = <"5. Forstyrrende, impulsiv atferd/atferdsforstyrrelser">
                description = <"">
                comment = <"Moderat: Impulsiv, forstyrrende atferd som ikke forårsaker alvorlig skade eller ubehag; f.eks. ADHD, opposisjonell atferd eller dårlig emosjonell regulering (f.eks. selvskading).
Ja: Atferdsforstyrrelser som forårsaker alvorlig skade eller ubehag, antisosial atferd.">
            >
            ["at0009"] = <
                text = <"6. Mangler innsikt i sykdom og/eller atferd">
                description = <"">
                comment = <"Her undersøkes i hvilken grad ungdommen eller foresatte mangler innsikt i ungdommens psykiske lidelse eller atferdsproblemer, hvilke sosiale konsekvenser disse kan medføre, og hva ungdommen trenger av hjelp, støtte, omsorgstiltak eller behandling. For yngre ungdommer vil foresattes innsikt være viktigst, for eldre ungdommer vil ungdommens egen innsikt være viktigst.

Moderat: Enten ungdommen eller foresatte mangler innsikt.
Ja: Både ungdommen og foresatte, eller ungdom 16-18 år, mangler innsikt.">
            >
            ["at0010"] = <
                text = <"7. Mistenksomhet">
                description = <"">
                comment = <"Ungdommen gir uttrykk for mistenksomhet overfor andre personer enten verbalt eller nonverbalt, eller ser ut til å være «på vakt» overfor omgivelsene.">
            >
            ["at0011"] = <
                text = <"8. Viser manglende innlevelse (empati)">
                description = <"">
                comment = <"Ungdommen uttrykker følelseskald atferd uten innlevelse i andres tankemessige eller følelsesmessige situasjon. Atferden skal tydelig vise at ungdommen mangler empati.">
            >
            ["at0012"] = <
                text = <"9. Urealistisk planlegging">
                description = <"">
                comment = <"Her undersøkes i hvilken grad ungdommen selv eller foresatte har urealistiske planer for hva ungdommen trenger av hjelp, støtte eller behandling i fremtiden, og hva som kan forventes av støtte fra familie, og av sosialt og profesjonelt nettverk. Det er viktig å vurdere om foresatte og ungdommen er samarbeidsvillige og motiverte til å følge planene videre. For yngre ungdommer vil foresattes planer være viktigst, for eldre ungdommer vil egne planer være viktigst.

Moderat: Enten ungdommen eller foresatte mangler realistiske planer.
Ja: Både ungdommen og foresatte, eller ungdom 16-18 år, mangler realistiske planer.">
            >
            ["at0013"] = <
                text = <"10. Framtidige stress-situasjoner">
                description = <"">
                comment = <"Her undersøkes muligheten for at ungdommen (1) kan bli utsatt for påkjenninger og belastende situasjoner i fremtiden, og (2) ungdommens evne til stressmestring. Det er nok å komme inn under enten (1) eller (2) for å skåre (Moderat eller Ja)

I dette leddet inngår om foresatte kan være en støtte for ungdommen m.h.t. stressmestring, om det foreligger konflikt mellom ungdommen og foresatte, om foresatte eller ungdommen har antisosial livsstil eller holdninger, eller tiltrekning til voldelige miljøer som ekstremistiske sympatisører, f.eks. radikale islamister eller høyreradikale.

Eksempler: Mestringssvikt overfor grensesetting, nærhet til mulige voldsofre, rusing, eksponering for voldelig miljø, etc.">
            >
            ["at0014"] = <
                text = <"11. Tidligere og/eller alvorlig pågående traume">
                description = <"">
                comment = <"Har ungdommen vært utsatt for eller vært vitne til et alvorlig traume, vært utsatt for eller vært vitne til gjentatte fysiske, seksuelle eller psykiske overgrep, vært utsatt for omsorgssvikt?

Kanskje: Mistanke om alvorlig traume. 
Ja: Alvorlig traume.">
            >
            ["at0015"] = <
                text = <"12. Ungdommens og foresattes egen oppfatning av voldsrisiko">
                description = <"">
                comment = <"I hvilken grad ungdommen eller de foresatte oppfatter at det er risiko for vold: 

Kanskje: Ungdommen eller de foresatte oppfatter at det er litt forhøyet risiko for vold.
Ja: Ungdommen eller de foresatte oppfatter at det er enten moderat eller
høy voldsrisiko, eller de vil ikke svare.">
            >
            ["at0016"] = <
                text = <"Hvor stor tror du voldsrisikoen er for denne pasienten?">
                description = <"Samlet klinisk vurdering og iverksettelse av tiltak basert på V-RISK-Y, individuell klinisk vurdering, og annen tilgjengelig informasjon. ">
            >
            ["at0081"] = <
                text = <"Beskrivelse av forebyggende tiltak">
                description = <"">
                comment = <"Eks: skjerming, fast vakt, ekstra personale, hyppig tilsyn.">
            >
            ["at0082"] = <
                text = <"Beskrivelse av videre voldsrisikovurderingstiltak">
                description = <"">
                comment = <"Eks: kartlegging/utredning, videre voldsrisikoutredning på institusjonen, henvisning til second opinion, bruk av instrumenter (som BVC, ERM, START AV, SAVRY), etc.">
            >
            ["at0083"] = <
                text = <"Umiddelbar iverksettelse av forebyggende tiltak">
                description = <"">
            >
            ["at0084"] = <
                text = <"Ingen">
                description = <"">
            >
            ["at0085"] = <
                text = <"Ja">
                description = <"">
            >
            ["at0086"] = <
                text = <"Forslag til videre voldsrisikovurdering">
                description = <"">
            >
            ["at0087"] = <
                text = <"Nei">
                description = <"">
            >
            ["at0088"] = <
                text = <"Ja">
                description = <"">
            >
            ["at0090"] = <
                text = <"Tilleggsinformasjon">
                description = <"Ytterligere informasjon som trengs for å kunne registrere lokalt definert innhold eller for å tilpasse til andre   referansemodeller eller formalismer.">
                comment = <"For eksempel lokale informasjonsbehov eller ytterligere metadata for å kunne tilpasse til tilsvarende konsepter i FHIR.">
            >
            ["at0091"] = <
                text = <"Nei">
                description = <"Passer ikke.">
            >
            ["at0092"] = <
                text = <"Moderat">
                description = <"Tilstede i middels alvorlig grad.">
            >
            ["at0093"] = <
