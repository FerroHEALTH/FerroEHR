            ["ac9027"] = <
                text = <"Hvor stor tror du voldsrisikoen er for denne pasienten? (synthesised)">
                description = <"Samlet klinisk vurdering og iverksettelse av tiltak basert på V-RISK-Y, individuell klinisk vurdering, og annen tilgjengelig informasjon.  (synthesised)">
            >
            ["ac9013"] = <
                text = <"Umiddelbar iverksettelse av forebyggende tiltak (synthesised)">
                description = <" (synthesised)">
