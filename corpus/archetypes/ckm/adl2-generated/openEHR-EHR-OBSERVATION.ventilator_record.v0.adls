definition
    OBSERVATION[at0000] matches {    -- Ventilator record
        data matches {
            HISTORY[at0001] matches {
                events cardinality matches {1..*; unordered} matches {
                    EVENT[at0002] matches {    -- Any event
                        data matches {
                            ITEM_TREE[at0003] matches {
                                items cardinality matches {0..*; unordered} matches {
                                    ELEMENT[at0004] occurrences matches {0..1} matches {    -- Respiration rate
                                        value matches {
                                            DV_QUANTITY[at9007] matches {
                                                property matches {[at9000]}    -- Frequency
                                                units matches {"/min"}
                                            }
                                        }
                                        name matches {
                                            DV_CODED_TEXT[at9008] matches {
                                                defining_code matches {[ac9001]}    -- Respiration rate (synthesised)
                                            }
                                        }
                                    }
                                    ELEMENT[at0027] occurrences matches {0..1} matches {    -- Respiration type
                                        value matches {
                                            DV_CODED_TEXT[at9009] matches {
                                                defining_code matches {[ac9002]}    -- Respiration type (synthesised)
                                            }
                                        }
                                    }
                                    ELEMENT[at0020] occurrences matches {0..1} matches {    -- Inspiration/expiration (I/E) ratio
                                        value matches {
                                            DV_PROPORTION[at9010] matches {
                                                type matches {0}
                                            }
                                        }
                                    }
                                    ELEMENT[at0033] occurrences matches {0..1} matches {    -- Inspiration time
                                        value matches {
                                            DV_DURATION[at9011] matches {
                                                value matches {PTS/|>=PT0S|}
                                            }
                                        }
                                    }
                                    ELEMENT[at0034] occurrences matches {0..1} matches {    -- Expiration time
                                        value matches {
                                            DV_DURATION[at9012]
                                        }
                                    }
                                    ELEMENT[at0005] occurrences matches {0..1} matches {    -- Rapid shallow breathing index (RSBI)
                                        value matches {
                                            DV_QUANTITY[at9013] matches {
                                                property matches {[at9000]}    -- Frequency
                                                units matches {"/min/L"}
                                            }
                                        }
                                    }
                                    ELEMENT[at0006] occurrences matches {0..1} matches {    -- Lung compliance
                                        value matches {
                                            DV_QUANTITY[at9014] matches {
                                                property matches {[at9003]}    -- Acceleration
                                                units matches {"mL/cm[H2O]"}
                                            }
                                        }
                                    }
                                    ELEMENT[at0007] occurrences matches {0..1} matches {    -- End tidal CO2
                                        value matches {
                                            DV_QUANTITY[at9015] matches {
                                                property matches {[at9004]}    -- Pressure
                                                units matches {"mm[Hg]"}
                                            }
                                        }
                                    }
                                    ELEMENT[at0008] occurrences matches {0..1} matches {    -- Inspired CO2
                                        value matches {
                                            DV_QUANTITY[at9016] matches {
                                                property matches {[at9004]}    -- Pressure
                                                units matches {"mm[Hg]"}
                                            }
                                        }
                                    }
                                    ELEMENT[at0009] occurrences matches {0..1} matches {    -- End-Tidal N2O
                                        value matches {
                                            DV_PROPORTION[at9017] matches {
                                                numerator matches {|0.0..100.0|}
                                                type matches {2}
                                            }
                                        }
                                    }
                                    ELEMENT[at0011] occurrences matches {0..1} matches {    -- Inspired N2O
                                        value matches {
                                            DV_PROPORTION[at9018] matches {
                                                numerator matches {|0.0..100.0|}
                                                type matches {2}
                                            }
                                        }
                                    }
                                    ELEMENT[at0012] occurrences matches {0..1} matches {    -- End-tidal O2
                                        value matches {
                                            DV_PROPORTION[at9019] matches {
                                                numerator matches {|0.0..100.0|}
                                                type matches {2}
                                            }
                                        }
                                    }
                                    ELEMENT[at0017] occurrences matches {0..1} matches {    -- Positive end expiratory pressure (PEEP)
                                        value matches {
                                            DV_QUANTITY[at9020] matches {
                                                property matches {[at9004]}    -- Pressure
                                                units matches {"cm[H2O]"}
                                            }
                                        }
                                    }
                                    ELEMENT[at0013] occurrences matches {0..1} matches {    -- Inspired O2
                                        value matches {
                                            DV_PROPORTION[at9021] matches {
                                                numerator matches {|0.0..100.0|}
                                                type matches {2}
                                            }
                                        }
                                    }
                                    ELEMENT[at0019] occurrences matches {0..1} matches {    -- Negative inspiratory pressure (NIP)
                                        value matches {
                                            DV_QUANTITY[at9022] matches {
                                                property matches {[at9004]}    -- Pressure
                                                units matches {"cm[H2O]"}
                                            }
                                        }
                                    }
                                    ELEMENT[at0037] occurrences matches {0..1} matches {    -- Plateau inspiratory pressure
                                        value matches {
                                            DV_QUANTITY[at9023]
                                        }
                                    }
                                    ELEMENT[at0018] occurrences matches {0..1} matches {    -- Positive inspiratory pressure (PIP)
                                        value matches {
                                            DV_QUANTITY[at9024] matches {
                                                property matches {[at9004]}    -- Pressure
                                                units matches {"cm[H2O]"}
                                            }
                                        }
                                    }
                                    ELEMENT[at0021] occurrences matches {0..1} matches {    -- Tidal volume
                                        value matches {
                                            DV_QUANTITY[at9025] matches {
                                                property matches {[at9005]}    -- Volume
                                                units matches {"L"}
                                            }
                                        }
                                    }
                                    ELEMENT[at0022] occurrences matches {0..1} matches {    -- Peak inspiratory flow (PIF)
                                        value matches {
                                            DV_QUANTITY[at9026] matches {
                                                property matches {[at9006]}    -- Flow rate, volume
                                                units matches {"l/m"}
                                            }
                                        }
                                    }
                                    ELEMENT[at0023] occurrences matches {0..1} matches {    -- Peak expiratory flow (PEF)
                                        value matches {
                                            DV_QUANTITY[at9027] matches {
                                                property matches {[at9006]}    -- Flow rate, volume
                                                units matches {"l/m"}
                                            }
                                        }
                                    }
                                    ELEMENT[at0024] occurrences matches {0..1} matches {    -- Flow minute volume (MV)
                                        value matches {
                                            DV_QUANTITY[at9028] matches {
                                                property matches {[at9006]}    -- Flow rate, volume
                                                units matches {"l/m"}
                                            }
                                        }
                                    }
                                    ELEMENT[at0032] occurrences matches {0..1} matches {    -- Tidal volume (TV)
                                        value matches {
                                            DV_QUANTITY[at9029] matches {
                                                property matches {[at9005]}    -- Volume
                                                units matches {"ml"}
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        protocol matches {
            ITEM_TREE[at0010] matches {
                items cardinality matches {0..*; unordered} matches {
                    allow_archetype CLUSTER[at0038] matches {    -- Extension
                        include
                            archetype_id/value matches {/.*/}
                    }
                }
            }
        }
    }

