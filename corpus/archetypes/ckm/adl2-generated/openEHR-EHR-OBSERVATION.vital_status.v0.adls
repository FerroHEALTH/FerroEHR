archetype (adl_version=2.4.0; rm_release=1.1.0; generated; uid=8af8d91c-6ed1-4f4f-b1c3-9715e915cfb3; build_uid=f89140e0-d746-48d1-ab20-629a6beba148)
    openEHR-EHR-OBSERVATION.vital_status.v0.0.1-alpha

language
    original_language = <[ISO_639-1::en]>

description
    original_author = <
        ["name"] = <"Heather Leslie">
        ["organisation"] = <"Atomica Informatics">
        ["email"] = <"heather.leslie@atomicainformatics.com">
        ["date"] = <"2022-09-20">
    >
    original_namespace = <"org.openehr">
    original_publisher = <"openEHR Foundation">
    lifecycle_state = <"in_development">
    custodian_namespace = <"org.openehr">
