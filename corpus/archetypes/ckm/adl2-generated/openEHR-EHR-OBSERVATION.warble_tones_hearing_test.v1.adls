            keywords = <"السماع", "اللُّحمَوية", "النغمات">
            use = <"لتقييم العتبات السمعية للمرضى الذين تترواح أعمارهم ما بين سبعة أشهر و ثمانية عشرا شهرا">
            misuse = <"">
