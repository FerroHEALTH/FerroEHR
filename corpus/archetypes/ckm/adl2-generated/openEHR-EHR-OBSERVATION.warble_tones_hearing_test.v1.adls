definition
    OBSERVATION[at0000] matches {    -- Warble Tones Hearing Test
        data matches {
            HISTORY[at0001] matches {
                events cardinality matches {1..*; unordered} matches {
                    EVENT[at0002] occurrences matches {0..1} matches {    -- Any event
                        data matches {
                            ITEM_TREE[at0003] matches {
                                items cardinality matches {0..*; unordered} matches {
                                    ELEMENT[at0004] occurrences matches {0..1} matches {    -- Side
                                        value matches {
                                            DV_CODED_TEXT[at9011] matches {
                                                defining_code matches {[ac9000]}    -- Side (synthesised)
                                            }
                                        }
                                    }
                                    CLUSTER[at0018] occurrences matches {0..1} matches {    -- Details
                                        items cardinality matches {1..*; unordered} matches {
                                            ELEMENT[at0017] occurrences matches {0..1} matches {    -- Frequency
                                                value matches {
                                                    DV_QUANTITY[at9012] matches {
                                                        property matches {[at9001]}    -- Frequency
                                                        [units] matches {
                                                            [{"Hz"}],
                                                            [{"kHz"}]
                                                        }
                                                    }
                                                    DV_CODED_TEXT[at9013] matches {
                                                        defining_code matches {[ac9002]}    -- Frequency (synthesised)
                                                    }
                                                }
                                            }
                                            ELEMENT[at0020] occurrences matches {0..1} matches {    -- Hearing Threshold
                                                value matches {
                                                    DV_QUANTITY[at9014] matches {
                                                        property matches {[at9003]}    -- Loudness
                                                        units matches {"dB"}
                                                    }
                                                }
                                            }
                                            ELEMENT[at0019] occurrences matches {0..1} matches {    -- Response
                                                value matches {
                                                    DV_CODED_TEXT[at9015] matches {
                                                        defining_code matches {[ac9004]}    -- Response (synthesised)
                                                    }
                                                }
                                            }
                                            ELEMENT[at0024] occurrences matches {0..1} matches {    -- Image
                                                value matches {
                                                    DV_MULTIMEDIA[at9016] matches {
                                                        media_type matches {[ac9010]}    -- Image (synthesised)
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0025] occurrences matches {0..1} matches {    -- Reliability
                                        value matches {
                                            DV_TEXT[at9017]
                                        }
                                    }
                                    ELEMENT[at0023] occurrences matches {0..1} matches {    -- Comment
                                        value matches {
                                            DV_TEXT[at9018]
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

