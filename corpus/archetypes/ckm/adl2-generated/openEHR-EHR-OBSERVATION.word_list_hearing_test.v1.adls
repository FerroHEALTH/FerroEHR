definition
    OBSERVATION[at0000] matches {    -- Word List Hearing Test
        data matches {
            HISTORY[at0001] matches {
                events cardinality matches {1..*; unordered} matches {
                    EVENT[at0002] occurrences matches {0..1} matches {    -- Any event
                        data matches {
                            ITEM_TREE[at0003] matches {
                                items cardinality matches {0..*; unordered} matches {
                                    ELEMENT[at0014] occurrences matches {0..1} matches {    -- Test
                                        value matches {
                                            DV_CODED_TEXT[at9011] matches {
                                                defining_code matches {[ac9000]}    -- Test (synthesised)
                                            }
                                        }
                                    }
                                    CLUSTER[at0011] occurrences matches {0..1} matches {    -- Result
                                        items cardinality matches {1..*; unordered} matches {
                                            ELEMENT[at0012] occurrences matches {0..1} matches {    -- Success rate
                                                value matches {
                                                    DV_QUANTITY[at9012] matches {
                                                        property matches {[at9001]}    -- Proportion
                                                        units matches {"%"}
                                                    }
                                                }
                                            }
                                            ELEMENT[at0013] occurrences matches {0..1} matches {    -- Audible Sound level
                                                value matches {
                                                    DV_QUANTITY[at9013] matches {
                                                        property matches {[at9002]}    -- Loudness
                                                        units matches {"dB"}
                                                    }
                                                }
                                            }
                                            ELEMENT[at0017] occurrences matches {0..1} matches {    -- New element
                                                value matches {
                                                    DV_MULTIMEDIA[at9014] matches {
                                                        media_type matches {[ac9008]}    -- New element (synthesised)
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0018] occurrences matches {0..1} matches {    -- Comment
                                        value matches {
                                            DV_TEXT[at9015]
                                        }
                                    }
                                }
                            }
                        }
                        state matches {
                            ITEM_LIST[at0004] matches {
                                items cardinality matches {0..*; unordered} matches {
                                    ELEMENT[at0005] occurrences matches {0..1} matches {    -- Occlusion
                                        value matches {
                                            DV_CODED_TEXT[at9016] matches {
                                                defining_code matches {[ac9009]}    -- Occlusion (synthesised)
                                            }
                                        }
                                    }
                                    ELEMENT[at0008] occurrences matches {0..1} matches {    -- Lip reading
                                        value matches {
                                            DV_CODED_TEXT[at9017] matches {
                                                defining_code matches {[ac9010]}    -- Lip reading (synthesised)
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

