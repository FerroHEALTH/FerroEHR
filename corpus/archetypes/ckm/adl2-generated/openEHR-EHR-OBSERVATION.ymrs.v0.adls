    details = <
        ["sv"] = <
            language = <[ISO_639-1::sv]>
            purpose = <"Att uppskatta och registrera allvarlighetsgrad av manisk episod.">
            keywords = <"YMRS", "Young Mania Rating Scale", "DSM", "mani", "hypomani", "psykiatri">
            use = <"Använd för att uppskatta och registrera allvarlighetsgrad av manisk episod.

Young Mania Rating Scale (YMRS) används för att uppskatta allvarlighetsgrad av manisk episod. Formuläret består av elva frågor och klinikern värderar patientens svar på en skala. Varje svar bidrar med poäng till totala summan vilken uppgår till maximalt 60p.

- Förhöjt stämningsläge
- Ökad motorisk aktivitet
- Sexuellt intresse
- Sömn
- Irritabilitet
- Tal (flöde och mängd)
- Språk-/och tankestörning
- Tankeinnehåll
- Aggressivitet
- Yttre
- Insikt

Tolkning av resultat:
14-19 poäng indikerar hypomani
20-30 poäng indikerar medelsvår mani
>30 poäng indikerar svår mani">
            misuse = <"">
            copyright = <"© Cambio Healthcare Systems, openEHR Foundation">
        >
        ["en"] = <
            language = <[ISO_639-1::en]>
            purpose = <"To assess and record the severity of a manic episode.">
            keywords = <"YMRS", "Young Mania Rating Scale", "mania", "hypomania", "DSM", "psychiatry">
            use = <"Use as a tool to assess and record the severity of a manic episode.

The questionnaire consists of eleven items which the clinician rates based on the assessment of the patients current condition during the course of the interview. Each contributes points to the total score which ranges from 0-60. 

- Elevated mood
- Increased motor activity-energy
- Sexual interest
- Sleep
- Irritability
- Speech (rate and amount)
- Language-thought disorder
- Content
- Disruptive-aggressive behaviour
- Appearance
- Insight

Score interpretation:
14-19 points indicate hypomania
20-30 points indicate moderate mania
>30 points indicate severe mania.">
            misuse = <"">
            copyright = <"© Cambio Healthcare Systems, openEHR Foundation">
        >
    >

definition
    OBSERVATION[at0000] matches {    -- Young Mania Rating Scale (YMRS)
        data matches {
            HISTORY[at0001] matches {
                events cardinality matches {1..*; unordered} matches {
                    EVENT[at0002] matches {    -- Any event
                        data matches {
                            ITEM_TREE[at0003] matches {
                                items cardinality matches {0..*; unordered} matches {
                                    ELEMENT[at0004] occurrences matches {0..1} matches {    -- Elevated mood
                                        value matches {
                                            DV_ORDINAL[at9011] matches {
                                                [value, symbol] matches {
                                                    [{0}, {[at0016]}],    -- Absent
                                                    [{1}, {[at0017]}],    -- Mildly or possibly increased on questioning
                                                    [{2}, {[at0018]}],    -- Definite subjective elevation; optimistic, self-confident; cheerful; appropriate to content
                                                    [{3}, {[at0019]}],    -- Elevated, inappropriate to content; humorous
                                                    [{4}, {[at0020]}]    -- Euphoric; inappropriate laughter; singing
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0005] occurrences matches {0..1} matches {    -- Increased motor activity-energy
                                        value matches {
                                            DV_ORDINAL[at9012] matches {
                                                [value, symbol] matches {
                                                    [{0}, {[at0021]}],    -- Absent
                                                    [{1}, {[at0022]}],    -- Subjectively increased
                                                    [{2}, {[at0023]}],    -- Animated; gestures increased
                                                    [{3}, {[at0024]}],    -- Excessive energy; hyperactive at times; restless (can be calmed)
                                                    [{4}, {[at0025]}]    -- Motor excitement; continuous hyperactivity (cannot be calmed)
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0006] occurrences matches {0..1} matches {    -- Sexual interest
                                        value matches {
                                            DV_ORDINAL[at9013] matches {
                                                [value, symbol] matches {
                                                    [{0}, {[at0026]}],    -- Normal; not increased
                                                    [{1}, {[at0027]}],    -- Mildly or possibly increased
                                                    [{2}, {[at0028]}],    -- Definite subjective increase on questioning
                                                    [{3}, {[at0029]}],    -- Spontaneous sexual content; elaborates on sexual matters; hypersexual by self-report
                                                    [{4}, {[at0030]}]    -- Overt sexual acts (toward patients, staff or interviewer)
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0007] occurrences matches {0..1} matches {    -- Sleep
                                        value matches {
                                            DV_ORDINAL[at9014] matches {
                                                [value, symbol] matches {
                                                    [{0}, {[at0031]}],    -- Reports no decrease in sleep
                                                    [{1}, {[at0032]}],    -- Sleeping less than normal amount by up to one hour
                                                    [{2}, {[at0033]}],    -- Sleeping less than normal by more than one hour
                                                    [{3}, {[at0034]}],    -- Reports decreased need for sleep
                                                    [{4}, {[at0035]}]    -- Denies need for sleep
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0008] occurrences matches {0..1} matches {    -- Irritability
                                        value matches {
                                            DV_ORDINAL[at9015] matches {
                                                [value, symbol] matches {
                                                    [{0}, {[at0036]}],    -- Absent
                                                    [{2}, {[at0037]}],    -- Subjectively increased
                                                    [{4}, {[at0038]}],    -- Irritable at times during interview; recent episodes of anges or annoyance on ward
                                                    [{6}, {[at0039]}],    -- Frequently irritable during interview; short, curt throughout
                                                    [{8}, {[at0040]}]    -- Hostile, unco-operative; interview impossible
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0009] occurrences matches {0..1} matches {    -- Speech (rate and amount)
                                        value matches {
                                            DV_ORDINAL[at9016] matches {
                                                [value, symbol] matches {
                                                    [{0}, {[at0041]}],    -- No increase
                                                    [{2}, {[at0042]}],    -- Feels talkative
                                                    [{4}, {[at0043]}],    -- Increased rate or amount at times, verbose at times
                                                    [{6}, {[at0044]}],    -- Push; consistently increased rate and amount; difficult to interrupt
                                                    [{8}, {[at0045]}]    -- Pressured; uninterruptible, continuous speech
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0010] occurrences matches {0..1} matches {    -- Language - thought disorder
                                        value matches {
                                            DV_ORDINAL[at9017] matches {
                                                [value, symbol] matches {
                                                    [{0}, {[at0046]}],    -- Absent
                                                    [{1}, {[at0047]}],    -- Circumstantial; mild distractibility; quick thoughts
                                                    [{2}, {[at0048]}],    -- Distractible; loses goal of thought; changes topics frequently; racing thoughts
                                                    [{3}, {[at0049]}],    -- Flight of ideas; tangentiality; difficult to follow; rhyming, echolalia
                                                    [{4}, {[at0050]}]    -- Incoherent; communication impossible
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0011] occurrences matches {0..1} matches {    -- Content
                                        value matches {
                                            DV_ORDINAL[at9018] matches {
                                                [value, symbol] matches {
                                                    [{0}, {[at0051]}],    -- Normal
                                                    [{2}, {[at0052]}],    -- Questionable plans, new interests
                                                    [{4}, {[at0053]}],    -- Special project(s); hyperreligous
                                                    [{6}, {[at0054]}],    -- Grandiose or paranoid ideas; ideas of reference
                                                    [{8}, {[at0055]}]    -- Delusions; hallucinations
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0012] occurrences matches {0..1} matches {    -- Disruptive-aggressive behaviour
                                        value matches {
                                            DV_ORDINAL[at9019] matches {
                                                [value, symbol] matches {
                                                    [{0}, {[at0056]}],    -- Absent
                                                    [{2}, {[at0057]}],    -- Sarcastic; loud at times, guarded
                                                    [{4}, {[at0058]}],    -- Demanding; threats on ward
                                                    [{6}, {[at0059]}],    -- Threatens interviewer; shouting; interview difficult
                                                    [{8}, {[at0060]}]    -- Assaultive; destructive; interview impossible
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0013] occurrences matches {0..1} matches {    -- Appearance
                                        value matches {
                                            DV_ORDINAL[at9020] matches {
                                                [value, symbol] matches {
                                                    [{0}, {[at0061]}],    -- Appropriate dress and grooming
                                                    [{1}, {[at0062]}],    -- Minimally unkempt
                                                    [{2}, {[at0063]}],    -- Poorly groomed; moderately dishevelled; overdressed
                                                    [{3}, {[at0064]}],    -- Dishevelled; partly clothed; garish make-up
                                                    [{4}, {[at0065]}]    -- Completely unkempt; decorated; bizarre garb
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0014] occurrences matches {0..1} matches {    -- Insight
                                        value matches {
                                            DV_ORDINAL[at9021] matches {
                                                [value, symbol] matches {
                                                    [{0}, {[at0066]}],    -- Present; admits illness; agrees with need for treatment
                                                    [{1}, {[at0067]}],    -- Possibly ill
                                                    [{2}, {[at0068]}],    -- Admits behaviour change, but denies illness
                                                    [{3}, {[at0069]}],    -- Admits possible change in behaviour, but denies illness
                                                    [{4}, {[at0070]}]    -- Denies any behaviour change
                                                }
                                            }
                                        }
                                    }
                                    ELEMENT[at0015] occurrences matches {0..1} matches {    -- Total score
                                        value matches {
                                            DV_COUNT[at9022] matches {
                                                magnitude matches {|0..60|}
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        protocol matches {
            ITEM_TREE[at0071] matches {
                items cardinality matches {0..*; unordered} matches {
                    allow_archetype CLUSTER[at0072] matches {    -- Extension
                        include
                            archetype_id/value matches {/.*/}
                    }
                }
            }
        }
    }

