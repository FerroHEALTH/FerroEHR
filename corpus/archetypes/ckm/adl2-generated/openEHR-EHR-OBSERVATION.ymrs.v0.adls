                description = <"*">
            >
            ["at0064"] = <
                text = <"Vanvårdad; delvis oklädd; uppseendeväckande smink">
                description = <"*">
            >
            ["at0065"] = <
                text = <"Svårt vanvårdad; bisarr klädsel, smink">
                description = <"*">
            >
            ["at0066"] = <
                text = <"Insiktsfull; medger sjukdom och behov av behandling">
                description = <"*">
            >
            ["at0067"] = <
                text = <"Medger möjlig sjukdom">
                description = <"*">
            >
