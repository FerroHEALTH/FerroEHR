  <ontology>
    <term_definitions language="en">
      <items code="at0000">
        <items id="text">Citizenship</items>
        <items id="description">A record of the individual’s legal citizenship status, identifying the state or states of which the individual is a citizen.</items>
        <items id="comment">While "citizenship" and "nationality" can differ in some legal contexts, they are often used interchangeably in practice. In this archetype, the term "citizenship" is used.</items>
      </items>
      <items code="at0001">
        <items id="text">Item tree</items>
        <items id="description">@ internal @</items>
      </items>
      <items code="at0004">
        <items id="text">Valid from</items>
        <items id="description">When the citizenship started.</items>
      </items>
      <items code="at0005">
        <items id="text">Valid to</items>
        <items id="description">When the citizenship ended.</items>
      </items>
      <items code="at0006">
        <items id="text">Current?</items>
        <items id="description">The status of the citizenship.</items>
      </items>
      <items code="at0007">
        <items id="text">Information source</items>
        <items id="description">The source of information of the citizenship.</items>
        <items id="comment">Use free text to describe other sources of information of the citizenship.</items>
      </items>
      <items code="at0008">
        <items id="text">Current</items>
        <items id="description">Current citizenship.</items>
      </items>
      <items code="at0009">
        <items id="text">Previous</items>
        <items id="description">Previous citizenship.</items>
      </items>
      <items code="at0010">
        <items id="text">Self-reported</items>
        <items id="description">Information provided directly by the individual.</items>
      </items>
      <items code="at0011">
        <items id="text">Document-based</items>
        <items id="description">For example passport or other official documents.</items>
      </items>
      <items code="at0012">
        <items id="text">Registry-based</items>
        <items id="description">For example a national population register.</items>
      </items>
      <items code="at0014">
        <items id="text">Comment</items>
        <items id="description">Additional narrative about the specific citizenship, not captured in other fields.</items>
      </items>
      <items code="at0016">
        <items id="text">Specific citizenship</items>
        <items id="description">Details about a specific current or former citizenship held by the individual.</items>
        <items id="comment">Multiple citizenships can be recorded by repeating this cluster.</items>
      </items>
      <items code="at0017">
        <items id="text">Status</items>
        <items id="description">The status of the individual's citizenship.</items>
      </items>
      <items code="at0018">
        <items id="text">Citizen</items>
        <items id="description">The individual is legally recognized as a citizen by at least one state.</items>
      </items>
      <items code="at0019">
        <items id="text">Stateless</items>
        <items id="description">The individual is not legally recognized as a citizen by any state.</items>
      </items>
      <items code="at0020">
        <items id="text">Unknown</items>
        <items id="description">The individual’s citizenship is unknown.</items>
      </items>
      <items code="at0022">
        <items id="text">Additional details</items>
        <items id="description">Additional structured details about citizenship status.</items>
      </items>
      <items code="at0023">
        <items id="text">Last updated</items>
        <items id="description">The date the citizenship details were last updated.</items>
      </items>
      <items code="at0028">
        <items id="text">Information source details</items>
        <items id="description">Additional structured details about the source of the specific citizenship.</items>
      </items>
      <items code="at0029">
        <items id="text">Overall comment</items>
        <items id="description">Additional narrative about citizenship, not captured in other fields.</items>
      </items>
      <items code="at0030">
        <items id="text">Country</items>
        <items id="description">The country of the citizenship.</items>
        <items id="comment">Coding with an external terminology is preferred, where possible, for example ISO 3166-1 alpha-2.</items>
      </items>
    </term_definitions>
    <term_definitions language="nb">
      <items code="at0000">
        <items id="text">Statsborgerskap</items>
        <items id="description">En registrering av personens juridiske statsborgerskap, som identifiserer hvilken stat eller hvilke stater personen er statsborger i.</items>
      </items>
      <items code="at0001">
        <items id="text">Item tree</items>
        <items id="description">@ internal @</items>
      </items>
      <items code="at0004">
        <items id="text">Gyldig fra</items>
        <items id="description">Starten på statsborgerskap.</items>
      </items>
      <items code="at0005">
        <items id="text">Gyldig til</items>
        <items id="description">Slutten på statsborgerskap.</items>
      </items>
      <items code="at0006">
        <items id="text">Nåværende?</items>
        <items id="description">Tidsstatus for registrert statsborgerskap.</items>
      </items>
      <items code="at0007">
        <items id="text">Informasjonskilde</items>
        <items id="description">Opplysningskilde for statsborgerskap.</items>
        <items id="comment">Bruk fritekst til å beskrive andre opplysningskilder for statsborgerskap.</items>
      </items>
      <items code="at0008">
        <items id="text">Nåværende</items>
        <items id="description">Nåværende statsborger.</items>
      </items>
      <items code="at0009">
        <items id="text">Tidligere</items>
        <items id="description">Tidligere statsborger.</items>
      </items>
      <items code="at0010">
        <items id="text">Selvrapportert</items>
        <items id="description">Informasjon oppgitt direkte av personen.</items>
      </items>
      <items code="at0011">
        <items id="text">Dokumentbasert</items>
        <items id="description">For eksempel pass eller andre offisielle dokumenter.</items>
      </items>
      <items code="at0012">
        <items id="text">Registerbasert</items>
        <items id="description">For eksempel et nasjonalt folkeregister.</items>
      </items>
      <items code="at0014">
        <items id="text">Kommentar</items>
        <items id="description">Ytterligere fritekst om det spesifikke statsborgerskapet som ikke er registrert i andre felt.</items>
      </items>
      <items code="at0016">
        <items id="text">Spesifikt statsborgerskap</items>
        <items id="description">Detaljer om nåværende og/eller tidligere statsborgerskap som personen har hatt.</items>
      </items>
      <items code="at0017">
        <items id="text">Status</items>
        <items id="description">Juridisk statsborgerskapsstatus.</items>
      </items>
      <items code="at0018">
        <items id="text">Statsborger</items>
        <items id="description">Personen er juridisk anerkjent som statsborger av minst én stat.</items>
      </items>
      <items code="at0019">
        <items id="text">Statsløs</items>
        <items id="description">Personen er ikke anerkjent som statsborger av noen stat.</items>
      </items>
      <items code="at0020">
        <items id="text">Ukjent</items>
        <items id="description">Personens statsborgerskap er ukjent.</items>
      </items>
      <items code="at0022">
        <items id="text">Ytterligere detaljer</items>
        <items id="description">Ytterligere detaljer om statsborgerskapsstatus.</items>
      </items>
      <items code="at0023">
        <items id="text">Sist oppdatert</items>
        <items id="description">Datoen statsborgerskap sist ble oppdatert.</items>
      </items>
      <items code="at0028">
        <items id="text">Detaljer om informasjonskilde</items>
        <items id="description">Ytterligere detaljer om kilde til det spesifikke statsborgerskapet.</items>
      </items>
      <items code="at0029">
        <items id="text">Generell kommentar</items>
        <items id="description">Ytterligere fritekst om statsborgerskap som ikke er registrert i andre felt.</items>
      </items>
      <items code="at0030">
        <items id="text">Land</items>
        <items id="description">Landet for statsborgerskap.</items>
        <items id="comment">Koding med en ekstern terminologi bør brukes der det er mulig, for eksempel ISO 3166-1 alpha-2.</items>
      </items>
    </term_definitions>
  </ontology>
</archetype>
