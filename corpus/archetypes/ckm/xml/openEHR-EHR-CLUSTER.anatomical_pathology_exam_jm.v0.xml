  <ontology>
    <term_definitions language="en">
      <items code="at0000">
        <items id="text">Anatomical pathology examination</items>
        <items id="description">A generic framework for findings observed during the histopathological or cytopathological examination of organs, tissues, cells, or body fluids using gross, microscopic, and ancillary testing methods.</items>
      </items>
      <items code="at0009">
        <items id="text">Examination findings</items>
        <items id="description">Structured details about the anatomical pathology examination findings.</items>
      </items>
      <items code="at0011">
        <items id="text">Comment</items>
        <items id="description">Additional narrative about the anatomical pathology examination findings, not captured in other fields.</items>
      </items>
      <items code="at0022">
        <items id="text">Multimedia representation</items>
        <items id="description">Digital image, video or diagram representing the anatomical pathology examination.</items>
        <items id="comment">Multiple formats are allowed but they should represent equivalent clinical content.</items>
      </items>
      <items code="at0025">
        <items id="text">Microscopic description</items>
        <items id="description">Narrative summary of findings observed under the microscope.</items>
      </items>
      <items code="at0026">
        <items id="text">Clinical interpretation</items>
        <items id="description">Single word, phrase or brief description that represents the clinical meaning and significance of the anatomical pathology examination for the identified specimen.</items>
        <items id="comment">For example: 'No abnormality detected' or 'Moderate inflammation present'. Coding of the 'Clinical interpretation' with a terminology is preferred, where possible.</items>
      </items>
      <items code="at0027">
        <items id="text">Specimen</items>
        <items id="description">Details about the specimen examined.</items>
        <items id="comment">For example, the ID of the specimen or a macroscopic description of the specimen being examined.</items>
      </items>
      <items code="at0028">
        <items id="text">Examination not done</items>
        <items id="description">Details to explicitly record that this examination was not performed.</items>
      </items>
    </term_definitions>
