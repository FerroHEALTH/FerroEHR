  <ontology>
    <term_definitions language="en">
      <items code="at0000">
        <items id="text">Auscultation of lung</items>
        <items id="description">Findings observed during the auscultation of a lung structure.</items>
      </items>
      <items code="at0001">
        <items id="text">Lung structure examined</items>
        <items id="description">Identification of the lung structure under auscultation.</items>
        <items id="comment">For example: both lungs together; left lung; or right upper lobe. This data element should be coded using a terminology, if available. If the structure of the lung being examined has previously been identified in another archetype in which this archetype is nested, this data element becomes redundant.</items>
      </items>
      <items code="at0002">
        <items id="text">No abnormality detected</items>
        <items id="description">Statement that no abnormality was detected (NAD) on physical examination.</items>
        <items id="comment">Record as True if no abnormality was detected on examination. Specific statements about the examination can be included in the 'Clinical Interpretation' data element.</items>
      </items>
      <items code="at0003">
        <items id="text">Clinical description</items>
        <items id="description">Narrative description of the overall findings observed during the physical examination.</items>
      </items>
      <items code="at0005">
        <items id="text">Multimedia representation</items>
        <items id="description">Audio file representing the physical examination findings.</items>
      </items>
      <items code="at0006">
        <items id="text">Clinical interpretation</items>
        <items id="description">Single word, phrase or brief description that represents the clinical meaning and significance of the physical examination findings.</items>
      </items>
      <items code="at0007">
        <items id="text">Comment</items>
        <items id="description">Additional narrative about the physical examination findings, not captured in other fields.</items>
      </items>
      <items code="at0008">
        <items id="text">Exam not done</items>
        <items id="description">Details to explicitly record that this examination was not performed.</items>
      </items>
    </term_definitions>
    <term_definitions language="nb">
      <items code="at0000">
        <items id="text">*Auscultation of lung(en)</items>
        <items id="description">*Findings observed during the auscultation of a lung structure.(en)</items>
      </items>
      <items code="at0001">
        <items id="text">*Lung structure examined(en)</items>
        <items id="description">*Identification of the lung structure under auscultation.(en)</items>
        <items id="comment">*For example: both lungs together; left lung; or right upper lobe. This data element should be coded using a terminology, if available. If the structure of the lung being examined has previously been identified in another archetype in which this archetype is nested, this data element becomes redundant.(en)</items>
      </items>
      <items code="at0002">
        <items id="text">Uten anmerkning</items>
        <items id="description">Konstatering at funn ved undersøkelse ikke viste noe unormalt.</items>
        <items id="comment">Dokumenter som Sann dersom intet unormalt ble funnet ved undersøkelse. Spesifikke uttalelser vedrørende undersøkelse kan bli inkludert i dataelementet "klinisk interpretasjon".</items>
      </items>
      <items code="at0003">
        <items id="text">Klinisk beskrivelse</items>
        <items id="description">En tekstlig beskrivelse av samlete funn observert ved den fysiske undersøkelsen.</items>
      </items>
      <items code="at0005">
        <items id="text">Multimedia representasjon</items>
        <items id="description">Digitale bilder, video eller diagram som representerer funnene ved klinisk undersøkelse.</items>
      </items>
      <items code="at0006">
        <items id="text">Klinisk interpretasjon</items>
        <items id="description">Enkelt ord, frase eller kort beskrivelse som representerer klinisk betydning og signifikans av funnene ved klinisk undersøkelse.</items>
      </items>
      <items code="at0007">
        <items id="text">Kommentar</items>
        <items id="description">Tekstlig tilleggsinformasjon vedrørende klinisk undersøkelse, som ikke er fanget opp i de andre dataelementene.</items>
      </items>
      <items code="at0008">
        <items id="text">Undersøkelse ikke gjennomført</items>
        <items id="description">Detaljer for å dokumentere eksplisitt at undersøkelsen ikke er gjennomført.</items>
      </items>
    </term_definitions>
  </ontology>
</archetype>
