    <details>
      <language>
        <terminology_id>
          <value>ISO_639-1</value>
        </terminology_id>
        <code_string>de</code_string>
      </language>
      <purpose>Zur Darstellung von Informationen über einen externen Lagerungsort, wo menschliche Proben oder Gewebeproben aufbewahrt/gelagert werden.</purpose>
      <keywords>Lagerung</keywords>
      <keywords>Biobank</keywords>
      <keywords>Biologische Datenbank</keywords>
      <use>Verwenden Sie diesen Archetyp, um Informationen über ein externes Lager, in dem sich menschliche Proben oder Gewebeproben befinden, darzustellen.&#xD;
&#xD;
Zu den Anwendungsfällen gehören:&#xD;
- Blut und Hautgewebe zur autologen Verwendung oder Spende;&#xD;
- Zelllinien;&#xD;
- gefrorenes Sperma, Eizellen und Embryonen im Rahmen der Behandlung der assistierten Reproduktion;&#xD;
- Muttermilch zur Spende und&#xD;
- biologische Proben und Biomaterial für Forschungszwecke.</use>
      <misuse />
      <copyright />
    </details>
    <details>
      <language>
        <terminology_id>
          <value>ISO_639-1</value>
        </terminology_id>
        <code_string>nb</code_string>
      </language>
      <purpose>For å registrere informasjon om et ekstern biologisk lager/biobank som inneholder humant biologisk materiale.</purpose>
      <keywords>biolager</keywords>
      <keywords>biorepository</keywords>
      <keywords>biologisk database</keywords>
      <keywords>depot</keywords>
      <use>Brukes for å registrere informasjon om et ekstern biologisk lager/biobank som inneholder humant biologisk materiale.&#xD;
&#xD;
Brukstilfeller inkluderer:&#xD;
- blod og hudvev for autolog bruk eller donasjon;&#xD;
- cellelinjer;&#xD;
- nedfrosset sæd, oocytter og embryoer som en del av assistert reproduksjonsbehandling;&#xD;
- morsmelk for donasjon; og&#xD;
- biologiske prøver og biologisk prøvemateriale til forskning.</use>
      <misuse />
      <copyright />
    </details>
    <details>
      <language>
        <terminology_id>
          <value>ISO_639-1</value>
        </terminology_id>
        <code_string>en</code_string>
      </language>
      <purpose>To record information about an external storage repository holding human specimens or tissue samples.</purpose>
      <keywords>storage</keywords>
      <keywords>biorepository</keywords>
      <keywords>Biological database</keywords>
      <use>Use to record information about an external storage repository holding human specimens or tissue samples.&#xD;
&#xD;
Use cases include:&#xD;
- blood and skin tissue for autologous use or donation;&#xD;
- cell lines;&#xD;
- frozen semen, oocytes and embryos as part of assisted reproduction treatment;&#xD;
- breast milk for donation; and&#xD;
- biological samples and biomaterial for research.</use>
      <misuse />
      <copyright>© openEHR Foundation</copyright>
    </details>
