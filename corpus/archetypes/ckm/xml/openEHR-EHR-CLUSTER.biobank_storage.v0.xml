  <ontology>
    <term_definitions language="en">
      <items code="at0000">
        <items id="text">Biobank storage</items>
        <items id="description">Storage repository for human biological material and associated information.</items>
      </items>
      <items code="at0001">
        <items id="text">Biobank name</items>
        <items id="description">Name of the specimen, biospecimen or tissue repository.</items>
      </items>
      <items code="at0002">
        <items id="text">Biobank ID</items>
        <items id="description">Identifier of the biobank/storage or tissue establishment.</items>
        <items id="comment">Use of an established biobank classification is preferred, e.g. the EU Tissue Establishment Compendium.</items>
      </items>
      <items code="at0003">
        <items id="text">Sample ID</items>
        <items id="description">Identifier of the specimen, biospecimen or tissue stored in the biobank/storage.</items>
      </items>
      <items code="at0004">
        <items id="text">Biobank details</items>
        <items id="description">Details about the organisation or location of the biobank/storage.</items>
      </items>
      <items code="at0005">
        <items id="text">Donor ID</items>
        <items id="description">Identifier of the human source of the specimen, biospecimen or tissue sample.</items>
        <items id="comment">For example: the tissue donor ID, or the donor ID for both the egg donor and the sperm donor to an embryo.</items>
      </items>
      <items code="at0006">
        <items id="text">Comment</items>
        <items id="description">Additional narrative about the biobank, not captured in other fields.</items>
      </items>
      <items code="at0007">
        <items id="text">Additional details</items>
        <items id="description">Additional structured details related to the biobank storage.</items>
      </items>
      <items code="at0008">
        <items id="text">Contents</items>
        <items id="description">The contents of this biobank/storage.</items>
        <items id="comment">For example: specimen or a specimen container.</items>
      </items>
    </term_definitions>
    <term_definitions language="nb">
      <items code="at0000">
        <items id="text">Biobank</items>
        <items id="description">Lagringssted for humant biologisk materiale og dens tilhørende informasjon.</items>
      </items>
      <items code="at0001">
        <items id="text">Biobank navn</items>
        <items id="description">Navnet til det biologisk lageret/biobanken som inneholder det biologiske prøvematerialet.</items>
      </items>
      <items code="at0002">
        <items id="text">Biobank ID</items>
        <items id="description">Identifikator for det biologisk lageret/biobanken.</items>
        <items id="comment">Bruk av etablert biobankklassifisering foretrekkes, f.eks. EU Tissue Establishment Compendium.</items>
      </items>
      <items code="at0003">
        <items id="text">Prøvemateriale ID</items>
        <items id="description">Identifikator for prøvematerialet eller vevet som er lagret i det biologiske lageret/biobanken.</items>
      </items>
      <items code="at0004">
        <items id="text">Biobank detaljer</items>
        <items id="description">Detaljer om organisering eller plassering av lageret/biobanken.</items>
      </items>
      <items code="at0005">
        <items id="text">Donor ID</items>
        <items id="description">Identifikator til den humane kilden til det biologiske prøvematerialet.</items>
        <items id="comment">For eksempel: IDen til vevsdonoren eller IDen til både eggdonor og sæddonor til et embryo.</items>
      </items>
      <items code="at0006">
        <items id="text">Kommentar</items>
        <items id="description">Ytterligere kommentarer om det biologiske materialet/biobanken som ikke passer i andre felter.</items>
      </items>
      <items code="at0007">
        <items id="text">Ytterligere detaljer</items>
        <items id="description">Ytterligere strukturerte detaljer om biobanken / biologiske lageret.</items>
      </items>
      <items code="at0008">
        <items id="text">Innhold</items>
        <items id="description">Inneholdet i lageret/biobanken.</items>
        <items id="comment">For eksempel et prøvemateriale eller en prøvebeholder.</items>
      </items>
    </term_definitions>
    <term_definitions language="de">
      <items code="at0000">
        <items id="text">Biobank-Lagerung</items>
        <items id="description">Aufbewahrungsort für menschliches biologisches Material und zugehörige Informationen.</items>
      </items>
      <items code="at0001">
        <items id="text">Biobank-Name</items>
        <items id="description">Name der Probe-, Bioprobe- oder des Gewebelagers.</items>
      </items>
      <items code="at0002">
        <items id="text">Biobank-ID</items>
        <items id="description">Kennung der Biobank/Lagerung- oder Gewebeeinrichtung.</items>
        <items id="comment">Die Verwendung einer etablierten Biobank-Klassifikation wird bevorzugt, z. das "EU Tissue Establishment Compendium".</items>
      </items>
      <items code="at0003">
        <items id="text">Proben-ID</items>
        <items id="description">Identifikation der Probe, Bioprobe oder des Gewebes, die in der Biobank/Lagerung aufbewahrt werden.</items>
      </items>
      <items code="at0004">
        <items id="text">Angaben zur Biobank</items>
        <items id="description">Angaben zur Organisation oder zum Standort der Biobank/Lagerung.</items>
      </items>
      <items code="at0005">
        <items id="text">Spender-ID</items>
        <items id="description">Identifikation der menschlichen Quelle der Probe, Bioprobe oder Gewebeprobe.</items>
        <items id="comment">Zum Beispiel: die Gewebespender-ID oder die Spender-ID sowohl für die Eizellspenderin als auch für den Samenspender eines Embryos.</items>
      </items>
      <items code="at0006">
        <items id="text">Kommentar</items>
