  <ontology>
    <term_definitions language="en">
      <items code="at0000">
        <items id="text">Catheter cuff/balloon</items>
        <items id="description">Details about an inflatable cuff or balloon on a catheter or tubular medical device.</items>
      </items>
      <items code="at0030">
        <items id="text">Cuff type</items>
        <items id="description">The classification of the cuff based on pressure and volume characteristics.</items>
      </items>
      <items code="at0031">
        <items id="text">High pressure/low volume (HPLV)</items>
        <items id="description">A high-pressure, low-volume cuff design.</items>
      </items>
      <items code="at0032">
        <items id="text">Low pressure/high volume (LPHV)</items>
        <items id="description">A low-pressure, high-volume cuff design.</items>
      </items>
      <items code="at0033">
        <items id="text">Cuff position</items>
        <items id="description">The anatomical position of the cuff on the device.</items>
      </items>
      <items code="at0034">
        <items id="text">Proximal</items>
        <items id="description">The cuff is located near the insertion end of the device.</items>
      </items>
      <items code="at0035">
        <items id="text">Distal</items>
        <items id="description">The cuff is located away from the insertion end of the device.</items>
      </items>
      <items code="at0036">
        <items id="text">Cuff capacity</items>
        <items id="description">The volume of air or fluid required to fully inflate the cuff.</items>
      </items>
      <items code="at0037">
        <items id="text">Inflation pressure range</items>
        <items id="description">The recommended pressure range for cuff inflation.</items>
        <items id="comment">For example: '20-30 cmH₂O'.</items>
      </items>
    </term_definitions>
    <term_definitions language="nb">
      <items code="at0000">
        <items id="text">Kateter mansjett/ballong</items>
        <items id="description">Detaljer om en oppblåsbar mansjett eller ballong på et kateter eller tubulært medisinsk utstyr.</items>
      </items>
      <items code="at0030">
        <items id="text">Mansjetttype</items>
        <items id="description">Klassifiseringen av mansjetten basert på trykk- og volumkarakteristika.</items>
      </items>
      <items code="at0031">
        <items id="text">Høyt trykk/lavt volum (HPLV)</items>
        <items id="description">En høyttrykk, lavvolum mansjettdesign.</items>
      </items>
      <items code="at0032">
        <items id="text">Lavt trykk/høyt volum (LPHV)</items>
        <items id="description">En lavttrykk, høytvolum mansjettdesign.</items>
      </items>
      <items code="at0033">
        <items id="text">Mansjettposisjon</items>
        <items id="description">Den anatomiske posisjonen på mansjetten på enheten.</items>
      </items>
      <items code="at0034">
        <items id="text">Proksimal</items>
        <items id="description">Mansjetten er plassert nær innsettelsesenden av enheten.</items>
      </items>
      <items code="at0035">
        <items id="text">Distal</items>
        <items id="description">Mansjetten er plassert bort fra innsettelsesenden av enheten.</items>
      </items>
      <items code="at0036">
        <items id="text">Mansjettkapasitet</items>
        <items id="description">Volumet av luft eller væske som kreves for fullstendig oppblåsing av mansjetten.</items>
      </items>
      <items code="at0037">
        <items id="text">Oppblåsingstrykksområde</items>
        <items id="description">Det anbefalte trykksområde for oppblåsing av mansjett.</items>
        <items id="comment">For eksempel '20-30 cmH₂O'.</items>
      </items>
    </term_definitions>
  </ontology>
</archetype>
