  <ontology>
    <term_definitions language="en">
      <items code="at0000">
        <items id="text">Catheter lumen</items>
        <items id="description">Details about a lumen of a catheter or tubular medical device.</items>
      </items>
      <items code="at0012">
        <items id="text">Label</items>
        <items id="description">A label or identifier for this lumen.</items>
        <items id="comment">For example: 'main', 'distal', 'proximal', 'vent', or 'suction'.</items>
      </items>
      <items code="at0013">
        <items id="text">Internal diameter</items>
        <items id="description">The internal diameter of this lumen.</items>
      </items>
      <items code="at0014">
        <items id="text">Length</items>
        <items id="description">The length or depth of this lumen.</items>
      </items>
      <items code="at0015">
        <items id="text">Purpose</items>
        <items id="description">The primary function or purpose of this lumen.</items>
      </items>
      <items code="at0016">
        <items id="text">Airway</items>
        <items id="description">The lumen is used for airway management.</items>
      </items>
      <items code="at0017">
        <items id="text">Medication delivery</items>
        <items id="description">The lumen is used for delivery of medications.</items>
      </items>
      <items code="at0018">
        <items id="text">Fluid administration</items>
        <items id="description">The lumen is used for administration of fluids.</items>
      </items>
      <items code="at0019">
        <items id="text">Monitoring/pressure</items>
        <items id="description">The lumen is used for monitoring or pressure measurement.</items>
      </items>
      <items code="at0020">
        <items id="text">Drainage</items>
        <items id="description">The lumen is used for drainage of fluids.</items>
      </items>
      <items code="at0022">
        <items id="text">Connector</items>
        <items id="description">Details about the connector for this lumen.</items>
        <items id="comment">More than one connector may be relevant when a single lumen has both a primary hub and one or more additional access points, such as an extension connector, sampling port, or needleless access connector.</items>
      </items>
      <items code="at0023">
        <items id="text">Type</items>
        <items id="description">The type of connector used for this lumen.</items>
      </items>
      <items code="at0024">
        <items id="text">Push-fit</items>
        <items id="description">A push-fit connector.</items>
      </items>
      <items code="at0025">
        <items id="text">Luer-lock</items>
        <items id="description">A Luer-lock connector.</items>
      </items>
      <items code="at0026">
        <items id="text">Slip-fit</items>
        <items id="description">A slip-fit connector.</items>
      </items>
      <items code="at0028">
        <items id="text">Size</items>
        <items id="description">The size of the connector for this lumen.</items>
      </items>
    </term_definitions>
    <term_definitions language="nb">
      <items code="at0000">
        <items id="text">Kateterlumen</items>
        <items id="description">Detaljer om et lumen av et kateter eller tubulært medisinsk utstyr.</items>
      </items>
      <items code="at0012">
        <items id="text">Navn</items>
        <items id="description">Et navn eller identifikator for dette lumenet.</items>
        <items id="comment">For eksempel 'hoved', 'distal', 'proksimal', 'ventil' eller 'sug'.</items>
      </items>
      <items code="at0013">
        <items id="text">Indre diameter</items>
        <items id="description">Den indre diameter av dette lumenet.</items>
      </items>
      <items code="at0014">
        <items id="text">Lengde</items>
        <items id="description">Lengden eller dybden på dette lumenet.</items>
      </items>
      <items code="at0015">
        <items id="text">Formål</items>
        <items id="description">Den primære funksjonen eller formålet med dette lumenet.</items>
      </items>
      <items code="at0016">
        <items id="text">Luftvei</items>
        <items id="description">Lumenet brukes til luftveisbehandling.</items>
      </items>
      <items code="at0017">
        <items id="text">Legemiddellevering</items>
        <items id="description">Lumenet brukes til administrering av legemidler.</items>
