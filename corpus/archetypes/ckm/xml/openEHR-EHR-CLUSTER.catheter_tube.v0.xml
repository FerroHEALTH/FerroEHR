        <items id="description">The device is made of polyvinyl chloride (PVC) material.</items>
      </items>
      <items code="at0039">
        <items id="text">Polyethylene (PE)</items>
        <items id="description">The device is made of polyethylene material.</items>
      </items>
      <items code="at0040">
        <items id="text">Polypropylene (PP)</items>
        <items id="description">The device is made of polypropylene material.</items>
      </items>
      <items code="at0041">
