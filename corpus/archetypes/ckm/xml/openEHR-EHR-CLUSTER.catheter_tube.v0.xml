    <term_definitions language="en">
      <items code="at0000">
        <items id="text">Catheter tube</items>
        <items id="description">Details about the physical and functional properties of flexible tubular medical devices inserted into body orifices or cavities.</items>
      </items>
      <items code="at0001">
        <items id="text">Material</items>
        <items id="description">The material from which the device is constructed.</items>
      </items>
      <items code="at0002">
        <items id="text">Silicone</items>
        <items id="description">The device is made of silicone material.</items>
      </items>
      <items code="at0003">
