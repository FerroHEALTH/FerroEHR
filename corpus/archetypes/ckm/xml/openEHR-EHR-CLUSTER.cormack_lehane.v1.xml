  <ontology>
    <term_definitions language="nb">
      <items code="at0000">
        <items id="text">Cormack/Lehane-klassifikasjon</items>
        <items id="description">Cormack/Lehane-systemet klassifiserer innsynsforhold til larynx ved direkte laryngoskopi, basert på hvilke strukturer som kan ses.</items>
      </items>
      <items code="at0001">
        <items id="text">Gradering</items>
        <items id="description">Gradering av anatomisk synlighet i larynx.</items>
      </items>
      <items code="at0002">
        <items id="text">Grad 1: Hele larynx synlig</items>
        <items id="description">Hele larynx synlig.</items>
      </items>
      <items code="at0003">
        <items id="text">Grad 2: Epiglottis og aryregionen synlig</items>
        <items id="description">Epiglottis og aryregionen synlig.</items>
      </items>
      <items code="at0004">
        <items id="text">Grad 3: Bare epiglottis synlig</items>
        <items id="description">Bare epiglottis synlig.</items>
      </items>
      <items code="at0005">
        <items id="text">Grad 4: Epiglottis ikke synlig</items>
        <items id="description">Epiglottis ikke synlig.</items>
      </items>
      <items code="at0006">
        <items id="text">Kommentar</items>
        <items id="description">Fritekstkommentar til graderingen.</items>
      </items>
    </term_definitions>
    <term_definitions language="en">
      <items code="at0000">
        <items id="text">Cormack-Lehane classification</items>
        <items id="description">The Cormack-Lehane system classifies views obtained by direct laryngoscopy based on the structures seen.</items>
      </items>
      <items code="at0001">
        <items id="text">Grading</items>
        <items id="description">A grading of the laryngeal anatomical visibility.</items>
      </items>
      <items code="at0002">
        <items id="text">Grade 1: Full view of the glottis</items>
        <items id="description">Full view of the glottis.</items>
      </items>
      <items code="at0003">
        <items id="text">Grade 2: Partial view of the glottis or arytenoids</items>
        <items id="description">Partial view of the glottis or arytenoids.</items>
      </items>
      <items code="at0004">
        <items id="text">Grade 3: Only epiglottis visible</items>
        <items id="description">Only epiglottis visible.</items>
      </items>
      <items code="at0005">
        <items id="text">Grade 4: Neither glottis nor epiglottis visible</items>
        <items id="description">Neither glottis nor epiglottis visible.</items>
      </items>
      <items code="at0006">
        <items id="text">Comment</items>
        <items id="description">Narrative comment about the Cormack-Lehane grading.</items>
      </items>
    </term_definitions>
  </ontology>
