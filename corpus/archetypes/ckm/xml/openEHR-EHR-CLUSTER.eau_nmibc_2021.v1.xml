        <items id="description" />
      </items>
      <items code="at0012">
        <items id="text">≥ 3 cm</items>
        <items id="description" />
      </items>
      <items code="at0013">
        <items id="text">≤ 70 years</items>
        <items id="description" />
      </items>
      <items code="at0014">
        <items id="text">&gt; 70 years</items>
        <items id="description" />
      </items>
      <items code="at0015">
        <items id="text">Stage</items>
        <items id="description" />
      </items>
      <items code="at0016">
        <items id="text">Ta</items>
        <items id="description">Non-invasive papillary tumor confined to the urothelium.</items>
      </items>
      <items code="at0017">
        <items id="text">T1</items>
        <items id="description">Tumor invasion into the lamina propria, sparing the muscularis propria.</items>
      </items>
      <items code="at0018">
        <items id="text">Concomitant CIS</items>
        <items id="description" />
      </items>
      <items code="at0019">
        <items id="text">No</items>
        <items id="description" />
      </items>
      <items code="at0020">
        <items id="text">Yes</items>
        <items id="description" />
      </items>
      <items code="at0021">
        <items id="text">WHO grade 2004/2016</items>
        <items id="description" />
        <items id="comment">Only one of the two classification systems (WHO 1973 or WHO 2004/2016) should be used at one time.</items>
      </items>
      <items code="at0022">
        <items id="text">LMP-LG</items>
        <items id="description">Non-invasive papillary tumours with minimal atypia and orderly cells.</items>
      </items>
      <items code="at0023">
        <items id="text">HG</items>
        <items id="description">Tumours with significant architectural and nuclear atypia, frequent mitoses, and loss of normal cell structure.</items>
      </items>
      <items code="at0024">
        <items id="text">WHO grade 1973</items>
        <items id="description" />
        <items id="comment">Only one of the two classification systems (WHO 1973 or WHO 2004/2016) should be used at one time.</items>
      </items>
      <items code="at0025">
        <items id="text">G1</items>
        <items id="description">Well-differentiated tumours with minimal atypia and orderly architecture.</items>
      </items>
      <items code="at0026">
        <items id="text">G2</items>
        <items id="description">Moderately differentiated tumours with intermediate atypia and architectural irregularities.</items>
      </items>
      <items code="at0027">
        <items id="text">G3</items>
        <items id="description">Poorly differentiated tumours with marked atypia, disorganized structure, and frequent mitoses.</items>
      </items>
      <items code="at0028">
        <items id="text">Number of tumors</items>
        <items id="description" />
      </items>
      <items code="at0029">
        <items id="text">Single</items>
        <items id="description" />
      </items>
      <items code="at0030">
        <items id="text">Multiple</items>
        <items id="description" />
      </items>
    </term_definitions>
    <term_definitions language="nb">
      <items code="at0000">
        <items id="text">EAU NMIBC risikogruppering (2021)</items>
        <items id="description">Den europeiske urologiforeningen (EAU) sin risikovurdering fra 2021 for ikke-muskelinvasiv blærekreft (NMIBC) stratifiserer pasienter basert på prognostiske faktorer som svulstkarakteristika, pasientens alder og WHO-graderingssystemer for urotheliale neoplasmer.</items>
      </items>
      <items code="at0001">
        <items id="text">Risikogruppe</items>
        <items id="description">Risiko for residiv basert på parametrene.</items>
        <items id="comment">Ytterligere kliniske risikofaktorer er: alder &gt; 70 år; multiple papillære tumorer; og tumordiameter &gt; 3 cm.</items>
      </items>
      <items code="at0002">
        <items id="text">Lav risiko</items>
        <items id="description">En primær, solitær TaT1 LG/G1-svulst &amp;lt; 3 cm i diameter uten CIS hos en pasient ≤ 70 år ELLER en primær Ta LG/G1-svulst uten CIS med maksimalt ÉN av de ytterligere kliniske risikofaktorene.</items>
      </items>
      <items code="at0003">
        <items id="text">Middels risiko</items>
        <items id="description">Pasienter uten CIS som ikke er inkludert i verken lav-, høy- eller svært høyrisikogruppene.</items>
      </items>
      <items code="at0004">
        <items id="text">Høy risiko</items>
        <items id="description">Alle T1 HG/G3 uten CIS, UNNTATT de som er inkludert i gruppen med svært høy risiko ELLER Alle CIS-pasienter, UNNTATT de som er inkludert i gruppen med svært høy risiko ELLER Ta LG/G2 eller T1G1, ingen CIS med alle 3 risikofaktorer ELLER Ta HG/G3 eller T1 LG, ingen CIS med minst 2 risikofaktorer ELLER T1G2 ingen CIS med minst 1 risikofaktor.</items>
      </items>
      <items code="at0005">
        <items id="text">Svært høy risiko</items>
        <items id="description">Ta HG/G3 og CIS med alle 3 risikofaktorer ELLER T1G2 og CIS med minst 2 risikofaktorer ELLER T1 HG/G3 og CIS med minst 1 risikofaktor ELLER T1 HG/G3 ingen CIS med alle 3 risikofaktorer.</items>
      </items>
