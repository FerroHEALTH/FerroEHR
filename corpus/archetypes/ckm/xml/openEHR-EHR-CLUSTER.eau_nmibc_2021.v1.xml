      <items code="at0015">
        <items id="text">Stadium</items>
        <items id="description" />
      </items>
      <items code="at0016">
        <items id="text">Ta</items>
        <items id="description">Ikke-invasiv papillær tumor begrenset til urotelet.</items>
      </items>
      <items code="at0017">
        <items id="text">T1</items>
        <items id="description">Tumorinfiltrasjon av lamina propria, uten infiltrasjon i muscularis propria.</items>
      </items>
      <items code="at0018">
        <items id="text">Samtidig CIS</items>
        <items id="description" />
      </items>
      <items code="at0019">
        <items id="text">Nei</items>
        <items id="description" />
      </items>
      <items code="at0020">
        <items id="text">Ja</items>
        <items id="description" />
      </items>
      <items code="at0021">
        <items id="text">WHO-grad 2004/2016</items>
        <items id="description" />
        <items id="comment">Bare ett av de to klassifiseringssystemene (WHO 1973 eller WHO 2004/2016) skal brukes om gangen.</items>
      </items>
      <items code="at0022">
        <items id="text">LMP-LG</items>
        <items id="description">Ikke-invasive papillære tumorer med minimal atypi og ordnede celler.</items>
      </items>
      <items code="at0023">
        <items id="text">HG</items>
        <items id="description">Tumorer med markert arkitektur og kjerneatypi, hyppige mitoser og tap av normal cellestruktur.</items>
      </items>
      <items code="at0024">
        <items id="text">WHO-grad 1973</items>
        <items id="description" />
        <items id="comment">Bare ett av de to klassifiseringssystemene (WHO 1973 eller WHO 2004/2016) skal brukes om gangen.</items>
      </items>
      <items code="at0025">
        <items id="text">G1</items>
        <items id="description">Veldifferensierte tumorer med minimal atypi og ordnet arkitektur.</items>
      </items>
      <items code="at0026">
        <items id="text">G2</items>
        <items id="description">Moderat differensierte tumorer med intermediær atypi og arkitektoniske uregelmessigheter.</items>
      </items>
      <items code="at0027">
        <items id="text">G3</items>
        <items id="description">Dårlig differensierte tumorer med markert atypi, desorganisert arkitektur og hyppige mitoser.</items>
      </items>
