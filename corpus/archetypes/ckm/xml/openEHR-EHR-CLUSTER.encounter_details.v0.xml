  <ontology>
    <term_definitions language="en">
      <items code="at0000">
        <items id="text">Encounter details</items>
        <items id="description">Details about an encounter.</items>
      </items>
      <items code="at0001">
        <items id="text">Location</items>
        <items id="description">The physical location where the encounter took place.</items>
        <items id="comment">Coding with an external terminology is preferred, where possible. For example: doctor's office, emergency room, clinic.</items>
      </items>
      <items code="at0002">
        <items id="text">Structured location</items>
        <items id="description">Structured details about where the encounter took place.</items>
      </items>
      <items code="at0003">
        <items id="text">Reason</items>
        <items id="description">The reason for the encounter.</items>
        <items id="comment">Coding with an external terminology is preferred, where possible. For example: diagnosis, elective surgery, or childbirth.</items>
      </items>
      <items code="at0004">
        <items id="text">Start</items>
        <items id="description">The date/date-time when the encounter started.</items>
        <items id="comment">For example: admitted to inpatient facility, transferred to different ward.</items>
      </items>
      <items code="at0005">
        <items id="text">End</items>
        <items id="description">The date/date-time when the encounter ended.</items>
      </items>
      <items code="at0019">
        <items id="text">Sub-episode</items>
        <items id="description">Details about a sub-episode that consitutes part of the original encounter.</items>
        <items id="comment">This slot is intended to be used to add details about sub-episodes using nested instances of this archetype. Examples of sub-episodes can be transfers to different department or room/bed changes.</items>
      </items>
      <items code="at0020">
        <items id="text">Comment</items>
        <items id="description">Additional narrative about the encounter not captured in other fields.</items>
      </items>
      <items code="at0021">
        <items id="text">Source</items>
        <items id="description">The location/organization the patient was prior to the encounter.</items>
      </items>
      <items code="at0022">
        <items id="text">Source category</items>
        <items id="description">The type of location the patient was prior to the encounter.</items>
        <items id="comment">Coding with a terminology is desirable, where possible. For example: home, nursing home, incident site</items>
      </items>
      <items code="at0045">
        <items id="text">Destination</items>
        <items id="description">Location/organization to which the patient went to following the encounter.</items>
      </items>
      <items code="at0046">
        <items id="text">Encounter ID</items>
        <items id="description">An identifier for the encounter.</items>
      </items>
      <items code="at0047">
        <items id="text">Destination category</items>
        <items id="description">The type of location to which the patient went to following the encounter.</items>
        <items id="comment">Coding with a terminology is desirable, where possible.  For example: home, nursing home, other healthcare facility</items>
      </items>
      <items code="at0048">
        <items id="text">Additional details</items>
        <items id="description">Further details about the encounter.</items>
      </items>
    </term_definitions>
    <term_definitions language="nb">
      <items code="at0000">
        <items id="text">Detaljer om klinisk kontakt</items>
        <items id="description">Detaljer om en klinisk kontakt.</items>
      </items>
      <items code="at0001">
        <items id="text">Lokasjon</items>
        <items id="description">Den fysiske lokasjonen hvor den kliniske kontakten fant sted.</items>
      </items>
      <items code="at0002">
        <items id="text">Strukturert lokasjon</items>
        <items id="description">Strukturerte detaljer om den fysiske lokasjonen hvor den kliniske kontakten fant sted.</items>
      </items>
      <items code="at0003">
        <items id="text">Årsak</items>
        <items id="description">Årsaken for den kliniske kontakten.</items>
        <items id="comment">Koding av årsak med en terminologi er foretrukket om mulig. For eksempel, diagnose, elektiv kirurgi, eller fødsel.</items>
      </items>
      <items code="at0004">
        <items id="text">Start</items>
        <items id="description">Dato eller dato og klokkeslett for når den kliniske kontakten startet.</items>
        <items id="comment">For eksempel tidspunktet individet ble innlagt i døgninstitusjon eller overført til annen avdeling.</items>
      </items>
      <items code="at0005">
        <items id="text">Stopp</items>
        <items id="description">Dato eller dato og klokkeslett for når den kliniske kontakten sluttet.</items>
      </items>
      <items code="at0019">
        <items id="text">Del-episode</items>
        <items id="description">Detaljer om en del‑episode som utgjør en del av den opprinnelige kliniske kontakten.</items>
        <items id="comment">Dette SLOT-et er ment for å registrere detaljer om del‑episoder ved å gjenbruke denne arketypen for underordnede episoder (nøsting). Eksempler på del‑episoder kan være overføringer til annen avdeling eller endringer av rom/seng.</items>
      </items>
      <items code="at0020">
        <items id="text">Kommentar</items>
        <items id="description">Ytterligere fritekst om den kliniske kontakten som ikke er registrert/omfattet i andre felter.</items>
      </items>
      <items code="at0021">
        <items id="text">Opphav</items>
        <items id="description">Stedet/organisasjonen pasienten var før den kliniske kontakten.</items>
      </items>
      <items code="at0022">
        <items id="text">Opphavskategori</items>
        <items id="description">Type sted pasienten kom fra før den kliniske kontakten.</items>
        <items id="comment">Koding av opphavskategori med en terminologi er foretrukket om mulig. For eksempel hjem, sykehjem, eller skadested.</items>
      </items>
      <items code="at0045">
        <items id="text">Destinasjon</items>
        <items id="description">Stedet/organisasjonen pasienten ble utskrevet/overflyttet til etter den kliniske kontakten.</items>
      </items>
      <items code="at0046">
        <items id="text">Identifikator</items>
        <items id="description">En identifikator for den kliniske kontakten.</items>
      </items>
      <items code="at0047">
        <items id="text">Destinasjonskategori</items>
        <items id="description">Typen sted pasienten ble utskrevet/overflyttet til etter den kliniske kontakten.</items>
        <items id="comment">Koding av destinasjonskategori med en terminologi er foretrukket om mulig. For eksempel hjem, sykehjem, eller annen helseinstitusjon.</items>
      </items>
      <items code="at0048">
        <items id="text">Ytterligere detaljer</items>
        <items id="description">Ytterligere strukturerte detaljer om den kliniske kontakten.</items>
      </items>
    </term_definitions>
  </ontology>
</archetype>
