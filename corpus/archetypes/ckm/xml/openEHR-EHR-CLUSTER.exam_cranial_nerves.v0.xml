  <ontology>
    <term_definitions language="en">
      <items code="at0000">
        <items id="text">Examination of cranial nerves</items>
        <items id="description">Findings observed during the physical examination of the cranial nerves.</items>
      </items>
      <items code="at0002">
        <items id="text">No abnormality detected</items>
        <items id="description">Statement that no abnormality was detected (NAD) on physical examination.</items>
        <items id="comment">Record as True if no abnormality was detected on examination. Specific statements about the examination can be included in the 'Clinical Interpretation' data element.</items>
      </items>
      <items code="at0003">
        <items id="text">Clinical description</items>
        <items id="description">Narrative description of the overall findings observed during the physical examination.</items>
      </items>
      <items code="at0004">
        <items id="text">Additional findings</items>
        <items id="description">Structured details about other physical examination findings.</items>
      </items>
      <items code="at0005">
        <items id="text">Multimedia representation</items>
        <items id="description">Digital image, video or diagram representing the physical examination findings.</items>
      </items>
      <items code="at0006">
        <items id="text">Clinical interpretation</items>
        <items id="description">Single word, phrase or brief description that represents the clinical meaning and significance of the physical examination findings.</items>
      </items>
      <items code="at0007">
        <items id="text">Comment</items>
        <items id="description">Additional narrative about the physical examination findings, not captured in other fields.</items>
      </items>
      <items code="at0008">
        <items id="text">Examination not done</items>
        <items id="description">Details to explicitly record that this examination was not performed.</items>
      </items>
      <items code="at0009">
        <items id="text">I</items>
        <items id="description">Details about function of the olfactory nerve.</items>
      </items>
      <items code="at0010">
        <items id="text">II</items>
        <items id="description">Details about the function of the optic nerve.</items>
        <items id="comment">Visual acuity testing should be captured using OBSERVATION.visual.field.measurement. Visual acuity test results should be captured using OBSERVATION.visual.acuity.</items>
      </items>
      <items code="at0011">
        <items id="text">III, IV &amp; VI</items>
        <items id="description">Details about the function of the oculomotor, trochlear and abducens nerves.</items>
      </items>
      <items code="at0012">
        <items id="text">V</items>
        <items id="description">Details about the function of the trigeminal nerve.</items>
      </items>
      <items code="at0013">
        <items id="text">Corneal reflex</items>
        <items id="description">Response elicited by stimulation of the cornea.</items>
        <items id="comment">Also known as the Blink reflex. Provides information about the function of V and VII.</items>
      </items>
      <items code="at0014">
        <items id="text">Present</items>
        <items id="description">The corneal reflex is present.</items>
      </items>
      <items code="at0015">
        <items id="text">Absent</items>
        <items id="description">The corneal reflex is absent.</items>
      </items>
      <items code="at0016">
        <items id="text">Equivocal</items>
        <items id="description">It is not possible to determine if the corneal reflex is clearly present or absent.</items>
      </items>
      <items code="at0017">
        <items id="text">Jaw jerk</items>
        <items id="description">Response to tapping chin with a reflex hammer.</items>
        <items id="comment">Also known as the Masseter reflex.</items>
      </items>
      <items code="at0018">
        <items id="text">Present</items>
        <items id="description">The jaw jerk is present.</items>
      </items>
      <items code="at0019">
        <items id="text">Absent</items>
        <items id="description">The jaw jerk is absent.</items>
      </items>
      <items code="at0020">
        <items id="text">Equivocal</items>
        <items id="description">It is not possible to determine if the jaw jerk is clearly present or absent.</items>
      </items>
      <items code="at0021">
        <items id="text">VII</items>
        <items id="description">Details about the function of the facial nerve.</items>
      </items>
      <items code="at0022">
        <items id="text">VIII</items>
        <items id="description">Details about the function of the vestibulococchlear nerve.</items>
      </items>
      <items code="at0023">
        <items id="text">IX &amp; X</items>
        <items id="description">Details about the function of the glossopharyngeal and vagus nerves.</items>
      </items>
      <items code="at0024">
        <items id="text">Pharyngeal reflex</items>
        <items id="description">Response elicited by stimulation of the roof of the mouth, back of tongue, tonsils, uvula and the throat.</items>
        <items id="comment">Also known as the Gag reflex.</items>
      </items>
      <items code="at0025">
        <items id="text">Present</items>
        <items id="description">The pharyngeal reflex is present.</items>
      </items>
      <items code="at0026">
        <items id="text">Absent</items>
        <items id="description">The pharyngeal reflex is absent.</items>
      </items>
      <items code="at0027">
        <items id="text">Equivocal</items>
        <items id="description">It is not possible to determine if the pharyngeal reflex is present or absent.</items>
      </items>
      <items code="at0028">
        <items id="text">Pharyngeal reflex description</items>
        <items id="description">Narrative description about the pharyngeal reflex.</items>
      </items>
      <items code="at0029">
        <items id="text">XI</items>
        <items id="description">Details about the function of the accessory nerve.</items>
      </items>
      <items code="at0030">
        <items id="text">XII</items>
        <items id="description">Details about the function of the hypoglossal nerve.</items>
      </items>
    </term_definitions>
  </ontology>
</archetype>
