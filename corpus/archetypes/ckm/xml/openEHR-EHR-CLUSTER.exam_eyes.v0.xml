  <ontology>
    <term_definitions language="en">
      <items code="at0000">
        <items id="text">Examination of both eyes</items>
        <items id="description">Findings observed during the physical examination of both eyes.</items>
      </items>
      <items code="at0002">
        <items id="text">No abnormality detected</items>
        <items id="description">Commonly used statement that no abnormality was detected (NAD) on examination of both eyes.</items>
        <items id="comment">Record as True if no abnormality was detected on examination. Specific statements about the examination can be included in the 'Clinical Interpretation' data element.</items>
      </items>
      <items code="at0003">
        <items id="text">Clinical description</items>
        <items id="description">Narrative description of the overall findings observed during the physical examination.</items>
      </items>
      <items code="at0004">
        <items id="text">Examination details</items>
        <items id="description">Structured details about the physical examination findings.</items>
      </items>
      <items code="at0005">
        <items id="text">Multimedia representation</items>
        <items id="description">Digital image, video or diagram representing the physical examination findings.</items>
      </items>
      <items code="at0006">
        <items id="text">Clinical interpretation</items>
        <items id="description">Single word, phrase or brief description that represents the clinical meaning and significance of the physical examination findings.</items>
      </items>
      <items code="at0007">
        <items id="text">Comment</items>
        <items id="description">Additional narrative about the physical examination findings, not captured in other fields.</items>
      </items>
      <items code="at0008">
        <items id="text">Examination not done</items>
        <items id="description">Details to explicitly record that this examination was not performed.</items>
      </items>
      <items code="at0011">
        <items id="text">Symmetry?</items>
        <items id="description">Description of the appearance of symmetry of both eyes in comparison to one another.</items>
      </items>
      <items code="at0012">
        <items id="text">PERL</items>
        <items id="description">Pupils are equal and reactive to light.</items>
      </items>
      <items code="at0013">
        <items id="text">PERLA</items>
        <items id="description">Pupils are equal and reactive to light and accomodation.</items>
      </items>
      <items code="at0014">
        <items id="text">No abnormality detected</items>
        <items id="description">Commonly used statement no abnormality was detected (NAD) on examination of both pupils.</items>
      </items>
    </term_definitions>
    <term_definitions language="nb">
      <items code="at0000">
        <items id="text">Undersøkelse av begge øyne</items>
        <items id="description">Funn gjort ved klinisk undersøkelse av begge øyne.</items>
      </items>
      <items code="at0002">
        <items id="text">Normale funn</items>
        <items id="description">Vanlig benyttet utsagn om at det ikke er funnet noe unormalt (uten anmerkning, ua) ved undersøkelse av begge øyne.</items>
        <items id="comment">Registrerer som Sann hvis det ikke er funnet noe unormalt under undersøkelsen. Spesifikke utsagn om undersøkelsen kan legges til i feltet 'Klinisk tolkning'.</items>
      </items>
      <items code="at0003">
        <items id="text">Klinisk beskrivelse</items>
        <items id="description">Tekstlig beskrivelse av overordnede funn gjort ved undersøkelse.</items>
      </items>
      <items code="at0004">
        <items id="text">Detaljerte funn</items>
        <items id="description">Strukturerte detaljer om funn fra undersøkelsen.</items>
      </items>
      <items code="at0005">
        <items id="text">Multimedia</items>
        <items id="description">Digitalt bilde, video eller figur som viser funn fra undersøkelsen.</items>
      </items>
      <items code="at0006">
        <items id="text">Klinisk tolkning</items>
        <items id="description">Enkeltord, frase eller kort beskrivelse som angir den kliniske betydningen eller tolkningen av funnene fra undersøkelsen.</items>
      </items>
      <items code="at0007">
        <items id="text">Kommentar</items>
        <items id="description">Tekstlige tilleggsopplysninger som ikke er registrert i andre felter.</items>
      </items>
      <items code="at0008">
        <items id="text">Undersøkelse ikke utført</items>
        <items id="description">Detaljer for å beskrive at denne undersøkelsen ikke ble utført.</items>
      </items>
      <items code="at0011">
        <items id="text">Symmetri?</items>
        <items id="description">Beskrivelse av i hvilken grad øynene er symmetriske.</items>
      </items>
      <items code="at0012">
        <items id="text">Like pupiller, reagerer på lys</items>
        <items id="description">Pupiller runde og sidelike, reagerer normalt på lys.</items>
      </items>
      <items code="at0013">
        <items id="text">Like pupiller, reagerer på lys og nærinnstilling</items>
        <items id="description">Pupiller runde og sidelike, reagerer normalt på lys og nærinnstilling</items>
      </items>
      <items code="at0014">
        <items id="text">Uten anmerkning</items>
        <items id="description">Vanlig benyttet utsagn om at det ikke er funnet noe unormalt (uten anmerkning, ua) ved undersøkelse av begge øyne.</items>
      </items>
    </term_definitions>
  </ontology>
