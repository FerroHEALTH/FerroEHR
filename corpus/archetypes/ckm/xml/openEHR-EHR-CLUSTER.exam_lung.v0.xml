    <term_definitions language="nb">
      <items code="at0000">
        <items id="text">Undersøkelse av en lunge</items>
        <items id="description">Funn gjort ved fysisk undersøkselse av en lunge.</items>
      </items>
      <items code="at0001">
        <items id="text">Undersøkt lunge</items>
        <items id="description">Identfisering av undersøkt lunge</items>
      </items>
      <items code="at0002">
        <items id="text">Uten anmerkning</items>
        <items id="description">Konstatering at funn ved undersøkelse ikke viste noe unormalt.</items>
        <items id="comment">Dokumenter som Sann dersom intet unormalt ble funnet ved undersøkelse. Spesifikke uttalelser vedrørende undersøkelse kan bli inkludert i dataelementet "klinisk interpretasjon".</items>
      </items>
      <items code="at0003">
        <items id="text">Klinisk beskrivelse</items>
        <items id="description">En tekstlig beskrivelse av samlete funn observert ved den kliniske undersøkelsen.</items>
      </items>
      <items code="at0004">
        <items id="text">Unbdersøkelsesfunn</items>
        <items id="description">Strukturerte detaljer vedrørende funn ved klinisk undersøkelse.</items>
      </items>
      <items code="at0005">
        <items id="text">Multimedia fremstilling</items>
        <items id="description">Digitale bilder, video eller diagram som representerer funnene ved klinisk undersøkelse.</items>
      </items>
      <items code="at0006">
        <items id="text">Klinisk interpretasjon</items>
        <items id="description">Enkelt ord, frase eller kort beskrivelse som representerer klinisk betyning og signifikans av funnene ved klinisk undersøkelse.</items>
      </items>
      <items code="at0007">
        <items id="text">Kommentar</items>
        <items id="description">Tekstlig tilleggsinformasjon vedrørende klinisk undersøkelse, som ikke er fanget opp i de andre datalementene.</items>
      </items>
      <items code="at0008">
        <items id="text">Undersøkelse ikke gjennomføt</items>
        <items id="description">Detaljer for eksplisitt dokumentasjon nav at undersøkelsen ikke ble gjennomført.</items>
      </items>
      <items code="at0009">
        <items id="text">Venstre</items>
        <items id="description">Venstre lunge ble undersøkt.</items>
      </items>
      <items code="at0010">
        <items id="text">Høyre</items>
        <items id="description">Høyre lunge ble undersøkt.</items>
      </items>
    </term_definitions>
    <term_definitions language="pt-br">
      <items code="at0000">
        <items id="text">Exame do pulmão</items>
        <items id="description">Os resultados observados durante o exame físico de um único pulmão.</items>
      </items>
      <items code="at0001">
        <items id="text">Pulmão examinado</items>
        <items id="description">Identificação do pulmão em análise.</items>
      </items>
      <items code="at0002">
        <items id="text">Exame normal?</items>
        <items id="description">Declaração de que nenhuma anormalidade foi detectada (NAD) no exame físico.</items>
        <items id="comment">Gravar "Verdadeiro" se nenhuma anormalidade foi detectada no exame. declarações específicas sobre o exame podem ser incluídos no elemento "Interpretação Clínica " dos dados clínicos.</items>
      </items>
      <items code="at0003">
        <items id="text">Descrição clínica</items>
        <items id="description">Descrição dos resultados globais observados durante o exame físico.</items>
      </items>
      <items code="at0004">
        <items id="text">Achados do exame</items>
        <items id="description">Detalhes sobre os achados do exame físico estruturado.</items>
      </items>
      <items code="at0005">
        <items id="text">Representação multimídia</items>
        <items id="description">Imagem digital, vídeo ou diagrama que representa os achados do exame físico.</items>
      </items>
      <items code="at0006">
        <items id="text">Interpretação clínica</items>
        <items id="description">Única palavra, frase ou breve descrição que representa o significado clínico e relevância dos achados do exame físico.</items>
      </items>
      <items code="at0007">
        <items id="text">Comentários</items>
        <items id="description">Narrativas adicionais sobre os achados do exame físico não contemplados em outros campos.</items>
      </items>
      <items code="at0008">
        <items id="text">Exame não realizado</items>
        <items id="description">Registrar minuciosamente os detalhes esclarecendo porque este exame não foi realizado.</items>
      </items>
      <items code="at0009">
        <items id="text">Esquerdo</items>
        <items id="description">Pulmão esquerdo foi examinado.</items>
      </items>
      <items code="at0010">
        <items id="text">Direito</items>
        <items id="description">Pulmão direito foi examinado.</items>
      </items>
    </term_definitions>
