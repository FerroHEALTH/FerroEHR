  <ontology>
    <term_definitions language="en">
      <items code="at0000">
        <items id="text">Housing</items>
        <items id="description">Details about the place where an individual lives.</items>
      </items>
      <items code="at0002">
        <items id="text">Housing situation</items>
        <items id="description">Category of housing where the individual is living.</items>
        <items id="comment">Coding with a terminology is desirable, where possible. For example: "no housing", "institution", "own home". Only use the run-time name constraint if the individual is currently living in a different place from usual.</items>
      </items>
      <items code="at0003">
        <items id="text">Tenure</items>
        <items id="description">The type of legal right to occupy a dwelling, for example, owner or renter.</items>
      </items>
      <items code="at0004">
        <items id="text">Description</items>
        <items id="description">Narrative description about the housing where the individual is living.</items>
        <items id="comment">For example: "Usually living in their own home, currently living in respite home while family is on holiday."</items>
      </items>
      <items code="at0006">
        <items id="text">Details</items>
        <items id="description">Additional details about housing.</items>
        <items id="comment">For example: social network/relationships; household; home environment.</items>
      </items>
      <items code="at0016">
        <items id="text">Comment</items>
        <items id="description">Additional narrative about where the individual is living not covered in other fields.</items>
      </items>
      <items code="at0017">
        <items id="text">Current housing situation</items>
        <items id="description">Category of housing where the individual is currently living.</items>
      </items>
      <items code="at0018">
        <items id="text">Usual housing situation</items>
        <items id="description">Category of housing where the individual is usually living.</items>
      </items>
    </term_definitions>
    <term_definitions language="nb">
      <items code="at0000">
        <items id="text">Bolig</items>
        <items id="description">Detaljer om stedet et individ bor.</items>
      </items>
      <items code="at0002">
        <items id="text">Boligsituasjon</items>
        <items id="description">Kategorisering av individets boligsituasjon.</items>
        <items id="comment">Koding med en terminologi er ønskelig, der det er mulig. For eksempel "Ingen bolig, "Institusjon", "Egen privat bolig". Bruk run-time name constraint bare dersom individet ved registreringstidspunktet bor et annet sted enn det vanligvis bor.</items>
      </items>
      <items code="at0003">
        <items id="text">Eierskap</items>
        <items id="description">Individets juridiske rett til å benytte boligen, f.eks. selveier eller leier.</items>
        <items id="comment">For eksempel: Leietager eller boligeier.</items>
      </items>
      <items code="at0004">
        <items id="text">Beskrivelse</items>
        <items id="description">Fritekstbeskrivelse om individets boligsituasjon.</items>
        <items id="comment">For eksempel "bor vanligvis i sitt eget hjem, men er i avlastningsbolig mens familien er på ferie".</items>
      </items>
      <items code="at0006">
        <items id="text">Detaljer</items>
        <items id="description">Ytterligere detaljer om boligsituasjonen.</items>
        <items id="comment">For eksempel: sosiale nettverk eller forhold, husholdning, eller hjemmeomgivelser.</items>
      </items>
      <items code="at0016">
        <items id="text">Kommentar</items>
        <items id="description">Ytterligere fritekst om hvor individet bor, som ikke dekkes av andre felt.</items>
      </items>
      <items code="at0017">
        <items id="text">Nåværende boligsituasjon</items>
        <items id="description">Kategorisering av individets nåværende boligsituasjon.</items>
      </items>
      <items code="at0018">
        <items id="text">Vanlig boligsituasjon</items>
        <items id="description">Kategorisering av individets vanlige boligsituasjon.</items>
      </items>
    </term_definitions>
  </ontology>
</archetype>
