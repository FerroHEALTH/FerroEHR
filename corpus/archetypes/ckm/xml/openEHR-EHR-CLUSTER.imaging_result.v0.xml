  <ontology>
    <term_definitions language="en">
      <items code="at0000">
        <items id="text">Imaging result</items>
        <items id="description">Imaging result as a single value or as a nested group result.</items>
      </items>
      <items code="at0001">
        <items id="text">Imaging result</items>
        <items id="description">Specific detailed imaging result, including both the value of the result item, and additional information that may be useful for clinical interpretation.</items>
      </items>
      <items code="at0002">
        <items id="text">Result</items>
        <items id="description">Actual value of the imaging result. The name of this element can be replaced in a template or at run-time to reflect the actual result name and will often be coded.</items>
      </items>
      <items code="at0003">
        <items id="text">Comment</items>
        <items id="description">Additional information about the result not captured in the Result field.</items>
      </items>
      <items code="at0004">
        <items id="text">Result status</items>
        <items id="description">The status of the result value.</items>
      </items>
      <items code="at0005">
        <items id="text">Registered</items>
        <items id="description">No result yet available.</items>
      </items>
      <items code="at0006">
        <items id="text">Interim</items>
        <items id="description">This is an initial or interim result: data may be missing or verification not been performed.</items>
      </items>
      <items code="at0007">
        <items id="text">Final</items>
        <items id="description">The result is complete and verified by the responsible pathologist.</items>
      </items>
      <items code="at0008">
        <items id="text">Amended</items>
        <items id="description">The result has been modified subsequent to being Final, and is complete and verified by the responsible pathologist.</items>
      </items>
      <items code="at0009">
        <items id="text">Cancelled/Aborted</items>
        <items id="description">The result is unavailable because the test was not started or not completed.</items>
      </items>
      <items code="at0010">
        <items id="text">Not requested</items>
        <items id="description">The result is not available as the test was not requested.</items>
      </items>
      <items code="at0011">
        <items id="text">Result status timestamp</items>
        <items id="description">The date and/or time that the entire result was issued for the recorded ‘Result status’.</items>
      </items>
      <items code="at0012">
        <items id="text">Imaging result detail</items>
        <items id="description">Further detail about an individual result.</items>
      </items>
      <items code="at0013">
        <items id="text">Anatomical location</items>
        <items id="description">Details about the individual anatomical location to which the result refers, where finer-grained representation of Anatomical location is required.</items>
      </items>
      <items code="at0014">
        <items id="text">Other detail</items>
        <items id="description">Further details for the individual result or group or a further nested result.</items>
      </items>
    </term_definitions>
    <term_definitions language="de">
      <items code="at0000">
        <items id="text">Ergebnis der Bildgebung</items>
        <items id="description">Ergebnis der Bildgebung als Einzelwert oder als eine verschachtelte Gruppe von Ergebniswerten.</items>
      </items>
      <items code="at0001">
        <items id="text">Ergebnis der Bildgebung</items>
        <items id="description">Ein spezifisches detailliertes Ergebnis der Bildgebung, das sowohl den Wert des Ergebnisses, als auch zusätzliche Informationen enthält, die für die klinische Interpretation nützlich sein können.</items>
      </items>
      <items code="at0002">
        <items id="text">Ergebnis</items>
        <items id="description">Der tatsächliche Wert des Ergebnisses der Bildgebung. Der Name dieses Elements kann während der Template Erstellung oder zur Laufzeit, entsprechend der tatsächlichen Bezeichnung, definiert werden. Dieser Wert wird oft kodiert.</items>
      </items>
      <items code="at0003">
        <items id="text">Kommentar</items>
        <items id="description">Zusätzliche Informationen über das Ergebnis, die nicht im Ergebnisfeld erfasst wurden.</items>
      </items>
      <items code="at0004">
        <items id="text">Status des Ergebnisses</items>
        <items id="description">Der Status des Ergebniswerts.</items>
      </items>
      <items code="at0005">
        <items id="text">Registriert</items>
        <items id="description">Noch kein Ergebnis verfügbar.</items>
      </items>
      <items code="at0006">
        <items id="text">Vorläufig</items>
        <items id="description">Dies ist ein erstes oder ein vorläufiges Ergebnis: es können Daten fehlen oder die Prüfung des Ergebnisses wurde noch nicht durchgeführt.</items>
      </items>
      <items code="at0007">
        <items id="text">Final</items>
        <items id="description">Das Ergebnis ist komplett und wurde vom zuständigen Pathologen überprüft.</items>
      </items>
      <items code="at0008">
        <items id="text">Geändert</items>
        <items id="description">Das Ergebnis wurde nach der Finalisierung modifiziert und ist nun vollständig und vom zuständigen Pathologen verifiziert.</items>
      </items>
      <items code="at0009">
        <items id="text">Storniert/Abgebrochen</items>
        <items id="description">Das Ergebnis ist nicht verfügbar, da der Test nicht begonnen oder nicht abgeschlossen wurde.</items>
      </items>
      <items code="at0010">
        <items id="text">Nicht angefordert</items>
        <items id="description">Das Ergebnis ist nicht verfügbar, weil der Test nicht angefordert wurde.</items>
      </items>
      <items code="at0011">
        <items id="text">Zeitstempel vom Status des Ergebnisses</items>
        <items id="description">Das Datum und/oder die Uhrzeit des ausgegebenen Status des Ergebnisses.</items>
      </items>
      <items code="at0012">
        <items id="text">Details zum Ergebnis der Bildgebung</items>
        <items id="description">Weitere Details zu einem einzelnen Ergebnis.</items>
      </items>
      <items code="at0013">
        <items id="text">Anatomische Lageposition</items>
        <items id="description">Details über die individuelle anatomische Position, auf die sich das Ergebnis bezieht, wenn eine präzisere Wiedergabe der anatomischen Position erforderlich ist.</items>
      </items>
      <items code="at0014">
        <items id="text">Andere Details</items>
        <items id="description">Weitere Details zu einem einzelnen Ergebnis oder einem gruppiertem Ergebnis oder zu einer verschachtelten Gruppe von Ergebniswerten.</items>
      </items>
    </term_definitions>
  </ontology>
</archetype>
