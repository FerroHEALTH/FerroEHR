        <items id="text">Laboratory serological finding</items>
        <items id="description">Findings observed examining laboratory specimens under a microscope.</items>
      </items>
      <items code="at0001">
        <items id="text">Description</items>
        <items id="description">Narrative description about the findings observed on inspection of a specimen using a microscope.</items>
      </items>
