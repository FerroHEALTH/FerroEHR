      <purpose>Zur Dokumentation von Befunden, die bei der Untersuchtung von Laborproben unter dem Mikroskop beobachtet wurden.</purpose>
      <keywords>Mikroskopie</keywords>
      <keywords>Mikro</keywords>
      <use />
      <misuse>Nicht zur Dokumentation von Befunden aus der Kultur einer Probe zu verwenden - für diesen Zweck ist der CLUSTER.laboratory_test_culture Archetyp zu nutzen.</misuse>
      <copyright />
    </details>
    <details>
      <language>
        <terminology_id>
          <value>ISO_639-1</value>
        </terminology_id>
        <code_string>en</code_string>
      </language>
      <purpose>To record findings observed examining laboratory specimens under a microscope.</purpose>
      <keywords>microscopy</keywords>
      <keywords>micro</keywords>
      <use />
      <misuse>Not to be used to record findings observed from culture of a specimen - use the CLUSTER.laboratory_test_culture for this purpose.</misuse>
      <copyright>© openEHR Foundation</copyright>
    </details>
