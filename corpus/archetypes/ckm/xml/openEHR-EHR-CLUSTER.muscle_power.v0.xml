  <ontology>
    <term_definitions language="en">
      <items code="at0000">
        <items id="text">Muscle power finding</items>
        <items id="description">Findings observed during the physical examination of power in a muscle group or a limb.</items>
      </items>
      <items code="at0014">
        <items id="text">Comment</items>
        <items id="description">Additional narrative about the muscle tone findings, not captured in other fields.</items>
      </items>
      <items code="at0001">
        <items id="text">Body site</items>
        <items id="description">Identification of the limb or muscle group tested.</items>
      </items>
      <items code="at0007">
        <items id="text">Strength</items>
        <items id="description">Observed level of power in the identified limb or muscle group.</items>
      </items>
      <items code="at0003">
        <items id="text">Left arm</items>
        <items id="description" />
      </items>
      <items code="at0002">
        <items id="text">Right arm</items>
        <items id="description" />
      </items>
      <items code="at0005">
        <items id="text">Left leg</items>
        <items id="description" />
      </items>
      <items code="at0004">
        <items id="text">Right leg</items>
        <items id="description" />
      </items>
      <items code="at0008">
        <items id="text">No visible muscle contraction</items>
        <items id="description" />
      </items>
      <items code="at0009">
        <items id="text">Visible muscle contraction with no or trace movement</items>
        <items id="description" />
      </items>
      <items code="at0010">
        <items id="text">Limb movement, but not against gravity</items>
        <items id="description" />
      </items>
      <items code="at0011">
        <items id="text">Movement against gravity but not resistance</items>
        <items id="description" />
      </items>
      <items code="at0012">
        <items id="text">Movement against at least some resistance supplied by the examiner</items>
        <items id="description" />
      </items>
      <items code="at0013">
        <items id="text">Full strength</items>
        <items id="description" />
      </items>
      <items code="at0006">
        <items id="text">Clinical description</items>
        <items id="description">Narrative description about the observed muscle power at the identified body site.</items>
      </items>
    </term_definitions>
    <term_definitions language="de">
      <items code="at0000">
        <items id="text">Befund zur Muskelkraft</items>
        <items id="description">Befunde, die bei der körperlichen Untersuchung der Muskelkraft einer Muskelgruppe oder Gliedmaße beobachtet wurden.</items>
      </items>
      <items code="at0001">
        <items id="text">Körperstelle</items>
        <items id="description">Kennzeichnung der untersuchten Gliedmaße oder Muskelgruppe.</items>
      </items>
      <items code="at0002">
        <items id="text">Rechter Arm</items>
        <items id="description" />
      </items>
      <items code="at0003">
        <items id="text">Linker Arm</items>
        <items id="description" />
      </items>
      <items code="at0004">
        <items id="text">Rechtes Bein</items>
        <items id="description" />
      </items>
      <items code="at0005">
        <items id="text">Linkes Bein</items>
        <items id="description" />
      </items>
      <items code="at0006">
        <items id="text">Klinische Beschreibung</items>
        <items id="description">Beschreibung der beobachteten Muskelkraft an der angegebenen Körperstelle.</items>
      </items>
      <items code="at0007">
        <items id="text">Kraft</items>
        <items id="description">Beobachtetes Kraftniveau in der angegebenen Gliedmaße oder Muskelgruppe.</items>
      </items>
      <items code="at0008">
        <items id="text">Keine sichtbare Muskelkontraktion</items>
        <items id="description" />
      </items>
      <items code="at0009">
        <items id="text">Sichtbare Muskelkontraktion ohne oder mit minimaler Bewegung</items>
        <items id="description" />
      </items>
      <items code="at0010">
        <items id="text">Gliedmaßenbewegung, jedoch nicht gegen die Schwerkraft</items>
        <items id="description" />
      </items>
      <items code="at0011">
        <items id="text">Bewegung gegen die Schwerkraft, jedoch ohne Widerstand</items>
        <items id="description" />
      </items>
      <items code="at0012">
        <items id="text">Bewegung gegen mindestens einen vom Untersucher ausgeübten Widerstand</items>
        <items id="description" />
      </items>
      <items code="at0013">
        <items id="text">Volle Kraft</items>
        <items id="description" />
      </items>
      <items code="at0014">
        <items id="text">Kommentar</items>
        <items id="description">Zusätzlicher Freitext zu den Befunden des Muskeltonus, der nicht in anderen Felder erfasst werden konnte.</items>
      </items>
    </term_definitions>
