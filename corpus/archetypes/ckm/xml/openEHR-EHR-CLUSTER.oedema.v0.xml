  <ontology>
    <term_definitions language="en">
      <items code="at0000">
        <items id="text">Oedema</items>
        <items id="description">An excess of watery fluid collecting in the cavities or tissues of the body.</items>
      </items>
      <items code="at0003">
        <items id="text">Clinical description</items>
        <items id="description">Narrative description of the oedema findings observed during the physical examination.</items>
      </items>
      <items code="at0004">
        <items id="text">Examination findings</items>
        <items id="description">Structured details about the physical examination findings.</items>
      </items>
      <items code="at0005">
        <items id="text">Multimedia representation</items>
        <items id="description">Digital image, video or diagram representing the physical examination findings.</items>
      </items>
      <items code="at0006">
        <items id="text">Clinical interpretation</items>
        <items id="description">Single word, phrase or brief description that represents the clinical meaning and significance of the physical examination findings.</items>
        <items id="comment">Coding of the 'Clinical interpretation' with a terminology is preferred, where possible.</items>
      </items>
      <items code="at0007">
        <items id="text">Comment</items>
        <items id="description">Additional narrative about the physical examination findings, not captured in other fields.</items>
      </items>
      <items code="at0008">
        <items id="text">Examination not done</items>
        <items id="description">Details to explicitly record that this examination was not performed.</items>
      </items>
      <items code="at0011">
        <items id="text">Structured body site</items>
        <items id="description">A structured description of the area of the body under examination.</items>
        <items id="comment">If the body site has been fully identified in the 'System or structure examined' or the 'Body site' data element, this SLOT becomes redundant.</items>
      </items>
      <items code="at0012">
        <items id="text">Body site</items>
        <items id="description">Identification of the area of the body under examination.</items>
        <items id="comment">If the body site has been fully identified in the parent archetype in which this archetype is nested, this data element becomes redundant.</items>
      </items>
      <items code="at0013">
        <items id="text">Severity</items>
        <items id="description">Estimation of the severity of oedema.</items>
      </items>
      <items code="at0014">
        <items id="text">None</items>
        <items id="description">No oedema is present.</items>
      </items>
      <items code="at0015">
        <items id="text">Mild (+)</items>
        <items id="description">The oedema is mild.</items>
      </items>
      <items code="at0016">
        <items id="text">Moderate (++)</items>
        <items id="description">The oedema is moderate.</items>
      </items>
      <items code="at0017">
        <items id="text">Severe (+++)</items>
        <items id="description">The oedema is severe.</items>
      </items>
      <items code="at0018">
        <items id="text">Character</items>
        <items id="description">The nature of the oedema.</items>
      </items>
      <items code="at0019">
        <items id="text">Pitting</items>
        <items id="description">Pitting of the skin on finger pressure.</items>
      </items>
      <items code="at0020">
        <items id="text">Non-pitting</items>
        <items id="description">No pitting of the skin on finger pressure.</items>
      </items>
      <items code="at0021">
        <items id="text">Extent</items>
        <items id="description">Description of the extent of the oedema.</items>
        <items id="comment">For example: to mid calf; or to L2 level.</items>
      </items>
    </term_definitions>
    <term_definitions language="nb">
      <items code="at0000">
        <items id="text">*Oedema (en)</items>
        <items id="description">Funn ved fysisk undersøkelse av et organsystem eller anatomisk struktur.</items>
      </items>
      <items code="at0003">
        <items id="text">Klinisk beskrivelse</items>
        <items id="description">*Narrative description of the oedema findings observed during the physical examination. (en)</items>
      </items>
      <items code="at0004">
        <items id="text">Spesifikke funn</items>
        <items id="description">Ytterligere strukturerte detaljer om undersøkelsesfunnene.</items>
      </items>
      <items code="at0005">
        <items id="text">Multimediarepresentasjon</items>
        <items id="description">Digitale bilder, video eller diagram som representerer undersøkelsesfunnene.</items>
      </items>
      <items code="at0006">
        <items id="text">Fortolkning</items>
        <items id="description">Enkelt ord, setning, frase eller kort beskrivelse som representerer den kliniske betydning og viktigheten av funnene ved den kliniske undersøkelsen.</items>
        <items id="comment">Koding med terminologi foretrekkes når mulig. For eksempel "normal undersøkelse" eller "tympanisk membran perforasjon".</items>
      </items>
      <items code="at0007">
        <items id="text">Kommentar</items>
        <items id="description">Ytterligere fritekst om funn ved undersøkelsen, som ikke dekkes av andre elementer.</items>
      </items>
      <items code="at0008">
        <items id="text">Undersøkelse ikke utført</items>
        <items id="description">Detaljer for å eksplisitt registrere at denne undersøkelsen ikke ble utført.</items>
      </items>
      <items code="at0011">
        <items id="text">Strukturert anatomisk lokalisasjon</items>
        <items id="description">Angivelse av en strukturert anatomisk lokalisering av det undersøkte organsystemet eller anatomiske strukturen.</items>
        <items id="comment">Hvis anatomisk lokalisasjon er entydig identifisert i elementet "Undersøkt organsystem eller struktur" er dette SLOTet ikke nødvendig å benytte.</items>
      </items>
      <items code="at0012">
        <items id="text">Anatomisk lokalisasjon</items>
        <items id="description">Identifisering av et enkelt fysisk sted enten på eller i menneskekroppen.</items>
        <items id="comment">*If the body site has been fully identified in the parent archetype in which this archetype is nested, this data element becomes redundant. (en)</items>
      </items>
      <items code="at0013">
        <items id="text">*Severity (en)</items>
        <items id="description">*Estimation of the severity of oedema. (en)</items>
      </items>
      <items code="at0014">
        <items id="text">*None (en)</items>
        <items id="description">*No oedema is present. (en)</items>
      </items>
      <items code="at0015">
        <items id="text">*Mild (+) (en)</items>
        <items id="description">*The oedema is mild. (en)</items>
      </items>
      <items code="at0016">
        <items id="text">*Moderate (++) (en)</items>
        <items id="description">*The oedema is moderate. (en)</items>
      </items>
      <items code="at0017">
        <items id="text">*Severe (+++) (en)</items>
        <items id="description">*The oedema is severe. (en)</items>
      </items>
      <items code="at0018">
        <items id="text">*Character (en)</items>
        <items id="description">*</items>
      </items>
      <items code="at0019">
        <items id="text">*Pitting (en)</items>
        <items id="description">*Pitting of the skin on finger pressure. (en)</items>
      </items>
      <items code="at0020">
        <items id="text">*Non-pitting (en)</items>
        <items id="description">*No pitting of the skin on finger pressure. (en)</items>
      </items>
      <items code="at0021">
        <items id="text">*Extent (en)</items>
        <items id="description">*Description of the extent of the oedema. (en)</items>
        <items id="comment">*For example: to mid calf; or to L2 level. (en)</items>
      </items>
    </term_definitions>
    <term_definitions language="de">
      <items code="at0000">
        <items id="text">Ödem</items>
        <items id="description">Ein Übermaß an seröser Flüssigkeit, die sich in Hohlräumen oder Geweben des Körpers ansammelt.</items>
      </items>
      <items code="at0003">
        <items id="text">Klinische Beschreibung</items>
        <items id="description">Beschreibung der bei der körperlichen Untersuchung festgestellten Ödembefunde.</items>
      </items>
      <items code="at0004">
        <items id="text">Untersuchungsbefunde</items>
        <items id="description">Strukturierte Angaben zu den Befunden der körperlichen Untersuchung.</items>
      </items>
      <items code="at0005">
        <items id="text">Multimediale Repräsentation</items>
        <items id="description">Digitales Bild, Video oder Diagramm, das die Befunde der körperlichen Untersuchung darstellt.</items>
      </items>
      <items code="at0006">
        <items id="text">Klinische Interpretation</items>
        <items id="description">Einzelnes Wort, Ausdruck oder Kurzbeschreibung der klinischen Bedeutung und Aussagekraft der körperlichen Untersuchungsbefunde.</items>
        <items id="comment">Eine Kodierung der 'Klinischen Interpretation' mit einer Terminologie wird, wenn möglich, bevorzugt.</items>
      </items>
      <items code="at0007">
        <items id="text">Kommentar</items>
        <items id="description">Zusätzliche Beschreibung der Befunde der körperlichen Untersuchung, die in den anderen Feldern nicht erfasst werden konnten.</items>
      </items>
      <items code="at0008">
        <items id="text">Untersuchung nicht durchgeführt</items>
        <items id="description">Detailangaben, die ausdrücklich festhalten, dass diese Untersuchung nicht durchgeführt wurde.</items>
      </items>
      <items code="at0011">
        <items id="text">Strukturierte Körperstelle</items>
        <items id="description">Eine strukturierte Beschreibung des untersuchten Körperbereichs.</items>
        <items id="comment">Wenn die Körperstelle im Datenelement 'Untersuchtes System oder untersuchte Struktur' oder im Datenelement 'Körperstelle' vollständig identifiziert wurde, wird die Verwendung dieses SLOT überflüssig.</items>
      </items>
      <items code="at0012">
        <items id="text">Körperstelle</items>
        <items id="description">Identifizierung des untersuchten Körperbereichs.</items>
        <items id="comment">Wenn die Körperstelle im Datenelement "Strukturierte Körperstelle" vollständig identifiziert wurde, wird dieses Datenelement überflüssig.</items>
      </items>
      <items code="at0013">
        <items id="text">Schweregrad</items>
        <items id="description">Einschätzung des Schweregrads des Ödems.</items>
      </items>
      <items code="at0014">
        <items id="text">Kein</items>
        <items id="description">Es ist kein Ödem vorhanden.</items>
      </items>
      <items code="at0015">
        <items id="text">Leicht (+)</items>
        <items id="description">Es ist ein leichtes Ödem vorhanden.</items>
      </items>
      <items code="at0016">
        <items id="text">Mässig (++)</items>
        <items id="description">Das Ödem ist mässig ausgeprägt.</items>
      </items>
      <items code="at0017">
        <items id="text">Schwer (+++)</items>
        <items id="description">Das Ödem ist stark ausgeprägt.</items>
      </items>
      <items code="at0018">
        <items id="text">Charakter</items>
        <items id="description">Der Charakter des Ödems.</items>
      </items>
      <items code="at0019">
        <items id="text">Eindellung</items>
        <items id="description">Eindellung der Haut bei Fingerdruck.</items>
      </items>
      <items code="at0020">
        <items id="text">Keine Eindellung</items>
        <items id="description">Keine Eindellung der Haut bei Fingerdruck.</items>
      </items>
      <items code="at0021">
        <items id="text">Ausmaß</items>
        <items id="description">Beschreibung des Ausmaßes des Ödems.</items>
        <items id="comment">Zum Beispiel: bis zur Mitte der Wade; oder bis zur Höhe von L2.</items>
      </items>
    </term_definitions>
