  <ontology>
    <term_definitions language="en">
      <items code="at0000">
        <items id="text">Unit transfusion details</items>
        <items id="description">Detailed information about a single unit of transfusion's blood product.</items>
      </items>
      <items code="at0001">
        <items id="text">Unit identifier</items>
        <items id="description">The identifier of the unit of blood product transfused.</items>
      </items>
      <items code="at0002">
        <items id="text">Unit starting date/time</items>
        <items id="description">The date and time when the transfusion of the unit commences.</items>
      </items>
      <items code="at0005">
        <items id="text">Description</items>
        <items id="description">Narrative description about the transfusion of the unit.</items>
      </items>
      <items code="at0006">
        <items id="text">Unit volume</items>
        <items id="description">The amount of blood product contained in each unit.</items>
      </items>
      <items code="at0007">
        <items id="text">Additional details</items>
        <items id="description">Further structured details of the blood unit.</items>
      </items>
      <items code="at0009">
        <items id="text">Unit duration</items>
        <items id="description">The duration of the transfusion of the unit.</items>
      </items>
      <items code="at0010">
        <items id="text">Unit end date/time</items>
        <items id="description">The date and time when the transfusion of the unit stops.</items>
      </items>
      <items code="at0011">
        <items id="text">Unit reason for cessation</items>
        <items id="description">The reason why the transfusion was stopped.</items>
      </items>
      <items code="at0014">
        <items id="text">Unit sequence number</items>
        <items id="description">The order of the unit within the sequence of transfused units.</items>
      </items>
      <items code="at0015">
        <items id="text">Adverse reaction</items>
        <items id="description">Additional information regarding a specific adverse reaction event caused by exposure to a specific substance.</items>
        <items id="comment">It is strongly recommended to use the CLUSTER "Adverse reaction event".</items>
      </items>
      <items code="at0016">
        <items id="text">Administration details</items>
        <items id="description">Detailed information about a specific administration event, and the body site where it is performed, for a specific purpose in a subject.</items>
      </items>
    </term_definitions>
    <term_definitions language="ca">
