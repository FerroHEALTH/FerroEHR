  <ontology>
    <term_definitions language="en">
      <items code="at0000">
        <items id="text">DNACPR decision</items>
        <items id="description">The outcome of a clinical decision as to whether cardio-pulmonary resuscitation should be undertaken or not. This is generally referred to in UK clinical guidance as the DNACPR (Do not attempt cardio-pulmonary resuscitation) decision.</items>
      </items>
      <items code="at0001">
        <items id="text">Tree</items>
        <items id="description">@ internal @</items>
      </items>
      <items code="at0002">
        <items id="text">Date of DNACPR decision</items>
        <items id="description">The date at which the DNACPR decision was originally taken or last reviewed.</items>
      </items>
      <items code="at0003">
        <items id="text">DNACPR decision</items>
        <items id="description">The clinical decision on whether (CPR) cardiopulmonary resuscitation  should be attempted. In some cases a clear answer may not be available to the recording clinician.</items>
      </items>
      <items code="at0004">
        <items id="text">For attempted cardio-pulmonary resuscitation</items>
        <items id="description">Cardio-pulmonary resuscitation should be attempted.</items>
      </items>
      <items code="at0005">
        <items id="text">Not for attempted cardiopulmonary resuscitation</items>
        <items id="description">Cardiopulmonary resuscitation should not be attempted.</items>
      </items>
      <items code="at0006">
        <items id="text">Patient awareness of decision</items>
        <items id="description">Is the patient aware of the DNACPR decision?</items>
      </items>
      <items code="at0007">
        <items id="text">Patient not aware of DNACPR decision</items>
        <items id="description">The patient is not aware of the do not attempt  cardiopulmonary resuscitation clinical decision</items>
      </items>
      <items code="at0008">
        <items id="text">Patient aware of DNACPR decision</items>
        <items id="description">The patient is aware of the do not attempt cardiopulmonary resucitation decision.</items>
      </items>
      <items code="at0009">
        <items id="text">Date for review of DNACPR decision</items>
        <items id="description">The date at which the DNACPR decision should be reviewed.</items>
      </items>
      <items code="at0010">
        <items id="text">Tree</items>
        <items id="description">@ internal @</items>
      </items>
      <items code="at0011">
        <items id="text">Location of DNACPR documentation</items>
        <items id="description">The location of the original DNACPR document, either a text description or an electronic link</items>
      </items>
      <items code="at0012">
        <items id="text">Informal carer awareness of decision</items>
        <items id="description">Is the informal carer, or carers, aware of the DNACPR decision?</items>
      </items>
      <items code="at0013">
        <items id="text">Discussion with patient</items>
        <items id="description">Has resuscitation been discussed with  the patient?</items>
      </items>
      <items code="at0014">
        <items id="text">Discussion with informal carer</items>
        <items id="description">Has resuscitation been discussed with  the patient's informaral carer or carers?</items>
      </items>
      <items code="at0015">
        <items id="text">Resuscitation discussed with informal carer</items>
        <items id="description">Resuscitation has been discussed with the patient's informal carer.</items>
      </items>
      <items code="at0016">
        <items id="text">Resuscitation discussed with patient</items>
        <items id="description">Resuscitation has been discussed with the patient.</items>
      </items>
      <items code="at0017">
        <items id="text">DNACPR form completed</items>
        <items id="description">Has the physical DNACPR form been completed?</items>
      </items>
      <items code="at0018">
        <items id="text">DNACPR form completed</items>
        <items id="description">The physical DNACPR form has been completed.</items>
      </items>
      <items code="at0019">
        <items id="text">DNACPR form not completed</items>
        <items id="description">The physical DNACPR form has not been completed.</items>
      </items>
      <items code="at0021">
        <items id="text">Comment</items>
        <items id="description">Other narrative comment pertinent to the DNACPR decision.</items>
      </items>
      <items code="at0022">
        <items id="text">DNACPR decision status unknown</items>
        <items id="description">There is no clear information on the outcome of the DNACPR decision.</items>
      </items>
      <items code="at0023">
        <items id="text">Resucitation not discussed with patient</items>
        <items id="description">Resuscitation has not been discussed with the patient</items>
      </items>
      <items code="at0024">
        <items id="text">Resuscitation not discussed with informal carer</items>
        <items id="description">Resuscitation has not been discussed with the patient's informal carer or carers.</items>
      </items>
      <items code="at0025">
        <items id="text">Informal carer not aware of DNACPR decision</items>
        <items id="description">The informal carer is not aware of the do not attempt cardiopulmonary resuscitation clinical decision</items>
      </items>
      <items code="at0026">
        <items id="text">Informal carer aware of DNACPR decision</items>
        <items id="description">The informal carer is aware of the do not attempt cardiopulmonary resucitation decision.</items>
      </items>
