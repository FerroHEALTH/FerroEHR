  <ontology>
    <term_definitions language="en">
      <items code="at0000">
        <items id="text">Estimated date of delivery (EDD)</items>
        <items id="description">Estimated date of delivery for a pregnancy.</items>
      </items>
      <items code="at0001">
        <items id="text">Item tree</items>
        <items id="description">@ internal @</items>
      </items>
      <items code="at0002">
        <items id="text">Item tree</items>
        <items id="description">@ internal @</items>
      </items>
      <items code="at0003">
        <items id="text">EDD by date of conception</items>
        <items id="description">The EDD calculated from a known date of conception.</items>
        <items id="comment">The date of conception will usually be recorded elsewhere in the health record, for example as part of the record for an IVF procedure.</items>
      </items>
      <items code="at0004">
        <items id="text">EDD by cycle</items>
        <items id="description">The EDD estimated from the onset of the last normal menstrual period by Naegele's method.</items>
        <items id="comment">The date of the 'Last menstrual period' will be captured elsewhere using the EVALUATION.last_menstrual_period archetype. In addition, further details about typical cycles will be recorded using the EVALUATION.menstruation_summary and details about a specific menstrual cycle will be recorded using the OBSERVATION.menstruation archetype.</items>
      </items>
      <items code="at0005">
        <items id="text">Date of ultrasound</items>
        <items id="description">The date on which the ultrasound was carried out.</items>
      </items>
      <items code="at0006">
        <items id="text">By ultrasound</items>
        <items id="description">Details about an EDD estimated from the findings on a pregnancy ultrasound.</items>
        <items id="comment">The findings from each ultrasound will be captured as a separate instance within this CLUSTER.</items>
      </items>
      <items code="at0007">
        <items id="text">Gestation by scan</items>
        <items id="description">The gestation estimated from the scan.</items>
      </items>
      <items code="at0008">
        <items id="text">EDD by ultrasound</items>
        <items id="description">Details about an EDD estimated from the findings on a pregnancy ultrasound.</items>
        <items id="comment">Only one 'Agreed EDD' is appropriate at any one time. If the agreed EDD needs to be revised then this should be captured in a new revision of this archetype within a health record.</items>
      </items>
      <items code="at0009">
        <items id="text">Agreed EDD</items>
        <items id="description">Details about the EDD which is used as the basis for clinical decision-making during the pregnancy.</items>
        <items id="comment">This CLUSTER has intentionally been constrained to a single occurrence representing the current agreed date. Amended EDDs should be stored in the health record as previous versions of this archetype.</items>
      </items>
      <items code="at0010">
        <items id="text">EDD</items>
        <items id="description">The EDD which is to be used as the basis for clinical decision-making.</items>
        <items id="comment">This EDD may be amended during the pregnancy by the healthcare providers to reflect available evidence and the specific circumstances of the pregnancy. For example, an EDD based on an uncertain cycle information may be updated once early ultrasound details become available.</items>
      </items>
      <items code="at0011">
        <items id="text">Rationale</items>
        <items id="description">The rationale for the 'EDD'.</items>
        <items id="comment">For example, 'based on a 9 week ultrasound scan'.</items>
      </items>
      <items code="at0012">
        <items id="text">Extension</items>
        <items id="description">Additional information required to capture local content or to align with other reference models/formalisms.</items>
        <items id="comment">For example: local information requirements or additional metadata to align with FHIR.</items>
      </items>
      <items code="at0013">
        <items id="text">Last updated</items>
        <items id="description">The date any EDD was last updated.</items>
      </items>
    </term_definitions>
    <term_definitions language="nb">
      <items code="at0000">
        <items id="text">Termindato</items>
        <items id="description">Estimert termindato for et svangerskap.</items>
      </items>
      <items code="at0001">
        <items id="text">Item tree</items>
        <items id="description">@ internal @</items>
      </items>
      <items code="at0002">
        <items id="text">Item tree</items>
        <items id="description">@ internal @</items>
      </items>
      <items code="at0003">
        <items id="text">Termindato basert på befruktningsdato</items>
        <items id="description">Termindato beregnet ut fra kjent befruktningsdato.</items>
        <items id="comment">Befruktningsdatoen vil vanligvis være registrert andre steder i pasientjournalen, for eksempel som en del av journalføringen ved en IVF-prosedyre.</items>
      </items>
      <items code="at0004">
        <items id="text">Termindato basert på syklus</items>
        <items id="description">Termindato estimert ut fra første dag i siste normale menstruasjon ved hjelp av Naegeles regel.</items>
        <items id="comment">Dato for 'siste menstruasjon' registreres andre steder ved bruk av arketypen EVALUATION.last_menstrual_period. I tillegg registreres nærmere opplysninger om typiske sykluser med arketypen EVALUATION.menstruation_summary, mens detaljer om en spesifikk menstruasjonssyklus registreres med arketypen OBSERVATION.menstruation.</items>
      </items>
      <items code="at0005">
        <items id="text">Dato for ultralyd</items>
        <items id="description">Datoen ultralydundersøkelsen ble utført.</items>
      </items>
      <items code="at0006">
        <items id="text">Basert på ultralyd</items>
        <items id="description">Detaljer om termindato estimert ut fra en ultralydundersøkelse.</items>
        <items id="comment">Funn fra hver ultralyd registreres som en egen instans innenfor denne klyngen.</items>
      </items>
      <items code="at0007">
        <items id="text">Gestasjonsalder basert på ultralyd</items>
        <items id="description">Svangerskapsalder estimert fra ultralyden.</items>
      </items>
      <items code="at0008">
        <items id="text">Termindato basert på ultralyd</items>
        <items id="description">Detaljer om termindato estimert på grunnlag av funn ved ultralydundersøkelse i svangerskapet.</items>
        <items id="comment">Kun én 'avtalt termindato' er gyldig til enhver tid. Dersom den avtalte termindatoen må revideres, skal dette registreres i en ny revisjon av denne arketypen i pasientjournalen.</items>
      </items>
      <items code="at0009">
        <items id="text">Avtalt termindato</items>
        <items id="description">Detaljer om den termindatoen som brukes som grunnlag for kliniske beslutninger under svangerskapet.</items>
        <items id="comment">Denne klyngen er begrenset til én forekomst som representerer gjeldende avtalt termindato. Endrede termindatoer skal lagres i pasientjournalen som tidligere versjoner av denne arketypen.</items>
      </items>
      <items code="at0010">
        <items id="text">Termindato</items>
        <items id="description">Termindatoen som skal brukes som grunnlag for kliniske beslutninger.</items>
        <items id="comment">Denne termindatoen kan endres under svangerskapet av helsepersonell for å reflektere tilgjengelig dokumentasjon og de spesifikke omstendighetene ved svangerskapet. For eksempel kan en termindato basert på usikre opplysninger om syklus oppdateres når tidlige ultralyddetaljer blir tilgjengelige.</items>
      </items>
      <items code="at0011">
        <items id="text">Begrunnelse</items>
        <items id="description">Begrunnelsen for 'termindato'.</items>
        <items id="comment">For eksempel: 'basert på en ultralydundersøkelse i uke 9'.</items>
      </items>
      <items code="at0012">
        <items id="text">Utvidelse</items>
        <items id="description">Ytterligere informasjon som trengs for å kunne registrere lokalt definert innhold eller for å tilpasse til andre referansemodeller/formalismer.</items>
        <items id="comment">For eksempel lokale informasjonsbehov eller ytterligere metadata for å kunne tilpasse til tilsvarende konsepter i FHIR.</items>
      </items>
      <items code="at0013">
        <items id="text">Sist oppdatert</items>
        <items id="description">Datoen for siste oppdatering av en termindato.</items>
      </items>
    </term_definitions>
