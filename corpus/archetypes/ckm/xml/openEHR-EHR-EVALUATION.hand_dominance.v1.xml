  <ontology>
    <term_definitions language="en">
      <items code="at0000">
        <items id="text">Hand dominance</items>
        <items id="description">Hand dominance is an individual's natural preference for a specific hand for performing various motor tasks.</items>
      </items>
      <items code="at0001">
        <items id="text">Item tree</items>
        <items id="description">@ internal @</items>
      </items>
      <items code="at0002">
        <items id="text">Dominant hand</items>
        <items id="description">Which hand the individual typically uses for common tasks.</items>
      </items>
      <items code="at0003">
        <items id="text">Right-handed</items>
        <items id="description">The individual primarily uses their right hand.</items>
      </items>
      <items code="at0004">
        <items id="text">Left-handed</items>
        <items id="description">The individual primarily uses their left hand.</items>
      </items>
      <items code="at0005">
        <items id="text">Ambidextrous</items>
        <items id="description">The individual uses both hands equally.</items>
      </items>
      <items code="at0006">
        <items id="text">Mixed-handed</items>
        <items id="description">The individual prefers different hands for different tasks, such as writing with the right hand and using a hammer with the left.</items>
      </items>
      <items code="at0013">
        <items id="text">Comment</items>
        <items id="description">Additional narrative about the dominant hand, not captured in other fields.</items>
      </items>
      <items code="at0014">
        <items id="text">Item tree</items>
        <items id="description">@ internal @</items>
      </items>
      <items code="at0015">
        <items id="text">Extension</items>
        <items id="description">Additional information required to capture local context or to align with other reference models/formalisms.</items>
        <items id="comment">For example, local information requirements; or additional metadata to align with FHIR.</items>
      </items>
      <items code="at0016">
        <items id="text">Assessment method</items>
        <items id="description">The method used to acertain the individual's handedness.</items>
        <items id="comment">For example, Edinburgh Handedness Inventory.</items>
      </items>
      <items code="at0023">
        <items id="text">Last updated</items>
        <items id="description">The date when the dominant hand was last updated.</items>
      </items>
    </term_definitions>
    <term_definitions language="nb">
      <items code="at0000">
        <items id="text">Hånddominans</items>
        <items id="description">Hånddominans er et individs naturlige preferanse for å bruke en bestemt hånd for å gjennomføre ulike motoriske handlinger.</items>
      </items>
      <items code="at0001">
        <items id="text">Item tree</items>
        <items id="description">@ internal @</items>
      </items>
      <items code="at0002">
        <items id="text">Dominant hånd</items>
        <items id="description">Hvilken hånd individet vanligvis bruker for vanlige oppgaver.</items>
      </items>
      <items code="at0003">
        <items id="text">Høyrehendt</items>
        <items id="description">Individet bruker hovedsakelig sin høyre hånd.</items>
      </items>
      <items code="at0004">
        <items id="text">Venstrehendt</items>
        <items id="description">Individet bruker hovedsakelig sin venstre hånd.</items>
      </items>
      <items code="at0005">
        <items id="text">Ambidekster</items>
        <items id="description">Individet bruker bruker begge hender like mye. Også kalt kapphendt eller tvehendt.</items>
      </items>
      <items code="at0006">
        <items id="text">Kryssdominant</items>
        <items id="description">Individet bruker ulike hender avhengig av oppgaven, som f.eks. skriver med høyre hånd, og bruker hammer med venstre.</items>
      </items>
      <items code="at0013">
        <items id="text">Kommentar</items>
        <items id="description">Ytterligere fritekst om hånddominans som ikke er omfattet i andre felter.</items>
      </items>
      <items code="at0014">
        <items id="text">Item tree</items>
        <items id="description">@ internal @</items>
      </items>
      <items code="at0015">
        <items id="text">Tilleggsinformasjon</items>
        <items id="description">Ytterligere informasjon som trengs for å kunne registrere lokalt definert innhold eller for å tilpasse til andre referansemodeller/formalismer.</items>
        <items id="comment">For eksempel lokale informasjonsbehov eller ytterligere metadata for å kunne tilpasse til tilsvarende konsepter i FHIR.</items>
      </items>
      <items code="at0016">
        <items id="text">Vurderingsmetode</items>
        <items id="description">Hvilken metode som ble brukt for å fastslå individets hånddominans.</items>
        <items id="comment">For eksempel, Edinburgh Handedness Inventory.</items>
      </items>
      <items code="at0023">
        <items id="text">Sist oppdatert</items>
        <items id="description">Datoen da hånddominans sist ble oppdatert.</items>
      </items>
    </term_definitions>
  </ontology>
</archetype>
