  <ontology>
    <term_definitions language="en">
      <items code="at0000">
        <items id="text">Pregnancy/breast feeding status</items>
        <items id="description">Record of the positive state of pregnancy or breast feeding.</items>
      </items>
      <items code="at0001">
        <items id="text">Tree</items>
        <items id="description">@ internal @</items>
      </items>
      <items code="at0002">
        <items id="text">Pregnant</items>
        <items id="description">The woman is pregnant.</items>
        <items id="comment">Record as True if there is clinical opinion or confirmation by diagnostic test of a positive pregnancy state.</items>
      </items>
      <items code="at0003">
        <items id="text">Breast feeding</items>
        <items id="description">The woman is breast feeding.</items>
        <items id="comment">Record as True if there is knowledge that the woman is currently breastfeeding.</items>
      </items>
      <items code="at0004">
        <items id="text">Tree</items>
        <items id="description">@ internal @</items>
      </items>
      <items code="at0005">
        <items id="text">Last updated</items>
        <items id="description">Date and optional time when the pregnancy and /or breast feeding statement was last updated.</items>
      </items>
      <items code="at0006">
        <items id="text">Extension</items>
        <items id="description">Additional information required to capture local content or to align with other reference models/formalisms.</items>
        <items id="comment">For example: local information requirements or additional metadata to align with FHIR or CIMI equivalents.</items>
      </items>
    </term_definitions>
    <term_definitions language="de">
      <items code="at0000">
        <items id="text">Status Schwangerschaft/Stillzeit</items>
        <items id="description">Repräsentation des positiven Zustands der Schwangerschaft oder der Stillzeit.</items>
      </items>
      <items code="at0001">
        <items id="text">Tree</items>
        <items id="description">@ internal @</items>
      </items>
      <items code="at0002">
        <items id="text">Schwanger</items>
        <items id="description">Die Frau ist schwanger.</items>
        <items id="comment">Als "WAHR" darstellen, wenn eine klinisches Gutachten vorliegt oder ein positiver Schwangerschaftszustand durch einen diagnostischen Test bestätigt wird.</items>
      </items>
      <items code="at0003">
        <items id="text">Stillzeit</items>
        <items id="description">Die Frau befindet sich in der Stillzeit</items>
        <items id="comment">Als "WAHR" darstellen, wenn bekannt ist, dass die Frau gerade stillt.</items>
      </items>
      <items code="at0004">
        <items id="text">Tree</items>
        <items id="description">@ internal @</items>
      </items>
      <items code="at0005">
        <items id="text">Zuletzt aktualisiert</items>
        <items id="description">Datum und optionale Uhrzeit der letzten Aktualisierung des Statements zur Schwangerschaft und / oder Stillzeit.</items>
      </items>
      <items code="at0006">
        <items id="text">Erweiterung</items>
        <items id="description">Zusätzliche Informationen zur Erfassung lokaler Inhalte oder Anpassung an andere Referenzmodelle/Formalismen.</items>
        <items id="comment">Zum Beispiel: Lokaler Informationsbedarf oder zusätzliche Metadaten zur Anpassung an FHIR-Ressourcen oder CIMI-Modelle.</items>
      </items>
    </term_definitions>
  </ontology>
