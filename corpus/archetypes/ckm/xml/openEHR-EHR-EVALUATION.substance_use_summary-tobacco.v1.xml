        <code_string>en</code_string>
      </language>
      <purpose>This is a generic archetype used to record an ongoing and persistent summary of the use of any and all substances.</purpose>
      <keywords>consumption</keywords>
      <keywords>substance</keywords>
      <keywords>use</keywords>
      <keywords>usage</keywords>
      <keywords>dependence</keywords>
      <keywords>tobacco</keywords>
      <keywords>smoking</keywords>
      <keywords>cigarettes</keywords>
      <keywords>cigar</keywords>
      <keywords>pipe</keywords>
      <use>Used to record an ongoing and persistent summary of any and all use of tobacco.</use>
      <misuse>Not to be used for recording actual details about the use of the substance and event-related data - this should be captured using the OBSERVATION.substance_use-tobacco archetype.  &#xD;
Not to be used to record information about any other substance other than tobacco.</misuse>
