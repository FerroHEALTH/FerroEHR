  <ontology>
    <term_definitions language="en">
      <items code="at0000">
        <items id="text">Developmental milestone</items>
        <items id="description">An assessment of whether an individual has achieved a skill recognised as a milestone in infant, child or adolescent development.</items>
      </items>
      <items code="at0001">
        <items id="text">History</items>
        <items id="description">@ internal @</items>
      </items>
      <items code="at0002">
        <items id="text">Any point-in-time event</items>
        <items id="description">Default, unspecified point in time which may be explicitly defined in a template or at run-time.</items>
      </items>
      <items code="at0003">
        <items id="text">Tree</items>
        <items id="description">@ internal @</items>
      </items>
      <items code="at0004">
        <items id="text">Milestone name</items>
        <items id="description">The name of the activity, skill or behaviour being assessed as a developmental milestone.</items>
        <items id="comment">The developmental milestone should be sufficiently specific and clearly defined to support consistent assessment of achievement. For example: "Walks independently"; "Waves bye-bye"; "Plays with other children". Where a milestone is commonly known by a term that implies a problematic behaviour, name the underlying milestone accordingly, for example: "Distinguishes familiar people from strangers" rather than "Stranger anxiety"; "Understands that a caregiver still exists when out of sight" rather than "Separation anxiety". Coding with a terminology is preferred, where possible.</items>
      </items>
      <items code="at0005">
        <items id="text">Achievement status</items>
        <items id="description">Assessment of whether the individual has achieved the specified developmental skill.</items>
      </items>
      <items code="at0006">
        <items id="text">Achieved</items>
        <items id="description">The individual has achieved the specified developmental skill.</items>
      </items>
      <items code="at0008">
        <items id="text">Not achieved</items>
        <items id="description">The individual has not yet achieved the specified developmental skill, including where the skill can only be partially performed.</items>
      </items>
      <items code="at0009">
        <items id="text">Date achieved</items>
        <items id="description">The date or approximate date when the individual first achieved the developmental skill.</items>
        <items id="comment">Record only when 'Achievement status' is "Achieved". This date may differ from the date of assessment, for example when achievement is reported by a parent. A record of "Not achieved" applies at the date of assessment. Partial dates may be recorded, for example month and year.</items>
      </items>
      <items code="at0010">
        <items id="text">Variation</items>
        <items id="description">Narrative description of an atypical way in which the individual achieved the developmental skill.</items>
        <items id="comment">For example: "Bottom shuffling instead of crawling".</items>
      </items>
      <items code="at0011">
        <items id="text">Comment</items>
        <items id="description">Additional narrative about the developmental milestone assessment not captured in other fields.</items>
      </items>
      <items code="at0012">
        <items id="text">Tree</items>
        <items id="description">@ internal @</items>
      </items>
      <items code="at0013">
        <items id="text">Extension</items>
        <items id="description">Additional information required to capture local content or to align with other reference models or formalisms.</items>
        <items id="comment">For example: local information requirements or additional metadata to align with FHIR or CIMI equivalents.</items>
      </items>
      <items code="at0017">
        <items id="text">Observer</items>
        <items id="description">The role or relationship of the person who directly observed the individual performing the developmental skill.</items>
        <items id="comment">Record only when the skill was observed by someone other than the person recording the information. For example: 'Mother', 'Father', 'Grandparent', 'Babysitter', or 'Childcare worker'. Coding with a terminology is preferred, where possible.</items>
      </items>
      <items code="at0018">
        <items id="text">Information source</items>
        <items id="description">The role or relationship of the person who provided information about the achievement of the developmental skill.</items>
        <items id="comment">Record only when the information was provided by someone other than the person recording it. The information source may differ from the observer, for example when a parent reports what a babysitter observed. Information may be provided by someone familiar with the individual's development, such as a parent, carer or childcare worker. A report of 'Not achieved' should reflect knowledge that the skill has not yet been achieved, rather than simply an absence of observed performance.</items>
      </items>
    </term_definitions>
  </ontology>
</archetype>
