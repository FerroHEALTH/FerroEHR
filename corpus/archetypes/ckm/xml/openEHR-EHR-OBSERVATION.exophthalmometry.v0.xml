  <ontology>
    <term_definitions language="en">
      <items code="at0000">
        <items id="text">Exophthalmometry</items>
        <items id="description">Measurement of eye globe position relative to the orbital rim to assess protrusion or retraction of the eyeball.</items>
      </items>
      <items code="at0001">
        <items id="text">History</items>
        <items id="description">@ internal @</items>
      </items>
      <items code="at0002">
        <items id="text">Any event</items>
        <items id="description">@ internal @</items>
      </items>
      <items code="at0003">
        <items id="text">Tree</items>
        <items id="description">@ internal @</items>
      </items>
      <items code="at0004">
        <items id="text">Result</items>
        <items id="description">The measurement of globe position in the anterior-posterior axis, the main measure of exomphthalmometry.</items>
        <items id="comment">The landmarks compared along this axis may vary by method. For instance, in case of Hertel Exophthalmometry, it is the anterior-posterior distance between a line connecting the lateral orbital rims and the apex of the cornea. &#xD;
High values indicate Exophthalmus, low Values indicate Enophthalmus</items>
      </items>
      <items code="at0005">
        <items id="text">Eye examined</items>
        <items id="description" />
      </items>
      <items code="at0006">
        <items id="text">Right Eye</items>
        <items id="description">The right eye was examined.</items>
      </items>
      <items code="at0007">
        <items id="text">Left Eye</items>
        <items id="description">The left eye was examined.</items>
      </items>
      <items code="at0008">
        <items id="text">Item tree</items>
        <items id="description">@ internal @</items>
      </items>
      <items code="at0009">
        <items id="text">Horizontal Base Distance</items>
        <items id="description">The Horizontal distance between the reference points that are being compared to the globe position. In a Hertel exomphtalmometry, this refers to the distance between the lateral orbital rims.</items>
      </items>
      <items code="at0010">
        <items id="text">Globe position in vertical axis</items>
        <items id="description">A measure of the globe position in the vertical position.</items>
        <items id="comment">The landmarks compared along this axis may vary by method, and it is not measured by all Exomphthalmometry devices. The most commonly used Exophthalmometer (Hertel) does not produce this value, but the Naugle Exophthalmometer does. Abnormal Values reflect hyper-ophthalmus or hypo-ophthalmus.</items>
      </items>
      <items code="at0012">
        <items id="text">Provocative Maneuvers</items>
        <items id="description" />
      </items>
      <items code="at0013">
        <items id="text">Valsalva Maneuver</items>
        <items id="description">A maneuver by which exhalation is attempted against closed airways.</items>
      </items>
      <items code="at0014">
        <items id="text">Measurement Device Type</items>
        <items id="description" />
      </items>
      <items code="at0015">
        <items id="text">Hertel</items>
        <items id="description">A measurement device positioned against both lateral orbital rims to measure the anterioposterior distance to the corneal apexes.</items>
      </items>
      <items code="at0016">
        <items id="text">Naugle</items>
        <items id="description">A measurement device positioned against the superior and inferior orbital rims to measure both the anterioposterior distance to the corneal apices and the vertial position of the globes.</items>
      </items>
      <items code="at0017">
        <items id="text">Luedde</items>
        <items id="description">A measurement device positioned against the orbital lateral rim of one orbit to measure the anterioposterior position of the globe.</items>
      </items>
      <items code="at0018">
        <items id="text">Mourits</items>
        <items id="description">A parallax-free exophthalmometry device, positioned similarly to the Hertel exophthalmometer.</items>
      </items>
      <items code="at0019">
        <items id="text">Computer Tomography</items>
        <items id="description">An imaging-based method to measure Globe position.</items>
      </items>
      <items code="at0020">
        <items id="text">Device Specification</items>
        <items id="description" />
      </items>
      <items code="at0021">
        <items id="text">Comment</items>
        <items id="description" />
      </items>
      <items code="at0022">
        <items id="text">Interpretation</items>
        <items id="description" />
      </items>
      <items code="at0023">
        <items id="text">No test result</items>
        <items id="description">No visual acuity test result is available for the test eye.</items>
        <items id="comment">Record as True if the clinician was unable to record a result for the test eye.</items>
      </items>
      <items code="at0024">
        <items id="text">Reason for no test result</items>
        <items id="description">Reason why no visual acuity test result is available for the test eye.</items>
        <items id="comment">For example, patient was not cooperative; patient was not capable; ran out of time.</items>
      </items>
      <items code="at0025">
        <items id="text">Item tree</items>
        <items id="description">@ internal @</items>
      </items>
      <items code="at0026">
        <items id="text">Confounding Factors</items>
        <items id="description">Patient circumstances or actions which affect interpretation of the result. Often termed 'reliability' in opthalmological documentation.&#xD;
May include actions aiming improve the patient's ability to participate such as holding the lid open.</items>
        <items id="comment">Examples: 'Patient was confused', "Lid held open by hand" "Excentric Fixation"</items>
      </items>
      <items code="at0028">
        <items id="text">Lid Swelling</items>
        <items id="description" />
      </items>
      <items code="at0029">
        <items id="text">Blepharospasm</items>
        <items id="description" />
      </items>
      <items code="at0030">
