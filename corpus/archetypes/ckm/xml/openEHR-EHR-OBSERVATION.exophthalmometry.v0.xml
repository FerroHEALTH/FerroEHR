    <details>
      <language>
        <terminology_id>
          <value>ISO_639-1</value>
        </terminology_id>
        <code_string>en</code_string>
      </language>
      <purpose>To record measurements of eye globe position in relation to the orbital rim for assessment of exophthalmos or enophthalmos.</purpose>
      <keywords>exophthalmometry, exophthalmos, enophthalmos, eye, globe position, orbital measurement, orbit, Hertel, orbital disorders</keywords>
      <use>Use to record all measurements of eye globe position that include a measure of anterior-posterior position,  regardless of the measurement method or device used.</use>
      <misuse>Not to be used for measurements of orbital dimensions that do not relate to globe position relative to the orbital rim.</misuse>
      <copyright>© openEHR Foundation</copyright>
    </details>
