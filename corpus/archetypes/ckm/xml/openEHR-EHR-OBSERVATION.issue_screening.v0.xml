      </items>
      <items code="at0022">
        <items id="text">Specific issue</items>
        <items id="description">Screening details about a specified issue.</items>
      </items>
      <items code="at0023">
        <items id="text">Present</items>
        <items id="description">The specific issue is present.</items>
      </items>
      <items code="at0024">
        <items id="text">Absent</items>
        <items id="description">The specific issue is not present.</items>
      </items>
      <items code="at0025">
        <items id="text">Comment</items>
        <items id="description">Additional narrative about the specified issue, not captured in other fields.</items>
      </items>
      <items code="at0027">
        <items id="text">Unknown</items>
        <items id="description">It is not known whether the issue is present or absent.</items>
      </items>
      <items code="at0028">
        <items id="text">Any presence?</items>
        <items id="description">Presence of any relevant issues.</items>
        <items id="comment">For example: screening if the individual has any issues or concerns about their health and well being.</items>
      </items>
      <items code="at0031">
        <items id="text">Present</items>
        <items id="description">Issues are present.</items>
      </items>
      <items code="at0032">
        <items id="text">Absent</items>
        <items id="description">Issues are not present.</items>
      </items>
      <items code="at0033">
        <items id="text">Unknown</items>
        <items id="description">It is not known whether any issues are present or absent.</items>
      </items>
      <items code="at0034">
        <items id="text">Screening purpose</items>
        <items id="description">The reason for overall screening.</items>
        <items id="comment">For example: the individual's self-perception about their overall wellness.</items>
      </items>
      <items code="at0039">
        <items id="text">Screening details</items>
        <items id="description">Additional details or questions about the specific issue.</items>
      </items>
