  <ontology>
    <term_definitions language="en">
      <items code="at0000">
        <items id="text">Issue screening questionnaire</items>
        <items id="description">An individual- or self-reported questionnaire screening for issues, worries or concerns affecting an individual.</items>
      </items>
      <items code="at0001">
        <items id="text">History</items>
        <items id="description">@ internal @</items>
      </items>
      <items code="at0002">
