        <items id="description">Ytterligere fritekst om det spesifikke problemet som ikke er omfattet av andre felt.</items>
      </items>
      <items code="at0027">
        <items id="text">Ukjent</items>
        <items id="description">Det er ukjent om problemet er tilstede eller fraværende.</items>
      </items>
      <items code="at0028">
        <items id="text">Tilstedeværelse?</items>
        <items id="description">Tilstedeværelse av relevante problemer.</items>
        <items id="comment">For eksempel: screening av individets personlige problemer eller bekymringer om helse og velvære.</items>
      </items>
      <items code="at0031">
        <items id="text">Tilstede</items>
        <items id="description">Problemer er tilstede.</items>
      </items>
      <items code="at0032">
        <items id="text">Fraværende</items>
        <items id="description">Problemer er ikke tilstede.</items>
      </items>
      <items code="at0033">
        <items id="text">Ukjent</items>
        <items id="description">Det er ukjent om noen problemer er tilstede eller fraværende.</items>
      </items>
      <items code="at0034">
        <items id="text">Registreringsformål</items>
        <items id="description">Årsaken til registreringen.</items>
        <items id="comment">For eksempel: individets selvoppfatning om deres generelle velvære.</items>
      </items>
      <items code="at0039">
        <items id="text">Screening detaljer</items>
        <items id="description">Ytterligere detaljer eller spørsmål om det spesifikke problemet.</items>
      </items>
