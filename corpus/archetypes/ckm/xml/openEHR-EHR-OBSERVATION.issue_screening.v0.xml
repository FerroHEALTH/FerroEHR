        <items id="description">@ internal @</items>
      </items>
      <items code="at0004">
        <items id="text">Issue name</items>
        <items id="description">Name of the issue being screened.</items>
        <items id="comment">For example: sleep; mood; diet; or physical activity.</items>
      </items>
      <items code="at0005">
        <items id="text">Presence?</items>
        <items id="description">Presence of the issue.</items>
      </items>
