        <items id="text">Tilstede</items>
        <items id="description">Det spesifikke problemet er tilstede.</items>
      </items>
      <items code="at0024">
        <items id="text">Fraværende</items>
        <items id="description">Det spesifikke problemet er fraværende.</items>
      </items>
      <items code="at0025">
