  <ontology>
    <term_definitions language="en">
      <items code="at0000">
        <items id="text">Medication screening questionnaire</items>
        <items id="description">Questionnaire information about the administration or consumption of any medication, a specified medication or type/class of medication at or during an event such as a specific point in time or duration of time.</items>
      </items>
      <items code="at0001">
        <items id="text">Tree</items>
        <items id="description">@ internal @</items>
      </items>
      <items code="at0002">
        <items id="text">Medication class name</items>
        <items id="description">Name of class or type of medication.</items>
        <items id="comment">For example: opioid; or analgesic.</items>
      </items>
      <items code="at0003">
        <items id="text">Medication class in use?</items>
        <items id="description">Is the individual using the medication, class or type of medication at or during the identified event?</items>
      </items>
      <items code="at0005">
        <items id="text">Tree</items>
        <items id="description">@ internal @</items>
      </items>
      <items code="at0008">
        <items id="text">Specific medication</items>
        <items id="description">Details about a specific medication or medication subclass of the medication class.</items>
      </items>
      <items code="at0019">
        <items id="text">Extension</items>
        <items id="description">Additional information required to capture local content or to align with other reference models/formalisms.</items>
        <items id="comment">For example: local information requirements or additional metadata to align with FHIR or CIMI equivalents.</items>
      </items>
      <items code="at0021">
        <items id="text">Medication name</items>
        <items id="description">Name of medication or medication subclass.</items>
        <items id="comment">For example: Oxycodone.</items>
      </items>
      <items code="at0022">
        <items id="text">Event Series</items>
        <items id="description">@ internal @</items>
      </items>
      <items code="at0023">
        <items id="text">Any event</items>
        <items id="description">Default, unspecified point in time or interval event which may be explicitly defined in a template or at run-time.</items>
      </items>
      <items code="at0024">
        <items id="text">Medication in use?</items>
        <items id="description">Is the individual using the medication or subclass of medication at or during the identified event?</items>
      </items>
      <items code="at0025">
        <items id="text">Comment</items>
        <items id="description">Additional narrative about the medication use during an identified event, not captured in other fields.</items>
      </items>
      <items code="at0026">
        <items id="text">Specific medication class</items>
        <items id="description">Details about the use of a specific class of medication.</items>
      </items>
      <items code="at0027">
        <items id="text">Any medication use?</items>
        <items id="description">Is the individual using any medication at or during the time of the event?</items>
      </items>
      <items code="at0028">
        <items id="text">In use</items>
        <items id="description">The individual uses or has used the medication class at or during the time of the event.</items>
      </items>
      <items code="at0029">
        <items id="text">Not in use</items>
        <items id="description">The individual does not use or has not used the medication class at or during the time of the event.</items>
      </items>
      <items code="at0030">
        <items id="text">Unknown</items>
        <items id="description">It is unknown whether the individual uses or has used the medication class at or during the time of the event.</items>
      </items>
      <items code="at0031">
        <items id="text">In use</items>
        <items id="description">The individual uses or has used the medication at or during the time of the event.</items>
      </items>
      <items code="at0032">
        <items id="text">Not in use</items>
        <items id="description">The individual does not use or has not used the medication at or during the time of the event.</items>
      </items>
      <items code="at0033">
        <items id="text">Unknown</items>
        <items id="description">It is unknown whether the individual uses or has used the medication at or during the time of the event.</items>
      </items>
    </term_definitions>
    <term_definitions language="nb">
      <items code="at0000">
        <items id="text">Spørreskjema for legemiddelbruk</items>
        <items id="description">Spørreskjemainformasjon om administrering og inntak av et spesifikt legemiddel eller en type eller klasse legemiddel ved eller i løpet av en hendelse, f.eks. et tidspunkt eller et tidsintervall.</items>
      </items>
      <items code="at0001">
        <items id="text">Tree</items>
        <items id="description">@ internal @</items>
      </items>
      <items code="at0002">
        <items id="text">Legemiddelklasse</items>
        <items id="description">Navnet på klassen eller typen legemiddel.</items>
        <items id="comment">For eksempel opioid eller smertestillende.</items>
      </items>
      <items code="at0003">
        <items id="text">Legemiddelklasse i bruk?</items>
        <items id="description">Bruker individet klassen eller typen legemiddel ved eller i løpet av hendelsen?</items>
      </items>
      <items code="at0005">
        <items id="text">Tree</items>
        <items id="description">@ internal @</items>
      </items>
      <items code="at0008">
        <items id="text">Spesifikt legemiddel</items>
        <items id="description">Detaljer om bruk av et spesifikt legemiddel eller en spesifikk underklasse av legemiddelklassen.</items>
      </items>
      <items code="at0019">
        <items id="text">Ytterligere informasjon</items>
        <items id="description">Ytterligere informasjon som trengs for å kunne registrere lokalt definert innhold eller for å tilpasse til andre referansemodeller/formalismer.</items>
        <items id="comment">For eksempel lokale informasjonsbehov eller ytterligere metadata for å kunne tilpasse til tilsvarende konsepter i FHIR eller CIMI.</items>
      </items>
      <items code="at0021">
        <items id="text">Legemiddelnavn</items>
        <items id="description">Navn på legemiddelet eller underklassen av legemiddelklassen.</items>
        <items id="comment">For eksempel oksykodon.</items>
      </items>
      <items code="at0022">
        <items id="text">*HISTORY (en)</items>
        <items id="description">*</items>
      </items>
      <items code="at0023">
        <items id="text">Uspesifisert hendelse</items>
        <items id="description">Standard, uspesifisert tidspunkt eller tidsintervall som kan defineres mer eksplisitt i et templat eller i en applikasjon.</items>
      </items>
      <items code="at0024">
        <items id="text">Legemiddel i bruk?</items>
        <items id="description">Bruker individet legemiddelet eller underklassen legemiddel ved eller i løpet av hendelsen?</items>
      </items>
      <items code="at0025">
        <items id="text">Kommentar</items>
        <items id="description">Ytterligere fritekst om legemiddelbruken under hendelsen, som ikke fanges av andre felt.</items>
      </items>
      <items code="at0026">
        <items id="text">Spesifikk legemiddelklasse</items>
        <items id="description">Detaljer om bruk av en spesifikk legemiddelklasse.</items>
      </items>
      <items code="at0027">
        <items id="text">Er noen legemidler i bruk?</items>
        <items id="description">Bruker individet noen legemidler i det hele tatt ved eller i løpet av hendelsen?</items>
      </items>
      <items code="at0028">
        <items id="text">I bruk</items>
        <items id="description">Individet bruker eller har brukt legemiddelklassen ved eller i løpet av hendelsen.</items>
      </items>
      <items code="at0029">
        <items id="text">Ikke i bruk</items>
        <items id="description">Individet bruker ikke eller har ikke brukt legemiddelklassen ved eller i løpet av hendelsen.</items>
      </items>
      <items code="at0030">
        <items id="text">Ukjent</items>
        <items id="description">Det er ukjent hvorvidt individet bruker eller har brukt legemiddelklassen ved eller i løpet av hendelsen.</items>
      </items>
      <items code="at0031">
        <items id="text">I bruk</items>
        <items id="description">Individet bruker eller har brukt legemiddelet ved eller i løpet av hendelsen.</items>
      </items>
      <items code="at0032">
        <items id="text">Ikke i bruk</items>
        <items id="description">Individet bruker ikke eller har ikke brukt legemiddelet ved eller i løpet av hendelsen.</items>
      </items>
      <items code="at0033">
        <items id="text">Ukjent</items>
        <items id="description">Det er ukjent hvorvidt individet bruker eller har brukt legemiddelet ved eller i løpet av hendelsen.</items>
      </items>
    </term_definitions>
    <term_definitions language="de">
      <items code="at0000">
        <items id="text">Fragebogen zum Medikations-Screening</items>
        <items id="description">Aggregierte Informationen über die Verabreichung oder die Einnahme eines bestimmten Medikaments oder einer bestimmten Art/Klasse von Medikamenten bei oder während eines Ereignisses, wie z.B. einem bestimmten Zeitpunkt oder einer bestimmten Zeitdauer.</items>
      </items>
      <items code="at0001">
        <items id="text">Tree</items>
        <items id="description">@ internal @</items>
      </items>
      <items code="at0002">
        <items id="text">Name der Medikamentenklasse</items>
        <items id="description">Name der Klasse oder des Medikamententyps.</items>
        <items id="comment">Zum Beispiel: Opioid; oder Analgetikum.</items>
      </items>
      <items code="at0003">
        <items id="text">Medikamentenklasse in Verwendung?</items>
        <items id="description">Wendet die Person das Medikament, die Klasse oder Art des Medikaments bei oder während des Zeitpunkts des Ergebnisses an?</items>
      </items>
      <items code="at0005">
        <items id="text">Tree</items>
        <items id="description">@ internal @</items>
      </items>
      <items code="at0008">
        <items id="text">Spezifische Medikamente</items>
        <items id="description">Details über ein spezifisches Medikament oder eine Medikamentenunterklasse der Medikamentenklasse.</items>
      </items>
      <items code="at0019">
        <items id="text">Erweiterung</items>
        <items id="description">Zusätzliche Informationen zur Erfassung lokaler Inhalte oder Anpassung an andere Referenzmodelle/Formalismen.</items>
        <items id="comment">Zum Beispiel: Lokaler Informationsbedarf oder zusätzliche Metadaten zur Anpassung an FHIR-Ressourcen oder CIMI-Modelle.</items>
      </items>
      <items code="at0021">
        <items id="text">Name des Medikaments</items>
        <items id="description">Name des Medikaments oder der Medikamentenunterklasse.</items>
        <items id="comment">Zum Beispiel: Oxycodon.</items>
      </items>
      <items code="at0022">
        <items id="text">Event Series</items>
        <items id="description">@ internal @</items>
      </items>
      <items code="at0023">
        <items id="text">Beliebiges Ereignis</items>
        <items id="description">Standard, ein nicht spezifizierter Zeitpunkt oder ein Intervallereignis, das explizit in einem Template oder zur Laufzeit definiert werden kann.</items>
      </items>
      <items code="at0024">
        <items id="text">Medikament in Verwendung?</items>
        <items id="description">Wendet die Person das Medikament oder Unterklasse des Medikaments bei oder während des genannten Ereignisses an?</items>
      </items>
      <items code="at0025">
        <items id="text">Kommentar</items>
        <items id="description">Zusätzliche Beschreibung des Gebrauchs von Medikamenten während eines bestimmten Ereignisses, die in anderen Bereichen nicht erfasst wurde.</items>
      </items>
      <items code="at0026">
        <items id="text">Spezifische Medikamentenklasse</items>
        <items id="description">Details über die Verwendung einer bestimmten Medikamentenklasse.</items>
      </items>
      <items code="at0027">
        <items id="text">Medikamente in Verwendung?</items>
        <items id="description">Wendet die Person das Medikament bei oder während des Zeitpunkts des Ergebnisses an?</items>
      </items>
      <items code="at0028">
        <items id="text">In Verwendung</items>
        <items id="description">Die Person verwendet die Medikamentenklasse zum Zeitpunkt des Ergebnis oder währendessen oder hat sie verwendet.</items>
      </items>
      <items code="at0029">
        <items id="text">Nicht in Verwendung</items>
        <items id="description">Die Person verwendet die Medikamentenklasse zum Zeitpunkt des Ergebnis oder währendessen nicht oder hat sie nicht verwendet.</items>
      </items>
      <items code="at0030">
        <items id="text">Unbekannt</items>
        <items id="description">Es ist unbekannt, ob die Person die Medikamentenklasse zum Zeitpunkt des Ergebnis oder währendessen verwendet oder sie verwendet hat.</items>
      </items>
      <items code="at0031">
        <items id="text">In Verwendung</items>
        <items id="description">Die Person verwendet das Medikament zum Zeitpunkt des Ergebnis oder währendessen oder hat es verwendet.</items>
      </items>
      <items code="at0032">
        <items id="text">Nicht in Verwendung</items>
        <items id="description">Die Person verwendet das Medikament zum Zeitpunkt des Ergebnis oder währendessen nicht oder hat es nicht verwendet.</items>
      </items>
      <items code="at0033">
        <items id="text">Unbekannt</items>
        <items id="description">Es ist unbekannt, ob die Person das Medikament zum Zeitpunkt des Ergebnis oder währendessen verwendet oder es verwendet hat.</items>
      </items>
    </term_definitions>
  </ontology>
</archetype>
