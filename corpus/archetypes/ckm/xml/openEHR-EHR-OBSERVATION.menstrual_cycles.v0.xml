        <items id="description">@ internal @</items>
      </items>
      <items code="at0005">
        <items id="text">Antall sykluser</items>
        <items id="description">Antall sykluser i et definert tidsintervall, for eksempel ett år.</items>
      </items>
      <items code="at0006">
        <items id="text">Beskrivelse av menstruasjonssyklusene</items>
