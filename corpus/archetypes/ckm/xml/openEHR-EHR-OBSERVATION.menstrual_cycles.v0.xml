        <items id="description">Number of cycles in a defined interval, for excample a year.</items>
      </items>
      <items code="at0006">
        <items id="text">Description</items>
        <items id="description">Narrative description about the menstruation cycles.</items>
      </items>
      <items code="at0007">
        <items id="text">Comment</items>
        <items id="description">Additional narrative about the overall menstruation cycles not captured in other fields.</items>
      </items>
