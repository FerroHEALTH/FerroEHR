        </term_definitions>
        <term_definitions code="at0025">
          <items id="text">Officiële naam</items>
          <items id="description">Generally the complete role name should be used to avoid any ambiguity in identification. This should usually be the same as the company registration name.</items>
        </term_definitions>
        <term_definitions code="at0026">
          <items id="text">Andere naam</items>
          <items id="description">Used when the role does not fit into any one of the categories listed above.</items>
        </term_definitions>
        <term_definitions code="at0027">
          <items id="text">Onbekend</items>
          <items id="description">Used when the role type is unknown.</items>
