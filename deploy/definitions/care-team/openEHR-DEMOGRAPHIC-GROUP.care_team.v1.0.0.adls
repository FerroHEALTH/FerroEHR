archetype (adl_version=2.0.6; rm_release=1.1.0)
    openEHR-DEMOGRAPHIC-GROUP.care_team.v1.0.0

language
    original_language = <[ISO_639-1::en]>

description
    original_author = <
        ["name"] = <"FerroEHR">
        ["organisation"] = <"Cadasto B.V.">
    >
    lifecycle_state = <"unmanaged">
    details = <
        ["en"] = <
            language = <[ISO_639-1::en]>
            purpose = <"A team of healthcare professionals, such as a care team or a department, whose members are the professionals' PERSONs. A SCIM Group is provisioned as one.">
            use = <"Adapted from the openEHR CKM archetypes the derived_from entry names: the team's identifiers in details and its name in identities, every element optional so a team provisioned with only a name is complete. Each member's PERSON holds a membership PARTY_RELATIONSHIP to the team.">
            copyright = <"© openEHR Foundation">
        >
    >
    other_details = <
        ["licence"] = <"This work is licensed under the Creative Commons Attribution-ShareAlike 3.0 License. To view a copy of this license, visit http://creativecommons.org/licenses/by-sa/3.0/.">
        ["derived_from"] = <"openEHR-DEMOGRAPHIC-ORGANISATION.organisation.v0 (openEHR CKM 1013.1.475, modified 2019-08-09), openEHR-DEMOGRAPHIC-PARTY_IDENTITY.organisation_name.v0 (openEHR CKM 1013.1.476, modified 2019-08-09)">
    >

definition
    GROUP[id1] matches {
        details matches {
            ITEM_TREE[id2] matches {
                items matches {
                    ELEMENT[id3] occurrences matches {0..*} matches {
                        value matches { DV_IDENTIFIER[id7] }
                    }
                }
            }
        }
        identities matches {
            PARTY_IDENTITY[id4] matches {
                details matches {
                    ITEM_TREE[id5] matches {
                        items matches {
                            ELEMENT[id6] occurrences matches {0..1} matches {
                                value matches { DV_TEXT[id8] }
                            }
                        }
                    }
                }
            }
        }
    }

terminology
    term_definitions = <
        ["en"] = <
            ["id1"] = <text = <"Care team"> description = <"A team of healthcare professionals.">>
            ["id2"] = <text = <"Identifiers"> description = <"The identifiers of the team.">>
            ["id3"] = <text = <"Identifier"> description = <"An identifier of the team, such as the external id of a provisioned group.">>
            ["id4"] = <text = <"Name"> description = <"The name the team is known by.">>
            ["id5"] = <text = <"Items"> description = <"The structure of the name.">>
            ["id6"] = <text = <"Name"> description = <"The name of the team as it is displayed.">>
        >
    >
