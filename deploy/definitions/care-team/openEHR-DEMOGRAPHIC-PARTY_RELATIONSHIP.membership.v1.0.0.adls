archetype (adl_version=2.0.6; rm_release=1.1.0)
    openEHR-DEMOGRAPHIC-PARTY_RELATIONSHIP.membership.v1.0.0

language
    original_language = <[ISO_639-1::en]>

description
    original_author = <
        ["name"] = <"FerroEHR">
        ["organisation"] = <"Cadasto B.V.">
    >
    lifecycle_state = <"unmanaged">
    details = <
        ["en"] = <
            language = <[ISO_639-1::en]>
            purpose = <"The membership of a person in a team: a PARTY_RELATIONSHIP from the member's PERSON, its source, to the team's GROUP, its target.">
            use = <"Held in the member's PERSON.relationships. Adapted from the PARTY_RELATIONSHIP the openEHR CKM archetype the derived_from entry names constrains inline: its details and type of relationship, here the member's role in the team, optional. Its name is the relationship's type (RM PARTY_RELATIONSHIP.type() = name): a DV_TEXT for a membership of any group, or the DV_CODED_TEXT member_of of the draft openEHR access terminology openehr_access (bound in term_bindings) for a care team's membership, which makes it a care relationship. MBR of HL7 v3 RoleClass is the broader standard code of member_of.">
            copyright = <"© openEHR Foundation">
        >
    >
    other_details = <
        ["licence"] = <"This work is licensed under the Creative Commons Attribution-ShareAlike 3.0 License. To view a copy of this license, visit http://creativecommons.org/licenses/by-sa/3.0/.">
        ["derived_from"] = <"openEHR-DEMOGRAPHIC-ORGANISATION.organisation.v0 (openEHR CKM 1013.1.475, modified 2019-08-09)">
    >

definition
    PARTY_RELATIONSHIP[id1] matches {
        name matches {
            DV_TEXT[id5]
            DV_CODED_TEXT[id6] matches {
                defining_code matches {[ac20]}
            }
        }
        details matches {
            ITEM_TREE[id2] occurrences matches {0..1} matches {
                items matches {
                    ELEMENT[id3] occurrences matches {0..1} matches {
                        value matches { DV_TEXT[id4] }
                    }
                }
            }
        }
    }

terminology
    term_definitions = <
        ["en"] = <
            ["id1"] = <text = <"Membership"> description = <"The membership of a person in a team.">>
            ["id2"] = <text = <"Details"> description = <"The details of the membership.">>
            ["id3"] = <text = <"Role in the team"> description = <"The role the member holds in the team.">>
            ["ac20"] = <text = <"Membership kinds"> description = <"The coded kinds of membership.">>
            ["at20"] = <text = <"Member of"> description = <"A member of a care team: member_of of the draft openEHR access terminology openehr_access.">>
        >
    >
    term_bindings = <
        ["openehr_access"] = <
            ["at20"] = <http://openehr.org/openehr_access/id/member_of>
        >
    >
    value_sets = <
        ["ac20"] = <
            id = <"ac20">
            members = <"at20">
        >
    >
