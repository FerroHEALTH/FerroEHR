archetype (adl_version=2.0.6; rm_release=1.1.0)
    openEHR-DEMOGRAPHIC-PARTY_RELATIONSHIP.under_care_of.v2.0.0

language
    original_language = <[ISO_639-1::en]>

description
    original_author = <
        ["name"] = <"FerroEHR">
        ["organisation"] = <"Cadasto B.V.">
    >
    lifecycle_state = <"unmanaged">
    details = <
        ["en"] = <
            language = <[ISO_639-1::en]>
            purpose = <"A care relationship: a PARTY_RELATIONSHIP of its own from the patient's PERSON, its source, to the carer, its target: a professional's PERSON, a ROLE a professional performs, a care team's GROUP or an ORGANISATION unit, with the period of the care as its time_validity.">
            use = <"Written at /demographic/party_relationship by the care delivery environment, such as a hospital's ADT system, under a write_care_relationship grant, each relationship versioned on its own. Its name is under_care_of of the draft openEHR access terminology openehr_access, and its details hold the elements the care relationship element group of that terminology names: care_role (1..1), the part the carer plays in the patient's care, provider (1..1), the ORGANISATION in whose care it is, and covers_for, context and basis (0..1). Adapted from the person-to-provider PARTY_RELATIONSHIP the openEHR CKM archetype the derived_from entry names constrains inline.">
            copyright = <"© openEHR Foundation">
        >
    >
    other_details = <
        ["licence"] = <"This work is licensed under the Creative Commons Attribution-ShareAlike 3.0 License. To view a copy of this license, visit http://creativecommons.org/licenses/by-sa/3.0/.">
        ["derived_from"] = <"openEHR-DEMOGRAPHIC-PERSON.person-patient.v0 (openEHR CKM 1013.1.821, modified 2019-08-09)">
    >

definition
    PARTY_RELATIONSHIP[id1] matches {
        details matches {
            ITEM_TREE[id2] matches {
                items matches {
                    ELEMENT[id3] occurrences matches {1} matches {
                        value matches { DV_CODED_TEXT[id4] }
                    }
                    ELEMENT[id5] occurrences matches {1} matches {
                        value matches { DV_IDENTIFIER[id6] }
                    }
                    ELEMENT[id7] occurrences matches {0..1} matches {
                        value matches { DV_IDENTIFIER[id8] }
                    }
                    ELEMENT[id9] occurrences matches {0..1} matches {
                        value matches { DV_IDENTIFIER[id10] }
                    }
                    ELEMENT[id11] occurrences matches {0..1} matches {
                        value matches { DV_CODED_TEXT[id12] }
                    }
                }
            }
        }
    }

terminology
    term_definitions = <
        ["en"] = <
            ["id1"] = <text = <"Under care of"> description = <"The care of a patient by a professional, a role a professional performs, a care team or an organisational unit.">>
            ["id2"] = <text = <"Details"> description = <"The details of the care relationship.">>
            ["id3"] = <text = <"Care role"> description = <"The part the carer plays in the care of the patient, named care_role of openehr_access: a code of the value set the access policy binds for care_role, or of HL7_ParticipationType when it binds none.">>
            ["id5"] = <text = <"Provider"> description = <"The healthcare provider in whose care the relationship is, named provider of openehr_access: an ORGANISATION by issuer and id, with the type ORGANISATION.">>
            ["id7"] = <text = <"Covers for"> description = <"The carer the target replaces for the period of the relationship, named covers_for of openehr_access.">>
            ["id9"] = <text = <"Context"> description = <"The episode, referral or case the relationship belongs to, named context of openehr_access.">>
            ["id11"] = <text = <"Basis"> description = <"Who wrote the relationship, named basis of openehr_access: assigned, the default, or self_declared.">>
        >
    >
