archetype (adl_version=2.0.6; rm_release=1.1.0)
    openEHR-DEMOGRAPHIC-ROLE.data_migration.v1.0.0

language
    original_language = <[ISO_639-1::en]>

description
    original_author = <
        ["name"] = <"FerroEHR">
        ["organisation"] = <"Cadasto B.V.">
    >
    lifecycle_state = <"unmanaged">
    details = <
        ["en"] = <
            language = <[ISO_639-1::en]>
            purpose = <"The ROLE a system AGENT performs to import EHRs and EHR extracts into FerroEHR, or export them, for a data migration.">
            use = <"One CAPABILITY whose credentials hold the operations, the subject namespaces of the EHRs it may touch, its rate and the creating systems whose committers an import keeps; time_validity bounds the migration by day. Adapted from the openEHR CKM archetypes the derived_from entry names: the ROLE and its CAPABILITY structure, with the credentials FerroEHR's own.">
            copyright = <"© openEHR Foundation">
        >
    >
    other_details = <
        ["licence"] = <"This work is licensed under the Creative Commons Attribution-ShareAlike 3.0 License. To view a copy of this license, visit http://creativecommons.org/licenses/by-sa/3.0/.">
        ["derived_from"] = <"openEHR-DEMOGRAPHIC-ROLE.individual_provider.v0, openEHR-DEMOGRAPHIC-CAPABILITY.individual_credentials.v0 (openEHR CKM)">
    >

definition
    ROLE[id1] matches {
        identities matches {
            PARTY_IDENTITY[id2] matches {
                details matches {
                    ITEM_TREE[id3] matches {
                        items matches {
                            ELEMENT[id4] occurrences matches {0..1} matches {
                                value matches { DV_TEXT[id5] }
                            }
                        }
                    }
                }
            }
        }
        capabilities matches {
            CAPABILITY[id6] occurrences matches {1} matches {
                name matches {
                    DV_CODED_TEXT[id7] matches {
                        defining_code matches {[ac1]}
                    }
                }
                credentials matches {
                    ITEM_TREE[id8] matches {
                        items matches {
                            ELEMENT[id9] occurrences matches {1..3} matches {
                                value matches {
                                    DV_CODED_TEXT[id30] matches {
                                        defining_code matches {[ac2]}
                                    }
                                }
                            }
                            ELEMENT[id10] occurrences matches {1..*} matches {
                                value matches { DV_TEXT[id31] }
                            }
                            CLUSTER[id11] occurrences matches {1} matches {
                                items matches {
                                    ELEMENT[id12] occurrences matches {1} matches {
                                        value matches { DV_COUNT[id32] }
                                    }
                                    ELEMENT[id13] occurrences matches {1} matches {
                                        value matches { DV_COUNT[id33] }
                                    }
                                }
                            }
                            ELEMENT[id14] occurrences matches {0..*} matches {
                                value matches { DV_TEXT[id34] }
                            }
                            ELEMENT[id15] occurrences matches {0..1} matches {
                                value matches { DV_DATE_TIME[id35] }
                            }
                            ELEMENT[id16] occurrences matches {0..1} matches {
                                value matches { DV_DATE_TIME[id36] }
                            }
                            ELEMENT[id17] occurrences matches {0..1} matches {
                                value matches { DV_TEXT[id37] }
                            }
                        }
                    }
                }
            }
        }
    }

terminology
    term_definitions = <
        ["en"] = <
            ["id1"] = <text = <"Data migration"> description = <"The role of a system that moves EHRs into or out of FerroEHR.">>
            ["id2"] = <text = <"Role name"> description = <"The name of the role.">>
            ["id3"] = <text = <"Name"> description = <"The structure of the name.">>
            ["id4"] = <text = <"Full name"> description = <"The name of the role as it is written in full.">>
            ["id6"] = <text = <"Migration grant"> description = <"What the migration may do.">>
            ["id7"] = <text = <"Kind"> description = <"The kind of the grant, which is the name of the capability.">>
            ["id8"] = <text = <"Grant"> description = <"What the capability grants, held in its credentials.">>
            ["id9"] = <text = <"Operation"> description = <"An operation the migration may run.">>
            ["id10"] = <text = <"Subject namespace"> description = <"The EHR_STATUS.subject.external_ref.namespace of the EHRs the migration may touch.">>
            ["id11"] = <text = <"Rate"> description = <"The rate the migration may send requests at.">>
            ["id12"] = <text = <"Requests per second"> description = <"The requests per second the migration may send once its burst is spent.">>
            ["id13"] = <text = <"Burst"> description = <"The requests the migration may send at once.">>
            ["id14"] = <text = <"Trusted creating system"> description = <"The creating_system_id of a source system whose committers an imported extract keeps.">>
            ["id15"] = <text = <"Not before"> description = <"The instant before which the grant does not hold, for a bound finer than the day of time_validity.">>
            ["id16"] = <text = <"Not after"> description = <"The instant after which the grant does not hold, for a bound finer than the day of time_validity.">>
            ["id17"] = <text = <"Authorisation reference"> description = <"The reference of the decision that authorised the grant, such as a change ticket or a processing agreement.">>
            ["ac1"] = <text = <"Kinds of migration grant"> description = <"The kinds of the grant.">>
            ["ac2"] = <text = <"Migration operations"> description = <"The operations a migration may run.">>
            ["at10"] = <text = <"Data migration"> description = <"The grant of a data migration.">>
            ["at20"] = <text = <"Import EHR"> description = <"Import an EHR (message_import_ehr).">>
            ["at21"] = <text = <"Import EHR extract"> description = <"Import an EHR extract (message_import_ehr_extract).">>
            ["at22"] = <text = <"Export EHR extract"> description = <"Export an EHR extract.">>
        >
    >
    value_sets = <
        ["ac1"] = <
            id = <"ac1">
            members = <"at10">
        >
        ["ac2"] = <
            id = <"ac2">
            members = <"at20", "at21", "at22">
        >
    >
