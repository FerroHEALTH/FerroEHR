archetype (adl_version=2.0.6; rm_release=1.1.0)
    openEHR-DEMOGRAPHIC-PERSON.healthcare_professional.v1.0.0

language
    original_language = <[ISO_639-1::en]>

description
    original_author = <
        ["name"] = <"FerroEHR">
        ["organisation"] = <"Cadasto B.V.">
    >
    lifecycle_state = <"unmanaged">
    details = <
        ["en"] = <
            language = <[ISO_639-1::en]>
            purpose = <"A healthcare professional's PERSON, whose login identifiers bind the person to their sign-ins.">
            use = <"Adapted from the openEHR CKM archetypes the derived_from entry names: the person's identifiers in details, the name in identities and a work email in contacts, every element optional so a person provisioned without one is complete.">
            copyright = <"© openEHR Foundation">
        >
    >
    other_details = <
        ["licence"] = <"This work is licensed under the Creative Commons Attribution-ShareAlike 3.0 License. To view a copy of this license, visit http://creativecommons.org/licenses/by-sa/3.0/.">
        ["derived_from"] = <"openEHR-DEMOGRAPHIC-PERSON.person.v0, openEHR-DEMOGRAPHIC-CLUSTER.person_identifier.v0, openEHR-DEMOGRAPHIC-PARTY_IDENTITY.person_name.v0, openEHR-DEMOGRAPHIC-ADDRESS.electronic_communication.v0 (openEHR CKM)">
    >

definition
    PERSON[id1] matches {
        details matches {
            ITEM_TREE[id2] matches {
                items matches {
                    ELEMENT[id3] occurrences matches {0..*} matches {
                        value matches { DV_IDENTIFIER[id13] }
                    }
                }
            }
        }
        identities matches {
            PARTY_IDENTITY[id4] matches {
                details matches {
                    ITEM_TREE[id5] matches {
                        items matches {
                            ELEMENT[id6] occurrences matches {0..1} matches {
                                value matches { DV_TEXT[id14] }
                            }
                            ELEMENT[id7] occurrences matches {0..1} matches {
                                value matches { DV_TEXT[id15] }
                            }
                            ELEMENT[id8] occurrences matches {0..1} matches {
                                value matches { DV_TEXT[id16] }
                            }
                        }
                    }
                }
            }
        }
        contacts matches {
            CONTACT[id9] occurrences matches {0..1} matches {
                addresses matches {
                    ADDRESS[id10] matches {
                        details matches {
                            ITEM_TREE[id11] matches {
                                items matches {
                                    ELEMENT[id12] occurrences matches {0..1} matches {
                                        value matches { DV_TEXT[id17] }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

terminology
    term_definitions = <
        ["en"] = <
            ["id1"] = <text = <"Healthcare professional"> description = <"A person who provides healthcare.">>
            ["id2"] = <text = <"Person identifiers"> description = <"The identifiers of the person.">>
            ["id3"] = <text = <"Identifier main data"> description = <"An identifier of the person, such as a login identifier.">>
            ["id4"] = <text = <"Person name"> description = <"The name of the person.">>
            ["id5"] = <text = <"Name"> description = <"The structure of the name.">>
            ["id6"] = <text = <"Full name"> description = <"The name as it is written in full.">>
            ["id7"] = <text = <"Given name"> description = <"The given name of the person.">>
            ["id8"] = <text = <"Family name"> description = <"The family name of the person.">>
            ["id9"] = <text = <"Contacts"> description = <"The contacts of the person.">>
            ["id10"] = <text = <"Electronic communication"> description = <"An electronic address of the person.">>
            ["id11"] = <text = <"Electronic communication details"> description = <"The structure of the address.">>
            ["id12"] = <text = <"Email address"> description = <"The work email address of the person.">>
        >
    >
