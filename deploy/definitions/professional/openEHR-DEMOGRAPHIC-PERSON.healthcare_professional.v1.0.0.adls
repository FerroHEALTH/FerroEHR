            ["at24"] = <text = <"Legal name"> description = <"Legal name.">>
            ["at25"] = <text = <"Other name"> description = <"Other name.">>
            ["at30"] = <text = <"Telephone"> description = <"Telephone.">>
            ["at31"] = <text = <"Fax"> description = <"Fax.">>
            ["at32"] = <text = <"Mobile"> description = <"Mobile.">>
            ["at33"] = <text = <"Pager"> description = <"Pager.">>
            ["at34"] = <text = <"E-mail"> description = <"E-mail.">>
            ["at35"] = <text = <"URL"> description = <"URL.">>
            ["at40"] = <text = <"Personal"> description = <"Personal.">>
            ["at41"] = <text = <"Business"> description = <"Business.">>
            ["at42"] = <text = <"Personal/Business"> description = <"Personal/Business.">>
            ["at43"] = <text = <"Other use"> description = <"Other use.">>
        >
    >
    value_sets = <
        ["ac1"] = <
            id = <"ac1">
            members = <"at20", "at21", "at22", "at23", "at24", "at25">
        >
        ["ac2"] = <
            id = <"ac2">
            members = <"at30", "at31", "at32", "at33", "at34", "at35">
        >
        ["ac3"] = <
            id = <"ac3">
            members = <"at40", "at41", "at42", "at43">
        >
    >
