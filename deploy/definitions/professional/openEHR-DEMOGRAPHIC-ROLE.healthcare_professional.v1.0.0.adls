archetype (adl_version=2.0.6; rm_release=1.1.0)
    openEHR-DEMOGRAPHIC-ROLE.healthcare_professional.v1.0.0

language
    original_language = <[ISO_639-1::en]>

description
    original_author = <
        ["name"] = <"FerroEHR">
        ["organisation"] = <"Cadasto B.V.">
    >
    lifecycle_state = <"unmanaged">
    details = <
        ["en"] = <
            language = <[ISO_639-1::en]>
            purpose = <"The professional ROLE a healthcare professional's PERSON performs, which makes the person bindable.">
            use = <"Adapted from the openEHR CKM archetype the derived_from entry names, with its name the only content and that optional.">
            copyright = <"© openEHR Foundation">
        >
    >
    other_details = <
        ["licence"] = <"This work is licensed under the Creative Commons Attribution-ShareAlike 3.0 License. To view a copy of this license, visit http://creativecommons.org/licenses/by-sa/3.0/.">
        ["derived_from"] = <"openEHR-DEMOGRAPHIC-ROLE.individual_provider.v0, openEHR-DEMOGRAPHIC-PARTY_IDENTITY.person_name.v0 (openEHR CKM)">
    >

definition
    ROLE[id1] matches {
        identities matches {
            PARTY_IDENTITY[id2] matches {
                details matches {
                    ITEM_TREE[id3] matches {
                        items matches {
                            ELEMENT[id4] occurrences matches {0..1} matches {
                                value matches { DV_TEXT[id5] }
                            }
                        }
                    }
                }
            }
        }
    }

terminology
    term_definitions = <
        ["en"] = <
            ["id1"] = <text = <"Healthcare professional role"> description = <"The role of a person who provides healthcare.">>
            ["id2"] = <text = <"Role name"> description = <"The name of the role.">>
            ["id3"] = <text = <"Name"> description = <"The structure of the name.">>
            ["id4"] = <text = <"Full name"> description = <"The name of the role as it is written in full.">>
        >
    >
