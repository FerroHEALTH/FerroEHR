            ["at16"] = <text = <"Other"> description = <"Another name.">>
            ["at17"] = <text = <"Unknown"> description = <"The usage is not known.">>
            ["at20"] = <text = <"Business"> description = <"A business address.">>
            ["at21"] = <text = <"Mailing or postal"> description = <"A mailing or postal address.">>
            ["at22"] = <text = <"Temporary accommodation"> description = <"A temporary address.">>
            ["at23"] = <text = <"Residential"> description = <"A residential address.">>
            ["at24"] = <text = <"No fixed address"> description = <"The party has no fixed address.">>
