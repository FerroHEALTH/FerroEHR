            ["at30"] = <text = <"Telephone"> description = <"A telephone number.">>
            ["at31"] = <text = <"Fax"> description = <"A fax number.">>
            ["at32"] = <text = <"Mobile"> description = <"A mobile telephone number.">>
            ["at33"] = <text = <"Pager"> description = <"A pager number.">>
            ["at34"] = <text = <"E-mail"> description = <"An e-mail address.">>
            ["at35"] = <text = <"URL"> description = <"A web address.">>
            ["at40"] = <text = <"Personal"> description = <"For personal use.">>
            ["at41"] = <text = <"Business"> description = <"For business use.">>
            ["at42"] = <text = <"Personal/Business"> description = <"For personal and business use.">>
            ["at43"] = <text = <"Other use"> description = <"For another use.">>
        >
    >
