archetype (adl_version=2.0.6; rm_release=1.1.0)
    openEHR-DEMOGRAPHIC-ORGANISATION.healthcare_provider.v1.0.0

language
    original_language = <[ISO_639-1::en]>

description
    original_author = <
        ["name"] = <"FerroEHR">
        ["organisation"] = <"Cadasto B.V.">
    >
    lifecycle_state = <"unmanaged">
    details = <
        ["en"] = <
            language = <[ISO_639-1::en]>
            purpose = <"A healthcare provider's ORGANISATION: the provider a system acts for, and a federation partner.">
            use = <"Identified by a DV_IDENTIFIER in details, such as the Dutch URA, with its names in identities named by their usage and a postal and an electronic address. An acts-for relationship targets it, and a federation partner's ROLE names it as performer. Adapted from the openEHR CKM archetypes the derived_from entry names.">
            copyright = <"© openEHR Foundation">
        >
    >
    other_details = <
        ["licence"] = <"This work is licensed under the Creative Commons Attribution-ShareAlike 3.0 License. To view a copy of this license, visit http://creativecommons.org/licenses/by-sa/3.0/.">
        ["derived_from"] = <"openEHR-DEMOGRAPHIC-ORGANISATION.organisation.v0 (openEHR CKM 1013.1.475, modified 2019-08-09), openEHR-DEMOGRAPHIC-PARTY_IDENTITY.organisation_name.v0 (openEHR CKM 1013.1.476, modified 2019-08-09), openEHR-DEMOGRAPHIC-CLUSTER.person_identifier-provider.v0 (openEHR CKM 1013.1.833, modified 2019-08-12), openEHR-DEMOGRAPHIC-ADDRESS.address-provider.v0 (openEHR CKM 1013.1.499, modified 2019-08-08), openEHR-DEMOGRAPHIC-ADDRESS.electronic_communication-provider.v0 (openEHR CKM 1013.1.487, modified 2019-08-08)">
    >

definition
    ORGANISATION[id1] matches {
        details existence matches {1} matches {
            ITEM_TREE[id2] matches {
                items matches {
                    ELEMENT[id3] occurrences matches {1..*} matches {
                        value matches { DV_IDENTIFIER[id30] }
                    }
                }
            }
        }
        identities matches {
            PARTY_IDENTITY[id4] matches {
                name matches {
                    DV_TEXT[id31]
                    DV_CODED_TEXT[id32] matches {
                        defining_code matches {[ac1]}
                    }
                }
                details matches {
                    ITEM_TREE[id5] matches {
                        items matches {
                            ELEMENT[id6] occurrences matches {1} matches {
                                value matches { DV_TEXT[id33] }
                            }
                        }
                    }
                }
            }
        }
        contacts matches {
            CONTACT[id7] occurrences matches {0..*} matches {
                addresses matches {
                    ADDRESS[id8] matches {
                        name matches {
                            DV_TEXT[id39]
                            DV_CODED_TEXT[id40] matches {
                                defining_code matches {[ac2]}
                            }
                        }
                        details matches {
                            ITEM_TREE[id9] matches {
                                items matches {
                                    ELEMENT[id10] occurrences matches {0..*} matches {
                                        value matches { DV_TEXT[id34] }
                                    }
                                    ELEMENT[id11] occurrences matches {0..1} matches {
                                        value matches { DV_TEXT[id35] }
                                    }
                                    ELEMENT[id12] occurrences matches {0..1} matches {
                                        value matches { DV_TEXT[id36] }
                                    }
                                    ELEMENT[id13] occurrences matches {0..1} matches {
                                        value matches { DV_TEXT[id37] }
                                    }
                                    ELEMENT[id14] occurrences matches {0..1} matches {
                                        value matches { DV_TEXT[id38] }
                                    }
                                }
                            }
                        }
                    }
                    ADDRESS[id15] matches {
                        name matches {
                            DV_TEXT[id41]
                            DV_CODED_TEXT[id42] matches {
                                defining_code matches {[ac3]}
                            }
                        }
                        details matches {
                            ITEM_TREE[id16] matches {
                                items matches {
                                    ELEMENT[id17] occurrences matches {0..1} matches {
                                        value matches {
                                            DV_TEXT[id43]
                                            DV_CODED_TEXT[id44] matches {
                                                defining_code matches {[ac4]}
                                            }
                                        }
                                    }
                                    ELEMENT[id18] occurrences matches {1} matches {
                                        value matches { DV_TEXT[id45] }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

terminology
    term_definitions = <
        ["en"] = <
            ["id1"] = <text = <"Healthcare provider"> description = <"An organisation that provides healthcare: the provider a system acts for, or a federation partner.">>
            ["id2"] = <text = <"Identifiers"> description = <"The identifiers of the provider.">>
            ["id3"] = <text = <"Provider identifier"> description = <"An identifier of the provider issued by an organisation or the state, such as the Dutch URA.">>
            ["id4"] = <text = <"Name"> description = <"A name of the provider, named by its usage.">>
            ["id5"] = <text = <"Items"> description = <"The structure of the name.">>
            ["id6"] = <text = <"Name"> description = <"The name.">>
            ["id7"] = <text = <"Contact"> description = <"A way to reach the provider.">>
            ["id8"] = <text = <"Postal address"> description = <"A postal or residential address.">>
            ["id9"] = <text = <"Address details"> description = <"The structure of the address.">>
            ["id10"] = <text = <"Address line"> description = <"A line of the address, the street and number first.">>
            ["id11"] = <text = <"Postal code"> description = <"The postal code.">>
            ["id12"] = <text = <"Suburb/town/locality"> description = <"The town or locality.">>
            ["id13"] = <text = <"State/territory/province"> description = <"The state, territory or province.">>
            ["id14"] = <text = <"Country"> description = <"The country.">>
            ["id15"] = <text = <"Electronic address"> description = <"An electronic address, its type its name.">>
            ["id16"] = <text = <"Components"> description = <"The structure of the electronic address.">>
            ["id17"] = <text = <"Usage"> description = <"What the address is used for.">>
            ["id18"] = <text = <"Details"> description = <"The address itself, such as an e-mail address or a telephone number.">>
            ["ac1"] = <text = <"Organisation name usages"> description = <"The usages of an organisation's name.">>
            ["ac2"] = <text = <"Address types"> description = <"The types of a postal address.">>
            ["ac3"] = <text = <"Electronic address types"> description = <"The types of an electronic address.">>
            ["ac4"] = <text = <"Address usages"> description = <"What an address is used for.">>
            ["at10"] = <text = <"Organisational unit/section/division name"> description = <"The name of a unit, section or division.">>
            ["at11"] = <text = <"Service location name"> description = <"The name of a service location.">>
            ["at12"] = <text = <"Business name"> description = <"The business name.">>
            ["at13"] = <text = <"Locally used name"> description = <"A name used locally.">>
