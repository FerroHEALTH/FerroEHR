archetype (adl_version=2.0.6; rm_release=1.1.0)
    openEHR-DEMOGRAPHIC-PARTY_RELATIONSHIP.representation.v1.0.0

language
    original_language = <[ISO_639-1::en]>

description
    original_author = <
        ["name"] = <"FerroEHR">
        ["organisation"] = <"Cadasto B.V.">
    >
    lifecycle_state = <"unmanaged">
    details = <
        ["en"] = <
            language = <[ISO_639-1::en]>
            purpose = <"The relationship a representative acts through: a PARTY_RELATIONSHIP from the representative's PERSON, its source, to the PERSON of the subject they act for, its target.">
            use = <"Held in the representative's PERSON.relationships, or committed as a PARTY_RELATIONSHIP of its own when the subject authorises a proxy, with time_validity bounding when it holds: the date from which a minor decides alone, under the law of the deployment, ends it. Its name is its type, coded from the value set ac1. Its details hold the code that makes it a representation, represents of FerroEHR's operation terminology ferroehr-operations, and the code of the openEHR subject_relationship group the relationship is. Adapted from the person-to-person PARTY_RELATIONSHIP the openEHR CKM archetypes the derived_from entry names constrain inline (person.v0 at0004, personal relationships, and person-patient.v0 at0004.1, personal relationship): its type of relationship, coded.">
            copyright = <"© openEHR Foundation">
        >
    >
    other_details = <
        ["licence"] = <"This work is licensed under the Creative Commons Attribution-ShareAlike 3.0 License. To view a copy of this license, visit http://creativecommons.org/licenses/by-sa/3.0/.">
        ["derived_from"] = <"openEHR-DEMOGRAPHIC-PERSON.person.v0 (openEHR CKM 1013.1.479, modified 2022-01-20), openEHR-DEMOGRAPHIC-PERSON.person-patient.v0 (openEHR CKM 1013.1.821, modified 2019-08-09)">
    >

definition
    PARTY_RELATIONSHIP[id1] matches {
        name matches {
            DV_CODED_TEXT[id2] matches {
                defining_code matches {[ac1]}
            }
        }
        details matches {
            ITEM_TREE[id3] matches {
                items matches {
                    ELEMENT[id4] occurrences matches {1} matches {
                        value matches { DV_CODED_TEXT[id5] }
                    }
                    ELEMENT[id6] occurrences matches {0..1} matches {
                        value matches { DV_CODED_TEXT[id7] }
                    }
                }
            }
        }
    }

terminology
    term_definitions = <
        ["en"] = <
            ["id1"] = <text = <"Representation"> description = <"The relationship of a representative to the subject they act for.">>
            ["id2"] = <text = <"Type of representation"> description = <"The type of the relationship, which is its name.">>
            ["id3"] = <text = <"Details"> description = <"The details of the representation.">>
            ["id4"] = <text = <"Representation code"> description = <"The code that makes the relationship a representation: represents of FerroEHR's operation terminology ferroehr-operations.">>
            ["id6"] = <text = <"Relationship"> description = <"The relationship of the representative to the subject, a code of the openEHR subject_relationship group.">>
            ["ac1"] = <text = <"Types of representation"> description = <"The types of relationship a representative acts through.">>
            ["at10"] = <text = <"Parent"> description = <"The representative is a parent of the subject.">>
            ["at11"] = <text = <"Guardian"> description = <"The representative is a legal guardian of the subject.">>
            ["at12"] = <text = <"Authorised proxy"> description = <"The subject authorised the representative to act for them.">>
        >
    >
    value_sets = <
        ["ac1"] = <
            id = <"ac1">
            members = <"at10", "at11", "at12">
        >
    >
