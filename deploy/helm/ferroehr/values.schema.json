{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "ferroehr chart values",
  "description": "Draft-07 because that is what consumes it: helm 4 validates through santhosh-tekuri/jsonschema/v6 (multi-draft), but Artifact Hub's Values-schema renderer is typed against json-schema draft 4/6/7. Descriptions here state CONSTRAINTS the type cannot; the prose reference is the generated README table, and defaults are read from values.yaml, so neither is repeated.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "description": "Injected by a parent chart when this one is used as a dependency. Nothing in this chart reads it, but refusing it would make the chart unusable as a subchart.",
      "type": "object"
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 0
    },
    "strategy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "RollingUpdate",
            "Recreate"
          ]
        },
        "rollingUpdate": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxSurge": {
              "description": "A count or a percentage string (\"25%\").",
              "type": [
                "integer",
                "string"
              ]
            },
            "maxUnavailable": {
              "description": "A count or a percentage string (\"25%\").",
              "type": [
                "integer",
                "string"
              ]
            }
          }
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        },
        "tag": {
          "description": "Empty falls back to .Chart.appVersion.",
          "type": "string"
        },
        "digest": {
          "description": "Wins over `tag` entirely when set.",
          "type": "string",
          "pattern": "^(sha256:[0-9a-f]{64})?$"
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "name": {
          "type": "string"
        },
        "automountServiceAccountToken": {
          "type": "boolean"
        }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "existingSecretKey": {
          "description": "A key name INSIDE existingSecret, not an environment variable name: the chart mounts that key as a file and passes only its path.",
          "type": "string"
        },
        "url": {
          "description": "Inline DSN (dev/test only). Ignored when existingSecret is set.",
          "type": "string"
        },
        "clinical": {
          "description": "The clinical storage domain's own DSN. Empty uses the shared existingSecret / url, which is the schema-only posture.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "existingSecretKey": {
              "description": "A key name INSIDE existingSecret; the chart mounts that key as a file and passes only its path.",
              "type": "string"
            },
            "url": {
              "description": "Inline DSN (dev/test only). Ignored when existingSecret is set.",
              "type": "string"
            }
          }
        },
        "party": {
          "description": "The party storage domain's own DSN. Empty uses the shared existingSecret / url, which is the schema-only posture.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "existingSecretKey": {
              "description": "A key name INSIDE existingSecret; the chart mounts that key as a file and passes only its path.",
              "type": "string"
            },
            "url": {
              "description": "Inline DSN (dev/test only). Ignored when existingSecret is set.",
              "type": "string"
            }
          }
        },
        "linkage": {
          "description": "The linkage storage domain's own DSN. Empty uses the shared existingSecret / url, which is the schema-only posture.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "existingSecretKey": {
              "description": "A key name INSIDE existingSecret; the chart mounts that key as a file and passes only its path.",
              "type": "string"
            },
            "url": {
              "description": "Inline DSN (dev/test only). Ignored when existingSecret is set.",
              "type": "string"
            }
          }
        },
        "audit": {
          "description": "The audit storage domain's own DSN. Empty uses the shared existingSecret / url, which is the schema-only posture.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "existingSecretKey": {
              "description": "A key name INSIDE existingSecret; the chart mounts that key as a file and passes only its path.",
              "type": "string"
            },
            "url": {
              "description": "Inline DSN (dev/test only). Ignored when existingSecret is set.",
              "type": "string"
            }
          }
        },
        "migrateExistingSecret": {
          "description": "Secret holding the DSN that prepares the schema, which spans every schema and is therefore neither runtime credential. Unset, preparation falls back to the clinical DSN.",
          "type": "string"
        },
        "migrateExistingSecretKey": {
          "description": "A key name INSIDE migrateExistingSecret; the chart mounts that key as a file and passes only its path.",
          "type": "string"
        },
        "migrateUrl": {
          "description": "Inline schema-preparation DSN (dev/test only). Ignored when migrateExistingSecret is set.",
          "type": "string"
        }
      }
    },
    "migrations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runByMigratorRole": {
          "type": "boolean"
        },
        "job": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "existingSecret": {
              "description": "Required when enabled: the MIGRATOR DSN, a different credential from database.*.",
              "type": "string"
            },
            "existingSecretKey": {
              "type": "string"
            },
            "backoffLimit": {
              "type": "integer",
              "minimum": 0
            },
            "ttlSecondsAfterFinished": {
              "type": "integer",
              "minimum": 0
            },
            "activeDeadlineSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "resources": {
              "$ref": "#/definitions/resourceRequirements"
            },
            "podAnnotations": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "nodeSelector": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "tolerations": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "backup": {
      "description": "Per-domain logical backups: one CronJob per pseudonymisation domain (clinical, party, linkage), plus audit when database.audit gives that domain a database of its own. Off by default, and enabling it requires a DISTINCT existing PersistentVolumeClaim per rendered domain \u2014 the render is refused otherwise.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "pullPolicy": {
              "type": "string",
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            },
            "tag": {
              "description": "Empty falls back to .Chart.appVersion.",
              "type": "string"
            },
            "digest": {
              "description": "Wins over `tag` entirely when set.",
              "type": "string",
              "pattern": "^(sha256:[0-9a-f]{64})?$"
            }
          }
        },
        "timeZone": {
          "description": "An IANA time zone name; empty leaves the kube-controller-manager's own zone.",
          "type": "string"
        },
        "startingDeadlineSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "backoffLimit": {
          "type": "integer",
          "minimum": 0
        },
        "activeDeadlineSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "ttlSecondsAfterFinished": {
          "type": "integer",
          "minimum": 0
        },
        "resources": {
          "$ref": "#/definitions/resourceRequirements"
        },
        "podAnnotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "nodeSelector": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "tolerations": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "clinical": {
          "$ref": "#/definitions/backupDomain"
        },
        "party": {
          "$ref": "#/definitions/backupDomain"
        },
        "linkage": {
          "$ref": "#/definitions/backupDomain"
        },
        "audit": {
          "$ref": "#/definitions/backupDomain"
        }
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "authOidcHmacSecret": {
          "type": "string"
        },
        "signingKeyPassphrase": {
          "type": "string"
        },
        "eventsUrl": {
          "type": "string"
        },
        "basicUserPasswordHashes": {
          "description": "Keyed by username; each username also needs an entry under config.auth.basic.users, or rendering fails.",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "auditFhirFeedUrl": {
          "type": "string"
        },
        "terminologyOauth2ClientSecrets": {
          "description": "Keyed by client name; each name also needs an entry under config.terminology.external.oauth2_clients, or rendering fails.",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "multimediaAccessKeyId": {
          "type": "string"
        },
        "multimediaSecretAccessKey": {
          "type": "string"
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "serviceMonitor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "namespace": {
              "type": "string"
            },
            "labels": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "interval": {
              "$ref": "#/definitions/duration"
            },
            "scrapeTimeout": {
              "$ref": "#/definitions/duration"
            }
          }
        },
        "grafanaDashboard": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "folder": {
              "type": "string"
            }
          }
        }
      }
    },
    "config": {
      "description": "Rendered into ferroehr.toml, so its vocabulary is the SERVER's config tree and this schema deliberately does not fork it: unknown keys are accepted here and adjudicated by the server at boot. Only the keys the chart's own templates branch on, and the keys the chart documents with their shipped defaults (deployment_profile, audit.store, audit.categories), are typed, by shape and never by the server's vocabulary, and each accepts null \u2014 setting a key to null is how an overlay deletes it when a pinned older image does not know it yet.",
      "type": "object",
      "properties": {
        "deployment_profile": {
          "description": "The declared deployment posture: sandbox (the binary's default; must not hold real patient data) or production (refuses to boot while a separation is missing and not named in deployment_accepts). The vocabulary is the server's and is judged at boot.",
          "type": [
            "string",
            "null"
          ],
          "default": "sandbox"
        },
        "server": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "base_path": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "db": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "migrate": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "auth": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "enabled": {
              "type": [
                "boolean",
                "null"
              ]
            }
          }
        },
        "admin": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "enabled": {
              "type": [
                "boolean",
                "null"
              ]
            }
          }
        },
        "management": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "enabled": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "base_path": {
              "type": [
                "string",
                "null"
              ]
            },
            "port": {
              "description": "Unset serves the management surface on the API port; set, it becomes a second container port.",
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "maximum": 65535
            }
          }
        },
        "audit": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "enabled": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "store": {
              "type": [
                "object",
                "null"
              ],
              "properties": {
                "retention_days": {
                  "description": "Days to keep access-log records; 0 keeps them forever. The server judges it against the jurisdictional floors and ceilings at boot.",
                  "type": [
                    "integer",
                    "null"
                  ],
                  "default": 0
                },
                "retention_years": {
                  "description": "The horizon in calendar years, in place of a non-zero retention_days. Unset by default; the server refuses 0, and a value outside the jurisdictional bounds, at boot.",
                  "type": [
                    "integer",
                    "null"
                  ],
                  "default": null
                }
              }
            },
            "categories": {
              "description": "[audit.categories]: template id and root archetype id to the EHDS priority categories each holds. Empty by default. The category vocabulary is the server's and is judged at boot; only the shape is typed here.",
              "type": [
                "object",
                "null"
              ],
              "default": {
                "templates": {},
                "archetypes": {}
              },
              "properties": {
                "templates": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "additionalProperties": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "archetypes": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "additionalProperties": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "events": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "enabled": {
              "type": [
                "boolean",
                "null"
              ]
            }
          }
        },
        "terminology": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "external": {
              "type": [
                "object",
                "null"
              ],
              "properties": {
                "enabled": {
                  "type": [
                    "boolean",
                    "null"
                  ]
                }
              }
            }
          }
        },
        "multimedia": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "enabled": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "allow_http": {
              "type": [
                "boolean",
                "null"
              ]
            }
          }
        },
        "files": {
          "description": "NOT part of the TOML: each key becomes /etc/ferroehr/<key> from a chart Secret. Values are file contents, so they are strings.",
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "extraEnv": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "extraEnvFrom": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer",
            "ExternalName"
          ]
        },
        "port": {
          "$ref": "#/definitions/port"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "trafficDistribution": {
          "type": "string",
          "enum": [
            "",
            "PreferClose",
            "PreferSameZone",
            "PreferSameNode"
          ],
          "description": "Service topology preference (KEP-4444, stable v1.33). Empty omits the field, leaving cluster-wide spreading."
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "host": {
                "type": "string",
                "minLength": 1
              },
              "paths": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "pathType": {
                      "type": "string",
                      "enum": [
                        "Exact",
                        "Prefix",
                        "ImplementationSpecific"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "tls": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "secretName": {
                "type": "string"
              },
              "hosts": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "ingressFrom": {
          "description": "Raw NetworkPolicyPeer entries. EMPTY means the rule carries no `from` at all, which admits every source.",
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "ingressAllowAll": {
          "description": "Whether an empty `ingressFrom` may render an ingress rule with no `from` \u2014 which admits every source. true (the shipped default) renders it; false refuses the render while `ingressFrom` is empty. A non-empty `ingressFrom` narrows the sources regardless.",
          "type": "boolean"
        },
        "egress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "database": {
              "description": "Not optional when egress is enabled: rendering refuses an egress policy with no database destination.",
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "to": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                },
                "port": {
                  "$ref": "#/definitions/port"
                }
              }
            },
            "rules": {
              "description": "Raw NetworkPolicyEgressRule entries, one per enabled integration.",
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "hostUsers": {
      "type": "boolean",
      "description": "Kubernetes PodSpec.hostUsers (KEP-127, stable v1.36). false = the pod runs in its own user namespace, which is the chart default and what the 1.36 kubeVersion floor buys. true = share the host user namespace (the API default), for nodes whose runtime cannot map UIDs."
    },
    "podSecurityContext": {
      "description": "Rendered verbatim as the pod's securityContext, so the whole Kubernetes PodSecurityContext surface is permitted.",
      "type": "object"
    },
    "securityContext": {
      "description": "Rendered verbatim as the container's securityContext, so the whole Kubernetes SecurityContext surface is permitted.",
      "type": "object"
    },
    "resources": {
      "$ref": "#/definitions/resourceRequirements"
    },
    "probes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "liveness": {
          "$ref": "#/definitions/probeTiming"
        },
        "readiness": {
          "$ref": "#/definitions/probeTiming"
        },
        "startup": {
          "description": "Unlike liveness/readiness, these four fields are read individually rather than rendered whole, so the set is closed.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "initialDelaySeconds": {
              "type": "integer",
              "minimum": 0
            },
            "periodSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "failureThreshold": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "autoscaling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "maxReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "targetCPUUtilizationPercentage": {
          "description": "0 disables the metric.",
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "targetMemoryUtilizationPercentage": {
          "description": "0 disables the metric.",
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "behavior": {
          "description": "Rendered verbatim as HorizontalPodAutoscaler.spec.behavior, so the whole scaling-policy surface is permitted. Empty omits it and keeps the documented defaults.",
          "type": "object"
        }
      }
    },
    "podDisruptionBudget": {
      "description": "Set one of minAvailable / maxUnavailable, never both.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minAvailable": {
          "type": [
            "integer",
            "string"
          ]
        },
        "maxUnavailable": {
          "type": [
            "integer",
            "string"
          ]
        },
        "unhealthyPodEvictionPolicy": {
          "description": "Whether a node drain may evict already-unhealthy pods. AlwaysAllow is the documented recommendation; IfHealthyBudget is the API default and can hang a drain.",
          "type": "string",
          "enum": [
            "AlwaysAllow",
            "IfHealthyBudget"
          ]
        }
      }
    },
    "podLabels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "podAnnotations": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "tolerations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "affinity": {
      "type": "object"
    },
    "topologySpreadConstraints": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 0
    },
    "preStopSleepSeconds": {
      "type": "integer",
      "minimum": 0,
      "description": "Lame-duck pause before SIGTERM, in seconds; 0 disables. Rendered only on Kubernetes >= 1.30, where the native preStop.sleep action takes effect."
    },
    "extraVolumes": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "extraVolumeMounts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "viewer": {
      "description": "The optional viewer, deployed as its own workload. Off by default: it is a separate product surface with its own attack surface, and a CDR is complete without it. It reaches the CDR strictly over ITS-REST, which is what makes its egress policy enforceable.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "description": "Deploy the viewer alongside the CDR.",
          "type": "boolean"
        },
        "replicaCount": {
          "description": "Replicas. Session state is in-process, so >1 needs sticky sessions at the ingress.",
          "type": "integer",
          "minimum": 0
        },
        "image": {
          "description": "Viewer image.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "pullPolicy": {
              "type": "string",
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            },
            "tag": {
              "description": "Empty falls back to .Chart.appVersion.",
              "type": "string"
            },
            "digest": {
              "description": "sha256 digest; wins over tag. Bare hex or sha256:-prefixed.",
              "type": "string",
              "pattern": "^$|^(sha256:)?[a-fA-F0-9]{64}$"
            }
          }
        },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "ClusterIP",
                "NodePort",
                "LoadBalancer",
                "ExternalName"
              ]
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        },
        "ingress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "className": {
              "type": "string"
            },
            "annotations": {
              "type": "object"
            },
            "hosts": {
              "type": "array"
            },
            "tls": {
              "type": "array"
            }
          }
        },
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "oidc": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "issuer": {
                  "description": "Issuer URL; https for anything but local development.",
                  "type": "string"
                },
                "clientId": {
                  "type": "string"
                },
                "publicBaseUrl": {
                  "description": "The viewer's externally-reachable base URL, used to build the OIDC redirect.",
                  "type": "string"
                }
              }
            }
          }
        },
        "existingSecret": {
          "description": "Secret holding the OIDC client secret; mounted as a file, never env-borne.",
          "type": "string"
        },
        "existingSecretKey": {
          "type": "string"
        },
        "networkPolicy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "ingressFrom": {
              "description": "Empty means the rule carries no `from`, which admits EVERY source.",
              "type": "array"
            },
            "ingressAllowAll": {
              "description": "Whether an empty `ingressFrom` may render an ingress rule with no `from` \u2014 which admits every source to the viewer. true (the shipped default) renders it; false refuses the render while `ingressFrom` is empty. A non-empty `ingressFrom` narrows the sources regardless.",
              "type": "boolean"
            }
          }
        },
        "podSecurityContext": {
          "type": "object"
        },
        "securityContext": {
          "type": "object"
        },
        "resources": {
          "type": "object"
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        },
        "extraEnv": {
          "type": "array"
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "preStopSleepSeconds": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "terminology": {
      "description": "FerroTERM, the FHIR terminology server, deployed as its own workload and wired as the CDR's external terminology. Off by default. No Ingress is rendered for it and no key here renders one: the CDR is its only caller, which is what the SNOMED CT Affiliate Licence asks of a public deployment (clause 2.2.4 extraction, clause 2.7 access control).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "description": "Deploy FerroTERM alongside the CDR.",
          "type": "boolean"
        },
        "wireCdr": {
          "description": "Point config.terminology.external at the rendered Service. Declaring config.terminology.external.providers.default yourself while this is true is refused at render.",
          "type": "boolean"
        },
        "failOnError": {
          "description": "Whether an unresolvable binding is a 422 refusal rather than accepted. false is the server's own shipped default.",
          "type": "boolean"
        },
        "replicaCount": {
          "type": "integer",
          "minimum": 0
        },
        "topologySpreadConstraints": {
          "description": "Replaces the chart's default spread (one replica per node, ScheduleAnyway) wholesale rather than merging with it.",
          "type": "array"
        },
        "strategy": {
          "description": "Deployment update strategy. Empty leaves the API default, except with index.persistentVolumeClaim set, where the chart renders type: Recreate because a ReadWriteOnce volume cannot attach to a surge pod on another node.",
          "type": "object"
        },
        "image": {
          "description": "FerroTERM image. Its tag falls back to the FerroTERM release this chart pins, never to .Chart.appVersion. A tag other than that pin is refused while digest is non-empty: the digest wins, so the tag would be inert.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "pullPolicy": {
              "type": "string",
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            },
            "tag": {
              "type": "string"
            },
            "digest": {
              "description": "sha256 digest; wins over tag. Bare hex or sha256:-prefixed.",
              "type": "string",
              "pattern": "^$|^(sha256:)?[a-fA-F0-9]{64}$"
            }
          }
        },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "ClusterIP",
                "NodePort",
                "LoadBalancer",
                "ExternalName"
              ]
            },
            "port": {
              "$ref": "#/definitions/port"
            }
          }
        },
        "codeSystems": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingConfigMap": {
              "description": "A ConfigMap of FHIR JSON to serve instead of the chart's shaped seed.",
              "type": "string"
            },
            "mountPath": {
              "description": "Absolute path the code systems are mounted at; FERROTERM_CODESYSTEMS names it.",
              "type": "string",
              "pattern": "^/.+"
            }
          }
        },
        "index": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "persistentVolumeClaim": {
              "description": "The name of an EXISTING claim holding an index built off-cluster. Empty serves the shaped seed alone; the chart provisions no storage and renders no build Job.",
              "type": "string"
            },
            "mountPath": {
              "description": "Absolute path the index claim is mounted at; FERROTERM_INDEX names it, and is rendered only when a claim is named.",
              "type": "string",
              "pattern": "^/.+"
            }
          }
        },
        "ui": {
          "description": "Serve FerroTERM's own browsing UI.",
          "type": "boolean"
        },
        "defaultLanguage": {
          "type": "string",
          "minLength": 1
        },
        "logFormat": {
          "type": "string",
          "enum": [
            "json",
            "pretty"
          ]
        },
        "logLevel": {
          "description": "A RUST_LOG filter.",
          "type": "string",
          "minLength": 1
        },
        "networkPolicy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "extraIngressFrom": {
              "description": "Further peers admitted beside the CDR's pods. There is deliberately no admit-everything BOOLEAN here, and each peer is admitted exactly as written — so the peer itself is constrained: an empty peer, or an empty podSelector/namespaceSelector inside one, selects every pod in the namespace or in every namespace and is refused.",
              "type": "array",
              "items": {
                "$ref": "#/definitions/narrowingNetworkPolicyPeer"
              }
            }
          }
        },
        "podDisruptionBudget": {
          "description": "FerroTERM's own budget, over its own pods. Off by default: the shipped replicaCount is 1 and a budget over one pod blocks the drain it exists to survive. Set one of minAvailable / maxUnavailable, never both.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "minAvailable": {
              "type": [
                "integer",
                "string"
              ]
            },
            "maxUnavailable": {
              "type": [
                "integer",
                "string"
              ]
            },
            "unhealthyPodEvictionPolicy": {
              "description": "Whether a node drain may evict already-unhealthy pods. AlwaysAllow is the documented recommendation; IfHealthyBudget is the API default and can hang a drain.",
              "type": "string",
              "enum": [
                "AlwaysAllow",
                "IfHealthyBudget"
              ]
            }
          }
        },
        "podSecurityContext": {
          "type": "object"
        },
        "securityContext": {
          "type": "object"
        },
        "resources": {
          "type": "object"
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        },
        "extraEnv": {
          "type": "array"
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "preStopSleepSeconds": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "usageReport": {
      "type": "object",
      "additionalProperties": false,
      "description": "The usage report to FerroPULSE. The chart injects usage_report.enabled and usage_report.deployment (helm) into the rendered ferroehr.toml.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Send the usage report (on by default); false sends nothing."
        }
      }
    }
  },
  "definitions": {
    "narrowingLabelSelector": {
      "description": "A label selector that actually selects something: 'if present but empty, it selects all pods' / 'all namespaces' (Kubernetes networking/v1 NetworkPolicyPeer), so an empty one here would silently widen the rule it was added to narrow.",
      "type": "object",
      "minProperties": 1,
      "anyOf": [
        {
          "required": [
            "matchLabels"
          ]
        },
        {
          "required": [
            "matchExpressions"
          ]
        }
      ],
      "properties": {
        "matchLabels": {
          "type": "object",
          "minProperties": 1
        },
        "matchExpressions": {
          "type": "array",
          "minItems": 1
        }
      }
    },
    "narrowingNetworkPolicyPeer": {
      "description": "A NetworkPolicyPeer that names a source. Constrained rather than left raw because this policy has no admit-everything key by design, and an empty peer or an empty selector inside one reaches that state anyway.",
      "type": "object",
      "minProperties": 1,
      "properties": {
        "podSelector": {
          "$ref": "#/definitions/narrowingLabelSelector"
        },
        "namespaceSelector": {
          "$ref": "#/definitions/narrowingLabelSelector"
        },
        "ipBlock": {
          "type": "object",
          "required": [
            "cidr"
          ],
          "properties": {
            "cidr": {
              "type": "string",
              "minLength": 1
            },
            "except": {
              "type": "array"
            }
          }
        }
      }
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "duration": {
      "description": "A Prometheus duration: a digit run followed by ms, s, m, h, d, w or y.",
      "type": "string",
      "pattern": "^([0-9]+(ms|[smhdwy]))+$"
    },
    "quantity": {
      "description": "A Kubernetes quantity \u2014 \"250m\", \"1Gi\", or a bare number.",
      "type": [
        "string",
        "number"
      ]
    },
    "resourceRequirements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "limits": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/quantity"
          }
        },
        "requests": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/quantity"
          }
        },
        "claims": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "cronSchedule": {
      "description": "A five-field cron expression, or one of the @macros the CronJob API accepts.",
      "type": "string",
      "pattern": "^(@(annually|yearly|monthly|weekly|daily|midnight|hourly)|@every +[0-9a-z]+|[^@ ]+( +[^ ]+){4})$"
    },
    "backupDomain": {
      "description": "One pseudonymisation domain's backup: its own schedule and its own destination claim.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schedule": {
          "$ref": "#/definitions/cronSchedule"
        },
        "persistentVolumeClaim": {
          "description": "The name of an EXISTING PersistentVolumeClaim. Required when backup.enabled, and a different claim per domain.",
          "type": "string"
        },
        "existingSecret": {
          "type": "string",
          "description": "Secret holding this domain's BACKUP DSN (a read-only role on that domain's schema)."
        },
        "existingSecretKey": {
          "type": "string",
          "minLength": 1,
          "description": "Key within existingSecret carrying the backup DSN."
        }
      }
    },
    "probeTiming": {
      "description": "Rendered whole beside the chart's own httpGet/exec handler, so any Kubernetes probe field is permitted; these four are typed because they are the ones the chart ships.",
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "initialDelaySeconds": {
          "type": "integer",
          "minimum": 0
        },
        "periodSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "failureThreshold": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
