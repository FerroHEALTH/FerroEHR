#
# The terminology index the sandbox box carries at
# /opt/ferroehr-sandbox/ferroterm-index (#3520). The index is operator state
# built off-box from licensed releases, so the repository cannot read it; this
# record is what the operator built, and scripts/checks/ferroterm-index-layout.sh
# refuses a FerroTERM pin in docker-compose.yml whose artifact layout differs
# from FERROTERM_INDEX_LAYOUT. Rebuilding the index updates this file in the
# same change that bumps the pin.
FERROTERM_INDEX_LAYOUT=7
FERROTERM_INDEX_BUILT_WITH=0.1.6
FERROTERM_INDEX_BUILT_ON=2026-10-02
FERROTERM_INDEX_SNOMED=http://snomed.info/sct/900000000000207008/version/20260901
FERROTERM_INDEX_LOINC=2.83
